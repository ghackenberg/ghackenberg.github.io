---
import "@styles/global.css";
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/outfit/300.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import "@fontsource/outfit/800.css";
import "@fontsource/caveat/400.css";
import "@fontsource/caveat/600.css";
import "@fontsource/caveat/700.css";
import outfit400Woff2 from "@fontsource/outfit/files/outfit-latin-400-normal.woff2?url";
import outfit500Woff2 from "@fontsource/outfit/files/outfit-latin-500-normal.woff2?url";
import outfit700Woff2 from "@fontsource/outfit/files/outfit-latin-700-normal.woff2?url";
import outfit800Woff2 from "@fontsource/outfit/files/outfit-latin-800-normal.woff2?url";
import type { ImageMetadata } from "astro";
import KaTeXStyles from "@components/KaTeXStyles.astro";
import { getImage } from "astro:assets";
import { ensureBrandingAssets } from "@commons/server/branding-assets";
import { getFileContentHash, getHashedFilename } from "@commons/server/content-hash";
import Background from "@components/Background.astro";
import Container from "@components/Container.astro";
import JsonLd from "@components/JsonLd.astro";
import AnalyticsDevOverlay from "@components/dev/AnalyticsDevOverlay.astro";
import DevStudioShell from "@components/dev/DevStudioShell.astro";
import PreviewMediaBoot from "@components/PreviewMediaBoot.astro";
import PreviewMediaLoader from "@components/PreviewMediaLoader.astro";
import Telemetry from "@components/Telemetry.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
import { getCollection } from "astro:content";
import { CONTENT_DOMAINS, DOMAIN_METADATA } from "@commons/shared/domain-themes";

const isDev = import.meta.env.DEV;

const criticalFontCss = `
  html { scrollbar-gutter: stable; }
  @font-face { font-family: 'Outfit'; font-style: normal; font-display: block; font-weight: 400; src: url('${outfit400Woff2}') format('woff2'); }
  @font-face { font-family: 'Outfit'; font-style: normal; font-display: block; font-weight: 500; src: url('${outfit500Woff2}') format('woff2'); }
  @font-face { font-family: 'Outfit'; font-style: normal; font-display: block; font-weight: 700; src: url('${outfit700Woff2}') format('woff2'); }
  @font-face { font-family: 'Outfit'; font-style: normal; font-display: block; font-weight: 800; src: url('${outfit800Woff2}') format('woff2'); }
`;

type JsonLdValue = string | number | boolean | null | undefined | { [key: string]: JsonLdValue } | JsonLdValue[];

interface Props {
  title?: string;
  description?: string;
  image?: string | ImageMetadata | { src: ImageMetadata | string; title?: string; description?: string };
  type?: "website" | "article";
  pubDate?: Date | string;
  tags?: string[];
  hasMath?: boolean;
  preloadImage?: string;
  jsonLd?: Record<string, JsonLdValue> | Array<Record<string, JsonLdValue>>;
  lang?: string;
  inLanguage?: string;
  breadcrumbParentTitle?: string;
}

const { 
  title = "Dr. Georg Hackenberg | Professor for Industrial Informatics", 
  description = "Personal website of Dr. Georg Hackenberg, Full Professor for Industrial Informatics, software engineer, digital entrepreneur, and researcher.",
  image,
  type = "website",
  pubDate,
  tags,
  hasMath = false,
  preloadImage,
  jsonLd,
  lang,
  inLanguage,
  breadcrumbParentTitle
} = Astro.props;

const htmlLang = inLanguage || lang || "en";

// Determine active domain from the first URL path segment
const pathname = Astro.url.pathname;
const firstSegment = pathname.split('/').filter(Boolean)[0] || '';
const VALID_DOMAINS = ['posts', 'courses', 'publications', 'presentations', 'projects', 'services', 'visualizations', 'tags', 'newsletters'];
const activeDomain = VALID_DOMAINS.includes(firstSegment) ? firstSegment : undefined;

// Build canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// External profiles
const profiles = (await getCollection("profiles")).sort((a, b) => a.data.order - b.data.order);

// Resolve default OG image from .cache/branding/ with content hash
const { ogImagePath } = await ensureBrandingAssets();
const defaultOgHash = getFileContentHash(ogImagePath);
const defaultOgImageSrc = `/assets/branding/${getHashedFilename('og-share-preview.png', defaultOgHash)}`;
let resolvedImageSrc: string = defaultOgImageSrc;

if (image) {
  let targetImage: string | ImageMetadata = image as string | ImageMetadata;
  if (typeof image === 'object' && image !== null && 'src' in image && image.src) {
    targetImage = image.src;
  }
  if (typeof targetImage === 'string') {
    resolvedImageSrc = targetImage;
  } else if (typeof targetImage === 'object' && targetImage !== null && 'src' in targetImage) {
    if (targetImage.format === 'svg') {
      // SVGs are not supported for Open Graph / Twitter cards across platforms; fall back to default
      resolvedImageSrc = defaultOgImageSrc;
    } else {
      try {
        const optimizedCustomImage = await getImage({
          src: targetImage,
          format: 'jpeg',
          width: 1200,
          height: 630,
          quality: 85
        });
        resolvedImageSrc = optimizedCustomImage.src;
      } catch (e) {
        resolvedImageSrc = targetImage.src;
      }
    }
  }
}

// Build absolute OG image URL
const resolvedImageURL = new URL(
  resolvedImageSrc,
  Astro.site
);

// Format date for article metadata if available
let isoDate: string | undefined;
if (pubDate) {
  try {
    isoDate = pubDate instanceof Date ? pubDate.toISOString() : new Date(pubDate).toISOString();
  } catch (e) {
    console.error("Failed to parse pubDate for SEO metadata", e);
  }
}

// Resolve JSON-LD array and auto-compute Schema.org BreadcrumbList for non-root routes if not provided
const resolvedJsonLd: Array<Record<string, JsonLdValue>> = [];
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    resolvedJsonLd.push(...jsonLd);
  } else {
    resolvedJsonLd.push(jsonLd);
  }
}

const hasBreadcrumbList = resolvedJsonLd.some(
  (item) => item && (item["@type"] === "BreadcrumbList" || (Array.isArray(item["@type"]) && item["@type"].includes("BreadcrumbList")))
);

const pathnameSegments = Astro.url.pathname.replace(/^\/|\/$/g, "").split("/").filter(Boolean);

if (!hasBreadcrumbList && pathnameSegments.length > 0) {
  const SEGMENT_NAMES: Record<string, string> = {
    ...Object.fromEntries(CONTENT_DOMAINS.map((d) => [d, DOMAIN_METADATA[d].label])),
    about: "About",
    contact: "Contact",
    impressum: "Impressum",
    datenschutz: "Datenschutz"
  };

  const breadcrumbElements: Array<Record<string, JsonLdValue>> = [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": new URL("/", Astro.site || "https://hackenberg.tech").href.replace(/\/$/, "")
    }
  ];

  let accumulatedPath = "";
  pathnameSegments.forEach((seg, idx) => {
    accumulatedPath += `/${seg}`;
    const isLeaf = idx === pathnameSegments.length - 1;
    const segmentUrl = new URL(accumulatedPath + "/", Astro.site || "https://hackenberg.tech").href;

    if (isLeaf) {
      const cleanTitle = title ? title.split(" | ")[0].trim() : seg;
      breadcrumbElements.push({
        "@type": "ListItem",
        "position": idx + 2,
        "name": cleanTitle || seg,
        "item": canonicalURL.href
      });
    } else {
      const segName = (idx === 1 && pathnameSegments.length === 3 && breadcrumbParentTitle)
        ? breadcrumbParentTitle
        : (SEGMENT_NAMES[seg] || decodeURIComponent(seg).replace(/[-_]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()));
      breadcrumbElements.push({
        "@type": "ListItem",
        "position": idx + 2,
        "name": segName,
        "item": segmentUrl
      });
    }
  });

  resolvedJsonLd.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbElements
  });
}
---

<!DOCTYPE html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Flicker-free image load state (must run before any image is parsed) -->
    <PreviewMediaBoot />


    <script is:inline>
      // Add no-transitions class to prevent theme transition animation on load
      document.documentElement.classList.add('no-transitions');

      (function() {
        const urlParams = new URLSearchParams(window.location.search);
        const themeParam = urlParams.get('theme');
        let themeSetting = localStorage.getItem('theme') || 'system';

        if (themeParam === 'light' || themeParam === 'dark') {
          themeSetting = themeParam;
        }

        document.documentElement.setAttribute('data-theme-setting', themeSetting);

        var rawTags = urlParams.getAll('tag');
        var hasTag = rawTags.some(function(t) { return t.trim().length > 0; });
        var hasQ = Boolean((urlParams.get('q') || '').trim());
        var page = parseInt(urlParams.get('page') || '1', 10);
        if (hasTag || hasQ || page > 1) {
          document.documentElement.classList.add('has-filter-query');
        }
        if (hasTag) {
          document.documentElement.classList.add('has-active-tag-filter');
        }

        function applyTheme(setting, trigger) {
          let activeTheme = setting;
          if (setting === 'system') {
            const systemIsLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
            activeTheme = systemIsLight ? 'light' : 'dark';
          }

          if (activeTheme === 'light') {
            document.documentElement.classList.add('light');
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.remove('light');
            document.documentElement.classList.add('dark');
          }

          if (trigger) {
            window.dispatchEvent(new CustomEvent('theme-changed', { 
              detail: { 
                themeSetting: setting, 
                resolvedTheme: activeTheme, 
                trigger: trigger 
              } 
            }));
          }
        }
        window.applyThemeGlobal = applyTheme;

        applyTheme(themeSetting);

        // Listen to system preference changes
        if (window.matchMedia) {
          window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', function() {
            const currentSetting = localStorage.getItem('theme') || 'system';
            if (currentSetting === 'system') {
              applyTheme('system', 'system');
            }
          });
        }
      })();
    </script>
    
    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    
    <!-- PWA Web App Manifest -->
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.json`} />
    
    <!-- RSS Feed & Machine Discovery -->
    <link rel="alternate" type="application/rss+xml" title="Dr. Georg Hackenberg - RSS Feed" href={`${import.meta.env.BASE_URL}rss.xml`} />
    <link rel="author" href="https://hackenberg.tech/llms.txt" />
    
    <!-- Theme & Mobile Colors -->
    <meta name="theme-color" content="var(--color-bg-main)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    
    <!-- Meta Info -->
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="Cp7mdJpXJfZMzl80PESVj2Xb1uG37nSQB1rW0IqYYYw" />
    
    <!-- Primary SEO Meta Tags & Critical Asset Preloads -->
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <link rel="preload" href={outfit400Woff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={outfit500Woff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={outfit700Woff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={outfit800Woff2} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={criticalFontCss} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- JSON-LD Structured Data (SEO / GEO / AIO) -->
    {resolvedJsonLd.length > 0 && <JsonLd schema={resolvedJsonLd} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageURL} />
    <meta property="og:site_name" content="Dr. Georg Hackenberg" />
    <meta property="og:locale" content={lang === "de" ? "de_AT" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImageURL} />
    
    <!-- Article Specific Metadata -->
    {type === "article" && (
      <>
        {isoDate && <meta property="article:published_time" content={isoDate} />}
        <meta property="article:author" content="Dr. Georg Hackenberg" />
        {tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    

    <!-- Preview card image load indicator -->
    <PreviewMediaLoader />

    <!-- Telemetry & Semantic Tracking -->
    <Telemetry />

    <!-- KaTeX Math Styles -->
    {hasMath && <KaTeXStyles />}
    <script is:inline>
      // Remove no-transitions once the page is loaded, stylesheets are applied, and laid out
      (function() {
        function enableTransitions() {
          if (!document.documentElement.classList.contains('no-transitions')) return;
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              document.documentElement.classList.remove('no-transitions');
            });
          });
        }

        // Wait for stylesheets to load
        const links = Array.from(document.querySelectorAll('link[rel="stylesheet"]'));
        let pending = links.length;

        if (pending === 0) {
          // If in development mode, style tags might be injected dynamically, so add a small delay
          setTimeout(enableTransitions, 100);
        } else {
          links.forEach(link => {
            try {
              if (link.sheet) {
                pending--;
                return;
              }
            } catch (e) {}

            link.addEventListener('load', () => {
              pending--;
              if (pending === 0) enableTransitions();
            });
            link.addEventListener('error', () => {
              pending--;
              if (pending === 0) enableTransitions();
            });
          });
          if (pending === 0) {
            enableTransitions();
          }
        }

        // Fallbacks to guarantee transition enablement
        window.addEventListener('load', enableTransitions);
        setTimeout(enableTransitions, 1500);
      })();
    </script>
    {isDev && (
      <>
        <script is:inline>
          if (window.self !== window.top) {
            document.documentElement.classList.add('in-dev-frame');

            // --- Dev Frame URL, Query & Hash Two-Way Synchronization ---
            (function() {
              const origPushState = history.pushState.bind(history);
              const origReplaceState = history.replaceState.bind(history);

              function syncToTop(url, isPush) {
                if (!url) return;
                try {
                  const targetUrl = new URL(url.toString(), window.location.href);
                  const fullUrl = targetUrl.pathname + targetUrl.search + targetUrl.hash;
                  const topFull = (window.top?.location.pathname || '') + (window.top?.location.search || '') + (window.top?.location.hash || '');
                  if (topFull !== fullUrl) {
                    if (isPush) {
                      window.top?.history.pushState(null, '', fullUrl);
                    } else {
                      window.top?.history.replaceState(null, '', fullUrl);
                    }
                  }
                } catch {
                  window.parent.postMessage({ type: 'dev-studio-url-sync', url: String(url), push: isPush }, '*');
                }
              }

              history.pushState = function(state, unused, url) {
                origPushState(state, unused, url);
                syncToTop(url, true);
              };

              history.replaceState = function(state, unused, url) {
                origReplaceState(state, unused, url);
                syncToTop(url, false);
              };

              // Listen to hash changes in iframe (e.g. anchor clicks, TOC navigation)
              window.addEventListener('hashchange', function() {
                const fullUrl = window.location.pathname + window.location.search + window.location.hash;
                syncToTop(fullUrl, true);
                scrollToCurrentHash();
              });

              // Intercept anchor clicks on #hash links to ensure hash and pushState are preserved
              document.addEventListener('click', function(e) {
                const anchor = e.target && e.target.closest ? e.target.closest('a') : null;
                if (!anchor) return;
                const href = anchor.getAttribute('href');
                if (href && href.startsWith('#') && href.length > 1) {
                  const targetId = decodeURIComponent(href.slice(1));
                  const targetEl = document.getElementById(targetId);
                  if (targetEl) {
                    const fullUrl = window.location.pathname + window.location.search + href;
                    syncToTop(fullUrl, true);
                  }
                }
              }, true);

              // Auto-scroll to target element on initial load or popstate
              function scrollToCurrentHash() {
                if (!window.location.hash) return;
                const targetId = decodeURIComponent(window.location.hash.slice(1));
                if (!targetId) return;
                const el = document.getElementById(targetId);
                if (el) {
                  setTimeout(function() {
                    el.scrollIntoView({ behavior: 'smooth' });
                  }, 50);
                }
              }

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', scrollToCurrentHash);
              } else {
                scrollToCurrentHash();
              }
              window.addEventListener('load', scrollToCurrentHash);
              window.addEventListener('popstate', scrollToCurrentHash);
            })();
          } else {
            document.documentElement.classList.add('in-dev-studio');
          }
        </script>
        <style is:inline>
          /* When in Studio (top-level host window) */
          html.in-dev-studio,
          html.in-dev-studio body {
            overflow: hidden !important;
            height: 100vh !important;
            padding-top: 0 !important;
          }
          html.in-dev-studio body > #site-root,
          html.in-dev-studio body > #parallax-canvas,
          html.in-dev-studio body > #privacy-policy-modal-container,
          html.in-dev-studio body > #dev-analytics-container {
            display: none !important;
          }

          /* When inside the dev iframe */
          html.in-dev-frame body {
            padding-top: 0 !important;
          }
          html.in-dev-frame #dev-studio-root {
            display: none !important;
          }
          html.in-dev-frame #dev-analytics-hud {
            display: none !important;
          }
          /* Custom scrollbar elimination inside iframe while keeping native scroll */
          html.in-dev-frame, html.in-dev-frame body {
            scrollbar-width: none !important;
            -ms-overflow-style: none !important;
          }
          html.in-dev-frame::-webkit-scrollbar, html.in-dev-frame body::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
          }
        </style>
      </>
    )}
  </head>

  <body data-domain={activeDomain} class="text-gray-100 selection:bg-brand-primary selection:text-white min-h-screen flex flex-col relative antialiased">
    <!-- Parallax vector background with astronomical moon phases and day/night transitions -->
    <Background />

    <!-- Main site wrapper -->
    <div id="site-root" class="relative z-10 flex flex-col min-h-screen">
      <slot />

      <!-- Footer -->
      <footer class="w-full glass-panel border-t !border-x-0 !border-b-0 border-element-border py-12 md:py-16 text-sm text-gray-400 mt-auto relative z-10">
        <Container as="div" size="reading" padding="none">
          <NewsletterSignup variant="footer" />
        </Container>

        <Container as="div" size="wide" padding="none">
          <!-- Minimalist Footer Single-Bar (Variant 1A) -->
          <div class="flex flex-col min-[1100px]:flex-row items-center justify-between gap-6 text-xs text-text-subtle">
            <!-- Left: Copyright & Colophon -->
            <div class="flex flex-col items-center min-[1100px]:items-start gap-1 shrink-0 whitespace-nowrap">
              <p class="text-gray-400 light:text-slate-600 font-medium">&copy; {new Date().getFullYear()} Dr. Georg Hackenberg. All rights reserved.</p>
              <p class="text-xs text-text-subtle">
                Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-text-subtle hover:text-brand-primary underline underline-offset-2 decoration-gray-600 light:decoration-slate-400 transition-colors font-medium">Astro</a>, <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="text-text-subtle hover:text-brand-primary underline underline-offset-2 decoration-gray-600 light:decoration-slate-400 transition-colors font-medium">Tailwind CSS</a> &amp; <a href="https://antigravity.google" target="_blank" rel="noopener noreferrer" class="font-semibold heading-gradient-brand hover:opacity-80 transition-opacity">Antigravity</a>
              </p>
            </div>

            <!-- Center: External Profiles (6 glass icon buttons) -->
            <div class="flex items-center gap-2 shrink-0" aria-label="External Profiles">
              {profiles.map((profile) => (
                <a 
                  href={profile.data.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="w-9 h-9 rounded-full border border-element-border-medium bg-element-bg/50 hover:bg-element-bg hover:border-brand-primary/40 text-gray-400 hover:text-gray-100 light:text-slate-600 light:hover:text-brand-primary flex items-center justify-center transition-all duration-200 hover:scale-105" 
                  aria-label={`${profile.data.name} Profile`} 
                  title={profile.data.name}
                >
                  {profile.data.icon === "github" && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                  )}
                  {profile.data.icon === "linkedin" && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                    </svg>
                  )}
                  {profile.data.icon === "youtube" && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                  )}
                  {profile.data.icon === "scholar" && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
                    </svg>
                  )}
                  {profile.data.icon === "orcid" && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z"/>
                    </svg>
                  )}
                  {profile.data.icon === "wikidata" && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M1.5 4.5h2.25v15H1.5v-15zm3.375 0h1.125v15H4.875v-15zm2.25 0h2.25v15h-2.25v-15zm3.375 0h1.125v15H10.5v-15zm2.25 0h1.125v15H12.75v-15zm2.25 0h2.25v15H15v-15zm3.375 0h1.125v15h-1.125v-15zm2.25 0h1.875v15h-1.875v-15z"/>
                    </svg>
                  )}
                </a>
              ))}
            </div>

            <!-- Right: Legal, AI Feeds & Back-to-top -->
            <div class="flex flex-wrap items-center justify-center min-[1100px]:justify-end gap-x-4 gap-y-2 whitespace-nowrap">
              <a href="/impressum/" class="text-text-subtle hover:text-brand-primary/80 transition-colors">Impressum</a>
              <a href="/datenschutz/" class="text-text-subtle hover:text-brand-primary/80 transition-colors">Datenschutz</a>
              <span class="opacity-30 select-none" aria-hidden="true">|</span>
              <a href="/llms.txt" target="_blank" rel="noopener noreferrer" class="text-text-subtle hover:text-brand-primary/80 font-mono text-[11px] transition-colors" aria-label="LLMs.txt" title="Machine-readable summary for AI and LLMs">llms.txt</a>
              <a href="/llms-full.txt" target="_blank" rel="noopener noreferrer" class="text-text-subtle hover:text-brand-primary/80 font-mono text-[11px] transition-colors" aria-label="LLMs-full.txt" title="Full raw text corpus for AI and LLMs">llms-full.txt</a>
              <span class="opacity-30 select-none" aria-hidden="true">|</span>
              <a href="#" class="text-text-subtle hover:text-brand-primary/80 transition-colors">Back to top ↑</a>
            </div>
          </div>
        </Container>

      </footer>
    </div>

    <!-- Page Modals (e.g. SlideReferencesModal, PrivacyModal) -->
    <slot name="modals" />
    {isDev && (
      <>
        <DevStudioShell currentPath={Astro.url.pathname + (Astro.url.search || '')} />
        <AnalyticsDevOverlay />
      </>
    )}
  </body>
