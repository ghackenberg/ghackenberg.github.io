---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import { getCollection } from "astro:content";
import FilterToolbar from "@components/FilterToolbar.astro";
import CatalogPreFilter from "@components/CatalogPreFilter.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import ServiceCard from "@components/ServiceCard.astro";
import { buildCollectionPageSchema } from "@commons/server/json-ld";

const services = await getCollection("services");
const sortedServices = services.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Extract unique tags from all services
const tagsSet = new Set<string>();
for (const service of services) {
  if (service.data.tags) {
    service.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();
const itemTags = sortedServices.map(s => (s.data.tags || []).map(t => t.toLowerCase()));

const firstServiceImage = services.find(s => s.data.image)?.data.image;

const pageJsonLd = buildCollectionPageSchema("services", sortedServices.map((s) => ({ id: `https://hackenberg.tech/services/${s.id}/#service` })));
---

<Layout
  title="AI, Software & Content Engineering Services | Hackenberg"
  description="Bookable Sovereign AI, MCP server, software architecture & Astro content-engineering consulting in Austria & DACH by Dr. Georg Hackenberg."
  image={firstServiceImage}
  jsonLd={pageJsonLd}
>
  <Navbar />

  <Container size="wide">
    <Breadcrumbs domain="services" />

    <!-- Header -->
    <div class="mb-16">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-6">
        Engineering <span class="text-domain-services">Services</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Professional consulting and engineering services bridging sovereign artificial intelligence architectures, software systems, and digital publishing.
      </p>
    </div>

    <!-- Filter Toolbar -->
    <FilterToolbar
      searchId="service-search"
      searchPlaceholder="Search services..."
      tags={allTags}
      domain="services"
      itemTags={itemTags}
      totalCount={sortedServices.length}
      pageSize={12}
    />

    <!-- Services Grid (3-2-1) -->
    {sortedServices.length === 0 ? (
      <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No services defined.</p>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="services-grid">
          {sortedServices.map((service) => {
            const tagsJoined = (service.data.tags || []).join(" ").toLowerCase();
            return (
              <div
                id={service.id}
                class="service-card relative group h-full"
                data-title={service.data.title.toLowerCase()}
                data-desc={service.data.description.toLowerCase()}
                data-tags={tagsJoined}
              >
                <ServiceCard
                  id={service.id}
                  title={service.data.title}
                  description={service.data.description}
                  tags={service.data.tags}
                  image={service.data.image}
                  headingTag="h2"
                />
              </div>
            );
          })}
        </div>

        <CatalogPreFilter
          itemSelector=".service-card"
          noResultsId="no-services-message"
        />
      </>
    )}

    <p id="no-services-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
      No services match your selected filter criteria.
    </p>
  </Container>
</Layout>

<script>
  import { ClientListFilter } from "@commons/client/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".service-card",
      searchFieldSelector: "#service-search",
      searchDataAttributes: ["data-title", "data-desc", "data-tags"],
      searchParamKey: "q",
      resetButtonSelector: "#service-search-reset",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag",
          multiple: true
        }
      ],
      scrollToSelector: "#services-grid",
      noResultsSelector: "#no-services-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>
