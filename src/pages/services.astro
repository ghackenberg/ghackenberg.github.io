---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import FilterSidebar from "@components/FilterSidebar.astro";

const services = await getCollection("services");
const sortedServices = services.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Extract unique tags from all services
const tagsSet = new Set<string>();
for (const service of services) {
  if (service.data.tags) {
    service.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();

const optimizedServices = await Promise.all(
  sortedServices.map(async (service) => {
    let optimizedImageSrc = undefined;

    if (service.data.previewImage) {
      const img = service.data.previewImage.src;
      const optimized = await getImage({
        src: img,
        format: "webp",
        width: 800,
        quality: 80
      });
      optimizedImageSrc = optimized.src;
    }

    return {
      ...service,
      optimizedImageSrc
    };
  })
);



const servicesJsonLd = sortedServices.map(s => ({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `https://hackenberg.tech/services/#${s.id}`,
  "name": s.data.title,
  "serviceType": s.data.title,
  "description": s.data.description,
  "url": `https://hackenberg.tech/services/${s.id}/`,
  "provider": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech"
  },
  "areaServed": "Global"
}));

const firstServiceImage = services.find(s => s.data.previewImage)?.data.previewImage;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://hackenberg.tech/services/"
    }
  ]
};

const pageJsonLd = [breadcrumbSchema, ...servicesJsonLd];
---

<Layout 
  title="Business Services | Dr. Georg Hackenberg" 
  description="Explore specialized artificial intelligence and media publishing business services offered by Dr. Georg Hackenberg, covering sovereign AI technology stacks, system integration, agentic automation, channel definition, social media design systems, and content production."
  image={firstServiceImage}
  jsonLd={pageJsonLd}
>
  <Navbar />

  <Container size="wide">
    <!-- Header -->
    <div class="mb-16">

      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 mb-6">
        Business <span class="heading-gradient-purple">Services</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Bridging the gap between cutting-edge academic research, software engineering, and corporate practice. Discover specialized business services across sovereign artificial intelligence architectures and modern digital media publishing.
      </p>
    </div>


    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Filters Sidebar (Column 1) -->
      <FilterSidebar
        title="Filter Services"
        searchId="service-search"
        searchPlaceholder="Search services..."
        tags={allTags}
        accentColor="purple"
      />

      <!-- Services Grid (Column 2) -->
      <div class="lg:col-span-9 order-2 lg:order-1">
        {optimizedServices.length === 0 ? (
          <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No services defined.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 scroll-mt-28" id="services-grid">
            {optimizedServices.map((service) => {
              const tagsJoined = (service.data.tags || []).join(" ").toLowerCase();
              return (
                <div 
                  id={service.id} 
                  class="service-card scroll-mt-24 relative group h-full"
                  data-title={service.data.title.toLowerCase()}
                  data-desc={service.data.description.toLowerCase()}
                  data-tags={tagsJoined}
                >
                  <article class="glass-card preview-card border border-element-border relative flex flex-col h-full items-stretch p-0 cursor-pointer hover:border-element-border-medium transition-all duration-300" data-card-id={service.id} data-collection="services">
                    <!-- Card Clickable Overlay Link -->
                    <a 
                      href={`/services/${service.id}/`} 
                      class="absolute inset-0 z-10 cursor-pointer" 
                      aria-label={`View details for ${service.data.title}`}
                    ></a>

                    <!-- Preview Image Column (Top) -->
                    <div class="w-full aspect-video shrink-0 relative overflow-hidden bg-gray-950/40 border-b border-element-border">
                      {service.data.previewImage && (() => {
                        const img = service.data.previewImage.src;
                        const title = service.data.previewImage.title;
                        const desc = service.data.previewImage.description;
                        return (
                        <svg 
                          class="absolute inset-0 w-full h-full group-hover:scale-105 transition-transform duration-500 z-0 pointer-events-none" 
                          viewBox={`0 0 ${img.width} ${img.height}`} 
                          preserveAspectRatio="xMidYMid slice" 
                          role="img" 
                          aria-label={desc}
                        >
                          <defs>
                            <linearGradient id={`grad-service-dark-${service.id}`} x1="0" y1="0" x2="0" y2="1">
                              <stop offset="0%" stop-color="#000000" stop-opacity="0" />
                              <stop offset="50%" stop-color="#000000" stop-opacity="0.15" />
                              <stop offset="100%" stop-color="#000000" stop-opacity="0.75" />
                            </linearGradient>
                            <linearGradient id={`grad-service-light-${service.id}`} x1="0" y1="0" x2="0" y2="1">
                              <stop offset="0%" stop-color="#000000" stop-opacity="0" />
                              <stop offset="50%" stop-color="#000000" stop-opacity="0.10" />
                              <stop offset="100%" stop-color="#000000" stop-opacity="0.40" />
                            </linearGradient>
                          </defs>
                          <image 
                            role="img"
                            href={service.optimizedImageSrc || img.src} 
                            x="0" 
                            y="0" 
                            width={img.width} 
                            height={img.height} 
                            preserveAspectRatio="xMidYMid slice" 
                            {...{ title }}
                            aria-label={desc}
                          />
                          <rect 
                            x="0" 
                            y="0" 
                            width={img.width} 
                            height={img.height + 0.5} 
                            class="block light:hidden"
                            fill={`url(#grad-service-dark-${service.id})`} 
                          />
                          <rect 
                            x="0" 
                            y="0" 
                            width={img.width} 
                            height={img.height + 0.5} 
                            class="hidden light:block"
                            fill={`url(#grad-service-light-${service.id})`} 
                          />
                        </svg>
                      );
                      })()}
                      <div class="absolute inset-0 bg-gradient-to-t from-gray-950/40 via-transparent to-transparent pointer-events-none z-10"></div>

                      <!-- Unread badge -->
                      <span 
                        class="unread-dot hidden badge-new badge-new-purple badge-corner-tr"
                        data-item-url={`/services/${service.id}/`}
                        title="Unread service"
                      >UNREAD</span>
                    </div>

                    <!-- Info Body (Below) -->
                    <div class="preview-card-body flex flex-col flex-grow justify-between">
                      <div class="space-y-3">
                        <!-- Header -->
                        <div>
                          <h2 class="text-xl md:text-2xl font-extrabold text-gray-100 light:text-slate-900 tracking-tight leading-snug flex items-center gap-2 transition-colors group-hover:text-brand-purple light:group-hover:text-purple-600">
                            <span>{service.data.title}</span>
                          </h2>
                        </div>

                        <!-- Description -->
                        <p class="text-gray-300 light:text-slate-600 text-sm md:text-base leading-relaxed font-normal">
                          {service.data.description}
                        </p>

                        {service.data.tags && service.data.tags.length > 0 && (
                          <div class="flex flex-wrap gap-2 pt-1 relative z-20">
                            {service.data.tags.map((tag) => (
                              <a
                                href={`/tags/${tag}/`}
                                data-tag={tag}
                                class="tag-chip tag-chip-purple inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border relative z-20 hover:scale-105"
                              >
                                #{tag}
                              </a>
                            ))}
                          </div>
                        )}
                      </div>

                      <!-- Footer CTA Button -->
                      <div class="pt-6 mt-auto w-full relative z-20">
                        <a
                          href={`/services/${service.id}/`}
                          aria-label={`Read More: ${service.data.title}`}
                          class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-brand-purple/12 hover:bg-brand-purple/25 border border-brand-purple/20 hover:border-brand-purple/45 text-purple-300 light:text-purple-700 text-xs font-bold relative z-20 transition-all duration-200"
                        >
                          <span>Read More</span>
                          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                          </svg>
                        </a>
                      </div>
                    </div>

                  </article>
                </div>
              );
            })}
          </div>
        )}
        <p id="no-services-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
          No services match your selected filter criteria.
        </p>
      </div>
    </div>
  </Container>
</Layout>

<style>
  /* Markdown content styling for service layouts */
  .service-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 800;
    color: white;
    margin-top: 1.5rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
  }
  .service-content :global(h3:first-child) {
    margin-top: 0;
  }
  .service-content :global(h4) {
    font-size: 1.05rem;
    font-weight: 700;
    color: white;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .service-content :global(p) {
    font-size: 0.875rem;
    line-height: 1.7;
    color: #9ca3af; /* text-gray-400 */
    margin-bottom: 1.25rem;
  }
  .service-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
    color: #9ca3af;
  }
  .service-content :global(li) {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .service-content :global(li strong) {
    color: white;
  }
</style>

<script>
  import { ClientListFilter } from "@commons/client/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".service-card",
      searchFieldSelector: "#service-search",
      searchDataAttributes: ["data-title", "data-desc", "data-tags"],
      searchParamKey: "q",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag"
        }
      ],
      scrollToSelector: "#services-grid",
      noResultsSelector: "#no-services-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>
