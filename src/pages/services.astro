---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";

const services = await getCollection("services");
const sortedServices = services.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Extract unique tags from all services
const tagsSet = new Set<string>();
for (const service of services) {
  if (service.data.tags) {
    service.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();

const optimizedServices = await Promise.all(
  sortedServices.map(async (service) => {
    let optimizedImageSrc = undefined;

    if (service.data.previewImage) {
      const optimized = await getImage({
        src: service.data.previewImage,
        format: "webp",
        width: 800,
        quality: 80
      });
      optimizedImageSrc = optimized.src;
    }

    return {
      ...service,
      optimizedImageSrc
    };
  })
);



const servicesJsonLd = sortedServices.map(s => ({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `https://hackenberg.tech/services/#${s.id}`,
  "name": s.data.title,
  "serviceType": s.data.tagline,
  "description": s.data.description,
  "url": `https://hackenberg.tech/services/${s.id}/`,
  "provider": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech"
  },
  "areaServed": "Global"
}));

const firstServiceImage = services.find(s => s.data.previewImage)?.data.previewImage;
---

<Layout 
  title="Business Services | Dr. Georg Hackenberg, Professor for Industrial Informatics @ UAP Campus Wels" 
  description="Explore specialized artificial intelligence and media publishing business services offered by Dr. Georg Hackenberg, covering sovereign AI technology stacks, system integration, agentic automation, channel definition, social media design systems, and content production."
  image={firstServiceImage}
  jsonLd={servicesJsonLd}
>
  <Navbar />

  <main class="flex-grow max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-20 w-full relative z-10">
    <!-- Header -->
    <div class="mb-16">

      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 mb-6">
        Business <span class="heading-gradient-purple">Services</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Bridging the gap between cutting-edge academic research, software engineering, and corporate practice. Discover specialized business services across sovereign artificial intelligence architectures and modern digital media publishing.
      </p>
    </div>


    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Filters Sidebar (Column 1) -->
      <div class="lg:col-span-3 order-1 lg:order-2 lg:sticky lg:top-24">
        <div class="glass-card p-6 rounded-2xl border border-element-border flex flex-col lg:max-h-[calc(100vh-8rem)]">
          <div class="mb-4 shrink-0">
            <h2 class="text-lg font-bold flex items-center space-x-2">
              <span>⚙️</span>
              <span>Filter Services</span>
            </h2>
          </div>

          <!-- Text Search -->
          <div class="mb-4 shrink-0">
            <label for="service-search" class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block mb-2">Search</label>
            <div class="relative">
              <input 
                type="text" 
                id="service-search" 
                placeholder="Search services..." 
                class="w-full bg-element-bg border border-element-border-medium rounded-lg px-3 py-2 pl-8 text-xs text-gray-100 placeholder-gray-500 focus:outline-none focus:border-brand-purple/50 focus:ring-1 focus:ring-brand-purple/50 transition-all duration-200"
              />
              <span class="absolute left-2.5 top-2.5 text-xs text-gray-500">🔍</span>
            </div>
          </div>

          <!-- Technologies / Tags list -->
          <div class="flex-1 min-h-0 flex flex-col">
            <div class="flex items-center justify-between mb-2 shrink-0">
              <span class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block">Filter by Tag</span>
              <span class="text-[10px] text-gray-500 font-medium">{allTags.length} topics</span>
            </div>
            <div class="flex flex-wrap gap-1.5 max-h-[260px] lg:max-h-none flex-1 min-h-0 overflow-y-auto pr-1 custom-scrollbar-thin content-start" id="tag-filter-buttons">
              {allTags.map(tag => (
                <button 
                  type="button" 
                  class="tag-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold border cursor-pointer transition-all duration-200"
                  data-tag={tag}
                >
                  #{tag}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Services Grid (Column 2) -->
      <div class="lg:col-span-9 order-2 lg:order-1">
        {optimizedServices.length === 0 ? (
          <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No services defined.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 scroll-mt-28" id="services-grid">
            {optimizedServices.map((service) => {
              const tagsJoined = (service.data.tags || []).join(" ").toLowerCase();
              return (
                <section 
                  id={service.id} 
                  class="service-card scroll-mt-24 relative group h-full"
                  data-title={service.data.title.toLowerCase()}
                  data-tagline={service.data.tagline.toLowerCase()}
                  data-desc={service.data.description.toLowerCase()}
                  data-tags={tagsJoined}
                >
                  <div class="glass-card preview-card border border-element-border relative flex flex-col h-full items-stretch p-0 cursor-pointer hover:border-element-border-medium transition-all duration-300">
                    <!-- Card Clickable Overlay Link -->
                    <a 
                      href={`/services/${service.id}/`} 
                      class="absolute inset-0 z-10 cursor-pointer" 
                      aria-label={`View details for ${service.data.title}`}
                    ></a>

                    <!-- Preview Image Column (Top) -->
                    <div class="w-full aspect-video shrink-0 relative overflow-hidden bg-gray-950/40 border-b border-element-border">
                      {service.data.previewImage && (
                        <svg 
                          class="absolute inset-0 w-full h-full group-hover:scale-105 transition-transform duration-500 z-0 pointer-events-none" 
                          viewBox={`0 0 ${service.data.previewImage.width} ${service.data.previewImage.height}`} 
                          preserveAspectRatio="xMidYMid slice" 
                          role="img"
                          aria-label={`Service preview: ${service.data.title}`}
                        >
                          <defs>
                            <linearGradient id={`grad-service-dark-${service.id}`} x1="0" y1="0" x2="0" y2="1">
                              <stop offset="0%" stop-color="#000000" stop-opacity="0" />
                              <stop offset="50%" stop-color="#000000" stop-opacity="0.15" />
                              <stop offset="100%" stop-color="#000000" stop-opacity="0.75" />
                            </linearGradient>
                            <linearGradient id={`grad-service-light-${service.id}`} x1="0" y1="0" x2="0" y2="1">
                              <stop offset="0%" stop-color="#000000" stop-opacity="0" />
                              <stop offset="50%" stop-color="#000000" stop-opacity="0.10" />
                              <stop offset="100%" stop-color="#000000" stop-opacity="0.40" />
                            </linearGradient>
                          </defs>
                          <image 
                            href={service.optimizedImageSrc || service.data.previewImage.src} 
                            x="0" 
                            y="0" 
                            width={service.data.previewImage.width} 
                            height={service.data.previewImage.height} 
                            preserveAspectRatio="xMidYMid slice" 
                          />
                          <rect 
                            x="0" 
                            y="0" 
                            width={service.data.previewImage.width} 
                            height={service.data.previewImage.height + 0.5} 
                            class="block light:hidden"
                            fill={`url(#grad-service-dark-${service.id})`} 
                          />
                          <rect 
                            x="0" 
                            y="0" 
                            width={service.data.previewImage.width} 
                            height={service.data.previewImage.height + 0.5} 
                            class="hidden light:block"
                            fill={`url(#grad-service-light-${service.id})`} 
                          />
                        </svg>
                      )}
                      <div class="absolute inset-0 bg-gradient-to-t from-gray-950/40 via-transparent to-transparent pointer-events-none z-10"></div>

                      <!-- Unread badge -->
                      <span 
                        class="unread-dot hidden badge-new badge-new-purple badge-corner-tr"
                        data-item-url={`/services/${service.id}/`}
                        title="Unread service"
                      >UNREAD</span>
                    </div>

                    <!-- Info Body (Below) -->
                    <div class="preview-card-body flex flex-col flex-grow justify-between">
                      <div class="space-y-3">
                        <!-- Header -->
                        <div>
                          <h2 class="text-xl md:text-2xl font-extrabold text-gray-100 light:text-slate-900 tracking-tight leading-snug flex items-center gap-2 transition-colors group-hover:text-brand-purple light:group-hover:text-purple-600">
                            <span>{service.data.title}</span>
                          </h2>
                          <p class="text-brand-purple light:text-purple-700 font-bold text-xs uppercase tracking-wider mt-1">
                            {service.data.tagline}
                          </p>
                        </div>

                        <!-- Description -->
                        <p class="text-gray-300 light:text-slate-600 text-sm md:text-base leading-relaxed font-normal">
                          {service.data.description}
                        </p>

                        {service.data.tags && service.data.tags.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 pt-1 relative z-20">
                            {service.data.tags.map((tag) => (
                              <a
                                href={`/tags/${tag}/`}
                                data-tag={tag}
                                class="tag-chip tag-chip-purple inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border relative z-20 hover:scale-105"
                              >
                                #{tag}
                              </a>
                            ))}
                          </div>
                        )}
                      </div>

                      <!-- Footer CTA Button -->
                      <div class="pt-6 mt-auto w-full relative z-20">
                        <a
                          href={`/services/${service.id}/`}
                          class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-brand-purple/12 hover:bg-brand-purple/25 border border-brand-purple/20 hover:border-brand-purple/45 text-purple-300 light:text-brand-purple text-xs font-bold relative z-20 transition-all duration-200"
                        >
                          <span>Read More</span>
                          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                          </svg>
                        </a>
                      </div>
                    </div>

                  </div>
                </section>
              );
            })}
          </div>
        )}
        <p id="no-services-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
          No services match your selected filter criteria.
        </p>
      </div>
    </div>

    <!-- Contact & Booking Section -->
    <section id="contact-services" class="py-16 mt-16 border-t border-element-border scroll-mt-24">
      <div class="max-w-3xl mx-auto text-center mb-12">

        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-100 mb-4">
          Start a Conversation
        </h2>
        <p class="text-gray-400 text-sm md:text-base leading-relaxed">
          Select a service above or write directly to discuss educational partnerships, strategic advisory, or prototype developments.
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="glass-card p-8 md:p-10 rounded-3xl border border-element-border relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-brand-purple to-pink-500 light:to-pink-600"></div>
          
          <h3 class="text-lg font-bold text-gray-100 mb-6">Contact & Booking Inquiry</h3>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="text-brand-purple mt-1.5 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"></path>
                </svg>
              </div>
              <div class="flex-grow flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Send an email request to</p>
                  <p id="services-email-text" class="text-gray-100 font-mono font-medium mt-0.5 select-all text-sm sm:text-base">georg.hackenberg@fh-wels.at</p>
                </div>
                <button 
                  id="services-copy-email-btn"
                  class="px-4 py-2 text-xs font-semibold rounded-lg bg-element-bg hover:bg-element-bg-hover text-gray-300 hover:text-gray-100 border border-element-border-medium hover:border-element-border-hover transition-all duration-200 self-start sm:self-auto flex items-center space-x-2"
                >
                  <span id="services-copy-btn-text">Copy Email</span>
                </button>
              </div>
            </div>
            
            <div class="pt-6 border-t border-element-border flex flex-col sm:flex-row gap-4 justify-between items-center text-xs text-gray-400">
              <p>Typically responding within 2 business days.</p>
              <a 
                id="direct-mail-link"
                href="mailto:georg.hackenberg@fh-wels.at?subject=Services%20Inquiry"
                class="px-5 py-2.5 rounded-xl bg-brand-purple hover:bg-brand-purple/90 text-slate-950 font-bold transition-all duration-300 hover:scale-105 shadow-md shadow-brand-purple/20 light:bg-purple-600 light:hover:bg-purple-700 light:text-white"
              >
                Open Email Client &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* Markdown content styling for service layouts */
  .service-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 800;
    color: white;
    margin-top: 1.5rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
  }
  .service-content :global(h3:first-child) {
    margin-top: 0;
  }
  .service-content :global(h4) {
    font-size: 1.05rem;
    font-weight: 700;
    color: white;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .service-content :global(p) {
    font-size: 0.875rem;
    line-height: 1.7;
    color: #9ca3af; /* text-gray-400 */
    margin-bottom: 1.25rem;
  }
  .service-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.25rem;
    color: #9ca3af;
  }
  .service-content :global(li) {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .service-content :global(li strong) {
    color: white;
  }

  .tag-filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #9ca3af;
  }

  .tag-filter-btn:hover:not(.active) {
    border-color: rgba(168, 85, 247, 0.3);
    color: #c084fc;
    background: rgba(168, 85, 247, 0.08);
  }

  .tag-filter-btn.active {
    background: rgba(168, 85, 247, 0.2);
    border-color: rgba(168, 85, 247, 0.5);
    color: #d8b4fe;
    box-shadow: 0 0 15px -3px rgba(168, 85, 247, 0.25);
  }

  /* Light mode overrides */
  :global(.light) .tag-filter-btn {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.08);
    color: #475569;
  }

  :global(.light) .tag-filter-btn:hover:not(.active) {
    background: rgba(168, 85, 247, 0.06);
    border-color: rgba(168, 85, 247, 0.3);
    color: #7e22ce;
  }

  :global(.light) .tag-filter-btn.active {
    background: rgba(168, 85, 247, 0.15);
    border-color: rgba(168, 85, 247, 0.4);
    color: #7e22ce;
    box-shadow: 0 0 15px -3px rgba(168, 85, 247, 0.2);
  }
</style>

<script>
  import { ClientListFilter } from "../scripts/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".service-card",
      searchFieldSelector: "#service-search",
      searchDataAttributes: ["data-title", "data-tagline", "data-desc", "data-tags"],
      searchParamKey: "q",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag"
        }
      ],
      scrollToSelector: "#services-grid",
      noResultsSelector: "#no-services-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);

  // Add listeners to inquiry triggers to pre-fill email client link subject
  function initEmailHandlers() {
    const triggers = document.querySelectorAll('.inquiry-trigger');
    const directMailLink = document.getElementById('direct-mail-link') as HTMLAnchorElement | null;
    
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const subject = trigger.getAttribute('data-subject');
        if (directMailLink && subject) {
          directMailLink.href = `mailto:georg.hackenberg@fh-wels.at?subject=${encodeURIComponent(subject)}`;
        }
      });
    });

    // Copy Email Logic
    const copyBtn = document.getElementById('services-copy-email-btn');
    const emailText = document.getElementById('services-email-text');
    const copyBtnText = document.getElementById('services-copy-btn-text');

    if (copyBtn && emailText && copyBtnText) {
      copyBtn.addEventListener('click', () => {
        const email = emailText.textContent?.trim() || 'georg.hackenberg@fh-wels.at';
        
        navigator.clipboard.writeText(email).then(() => {
          copyBtnText.textContent = 'Copied!';
          copyBtn.classList.remove('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
          copyBtn.classList.add('bg-brand-green/20', 'text-brand-green', 'border-brand-green/30');
          
          setTimeout(() => {
            copyBtnText.textContent = 'Copy Email';
            copyBtn.classList.remove('bg-brand-green/20', 'text-brand-green', 'border-brand-green/30');
            copyBtn.classList.add('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
          }, 2500);
        }).catch(err => {
          console.error('Failed to copy: ', err);
        });
      });
    }
  }

  initEmailHandlers();
  document.addEventListener("astro:page-load", initEmailHandlers);
</script>
