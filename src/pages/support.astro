---
import Layout from "@layouts/Layout.astro";
import { buildSupportPageSchema } from "@commons/server/json-ld";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";

const pageTitle = "Support & Open-Source Patronage | Dr. Georg Hackenberg";
const pageDescription =
  "Support Dr. Georg Hackenberg's independent software frameworks, interactive WebGL/Canvas simulations, and university courseware via GitHub Sponsors.";

const pageJsonLd = buildSupportPageSchema({
  name: pageTitle,
  description: pageDescription,
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={pageJsonLd}
>
  <Navbar />

  <main class="w-full">
    <Section id="support" padding="standard">
      <Container size="wide" padding="none">
        <Breadcrumbs class="mb-6" />

        <!-- Level-1 Page Header & Answer-First Definition Block -->
        <div class="mb-12">
          <h1
            id="support-page-heading"
            class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-4"
          >
            Open-Source <span class="text-brand-primary">Support</span>
          </h1>
          <p
            id="support-page-subheading"
            class="text-gray-400 light:text-slate-600 text-base md:text-lg max-w-3xl font-normal leading-relaxed"
          >
            Independent software frameworks, interactive WebGL and Canvas simulations, slide-as-code university lectures, and in-depth technical engineering articles require continuous development and operational maintenance. GitHub Sponsors provides a direct channel to support the ongoing engineering, cloud infrastructure, and educational ecosystem behind this platform.
          </p>
        </div>

        <div class="space-y-16">
          <!-- Primary Hero Callout Card (Glassmorphic Patronage Banner) -->
          <div class="glass-card p-6 sm:p-8 md:p-10 rounded-3xl border border-element-border hover:border-brand-primary/30 relative overflow-hidden transition-all duration-300">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              <div class="lg:col-span-8 space-y-4">
                <h2
                  id="github-sponsors-banner-heading"
                  class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 leading-tight"
                >
                  Sustain Independent Software Engineering &amp; <span class="text-brand-primary">Digital Education</span>
                </h2>

                <p class="text-gray-300 light:text-slate-600 text-sm sm:text-base leading-relaxed max-w-2xl">
                  If my open-source libraries, industrial AI blueprints, interactive visualizers, or university lecture materials save your team engineering time or accelerate your learning, consider backing ongoing development through GitHub Sponsors.
                </p>
              </div>

              <!-- CTA Column -->
              <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center lg:items-end">
                <a
                  href="https://github.com/sponsors/ghackenberg"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track-event="High Intent: Sponsor Click"
                  data-track-location="support-hero"
                  class="w-full lg:w-auto min-w-[230px] px-6 py-3.5 rounded-2xl bg-brand-primary hover:bg-brand-primary/90 text-white font-bold text-sm inline-flex items-center justify-center gap-2.5 shadow-lg shadow-brand-primary/25 hover:shadow-brand-primary/40 transition-all duration-200 hover:scale-102 active:scale-95"
                >
                  <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                  </svg>
                  <span>Sponsor on GitHub</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Sub-Section 1: What Your Sponsorship Sustains -->
          <div>
            <div class="mb-8">
              <h2
                id="what-sponsorship-sustains-heading"
                class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3"
              >
                What Your Sponsorship <span class="text-brand-primary">Sustains</span>
              </h2>
              <p
                id="what-sponsorship-sustains-subheading"
                class="text-gray-400 light:text-slate-600 text-base md:text-lg max-w-3xl font-normal leading-relaxed"
              >
                Every contribution directly supports ongoing software maintenance, educational courseware production, and independent web infrastructure.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <!-- Pillar 1 -->
              <div class="glass-card p-6 md:p-8 rounded-3xl border border-element-border hover:border-brand-primary/30 transition-all duration-300 flex flex-col h-full">
                <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 border border-brand-primary/25 flex items-center justify-center text-brand-primary mb-5 shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                  </svg>
                </div>
                <h3
                  id="pillar-open-source-heading"
                  class="text-xl font-bold text-gray-100 light:text-slate-900 mb-3"
                >
                  Open-Source <span class="text-brand-primary">Frameworks</span>
                </h3>
                <p class="text-sm text-gray-400 light:text-slate-600 leading-relaxed flex-1">
                  Continuous maintenance, dependency security updates, and feature development across <a href="/projects/" class="text-brand-primary hover:underline font-medium">open-source software projects</a> in Python, TypeScript, and Java—spanning WebAssembly CAD kernels (<strong class="text-gray-200 light:text-slate-800">OpenCASCADE.js</strong>, <strong class="text-gray-200 light:text-slate-800">AgentBrick</strong>), discrete-event simulation (<strong class="text-gray-200 light:text-slate-800">SpineML</strong>), and optimization engines (<strong class="text-gray-200 light:text-slate-800">Smart Systems IDE</strong>).
                </p>
              </div>

              <!-- Pillar 2 -->
              <div class="glass-card p-6 md:p-8 rounded-3xl border border-element-border hover:border-brand-primary/30 transition-all duration-300 flex flex-col h-full">
                <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 border border-brand-primary/25 flex items-center justify-center text-brand-primary mb-5 shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-5.25 6.557c0 1.5 2.35 2.7 5.25 2.7s5.25-1.2 5.25-2.7" />
                  </svg>
                </div>
                <h3
                  id="pillar-open-education-heading"
                  class="text-xl font-bold text-gray-100 light:text-slate-900 mb-3"
                >
                  Educational <span class="text-brand-primary">Resources</span>
                </h3>
                <p class="text-sm text-gray-400 light:text-slate-600 leading-relaxed flex-1">
                  Production of self-contained university courseware, interactive Slide-as-Code lecture decks with synchronized voiceover synthesis, and dual-theme PDF study handouts for students, educators, and practicing engineers.
                </p>
              </div>

              <!-- Pillar 3 -->
              <div class="glass-card p-6 md:p-8 rounded-3xl border border-element-border hover:border-brand-primary/30 transition-all duration-300 flex flex-col h-full">
                <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 border border-brand-primary/25 flex items-center justify-center text-brand-primary mb-5 shrink-0">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                  </svg>
                </div>
                <h3
                  id="pillar-infrastructure-heading"
                  class="text-xl font-bold text-gray-100 light:text-slate-900 mb-3"
                >
                  Independent <span class="text-brand-primary">Infrastructure</span>
                </h3>
                <p class="text-sm text-gray-400 light:text-slate-600 leading-relaxed flex-1">
                  Cloud hosting, automated build and verification pipelines, domain operations, and browser-native WebGL/Canvas simulations engineered with strict GDPR/DSGVO privacy compliance and zero third-party ad tracking.
                </p>
              </div>
            </div>
          </div>

          <!-- Sub-Section 2: Ways to Support & Collaborate -->
          <div>
            <div class="mb-8">
              <h2
                id="ways-to-support-heading"
                class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3"
              >
                Ways to Support &amp; <span class="text-brand-primary">Collaborate</span>
              </h2>
              <p
                id="ways-to-support-subheading"
                class="text-gray-400 light:text-slate-600 text-base md:text-lg max-w-3xl font-normal leading-relaxed"
              >
                Choose between individual community patronage, corporate team sponsorship via GitHub, or direct B2B engineering advisory with contractual SLAs.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <!-- Tier 1: Individual Patronage -->
              <div class="glass-card p-6 md:p-8 rounded-3xl border border-element-border hover:border-brand-primary/30 transition-all duration-300 flex flex-col justify-between h-full">
                <div>
                  <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 border border-brand-primary/25 flex items-center justify-center text-brand-primary mb-5 shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                  </div>
                  <h3
                    id="tier-individual-heading"
                    class="text-xl font-bold text-gray-100 light:text-slate-900 mb-3"
                  >
                    Individual <span class="text-brand-primary">Patronage</span>
                  </h3>
                  <p class="text-sm text-gray-400 light:text-slate-600 leading-relaxed mb-6">
                    Flexible one-time micro-sponsorships or recurring monthly contributions via GitHub Sponsors. Ideal for developers, students, and researchers who benefit from open-source packages, lecture slides, or engineering deep-dives.
                  </p>
                </div>

                <div class="pt-5 border-t border-element-border/50 mt-auto">
                  <a
                    href="https://github.com/sponsors/ghackenberg"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track-event="High Intent: Sponsor Click"
                    data-track-location="support-tier-individual"
                    class="w-full py-2.5 px-4 rounded-xl bg-brand-primary/15 hover:bg-brand-primary text-brand-primary hover:text-white border border-brand-primary/30 font-semibold text-xs sm:text-sm inline-flex items-center justify-center gap-2 transition-all duration-200"
                  >
                    <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                    </svg>
                    <span>Back as an Individual</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>

              <!-- Tier 2: Organization & Team Sponsorship -->
              <div class="glass-card p-6 md:p-8 rounded-3xl border border-element-border hover:border-brand-primary/30 transition-all duration-300 flex flex-col justify-between h-full">
                <div>
                  <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 border border-brand-primary/25 flex items-center justify-center text-brand-primary mb-5 shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                    </svg>
                  </div>
                  <h3
                    id="tier-organization-heading"
                    class="text-xl font-bold text-gray-100 light:text-slate-900 mb-3"
                  >
                    Organization <span class="text-brand-primary">Sponsorship</span>
                  </h3>
                  <p class="text-sm text-gray-400 light:text-slate-600 leading-relaxed mb-6">
                    Sustaining sponsorship for engineering teams and enterprises building upon open-source repositories or training materials. GitHub Sponsors supports automated corporate billing, consolidated invoices, and public organization attribution.
                  </p>
                </div>

                <div class="pt-5 border-t border-element-border/50 mt-auto">
                  <a
                    href="https://github.com/sponsors/ghackenberg"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track-event="High Intent: Sponsor Click"
                    data-track-location="support-tier-organization"
                    class="w-full py-2.5 px-4 rounded-xl bg-brand-primary/15 hover:bg-brand-primary text-brand-primary hover:text-white border border-brand-primary/30 font-semibold text-xs sm:text-sm inline-flex items-center justify-center gap-2 transition-all duration-200"
                  >
                    <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                    </svg>
                    <span>Sponsor as an Organization</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>

              <!-- Tier 3: Industrial R&D & Advisory Services -->
              <div class="glass-card p-6 md:p-8 rounded-3xl border border-element-border hover:border-brand-primary/30 transition-all duration-300 flex flex-col justify-between h-full">
                <div>
                  <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 border border-brand-primary/25 flex items-center justify-center text-brand-primary mb-5 shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
                    </svg>
                  </div>
                  <h3
                    id="tier-enterprise-heading"
                    class="text-xl font-bold text-gray-100 light:text-slate-900 mb-3"
                  >
                    Industrial R&amp;D &amp; <span class="text-brand-primary">Advisory</span>
                  </h3>
                  <p class="text-sm text-gray-400 light:text-slate-600 leading-relaxed mb-6">
                    Require dedicated architecture reviews, custom industrial AI and simulation engineering, executive workshops, or joint academic-industrial research with formal deliverables? Engage directly through B2B consulting services.
                  </p>
                </div>

                <div class="pt-5 border-t border-element-border/50 mt-auto">
                  <a
                    href="/services/"
                    class="w-full py-2.5 px-4 rounded-xl bg-brand-primary/15 hover:bg-brand-primary text-brand-primary hover:text-white border border-brand-primary/30 font-semibold text-xs sm:text-sm inline-flex items-center justify-center gap-2 transition-all duration-200"
                  >
                    <span>Explore B2B Services</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Sub-Section 3: Non-Financial Contributions -->
          <div>
            <div class="mb-8">
              <h2
                id="community-support-heading"
                class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3"
              >
                Non-Financial <span class="text-brand-primary">Contributions</span>
              </h2>
              <p
                id="community-support-subheading"
                class="text-gray-400 light:text-slate-600 text-base md:text-lg max-w-3xl font-normal leading-relaxed"
              >
                Community engagement, code contributions, and academic citations amplify the impact of open-source research just as much as financial backing.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              <a
                href="https://github.com/ghackenberg"
                target="_blank"
                rel="noopener noreferrer"
                class="glass-card p-6 rounded-2xl border border-element-border hover:border-brand-primary/40 hover:shadow-lg hover:shadow-brand-primary/5 transition-all duration-300 flex flex-col group h-full"
              >
                <div class="flex items-center justify-between mb-4">
                  <div class="w-12 h-12 rounded-xl bg-element-bg border border-element-border-medium flex items-center justify-center text-gray-400 group-hover:text-brand-primary group-hover:border-brand-primary/40 group-hover:bg-brand-primary/10 transition-all duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                    </svg>
                  </div>
                  <svg class="w-4 h-4 text-gray-500 group-hover:text-brand-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                  </svg>
                </div>
                <h3
                  id="community-star-heading"
                  class="text-base font-bold text-gray-100 group-hover:text-brand-primary transition-colors mb-2"
                >
                  Star &amp; Fork Repositories
                </h3>
                <p class="text-xs text-gray-400 light:text-slate-600 leading-relaxed mt-auto">
                  Starring repositories on GitHub boosts visibility and helps fellow engineers discover open-source tools.
                </p>
              </a>

              <a
                href="https://github.com/ghackenberg"
                target="_blank"
                rel="noopener noreferrer"
                class="glass-card p-6 rounded-2xl border border-element-border hover:border-brand-primary/40 hover:shadow-lg hover:shadow-brand-primary/5 transition-all duration-300 flex flex-col group h-full"
              >
                <div class="flex items-center justify-between mb-4">
                  <div class="w-12 h-12 rounded-xl bg-element-bg border border-element-border-medium flex items-center justify-center text-gray-400 group-hover:text-brand-primary group-hover:border-brand-primary/40 group-hover:bg-brand-primary/10 transition-all duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                    </svg>
                  </div>
                  <svg class="w-4 h-4 text-gray-500 group-hover:text-brand-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                  </svg>
                </div>
                <h3
                  id="community-contribute-heading"
                  class="text-base font-bold text-gray-100 group-hover:text-brand-primary transition-colors mb-2"
                >
                  Submit Issues &amp; PRs
                </h3>
                <p class="text-xs text-gray-400 light:text-slate-600 leading-relaxed mt-auto">
                  Report edge cases, contribute pull requests, or improve documentation across active software projects.
                </p>
              </a>

              <a
                href="/publications/"
                class="glass-card p-6 rounded-2xl border border-element-border hover:border-brand-primary/40 hover:shadow-lg hover:shadow-brand-primary/5 transition-all duration-300 flex flex-col group h-full"
              >
                <div class="flex items-center justify-between mb-4">
                  <div class="w-12 h-12 rounded-xl bg-element-bg border border-element-border-medium flex items-center justify-center text-gray-400 group-hover:text-brand-primary group-hover:border-brand-primary/40 group-hover:bg-brand-primary/10 transition-all duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
