---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import TagChip from "@components/TagChip.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const interests = await getCollection("interests");
  return interests.map((interest) => ({
    params: { slug: interest.id },
    props: { interest },
  }));
}

const { interest } = Astro.props;
const { Content } = await render(interest);



const tags = interest.data.tags || [];

const interestUrl = `https://hackenberg.tech/interests/${interest.id}/`;

const interestSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${interestUrl}#webpage`,
  "name": `${interest.data.title} - Professional Interests | Dr. Georg Hackenberg, Professor for Industrial Informatics @ UAP / FH Upper Austria Technology Campus Wels`,
  "description": interest.data.description,
  "url": interestUrl,
  "author": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech",
    "sameAs": "https://www.wikidata.org/wiki/Q141537961"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About",
      "item": "https://hackenberg.tech/about/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": interest.data.title,
      "item": interestUrl
    }
  ]
};

const pageJsonLd = [interestSchema, breadcrumbSchema];
---

<Layout 
  title={`${interest.data.title} | Dr. Georg Hackenberg`}
  description={interest.data.description}
  image={interest.data.heroImage}
  jsonLd={pageJsonLd}
>
  <Navbar />

  <Section id="interest-content" padding="standard">
    <Container size="reading" padding="none">
    
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs 
      items={[
        { label: "Home", href: "/" },
        { label: "About", href: "/about/" },
        { label: interest.data.title }
      ]}
      domain="interests"
    />

    <!-- Hero Header -->
    <header class="mb-14">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-4 leading-tight">
          {interest.data.title}
        </h1>

        <p class="text-gray-300 text-base sm:text-lg leading-relaxed font-normal mb-6">
          {interest.data.description}
        </p>

        {interest.data.tags && interest.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {interest.data.tags.map((tag) => (
              <TagChip tag={tag} />
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Detailed Content Card -->
    <div class="glass-card p-6 sm:p-10 md:p-12 rounded-3xl border border-domain-interests/20 interest-content prose-custom">
      <Content />
    </div>
    </Container>
  </Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="interests" 
    currentId={interest.id} 
    tags={tags} 
  />
</Layout>

<style>
  /* Markdown content styling for interest articles */
  .interest-content :global(h2) {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-heading);
    margin-top: 2rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 0.4rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .interest-content :global(h2:first-child) {
    margin-top: 0;
  }
  .interest-content :global(h3) {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 1.6rem;
    margin-bottom: 0.75rem;
    transition: color 0.5s ease;
  }
  .interest-content :global(h4) {
    font-size: 1.03125rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    line-height: 1.45;
    transition: color 0.5s ease;
  }
  .interest-content :global(p) {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
    transition: color 0.5s ease;
  }
  .interest-content :global(p:first-of-type) {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.65;
    color: var(--color-text-heading);
    border-left: 3px solid var(--glow-text, var(--color-domain-interests));
    padding-left: 1rem;
    margin-bottom: 1.5rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .interest-content :global(ul) {
    list-style-type: none;
    padding-left: 0;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .interest-content :global(li) {
    position: relative;
    margin-bottom: 0;
    font-size: 0.9375rem;
    line-height: 1.75;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 0.85rem 1.25rem 0.85rem 2.25rem;
    border-radius: 12px;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  :global(.light) .interest-content :global(li) {
    background: rgba(15, 23, 42, 0.02);
    border-color: rgba(15, 23, 42, 0.06);
  }
  .interest-content :global(li:hover) {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
  }
  :global(.light) .interest-content :global(li:hover) {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.1);
  }
  .interest-content :global(li::before) {
    content: "✦";
    position: absolute;
    left: 0.85rem;
    top: 0.85rem;
    color: var(--glow-text, var(--color-domain-interests));
    font-weight: bold;
    line-height: 1.75;
  }
  .interest-content :global(li strong) {
    color: var(--color-text-heading);
    font-weight: 700;
    margin-right: 0.2rem;
    transition: color 0.5s ease;
  }
  .interest-content :global(> *:last-child) {
    margin-bottom: 0;
  }

  .interest-content :global(img) {
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    background-color: var(--color-bg-main);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .interest-content :global(img:hover) {
    border-color: rgba(255, 255, 255, 0.25);
  }
  .interest-content :global(p:has(> em:only-child)) {
    text-align: center;
    margin-top: -0.25rem;
    margin-bottom: 2.25rem;
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  .interest-content {
    --glow-text: var(--color-domain-interests);
  }
  :global(.light) .interest-content {
    --glow-text: var(--color-domain-interests);
  }
</style>
