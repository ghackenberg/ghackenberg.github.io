---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import ProjectCard from "@components/ProjectCard.astro";
import FilterSidebar from "@components/FilterSidebar.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Extract unique tags from all projects
const tagsSet = new Set<string>();
for (const project of projects) {
  if (project.data.tags) {
    project.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();
const firstProjectScreenshot = sortedProjects.find(p => p.data.screenshot)?.data.screenshot;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Projects",
      "item": "https://hackenberg.tech/projects/"
    }
  ]
};
---

<Layout 
  title="Software Projects | Dr. Georg Hackenberg" 
  description="Explore software engineering projects, open-source systems, and interactive tools designed and built by Dr. Georg Hackenberg."
  image={firstProjectScreenshot}
  jsonLd={breadcrumbSchema}
>
  <Navbar />

  <Container size="wide">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
        Software <span class="heading-gradient-blue">Projects</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Active platforms, frameworks, and tools designed to optimize product design, engineering, knowledge graphs, and real-time physical simulation.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Filters Sidebar (Column 1) -->
      <FilterSidebar
        title="Filter Projects"
        searchId="project-search"
        searchPlaceholder="Search projects..."
        tags={allTags}
        accentColor="blue"
      />

      <!-- Projects Grid (Column 2) -->
      <div class="lg:col-span-9 order-2 lg:order-1">
        {sortedProjects.length === 0 ? (
          <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No projects defined.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 scroll-mt-28" id="projects-grid">
            {sortedProjects.map(project => {
              const tagsJoined = (project.data.tags || []).join(" ").toLowerCase();
              return (
                <div 
                  class="project-wrapper h-full"
                  data-title={project.data.title.toLowerCase()}
                  data-tagline={project.data.tagline.toLowerCase()}
                  data-desc={project.data.description.toLowerCase()}
                  data-tags={tagsJoined}
                >
                  <ProjectCard 
                    title={project.data.title}
                    tagline={project.data.tagline}
                    description={project.data.description}
                    href={`/projects/${project.id}/`}
                    tags={project.data.tags}
                    accentColor={project.data.accentColor}
                    screenshot={project.data.screenshot}
                    screenshotLight={project.data.screenshotLight}
                  />
                </div>
              );
            })}
          </div>
        )}
        <p id="no-projects-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
          No projects match your selected filter criteria.
        </p>
      </div>
    </div>
  </Container>
</Layout>

<script>
  import { ClientListFilter } from "@commons/client/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".project-wrapper",
      searchFieldSelector: "#project-search",
      searchDataAttributes: ["data-title", "data-tagline", "data-desc", "data-tags"],
      searchParamKey: "q",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag"
        }
      ],
      scrollToSelector: "#projects-grid",
      noResultsSelector: "#no-projects-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>

