---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import ProjectCard from "@components/ProjectCard.astro";
import FilterSidebar from "@components/FilterSidebar.astro";
import TrlCircle from "@components/TrlCircle.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => {
  const trlDiff = b.data.trl - a.data.trl;
  if (trlDiff !== 0) return trlDiff;
  return a.data.title.localeCompare(b.data.title);
});

// Extract unique tags from all projects
const tagsSet = new Set<string>();
for (const project of projects) {
  if (project.data.tags) {
    project.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();
const allTrls = Array.from(new Set(sortedProjects.map(p => p.data.trl))).sort((a, b) => b - a);
const firstProjectScreenshot = sortedProjects.find(p => p.data.screenshot)?.data.screenshot;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Projects",
      "item": "https://hackenberg.tech/projects/"
    }
  ]
};
---

<Layout 
  title="Software Projects | Dr. Georg Hackenberg" 
  description="Explore software engineering projects, open-source systems, and interactive tools designed and built by Dr. Georg Hackenberg."
  image={firstProjectScreenshot}
  jsonLd={breadcrumbSchema}
>
  <Navbar />

  <Container size="wide">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
        Software <span class="heading-gradient-blue">Projects</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Active platforms, frameworks, and tools designed to optimize product design, engineering, knowledge graphs, and real-time physical simulation.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Filters Sidebar (Column 1) -->
      <FilterSidebar
        title="Filter Projects"
        searchId="project-search"
        searchPlaceholder="Search projects..."
        tags={allTags}
        accentColor="blue"
      >
        <!-- Technology Readiness Level -->
        <div class="mb-4 shrink-0">
          <span class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block mb-2">Technology Readiness Level</span>
          <div class="flex flex-wrap gap-2">
            {allTrls.map(level => (
              <button 
                id={`trl-btn-${level}`}
                class="trl-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold border cursor-pointer transition-all duration-200 inline-flex items-center gap-1.5"
                data-trl={level.toString()}
              >
                <span>TRL {level}</span>
                <TrlCircle level={level} accentColor="blue" size={13} />
              </button>
            ))}
          </div>
        </div>
      </FilterSidebar>

      <!-- Projects Grid (Column 2) -->
      <div class="lg:col-span-9 order-2 lg:order-1">
        {sortedProjects.length === 0 ? (
          <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No projects defined.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
            {sortedProjects.map(project => {
              const tagsJoined = (project.data.tags || []).join(" ").toLowerCase();
              return (
                <div 
                  class="project-wrapper h-full"
                  data-title={project.data.title.toLowerCase()}
                  data-trl={project.data.trl.toString()}
                  data-desc={project.data.description.toLowerCase()}
                  data-tags={tagsJoined}
                >
                  <ProjectCard 
                    title={project.data.title}
                    trl={project.data.trl}
                    description={project.data.description}
                    href={`/projects/${project.id}/`}
                    tags={project.data.tags}
                    accentColor={project.data.accentColor}
                    screenshot={project.data.screenshot}
                    screenshotLight={project.data.screenshotLight}
                  />
                </div>
              );
            })}
          </div>
        )}
        <p id="no-projects-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
          No projects match your selected filter criteria.
        </p>
      </div>
    </div>
  </Container>
</Layout>

<style>
  /* Custom filter active states matching design guidelines */
  .trl-filter-btn {
    position: relative;
    background: rgba(31, 41, 55, 0.4);
    border-color: rgba(255, 255, 255, 0.05);
    color: #9ca3af; /* text-gray-400 */
  }

  .trl-filter-btn.active {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    color: #60a5fa; /* text-blue-400 */
    box-shadow: 0 0 15px -3px rgba(59, 130, 246, 0.25);
  }

  .trl-filter-btn:hover:not(.active) {
    border-color: rgba(59, 130, 246, 0.3);
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.08);
  }

  /* Light mode overrides */
  :global(.light) .trl-filter-btn {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.08);
    color: #475569; /* slate-600 */
  }

  :global(.light) .trl-filter-btn.active {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    color: #1d4ed8; /* blue-700 */
    box-shadow: 0 0 15px -3px rgba(59, 130, 246, 0.2);
  }

  :global(.light) .trl-filter-btn:hover:not(.active) {
    background: rgba(59, 130, 246, 0.06);
    border-color: rgba(59, 130, 246, 0.3);
    color: #1d4ed8; /* blue-700 */
  }
</style>

<script>
  import { ClientListFilter } from "@commons/client/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".project-wrapper",
      searchFieldSelector: "#project-search",
      searchDataAttributes: ["data-title", "data-desc", "data-tags"],
      searchParamKey: "q",
      buttonFilters: [
        {
          buttonSelector: ".trl-filter-btn",
          dataAttribute: "data-trl",
          defaultValue: "all",
          activeClass: "active",
          paramKey: "trl"
        },
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag"
        }
      ],
      scrollToSelector: "#projects-grid",
      noResultsSelector: "#no-projects-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>

