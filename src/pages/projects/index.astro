---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Extract unique tags from all projects
const tagsSet = new Set<string>();
for (const project of projects) {
  if (project.data.tags) {
    project.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();
const firstProjectScreenshot = sortedProjects.find(p => p.data.screenshot)?.data.screenshot;
---

<Layout 
  title="Software Projects | Dr. Georg Hackenberg, Professor for Industrial Informatics @ UAP Campus Wels" 
  description="Explore software engineering projects, open-source systems, and interactive tools designed and built by Dr. Georg Hackenberg."
  image={firstProjectScreenshot}
>
  <Navbar />

  <main class="flex-grow max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-20 w-full relative z-10">
    <!-- Header -->
    <div class="mb-12">

      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
        Software <span class="heading-gradient-blue">Projects</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Active platforms, frameworks, and tools designed to optimize product design, engineering, knowledge graphs, and real-time physical simulation.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Filters Sidebar (Column 1) -->
      <div class="lg:col-span-3 order-1 lg:order-2 lg:sticky lg:top-24">
        <div class="glass-card p-6 rounded-2xl border border-element-border flex flex-col">
          <h2 class="text-lg font-bold mb-4 flex items-center space-x-2 shrink-0">
            <span>⚙️</span>
            <span>Filter Projects</span>
          </h2>

          <!-- Text Search -->
          <div class="mb-4">
            <label for="project-search" class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block mb-2">Search</label>
            <div class="relative">
              <input 
                type="text" 
                id="project-search" 
                placeholder="Search projects..." 
                class="w-full bg-element-bg border border-element-border-medium rounded-lg px-3 py-2 pl-8 text-xs placeholder-gray-500 focus:outline-none focus:border-brand-blue/50 focus:ring-1 focus:ring-brand-blue/50 transition-all duration-200"
              />
              <span class="absolute left-2.5 top-2.5 text-xs text-gray-500">🔍</span>
            </div>
          </div>

          <!-- Technologies / Tags list -->
          <div class="mb-2">
            <span class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block mb-2">Filter by Tag</span>
            <div class="flex flex-wrap gap-1.5" id="tag-filter-buttons">
              {allTags.map(tag => (
                <button 
                  type="button" 
                  class="tag-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold border cursor-pointer transition-all duration-200"
                  data-tag={tag}
                >
                  #{tag}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Projects Grid (Column 2) -->
      <div class="lg:col-span-9 order-2 lg:order-1">
        {sortedProjects.length === 0 ? (
          <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No projects defined.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
            {sortedProjects.map(project => {
              const tagsJoined = (project.data.tags || []).join(" ").toLowerCase();
              return (
                <div 
                  class="project-wrapper h-full"
                  data-title={project.data.title.toLowerCase()}
                  data-tagline={project.data.tagline.toLowerCase()}
                  data-desc={project.data.description.toLowerCase()}
                  data-tags={tagsJoined}
                >
                  <ProjectCard 
                    title={project.data.title}
                    tagline={project.data.tagline}
                    description={project.data.description}
                    href={`/projects/${project.id}`}
                    tags={project.data.tags}
                    accentColor={project.data.accentColor}
                    screenshot={project.data.screenshot}
                    screenshotLight={project.data.screenshotLight}
                  />
                </div>
              );
            })}
          </div>
        )}
        <p id="no-projects-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
          No projects match your selected filter criteria.
        </p>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { ClientListFilter } from "../../scripts/filter";

  new ClientListFilter({
    itemSelector: ".project-wrapper",
    searchFieldSelector: "#project-search",
    searchDataAttributes: ["data-title", "data-tagline", "data-desc", "data-tags"],
    buttonFilters: [
      {
        buttonSelector: ".tag-filter-btn",
        dataAttribute: "data-tags",
        defaultValue: "all",
        activeClass: "active",
        matchType: "includes"
      }
    ],
    noResultsSelector: "#no-projects-message"
  });
</script>

<style>
  .tag-filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #9ca3af;
  }

  .tag-filter-btn:hover:not(.active) {
    border-color: rgba(59, 130, 246, 0.3);
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.08);
  }

  .tag-filter-btn.active {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
    color: #7dd3fc;
    box-shadow: 0 0 15px -3px rgba(59, 130, 246, 0.25);
  }

  /* Light mode overrides */
  :global(.light) .tag-filter-btn {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.08);
    color: #475569;
  }

  :global(.light) .tag-filter-btn:hover:not(.active) {
    background: rgba(59, 130, 246, 0.06);
    border-color: rgba(59, 130, 246, 0.3);
    color: #1d4ed8;
  }

  :global(.light) .tag-filter-btn.active {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    color: #1d4ed8;
    box-shadow: 0 0 15px -3px rgba(59, 130, 246, 0.2);
  }
</style>
