---
const mode = Astro.url.searchParams.get('mode') || 'transparent';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Icon Generator</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
      }

      .icon-wrapper {
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      /* Standard transparent container (for browser tab favicons - minimal padding, maximal size) */
      .icon-wrapper.mode-transparent {
        background: transparent;
      }

      .icon-wrapper.mode-transparent svg {
        width: 100%;
        height: 100%;
      }

      /* App icon container (for Apple Touch Icon & PWA icons: full-bleed plain Soft Sage) */
      .icon-wrapper.mode-app {
        background: #469b84;
      }

      .icon-wrapper.mode-app #ht-bg {
        display: none;
      }

      .icon-wrapper.mode-app svg {
        width: 92%;
        height: 92%;
      }

      /* Maskable icon container (for Android/PWA adaptive icons: centered inside safe zone) */
      .icon-wrapper.mode-maskable {
        background: #469b84;
      }

      .icon-wrapper.mode-maskable #ht-bg {
        display: none;
      }

      .icon-wrapper.mode-maskable svg {
        width: 76%;
        height: 76%;
      }
    </style>
  </head>
  <body>
    <div id="icon-container" class={`icon-wrapper mode-${mode}`}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
        <rect id="ht-bg" x="0" y="0" width="100" height="100" rx="22" fill="#469b84" />
        <polygon points="30,58 34,42 70,42 66,58" fill="#cae8df" />
        <polygon points="18,78 30,22 44,22 32,78" fill="#ffffff" />
        <polygon points="56,78 68,22 82,22 70,78" fill="#ffffff" />
      </svg>
    </div>

    <script is:inline>
      const urlParams = new URLSearchParams(window.location.search);
      const activeMode = urlParams.get('mode') || 'transparent';
      const container = document.getElementById('icon-container');
      if (container) {
        container.className = 'icon-wrapper mode-' + activeMode;
      }
    </script>
  </body>
</html>
