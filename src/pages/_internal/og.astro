---
import "@styles/global.css";
import "@fontsource/outfit/700.css";
import "@fontsource/outfit/800.css";
import "@fontsource/inter/400.css";

// Deterministic High-Density Starfield Generator matching Background.astro
interface Star {
  isHero: boolean;
  x: number;
  y: number;
  size?: number;
  r?: number;
  opacity: number;
}

const stars: Star[] = [];
let seed = 42;
function random(): number {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
}

const numStars = 140;
for (let i = 0; i < numStars; i++) {
  const x = random() * 1200;
  const y = random() * 630;
  const opacity = random() * 0.45 + 0.35;
  const isHero = i % 14 === 0;

  if (isHero) {
    const size = random() * 4.5 + 4;
    stars.push({
      isHero: true,
      x,
      y,
      size,
      opacity: random() * 0.3 + 0.55,
    });
  } else {
    const r = random() * 0.8 + 0.5;
    stars.push({
      isHero: false,
      x,
      y,
      r,
      opacity,
    });
  }
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1200, height=630, initial-scale=1.0" />
    <title>OG Image Preview</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html, body {
        margin: 0;
        padding: 0;
        width: 1200px;
        height: 630px;
        font-family: 'Outfit', 'Inter', sans-serif;
        overflow: hidden;
        position: relative;
        background: #030712;
      }

      .og-canvas {
        position: relative;
        width: 1200px;
        height: 630px;
        background: #030712;
        background-image: radial-gradient(ellipse 90% 70% at 50% 25%, #0e2047 0%, #030712 85%);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .bg-glow-orb {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        z-index: 1;
      }
      .orb-blue {
        background-color: #3b82f6;
        width: 650px;
        height: 500px;
        top: -120px;
        left: 80px;
        filter: blur(140px);
        opacity: 0.22;
      }
      .orb-purple {
        background-color: #a855f7;
        width: 600px;
        height: 480px;
        top: 160px;
        right: -80px;
        filter: blur(140px);
        opacity: 0.18;
      }
      .orb-green {
        background-color: #10b981;
        width: 450px;
        height: 350px;
        bottom: -80px;
        left: 380px;
        filter: blur(130px);
        opacity: 0.12;
      }

      .stars-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 1200px;
        height: 630px;
        pointer-events: none;
        z-index: 2;
      }

      .shooting-stars-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 1200px;
        height: 630px;
        pointer-events: none;
        z-index: 2;
      }
      .shooting-star {
        position: absolute;
        height: 1.5px;
        background: linear-gradient(to left, rgba(254, 249, 195, 0) 0%, rgba(254, 249, 195, 0.75) 100%);
        transform-origin: left center;
      }
      .shooting-star-1 {
        width: 140px;
        top: 12%;
        left: 72%;
        transform: rotate(-35deg);
        opacity: 0.8;
      }
      .shooting-star-2 {
        width: 110px;
        top: 26%;
        left: 18%;
        transform: rotate(-38deg);
        opacity: 0.65;
      }
      .shooting-star-3 {
        width: 160px;
        top: 7%;
        left: 88%;
        transform: rotate(-32deg);
        opacity: 0.75;
      }

      .center-container {
        position: relative;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 32px;
      }

      .logo-badge {
        width: 112px;
        height: 112px;
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.04);
        border: 1.5px solid rgba(255, 255, 255, 0.16);
        box-shadow: 
          0 20px 48px -10px rgba(0, 0, 0, 0.7),
          inset 0 1px 1px 0 rgba(255, 255, 255, 0.25),
          0 0 40px -10px rgba(59, 130, 246, 0.35);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .logo-text {
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 52px;
        line-height: 1;
        letter-spacing: -1.5px;
        background: linear-gradient(135deg, #3b82f6 0%, #a855f7 50%, #f59e0b 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        padding-bottom: 2px;
      }

      .logo-details {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 8px;
      }

      .brand-name {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 54px;
        line-height: 1.1;
        color: #ffffff;
        letter-spacing: -0.8px;
        text-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
      }

      .brand-subtitle {
        font-family: 'Inter', sans-serif;
        font-weight: 400;
        font-size: 24px;
        line-height: 1.25;
        color: #94a3b8;
        letter-spacing: 0.1px;
        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
      }
    </style>
  </head>
  <body>
    <div class="og-canvas">
      <!-- Ambient Glow Orbs -->
      <div class="bg-glow-orb orb-blue"></div>
      <div class="bg-glow-orb orb-purple"></div>
      <div class="bg-glow-orb orb-green"></div>

      <!-- Shooting Stars -->
      <div class="shooting-stars-container">
        <div class="shooting-star shooting-star-1"></div>
        <div class="shooting-star shooting-star-2"></div>
        <div class="shooting-star shooting-star-3"></div>
      </div>

      <!-- Twinkling Stars SVG Layer -->
      <svg class="stars-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630">
        {stars.map((star) => (
          star.isHero ? (
            <g transform={`translate(${star.x.toFixed(1)}, ${star.y.toFixed(1)})`}>
              <path
                d={`M 0 -${star.size!.toFixed(1)} Q 0 0 ${star.size!.toFixed(1)} 0 Q 0 0 0 ${star.size!.toFixed(1)} Q 0 0 -${star.size!.toFixed(1)} 0 Q 0 0 0 -${star.size!.toFixed(1)} Z`}
                fill="#fef9c3"
                opacity={star.opacity.toFixed(2)}
              />
            </g>
          ) : (
            <circle
              cx={star.x.toFixed(1)}
              cy={star.y.toFixed(1)}
              r={star.r!.toFixed(2)}
              fill="#fef9c3"
              opacity={star.opacity.toFixed(2)}
            />
          )
        ))}
      </svg>

      <!-- Center Brand Logo Lockup -->
      <div class="center-container">
        <div class="logo-badge">
          <span class="logo-text">GH</span>
        </div>
        <div class="logo-details">
          <h1 class="brand-name">Dr. Georg Hackenberg</h1>
          <p class="brand-subtitle">Professor for Industrial Informatics @ UAP Campus Wels</p>
        </div>
      </div>
    </div>
  </body>
</html>
