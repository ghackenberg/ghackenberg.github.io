---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import FilterToolbar from "@components/FilterToolbar.astro";
import { getCollection } from "astro:content";

const tags = await getCollection("tags");
const posts = await getCollection("posts");
const publications = await getCollection("publications");
const presentations = await getCollection("presentations");
const courses = await getCollection("courses");
const projects = await getCollection("projects");
const services = await getCollection("services");
const newsletters = await getCollection("newsletters");
const visualizations = await getCollection("visualizations");

// Compute counts for each tag
const tagStats = tags.map((tag) => {
  const postCount = posts.filter((p) => p.data.tags.includes(tag.id)).length;
  const pubCount = publications.filter((p) => p.data.tags.includes(tag.id)).length;
  const presCount = presentations.filter((pres) => pres.data.tags && pres.data.tags.includes(tag.id)).length;
  const courseCount = courses.filter((c) => c.data.tags && c.data.tags.includes(tag.id)).length;
  const projCount = projects.filter((p) => p.data.tags && p.data.tags.includes(tag.id)).length;
  const serviceCount = services.filter((s) => s.data.tags && s.data.tags.includes(tag.id)).length;
  const newsletterCount = newsletters.filter((n) => n.data.tags && n.data.tags.includes(tag.id)).length;
  const visCount = visualizations.filter((v) => v.data.tags && v.data.tags.includes(tag.id)).length;
  const total = postCount + pubCount + presCount + courseCount + projCount + serviceCount + newsletterCount + visCount;

  return {
    id: tag.id,
    title: tag.data.title,
    description: tag.data.description,
    postCount,
    pubCount,
    presCount,
    courseCount,
    projCount,
    serviceCount,
    newsletterCount,
    visCount,
    total,
  };
});

// Sort tags alphabetically by title
const sortedTags = tagStats.sort((a, b) => a.title.localeCompare(b.title));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tags",
      "item": "https://hackenberg.tech/tags/"
    }
  ]
};
---

<Layout
  title="Content Tags & Topic Index | Dr. Georg Hackenberg"
  description="Explore the comprehensive knowledge index connecting technical blog posts, scientific publications, software projects, university courses, and business services by Dr. Georg Hackenberg."
  jsonLd={breadcrumbSchema}
>
  <Navbar />

  <Container size="wide">
    <Breadcrumbs domain="tags" />

    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-6">
        Topic <span class="text-domain-tags">Tags</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        A structured taxonomy of technologies, architectural concepts, and engineering topics spanning all articles, publications, projects, and courses.
      </p>
    </div>

    <!-- Filter Toolbar -->
    <FilterToolbar
      searchId="tag-filter"
      searchPlaceholder="Filter by keyword (e.g. AI, Systems, Web)..."
      domain="tags"
      totalCount={sortedTags.length}
    >
      <span id="tag-count-label" class="text-xs text-gray-400 font-medium whitespace-nowrap">
        Showing all {sortedTags.length} topics
      </span>
    </FilterToolbar>

    <!-- Tags Grid -->
    <div id="tags-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {sortedTags.map((tag) => (
        <a
          href={`/tags/${tag.id}/`}
          class="tag-card glass-card p-5 sm:p-6 rounded-2xl border border-element-border hover:border-domain-tags/40 transition-all duration-300 group flex flex-col justify-between hover:scale-[1.01] hover:shadow-lg hover:shadow-domain-tags/5"
          data-title={tag.title.toLowerCase()}
          data-id={tag.id.toLowerCase()}
          data-desc={tag.description.toLowerCase()}
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <h2 id={`tag-${tag.id}`} class="text-base font-bold text-gray-100 group-hover:text-domain-tags transition-colors flex items-center gap-1">
                <span class="text-gray-500 font-normal">#</span>
                <span>{tag.title}</span>
              </h2>
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-element-bg border border-element-border-medium text-gray-400 group-hover:border-domain-tags/30 group-hover:text-domain-tags transition-colors shrink-0">
                {tag.total}
              </span>
            </div>

            <p class="text-gray-400 text-xs sm:text-sm leading-relaxed mb-4 line-clamp-3 font-normal">
              {tag.description}
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-element-border text-[11px] text-gray-500 mt-auto">
            {tag.postCount > 0 && (
              <span class="inline-flex items-center gap-1 text-domain-posts">
                <span class="w-1.5 h-1.5 rounded-full bg-domain-posts"></span>
                <span>{tag.postCount} Post{tag.postCount !== 1 ? 's' : ''}</span>
              </span>
            )}
            {tag.pubCount > 0 && (
              <span class="inline-flex items-center gap-1 text-domain-publications">
                <span class="w-1.5 h-1.5 rounded-full bg-domain-publications"></span>
                <span>{tag.pubCount} Publication{tag.pubCount !== 1 ? 's' : ''}</span>
              </span>
            )}
            {tag.presCount > 0 && (
              <span class="inline-flex items-center gap-1 text-domain-presentations">
                <span class="w-1.5 h-1.5 rounded-full bg-domain-presentations"></span>
                <span>{tag.presCount} Presentation{tag.presCount !== 1 ? 's' : ''}</span>
              </span>
            )}
            {tag.courseCount > 0 && (
              <span class="inline-flex items-center gap-1 text-domain-courses">
                <span class="w-1.5 h-1.5 rounded-full bg-domain-courses"></span>
                <span>{tag.courseCount} Course{tag.courseCount !== 1 ? 's' : ''}</span>
              </span>
            )}
            {tag.projCount > 0 && (
              <span class="inline-flex items-center gap-1 text-domain-projects">
                <span class="w-1.5 h-1.5 rounded-full bg-domain-projects"></span>
                <span>{tag.projCount} Project{tag.projCount !== 1 ? 's' : ''}</span>
              </span>
            )}
            {tag.serviceCount > 0 && (
              <span class="inline-flex items-center gap-1 text-domain-services">
                <span class="w-1.5 h-1.5 rounded-full bg-domain-services"></span>
                <span>{tag.serviceCount} Service{tag.serviceCount !== 1 ? 's' : ''}</span>
              </span>
            )}
            {tag.newsletterCount > 0 && (
              <span class="inline-flex items-center gap-1 text-domain-newsletters">
                <span class="w-1.5 h-1.5 rounded-full bg-domain-newsletters"></span>
                <span>{tag.newsletterCount} Newsletter{tag.newsletterCount !== 1 ? 's' : ''}</span>
              </span>
            )}
            {tag.visCount > 0 && (
              <span class="inline-flex items-center gap-1 text-domain-visualizations">
                <span class="w-1.5 h-1.5 rounded-full bg-domain-visualizations"></span>
                <span>{tag.visCount} Visualization{tag.visCount !== 1 ? 's' : ''}</span>
              </span>
            )}
          </div>
        </a>
      ))}
    </div>

    <div id="no-results" class="hidden glass-card rounded-2xl p-12 text-center border border-element-border mt-6">
      <p class="text-gray-400 text-sm">No topics match your search criteria.</p>
    </div>
  </Container>
</Layout>

<script>
  function setupTagFilter() {
    const input = document.getElementById('tag-filter') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('.tag-card');
    const countLabel = document.getElementById('tag-count-label');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('tag-filter-reset') as HTMLButtonElement | null;

    if (!input) return;

    function applyFilter() {
      const q = input?.value.trim().toLowerCase() || '';
      let visible = 0;

      cards.forEach((card) => {
        const title = card.dataset.title || '';
        const id = card.dataset.id || '';
        const desc = card.dataset.desc || '';
        const matches = !q || title.includes(q) || id.includes(q) || desc.includes(q);

        if (matches) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countLabel) {
        countLabel.textContent = q ? `Found ${visible} matching topic${visible !== 1 ? 's' : ''}` : `Showing all ${cards.length} topics`;
      }

      if (noResults) {
        noResults.classList.toggle('hidden', visible > 0);
      }

      if (resetBtn) {
        if (q) {
          resetBtn.classList.remove('hidden');
          resetBtn.style.display = 'inline-flex';
        } else {
          resetBtn.classList.add('hidden');
          resetBtn.style.display = 'none';
        }
      }
    }

    input.addEventListener('input', applyFilter);

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        input.value = '';
        applyFilter();
        input.focus();
      });
    }

    // Initial run in case query parameter or cached input exists
    if (input.value) {
      applyFilter();
    }
  }

  setupTagFilter();
  document.addEventListener('astro:page-load', setupTagFilter);
</script>
