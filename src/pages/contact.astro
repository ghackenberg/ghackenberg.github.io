                  data-track-location="contact-page"
                  class="px-4 py-2 text-xs font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-200 hover:text-white border border-element-border-medium hover:border-brand-primary/40 transition-all duration-200 flex items-center space-x-2 cursor-pointer shadow-sm hover:scale-102"
                >
                  <svg id="copy-phone-icon" class="w-3.5 h-3.5 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
