              <div class="pt-6 border-t border-element-border/50 sm:pt-0 sm:border-t-0 sm:mt-0 xl:pt-6 xl:border-t xl:border-element-border/50 xl:mt-6 flex items-center justify-center sm:justify-end xl:justify-center shrink-0">
                <button 
                  type="button"
                  id="copy-phone-btn"
