---
import Layout from "@layouts/Layout.astro";
import { buildContactPageSchemas } from "@commons/server/json-ld";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { ensureMapAssets } from "@commons/server/map-assets";
import { getCollection } from "astro:content";

const { 
  welsMapLightSrc, 
  welsMapDarkSrc, 
  gruenauMapLightSrc, 
  gruenauMapDarkSrc, 
  width: mapWidth, 
  height: mapHeight 
} = await ensureMapAssets();

const profiles = (await getCollection("profiles")).sort((a, b) => a.data.order - b.data.order);

const pageJsonLd = buildContactPageSchemas({ profiles });
---

<Layout
  title="Contact Dr. Georg Hackenberg - Campus Wels, FH Upper Austria"
  description="Get in touch with Dr. Georg Hackenberg for research initiatives, industry collaborations, university teaching, and speaking inquiries."
  jsonLd={pageJsonLd}
>
  <Navbar />

  <main class="w-full">
    <!-- Unified Direct Contact Section -->
    <Section id="contact" padding="standard">
      <Container size="wide" padding="none">
        <Breadcrumbs class="mb-6" />

        <div class="mb-12">
          <h1 id="contact-page-heading" class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-4">
            Business <span class="text-brand-primary">Contact</span>
          </h1>
          <p id="contact-page-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
            Whether you want to discuss joint academic research, explore enterprise software architectures, propose a student thesis, or inquire about keynote presentations—I am always eager to connect.
          </p>
        </div>

        <div class="space-y-16">
          <div>
            <div class="mb-8">
              <h2 id="office-locations-heading" class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3">
                Office <span class="text-brand-primary">Locations</span>
              </h2>
              <p id="office-locations-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
                University faculty office at Technology Campus Wels and registered business headquarters in Grünau im Almtal, Upper Austria.
              </p>
            </div>
            <!-- Dual-Identity Location Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 w-full">
          <!-- Card 1: University Office (Wels) -->
          <div class="glass-card p-6 md:p-8 rounded-3xl border border-element-border hover:border-brand-primary/30 relative overflow-hidden hover:shadow-xl hover:shadow-brand-primary/5 transition-all duration-300 flex flex-col justify-between h-full">
            <div class="flex-1">
              <h3 id="university-office-heading" class="text-xl font-bold text-gray-100 mb-6 flex items-center gap-2.5">
                University <span class="text-brand-primary">Office</span>
              </h3>
              <div class="space-y-4 text-sm md:text-base">
                <!-- Role -->
                <div class="flex items-start space-x-3.5">
                  <div class="text-brand-primary shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-0.5">Academic Position</p>
                    <p class="text-gray-100 font-semibold leading-snug">Professor for Industrial Informatics</p>
                    <p class="text-gray-400 text-xs mt-0.5">School of Engineering</p>
                  </div>
                </div>

                <!-- Institution -->
                <div class="flex items-start space-x-3.5">
                  <div class="text-brand-primary shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-0.5">Institution & Campus</p>
                    <p class="text-gray-100 font-semibold leading-snug">University of Applied Sciences Upper Austria</p>
                    <p class="text-gray-400 text-xs mt-0.5">FH Upper Austria / Technology Campus Wels</p>
                  </div>
                </div>

                <!-- Address -->
                <div class="flex items-start space-x-3.5">
                  <div class="text-brand-primary shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-0.5">Campus Address</p>
                    <p class="text-gray-100 font-semibold leading-snug">Stelzhamerstrasse 23</p>
                    <p class="text-gray-400 text-xs mt-0.5">4600 Wels, Austria</p>
                  </div>
                </div>

                <!-- Office Room -->
                <div class="flex items-start space-x-3.5">
                  <div class="text-brand-primary shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-0.5">Faculty Office</p>
                    <p class="text-gray-100 font-semibold leading-snug">Building A (Bauteil A), 2nd Floor (2. OG)</p>
                    <p class="text-gray-400 text-xs mt-0.5">Room O2 - 030</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bottom-aligned Campus Wels Map Section -->
            <div class="mt-8 pt-6 border-t border-element-border/50">
              <div class="rounded-2xl border border-element-border overflow-hidden bg-element-bg relative group/map">
                <div class="relative w-full aspect-[2/1] overflow-hidden bg-element-bg">
                  <!-- Dark mode map image -->
                  <img 
                    src={welsMapDarkSrc} 
                    alt="Campus Wels location map in dark theme showing Building A and Stelzhamerstrasse" 
                    title="FH Upper Austria Campus Wels Location Map (Dark Theme)"
                    width={mapWidth}
                    height={mapHeight}
                    loading="lazy" 
                    decoding="async" 
                    class="w-full h-full object-cover block light:hidden transition-transform duration-500 group-hover/map:scale-105"
                  />
                  <!-- Light mode map image -->
                  <img 
                    src={welsMapLightSrc} 
                    alt="Campus Wels location map in light theme showing Building A and Stelzhamerstrasse" 
                    title="FH Upper Austria Campus Wels Location Map (Light Theme)"
                    width={mapWidth}
                    height={mapHeight}
                    loading="lazy" 
                    decoding="async" 
                    class="w-full h-full object-cover hidden light:block transition-transform duration-500 group-hover/map:scale-105"
                  />
                  <!-- Center Location Pin with pulsing radar glow -->
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div class="relative flex items-center justify-center">
                      <span class="animate-ping absolute inline-flex h-8 w-8 rounded-full bg-brand-primary opacity-40"></span>
                      <span class="relative inline-flex rounded-full h-4 w-4 bg-brand-primary shadow-lg shadow-brand-primary/50 border-2 border-white items-center justify-center">
                        <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                      </span>
                    </div>
                  </div>
                  <!-- Coordinate badge top right -->
                  <div class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-lg bg-bg-pane/90 backdrop-blur-md border border-element-border-medium text-[10px] font-mono text-gray-300 pointer-events-none shadow-sm">
                    48.1614° N, 14.0278° E
                  </div>
                  <!-- Building indicator bottom left -->
                  <div class="absolute bottom-2.5 left-2.5 px-2 py-0.5 rounded-lg bg-bg-pane/90 backdrop-blur-md border border-brand-primary/30 text-[11px] font-medium text-brand-primary pointer-events-none flex items-center gap-1.5 shadow-sm">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-primary animate-pulse"></span>
                    <span>Stelzhamerstraße 23 • Wels</span>
                  </div>
                  <!-- Map Attribution bottom right -->
                  <div class="absolute bottom-2 right-2 text-[9px] text-gray-400 bg-bg-pane/80 px-1.5 py-0.5 rounded backdrop-blur-sm pointer-events-none">
                    © OpenStreetMap
                  </div>
                </div>
              </div>

              <!-- Quick navigation action controls -->
              <div class="flex flex-wrap items-center justify-between gap-2 pt-3">
                <span class="text-xs text-gray-400 font-medium flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-brand-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>Route:</span>
                </span>
                <div class="flex flex-wrap items-center gap-1.5">
                  <a 
                    href="https://www.google.com/maps/dir/?api=1&destination=48.1614265,14.0277939" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-2.5 py-1 text-xs font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 hover:text-gray-100 border border-element-border-medium hover:border-brand-primary/40 transition-all duration-200 inline-flex items-center gap-1 shadow-sm"
                  >
                    <span>Google Maps</span>
                    <span class="text-brand-primary text-[11px]">↗</span>
                  </a>
                  <a 
                    href="https://maps.apple.com/?daddr=48.1614265,14.0277939" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-2.5 py-1 text-xs font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 hover:text-gray-100 border border-element-border-medium hover:border-brand-primary/40 transition-all duration-200 inline-flex items-center gap-1 shadow-sm"
                  >
                    <span>Apple Maps</span>
                    <span class="text-brand-primary text-[11px]">↗</span>
                  </a>
                  <a 
                    href="https://www.openstreetmap.org/?mlat=48.1614265&mlon=14.0277939#map=18/48.1614265/14.0277939" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-2.5 py-1 text-xs font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 hover:text-gray-100 border border-element-border-medium hover:border-brand-primary/40 transition-all duration-200 inline-flex items-center gap-1 shadow-sm"
                  >
                    <span>OSM</span>
                    <span class="text-brand-primary text-[11px]">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2: Business Headquarters (Grünau) -->
          <div class="glass-card p-6 md:p-8 rounded-3xl border border-element-border hover:border-brand-primary/30 relative overflow-hidden hover:shadow-xl hover:shadow-brand-primary/5 transition-all duration-300 flex flex-col justify-between h-full">
            <div class="flex-1">
              <h3 id="business-headquarters-heading" class="text-xl font-bold text-gray-100 mb-6 flex items-center gap-2.5">
                Business <span class="text-brand-primary">Headquarters</span>
              </h3>
              <div class="space-y-4 text-sm md:text-base">
                <!-- Entity -->
                <div class="flex items-start space-x-3.5">
                  <div class="text-brand-primary shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-0.5">Commercial Legal Entity</p>
                    <p class="text-gray-100 font-semibold leading-snug">IT Consulting & Software Engineering</p>
                    <p class="text-gray-400 text-xs mt-0.5">Sole Proprietorship / Einzelunternehmen</p>
                  </div>
                </div>

                <!-- Registration -->
                <div class="flex items-start space-x-3.5">
                  <div class="text-brand-primary shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-0.5">Professional Scope</p>
                    <p class="text-gray-100 font-semibold leading-snug">B2B Engineering Advisory & Software Architecture</p>
                    <p class="text-gray-400 text-xs mt-0.5">Registered in Upper Austria</p>
                  </div>
                </div>

                <!-- Address -->
                <div class="flex items-start space-x-3.5">
                  <div class="text-brand-primary shrink-0 mt-0.5">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-0.5">Registered Office Address</p>
                    <p class="text-gray-100 font-semibold leading-snug">Edthof 13a</p>
                    <p class="text-gray-400 text-xs mt-0.5">4645 Grünau im Almtal, Austria</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bottom-aligned Business Headquarters Map Section -->
            <div class="mt-8 pt-6 border-t border-element-border/50">
              <div class="rounded-2xl border border-element-border overflow-hidden bg-element-bg relative group/map">
                <div class="relative w-full aspect-[2/1] overflow-hidden bg-element-bg">
                  <!-- Dark mode map image -->
                  <img 
                    src={gruenauMapDarkSrc} 
                    alt="Business Headquarters location map in dark theme in Grünau im Almtal" 
                    title="Business Headquarters Location Map (Dark Theme)"
                    width={mapWidth}
                    height={mapHeight}
                    loading="lazy" 
                    decoding="async" 
                    class="w-full h-full object-cover block light:hidden transition-transform duration-500 group-hover/map:scale-105"
                  />
                  <!-- Light mode map image -->
                  <img 
                    src={gruenauMapLightSrc} 
                    alt="Business Headquarters location map in light theme in Grünau im Almtal" 
                    title="Business Headquarters Location Map (Light Theme)"
                    width={mapWidth}
                    height={mapHeight}
                    loading="lazy" 
                    decoding="async" 
                    class="w-full h-full object-cover hidden light:block transition-transform duration-500 group-hover/map:scale-105"
                  />
                  <!-- Center Location Pin with pulsing radar glow -->
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div class="relative flex items-center justify-center">
                      <span class="animate-ping absolute inline-flex h-8 w-8 rounded-full bg-brand-primary opacity-40"></span>
                      <span class="relative inline-flex rounded-full h-4 w-4 bg-brand-primary shadow-lg shadow-brand-primary/50 border-2 border-white items-center justify-center">
                        <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                      </span>
                    </div>
                  </div>
                  <!-- Coordinate badge top right -->
                  <div class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-lg bg-bg-pane/90 backdrop-blur-md border border-element-border-medium text-[10px] font-mono text-gray-300 pointer-events-none shadow-sm">
                    47.8588° N, 13.9640° E
                  </div>
                  <!-- Building indicator bottom left -->
                  <div class="absolute bottom-2.5 left-2.5 px-2 py-0.5 rounded-lg bg-bg-pane/90 backdrop-blur-md border border-brand-primary/30 text-[11px] font-medium text-brand-primary pointer-events-none flex items-center gap-1.5 shadow-sm">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-primary animate-pulse"></span>
                    <span>Edthof 13a • Grünau</span>
                  </div>
                  <!-- Map Attribution bottom right -->
                  <div class="absolute bottom-2 right-2 text-[9px] text-gray-400 bg-bg-pane/80 px-1.5 py-0.5 rounded backdrop-blur-sm pointer-events-none">
                    © OpenStreetMap
                  </div>
                </div>
              </div>

              <!-- Quick navigation action controls -->
              <div class="flex flex-wrap items-center justify-between gap-2 pt-3">
                <span class="text-xs text-gray-400 font-medium flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-brand-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>Route:</span>
                </span>
                <div class="flex flex-wrap items-center gap-1.5">
                  <a 
                    href="https://www.google.com/maps/dir/?api=1&destination=47.8587572,13.9640378" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-2.5 py-1 text-xs font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 hover:text-gray-100 border border-element-border-medium hover:border-brand-primary/40 transition-all duration-200 inline-flex items-center gap-1 shadow-sm"
                  >
                    <span>Google Maps</span>
                    <span class="text-brand-primary text-[11px]">↗</span>
                  </a>
                  <a 
                    href="https://maps.apple.com/?daddr=47.8587572,13.9640378" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-2.5 py-1 text-xs font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 hover:text-gray-100 border border-element-border-medium hover:border-brand-primary/40 transition-all duration-200 inline-flex items-center gap-1 shadow-sm"
                  >
                    <span>Apple Maps</span>
                    <span class="text-brand-primary text-[11px]">↗</span>
                  </a>
                  <a 
                    href="https://www.openstreetmap.org/?mlat=47.8587572&mlon=13.9640378#map=18/47.8587572/13.9640378" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="px-2.5 py-1 text-xs font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 hover:text-gray-100 border border-element-border-medium hover:border-brand-primary/40 transition-all duration-200 inline-flex items-center gap-1 shadow-sm"
                  >
                    <span>OSM</span>
                    <span class="text-brand-primary text-[11px]">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

        <div>
          <div class="mb-8">
            <h2 id="direct-channels-heading" class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3">
              Direct <span class="text-brand-primary">Channels</span>
            </h2>
            <p id="direct-channels-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
              Official web domain, institutional email, and direct telephone line for academic, consulting, and speaking inquiries.
            </p>
          </div>
          <!-- Direct Communications (Web, Email, Telephone) -->
          <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 lg:gap-8 w-full">
            <!-- Card 1: Web Platform -->
            <div class="glass-card p-6 md:p-8 rounded-3xl border border-element-border hover:border-brand-primary/30 relative overflow-hidden hover:shadow-xl hover:shadow-brand-primary/5 transition-all duration-300 flex flex-col sm:flex-row xl:flex-col sm:items-center xl:items-stretch justify-between gap-6 xl:gap-0 h-full w-full">
              <div class="flex-1 min-w-0">
                <h3 id="web-presence-heading" class="text-xl font-bold text-gray-100 mb-4 xl:mb-6 flex items-center gap-2.5">
                  Web <span class="text-brand-primary">Platform</span>
                </h3>
                <div class="space-y-4 text-sm md:text-base">
                  <div class="flex items-start space-x-3.5">
                    <div class="text-brand-primary shrink-0 mt-0.5">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                      </svg>
                    </div>
                    <div class="w-full min-w-0">
                      <p class="text-gray-400 text-xs font-semibold uppercase tracking-wider mb-0.5">Official Web Domain</p>
                      <a href="https://hackenberg.tech" target="_blank" rel="noopener noreferrer" id="web-domain-text" class="text-gray-100 font-mono font-medium hover:text-brand-primary transition-colors block select-all whitespace-nowrap text-sm md:text-base">
                        https://hackenberg.tech
                      </a>
                      <p class="text-gray-400 text-xs mt-1">Digital garden, software architectures, research & publications</p>
                    </div>
                  </div>
                </div>
              </div>

