  </Section>
  </main>
</Layout>

<script>
  // Copy to Clipboard logic for email
  const copyEmailBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-address-text');
  const copyEmailBtnText = document.getElementById('copy-email-btn-text');

  if (copyEmailBtn && emailText && copyEmailBtnText) {
    copyEmailBtn.addEventListener('click', () => {
      const email = emailText.textContent?.trim() || 'georg.hackenberg@fh-wels.at';

      navigator.clipboard.writeText(email).then(() => {
        copyEmailBtnText.textContent = 'Copied!';
        copyEmailBtn.classList.remove('bg-element-bg', 'text-gray-200');
        copyEmailBtn.classList.add('bg-brand-primary/20', 'text-brand-primary', 'border-brand-primary/40');

        setTimeout(() => {
          copyEmailBtnText.textContent = 'Copy Email';
          copyEmailBtn.classList.remove('bg-brand-primary/20', 'text-brand-primary', 'border-brand-primary/40');
          copyEmailBtn.classList.add('bg-element-bg', 'text-gray-200');
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy email:', err);
      });
    });
  }

  // Copy to Clipboard logic for phone
  const copyPhoneBtn = document.getElementById('copy-phone-btn');
  const phoneText = document.getElementById('phone-number-text');
  const copyPhoneBtnText = document.getElementById('copy-phone-btn-text');

  if (copyPhoneBtn && phoneText && copyPhoneBtnText) {
    copyPhoneBtn.addEventListener('click', () => {
      const phone = phoneText.textContent?.trim() || '+43 664 80484 44066';

      navigator.clipboard.writeText(phone).then(() => {
        copyPhoneBtnText.textContent = 'Copied!';
        copyPhoneBtn.classList.remove('bg-element-bg', 'text-gray-200');
        copyPhoneBtn.classList.add('bg-brand-primary/20', 'text-brand-primary', 'border-brand-primary/40');

        setTimeout(() => {
          copyPhoneBtnText.textContent = 'Copy Phone';
          copyPhoneBtn.classList.remove('bg-brand-primary/20', 'text-brand-primary', 'border-brand-primary/40');
          copyPhoneBtn.classList.add('bg-element-bg', 'text-gray-200');
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy phone:', err);
      });
    });
  }

  // Copy to Clipboard logic for web
  const copyWebBtn = document.getElementById('copy-web-btn');
  const webText = document.getElementById('web-domain-text');
  const copyWebBtnText = document.getElementById('copy-web-btn-text');

  if (copyWebBtn && webText && copyWebBtnText) {
    copyWebBtn.addEventListener('click', () => {
      const url = webText.textContent?.trim() || 'https://hackenberg.tech';

      navigator.clipboard.writeText(url).then(() => {
        copyWebBtnText.textContent = 'Copied!';
        copyWebBtn.classList.remove('bg-element-bg', 'text-gray-200');
        copyWebBtn.classList.add('bg-brand-primary/20', 'text-brand-primary', 'border-brand-primary/40');

        setTimeout(() => {
          copyWebBtnText.textContent = 'Copy URL';
          copyWebBtn.classList.remove('bg-brand-primary/20', 'text-brand-primary', 'border-brand-primary/40');
          copyWebBtn.classList.add('bg-element-bg', 'text-gray-200');
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy URL:', err);
      });
    });
  }
</script>
