---
import { getCollection, render } from "astro:content";
import path from "node:path";
import "@styles/theme.css";
import "@styles/slides.css";
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/outfit/300.css";
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import "@fontsource/outfit/800.css";
import "@fontsource/outfit/900.css";
import "@fontsource/caveat/400.css";
import "@fontsource/caveat/600.css";
import "@fontsource/caveat/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/600.css";
import "@fontsource/jetbrains-mono/700.css";
import outfit400Woff2 from "@fontsource/outfit/files/outfit-latin-400-normal.woff2?url";
import outfit500Woff2 from "@fontsource/outfit/files/outfit-latin-500-normal.woff2?url";
import outfit700Woff2 from "@fontsource/outfit/files/outfit-latin-700-normal.woff2?url";
import outfit800Woff2 from "@fontsource/outfit/files/outfit-latin-800-normal.woff2?url";
import outfit900Woff2 from "@fontsource/outfit/files/outfit-latin-900-normal.woff2?url";
import jetbrainsMono400Woff2 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import jetbrainsMono600Woff2 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-600-normal.woff2?url";
import jetbrainsMono700Woff2 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2?url";

const criticalFontCss = `
  @font-face { font-family: 'Outfit'; font-style: normal; font-display: block; font-weight: 400; src: url('${outfit400Woff2}') format('woff2'); }
  @font-face { font-family: 'Outfit'; font-style: normal; font-display: block; font-weight: 500; src: url('${outfit500Woff2}') format('woff2'); }
  @font-face { font-family: 'Outfit'; font-style: normal; font-display: block; font-weight: 700; src: url('${outfit700Woff2}') format('woff2'); }
  @font-face { font-family: 'Outfit'; font-style: normal; font-display: block; font-weight: 800; src: url('${outfit800Woff2}') format('woff2'); }
  @font-face { font-family: 'Outfit'; font-style: normal; font-display: block; font-weight: 900; src: url('${outfit900Woff2}') format('woff2'); }
  @font-face { font-family: 'JetBrains Mono'; font-style: normal; font-display: block; font-weight: 400; src: url('${jetbrainsMono400Woff2}') format('woff2'); }
  @font-face { font-family: 'JetBrains Mono'; font-style: normal; font-display: block; font-weight: 600; src: url('${jetbrainsMono600Woff2}') format('woff2'); }
  @font-face { font-family: 'JetBrains Mono'; font-style: normal; font-display: block; font-weight: 700; src: url('${jetbrainsMono700Woff2}') format('woff2'); }
`;
import KaTeXStyles from "@components/KaTeXStyles.astro";

export async function getStaticPaths() {
  const presentations = await getCollection("presentations");
  return presentations.map((presentation) => ({
    params: { slug: presentation.id },
    props: { presentation },
  }));
}

const { presentation } = Astro.props;

// Load and sort all slides
const allSlides = await getCollection("slides");
const presentationSlides = allSlides
  .filter((s) => s.id.startsWith(presentation.id))
  .sort((a, b) => a.id.localeCompare(b.id));

const renderedSlides = await Promise.all(
  presentationSlides.map(async (slide, idx) => {
    const { Content } = await render(slide);
    return {
      id: slide.id,
      number: idx + 1,
      Content
    };
  })
);
---

<!DOCTYPE html>
<html lang={presentation.data.inLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{presentation.data.title} - Handout Druckansicht</title>
    <style is:inline set:html={criticalFontCss} />
    <KaTeXStyles />
    <script is:inline>
      const params = new URLSearchParams(window.location.search);
      const theme = params.get('theme') || 'dark';
      if (theme === 'light') {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }
    </script>
    <style is:global>
      @page {
        size: 1920px 1080px;
        margin: 0;
      }
      body {
        margin: 0;
        padding: 0;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      html:not(.light) body {
        background-color: #020617;
        color: #f8fafc;
      }
      html.light body {
        background-color: #ffffff;
        color: #0f172a;
      }
      .print-slide-page {
        width: 1920px !important;
        height: 1080px !important;
        max-width: 1920px !important;
        max-height: 1080px !important;
        display: flex;
        align-items: center;
        justify-content: center;
        page-break-after: always;
        break-after: page;
        box-sizing: border-box;
        overflow: hidden;
      }
      html:not(.light) .print-slide-page {
        background-color: #020617;
      }
      html.light .print-slide-page {
        background-color: #ffffff;
      }
      .print-slide-page .slide-base-frame {
        width: 1920px !important;
        height: 1080px !important;
        max-width: 1920px !important;
        max-height: 1080px !important;
      }
      /* Ensure everything is fully visible in print handout and disable transitions */
      .print-slide-page,
      .print-slide-page * {
        transition: none !important;
      }
      .print-slide-page [data-animate],
      .print-slide-page [data-cue]:not(mark):not(.highlight-marker),
      .print-slide-page .bento-card-root,
      .print-slide-page .step-card,
      .print-slide-page .metric-stat-card,
      .print-slide-page .pipeline-arrow {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }
      .print-slide-page mark,
      .print-slide-page .highlight-marker {
        background-size: 0% 100% !important;
        background-image: none !important;
        background: transparent !important;
        color: inherit !important;
        padding: 0 !important;
      }
      .print-slide-page .slide-base-frame.is-intro-state .slide-header-content,
      .print-slide-page .slide-base-frame.is-intro-state .slide-title,
      .print-slide-page .slide-base-frame.is-intro-state .slide-subtitle {
        transform: none !important;
        opacity: 1 !important;
        animation: none !important;
      }
      .print-slide-page .slide-base-frame.is-intro-state .slide-main-stage {
        opacity: 1 !important;
        transform: none !important;
        pointer-events: auto !important;
      }
      .print-slide-page .slide-base-frame.is-intro-state .slide-number-badge,
      .print-slide-page .slide-base-frame.is-intro-state .slide-footer {
        opacity: 1 !important;
        pointer-events: auto !important;
      }
      .print-slide-page .story-image-skeleton {
        display: none !important;
      }
      .print-slide-page img {
        opacity: 1 !important;
      }

      /* Dark mode card contrast overrides matching live player */
      html:not(.light) .bento-card-object .bg-blue-50,
      html:not(.light) .bento-card-object .bg-blue-50\/70,
      html:not(.light) .bento-card-object .bg-blue-50\/60,
      html:not(.light) .bento-card-object .bg-blue-50\/80 {
        background-color: rgba(30, 58, 138, 0.25) !important;
        border-color: rgba(59, 130, 246, 0.35) !important;
        color: #f1f5f9 !important;
      }
      html:not(.light) .bento-card-object .bg-cyan-50,
      html:not(.light) .bento-card-object .bg-cyan-50\/70 {
        background-color: rgba(22, 78, 99, 0.25) !important;
        border-color: rgba(6, 182, 212, 0.35) !important;
        color: #f1f5f9 !important;
      }
    </style>
  </head>
  <body>
    {renderedSlides.map((slide) => (
      <div class="print-slide-page" id={`slide-${slide.number}`} data-slide-id={path.basename(slide.id)} data-slide-number={slide.number}>
        <slide.Content />
      </div>
    ))}

    <script>
      import { AutoFitController } from "@components/slides/player/AutoFitController";

      async function initPrintSlides() {
        // 1. Remove intro states from all slides
        document.querySelectorAll('.is-intro-state').forEach((el) => {
          el.classList.remove('is-intro-state');
        });

        // 2. Wait for all web fonts and KaTeX math fonts to settle before measuring
        if (document.fonts && document.fonts.ready) {
          await Promise.race([
            document.fonts.ready,
            new Promise((resolve) => setTimeout(resolve, 1500))
          ]);
        }

        // 3. Run AutoFitController across all cards to match live player typography scale
        const autoFit = new AutoFitController();
        document.querySelectorAll<HTMLElement>('.print-slide-page').forEach((page) => {
          autoFit.fitSlide(page, true);
        });

        // 4. Mark document ready for Puppeteer PDF export & linters
        document.documentElement.setAttribute('data-print-ready', 'true');
      }

      void initPrintSlides();
    </script>
  </body>
</html>
