---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import SlideDeck from "../../../components/slides/player/SlideDeck.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import GetInTouchCard from "../../../components/GetInTouchCard.astro";
import { getCollection, render } from "astro:content";
import fs from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
  const presentations = await getCollection("presentations");
  return presentations.map((presentation) => ({
    params: { slug: presentation.id },
    props: { presentation },
  }));
}

const { presentation } = Astro.props;

// Load all slides for this presentation, sorted by filename
const allSlides = await getCollection("slides");
const presentationSlides = allSlides
  .filter((s) => s.id.startsWith(presentation.id))
  .sort((a, b) => a.id.localeCompare(b.id));

// Prepare slide metadata and rendered components
const renderedSlides = await Promise.all(
  presentationSlides.map(async (slide, idx) => {
    const { Content } = await render(slide);
    const slideBase = path.basename(slide.id);

    // Check if audio file and cues file exist
    const presentationDir = path.resolve("src/content/presentations", presentation.id);
    const audioFilePath = path.join(presentationDir, "audio", `${slideBase}.mp3`);
    const cuesFilePath = path.join(presentationDir, "audio", `${slideBase}.cues.json`);
    const thumbPath = path.join(presentationDir, "thumbnails", `${slideBase}.webp`);

    let audioUrl = undefined;
    if (fs.existsSync(audioFilePath)) {
      audioUrl = `/presentations/${presentation.id}/audio/${slideBase}.mp3`;
    }

    let thumbnailUrl = undefined;
    if (fs.existsSync(thumbPath)) {
      thumbnailUrl = `/presentations/${presentation.id}/thumbnails/${slideBase}.webp`;
    }

    let cues: Record<string, number> = {};
    if (fs.existsSync(cuesFilePath)) {
      try {
        cues = JSON.parse(fs.readFileSync(cuesFilePath, "utf8"));
      } catch {
        cues = {};
      }
    }

    return {
      id: slideBase,
      number: idx + 1,
      title: slide.data.title,
      subtitle: slide.data.subtitle,
      voiceover: slide.data.voiceover,
      notes: slide.data.notes,
      references: slide.data.references || [],
      thumbnailUrl,
      audioUrl,
      cues,
      Content
    };
  })
);

// Check if slides-dark.pdf or slides-light.pdf exist for download button
const presentationDir = path.resolve("src/content/presentations", presentation.id);
const pdfDarkPath = path.join(presentationDir, "slides-dark.pdf");
const pdfLightPath = path.join(presentationDir, "slides-light.pdf");

const pdfDarkUrl = fs.existsSync(pdfDarkPath) 
  ? `/presentations/${presentation.id}/slides-dark.pdf` 
  : undefined;

const pdfLightUrl = fs.existsSync(pdfLightPath) 
  ? `/presentations/${presentation.id}/slides-light.pdf` 
  : undefined;

const pdfDownloadUrl = pdfDarkUrl || pdfLightUrl;

const stripCues = (text: string) => (text ? text.replace(/\{(\/)?cue(?::[^}]+)?\}/g, "") : "");

type JsonLdValue = string | number | boolean | null | undefined | { [key: string]: JsonLdValue } | JsonLdValue[];
type JsonLdNode = Record<string, JsonLdValue>;

// Schema.org Dynamic Dual Architecture: Event + PresentationDigitalDocument or Pure Digital Document
const schemaGraph: JsonLdNode[] = [];

if (presentation.data.event) {
  schemaGraph.push({
    "@type": "Event",
    "@id": `https://hackenberg.tech/presentations/${presentation.id}/#event`,
    "name": presentation.data.event,
    "description": presentation.data.description,
    "startDate": presentation.data.pubDate.toISOString(),
    "eventAttendanceMode": presentation.data.location ? "https://schema.org/OfflineEventAttendanceMode" : "https://schema.org/OnlineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    ...(presentation.data.location ? {
      "location": {
        "@type": "Place",
        "name": presentation.data.location,
        "address": {
          "@type": "PostalAddress",
          "addressRegion": "Oberösterreich",
          "addressCountry": "AT"
        }
      }
    } : {}),
    "performer": {
      "@type": "Person",
      "@id": "https://hackenberg.tech/#georg",
      "name": "Dr. Georg Hackenberg",
      "jobTitle": "Professor für Informatik und Industriesysteme"
    },
    "workPerformed": {
      "@id": `https://hackenberg.tech/presentations/${presentation.id}/#presentation`
    }
  });
}

schemaGraph.push({
  "@type": "PresentationDigitalDocument",
  "@id": `https://hackenberg.tech/presentations/${presentation.id}/#presentation`,
  "name": presentation.data.title,
  "headline": presentation.data.subtitle || presentation.data.title,
  "description": presentation.data.description,
  "author": {
    "@id": "https://hackenberg.tech/#georg"
  },
  "datePublished": presentation.data.pubDate.toISOString(),
  "inLanguage": presentation.data.lang,
  "url": `https://hackenberg.tech/presentations/${presentation.id}/`,
  ...(presentation.data.event ? {
    "recordedAt": {
      "@id": `https://hackenberg.tech/presentations/${presentation.id}/#event`
    }
  } : {})
});

const presentationSchema = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};

const ui = {
  back: "Back to Presentations",
};

const previewImg = presentation.data.previewImage || presentation.data.icon;
---

<Layout
  title={`${presentation.data.title} | Keynote Dr. Georg Hackenberg`}
  description={presentation.data.description || `${presentation.data.title} - Interactive presentation by Dr. Georg Hackenberg`}
  image={previewImg}
  jsonLd={presentationSchema}
  lang={presentation.data.lang}
>
  <Navbar />

  <main class="flex-grow max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-20 w-full relative z-10">
    <!-- Back button -->
    <a 
      href="/presentations/" 
      class="inline-flex items-center space-x-2 text-xs font-semibold px-4 py-2 rounded-xl bg-brand-blue/10 border border-brand-blue/20 hover:border-brand-blue/30 text-brand-blue transition-all mb-8 cursor-pointer"
    >
      <span>&larr;</span>
      <span>{ui.back}</span>
    </a>

    <!-- Header Section -->
    <header class="mb-10 pb-8 border-b border-element-border">
      <div class="max-w-4xl">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <time datetime={presentation.data.pubDate.toISOString()} class="text-sm font-semibold text-brand-blue/80">
            {presentation.data.pubDate.toLocaleDateString(presentation.data.lang === "de" ? "de-AT" : "en-US", {
              year: "numeric",
              month: "long",
              day: "numeric"
            })}
          </time>
          {presentation.data.event && (
            <>
              <span class="text-gray-500">•</span>
              <span class="text-sm font-semibold text-brand-blue/80">{presentation.data.event}</span>
            </>
          )}
          {presentation.data.location && (
            <>
              <span class="text-gray-500">•</span>
              <span class="text-sm text-gray-400">📍 {presentation.data.location}</span>
            </>
          )}
          {!presentation.data.event && !presentation.data.location && (
            <>
              <span class="text-gray-500">•</span>
              <span class="text-xs font-medium text-slate-400">🎙️ Interactive Presentation</span>
            </>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
          {presentation.data.title}
        </h1>
        {presentation.data.subtitle && (
          <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed mb-6">
            {presentation.data.subtitle}
          </p>
        )}

        {presentation.data.tags && presentation.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {presentation.data.tags.map((tag) => (
              <a 
                href={`/tags/${tag}/`}
                class="px-2.5 py-1 rounded-lg text-xs font-medium bg-element-bg border border-element-border-medium text-gray-400 hover:text-gray-100 hover:border-brand-blue/30 transition-all duration-200"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Interactive Slide & Audio Deck -->
    <section id="presentation-player" class="mb-14 w-full scroll-mt-24">
      <SlideDeck
        presentationId={presentation.id}
        pdfUrl={pdfDownloadUrl}
        pdfDarkUrl={pdfDarkUrl}
        pdfLightUrl={pdfLightUrl}
        slides={renderedSlides.map((s) => ({
          id: s.id,
          title: s.title,
          audioUrl: s.audioUrl,
          cues: s.cues,
          notes: s.notes
        }))}
      >
        {renderedSlides.map((slide, idx) => (
          <section data-slide-id={slide.id} data-slide-index={idx}>
            <slide.Content />
          </section>
        ))}
      </SlideDeck>
    </section>

    <!-- Slide Transcripts & Academic Citations (Interactive Timeline Feed) -->
    <section id="transcripts" class="py-12 md:py-16 border-t border-element-border w-full scroll-mt-20">
      <!-- Section Header -->
      <div class="mb-10">
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3">
          Full <span class="heading-gradient-blue">Transcript</span>
        </h2>
        <p class="text-gray-400 light:text-slate-600 text-sm md:text-base max-w-2xl font-normal leading-relaxed">
          Explore the spoken presentation script and academic citations in chronological sequence. Click any thumbnail or slide badge to jump directly into the interactive player above.
        </p>
      </div>

      <!-- Timeline Feed -->
      <div class="relative space-y-8 md:space-y-10 py-2">
        {renderedSlides.map((slide, idx) => (
          <article 
            id={`transcript-${slide.id}`} 
            class="timeline-slide-entry relative flex items-start gap-3 sm:gap-4 md:gap-6 group"
            data-has-references={slide.references.length > 0 ? "true" : "false"}
          >
            <!-- Timeline vertical connector line to next slide (omitted on the last slide) -->
            {idx < renderedSlides.length - 1 && (
              <div 
                class="absolute left-6 sm:left-7 md:left-8 -translate-x-1/2 top-6 sm:top-7 md:top-8 -bottom-8 md:-bottom-10 w-[2px] bg-element-border-medium light:bg-slate-300 pointer-events-none z-0"
                aria-hidden="true"
              ></div>
            )}

            <!-- Step Badge Node (Click to jump to slide) -->
            <button
              type="button"
              data-jump-to-slide={idx}
              class="relative z-10 w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 shrink-0 rounded-2xl bg-slate-900 light:bg-white border-2 border-slate-700/80 light:border-slate-300 group-hover:border-brand-blue group-hover:bg-[#162238] light:group-hover:bg-[#f0f7ff] flex flex-col items-center justify-center transition-all duration-300 shadow-lg shadow-black/40 light:shadow-sm group-hover:shadow-brand-blue/25 cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-blue"
              title={`Jump to slide ${slide.number} in player`}
              aria-label={`Jump to slide ${slide.number}: ${slide.title}`}
            >
              <span class="text-[9px] sm:text-[10px] uppercase font-bold tracking-wider text-slate-400 light:text-slate-500 group-hover:text-brand-blue transition-colors">
                Slide
              </span>
              <span class="font-mono text-sm sm:text-base md:text-lg font-black text-white light:text-slate-800 group-hover:text-brand-blue transition-colors">
                {String(slide.number).padStart(2, '0')}
              </span>
            </button>

            <!-- Slide Card -->
            <div class="flex-1 min-w-0 glass-card rounded-2xl border border-element-border light:border-slate-200 group-hover:border-element-border-medium light:group-hover:border-slate-300 transition-all duration-300 p-4 sm:p-6 space-y-4 shadow-md hover:shadow-xl">
              <!-- Card Header -->
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 pb-3 border-b border-element-border/60 light:border-slate-200/60">
                <div class="min-w-0">
                  <h3 class="text-base sm:text-lg md:text-xl font-bold text-gray-100 light:text-slate-900 group-hover:text-brand-blue light:group-hover:text-brand-blue transition-colors">
                    {slide.title}
                  </h3>
                  {slide.subtitle && (
                    <p class="text-xs sm:text-sm text-gray-400 light:text-slate-500 mt-0.5 leading-relaxed">
                      {slide.subtitle}
                    </p>
                  )}
                </div>

                <!-- Quick Actions -->
                <div class="flex items-center gap-2 shrink-0 self-start">
                  <button
                    type="button"
                    data-jump-to-slide={idx}
                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-brand-blue/10 hover:bg-brand-blue/20 text-brand-blue border border-brand-blue/20 hover:border-brand-blue/40 transition-all cursor-pointer"
                    title="Play this slide in presentation player"
                  >
                    <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    <span>Jump to slide</span>
                  </button>
                </div>
              </div>

              <!-- Card Body: Responsive 2-column layout on desktop, stacked on mobile -->
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-6 items-start">
                <!-- Left: 16:9 Slide Preview Thumbnail -->
                <div class="md:col-span-4 lg:col-span-5">
                  <div 
                    class="relative aspect-video rounded-xl overflow-hidden border border-element-border light:border-slate-200 group/thumb cursor-pointer shadow-sm hover:shadow-lg transition-all"
                    data-jump-to-slide={idx}
                    title={`Click to jump to slide ${slide.number} in player`}
                  >
                    {slide.thumbnailUrl ? (
                      <img
                        src={slide.thumbnailUrl}
                        alt={`Slide ${slide.number}: ${slide.title}`}
                        title={`Slide ${slide.number} Preview: ${slide.title} - Keynote Presentation Dr. Georg Hackenberg`}
                        loading="lazy"
                        decoding="async"
                        width="480"
                        height="270"
                        class="w-full h-full object-cover transition-transform duration-500 group-hover/thumb:scale-105"
                      />
                    ) : (
                      <div class="w-full h-full bg-element-bg light:bg-slate-100 flex flex-col items-center justify-center p-3 text-center text-gray-500">
                        <svg class="w-8 h-8 stroke-current mb-1 text-gray-400" fill="none" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                        </svg>
                        <span class="text-[11px] font-medium">Slide {slide.number}</span>
                      </div>
                    )}
                    
                    <!-- Hover Overlay -->
                    <div class="absolute inset-0 bg-slate-950/50 opacity-0 group-hover/thumb:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]">
                      <span class="px-3 py-1.5 rounded-lg bg-brand-blue text-slate-950 font-bold text-xs flex items-center gap-1.5 shadow-lg transform translate-y-1 group-hover/thumb:translate-y-0 transition-transform">
                        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        <span>View in Player</span>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Right: Spoken Script & Structured Academic References -->
                <div class="md:col-span-8 lg:col-span-7 space-y-3.5 min-w-0">
                  <!-- Voiceover Spoken Script -->
                  {slide.voiceover && (
                    <div class="transcript-voiceover p-3.5 rounded-xl bg-white/[0.02] light:bg-slate-50/80 border border-element-border light:border-slate-200 space-y-1.5">
                      <div class="flex items-center justify-between">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-brand-blue flex items-center gap-1.5">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
                          Spoken Presentation Script
                        </span>
                        <button
                          type="button"
                          data-copy-text={stripCues(slide.voiceover)}
                          class="copy-script-btn text-[11px] text-gray-400 light:text-slate-500 hover:text-gray-200 light:hover:text-slate-800 flex items-center gap-1 transition-colors cursor-pointer"
                          title="Copy voiceover text"
                        >
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                          <span class="copy-label">Copy</span>
                        </button>
                      </div>
                      <p class="text-xs sm:text-sm text-gray-200 light:text-slate-700 leading-relaxed">
                        {stripCues(slide.voiceover)}
                      </p>
                    </div>
                  )}

                  <!-- Structured BibTeX References -->
                  {slide.references && slide.references.length > 0 && (
                    <div class="transcript-references p-3.5 rounded-xl bg-purple-500/5 light:bg-purple-50/50 border border-purple-500/20 light:border-purple-200 space-y-2.5">
                      <div class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-purple-400 light:text-purple-700">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                        <span>Academic & Industry References ({slide.references.length})</span>
                      </div>
                      <ul class="space-y-2.5">
                        {slide.references.map((ref) => (
                          <li class="text-xs text-gray-300 light:text-slate-600 leading-relaxed pl-2.5 border-l-2 border-purple-500/40 light:border-purple-300 flex flex-col gap-1">
                            <div>
                              <span class="font-bold text-gray-100 light:text-slate-900">{ref.author}</span>
                              {ref.year && <span class="text-gray-400 light:text-slate-500"> ({ref.year})</span>}:
                              <span class="italic text-gray-200 light:text-slate-800"> "{ref.title}"</span>.
                              {ref.type === 'inproceedings' && ref.booktitle && (
                                <span class="text-gray-400 light:text-slate-500 block sm:inline"> In <span class="text-gray-300 light:text-slate-700">{ref.booktitle}</span>{ref.pages ? `, pp. ${ref.pages}` : ''}.</span>
                              )}
                              {ref.type === 'article' && ref.journal && (
                                <span class="text-gray-400 light:text-slate-500 block sm:inline"> <span class="text-gray-300 light:text-slate-700">{ref.journal}</span>{ref.volume ? ` ${ref.volume}` : ''}{ref.number ? `(${ref.number})` : ''}{ref.pages ? `, pp. ${ref.pages}` : ''}.</span>
                              )}
                              {ref.type === 'book' && ref.publisher && (
                                <span class="text-gray-400 light:text-slate-500 block sm:inline"> {ref.publisher}.</span>
                              )}
                              {ref.type === 'online' && ref.siteName && (
                                <span class="text-gray-400 light:text-slate-500 block sm:inline"> <span class="text-gray-300 light:text-slate-700">{ref.siteName}</span>.</span>
                              )}
                              {ref.type === 'misc' && ref.howpublished && (
                                <span class="text-gray-400 light:text-slate-500 block sm:inline"> {ref.howpublished}.</span>
                              )}
                            </div>
                            <div class="flex flex-wrap items-center gap-2 pt-0.5">
                              <a
                                href={ref.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1 text-[11px] font-semibold text-purple-400 light:text-purple-700 hover:text-purple-300 light:hover:text-purple-900 hover:underline"
                              >
                                <span>Open Source</span>
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 01-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                              </a>
                              {'doi' in ref && ref.doi && (
                                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-purple-500/15 light:bg-purple-100 text-purple-300 light:text-purple-800 border border-purple-500/25 light:border-purple-300">
                                  DOI: {ref.doi}
                                </span>
                              )}
                              <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-white/5 light:bg-slate-200 text-gray-400 light:text-slate-700 border border-white/10 light:border-slate-300">
                                {ref.type}
                              </span>
                            </div>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Contact & Collaboration Section (English) -->
    <GetInTouchCard
      sectionHeading="Start a Conversation"
      sectionDescription="Interested in booking this keynote, discussing the slide deck, or exploring academic and industrial collaboration? Feel free to reach out directly via email."
      cardHeading="Keynote & Topic Inquiry"
      emailSubject={`Inquiry: ${presentation.data.title}`}
      accentColor="blue"
      primaryButtonText="Open Email Client"
    />
  </main>

  <script>
    // Jump-to-Slide Interactivity & Smooth Scrolling
    document.querySelectorAll('[data-jump-to-slide]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const slideIdxStr = btn.getAttribute('data-jump-to-slide');
        if (slideIdxStr === null) return;
        const slideIdx = parseInt(slideIdxStr, 10);
        if (isNaN(slideIdx)) return;

        // 1. Smoothly scroll up to the presentation player
        const playerEl = document.getElementById('presentation-player') || document.querySelector('.slide-deck-wrapper');
        if (playerEl) {
          playerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // 2. Dispatch custom event to switch slide in player
        window.dispatchEvent(new CustomEvent('deck:jump-to-slide', { detail: { index: slideIdx } }));
      });
    });

    // Copy Spoken Voiceover Script to Clipboard
    document.querySelectorAll('.copy-script-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const textToCopy = btn.getAttribute('data-copy-text');
        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy);
          const label = btn.querySelector('.copy-label');
          if (label) {
            const orig = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => {
              label.textContent = orig;
            }, 2000);
          }
        } catch {
          // Fallback or ignore
        }
      });
    });
  </script>

  <!-- Related Content -->
  <RelatedContent
    currentCollection="presentations"
    currentId={presentation.id}
    tags={presentation.data.tags}
  />
</Layout>
