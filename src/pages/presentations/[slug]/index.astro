---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import SlideDeck from "@components/slides/player/SlideDeck.astro";
import SlideReferencesModal from "@components/slides/player/SlideReferencesModal.astro";
import RelatedContent from "@components/RelatedContent.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import TagChip from "@components/TagChip.astro";
import { getCollection, render } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import { getFileContentHash, getHashedFilename } from "@commons/server/content-hash.js";
import { getMp3Duration } from "@commons/server/audio-metadata.js";
import { getPresentationDuration } from "@commons/server/reading-time.js";
import { formatDate } from "@commons/shared/format";

export async function getStaticPaths() {
  const presentations = await getCollection("presentations");
  return presentations.map((presentation) => ({
    params: { slug: presentation.id },
    props: { presentation },
  }));
}

const { presentation } = Astro.props;
const durationInfo = getPresentationDuration(presentation.id, { lang: presentation.data.lang });

// Load all slides for this presentation, sorted by filename
const allSlides = await getCollection("slides");
const presentationSlides = allSlides
  .filter((s) => s.id.startsWith(presentation.id))
  .sort((a, b) => a.id.localeCompare(b.id));

// Prepare slide metadata and rendered components
const renderedSlides = await Promise.all(
  presentationSlides.map(async (slide, idx) => {
    const { Content } = await render(slide);
    const slideBase = path.basename(slide.id);

    // Check if audio file and cues file exist
    const presentationDir = path.resolve("src/content/presentations", presentation.id);
    const audioFilePath = path.join(presentationDir, "audio", `${slideBase}.mp3`);
    const cuesFilePath = path.join(presentationDir, "audio", `${slideBase}.cues.json`);

    let audioUrl = undefined;
    let durationSec = undefined;
    if (fs.existsSync(audioFilePath)) {
      const hash = getFileContentHash(audioFilePath);
      audioUrl = `/presentations/${presentation.id}/audio/${getHashedFilename(`${slideBase}.mp3`, hash)}`;
      durationSec = getMp3Duration(audioFilePath);
    }

    let cues: Record<string, number> = {};
    if (fs.existsSync(cuesFilePath)) {
      try {
        cues = JSON.parse(fs.readFileSync(cuesFilePath, "utf8"));
      } catch {
        cues = {};
      }
    }

    return {
      id: slideBase,
      number: idx + 1,
      title: slide.data.title,
      subtitle: slide.data.subtitle,
      slideLayout: slide.data.slideLayout,
      voiceover: slide.data.voiceover,
      notes: slide.data.notes,
      references: slide.data.references || [],
      audioUrl,
      durationSec,
      cues,
      Content
    };
  })
);

// Check if slides-dark.pdf or slides-light.pdf exist for download button
const presentationDir = path.resolve("src/content/presentations", presentation.id);
const pdfDarkPath = path.join(presentationDir, "slides-dark.pdf");
const pdfLightPath = path.join(presentationDir, "slides-light.pdf");
const previewPath = path.join(presentationDir, "preview.jpg");

let previewUrl: string | undefined = undefined;
if (fs.existsSync(previewPath)) {
  const previewHash = getFileContentHash(previewPath);
  previewUrl = `/presentations/${presentation.id}/${getHashedFilename('preview.jpg', previewHash)}`;
}

const pdfDarkUrl = fs.existsSync(pdfDarkPath) 
  ? `/presentations/${presentation.id}/slides-dark.pdf` 
  : undefined;

const pdfLightUrl = fs.existsSync(pdfLightPath) 
  ? `/presentations/${presentation.id}/slides-light.pdf` 
  : undefined;

const pdfDownloadUrl = pdfDarkUrl || pdfLightUrl;

const stripCues = (text: string) => (text ? text.replace(/\{(\/)?cue(?::[^}]+)?\}/g, "") : "");

type JsonLdValue = string | number | boolean | null | undefined | { [key: string]: JsonLdValue } | JsonLdValue[];
type JsonLdNode = Record<string, JsonLdValue>;

// Schema.org: PresentationDigitalDocument
const schemaGraph: JsonLdNode[] = [
  {
    "@type": "PresentationDigitalDocument",
    "@id": `https://hackenberg.tech/presentations/${presentation.id}/#presentation`,
    "name": presentation.data.title,
    "headline": presentation.data.subtitle || presentation.data.title,
    "description": presentation.data.description,
    ...(previewUrl ? { "image": `https://hackenberg.tech${previewUrl}` } : {}),
    "author": {
      "@id": "https://hackenberg.tech/#georg"
    },
    "datePublished": presentation.data.pubDate.toISOString(),
    "inLanguage": presentation.data.lang,
    "url": `https://hackenberg.tech/presentations/${presentation.id}/`
  }
];

const presentationSchema = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};

const previewImg = previewUrl || presentation.data.previewImage || presentation.data.icon;
---

<Layout
  title={`${presentation.data.title} | Keynote Dr. Georg Hackenberg`}
  description={presentation.data.description || `${presentation.data.title} - Interactive presentation by Dr. Georg Hackenberg`}
  image={previewImg}
  jsonLd={presentationSchema}
  lang={presentation.data.lang}
  hasMath={true}
>
  <Navbar />

  <Section id="presentation-content" padding="standard">
    <!-- Header in Reading Width -->
    <Container size="reading" padding="none">
      <!-- Breadcrumbs Navigation -->
      <Breadcrumbs 
        items={[
          { label: "Home", href: "/" },
          { label: "Presentations", href: "/presentations/" },
          { label: presentation.data.title }
        ]}
        domain="presentations" 
      />

      <!-- Header Section -->
      <header class="mb-10 sm:mb-12 relative">
        <div class="max-w-4xl">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <time datetime={presentation.data.pubDate.toISOString()} class="text-sm font-semibold text-domain-presentations">
              {formatDate(presentation.data.pubDate, 'long', presentation.data.lang === "de" ? "de-AT" : "en-US")}
            </time>
            <span class="text-gray-500">•</span>
            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400">
              <svg class="w-3.5 h-3.5 text-gray-400 light:text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>{durationInfo.text}</span>
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
            {presentation.data.title}
          </h1>
          {presentation.data.subtitle && (
            <p class="text-base sm:text-lg text-gray-300 font-normal leading-relaxed mb-6">
              {presentation.data.subtitle}
            </p>
          )}

          {presentation.data.tags && presentation.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-6">
              {presentation.data.tags.map((tag) => (
                <TagChip tag={tag} />
              ))}
            </div>
          )}
        </div>
      </header>
    </Container>

    <!-- Player in Wide Width -->
    <Container size="wide" padding="none">
      <!-- Interactive Slide & Audio Deck -->
      <div id="presentation-player" class="w-full">
        <SlideDeck
          presentationId={presentation.id}
          pdfUrl={pdfDownloadUrl}
          pdfDarkUrl={pdfDarkUrl}
          pdfLightUrl={pdfLightUrl}
          slides={renderedSlides.map((s) => ({
            id: s.id,
            title: s.title,
            subtitle: stripCues(s.subtitle || ""),
            slideLayout: s.slideLayout,
            voiceover: stripCues(s.voiceover || ""),
            audioUrl: s.audioUrl,
            durationSec: s.durationSec,
            cues: s.cues,
            notes: s.notes,
            references: s.references
          }))}
        >
          {renderedSlides.map((slide, idx) => (
            <section id={`slide-${slide.id.replace(/\.[^/.]+$/, '').replace(/_/g, '-')}`} data-slide-id={slide.id} data-slide-index={idx}>
              <slide.Content />
            </section>
          ))}
        </SlideDeck>
      </div>
    </Container>
  </Section>

  <!-- Related Content -->
  <RelatedContent
    currentCollection="presentations"
    currentId={presentation.id}
    tags={presentation.data.tags}
  />

  <SlideReferencesModal slot="modals" />
</Layout>
