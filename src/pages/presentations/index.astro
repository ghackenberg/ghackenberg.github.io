---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import PresentationCard from "@components/PresentationCard.astro";
import FilterToolbar from "@components/FilterToolbar.astro";
import CatalogPreFilter from "@components/CatalogPreFilter.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { buildCollectionPageSchema } from "@commons/server/json-ld";
import { getCollection } from "astro:content";

const allPresentations = await getCollection("presentations");
const presentations = allPresentations.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique tags for tag filter across all presentations
const tagsSet = new Set<string>();
for (const presentation of presentations) {
  if (presentation.data.tags) {
    presentation.data.tags.forEach((tag) => {
      tagsSet.add(tag);
    });
  }
}
const allTags = Array.from(tagsSet).sort();
const itemTags = presentations.map(p => (p.data.tags || []).map(t => t.toLowerCase()));

const pagePreviewImage = presentations.find(t => t.data.image)?.data.image;

---

<Layout
  title="Interactive Presentations | Dr. Georg Hackenberg"
  description="Explore interactive presentations, keynote slide decks, and executive briefings by Dr. Georg Hackenberg on AI, search engines, knowledge graphs, and software architecture."
  image={pagePreviewImage}
  jsonLd={buildCollectionPageSchema("presentations", presentations.map((p) => ({ id: `https://hackenberg.tech/presentations/${p.id}/#presentation` })))}
  lang="en"
>
  <Navbar />

  <Container size="wide">
    <Breadcrumbs domain="presentations" />

    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-6">
        Interactive <span class="text-domain-presentations">Presentations</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Keynotes and technical slide decks featuring synchronized neural voiceovers, interactive vector schematics, and complete speaker transcripts.
      </p>
    </div>

    <!-- Filter Toolbar -->
    <FilterToolbar
      searchId="presentation-search"
      searchPlaceholder="Search presentations..."
      tags={allTags}
      domain="presentations"
      itemTags={itemTags}
      totalCount={presentations.length}
      pageSize={12}
    />

    <!-- Presentations Grid (3-2-1) -->
    {presentations.length === 0 ? (
      <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No presentations found.</p>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="presentations-grid">
          {presentations.map((presentation, idx) => {
            const tagsJoined = (presentation.data.tags || [])
              .join(" ")
              .toLowerCase();
            const isInitialHidden = idx >= 12;
            return (
              <div 
                class={`presentation-card-item h-full ${isInitialHidden ? "hidden" : ""}`}
                style={isInitialHidden ? "display: none;" : ""}
                data-title={presentation.data.title.toLowerCase()}
                data-desc={(presentation.data.subtitle || presentation.data.description || "").toLowerCase()}
                data-tags={tagsJoined}
              >
                <PresentationCard
                  id={presentation.id}
                  title={presentation.data.title}
                  subtitle={presentation.data.subtitle}
                  description={presentation.data.description}
                  pubDate={presentation.data.pubDate}
                  image={presentation.data.image}
                  tags={presentation.data.tags || []}
                />
              </div>
            );
          })}
        </div>

        <CatalogPreFilter
          itemSelector=".presentation-card-item"
          noResultsId="no-presentations-message"
          pageSize={12}
        />
      </>
    )}

    <p id="no-presentations-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
      No presentations match your selected filter criteria.
    </p>

    <!-- Pagination Controls -->
    <nav id="presentations-pagination" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-element-border mt-10" aria-label="Presentations Pagination">
      <div class="flex-1 w-full sm:w-auto text-left">
        <button 
          type="button" 
          data-action="prev" 
          disabled 
          class="prev-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border text-gray-600 text-sm font-semibold cursor-not-allowed opacity-40 w-full sm:w-auto transition-all duration-200"
        >
          <span class="mr-1.5">&larr;</span>
          <span>Previous</span>
        </button>
      </div>

      <div class="page-numbers-container flex items-center justify-center gap-1.5 order-3 sm:order-2 flex-wrap"></div>

      <div class="flex-1 w-full sm:w-auto text-right order-2 sm:order-3">
        <button 
          type="button" 
          data-action="next" 
          class="next-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border-medium text-gray-300 hover:text-gray-100 hover:border-domain-presentations/30 hover:bg-element-bg-hover transition-all duration-200 text-sm font-semibold group w-full sm:w-auto cursor-pointer"
        >
          <span>Next</span>
          <span class="group-hover:translate-x-0.5 transition-transform ml-1.5">&rarr;</span>
        </button>
      </div>
    </nav>
  </Container>
</Layout>

<script>
  import { ClientListFilter } from "@commons/client/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".presentation-card-item",
      searchFieldSelector: "#presentation-search",
      searchDataAttributes: ["data-title", "data-desc", "data-tags"],
      searchParamKey: "q",
      resetButtonSelector: "#presentation-search-reset",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag",
          multiple: true
        }
      ],
      pagination: {
        pageSize: 12,
        navSelector: "#presentations-pagination",
        pageParamKey: "page",
        domain: "presentations",
        scrollToSelector: "#presentations-grid"
      },
      scrollToSelector: "#presentations-grid",
      noResultsSelector: "#no-presentations-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>
