---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import PresentationCard from "../../components/PresentationCard.astro";
import { getCollection } from "astro:content";

const allPresentations = await getCollection("presentations");
const presentations = allPresentations.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique tags for tag filter across all presentations
const tagsSet = new Set<string>();
for (const presentation of presentations) {
  if (presentation.data.tags) {
    presentation.data.tags.forEach((tag) => {
      tagsSet.add(tag);
    });
  }
}
const allTags = Array.from(tagsSet).sort();

const pagePreviewImage = presentations.find(t => t.data.previewImage || t.data.icon)?.data.previewImage || presentations.find(t => t.data.previewImage || t.data.icon)?.data.icon;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Interactive Presentations",
      "item": "https://hackenberg.tech/presentations/"
    }
  ]
};
---

<Layout
  title="Interactive Presentations | Dr. Georg Hackenberg"
  description="Explore interactive presentations, keynote slide decks, and executive briefings by Dr. Georg Hackenberg on AI, search engines, knowledge graphs, and software architecture."
  image={pagePreviewImage}
  jsonLd={breadcrumbSchema}
  lang="en"
>
  <Navbar />

  <main class="flex-grow max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-20 w-full relative z-10">
    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
        Interactive <span class="heading-gradient-blue">Presentations</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Keynotes, technical slide decks, and executive briefings featuring synchronized neural voiceovers, vector diagrams, and complete transcripts for industry and science.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Filter Sidebar (Column 1) -->
      <div class="lg:col-span-3 order-1 lg:order-2 lg:sticky lg:top-24">
        <div class="glass-card p-6 rounded-2xl border border-element-border flex flex-col lg:max-h-[calc(100vh-8rem)]">
          <div class="mb-4 shrink-0">
            <h2 class="text-lg font-bold flex items-center space-x-2">
              <span>⚙️</span>
              <span>Filter Presentations</span>
            </h2>
          </div>

          <!-- Text Search -->
          <div class="mb-4 shrink-0">
            <label for="presentation-search" class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block mb-2">Search</label>
            <div class="relative">
              <input 
                type="text" 
                id="presentation-search" 
                placeholder="Search presentations..." 
                class="w-full bg-element-bg border border-element-border-medium rounded-lg px-3 py-2 pl-8 text-xs placeholder-gray-500 focus:outline-none focus:border-brand-blue/50 focus:ring-1 focus:ring-brand-blue/50 transition-all duration-200"
              />
              <span class="absolute left-2.5 top-2.5 text-xs text-gray-500">🔍</span>
            </div>
          </div>

          <!-- Technologies / Tags list -->
          <div class="flex-1 min-h-0 flex flex-col">
            <div class="flex items-center justify-between mb-2 shrink-0">
              <span class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block">Filter by Tag</span>
              <span class="text-[10px] text-gray-500 font-medium">{allTags.length} topics</span>
            </div>
            <div class="flex flex-wrap gap-1.5 max-h-[260px] lg:max-h-none flex-1 min-h-0 overflow-y-auto pr-1 custom-scrollbar-thin content-start" id="tag-filter-buttons">
              {allTags.map((tag) => (
                <button 
                  type="button" 
                  class="tag-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold border cursor-pointer transition-all duration-200"
                  data-tag={tag}
                >
                  #{tag}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Presentations Grid (Column 2) -->
      <div class="lg:col-span-9 order-2 lg:order-1">
        {presentations.length === 0 ? (
          <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No presentations found.</p>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 scroll-mt-28" id="presentations-grid">
            {presentations.map((presentation) => {
              const tagsJoined = (presentation.data.tags || [])
                .join(" ")
                .toLowerCase();
              return (
                <div 
                  class="presentation-card-item h-full"
                  data-title={presentation.data.title.toLowerCase()}
                  data-desc={(presentation.data.subtitle || presentation.data.description || "").toLowerCase()}
                  data-event={(presentation.data.event || "").toLowerCase()}
                  data-tags={tagsJoined}
                >
                  <PresentationCard
                    id={presentation.id}
                    title={presentation.data.title}
                    subtitle={presentation.data.subtitle}
                    description={presentation.data.description}
                    pubDate={presentation.data.pubDate}
                    event={presentation.data.event}
                    location={presentation.data.location}
                    icon={presentation.data.previewImage || presentation.data.icon}
                    tags={presentation.data.tags || []}
                  />
                </div>
              );
            })}
          </div>
        )}

        <p id="no-presentations-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
          No presentations match your selected filter criteria.
        </p>

        <!-- Pagination Controls -->
        <nav id="presentations-pagination" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-white/5 mt-10" aria-label="Presentations Pagination">
          <div class="flex-1 w-full sm:w-auto text-left">
            <button 
              type="button" 
              data-action="prev" 
              disabled 
              class="prev-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border text-gray-600 text-sm font-semibold cursor-not-allowed opacity-40 w-full sm:w-auto transition-all duration-200"
            >
              <span class="mr-1.5">&larr;</span>
              <span>Previous</span>
            </button>
          </div>

          <div class="pagination-pages flex items-center justify-center gap-1.5 flex-wrap">
            <!-- Dynamic page buttons injected by ClientListFilter -->
          </div>

          <div class="flex-1 w-full sm:w-auto text-right">
            <button 
              type="button" 
              data-action="next" 
              disabled 
              class="next-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border text-gray-600 text-sm font-semibold cursor-not-allowed opacity-40 w-full sm:w-auto transition-all duration-200"
            >
              <span>Next</span>
              <span class="group-hover:translate-x-0.5 transition-transform ml-1.5">&rarr;</span>
            </button>
          </div>
        </nav>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { ClientListFilter } from "../../scripts/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".presentation-card-item",
      searchFieldSelector: "#presentation-search",
      searchDataAttributes: ["data-title", "data-desc", "data-event", "data-tags"],
      searchParamKey: "q",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag"
        }
      ],
      pagination: {
        pageSize: 10,
        navSelector: "#presentations-pagination",
        pageParamKey: "page",
        theme: "blue",
        scrollToSelector: "#presentations-grid"
      },
      scrollToSelector: "#presentations-grid",
      noResultsSelector: "#no-presentations-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>

<style>
  .tag-filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #9ca3af;
  }

  .tag-filter-btn:hover:not(.active) {
    border-color: rgba(59, 130, 246, 0.3);
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.08);
  }

  .tag-filter-btn.active {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
    color: #7dd3fc;
    box-shadow: 0 0 15px -3px rgba(59, 130, 246, 0.25);
  }

  /* Light mode overrides */
  :global(.light) .tag-filter-btn {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.08);
    color: #475569;
  }

  :global(.light) .tag-filter-btn:hover:not(.active) {
    background: rgba(59, 130, 246, 0.06);
    border-color: rgba(59, 130, 246, 0.3);
    color: #1d4ed8;
  }

  :global(.light) .tag-filter-btn.active {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    color: #1d4ed8;
    box-shadow: 0 0 15px -3px rgba(59, 130, 246, 0.2);
  }
</style>
