---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Container from '@components/Container.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import NewsletterCard from '@components/NewsletterCard.astro';
import { getCollection } from 'astro:content';

const allIssues = await getCollection('newsletters');
const sortedIssues = allIssues.sort((a, b) => b.data.issueNumber - a.data.issueNumber);

const pageTitle = 'Email Newsletters | Dr. Georg Hackenberg';
const pageDescription =
  'Archive of English-language engineering and research newsletter dispatches covering blog posts, presentations, courses, projects, visualizations, and publications.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://hackenberg.tech',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Newsletters',
      item: 'https://hackenberg.tech/newsletters/',
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} jsonLd={breadcrumbSchema} lang="en">
  <Navbar />

  <Container size="wide">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Newsletters' },
      ]}
      domain="posts"
    />

    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-6">
        Email <span class="text-domain-posts">Newsletters</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Periodic English-language dispatches summarizing newly published blog posts, presentations, courses, projects, visualizations, and publications.
      </p>
    </div>

    {sortedIssues.length === 0 ? (
      <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">
        No newsletter issues found.
      </p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="newsletters-grid">
        {sortedIssues.map((issue) => (
          <NewsletterCard
            id={issue.id}
            issueNumber={issue.data.issueNumber}
            title={issue.data.title}
            description={issue.data.description}
            pubDate={issue.data.pubDate}
            icon={issue.data.icon}
          />
        ))}
      </div>
    )}
  </Container>
</Layout>
