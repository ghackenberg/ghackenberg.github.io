---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import { getCollection } from "astro:content";
import PublicationCard from "@components/PublicationCard.astro";
import FilterToolbar from "@components/FilterToolbar.astro";
import CatalogPreFilter from "@components/CatalogPreFilter.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { buildCollectionPageSchema } from "@commons/server/json-ld";
import { getPageNumbers } from "@commons/client/pagination";

const publications = (await getCollection("publications")).sort(
  (a, b) => b.id.localeCompare(a.id)
);

// Collect all unique tags for tag filter
const tags = Array.from(
  new Set(publications.flatMap((pub) => pub.data.tags || []))
).sort();
const itemTags = publications.map(p => (p.data.tags || []).map(t => t.toLowerCase()));

const PUBS_PER_PAGE = 12;
const totalPages = Math.ceil(publications.length / PUBS_PER_PAGE);

const rawFirstPubIcon = publications.find((pub) => pub.data.image)?.data.image;
const firstPubIcon = typeof rawFirstPubIcon === 'object' && rawFirstPubIcon !== null && 'src' in rawFirstPubIcon ? rawFirstPubIcon.src : rawFirstPubIcon;

---

<Layout 
  title="Reviewed Publications | Dr. Georg Hackenberg" 
  description="Browse academic research papers, conference articles, book chapters, and presentations by Dr. Georg Hackenberg on smart grids, gestural input, and informatics."
  image={firstPubIcon}
  jsonLd={buildCollectionPageSchema("publications", publications.map((p) => ({ id: `https://hackenberg.tech/publications/${p.id}/#article` })))}
>
  <Navbar />

  <Container size="wide">
    <Breadcrumbs domain="publications" />

    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-6">
        Reviewed <span class="text-domain-publications">Publications</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Peer-reviewed papers, journal articles, and conference presentations focusing on gesture control, software engineering, and smart energy systems.
      </p>
    </div>

    <!-- Filter Toolbar -->
    <FilterToolbar
      searchId="publication-search"
      searchPlaceholder="Search papers..."
      tags={tags}
      domain="publications"
      itemTags={itemTags}
      totalCount={publications.length}
      pageSize={PUBS_PER_PAGE}
    />

    <!-- Publications Grid (3-2-1) -->
    {publications.length === 0 ? (
      <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No publications found.</p>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="publications-grid">
          {publications.map((pub, idx) => {
            const tagsJoined = (pub.data.tags || []).join(" ").toLowerCase();
            const isInitialHidden = idx >= PUBS_PER_PAGE;
            return (
              <div 
                class={`publication-card-item h-full ${isInitialHidden ? "hidden" : ""}`}
                style={isInitialHidden ? "display: none;" : ""}
                data-title={pub.data.title.toLowerCase()}
                data-author={pub.data.authors.map(a => a.name).join(' ').toLowerCase()}
                data-book={(pub.data.book || "").toLowerCase()}
                data-tags={tagsJoined}
              >
                <PublicationCard
                  id={pub.id}
                  title={pub.data.title}
                  authors={pub.data.authors}
                  pubDate={pub.data.pubDate}
                  book={pub.data.book}
                  tags={pub.data.tags}
                  publisherUrl={pub.data.publisherUrl}
                  image={pub.data.image}
                />
              </div>
            );
          })}
        </div>

        <CatalogPreFilter
          itemSelector=".publication-card-item"
          noResultsId="no-publications-message"
          searchAttributes={["data-title", "data-author", "data-book", "data-tags"]}
          pageSize={PUBS_PER_PAGE}
        />

        <!-- Pagination Controls -->
        {totalPages > 1 && (
          <nav id="publications-pagination" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-12 border-t border-element-border mt-12" aria-label="Pagination">
            <!-- Previous Button -->
            <div class="flex-1 w-full sm:w-auto text-left">
              <button 
                type="button" 
                data-action="prev" 
                disabled 
                class="prev-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border text-gray-600 text-sm font-semibold cursor-not-allowed opacity-40 w-full sm:w-auto transition-all duration-200"
              >
                <span class="mr-1.5">&larr;</span>
                <span>Previous</span>
              </button>
            </div>

            <!-- Page Numbers -->
            <div class="page-numbers-container flex items-center justify-center gap-1.5 order-3 sm:order-2 flex-wrap">
              {getPageNumbers(1, totalPages).map((num) => {
                if (typeof num === 'string') {
                  return <span class="px-3 py-2 text-gray-500 text-sm font-medium">...</span>;
                }
                const isCurrent = num === 1;
                return isCurrent ? (
                  <span 
                    class="px-3.5 py-2 rounded-xl text-sm font-bold text-white bg-domain-publications shadow-lg shadow-domain-publications/20 cursor-default select-none min-w-[38px] text-center" 
                    aria-current="page"
                    data-page-btn={num}
                  >
                    {num}
                  </span>
                ) : (
                  <button 
                    type="button" 
                    data-goto={num} 
                    class="px-3.5 py-2 rounded-xl text-sm font-medium bg-element-bg border border-element-border-medium text-gray-400 hover:text-gray-100 hover:border-domain-publications/30 hover:bg-element-bg-hover transition-all duration-200 min-w-[38px] text-center cursor-pointer"
                  >
                    {num}
                  </button>
                );
              })}
            </div>

            <!-- Next Button -->
            <div class="flex-1 w-full sm:w-auto text-right order-2 sm:order-3">
              <button 
                type="button" 
                data-action="next" 
                class="next-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border-medium text-gray-300 hover:text-gray-100 hover:border-domain-publications/30 hover:bg-element-bg-hover transition-all duration-200 text-sm font-semibold group w-full sm:w-auto cursor-pointer"
              >
                <span>Next</span>
                <span class="group-hover:translate-x-0.5 transition-transform ml-1.5">&rarr;</span>
              </button>
            </div>
          </nav>
        )}
      </>
    )}
    <p id="no-publications-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
      No publications match your selected filter criteria.
    </p>
  </Container>
</Layout>

<script>
  import { ClientListFilter } from "@commons/client/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".publication-card-item",
      searchFieldSelector: "#publication-search",
      searchDataAttributes: ["data-title", "data-author", "data-book", "data-tags"],
      searchParamKey: "q",
      resetButtonSelector: "#publication-search-reset",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag",
          multiple: true
        }
      ],
      pagination: {
        pageSize: 12,
        navSelector: "#publications-pagination",
        pageParamKey: "page",
        domain: "publications",
        scrollToSelector: "#publications-grid"
      },
      scrollToSelector: "#publications-grid",
      noResultsSelector: "#no-publications-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>
