---
import Layout from "@layouts/Layout.astro";
import { buildPublicationSchema } from "@commons/server/json-ld";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import TagChip from "@components/TagChip.astro";
import { getCollection } from "astro:content";
import { formatDate } from "@commons/shared/format";

export async function getStaticPaths() {
  const pubs = await getCollection("publications");
  return pubs.map((pub) => ({
    params: { slug: pub.id },
    props: { pub },
  }));
}

const { pub } = Astro.props;

function getPublisherDomain(url: string | undefined): string {
  if (!url) return "";
  try {
    const parsed = new URL(url);
    let hostname = parsed.hostname;
    if (hostname.startsWith("www.")) {
      hostname = hostname.substring(4);
    }
    if (hostname === "doi.org") {
      const path = parsed.pathname;
      if (path.includes("10.1109")) return "ieeexplore.ieee.org";
      if (path.includes("10.1145") || path.includes("10.5555")) return "dl.acm.org";
      if (path.includes("10.1007")) return "link.springer.com";
      if (path.includes("10.1016")) return "sciencedirect.com";
      if (path.includes("10.1117")) return "spiedigitallibrary.org";
      if (path.includes("10.3139")) return "hanser-elibrary.com";
      if (path.includes("10.1515")) return "degruyter.com";
      if (path.includes("10.5220")) return "scitepress.org";
      if (path.includes("10.1017")) return "cambridge.org";
    }
    return hostname;
  } catch (e) {
    return "Publisher Page";
  }
}

const cleanAbstract = pub.data.abstract 
  ? pub.data.abstract.replace(/\s+/g, " ").trim()
  : "";
const seoDescription = cleanAbstract.length > 156 
  ? `${cleanAbstract.substring(0, 153)}...` 
  : cleanAbstract || `Academic research publication by Dr. Georg Hackenberg: "${pub.data.title}"`;



const publicationSchema = buildPublicationSchema({ pub, siteUrl: Astro.site?.origin || "https://hackenberg.tech" });
---

<Layout 
  title={`${pub.data.title} | Dr. Georg Hackenberg`} 
  description={seoDescription}
  image={pub.data.icon}
  type="article"
  pubDate={pub.data.pubDate}
  tags={pub.data.tags}
  jsonLd={publicationSchema}
>
  <Navbar />

  <Section id="publication-content" padding="standard">
    <Container size="reading" padding="none">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs 
      items={[
        { label: "Home", href: "/" },
        { label: "Publications", href: "/publications/" },
        { label: pub.data.title }
      ]}
      domain="publications"
    />

    <!-- Publication Header -->
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-gray-100 mb-6 leading-tight">
        {pub.data.title}
      </h1>

      <p class="text-gray-300 text-base md:text-lg mb-4 font-normal">
        <span set:html={pub.data.author} />
      </p>

      <p class="text-gray-400 text-sm mb-6 font-normal italic">
        {pub.data.book && <span>{pub.data.book}, </span>}
        <span>{formatDate(pub.data.pubDate, 'long')}</span>
      </p>

      {pub.data.tags && pub.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {pub.data.tags.map(tag => (
            <TagChip tag={tag} />
          ))}
        </div>
      )}

      {pub.data.publisherUrl && (
        <div class="flex flex-wrap items-center gap-3 mt-6">
          <a 
            href={pub.data.publisherUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all duration-300 hover:scale-105 flex items-center space-x-2 cursor-pointer bg-domain-publications/12 hover:bg-domain-publications/25 border border-domain-publications/20 hover:border-domain-publications/45 text-domain-publications"
          >
            <span>{getPublisherDomain(pub.data.publisherUrl)}</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
      )}
    </header>

    <!-- Content Sections -->
    <div class="glass-card p-6 md:p-10 rounded-3xl border border-element-border relative overflow-hidden prose-custom">
      {pub.data.abstract && (
        <div id="abstract" class="mb-10 md:mb-12">
          <h2 id="abstract-heading" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">Publication Abstract</h2>
          <p class="text-gray-300 text-base md:text-lg leading-relaxed font-normal">
            {pub.data.abstract}
          </p>
        </div>
      )}

      {pub.data.bibtex && (
        <div id="bibtex-citation">
          <div class="flex items-center justify-between border-b border-element-border pb-2 mb-4">
            <h2 id="bibtex-citation-heading" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 !border-b-0 !pb-0 !mb-0 !mt-0">BibTeX Citation</h2>
            <button 
              id="copy-bibtex-btn"
              data-track-event="High Intent: Copy BibTeX"
              data-track-id={pub.id}
              class="px-4 py-2 text-xs font-semibold rounded-lg bg-element-bg hover:bg-element-bg-hover text-gray-300 hover:text-gray-100 border border-element-border-medium hover:border-element-border-hover transition-all duration-200 flex items-center space-x-2"
            >
              <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
              </svg>
              <span id="copy-btn-text">Copy Citation</span>
            </button>
          </div>
          <pre id="bibtex-content" class="bg-gray-950/80 p-5 rounded-2xl border border-element-border text-gray-300 font-mono text-xs overflow-x-auto leading-relaxed select-all">{pub.data.bibtex}</pre>
        </div>
      )}
    </div>
    </Container>
  </Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="publications" 
    currentId={pub.id} 
    tags={pub.data.tags} 
  />
</Layout>

<script>
  // Copy Bibtex logic
  const copyBtn = document.getElementById('copy-bibtex-btn');
  const bibtexContent = document.getElementById('bibtex-content');
  const copyBtnText = document.getElementById('copy-btn-text');

  if (copyBtn && bibtexContent && copyBtnText) {
    copyBtn.addEventListener('click', () => {
      const text = bibtexContent.textContent?.trim() || '';
      navigator.clipboard.writeText(text).then(() => {
        // Visual feedback
        copyBtnText.textContent = 'Copied!';
        copyBtn.classList.remove('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
        copyBtn.classList.add('bg-brand-primary/20', 'text-brand-primary', 'border-brand-primary/30');
        
        // Reset after 2.5 seconds
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Citation';
          copyBtn.classList.remove('bg-brand-primary/20', 'text-brand-primary', 'border-brand-primary/30');
          copyBtn.classList.add('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy citation: ', err);
      });
    });
  }
</script>
