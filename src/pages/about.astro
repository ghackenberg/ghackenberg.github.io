---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import EducationTimeline from "@components/EducationTimeline.astro";
import Timeline from "@components/Timeline.astro";
import InterestCard from "@components/InterestCard.astro";
import { getCollection } from "astro:content";

const interests = (await getCollection("interests")).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const profiles = await getCollection("profiles");
const sortedProfiles = profiles.sort((a, b) => a.data.order - b.data.order);
const degrees = await getCollection("degrees");
const sortedDegrees = degrees.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About",
      "item": "https://hackenberg.tech/about/"
    }
  ]
};

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://hackenberg.tech/about/#profilepage",
  "url": "https://hackenberg.tech/about/",
  "name": "About Dr. Georg Hackenberg",
  "mainEntity": {
    "@type": "Person",
    "@id": "https://hackenberg.tech/#person",
    "name": "Dr. Georg Hackenberg",
    "jobTitle": "Professor for Industrial Informatics",
    "url": "https://hackenberg.tech",
    "sameAs": sortedProfiles.map((p) => p.data.url),
    "hasCredential": sortedDegrees.map((d) => ({
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "degree",
      "name": `${d.data.degree} in ${d.data.program}`,
      "recognizedBy": {
        "@type": "EducationalOrganization",
        "name": d.data.institution
      }
    }))
  }
};
---

<Layout
  title="About Dr. Georg Hackenberg - Professor, Software Architect & Researcher"
  description="Discover the academic background, software engineering leadership, and career timeline of Dr. Georg Hackenberg."
  jsonLd={[profilePageSchema, breadcrumbSchema]}
>
  <Navbar />

  <main class="w-full">
    <!-- Biography & Career Timeline Section -->
    <Section id="about" padding="standard">
      <Container size="wide" padding="none">
        <Breadcrumbs class="mb-6" />

        <!-- Standard Level-1 Page Header -->
        <div class="mb-12">
          <h1 id="about-heading" class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-4">
            About <span class="text-brand-primary">Me</span>
          </h1>
          <p id="about-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
            Professor for Industrial Informatics at the University of Applied Sciences Upper Austria (FH OÖ Campus Wels), software engineer, and researcher bridging industrial systems and agentic software.
          </p>
        </div>

        <!-- Career & Academic Timeline -->
        <div class="space-y-16">
          <!-- Subsection 1: Professional Interests -->
          <div>
            <div class="mb-8">
              <h2 id="professional-interests-heading" class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3">
                Professional <span class="text-domain-interests">Interests</span>
              </h2>
              <p id="professional-interests-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
                Key scientific domains, technical focus areas, and engineering pursuits that guide my academic research, university teaching, and software platform development.
              </p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {interests.map((interest) => (
                <InterestCard
                  id={interest.id}
                  title={interest.data.title}
                  description={interest.data.description}
                  heroImage={interest.data.heroImage}
                  tags={interest.data.tags}
                />
              ))}
            </div>
          </div>

          <div>
            <div class="mb-8">
              <h2 id="academic-degrees-heading" class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3">
                Academic <span class="text-brand-primary">Degrees</span>
              </h2>
              <p id="academic-degrees-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
                University education and academic degrees in computer science and software systems engineering across Mannheim, Aachen, and Munich.
              </p>
            </div>
            <EducationTimeline />
          </div>

          <div>
            <div class="mb-8">
              <h2 id="professional-experience-heading" class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3">
                Professional <span class="text-brand-primary">Experience</span>
              </h2>
              <p id="professional-experience-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
                Academic leadership, applied research positions, and software engineering roles across university and industry.
              </p>
            </div>
            <Timeline />
          </div>
        </div>
      </Container>
    </Section>
  </main>
</Layout>
