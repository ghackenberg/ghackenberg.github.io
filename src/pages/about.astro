---
import Layout from "@layouts/Layout.astro";
import { buildAboutPageSchemas } from "@commons/server/json-ld";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import EducationTimeline from "@components/EducationTimeline.astro";
import Timeline from "@components/Timeline.astro";
import { getImage } from "astro:assets";
import profileImage from "@assets/avatar/comic-profile-head.png";
import { getCollection } from "astro:content";

const degrees = await getCollection("degrees");
const experiences = await getCollection("experiences");
const profiles = await getCollection("profiles");

const optimizedProfile = await getImage({
  src: profileImage,
  format: "webp",
  width: 800,
  quality: 95,
});
const profileImageUrl = new URL(optimizedProfile.src, Astro.site || "https://hackenberg.tech").href;

const aboutSchemas = buildAboutPageSchemas({
  degrees,
  experiences,
  profiles,
  imageUrl: profileImageUrl,
});

---

<Layout
  title="About Dr. Georg Hackenberg - Professor, Software Architect & Researcher"
  description="Discover the academic background, software engineering leadership, and career timeline of Dr. Georg Hackenberg."
  jsonLd={aboutSchemas}
>
  <Navbar />

  <main class="w-full">
    <!-- Biography & Career Timeline Section -->
    <Section id="about" padding="standard">
      <Container size="wide" padding="none">
        <Breadcrumbs class="mb-6" />

        <!-- Standard Level-1 Page Header -->
        <div class="mb-12">
          <h1 id="about-heading" class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-4">
            About <span class="text-brand-primary">Me</span>
          </h1>
          <p id="about-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
            Professor for Industrial Informatics at the University of Applied Sciences Upper Austria (FH OÖ Campus Wels), software engineer, and researcher bridging industrial systems and agentic software.
          </p>
        </div>

        <!-- Career & Academic Timeline -->
        <div class="space-y-16">
          <div>
            <div class="mb-8">
              <h2 id="academic-degrees-heading" class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3">
                Academic <span class="text-brand-primary">Degrees</span>
              </h2>
              <p id="academic-degrees-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
                University education and academic degrees in computer science and software systems engineering across Mannheim, Aachen, and Munich.
              </p>
            </div>
            <EducationTimeline />
          </div>

          <div>
            <div class="mb-8">
              <h2 id="professional-experience-heading" class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-3">
                Professional <span class="text-brand-primary">Experiences</span>
              </h2>
              <p id="professional-experience-subheading" class="text-gray-400 text-base md:text-lg max-w-3xl font-normal leading-relaxed">
                Academic leadership, applied research positions, and software engineering roles across university and industry.
              </p>
            </div>
            <Timeline />
          </div>
        </div>
      </Container>
    </Section>
  </main>
</Layout>
