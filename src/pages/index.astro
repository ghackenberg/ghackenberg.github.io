              class="absolute bottom-1 sm:bottom-3 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-[#090d16]/85 light:bg-white/95 border border-brand-blue/40 light:border-blue-300 text-white light:text-slate-900 shadow-xl shadow-brand-blue/15 backdrop-blur-md hover:border-brand-blue hover:scale-105 hover:shadow-brand-blue/25 active:scale-95 transition-all duration-300 cursor-pointer text-xs sm:text-sm font-semibold group/btn"
