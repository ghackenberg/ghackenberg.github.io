<script>
  // Copy to Clipboard logic for contact button
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-text');
  const copyBtnText = document.getElementById('copy-btn-text');
  const copyIcon = document.getElementById('copy-icon');

  if (copyBtn && emailText && copyBtnText && copyIcon) {
    copyBtn.addEventListener('click', () => {
      const email = emailText.textContent?.trim() || 'georg.hackenberg@fh-wels.at';
      
      navigator.clipboard.writeText(email).then(() => {
        // Visual feedback
        copyBtnText.textContent = 'Copied!';
        copyBtn.classList.remove('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
        copyBtn.classList.add('bg-brand-green/20', 'text-brand-green', 'border-brand-green/30');
        
        // Reset after 2.5 seconds
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Email';
          copyBtn.classList.remove('bg-brand-green/20', 'text-brand-green', 'border-brand-green/30');
          copyBtn.classList.add('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy text: ', err);
      });
    });
  }

  // Scroll Fade-in animation for Media Activities cards
  const activityCards = document.querySelectorAll('.activity-card-anim');
  if (activityCards.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-8');
          entry.target.classList.add('opacity-100', 'translate-y-0');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    activityCards.forEach(card => observer.observe(card));
  } else {
    // Fallback if IntersectionObserver is not supported
    activityCards.forEach(card => {
      card.classList.remove('opacity-0', 'translate-y-8');
      card.classList.add('opacity-100', 'translate-y-0');
    });
  }
</script>

<!-- Expose Astro homeVisPayload to global scope -->
<script is:inline define:vars={{ homeVisPayload }}>
  window.HOME_VIS_PAYLOAD = homeVisPayload;
</script>

<!-- Initialize Vis.js Network for Home Page Posts Section -->
<script>
  interface GraphInstance {
    destroy(): void;
    updateLayout(layout: string, isLight: boolean): void;
    layouts: { id: string; label: string }[];
    pause?(): void;
    resume?(): void;
  }


  function onReady(fn: () => void) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fn);
    } else {
      fn();
    }
  }

  onReady(() => {
    const container = document.getElementById('home-vis-canvas');
    const loading = document.getElementById('home-vis-loading');
    if (!container) return;

    let activeInstance: GraphInstance | null = null;

    async function initHomeVis() {
      if (!container) return;

      try {
        const engineModule = await import('../content/visualizations/vis-network/engine.ts');
        const engine = engineModule.default;

        const payload = (window as typeof globalThis & { HOME_VIS_PAYLOAD?: Parameters<typeof engine.init>[1] }).HOME_VIS_PAYLOAD!;
        const defaultLayout = engine.layouts[0].id;
        const isLight = document.documentElement.classList.contains('light');

        // Initialize Vis.js Network with zoomView: false, dragView: false, dragNodes: false (pan/zoom disabled, vertical scroll preserved), hover enabled, and UTM tracking
        activeInstance = await engine.init(container, payload, defaultLayout, isLight, {
          interaction: {
            zoomView: false,
            dragView: false,
            dragNodes: false,
            hover: true
          },
          utmSource: 'homepage',
          utmMedium: 'knowledge_graph',
          utmCampaign: 'posts_network'
        });

        if (loading) {
          loading.style.opacity = '0';
          setTimeout(() => loading.remove(), 300);
        }
      } catch (e) {
        console.error('Failed to initialize home Vis.js network:', e);
      }
    }

    // Lazy-load Vis.js via IntersectionObserver and manage lifecycle when entering/leaving viewport
    let hasInitialized = false;
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (!hasInitialized) {
              hasInitialized = true;
              initHomeVis();
            } else if (activeInstance) {
              activeInstance.resume?.();
            }
          } else {
            if (activeInstance) {
              activeInstance.pause?.();
            }
          }
        });
      }, { rootMargin: '200px 0px' });
      observer.observe(container);
    } else {
      initHomeVis();
    }

    window.addEventListener('theme-changed', () => {
      const isLight = document.documentElement.classList.contains('light');
      if (activeInstance) {
        activeInstance.updateLayout(activeInstance.layouts[0].id, isLight);
      }
    });

    // Hero Avatar Chat Button Trigger
    const heroAvatarBtn = document.getElementById('hero-avatar-chat-btn');
    if (heroAvatarBtn) {
      heroAvatarBtn.addEventListener('click', () => {
        if (typeof window.isAvatarConsented === 'function' && window.isAvatarConsented()) {
          window.openAvatarDrawer?.();
        } else if (typeof window.openAvatarConsentModal === 'function') {
          window.openAvatarConsentModal('hero');
        } else {
          window.openAvatarDrawer?.();
        }
      });
    }
  });
</script>
