        <!-- Text Content -->
        <div class="lg:col-span-7 flex flex-col justify-center order-2 lg:order-1">

          
          <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-gray-100 mb-6 leading-tight">
            Hi, I am <br class="sm:hidden" />
            <span class="heading-gradient-brand">
              Dr. Georg Hackenberg
            </span>
          </h1>
          
          <p class="text-xl sm:text-2xl font-bold text-gray-300 mb-6 leading-normal tracking-wide">
            Professor for Industrial Informatics @ UAP / FH Upper Austria &bull; AI-Augmented Workflows &bull; Digital Content Creation
          </p>

          <p class="text-gray-400 text-base sm:text-lg leading-relaxed mb-6 font-normal">
            Welcome to my personal website! I explore and practice the frontier of <strong class="font-bold text-gray-200 light:text-slate-900">AI-augmented engineering</strong> and <strong class="font-bold text-gray-200 light:text-slate-900">cross-channel content creation</strong> across Web, LinkedIn, YouTube, and GitHub. As a computer science professor in <strong class="font-bold text-gray-200 light:text-slate-900">Wels 🏙️</strong> originally from <strong class="font-bold text-gray-200 light:text-slate-900">Hohenschwangau 🏰</strong> living in <strong class="font-bold text-gray-200 light:text-slate-900">Grünau 🌄</strong>, I bridge academic systems engineering at <strong class="font-bold text-gray-200 light:text-slate-900">UAP (FH Upper Austria)</strong> with autonomous agent workflows and modern digital production.
          </p>

          <!-- Entity Trust Pills (Modular Micro-Chips) -->
          <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 mb-6">
            <a 
              href="https://www.fh-ooe.at/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium glass-card border border-white/10 hover:border-brand-blue/40 text-gray-300 hover:text-gray-100 transition-all duration-200 shadow-sm group"
              title="University of Applied Sciences Upper Austria (rebranding to UAP)"
            >
              <span class="text-sm select-none">🏛️</span>
              <span><strong>UAP / FH Upper Austria</strong> <span class="text-gray-400 group-hover:text-gray-300 font-normal">(Technology Campus Wels)</span></span>
            </a>
            
            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium glass-card border border-white/10 text-gray-300 shadow-sm" title="Doctorate (Dr. rer. nat.) - Technical University of Munich">
              <span class="text-sm select-none">🎓</span>
              <span><strong>TU Munich</strong> <span class="text-gray-400 font-normal">(Dr. rer. nat.)</span></span>
            </div>

            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium glass-card border border-white/10 text-gray-300 shadow-sm" title="Master of Science in Software Systems Engineering - RWTH Aachen University">
              <span class="text-sm select-none">🎓</span>
              <span><strong>RWTH Aachen</strong> <span class="text-gray-400 font-normal">(M.Sc.)</span></span>
            </div>

            <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium glass-card border border-white/10 text-gray-300 shadow-sm" title="Bachelor of Science in Software- und Internettechnologie - University of Mannheim">
              <span class="text-sm select-none">🎓</span>
              <span><strong>Uni Mannheim</strong> <span class="text-gray-400 font-normal">(B.Sc.)</span></span>
            </div>

            <a 
              href="/publications/" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium glass-card border border-white/10 hover:border-indigo-400/40 text-gray-300 hover:text-gray-100 transition-all duration-200 shadow-sm group" 
              title="Peer-Reviewed Academic Publications & Proceedings"
            >
              <span class="text-sm select-none">📚</span>
              <span><strong>30+ Publications</strong> <span class="text-gray-400 group-hover:text-gray-300 font-normal">(Peer-Reviewed)</span></span>
            </a>

            <a 
              href="https://caddrive.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium glass-card border border-white/10 hover:border-brand-blue/40 text-gray-300 hover:text-gray-100 transition-all duration-200 shadow-sm group"
            >
              <span class="text-sm select-none">🚀</span>
              <span><strong>CADdrive</strong></span>
            </a>

            <a 
              href="https://mentawise.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium glass-card border border-white/10 hover:border-brand-purple/40 text-gray-300 hover:text-gray-100 transition-all duration-200 shadow-sm group"
            >
              <span class="text-sm select-none">🚀</span>
              <span><strong>Mentawise</strong></span>
            </a>
          </div>
          
          <div class="flex flex-wrap items-center gap-4">
            <a 
              href="#contact" 
              class="px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-extrabold shadow-lg shadow-blue-600/20 hover:shadow-blue-600/30 transition-all duration-300 hover:scale-105"
