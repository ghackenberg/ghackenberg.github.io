<script>
  // Copy to Clipboard logic for contact button
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-text');
  const copyBtnText = document.getElementById('copy-btn-text');
  const copyIcon = document.getElementById('copy-icon');

  if (copyBtn && emailText && copyBtnText && copyIcon) {
    copyBtn.addEventListener('click', () => {
      const email = emailText.textContent?.trim() || 'georg.hackenberg@fh-wels.at';
      
      navigator.clipboard.writeText(email).then(() => {
        // Visual feedback
        copyBtnText.textContent = 'Copied!';
        copyBtn.classList.remove('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
        copyBtn.classList.add('bg-brand-green/20', 'text-brand-green', 'border-brand-green/30');
        
        // Reset after 2.5 seconds
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Email';
          copyBtn.classList.remove('bg-brand-green/20', 'text-brand-green', 'border-brand-green/30');
          copyBtn.classList.add('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy text: ', err);
      });
    });
  }

  // Interactive Carousel Controller for All 9 Homepage Sections (< lg)
  function initCarousels() {
    const stages = document.querySelectorAll<HTMLElement>('.carousel-stage');
    stages.forEach(stage => {
      if (stage.dataset.carouselInit === 'true') return;
      stage.dataset.carouselInit = 'true';

      const carousel = stage.querySelector<HTMLElement>('.mobile-card-carousel');
      const prevBtn = stage.querySelector<HTMLButtonElement>('.carousel-prev');
      const nextBtn = stage.querySelector<HTMLButtonElement>('.carousel-next');

      if (!carousel) return;

      let activeAnimationId: number | null = null;
      let targetScrollLeft: number | null = null;
      let virtualScroll = carousel.scrollLeft;

      const stopAnimation = () => {
        if (activeAnimationId !== null) {
          cancelAnimationFrame(activeAnimationId);
          activeAnimationId = null;
        }
        carousel.style.scrollSnapType = '';
        carousel.style.scrollBehavior = '';
      };

      const applyVirtualScroll = (vs: number) => {
        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
        virtualScroll = vs;
        if (vs < 0) {
          carousel.scrollLeft = 0;
          const overshoot = -vs;
          carousel.style.transform = `translate3d(${overshoot}px, 0, 0)`;
        } else if (vs > maxScroll) {
          carousel.scrollLeft = maxScroll;
          const overshoot = -(vs - maxScroll);
          carousel.style.transform = `translate3d(${overshoot}px, 0, 0)`;
        } else {
          carousel.scrollLeft = vs;
          if (carousel.style.transform !== '') {
            carousel.style.transform = '';
          }
        }
      };

      const startBoundarySpring = (initVs: number, initV: number, wall: 'left' | 'right') => {
        if (activeAnimationId !== null) {
          cancelAnimationFrame(activeAnimationId);
          activeAnimationId = null;
        }

        carousel.style.scrollSnapType = 'none';
        carousel.style.scrollBehavior = 'auto';

        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
        const boundary = wall === 'left' ? 0 : maxScroll;

        let vs = initVs;
        let v = initV;
        let lastTime = performance.now();

        const k = 135;
        const c = 21;

        const frame = (now: number) => {
          const dt = Math.min((now - lastTime) / 1000, 0.05);
          lastTime = now;

          const isOverLeft = vs < 0;
          const isOverRight = vs > maxScroll;

          if (!isOverLeft && !isOverRight) {
            // In bounds, coasting toward the boundary wall
            v *= Math.pow(0.94, dt * 60);
            vs += v * dt;

            // If velocity died out before crossing boundary or reversed direction away from wall
            if ((wall === 'left' && (v >= 0 || Math.abs(v) < 5)) ||
                (wall === 'right' && (v <= 0 || Math.abs(v) < 5))) {
              if (Math.abs(vs - boundary) <= 2) {
                applyVirtualScroll(boundary);
                activeAnimationId = null;
                targetScrollLeft = null;
                carousel.style.transform = '';
                carousel.style.scrollSnapType = '';
                carousel.style.scrollBehavior = '';
                updateControls();
                return;
              } else {
                animateScrollTo(boundary);
                return;
              }
            }
          } else {
            // Out of bounds: Hookean spring-damper engaged
            let displacement = vs - boundary;

            // Clamp max displacement magnitude to 95px for physical integrity
            if (displacement < -95) {
              displacement = -95;
              vs = boundary - 95;
              if (v < 0) v = 0;
            } else if (displacement > 95) {
              displacement = 95;
              vs = boundary + 95;
              if (v > 0) v = 0;
            }

            const accel = -k * displacement - c * v;
            v += accel * dt;
            vs += v * dt;

            // Exit condition when spring settles
            if (Math.abs(displacement) < 0.5 && Math.abs(v) < 4) {
              applyVirtualScroll(boundary);
              activeAnimationId = null;
              targetScrollLeft = null;
              carousel.style.transform = '';
              carousel.style.scrollSnapType = '';
              carousel.style.scrollBehavior = '';
              updateControls();
              return;
            }
          }

          applyVirtualScroll(vs);
          activeAnimationId = requestAnimationFrame(frame);
        };

        activeAnimationId = requestAnimationFrame(frame);
      };

      const animateScrollTo = (targetPos: number) => {
        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
        const boundedTarget = Math.max(0, Math.min(maxScroll, targetPos));
        targetScrollLeft = boundedTarget;

        if (activeAnimationId !== null) {
          cancelAnimationFrame(activeAnimationId);
          activeAnimationId = null;
        }

        carousel.style.scrollSnapType = 'none';
        carousel.style.scrollBehavior = 'auto';

        let lastTime = performance.now();
        let currentPos = virtualScroll;

        const frame = (now: number) => {
          const dt = Math.min((now - lastTime) / 1000, 0.1);
          lastTime = now;

          // Exponential damping toward boundedTarget with 60fps equivalent factor (1 - 0.91^60dt)
          const factor = 1 - Math.pow(0.91, dt * 60);
          currentPos += (boundedTarget - currentPos) * factor;
          applyVirtualScroll(currentPos);

          if (Math.abs(boundedTarget - currentPos) > 0.5) {
            activeAnimationId = requestAnimationFrame(frame);
          } else {
            applyVirtualScroll(boundedTarget);
            activeAnimationId = null;
            targetScrollLeft = null;
            carousel.style.transform = '';
            carousel.style.scrollSnapType = '';
            carousel.style.scrollBehavior = '';
            updateControls();
          }
        };

        activeAnimationId = requestAnimationFrame(frame);
      };

      const getCardSnapPositions = (): number[] => {
        const items = Array.from(carousel.children).filter(
          (el) => (el as HTMLElement).offsetParent !== null
        ) as HTMLElement[];
        if (items.length === 0) return [0];
        const padLeft = parseFloat(window.getComputedStyle(carousel).paddingLeft) || 0;
        return items.map((item) => Math.max(0, item.offsetLeft - padLeft));
      };

      const updateControls = () => {
        const scrollLeft = carousel.scrollLeft;
        const maxScroll = carousel.scrollWidth - carousel.clientWidth;

        if (targetScrollLeft !== null && Math.abs(scrollLeft - targetScrollLeft) < 4) {
          targetScrollLeft = null;
        }

        if (scrollLeft <= 8) {
          stage.classList.add('at-start');
          if (prevBtn) {
            prevBtn.classList.add('opacity-0', 'pointer-events-none');
          }
        } else {
          stage.classList.remove('at-start');
          if (prevBtn) {
            prevBtn.classList.remove('opacity-0', 'pointer-events-none');
          }
        }

        if (scrollLeft >= maxScroll - 8) {
          stage.classList.add('at-end');
          if (nextBtn) {
            nextBtn.classList.add('opacity-0', 'pointer-events-none');
          }
        } else {
          stage.classList.remove('at-end');
          if (nextBtn) {
            nextBtn.classList.remove('opacity-0', 'pointer-events-none');
          }
        }
      };

      const scrollToNextCard = () => {
        const snapPositions = getCardSnapPositions();
        const baseScroll = targetScrollLeft !== null ? targetScrollLeft : carousel.scrollLeft;
        const nextPos = snapPositions.find((pos) => pos > baseScroll + 8);
        if (nextPos !== undefined) {
          animateScrollTo(nextPos);
        } else {
          animateScrollTo(carousel.scrollWidth - carousel.clientWidth);
        }
      };

      const scrollToPrevCard = () => {
        const snapPositions = getCardSnapPositions();
        const baseScroll = targetScrollLeft !== null ? targetScrollLeft : carousel.scrollLeft;
        const prevPos = [...snapPositions].reverse().find((pos) => pos < baseScroll - 8);
        if (prevPos !== undefined) {
          animateScrollTo(prevPos);
        } else {
          animateScrollTo(0);
        }
      };

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          scrollToPrevCard();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          scrollToNextCard();
        });
      }

      carousel.addEventListener('scroll', () => {
        if (carousel.style.transform === '') {
          virtualScroll = carousel.scrollLeft;
        }
        updateControls();
      }, { passive: true });

      window.addEventListener('resize', () => {
        if (carousel.style.transform === '') {
          virtualScroll = carousel.scrollLeft;
        }
        updateControls();
      }, { passive: true });

      // Initial state
      virtualScroll = carousel.scrollLeft;
      updateControls();

      // Prevent native HTML5 drag on child links and images
      carousel.addEventListener('dragstart', (e: DragEvent) => {
        e.preventDefault();
      });

      // Unified Pointer & Touch drag-to-swipe gesture (< 1024px) with Directional Axis-Locking
      type AxisLock = 'undecided' | 'horizontal' | 'vertical';
      let isDown = false;
      let axisLock: AxisLock = 'undecided';
      const AXIS_LOCK_THRESHOLD = 6;
      let dragPointerId: number | null = null;
      let hasDragged = false;
      let startX = 0;
      let startY = 0;
      let startVirtualScroll = 0;
      let currentDx = 0;
      let lastMoveX = 0;
      let lastMoveTime = 0;
      let velocityPxPerSec = 0;
      let suppressClickUntil = 0;

      carousel.addEventListener('click', (e: MouseEvent) => {
        if (performance.now() < suppressClickUntil || hasDragged) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, { capture: true });

      carousel.addEventListener('pointerdown', (e: PointerEvent) => {
        if ((e.pointerType === 'mouse' && e.button !== 0) || window.innerWidth >= 1024) return;
        stopAnimation();
        targetScrollLeft = null;
        if (carousel.style.transform === '') {
          virtualScroll = carousel.scrollLeft;
        }
        isDown = true;
        dragPointerId = e.pointerId;
        hasDragged = false;
        axisLock = e.pointerType === 'mouse' ? 'horizontal' : 'undecided';
        startX = e.clientX;
        startY = e.clientY;
        lastMoveX = e.clientX;
        lastMoveTime = performance.now();
        velocityPxPerSec = 0;
        startVirtualScroll = virtualScroll;
        currentDx = 0;
      });

      carousel.addEventListener('touchmove', (e: TouchEvent) => {
        if (isDown && axisLock === 'horizontal' && e.cancelable) {
          e.preventDefault();
        }
      }, { passive: false });

      const endDrag = () => {
        if (!isDown) return;
        const wasDragging = hasDragged;
        isDown = false;
        dragPointerId = null;
        axisLock = 'undecided';
        hasDragged = false;
        carousel.classList.remove('is-dragging');

        if (wasDragging) {
          suppressClickUntil = performance.now() + 250;
          const idleMs = performance.now() - lastMoveTime;
          const v0 = idleMs < 120 ? velocityPxPerSec : 0;
          const maxScroll = carousel.scrollWidth - carousel.clientWidth;

          // Natural physical stopping distance under friction (tau = 0.35s)
          const projectedScroll = virtualScroll + v0 * 0.35;

          const isLeftBoundary = projectedScroll < -15 || (virtualScroll < 0 && projectedScroll <= 0);
          const isRightBoundary = projectedScroll > maxScroll + 15 || (virtualScroll > maxScroll && projectedScroll >= maxScroll);

          if (isLeftBoundary) {
            startBoundarySpring(virtualScroll, v0, 'left');
            return;
          }
          if (isRightBoundary) {
            startBoundarySpring(virtualScroll, v0, 'right');
            return;
          }

          const snapPositions = getCardSnapPositions();
          let targetPos: number;
          if (snapPositions.length === 0) {
            targetPos = carousel.scrollLeft;
          } else {
            // Find mathematically closest snap position to projectedScroll
            targetPos = snapPositions.reduce((prev, curr) =>
              Math.abs(curr - projectedScroll) < Math.abs(prev - projectedScroll) ? curr : prev
            );

            // If user swiped with significant velocity (> 180px/s) or dragged (> 40px),
            // ensure it advances at least 1 card in the swipe direction if projectedScroll stayed on start card
            if (v0 > 180 || currentDx < -40) {
              const next = snapPositions.find((pos) => pos > startVirtualScroll + 8);
              if (next !== undefined && targetPos <= startVirtualScroll) {
                targetPos = next;
              }
            } else if (v0 < -180 || currentDx > 40) {
              const prev = [...snapPositions].reverse().find((pos) => pos < startVirtualScroll - 8);
              if (prev !== undefined && targetPos >= startVirtualScroll) {
                targetPos = prev;
              }
            }
          }

          animateScrollTo(targetPos);
        } else {
          if (carousel.style.transform !== '') {
            const maxScroll = carousel.scrollWidth - carousel.clientWidth;
            const wall = virtualScroll < maxScroll / 2 ? 'left' : 'right';
            startBoundarySpring(virtualScroll, 0, wall);
          } else {
            carousel.style.scrollSnapType = '';
            carousel.style.scrollBehavior = '';
          }
        }
      };

      const onPointerEnd = (e?: PointerEvent) => {
        if (e && dragPointerId !== null && e.pointerId !== dragPointerId) return;
        if (e) {
          try {
            if (carousel.hasPointerCapture(e.pointerId)) {
              carousel.releasePointerCapture(e.pointerId);
            }
          } catch {
            // Ignore capture release errors on detached/cancelled pointers
          }
        }
        endDrag();
      };

      window.addEventListener('pointerup', onPointerEnd);
      window.addEventListener('pointercancel', onPointerEnd);
      window.addEventListener('blur', () => onPointerEnd());

      window.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDown || (dragPointerId !== null && e.pointerId !== dragPointerId)) return;
        if (axisLock === 'vertical') return;

        // Fail-safe: if mouse primary button is no longer pressed, terminate drag immediately
        if (e.pointerType === 'mouse' && (e.buttons & 1) === 0) {
          endDrag();
          return;
        }

        const totalDx = Math.abs(e.clientX - startX);
        const totalDy = Math.abs(e.clientY - startY);

        if (axisLock === 'undecided') {
          if (totalDx < AXIS_LOCK_THRESHOLD && totalDy < AXIS_LOCK_THRESHOLD) {
            return;
          }
          if (totalDy > totalDx) {
            axisLock = 'vertical';
            isDown = false;
            dragPointerId = null;
            return;
          } else {
            axisLock = 'horizontal';
            hasDragged = true;
            carousel.classList.add('is-dragging');
            carousel.style.scrollSnapType = 'none';
            carousel.style.scrollBehavior = 'auto';
            try {
              carousel.setPointerCapture(e.pointerId);
            } catch {
              // Ignore capture errors if pointer is not active
            }
          }
        }

        if (axisLock === 'horizontal') {
          const now = performance.now();
          const dt = Math.max((now - lastMoveTime) / 1000, 0.001);
          const deltaX = e.clientX - lastMoveX;
          lastMoveX = e.clientX;
          lastMoveTime = now;

          // Instantaneous scroll velocity in px/sec: moving pointer left (deltaX < 0) scrolls right (v > 0)
          const instantV = -deltaX / dt;
          velocityPxPerSec = velocityPxPerSec === 0 ? instantV : (0.6 * instantV + 0.4 * velocityPxPerSec);

          currentDx = e.clientX - startX;
          if (!hasDragged && Math.abs(currentDx) > 5) {
            hasDragged = true;
            carousel.classList.add('is-dragging');
            carousel.style.scrollSnapType = 'none';
            carousel.style.scrollBehavior = 'auto';
          }

          if (hasDragged) {
            const maxScroll = carousel.scrollWidth - carousel.clientWidth;
            const rawVirtualScroll = startVirtualScroll - currentDx;

            if (rawVirtualScroll < 0) {
              const excess = -rawVirtualScroll;
              const damped = Math.min(110, Math.pow(excess, 0.8) * 1.8);
              virtualScroll = -damped;
            } else if (rawVirtualScroll > maxScroll) {
              const excess = rawVirtualScroll - maxScroll;
              const damped = Math.min(110, Math.pow(excess, 0.8) * 1.8);
              virtualScroll = maxScroll + damped;
            } else {
              virtualScroll = rawVirtualScroll;
            }

            applyVirtualScroll(virtualScroll);
          }
        }
      }, { passive: true });
    });
  }

  // Progressive Text Shortening ('Explore All' -> 'All' -> Arrow Only) for Section Header CTAs
  function updateSectionHeaderCtas(): void {
    const headers = document.querySelectorAll<HTMLElement>('.section-header');
    headers.forEach((header) => {
      const cta = header.querySelector<HTMLAnchorElement>('.section-header-cta');
      if (!cta) return;

      const row = cta.parentElement;
      if (!row) return;

      const h2 = row.querySelector<HTMLElement>('h2');
      if (!h2) return;

      const textFull = cta.querySelector<HTMLElement>('.cta-text-full');
      const textShort = cta.querySelector<HTMLElement>('.cta-text-short');
      if (!textFull || !textShort) return;

      const style = window.getComputedStyle(row);
      const gap = parseFloat(style.columnGap || style.gap || '12') || 12;
      const badge = row.querySelector<HTMLElement>('.dev-heading-badge');

      // Helper to test if h2 natural width + cta + badge exceeds available row width
      const isOverflowing = (): boolean => {
        const availableWidth = row.clientWidth;
        const h2NaturalWidth = h2.scrollWidth;
        const ctaWidth = cta.offsetWidth;
        const badgeWidth = badge ? gap + badge.offsetWidth : 0;
        const requiredWidth = h2NaturalWidth + gap + ctaWidth + badgeWidth;
        return requiredWidth > availableWidth + 2;
      };

      // 1. Level 1: Full text ("Explore All")
      textFull.classList.remove('hidden');
      textShort.classList.add('hidden');
      cta.classList.remove('px-2.5', 'sm:px-3', 'px-3', 'sm:px-3.5');
      cta.classList.add('px-4', 'sm:px-5');

      if (!isOverflowing()) {
        return;
      }

      // 2. Level 2: Short text ("All")
      textFull.classList.add('hidden');
      textShort.classList.remove('hidden');
      cta.classList.remove('px-4', 'sm:px-5', 'px-2.5', 'sm:px-3');
      cta.classList.add('px-3', 'sm:px-3.5');

      if (!isOverflowing()) {
        return;
      }

      // 3. Level 3: Icon-Only (Arrow SVG)
      textFull.classList.add('hidden');
      textShort.classList.add('hidden');
      cta.classList.remove('px-4', 'sm:px-5', 'px-3', 'sm:px-3.5');
      cta.classList.add('px-2.5', 'sm:px-3');
    });
  }

  declare global {
    interface Window {
      __syncHeroResponsiveLayout?: () => void;
      __initReactiveDotGrids?: () => void;
    }
  }

  function initSectionHeaderCtas(): void {
    updateSectionHeaderCtas();

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.__syncHeroResponsiveLayout?.();
      if (resizeTimer) cancelAnimationFrame(resizeTimer);
      resizeTimer = requestAnimationFrame(() => {
        updateSectionHeaderCtas();
        window.__syncHeroResponsiveLayout?.();
      });
    });

    const observer = new MutationObserver((mutations) => {
      let shouldUpdate = false;
      for (const m of mutations) {
        if (m.type === 'childList') {
          for (let i = 0; i < m.addedNodes.length; i++) {
            const node = m.addedNodes[i];
            if (node instanceof HTMLElement && (node.classList.contains('dev-heading-badge') || node.querySelector('.dev-heading-badge'))) {
              shouldUpdate = true;
              break;
            }
          }
          if (shouldUpdate) break;
          for (let i = 0; i < m.removedNodes.length; i++) {
            const node = m.removedNodes[i];
            if (node instanceof HTMLElement && (node.classList.contains('dev-heading-badge') || node.querySelector('.dev-heading-badge'))) {
              shouldUpdate = true;
              break;
            }
          }
        }
        if (shouldUpdate) break;
      }
      if (shouldUpdate) {
        requestAnimationFrame(updateSectionHeaderCtas);
      }
    });

    document.querySelectorAll('.section-header').forEach((header) => {
      observer.observe(header, { childList: true, subtree: true });
    });
  }

  // ==========================================================================
  // 2D Elliptical Bin-Packing Tag Cloud Engine
  // ==========================================================================
  function initTagCloudEngines(): void {
    const binStage = document.getElementById('bin-packing-stage');
    const binRowsContainer = document.getElementById('bin-packing-rows');
    const binPool = document.getElementById('bin-packing-pool');

    if (!binStage || !binRowsContainer || !binPool || binStage.dataset.engineInit === 'true') {
      return;
    }
    binStage.dataset.engineInit = 'true';

    const allTagNodes = Array.from(
      binStage.querySelectorAll<HTMLElement>('.bin-tag-node')
    ).sort((a, b) => (parseInt(a.dataset.rank || '0', 10) - parseInt(b.dataset.rank || '0', 10)));

    const overflowNode = document.getElementById('bin-overflow-node');
    const overflowLabel = document.getElementById('bin-overflow-label');
    const overflowCount = document.getElementById('bin-overflow-count');
    const overflowTooltipTitle = document.getElementById('bin-overflow-tooltip-title');
    const overflowTooltipCount = document.getElementById('bin-overflow-tooltip-count');

    const baseRestTags = parseInt(binStage.dataset.baseRestTags || '0', 10) || 0;
    const baseRestItems = parseInt(binStage.dataset.baseRestItems || '0', 10) || 0;

    let lastPackedWidth = 0;
    const runEllipticalBinPacking = () => {
      const containerW = binStage.clientWidth;
      if (containerW <= 0 || Math.abs(containerW - lastPackedWidth) < 2) return;
      lastPackedWidth = containerW;

      const isMobile = containerW < 460;
      const gapPx = isMobile ? 6 : 10;
      const effectiveW = Math.min(containerW, 920);

      // 1. Temporarily place all nodes in a single flat flex container to measure exact pixel widths
      binRowsContainer.innerHTML = '';
      binRowsContainer.className = 'flex flex-wrap items-center justify-center gap-1.5 sm:gap-2.5 w-full';
      allTagNodes.forEach((node) => binRowsContainer.appendChild(node));
      if (overflowNode) binRowsContainer.appendChild(overflowNode);

      const measured = allTagNodes.map((node, idx) => ({
        node,
        rank: idx,
        width: Math.ceil(node.getBoundingClientRect().width) || 95,
        total: parseInt(node.dataset.total || '0', 10) || 0,
        placed: false,
      }));

      const overflowW = overflowNode ? (Math.ceil(overflowNode.getBoundingClientRect().width) || 120) : 0;

      // 2. Determine target elliptical row count R based on container width
      const numRows = containerW < 380 ? 5 : containerW < 680 ? 6 : 5;
      const midRow = (numRows - 1) / 2;
      const minEnvelopeRatio = containerW < 420 ? 0.78 : 0.58;

      interface EllipticalRow {
        index: number;
        u: number;
        capacity: number;
        usedWidth: number;
        items: typeof measured;
        hasOverflowBadge: boolean;
      }

      const rows: EllipticalRow[] = [];
      for (let r = 0; r < numRows; r++) {
        const u = midRow > 0 ? (r - midRow) / midRow : 0; // [-1, +1]
        const ellipseFactor = minEnvelopeRatio + (1 - minEnvelopeRatio) * Math.sqrt(Math.max(0, 1 - 0.86 * u * u));
        rows.push({
          index: r,
          u,
          capacity: Math.floor(effectiveW * ellipseFactor),
          usedWidth: 0,
          items: [],
          hasOverflowBadge: false,
        });
      }

      // Reserve space in the bottom row (numRows - 1) for the +X remaining overflow pill
      if (overflowNode) {
        const lastRow = rows[numRows - 1];
        lastRow.hasOverflowBadge = true;
        lastRow.usedWidth = overflowW;
      }

      // Order rows from the center row outward: e.g. [2, 1, 3, 0, 4]
      const centerOutwardRows = rows.slice().sort((a, b) => Math.abs(a.u) - Math.abs(b.u) || a.index - b.index);

      const canFitInRow = (row: EllipticalRow, itemW: number): boolean => {
        const needed = (row.items.length > 0 || row.hasOverflowBadge ? gapPx : 0) + itemW;
        // Allow a single wide tag in a central row even if the tag itself is very wide on 320px screens
        if (row.items.length === 0 && !row.hasOverflowBadge && itemW <= containerW) return true;
        return row.usedWidth + needed <= row.capacity;
      };

      const addItemToRow = (row: EllipticalRow, item: (typeof measured)[number]) => {
        const needed = (row.items.length > 0 || row.hasOverflowBadge ? gapPx : 0) + item.width;
        row.items.push(item);
        row.usedWidth += needed;
        item.placed = true;
      };

      // 3. Phase 1: Place top-frequency tags (rank 0..6) into the central rows first so the largest pills anchor the center
      const centralRows = centerOutwardRows.filter((r) => Math.abs(r.u) <= 0.72);
      const coreItems = measured.filter((m) => m.rank < 7);

      coreItems.forEach((core, cIdx) => {
        if (cIdx === 0) {
          // Place #1 tag directly in the dead-center row
          addItemToRow(centerOutwardRows[0], core);
          return;
        }
        // Find the central row with the most remaining capacity where core fits
        const candidateRows = centralRows
          .filter((r) => canFitInRow(r, core.width))
          .sort((a, b) => (a.items.length - b.items.length) || ((b.capacity - b.usedWidth) - (a.capacity - a.usedWidth)));

        if (candidateRows.length > 0) {
          addItemToRow(candidateRows[0], core);
        } else {
          // Fallback to any row from center outward that fits
          const anyRow = centerOutwardRows.find((r) => canFitInRow(r, core.width));
          if (anyRow) addItemToRow(anyRow, core);
        }
      });

      // 4. Phase 2: Best-Fit Subset-Sum Gap Filling across all rows from center outward
      // Pair long tags with shorter tags so rows reach their elliptical target envelope without 1-pill gaps
      centerOutwardRows.forEach((row) => {
        let keepFilling = true;
        while (keepFilling) {
          const unplaced = measured.filter((m) => !m.placed && canFitInRow(row, m.width));
          if (unplaced.length === 0) {
            keepFilling = false;
            break;
          }
          const remainingCap = row.capacity - row.usedWidth - (row.items.length > 0 || row.hasOverflowBadge ? gapPx : 0);
          // Score candidates: balance frequency rank priority with how snugly they fill remainingCap
          let bestCandidate = unplaced[0];
          let bestScore = -Infinity;
          for (const cand of unplaced) {
            const fillRatio = remainingCap > 0 ? Math.min(1, cand.width / remainingCap) : 0.5;
            const rankScore = 1 - cand.rank / measured.length;
            // If row currently has only 1 pill, strongly reward picking a complementary pill to avoid 1-pill rows
            const score = row.items.length === 1 ? (fillRatio * 0.65 + rankScore * 0.35) : (rankScore * 0.65 + fillRatio * 0.35);
            if (score > bestScore) {
              bestScore = score;
              bestCandidate = cand;
            }
          }
          addItemToRow(row, bestCandidate);
        }
      });

      // 5. Phase 3: Arrange items inside each row in a center-heavy pendulum (largest in row center)
      binRowsContainer.innerHTML = '';
      binRowsContainer.className = 'flex flex-col items-center justify-center gap-1.5 sm:gap-2.5 w-full';
      binPool.innerHTML = '';

      rows.forEach((row) => {
        if (row.items.length === 0 && !row.hasOverflowBadge) return;
        const rowEl = document.createElement('div');
        rowEl.className = 'bin-cloud-row flex flex-nowrap items-center justify-center gap-1.5 sm:gap-2.5 w-full';

        // Sort row items by rank ascending (most important first) then pendulum-interleave so peak is in row center
        const sortedRowItems = row.items.slice().sort((a, b) => a.rank - b.rank);
        const orderedRowItems: typeof sortedRowItems = [];
        sortedRowItems.forEach((item, idx) => {
          if (idx === 0) orderedRowItems.push(item);
          else if (idx % 2 === 1) orderedRowItems.unshift(item);
          else orderedRowItems.push(item);
        });

        orderedRowItems.forEach((item) => rowEl.appendChild(item.node));
        if (row.hasOverflowBadge && overflowNode) {
          rowEl.appendChild(overflowNode);
        }
        binRowsContainer.appendChild(rowEl);
      });

      // Move any unplaced tags to hidden pool & dynamically update the +X remaining badge and tooltip
      const unplacedItems = measured.filter((m) => !m.placed);
      let extraOverflowItemsSum = 0;
      unplacedItems.forEach((item) => {
        extraOverflowItemsSum += item.total;
        binPool.appendChild(item.node);
      });

      const dynamicRestTags = baseRestTags + unplacedItems.length;
      const dynamicRestItems = baseRestItems + extraOverflowItemsSum;

      if (overflowLabel) overflowLabel.textContent = `+${dynamicRestTags} remaining`;
      if (overflowCount) overflowCount.textContent = `${dynamicRestItems}`;
      if (overflowTooltipTitle) overflowTooltipTitle.textContent = `+${dynamicRestTags} Remaining Tags`;
      if (overflowTooltipCount) {
        overflowTooltipCount.textContent = `${dynamicRestItems} ${dynamicRestItems === 1 ? 'item' : 'items'}`;
      }
    };

    runEllipticalBinPacking();
    const binResizeObserver = new ResizeObserver(() => {
      requestAnimationFrame(runEllipticalBinPacking);
    });
    binResizeObserver.observe(binStage);
    document.fonts?.ready?.then(() => {
      lastPackedWidth = 0;
      runEllipticalBinPacking();
    });
  }

  function setupPageScripts() {
    initCarousels();
    initSectionHeaderCtas();
    initTagCloudEngines();
    window.__syncHeroResponsiveLayout?.();
    document.fonts?.ready?.then(() => {
      window.__syncHeroResponsiveLayout?.();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPageScripts);
  } else {
    setupPageScripts();
  }
  document.addEventListener('astro:page-load', setupPageScripts);
</script>
