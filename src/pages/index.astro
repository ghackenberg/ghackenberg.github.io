  <!-- Hero Responsive Layout & Zero-Flicker First-Paint Init -->
  <script is:inline>
    (function () {
      let isFontsReady = false;
      let isPortraitReady = false;
      let isPortraitRevealed = false;

      let lastActionsWidth = -1;
      let lastActionsFontsReady = false;
      let lastPaddingTop = -1;
      let lastLeft = -1;
      let lastTop = -1;
      let lastSize = -1;
      let lastGridWidth = -1;
      let lastContourJson = '';

      function syncHeroResponsiveLayout() {
        // 1. Adaptive #hero-contact-btn (Get in Touch -> Contact -> Icon Only)
        const actionsRow = document.getElementById('hero-actions-row');
        const contactBtn = document.getElementById('hero-contact-btn');
        const socialGroup = document.getElementById('hero-social-group');

        if (actionsRow && contactBtn && socialGroup) {
          const textFull = contactBtn.querySelector('.hero-cta-full');
          const textShort = contactBtn.querySelector('.hero-cta-short');
          const icon = contactBtn.querySelector('.hero-cta-icon');

          if (textFull && textShort && icon) {
            const availableWidth = actionsRow.clientWidth;
            if (availableWidth !== lastActionsWidth || isFontsReady !== lastActionsFontsReady) {
              lastActionsWidth = availableWidth;
              lastActionsFontsReady = isFontsReady;

              const style = window.getComputedStyle(actionsRow);
              const gap = parseFloat(style.columnGap || style.gap || '12') || 12;
              const socialWidth = socialGroup.offsetWidth;

              const fits = function () {
                return contactBtn.offsetWidth + gap + socialWidth <= availableWidth + 1;
              };

              // Level 1: Full text ("Get in Touch")
              textFull.classList.remove('hidden');
              textShort.classList.add('hidden');
              icon.classList.add('hidden');
              contactBtn.classList.remove('w-12', 'px-0', 'px-4');
              contactBtn.classList.add('px-6');

              if (!fits()) {
                // Level 2: Short text ("Contact")
                textFull.classList.add('hidden');
                textShort.classList.remove('hidden');
                icon.classList.add('hidden');
                contactBtn.classList.remove('w-12', 'px-0', 'px-6');
                contactBtn.classList.add('px-4');

                if (!fits()) {
                  // Level 3: Envelope Icon Only
                  textFull.classList.add('hidden');
                  textShort.classList.add('hidden');
                  icon.classList.remove('hidden');
                  contactBtn.classList.remove('px-6', 'px-4');
                  contactBtn.classList.add('w-12', 'px-0');
                }
              }
            }
          }
        }

        // 2. Exact 2D Collision-Free Portrait Size & Position Solver (Single-Pass Offset-Normalized)
        const heroGrid = document.getElementById('hero-grid');
        const h1 = document.getElementById('hero-heading');
        const portraitCell = document.getElementById('hero-portrait-cell');
        const portraitWrapper = document.getElementById('hero-portrait-wrapper');

        if (heroGrid && portraitWrapper && portraitCell && h1) {
          const gridRect = heroGrid.getBoundingClientRect();
          const h1Rect = h1.getBoundingClientRect();
          const contentOriginY = h1Rect.top;
          const rawRects = [];

          function collectLineRects(el) {
            if (!el) return;
            const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
            let node;
            while ((node = walker.nextNode())) {
              if (!node.textContent || !node.textContent.trim()) continue;
              const r = document.createRange();
              r.selectNodeContents(node);
              const clientRects = r.getClientRects();
              for (let i = 0; i < clientRects.length; i++) {
                const cr = clientRects[i];
                if (cr.width < 2 || cr.height < 2) continue;
                rawRects.push({
                  top: cr.top - contentOriginY,
                  bottom: cr.bottom - contentOriginY,
                  right: cr.right - gridRect.left
                });
              }
            }
          }

          collectLineRects(h1);

          const subtitleEl = document.getElementById('hero-subtitle');
          if (subtitleEl) collectLineRects(subtitleEl);

          const bioEl = document.getElementById('hero-bio');
          if (bioEl) collectLineRects(bioEl);

          const pillsEl = document.getElementById('hero-trust-pills');
          if (pillsEl) {
            for (let i = 0; i < pillsEl.children.length; i++) {
              const child = pillsEl.children[i];
              if (child instanceof HTMLElement) {
                const cr = child.getBoundingClientRect();
                if (cr.width > 2 && cr.height > 2) {
                  rawRects.push({
                    top: cr.top - contentOriginY,
                    bottom: cr.bottom - contentOriginY,
                    right: cr.right - gridRect.left
                  });
                }
              }
            }
          }

          if (actionsRow) {
            if (contactBtn) {
              const cr = contactBtn.getBoundingClientRect();
              if (cr.width > 2 && cr.height > 2) {
                rawRects.push({
                  top: cr.top - contentOriginY,
                  bottom: cr.bottom - contentOriginY,
                  right: cr.right - gridRect.left
                });
              }
            }
            if (socialGroup) {
              for (let i = 0; i < socialGroup.children.length; i++) {
                const child = socialGroup.children[i];
                if (child instanceof HTMLElement) {
                  const cr = child.getBoundingClientRect();
                  if (cr.width > 2 && cr.height > 2) {
                    rawRects.push({
                      top: cr.top - contentOriginY,
                      bottom: cr.bottom - contentOriginY,
                      right: cr.right - gridRect.left
                    });
                  }
                }
              }
            }
          }

          rawRects.sort(function (a, b) { return a.top - b.top; });

          const bands = [];
          for (let i = 0; i < rawRects.length; i++) {
            const r = rawRects[i];
            if (bands.length === 0) {
              bands.push({ top: r.top, bottom: r.bottom, right: r.right });
              continue;
            }
            const last = bands[bands.length - 1];
            const verticalOverlap = Math.min(last.bottom, r.bottom) - Math.max(last.top, r.top);
            const minHeight = Math.min(last.bottom - last.top, r.bottom - r.top);
            const isSameLine = Math.abs(last.top - r.top) < 10 || verticalOverlap > minHeight * 0.35;

            if (isSameLine) {
              last.top = Math.min(last.top, r.top);
              last.bottom = Math.max(last.bottom, r.bottom);
              last.right = Math.max(last.right, r.right);
            } else {
              bands.push({ top: r.top, bottom: r.bottom, right: r.right });
            }
          }

          // Exact 2D Collision-Free Solver
          const PORTRAIT_GAP_X = 18;
          const PORTRAIT_GAP_Y = 6;
          const MIN_PORTRAIT_SIZE = 150; // Fixed 150px (the 2-line H1 height before the <768px breakpoint)
          const TOP_BAND_GAP = 24;       // mb-6 spacing when portrait is completely above H1

          const gridWidth = Math.floor(gridRect.width);
          const contentHeight = bands.length > 0 ? Math.ceil(bands[bands.length - 1].bottom) : Math.floor(gridRect.height);
          const h1Height = Math.round(h1Rect.height);
          const targetTopSize = Math.max(MIN_PORTRAIT_SIZE, h1Height);

          function maxRightInVerticalRange(yTop, yBottom) {
            let maxR = 0;
            for (let i = 0; i < bands.length; i++) {
              const b = bands[i];
              if (b.bottom > yTop - PORTRAIT_GAP_Y && b.top < yBottom + PORTRAIT_GAP_Y) {
                if (b.right > maxR) {
                  maxR = b.right;
                }
              }
            }
            return maxR;
          }

          const isSmallH1 = window.innerWidth < 768;

          let topExtension = 0;
          let chosenSize = 0;
          let leftPos = 0;
          let topPos = 0;

          if (!isSmallH1) {
            // Candidate 1: 'rechts mittig' (Right-Center)
            let sizeRightCenter = 0;
            let reqLeftRightCenter = 0;
            const maxPossibleRightCenter = Math.min(480, contentHeight);
            for (let S = maxPossibleRightCenter; S >= 1; S--) {
              const yTop = (contentHeight - S) * 0.5;
              const yBottom = (contentHeight + S) * 0.5;
              const reqLeft = maxRightInVerticalRange(yTop, yBottom) + PORTRAIT_GAP_X;
              if (reqLeft + S <= gridWidth) {
                sizeRightCenter = S;
                reqLeftRightCenter = reqLeft;
                break;
              }
            }

            // Candidate 2: 'oben rechts neben H1' (Top-Beside-H1)
            const reqLeftBesideH1 = maxRightInVerticalRange(0, h1Height) + PORTRAIT_GAP_X;
            const availableWidthBesideH1 = gridWidth - reqLeftBesideH1;
            const sizeTopRight = (availableWidthBesideH1 >= targetTopSize && h1Height > 0) ? targetTopSize : 0;

            if (sizeRightCenter >= targetTopSize && (sizeRightCenter + 4 >= sizeTopRight) && h1Height > 0) {
              // Mode 1: Right-Center
              topExtension = 0;
              chosenSize = sizeRightCenter;
              leftPos = Math.round(reqLeftRightCenter + (gridWidth - reqLeftRightCenter - sizeRightCenter) * 0.5);
              topPos = Math.round((contentHeight - sizeRightCenter) * 0.5);
            } else if (sizeTopRight >= targetTopSize && h1Height > 0) {
              // Mode 2: Top-Right Beside H1
              topExtension = 0;
              chosenSize = sizeTopRight;
              leftPos = Math.round(reqLeftBesideH1 + (availableWidthBesideH1 - sizeTopRight) * 0.5);
              topPos = 0;
            } else if (gridWidth > 0) {
              // Mode 3: Top-Center Above H1
              chosenSize = Math.min(MIN_PORTRAIT_SIZE, gridWidth);
              topExtension = chosenSize + TOP_BAND_GAP;
              leftPos = Math.round((gridWidth - chosenSize) * 0.5);
              topPos = 0;
            }
          } else if (gridWidth > 0) {
            // Mode 3: Top-Center Above H1 (whenever H1 switches to smaller font < 768px)
            chosenSize = Math.min(MIN_PORTRAIT_SIZE, gridWidth);
            topExtension = chosenSize + TOP_BAND_GAP;
            leftPos = Math.round((gridWidth - chosenSize) * 0.5);
            topPos = 0;
          }

          // Dirty-checked DOM style writes (zero layout thrashing on scroll/resize)
          if (topExtension !== lastPaddingTop) {
            lastPaddingTop = topExtension;
            heroGrid.style.paddingTop = topExtension > 0 ? (topExtension + 'px') : '0px';
          }

          if (chosenSize <= 0) {
            if (lastSize !== 0) {
              lastSize = 0;
              lastLeft = -1;
              lastTop = -1;
              portraitCell.style.display = 'none';
              portraitCell.style.visibility = 'hidden';
              portraitCell.style.left = '';
              portraitCell.style.right = '';
              portraitCell.style.top = '';
              portraitCell.style.bottom = '';
              portraitCell.style.width = '';
              portraitCell.style.height = '';
              portraitWrapper.style.width = '';
              portraitWrapper.style.height = '';
            }
          } else {
            if (leftPos !== lastLeft || topPos !== lastTop || chosenSize !== lastSize) {
              lastLeft = leftPos;
              lastTop = topPos;
              lastSize = chosenSize;

              portraitCell.style.display = '';
              portraitCell.style.left = leftPos + 'px';
              portraitCell.style.top = topPos + 'px';
              portraitCell.style.right = 'auto';
              portraitCell.style.bottom = 'auto';
              portraitCell.style.width = chosenSize + 'px';
              portraitCell.style.height = chosenSize + 'px';

              portraitWrapper.style.width = chosenSize + 'px';
              portraitWrapper.style.height = chosenSize + 'px';
            }

            if (portraitCell.style.visibility !== 'visible') {
              portraitCell.style.visibility = 'visible';
              portraitCell.style.opacity = '1';
              portraitCell.classList.remove('opacity-0');
            }
          }

          // Update ReactiveDotGrid content contour (shifted by topExtension)
          const dotGridLayer = document.getElementById('hero-dot-grid-layer');
          const dotGridEl = dotGridLayer ? dotGridLayer.querySelector('.reactive-dot-grid') : null;

          if (dotGridLayer && dotGridEl) {
            if (dotGridLayer.style.display === 'none') {
              dotGridLayer.style.display = '';
            }
            const contourData = bands.map(function (b) {
              return [Math.round(b.top + topExtension), Math.round(b.bottom + topExtension), Math.ceil(b.right)];
            });
            const contourJson = JSON.stringify(contourData);
            if (typeof window.__initReactiveDotGrids === 'function') {
              window.__initReactiveDotGrids();
            }
            if (contourJson !== lastContourJson || gridWidth !== lastGridWidth) {
              lastContourJson = contourJson;
              lastGridWidth = gridWidth;
              dotGridEl.dataset.contour = contourJson;
              dotGridEl.dispatchEvent(new CustomEvent('dotgrid:layout'));
            }
          }
        }
      }

      function checkAndRevealPortrait() {
        if (isPortraitRevealed) return;
        isPortraitRevealed = true;
        const portraitCell = document.getElementById('hero-portrait-cell');
        if (portraitCell && portraitCell.style.display !== 'none') {
          portraitCell.style.visibility = 'visible';
          portraitCell.style.opacity = '1';
          portraitCell.classList.remove('opacity-0');
        }
      }

      function onFontsReady() {
        if (isFontsReady) return;
        isFontsReady = true;
        syncHeroResponsiveLayout();
        const dotGridLayer = document.getElementById('hero-dot-grid-layer');
        const dotGridEl = dotGridLayer ? dotGridLayer.querySelector('.reactive-dot-grid') : null;
        if (dotGridEl) {
          dotGridEl.dispatchEvent(new CustomEvent('dotgrid:intro'));
        }
        checkAndRevealPortrait();
      }

      function onPortraitReady() {
        if (isPortraitReady) return;
        isPortraitReady = true;
        checkAndRevealPortrait();
      }

      window.addEventListener('portrait:ready', onPortraitReady, { passive: true });

      // Check if portrait container was already marked ready
      const heroCell = document.getElementById('hero-portrait-cell');
      const portraitContainer = heroCell ? heroCell.querySelector('.depth-portrait-container') : null;
      if (portraitContainer && portraitContainer.getAttribute('data-ready') === 'true') {
        onPortraitReady();
      }

      // Execute initial layout pass synchronously before First Paint
      syncHeroResponsiveLayout();

      // Check font readiness
      const isOutfitLoaded = document.fonts && typeof document.fonts.check === 'function' &&
        document.fonts.check('800 60px Outfit') &&
        document.fonts.check('700 24px Outfit') &&
        document.fonts.check('400 18px Outfit');
      if (isOutfitLoaded) {
        onFontsReady();
      } else if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(onFontsReady);
        setTimeout(onFontsReady, 180);
      } else {
        onFontsReady();
      }

      // Fallback safety timeout for portrait in case of network issue
      setTimeout(function () {
        if (!isPortraitReady) {
          onPortraitReady();
        }
      }, 1500);

      window.__syncHeroResponsiveLayout = function () {
        syncHeroResponsiveLayout();
      };
    })();
  </script>

