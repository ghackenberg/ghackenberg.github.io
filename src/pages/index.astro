<style>
  #hero-portrait-cell {
    position: absolute;
    right: 0;
    z-index: 10;
    pointer-events: auto;
    display: flex;
  }
  #hero-portrait-wrapper {
    aspect-ratio: 1 / 1;
  }
  @media (max-width: 767.98px) {
    #hero-grid {
      padding-top: 174px;
    }
  }

  /* Mobile Horizontal Card Carousel */
  .mobile-card-carousel {
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-card-carousel::-webkit-scrollbar {
    display: none;
  }

  /* Equal height for all carousel items and cards */
  .mobile-card-carousel > * {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    height: auto;
  }
  .mobile-card-carousel > div > :global(.preview-card) {
    flex: 1 1 auto;
    height: 100%;
  }

  :global(.preview-card) > :global(.aspect-video) {
    flex: 0 0 auto !important;
  }

  @media (min-width: 1024px) {
    .mobile-card-carousel > .carousel-extra-item {
      display: none !important;
    }
  }

  .mobile-card-carousel a,
  .mobile-card-carousel img {
    -webkit-user-drag: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Section Header Rhythm */
  .section-header {
    margin-bottom: clamp(2rem, 3.5vw, 2.5rem);
  }

  @media (max-width: 1023.98px) {
    .carousel-stage {
      overflow-x: clip;
      margin-top: -1.25rem;
      margin-bottom: -2.5rem;
      margin-inline: calc(-1 * clamp(1rem, 3vw, 2rem));
    }
    .mobile-card-carousel {
      padding-top: 1.25rem;
      padding-bottom: 2.5rem;
      padding-inline: clamp(1rem, 3vw, 2rem);
      scroll-padding-left: clamp(1rem, 3vw, 2rem);
      cursor: grab;
      touch-action: pan-y pinch-zoom;
      will-change: transform, scroll-position;
    }
    .mobile-card-carousel * {
      touch-action: pan-y pinch-zoom;
    }
    .mobile-card-carousel.is-dragging {
      cursor: grabbing !important;
      user-select: none !important;
      -webkit-user-select: none !important;
      scroll-snap-type: none !important;
      scroll-behavior: auto !important;
    }
    .mobile-card-carousel.is-dragging * {
      cursor: grabbing !important;
      user-select: none !important;
      -webkit-user-select: none !important;
    }

    /* Left and right edge fade overlays in swipe mode */
    .carousel-stage::before,
    .carousel-stage::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      width: clamp(20px, 4vw, 48px);
      z-index: 20;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
