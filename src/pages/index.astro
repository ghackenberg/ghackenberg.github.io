---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import ProjectCard from "@components/ProjectCard.astro";
import PostCard from "@components/PostCard.astro";
import Timeline from "@components/Timeline.astro";
import GitHubWidget from "@components/GitHubWidget.astro";
import LinkedInWidget from "@components/LinkedInWidget.astro";
import YouTubeWidget from "@components/YouTubeWidget.astro";
import ImageGalleryMarquee, { type GalleryItem } from "@components/ImageGalleryMarquee.astro";
import DepthPortrait from "@components/DepthPortrait.astro";
import { getImage } from "astro:assets";
import profileImage from "@assets/avatar/comic-profile-head.png";
import profileDepthImage from "@assets/avatar/comic-profile-head-depth.png";
import profileWinkImage from "@assets/avatar/comic-profile-head-wink.png";
import profileWinkDepthImage from "@assets/avatar/comic-profile-head-wink-depth.png";
import profileBlinkImage from "@assets/avatar/comic-profile-head-blink.png";
import profileBlinkDepthImage from "@assets/avatar/comic-profile-head-blink-depth.png";
import profileClosedMouthImage from "@assets/avatar/comic-profile-head-closed-mouth.png";
import profileClosedMouthDepthImage from "@assets/avatar/comic-profile-head-closed-mouth-depth.png";
import profileClosedMouthBlinkImage from "@assets/avatar/comic-profile-head-closed-mouth-blink.png";
import profileClosedMouthBlinkDepthImage from "@assets/avatar/comic-profile-head-closed-mouth-blink-depth.png";
import astroLogo from "@assets/technologies/astro.svg";
import tailwindLogo from "@assets/technologies/tailwind.svg";
import antigravityLogo from "@assets/technologies/antigravity.svg";
import interestSoftwareImg from "@content/interests/software-engineering/preview.jpg";
import interestSimulationImg from "@content/interests/computer-simulation/preview.jpg";
import interestAiImg from "@content/interests/artificial-intelligence/preview.jpg";
import interestUxImg from "@content/interests/user-experience/preview.jpg";
import { getCollection } from "astro:content";
import { calculateTagCounts, buildGraphPayload } from "@commons/shared/graph-payload.js";

const optimizedProfile = await getImage({
  src: profileImage,
  format: "webp",
  width: 800,
  quality: 95
});

const optimizedDepth = await getImage({
  src: profileDepthImage,
  format: "png",
  width: 800
});

const optimizedWink = await getImage({
  src: profileWinkImage,
  format: "webp",
  width: 800,
  quality: 95
});

const optimizedWinkDepth = await getImage({
  src: profileWinkDepthImage,
  format: "png",
  width: 800
});

const optimizedBlink = await getImage({
  src: profileBlinkImage,
  format: "webp",
  width: 800,
  quality: 95
});

const optimizedBlinkDepth = await getImage({
  src: profileBlinkDepthImage,
  format: "png",
  width: 800
});

const optimizedClosedMouth = await getImage({
  src: profileClosedMouthImage,
  format: "webp",
  width: 800,
  quality: 95
});

const optimizedClosedMouthDepth = await getImage({
  src: profileClosedMouthDepthImage,
  format: "png",
  width: 800
});

const optimizedClosedMouthBlink = await getImage({
  src: profileClosedMouthBlinkImage,
  format: "webp",
  width: 800,
  quality: 95
});

const optimizedClosedMouthBlinkDepth = await getImage({
  src: profileClosedMouthBlinkDepthImage,
  format: "png",
  width: 800
});

// Configurable facial expressions state machine
const faceExpressions = [
  {
    id: "default",
    imageSrc: optimizedProfile.src,
    depthSrc: optimizedDepth.src,
    durationRange: [3000, 6000] as [number, number],
    transitionDuration: 180,
    transitions: [
      { targetId: "wink", weight: 25 },
      { targetId: "blink", weight: 35 },
      { targetId: "closed_mouth", weight: 40 }
    ]
  },
  {
    id: "wink",
    imageSrc: optimizedWink.src,
    depthSrc: optimizedWinkDepth.src,
    durationRange: [250, 380] as [number, number],
    transitionDuration: 120,
    transitions: [
      { targetId: "default", weight: 65 },
      { targetId: "closed_mouth", weight: 35 }
    ]
  },
  {
    id: "blink",
    imageSrc: optimizedBlink.src,
    depthSrc: optimizedBlinkDepth.src,
    durationRange: [180, 280] as [number, number],
    transitionDuration: 100,
    transitions: [
      { targetId: "default", weight: 70 },
      { targetId: "closed_mouth", weight: 30 }
    ]
  },
  {
    id: "closed_mouth",
    imageSrc: optimizedClosedMouth.src,
    depthSrc: optimizedClosedMouthDepth.src,
    durationRange: [2500, 5000] as [number, number],
    transitionDuration: 200,
    transitions: [
      { targetId: "closed_mouth_blink", weight: 40 },
      { targetId: "default", weight: 35 },
      { targetId: "blink", weight: 15 },
      { targetId: "wink", weight: 10 }
    ]
  },
  {
    id: "closed_mouth_blink",
    imageSrc: optimizedClosedMouthBlink.src,
    depthSrc: optimizedClosedMouthBlinkDepth.src,
    durationRange: [180, 280] as [number, number],
    transitionDuration: 100,
    transitions: [
      { targetId: "closed_mouth", weight: 75 },
      { targetId: "default", weight: 25 }
    ]
  }
];

const optimizedInterestSoftware = await getImage({ src: interestSoftwareImg, format: "webp", width: 800, quality: 85 });
const optimizedInterestSimulation = await getImage({ src: interestSimulationImg, format: "webp", width: 800, quality: 85 });
const optimizedInterestAi = await getImage({ src: interestAiImg, format: "webp", width: 800, quality: 85 });
const optimizedInterestUx = await getImage({ src: interestUxImg, format: "webp", width: 800, quality: 85 });

const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const services = await getCollection("services");
services.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const interests = await getCollection("interests");

const posts = await getCollection("posts");
const sortedPosts = posts.slice().sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
const recentPosts = sortedPosts.slice(0, 5);
const publications = await getCollection("publications");
const presentations = await getCollection("presentations");
const courses = await getCollection("courses");
const visualizations = await getCollection("visualizations");
const tagsCollection = await getCollection("tags");
const tagMap = new Map(tagsCollection.map(t => [t.id, t]));

// Calculate tags and graph payload for the home page Vis.js Network
const tagCounts = calculateTagCounts({ posts, publications, presentations, projects, courses, services, interests });
const tagPosts = tagCounts.posts;
const tagPubs = tagCounts.publications;
const tagPresentations = tagCounts.presentations;
const tagCourses = tagCounts.courses;
const tagProjects = tagCounts.projects;
const tagServices = tagCounts.services;
const tagInterests = tagCounts.interests;
const allTags = tagCounts.allTags;

interface TagCloudItem {
  id: string;
  name: string;
  description: string;
  totalCount: number;
  postsCount: number;
  pubsCount: number;
  presCount: number;
  coursesCount: number;
  projectsCount: number;
  servicesCount: number;
  interestsCount: number;
  postsPct: number;
  pubsPct: number;
  presPct: number;
  coursesPct: number;
  projectsPct: number;
  servicesPct: number;
  interestsPct: number;
  fontSizeClass: string;
  fontWeightClass: string;
}

const tagCloudList: TagCloudItem[] = allTags.map(tagId => {
  const postsCount = tagPosts[tagId] || 0;
  const pubsCount = tagPubs[tagId] || 0;
  const presCount = tagPresentations[tagId] || 0;
  const coursesCount = tagCourses[tagId] || 0;
  const projectsCount = tagProjects[tagId] || 0;
  const servicesCount = tagServices[tagId] || 0;
  const interestsCount = tagInterests[tagId] || 0;
  const totalCount = postsCount + pubsCount + presCount + coursesCount + projectsCount + servicesCount + interestsCount;
  
  const postsPct = totalCount > 0 ? Math.round((postsCount / totalCount) * 100) : 0;
  const pubsPct = totalCount > 0 ? Math.round((pubsCount / totalCount) * 100) : 0;
  const presPct = totalCount > 0 ? Math.round((presCount / totalCount) * 100) : 0;
  const coursesPct = totalCount > 0 ? Math.round((coursesCount / totalCount) * 100) : 0;
  const projectsPct = totalCount > 0 ? Math.round((projectsCount / totalCount) * 100) : 0;
  const servicesPct = totalCount > 0 ? Math.round((servicesCount / totalCount) * 100) : 0;
  const interestsPct = totalCount > 0 ? Math.round((interestsCount / totalCount) * 100) : 0;

  const tagEntry = tagMap.get(tagId);
  const name = tagEntry?.data.title ?? tagId;
  const description = tagEntry?.data.description ?? '';

  return {
    id: tagId,
    name,
    description,
    totalCount,
    postsCount,
    pubsCount,
    presCount,
    coursesCount,
    projectsCount,
    servicesCount,
    interestsCount,
    postsPct,
    pubsPct,
    presPct,
    coursesPct,
    projectsPct,
    servicesPct,
    interestsPct,
    fontSizeClass: "text-xs sm:text-sm",
    fontWeightClass: "font-medium",
  };
});

const maxTagCount = Math.max(...tagCloudList.map(t => t.totalCount), 1);
const minTagCount = Math.min(...tagCloudList.map(t => t.totalCount), 1);

tagCloudList.forEach(t => {
  const ratio = maxTagCount > minTagCount ? (t.totalCount - minTagCount) / (maxTagCount - minTagCount) : 0.5;
  if (ratio > 0.75) {
    t.fontSizeClass = "text-sm sm:text-lg md:text-xl";
    t.fontWeightClass = "font-extrabold";
  } else if (ratio > 0.45) {
    t.fontSizeClass = "text-xs sm:text-base md:text-lg";
    t.fontWeightClass = "font-bold";
  } else if (ratio > 0.2) {
    t.fontSizeClass = "text-xs sm:text-sm md:text-base";
    t.fontWeightClass = "font-semibold";
  } else {
    t.fontSizeClass = "text-[11px] sm:text-xs md:text-sm";
    t.fontWeightClass = "font-medium";
  }
});

// Sort by total count descending
const sortedByFreq = tagCloudList.slice().sort((a, b) => b.totalCount - a.totalCount || a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));
const top7Tags = sortedByFreq.slice(0, 7);
const remainingTags = sortedByFreq.slice(7, 21);
const overflowTags = sortedByFreq.slice(21);

const restTagsCount = overflowTags.length;
const overflowTagIds = new Set(overflowTags.map(t => t.id));

const restPostsCount = posts.filter(p => p.data.tags?.some(t => overflowTagIds.has(t))).length;
const restPubsCount = publications.filter(p => p.data.tags?.some(t => overflowTagIds.has(t))).length;
const restPresCount = presentations.filter(p => p.data.tags?.some(t => overflowTagIds.has(t))).length;
const restCoursesCount = courses.filter(c => c.data.tags?.some(t => overflowTagIds.has(t))).length;
const restProjectsCount = projects.filter(p => p.data.tags?.some(t => overflowTagIds.has(t))).length;
const restServicesCount = services.filter(s => s.data.tags?.some(t => overflowTagIds.has(t))).length;
const restInterestsCount = interests.filter(i => i.data.tags?.some(t => overflowTagIds.has(t))).length;
const restTotalContentCount = restPostsCount + restPubsCount + restPresCount + restCoursesCount + restProjectsCount + restServicesCount + restInterestsCount;

const restPostsPct = restTotalContentCount > 0 ? Math.round((restPostsCount / restTotalContentCount) * 100) : 0;
const restPubsPct = restTotalContentCount > 0 ? Math.round((restPubsCount / restTotalContentCount) * 100) : 0;
const restPresPct = restTotalContentCount > 0 ? Math.round((restPresCount / restTotalContentCount) * 100) : 0;
const restCoursesPct = restTotalContentCount > 0 ? Math.round((restCoursesCount / restTotalContentCount) * 100) : 0;
const restProjectsPct = restTotalContentCount > 0 ? Math.round((restProjectsCount / restTotalContentCount) * 100) : 0;
const restServicesPct = restTotalContentCount > 0 ? Math.round((restServicesCount / restTotalContentCount) * 100) : 0;
const restInterestsPct = restTotalContentCount > 0 ? Math.round((restInterestsCount / restTotalContentCount) * 100) : 0;

// Dynamic weight sizing for the remaining badge, capped to max tag weight
const cappedRestWeight = Math.min(restTotalContentCount, maxTagCount);
const restRatio = maxTagCount > minTagCount ? (cappedRestWeight - minTagCount) / (maxTagCount - minTagCount) : 0.5;
let restFontSizeClass = "text-[11px] sm:text-xs md:text-sm";
let restFontWeightClass = "font-medium";
if (restRatio > 0.75) {
  restFontSizeClass = "text-sm sm:text-lg md:text-xl";
  restFontWeightClass = "font-extrabold";
} else if (restRatio > 0.45) {
  restFontSizeClass = "text-xs sm:text-base md:text-lg";
  restFontWeightClass = "font-bold";
} else if (restRatio > 0.2) {
  restFontSizeClass = "text-xs sm:text-sm md:text-base";
  restFontWeightClass = "font-semibold";
}

const graphPayloads = await buildGraphPayload({
  posts,
  publications,
  presentations,
  projects,
  courses,
  services,
  interests,
  tags: tagsCollection,
  getImage
});

const homeVisPayload = {
  "vis-network": graphPayloads['vis-network']
};

const colorMappings = {
  blue: {
    border: 'border-brand-blue/10 hover:border-brand-blue/40 shadow-brand-blue/5 hover:shadow-brand-blue/15',
    backBorder: 'border-brand-blue/20 bg-brand-blue/5',
    text: 'text-brand-blue',
    bg: 'bg-brand-blue/10 text-brand-blue border-brand-blue/20',
    badge: 'bg-brand-blue/20 text-brand-blue border-brand-blue/30',
    button: 'bg-brand-blue hover:bg-brand-blue/90 shadow-brand-blue/20 text-white',
    buttonGradient: 'bg-gradient-blue text-white',
    bullet: 'text-brand-blue',
  },
  yellow: {
    border: 'border-brand-yellow/10 hover:border-brand-yellow/40 shadow-brand-yellow/5 hover:shadow-brand-yellow/15',
    backBorder: 'border-brand-yellow/20 bg-brand-yellow/5',
    text: 'text-brand-yellow',
    bg: 'bg-brand-yellow/10 text-brand-yellow border-brand-yellow/20',
    badge: 'bg-brand-yellow/20 text-brand-yellow border-brand-yellow/30',
    button: 'bg-brand-yellow hover:bg-brand-yellow/90 shadow-brand-yellow/20 text-gray-950 light:text-gray-50',
    buttonGradient: 'bg-gradient-yellow text-slate-950 font-extrabold',
    bullet: 'text-brand-yellow',
  },
  purple: {
    border: 'border-brand-purple/10 hover:border-brand-purple/40 shadow-brand-purple/5 hover:shadow-brand-purple/15',
    backBorder: 'border-brand-purple/20 bg-brand-purple/5',
    text: 'text-brand-purple',
    bg: 'bg-brand-purple/10 text-brand-purple border-brand-purple/20',
    badge: 'bg-brand-purple/20 text-brand-purple border-brand-purple/30',
    button: 'bg-brand-purple hover:bg-brand-purple/90 shadow-brand-purple/20 text-white',
    buttonGradient: 'bg-gradient-purple text-white',
    bullet: 'text-brand-purple',
  },
  green: {
    border: 'border-brand-green/10 hover:border-brand-green/40 shadow-brand-green/5 hover:shadow-brand-green/15',
    backBorder: 'border-brand-green/20 bg-brand-green/5',
    text: 'text-brand-green',
    bg: 'bg-brand-green/10 text-brand-green border-brand-green/20',
    badge: 'bg-brand-green/20 text-brand-green border-brand-green/30',
    button: 'bg-brand-green hover:bg-brand-green/90 shadow-brand-green/20 text-white',
    buttonGradient: 'bg-gradient-green text-white',
    bullet: 'text-brand-green',
  }
};

const professionalInterests = [
  {
    slug: "software-engineering",
    icon: "💻",
    color: "blue" as const,
    title: "Software Engineering",
    image: optimizedInterestSoftware.src,
    imageTitle: "Research domain: Software Engineering",
    imageDescription: "Focus area in Software Engineering: Architectures & Web Platforms.",
    description: "My passion lies in crafting high-performance, type-safe software. From modern web architectures with Astro and TypeScript to scalable industrial platforms, I love building robust systems from the ground up.",
    tags: [
      "software-engineering",
      "software-architecture",
      "web-development",
      "typescript",
      "systems-engineering",
      "open-source"
    ]
  },
  {
    slug: "computer-simulation",
    icon: "🎓",
    color: "yellow" as const,
    title: "Computer Simulation",
    image: optimizedInterestSimulation.src,
    imageTitle: "Research domain: Computer Simulation",
    imageDescription: "Focus area in Computer Simulation: Systems & Layout Modeling.",
    description: "I am fascinated by modeling complex physical and industrial systems. Combining discrete-event simulation and optimization algorithms, I design smart factory layouts, logistics workflows, and resource models.",
    tags: [
      "simulation",
      "optimization",
      "manufacturing-systems",
      "factory-layout",
      "systems-engineering"
    ]
  },
  {
    slug: "artificial-intelligence",
    icon: "🎯",
    color: "purple" as const,
    title: "Artificial Intelligence",
    image: optimizedInterestAi.src,
    imageTitle: "Research domain: Artificial Intelligence",
    imageDescription: "Focus area in Artificial Intelligence: Generative AI & Agent Systems.",
    description: "I actively explore local LLMs, agentic AI, and knowledge graphs. I enjoy developing autonomous reasoning engines, semantic search tools, and intelligent agent workflows to unlock new scientific insights.",
    tags: [
      "artificial-intelligence",
      "generative-ai",
      "agentic-ai",
      "machine-learning",
      "enterprise-ai",
      "mcp"
    ]
  },
  {
    slug: "user-experience",
    icon: "🌐",
    color: "green" as const,
    title: "User Experience",
    image: optimizedInterestUx.src,
    imageTitle: "Research domain: User Experience",
    imageDescription: "Focus area in User Experience: Visualizations & UI Designs.",
    description: "I believe great software must be intuitive, responsive, and visually engaging. I love creating interactive graph network visualizers, dynamic layouts, and polished interfaces that make complex data effortless to explore.",
    tags: [
      "user-interface",
      "ux-design",
      "data-visualization",
      "human-computer-interaction",
      "computer-graphics",
      "webgl"
    ]
  }
];

// Build comprehensive showcase items for the flying image gallery marquee pool
const postGalleryItems: GalleryItem[] = await Promise.all(
  sortedPosts
    .filter(p => !!p.data.icon)
    .map(async p => {
      const opt = await getImage({
        src: p.data.icon!.src || p.data.icon!,
        format: "webp",
        width: 480,
        height: 270,
        quality: 80
      });
      return {
        id: `post:${p.id}`,
        title: p.data.title,
        image: opt.src,
        href: `/posts/${p.id}/`,
        tagline: p.data.description,
        pubDate: new Date(p.data.pubDate).valueOf(),
        imageTitle: p.data.icon!.title,
        imageDescription: p.data.icon!.description
      };
    })
);

const projectGalleryItems: GalleryItem[] = await Promise.all(
  sortedProjects
    .filter(p => !!p.data.screenshot)
    .map(async p => {
      const opt = await getImage({
        src: p.data.screenshot!.src || p.data.screenshot!,
        format: "webp",
        width: 480,
        height: 270,
        quality: 80
      });
      return {
        id: `project:${p.id}`,
        title: p.data.title,
        image: opt.src,
        href: `/projects/${p.id}/`,
        tagline: p.data.description,
        pubDate: Date.now() - 1000 * 60 * 60 * 24 * 60,
        imageTitle: p.data.screenshot!.title,
        imageDescription: p.data.screenshot!.description
      };
    })
);

const courseGalleryItems: GalleryItem[] = await Promise.all(
  courses
    .filter(c => !!c.data.screenshot)
    .map(async c => {
      const opt = await getImage({
        src: c.data.screenshot!.src || c.data.screenshot!,
        format: "webp",
        width: 480,
        height: 270,
        quality: 80
      });
      return {
        id: `course:${c.id}`,
        title: c.data.title,
        image: opt.src,
        href: `/courses/${c.id}/`,
        tagline: c.data.description,
        pubDate: Date.now() - 1000 * 60 * 60 * 24 * 90,
        imageTitle: c.data.screenshot!.title,
        imageDescription: c.data.screenshot!.description
      };
    })
);

const allModules = await getCollection("modules");
const serviceGalleryItems: GalleryItem[] = await Promise.all(
  services
    .filter(s => !!s.data.previewImage)
    .map(async s => {
      const opt = await getImage({
        src: s.data.previewImage!.src || s.data.previewImage!,
        format: "webp",
        width: 480,
        height: 270,
        quality: 80
      });
      return {
        id: `service:${s.id}`,
        title: s.data.title,
        image: opt.src,
        href: `/services/${s.id}/`,
        tagline: s.data.description,
        pubDate: Date.now() - 1000 * 60 * 60 * 24 * 120,
        imageTitle: s.data.previewImage!.title,
        imageDescription: s.data.previewImage!.description
      };
    })
);

const moduleGalleryItems: GalleryItem[] = await Promise.all(
  allModules
    .filter(m => !!m.data.previewImage)
    .map(async m => {
      const opt = await getImage({
        src: m.data.previewImage!.src || m.data.previewImage!,
        format: "webp",
        width: 480,
        height: 270,
        quality: 80
      });
      const [serviceSlug, moduleSlug] = m.id.split('/');
      return {
        id: `module:${m.id}`,
        title: m.data.title,
        image: opt.src,
        href: `/services/${serviceSlug}/${moduleSlug}/`,
        tagline: m.data.description,
        pubDate: Date.now() - 1000 * 60 * 60 * 24 * 120,
        imageTitle: m.data.previewImage!.title,
        imageDescription: m.data.previewImage!.description
      };
    })
);

const visualizationGalleryItems: GalleryItem[] = await Promise.all(
  visualizations
    .filter(v => !!v.data.screenshot)
    .map(async v => {
      const opt = await getImage({
        src: v.data.screenshot!.src || v.data.screenshot!,
        format: "webp",
        width: 480,
        height: 270,
        quality: 80
      });
      return {
        id: `viz:${v.id}`,
        title: v.data.title,
        image: opt.src,
        href: `/visualizations/${v.id}/`,
        tagline: v.data.description,
        pubDate: v.data.pubDate ? new Date(v.data.pubDate).valueOf() : (Date.now() - 1000 * 60 * 60 * 24 * 150),
        imageTitle: v.data.screenshot!.title,
        imageDescription: v.data.screenshot!.description
      };
    })
);

const interestGalleryItems: GalleryItem[] = professionalInterests.map(interest => ({
  id: `interest:${interest.slug}`,
  title: interest.title,
  image: interest.image,
  href: `/interests/${interest.slug}/`,
  tagline: interest.description,
  pubDate: Date.now() - 1000 * 60 * 60 * 24 * 30,
  imageTitle: interest.imageTitle,
  imageDescription: interest.imageDescription
}));

// Interleave categories to alternate color and topic rhythms in the marquee
const categoryBuckets = [
  postGalleryItems,
  projectGalleryItems,
  courseGalleryItems,
  [...serviceGalleryItems, ...moduleGalleryItems],
  visualizationGalleryItems,
  interestGalleryItems
];

const galleryItems: GalleryItem[] = [];
const maxBucketLen = Math.max(...categoryBuckets.map(b => b.length));
for (let i = 0; i < maxBucketLen; i++) {
  for (const bucket of categoryBuckets) {
    if (i < bucket.length) {
      galleryItems.push(bucket[i]);
    }
  }
}

const websiteSections = [
  {
    title: "Posts",
    emoji: "📝",
    href: "/posts/",
    section: "posts",
    count: posts.length,
    unit: "Articles",
    description: "Technical articles, dev logs, and engineering insights on AI, systems, and web architectures.",
    borderHover: "group-hover:border-brand-blue/40",
    glowShadow: "group-hover:shadow-[0_12px_35px_-10px_rgba(59,130,246,0.25)]",
    badgeStyle: "bg-brand-blue/10 text-brand-blue border-brand-blue/20",
    buttonGradient: "bg-gradient-blue text-white",
    radialGlow: "bg-brand-blue/10"
  },
  {
    title: "Publications",
    emoji: "📄",
    href: "/publications/",
    section: "publications",
    count: publications.length,
    unit: "Publications",
    description: "Peer-reviewed scientific papers, academic publications, and conference proceedings.",
