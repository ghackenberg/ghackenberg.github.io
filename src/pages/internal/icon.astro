---
import "@fontsource/outfit/800.css";

const mode = Astro.url.searchParams.get('mode') || 'transparent';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Icon Generator</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      }

      .icon-wrapper {
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      /* Standard transparent container (for browser tab favicons - minimal padding, maximal size) */
      .icon-wrapper.mode-transparent {
        background: transparent;
      }

      .icon-wrapper.mode-transparent svg {
        width: 100%;
        height: 100%;
      }

      .icon-wrapper.mode-transparent .text-logo {
        font-size: 78px;
        letter-spacing: -3px;
      }

      /* App icon container (for Apple Touch Icon & PWA icons: solid theme background with optimal padding) */
      .icon-wrapper.mode-app {
        background: #030712;
        background-image: radial-gradient(circle at 50% 30%, #0d1e44 0%, #030712 85%);
      }

      .icon-wrapper.mode-app svg {
        width: 78%;
        height: 78%;
      }

      .icon-wrapper.mode-app .text-logo {
        font-size: 78px;
        letter-spacing: -3px;
      }

      /* Maskable icon container (for Android adaptive icons: centered inside 80% safe zone) */
      .icon-wrapper.mode-maskable {
        background: #030712;
        background-image: radial-gradient(circle at 50% 30%, #0d1e44 0%, #030712 85%);
      }

      .icon-wrapper.mode-maskable svg {
        width: 70%;
        height: 70%;
      }

      .icon-wrapper.mode-maskable .text-logo {
        font-size: 78px;
        letter-spacing: -3px;
      }
    </style>
  </head>
  <body>
    <div id="icon-container" class={`icon-wrapper mode-${mode}`}>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128">
        <defs>
          <linearGradient id="gh-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#3b82f6" />
            <stop offset="50%" stop-color="#a855f7" />
            <stop offset="100%" stop-color="#f59e0b" />
          </linearGradient>
          <style>
            .text-logo {
              font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
              font-weight: 800;
              fill: url(#gh-gradient);
            }
          </style>
        </defs>
        <text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" class="text-logo">GH</text>
      </svg>
    </div>

    <script is:inline>
      const urlParams = new URLSearchParams(window.location.search);
      const activeMode = urlParams.get('mode') || 'transparent';
      const container = document.getElementById('icon-container');
      if (container) {
        container.className = 'icon-wrapper mode-' + activeMode;
      }
    </script>
  </body>
</html>
