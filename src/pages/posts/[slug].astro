---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import GetInTouchCard from "@components/GetInTouchCard.astro";
import { getCollection, render } from "astro:content";
import { generateCitationLabel } from "@commons/shared/citations.js";
import fs from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const rawTocHeadings = (headings || []).filter((h) => h.depth === 2 || h.depth === 3);
const tocHeadings = [...rawTocHeadings];
if (post.data.references && post.data.references.length > 0) {
  const refText = post.data.lang === "en" ? "References" : "Referenzen";
  const refSlug = post.data.lang === "en" ? "references" : "referenzen";
  if (!tocHeadings.some((h) => h.slug === refSlug)) {
    tocHeadings.push({ depth: 2, slug: refSlug, text: refText });
  }
}

const ui = {
  back: "Back to Posts",
  keyTakeaways: "Key Takeaways / Executive Summary",
  tocTitle: "Table of Contents",
  discussionHeading: "Questions, feedback, or discussion?",
  discussionText: "Want to discuss this topic or have feedback on this article? Feel free to reach out directly or connect on LinkedIn.",
  contactBtn: "Send message",
  linkedInBtn: "Connect on LinkedIn",
};

const seoDescription = post.data.description 
  ? post.data.description.replace(/\s+/g, " ").trim().substring(0, 156)
  : `${post.data.title} - A blog post by Dr. Georg Hackenberg on topics like ${post.data.tags.join(", ")}.`;

// Direct read of the raw content file to determine if math is present (since Astro 5/6 Content Layer glob loader does not expose the raw body directly on getCollection entries)
const postDir = path.join(process.cwd(), "src/content/posts", post.id);
let rawContent = "";
try {
  const mdPath = path.join(postDir, "index.md");
  const mdxPath = path.join(postDir, "index.mdx");
  if (fs.existsSync(mdPath)) {
    rawContent = fs.readFileSync(mdPath, "utf-8");
  } else if (fs.existsSync(mdxPath)) {
    rawContent = fs.readFileSync(mdxPath, "utf-8");
  }
} catch (e) {
  console.error(`Failed to read post file for math check: ${post.id}`, e);
}

const hasMath = rawContent.includes("$$") || /\$[^\$\s][^\$]*\$/.test(rawContent);

const postUrl = `https://hackenberg.tech/posts/${post.id}/`;

const iconSrc = post.data.icon?.src;
const isSvgIcon = iconSrc?.format === "svg";
const ogImage = isSvgIcon ? `/posts/${post.id}/og.png` : iconSrc;
const schemaImage = isSvgIcon 
  ? new URL(`/posts/${post.id}/og.png`, Astro.site).href
  : (iconSrc?.src ? new URL(iconSrc.src, Astro.site).href : undefined);

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${postUrl}#article`,
  "headline": post.data.title,
  "description": seoDescription,
  "image": schemaImage,
  "url": postUrl,
  "datePublished": post.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech"
  },
  "publisher": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech"
  },
  "keywords": post.data.tags ? post.data.tags.join(", ") : undefined,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Posts",
      "item": "https://hackenberg.tech/posts/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.data.title,
      "item": postUrl
    }
  ]
};

const postJsonLd = [blogPostingSchema, breadcrumbSchema];
---

<Layout 
  title={`${post.data.title} | Dr. Georg Hackenberg`} 
  description={seoDescription}
  image={ogImage}
  type="article"
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  hasMath={hasMath}
  jsonLd={postJsonLd}
  lang={post.data.lang || "de"}
>
  <Navbar />

  <Section id="post-content" padding="standard">
    <Container size="reading" padding="none">
    <!-- Back button -->
    <a 
      href="/posts/" 
      class="inline-flex items-center space-x-2 text-xs font-semibold px-4 py-2 rounded-xl bg-brand-blue/10 border border-brand-blue/20 hover:border-brand-blue/30 text-brand-blue transition-all mb-8 cursor-pointer"
    >
      <span>&larr;</span>
      <span>{ui.back}</span>
    </a>

    <!-- Post Header -->
    <header class="mb-10">
      <div class="flex items-center space-x-3 mb-4">
        <time class="text-sm font-semibold text-brand-blue/80">
          {post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric"
          })}
        </time>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
        {post.data.title}
      </h1>

      <div class="flex flex-wrap gap-2">
        {post.data.tags.map(tag => (
          <a 
            href={`/tags/${tag}/`}
            class="px-2.5 py-1 rounded-lg text-xs font-medium bg-element-bg border border-element-border-medium text-gray-400 hover:text-gray-100 hover:border-brand-blue/30 transition-all duration-200"
          >
            #{tag}
          </a>
        ))}
      </div>
    </header>

    {post.data.description && (
      <aside class="mb-10 p-6 rounded-2xl bg-brand-blue/5 light:bg-blue-50/80 border border-brand-blue/20 light:border-brand-blue/30 text-gray-200 light:text-slate-900 shadow-sm" aria-label={ui.keyTakeaways}>
        <div class="text-xs font-bold text-brand-blue light:text-brand-blue uppercase tracking-wider mb-2 flex items-center gap-2">
          <span class="text-base">⚡</span>
          <span>{ui.keyTakeaways}</span>
        </div>
        <p class="text-sm sm:text-base leading-relaxed text-gray-300 light:text-slate-800">
          {post.data.description}
        </p>
      </aside>
    )}

    <!-- Table of Contents for deep content exploration -->
    {tocHeadings.length >= 3 && (
      <nav class="mb-10 p-6 rounded-2xl glass-card border border-element-border/80 shadow-sm" aria-label={ui.tocTitle}>
        <div class="text-xs font-bold text-brand-blue uppercase tracking-wider mb-3 flex items-center gap-2">
          <span class="text-base">📑</span>
          <span>{ui.tocTitle}</span>
        </div>
        <ul class="space-y-1.5 text-sm">
          {tocHeadings.map(h => (
            <li class={h.depth === 3 ? "ml-4" : ""}>
              <a 
                href={`#${h.slug}`} 
                class="text-gray-300 hover:text-brand-blue transition-colors block py-0.5 leading-snug"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Post Body -->
    <div class="post-body glass-card p-6 md:p-10 rounded-3xl border border-element-border mb-12 relative overflow-hidden prose-custom">
      <!-- Top accent line -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-blue"></div>
      
      <Content />

      {post.data.references && post.data.references.length > 0 && (
        <section id={post.data.lang === 'en' ? 'references' : 'referenzen'} class="mt-12 pt-4">
          <h2>{post.data.lang === 'en' ? 'References' : 'Referenzen'}</h2>
          <ul class="space-y-3.5 list-none pl-0 text-sm sm:text-base leading-relaxed text-slate-300 light:text-slate-700">
            {post.data.references.map((ref) => (
              <li id={`ref-${ref.id}`} class="group flex items-start gap-2.5 scroll-mt-24 p-2 -mx-2 rounded-lg transition-colors hover:bg-white/[0.03] light:hover:bg-slate-100/60 target:bg-brand-blue/10 target:border target:border-brand-blue/30">
                <span class="font-mono text-brand-blue light:text-blue-700 font-bold shrink-0 select-none px-1.5 py-0 rounded bg-brand-blue/10 border border-brand-blue/20 leading-relaxed">[{generateCitationLabel(ref)}]</span>
                <div class="leading-relaxed">
                  <span class="font-medium text-slate-200 light:text-slate-800">{ref.author}</span>
                  {ref.year ? <span> ({ref.year}). </span> : <span>. </span>}
                  <cite class="italic font-normal text-slate-100 light:text-slate-900">{ref.title}</cite>.
                  {ref.type === 'inproceedings' && (
                    <span> In <em>{ref.booktitle}</em>{ref.pages ? (post.data.lang === 'en' ? `, pp. ${ref.pages}` : `, S. ${ref.pages}`) : ''}{ref.publisher ? ` (${ref.publisher})` : ''}. </span>
                  )}
                  {ref.type === 'article' && (
                    <span> <em>{ref.journal}</em>{ref.volume ? `, ${ref.volume}` : ''}{ref.number ? `(${ref.number})` : ''}{ref.pages ? (post.data.lang === 'en' ? `, pp. ${ref.pages}` : `, S. ${ref.pages}`) : ''}. </span>
                  )}
                  {ref.type === 'book' && (
                    <span>{ref.edition ? ` (${ref.edition}). ` : ' '}{ref.publisher}. </span>
                  )}
                  {ref.type === 'online' && (
                    <span>{ref.siteName ? ` ${ref.siteName}. ` : ' '}</span>
                  )}
                  {ref.type === 'misc' && (
                    <span>{ref.howpublished ? ` ${ref.howpublished}. ` : ' '}{ref.note ? `${ref.note}. ` : ''}</span>
                  )}
                  {ref.doi && (
                    <span>DOI: <a href={ref.doi.startsWith('http') ? ref.doi : `https://doi.org/${ref.doi}`} target="_blank" rel="noopener noreferrer" class="text-brand-blue light:text-blue-700 hover:underline break-all">{ref.doi}</a>. </span>
                  )}
                  {ref.url && (!ref.doi || !ref.url.includes(ref.doi)) && (
                    <span>{ref.type === 'online' ? (post.data.lang === 'en' ? 'Available online at ' : 'Online verfügbar unter ') : ''}<a href={ref.url} target="_blank" rel="noopener noreferrer" class="text-brand-blue light:text-blue-700 hover:underline break-all">{ref.url}</a>.</span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <!-- Contact & Discussion Section -->
    <GetInTouchCard
      sectionHeading="Start a Conversation"
      sectionDescription="Want to discuss this topic or have feedback on this article? Feel free to reach out directly via email."
      cardHeading="Feedback & Topic Discussion"
      emailSubject={`Feedback: ${post.data.title}`}
      accentColor="blue"
      primaryButtonText="Open Email Client"
    />
    </Container>
  </Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="posts" 
    currentId={post.id} 
    tags={post.data.tags} 
  />
</Layout>

<style>
  /* Local styling rules for post html contents rendering */
  .post-body :global(h2) {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-heading);
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 0.5rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .post-body :global(h2:first-child) {
    margin-top: 0;
  }
  .post-body :global(h3) {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
    line-height: 1.4;
    transition: color 0.5s ease;
  }
  .post-body :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: var(--color-text-main);
    font-size: 1.0625rem;
    transition: color 0.5s ease;
  }
  .post-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .post-body :global(a:not([class*="bg-"])) {
    color: #3b82f6; /* brand-blue */
    text-decoration: underline;
    transition: color 0.2s;
  }
  :root.light .post-body :global(a:not([class*="bg-"])),
  .light .post-body :global(a:not([class*="bg-"])) {
    color: #1d4ed8;
  }
  .post-body :global(a:not([class*="bg-"]):hover) {
    color: #60a5fa;
  }
  :root.light .post-body :global(a:not([class*="bg-"]):hover),
  .light .post-body :global(a:not([class*="bg-"]):hover) {
    color: #1e40af;
  }
  .post-body :global(.citation) {
    text-decoration: none !important;
  }
  .post-body :global(.citation:hover) {
    text-decoration: none !important;
  }
  .post-body :global(strong) {
    color: var(--color-text-heading);
    font-weight: 700;
    transition: color 0.5s ease;
  }
  .post-body :global(img) {
    border-radius: 1rem;
    border: 1px solid var(--color-border-medium);
    max-width: 100%;
    height: auto;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-block;
    vertical-align: middle;
  }
  .post-body :global(img:hover) {
    border-color: rgba(255, 255, 255, 0.2);
    transform: scale(1.01);
  }
  :global(.light) .post-body :global(img:hover) {
    border-color: rgba(15, 23, 42, 0.2);
  }
  /* Center block images */
  .post-body :global(p > img:only-child),
  .post-body :global(p > a:only-child > img) {
    display: block;
    margin: 2.5rem auto;
  }
  /* Responsive, styled iframes (YouTube, Slideshare) */
  .post-body :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 1rem;
    border: 1px solid var(--color-border-medium);
    margin: 2.5rem auto;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
    background: rgba(17, 24, 39, 0.4);
    display: block;
  }
  :global(.light) .post-body :global(iframe) {
    background: rgba(255, 255, 255, 0.4);
  }
  .post-body :global(pre) {
    background: rgba(3, 7, 18, 0.6);
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.75rem;
    padding: 1.25rem;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    color: #e5e7eb;
  }
  :global(.light) .post-body :global(pre) {
    background: rgba(255, 255, 255, 0.6);
    color: #1e293b;
  }
  .post-body :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-main);
    transition: color 0.5s ease;
  }
  .post-body :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-main);
    transition: color 0.5s ease;
  }
  .post-body :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  /* Markdown Tables Styling */
  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    background: rgba(37, 49, 78, 0.25);
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
  }
  :global(.light) .post-body :global(table) {
    background: rgba(15, 23, 42, 0.03);
  }
  .post-body :global(th) {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.875rem 1.25rem;
    text-align: left;
    font-weight: 700;
    color: var(--color-text-heading);
    border-bottom: 1px solid var(--color-border-medium);
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  :global(.light) .post-body :global(th) {
    background: rgba(15, 23, 42, 0.05);
  }
  .post-body :global(td) {
    padding: 0.875rem 1.25rem;
    color: var(--color-text-main);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .post-body :global(tr:last-child td) {
    border-bottom: none;
  }

  /* Reset article styles inside Mermaid diagrams to avoid inflating label boxes */
  .post-body :global(.mermaid-svg p) {
    margin: 0 !important;
    margin-bottom: 0 !important;
    line-height: 1.5 !important;
    font-size: 13px !important;
    padding: 0 !important;
  }
  .post-body :global(.mermaid-svg text) {
    font-family: "Inter", system-ui, -apple-system, sans-serif !important;
  }
</style>
