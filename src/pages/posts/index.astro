---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import { getCollection } from "astro:content";
import PostCard from "@components/PostCard.astro";
import FilterToolbar from "@components/FilterToolbar.astro";
import CatalogPreFilter from "@components/CatalogPreFilter.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { buildCollectionPageSchema } from "@commons/server/json-ld";

const allPosts = await getCollection("posts");
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique tags for tag filter across all posts
const tagsSet = new Set<string>();
for (const post of posts) {
  if (post.data.tags) {
    post.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();

const pagePreviewImage = posts.find(p => p.data.image)?.data.image;

---

<Layout 
  title="Blog Posts | Dr. Georg Hackenberg" 
  description="Read computer science insights, software tutorials, and dev logs by Dr. Georg Hackenberg covering systems development, styling, and graphics."
  image={pagePreviewImage}
  jsonLd={buildCollectionPageSchema("posts", posts.map((p) => ({ id: `https://hackenberg.tech/posts/${p.id}/#article` })))}
>
  <Navbar />

  <Container size="wide">
    <Breadcrumbs domain="posts" />

    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-6">
        Blog <span class="text-domain-posts">Posts</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Technical articles, development logs, and architectural insights covering usability design, graphics engines, software systems, and engineering.
      </p>
    </div>

    <!-- Filter Toolbar -->
    <FilterToolbar
      searchId="post-search"
      searchPlaceholder="Search articles..."
      tags={allTags}
      domain="posts"
      totalCount={posts.length}
      pageSize={12}
      itemTags={posts.map(p => (p.data.tags || []).map(t => t.toLowerCase()))}
    />

    <!-- Posts Grid & Results -->
    {posts.length === 0 ? (
      <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No blog posts found.</p>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
          {posts.map((post, idx) => {
            const tagsJoined = (post.data.tags || []).join(" ").toLowerCase();
            const isInitialHidden = idx >= 12;
            return (
              <div 
                class={`post-card-item h-full ${isInitialHidden ? "hidden" : ""}`}
                style={isInitialHidden ? "display: none;" : ""}
                data-title={post.data.title.toLowerCase()}
                data-desc={(post.data.description || "").toLowerCase()}
                data-tags={tagsJoined}
              >
                <PostCard
                  id={post.id}
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  image={post.data.image}
                  tags={post.data.tags}
                />
              </div>
            );
          })}
        </div>

        <CatalogPreFilter
          itemSelector=".post-card-item"
          noResultsId="no-posts-message"
          pageSize={12}
        />
      </>
    )}

    <p id="no-posts-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
      No blog posts match your selected filter criteria.
    </p>

    <!-- Pagination Controls -->
    <nav id="posts-pagination" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-element-border mt-10" aria-label="Blog Posts Pagination">
      {/* Previous Button */}
      <div class="flex-1 w-full sm:w-auto text-left">
        <button 
          type="button" 
          data-action="prev" 
          disabled
          class="prev-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border text-gray-600 text-sm font-semibold cursor-not-allowed opacity-40 w-full sm:w-auto transition-all duration-200"
        >
          <span class="mr-1.5">&larr;</span>
          <span>Previous</span>
        </button>
      </div>

      {/* Page Numbers */}
      <div class="page-numbers-container flex items-center justify-center gap-1.5 order-3 sm:order-2 flex-wrap"></div>

      {/* Next Button */}
      <div class="flex-1 w-full sm:w-auto text-right order-2 sm:order-3">
        <button 
          type="button" 
          data-action="next" 
          class="next-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border-medium text-gray-300 hover:text-gray-100 hover:border-domain-posts/30 hover:bg-element-bg-hover transition-all duration-200 text-sm font-semibold group w-full sm:w-auto cursor-pointer"
        >
          <span>Next</span>
          <span class="group-hover:translate-x-0.5 transition-transform ml-1.5">&rarr;</span>
        </button>
      </div>
    </nav>
  </Container>
</Layout>

<script>
  import { ClientListFilter } from "@commons/client/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".post-card-item",
      searchFieldSelector: "#post-search",
      searchDataAttributes: ["data-title", "data-desc", "data-tags"],
      searchParamKey: "q",
      resetButtonSelector: "#post-search-reset",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag",
          multiple: true
        }
      ],
      pagination: {
        pageSize: 12,
        navSelector: "#posts-pagination",
        pageParamKey: "page",
        domain: "posts",
        scrollToSelector: "#posts-grid"
      },
      noResultsSelector: "#no-posts-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>
