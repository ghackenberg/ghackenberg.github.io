---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";

const allPosts = await getCollection("posts");
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect all unique tags for tag filter across all posts
const tagsSet = new Set<string>();
for (const post of posts) {
  if (post.data.tags) {
    post.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();

const pagePreviewImage = posts.find(p => p.data.icon)?.data.icon;
---

<Layout 
  title="Blog Posts | Dr. Georg Hackenberg, Professor for Industrial Informatics @ UAP Campus Wels" 
  description="Read computer science insights, software tutorials, and dev logs by Dr. Georg Hackenberg covering systems development, styling, and graphics."
  image={pagePreviewImage}
>
  <Navbar />

  <main class="flex-grow max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-20 w-full relative z-10">
    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
        Blog <span class="heading-gradient-blue">Posts</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Insights, development logs, sketches, and tutorials covering ultimate usability design, graphics engine development, software systems, and mechatronics workbench engineering.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Filter Sidebar (Column 1) -->
      <div class="lg:col-span-3 order-1 lg:order-2 lg:sticky lg:top-24">
        <div class="glass-card p-6 rounded-2xl border border-element-border flex flex-col lg:max-h-[calc(100vh-8rem)]">
          <div class="mb-4 shrink-0">
            <h2 class="text-lg font-bold flex items-center space-x-2">
              <span>⚙️</span>
              <span>Filter Posts</span>
            </h2>
          </div>

          <!-- Text Search -->
          <div class="mb-4 shrink-0">
            <label for="post-search" class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block mb-2">Search</label>
            <div class="relative">
              <input 
                type="text" 
                id="post-search" 
                placeholder="Search articles..." 
                class="w-full bg-element-bg border border-element-border-medium rounded-lg px-3 py-2 pl-8 text-xs placeholder-gray-500 focus:outline-none focus:border-brand-blue/50 focus:ring-1 focus:ring-brand-blue/50 transition-all duration-200"
              />
              <span class="absolute left-2.5 top-2.5 text-xs text-gray-500">🔍</span>
            </div>
          </div>

          <!-- Technologies / Tags list -->
          <div class="flex-1 min-h-0 flex flex-col">
            <div class="flex items-center justify-between mb-2 shrink-0">
              <span class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block">Filter by Tag</span>
              <span class="text-[10px] text-gray-500 font-medium">{allTags.length} topics</span>
            </div>
            <div class="flex flex-wrap gap-1.5 max-h-[260px] lg:max-h-none flex-1 min-h-0 overflow-y-auto pr-1 custom-scrollbar-thin content-start" id="tag-filter-buttons">
              {allTags.map(tag => (
                <button 
                  type="button" 
                  class="tag-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold border cursor-pointer transition-all duration-200"
                  data-tag={tag}
                >
                  #{tag}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Posts Grid (Column 2) -->
      <div class="lg:col-span-9 order-2 lg:order-1">
        {posts.length === 0 ? (
          <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No blog posts found.</p>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 scroll-mt-28" id="posts-grid">
            {posts.map((post) => {
              const tagsJoined = (post.data.tags || []).join(" ").toLowerCase();
              return (
                <div 
                  class="post-card-item h-full"
                  data-title={post.data.title.toLowerCase()}
                  data-desc={(post.data.description || "").toLowerCase()}
                  data-tags={tagsJoined}
                >
                  <PostCard
                    id={post.id}
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    icon={post.data.icon}
                    tags={post.data.tags}
                  />
                </div>
              );
            })}
          </div>
        )}

        <p id="no-posts-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
          No blog posts match your selected filter criteria.
        </p>

        <!-- Pagination Controls -->
        <nav id="posts-pagination" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-white/5 mt-10" aria-label="Blog Posts Pagination">
          {/* Previous Button */}
          <div class="flex-1 w-full sm:w-auto text-left">
            <button 
              type="button"
              data-action="prev"
              disabled
              class="prev-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border text-gray-600 text-sm font-semibold cursor-not-allowed opacity-40 w-full sm:w-auto transition-all duration-200"
            >
              <span class="mr-1.5">&larr;</span>
              <span>Previous</span>
            </button>
          </div>

          {/* Page Numbers */}
          <div class="page-numbers-container flex items-center justify-center gap-1.5 order-3 sm:order-2 flex-wrap"></div>

          {/* Next Button */}
          <div class="flex-1 w-full sm:w-auto text-right order-2 sm:order-3">
            <button 
              type="button"
              data-action="next"
              class="next-btn inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-element-bg border border-element-border-medium text-gray-300 hover:text-gray-100 hover:border-brand-blue/30 hover:bg-element-bg-hover transition-all duration-200 text-sm font-semibold group w-full sm:w-auto cursor-pointer"
            >
              <span>Next</span>
              <span class="group-hover:translate-x-0.5 transition-transform ml-1.5">&rarr;</span>
            </button>
          </div>
        </nav>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { ClientListFilter } from "../../scripts/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".post-card-item",
      searchFieldSelector: "#post-search",
      searchDataAttributes: ["data-title", "data-desc", "data-tags"],
      searchParamKey: "q",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag"
        }
      ],
      pagination: {
        pageSize: 10,
        navSelector: "#posts-pagination",
        pageParamKey: "page",
        theme: "blue",
        scrollToSelector: "#posts-grid"
      },
      scrollToSelector: "#posts-grid",
      noResultsSelector: "#no-posts-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>

<style>
  .tag-filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #9ca3af;
  }

  .tag-filter-btn:hover:not(.active) {
    border-color: rgba(59, 130, 246, 0.3);
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.08);
  }

  .tag-filter-btn.active {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
    color: #7dd3fc;
    box-shadow: 0 0 15px -3px rgba(59, 130, 246, 0.25);
  }

  /* Light mode overrides */
  :global(.light) .tag-filter-btn {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.08);
    color: #475569;
  }

  :global(.light) .tag-filter-btn:hover:not(.active) {
    background: rgba(59, 130, 246, 0.06);
    border-color: rgba(59, 130, 246, 0.3);
    color: #1d4ed8;
  }

  :global(.light) .tag-filter-btn.active {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    color: #1d4ed8;
    box-shadow: 0 0 15px -3px rgba(59, 130, 246, 0.2);
  }
</style>
