---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const modules = await getCollection("course-modules");
  const courses = await getCollection("courses");

  return modules.map((module) => {
    const [courseSlug, moduleSlug] = module.id.split('/');
    const parentCourse = courses.find((c) => c.id === courseSlug || c.id === module.data.courseId);

    if (!parentCourse) {
      throw new Error(`Parent course not found for course module: ${module.id}`);
    }

    return {
      params: { slug: courseSlug, moduleSlug: moduleSlug },
      props: { module, parentCourse },
    };
  });
}

interface Props {
  module: CollectionEntry<"course-modules">;
  parentCourse: CollectionEntry<"courses">;
}

const { module, parentCourse } = Astro.props;
const { Content } = await render(module);

const moduleUrl = `https://hackenberg.tech/courses/${parentCourse.id}/${module.id.split('/').pop()}/`;

const activePreviewImage = module.data.previewImage || parentCourse.data.screenshot;

const moduleCourseSchema = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "@id": `${moduleUrl}#module`,
  "name": module.data.title,
  "description": module.data.description,
  "learningResourceType": "Course Module",
  "isPartOf": {
    "@id": `https://hackenberg.tech/courses/${parentCourse.id}/#course`
  },
  "image": activePreviewImage ? new URL(activePreviewImage.src.src, Astro.site).href : undefined,
  "url": moduleUrl,
  "teaches": module.data.topics && module.data.topics.length > 0 ? module.data.topics.join(", ") : undefined,
  "competencyRequired": module.data.competencies && module.data.competencies.length > 0 ? module.data.competencies.join(", ") : undefined,
  "author": {
    "@id": "https://hackenberg.tech/#person"
  },
  "inLanguage": parentCourse.data.language || "de"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Courses",
      "item": "https://hackenberg.tech/courses/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": parentCourse.data.title,
      "item": `https://hackenberg.tech/courses/${parentCourse.id}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": module.data.title,
      "item": moduleUrl
    }
  ]
};

const moduleJsonLd = [moduleCourseSchema, breadcrumbSchema];
---

<Layout 
  title={`${module.data.title} | ${parentCourse.data.title}`} 
  description={module.data.description}
  image={activePreviewImage}
  tags={parentCourse.data.tags}
  jsonLd={moduleJsonLd}
  lang={parentCourse.data.language || 'de'}
>
  <Navbar />

  <Section id="course-module-content" padding="standard">
    <Container size="reading" padding="none">
      <!-- Breadcrumbs Navigation -->
      <Breadcrumbs 
        items={[
          { label: "Home", href: "/" },
          { label: "Courses", href: "/courses/" },
          { label: parentCourse.data.title, href: `/courses/${parentCourse.id}/` },
          { label: module.data.title }
        ]}
        domain="courses"
      />

      <!-- Header -->
      <header class="mb-12 relative">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
          {module.data.title}
        </h1>
        <p class="text-gray-300 text-base sm:text-lg max-w-3xl leading-relaxed font-normal">
          {module.data.description}
        </p>

        {/* Quick Specs Grid */}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
          <div class="px-4 py-2.5 rounded-xl bg-element-bg border border-element-border flex flex-col justify-center min-h-[50px] light:bg-slate-50 light:border-slate-200">
            <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wider">Course</span>
            <span class="text-xs font-bold mt-0.5 text-gray-200 light:text-slate-800 truncate" title={parentCourse.data.title}>
              {parentCourse.data.title}
            </span>
          </div>
          <div class="px-4 py-2.5 rounded-xl bg-element-bg border border-element-border flex flex-col justify-center min-h-[50px] light:bg-slate-50 light:border-slate-200">
            <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wider">Language</span>
            <span class="text-xs font-bold mt-0.5 text-gray-200 light:text-slate-800">
              {parentCourse.data.language === 'de' ? 'German' : 'English'}
            </span>
          </div>
          <div class="px-4 py-2.5 rounded-xl bg-element-bg border border-element-border flex flex-col justify-center min-h-[50px] light:bg-slate-50 light:border-slate-200">
            <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wider">Module Sequence</span>
            <span class="text-xs font-bold mt-0.5 text-gray-200 light:text-slate-800">
              Unit {module.data.order}
            </span>
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <div class="glass-card p-8 md:p-10 rounded-3xl border border-element-border relative overflow-hidden prose-custom course-content">
        <!-- Module Overview Content -->
        <div class="mb-10">
          <Content />
        </div>

        <!-- Module Topics -->
        {module.data.topics && module.data.topics.length > 0 && (
          <div id="module-topics" class="mb-10">
            <h2 id="module-topics-heading" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
              Covered <span class="text-domain-courses">Topics</span>
            </h2>
            <ul class="space-y-2">
              {module.data.topics.map(topic => (
                <li>
                  <span>{topic}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Module Tools & Technologies -->
        {module.data.tools && module.data.tools.length > 0 && (
          <div id="module-tools" class="mb-10">
            <h2 id="module-tools-heading" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
              Applied <span class="text-domain-courses">Tools & Technologies</span>
            </h2>
            <div class="flex flex-wrap gap-2">
              {module.data.tools.map(tool => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase border border-domain-courses/20 bg-domain-courses/10 text-domain-courses">
                  🛠️ {tool}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Competencies / Learning Goals -->
        {module.data.competencies && module.data.competencies.length > 0 && (
          <div id="module-competencies">
            <h2 id="module-competencies-heading" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
              Target <span class="text-domain-courses">Competencies</span>
            </h2>
            <ul class="space-y-2">
              {module.data.competencies.map(comp => (
                <li>
                  <span>{comp}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </Container>
  </Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="courses" 
    currentId={parentCourse.id} 
    tags={parentCourse.data.tags} 
  />
</Layout>

<style>
  /* Markdown content styling for course module layouts */
  .course-content :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
    transition: color 0.5s ease;
  }
  .course-content :global(li strong) {
    color: var(--color-text-heading);
    transition: color 0.5s ease;
  }
  .course-content :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>
