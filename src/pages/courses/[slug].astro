---
import Layout from "@layouts/Layout.astro";
import { buildCourseSchema } from "@commons/server/json-ld";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import CourseModuleCard from "@components/CourseModuleCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import TagChip from "@components/TagChip.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);

const allCourseModules = await getCollection('course-modules');
const courseModules = allCourseModules
  .filter((m) => m.data.courseId === course.id)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const repoUrl = course.data.repoName ? `https://github.com/ghackenberg/${course.data.repoName}` : undefined;


const courseSchema = buildCourseSchema({ course, modules: courseModules, siteUrl: Astro.site?.origin || "https://hackenberg.tech" });
---

<Layout 
  title={`${course.data.title} | Dr. Georg Hackenberg`} 
  description={course.data.description}
  image={course.data.image}
  tags={course.data.tags}
  jsonLd={courseSchema}
  lang={course.data.inLanguage || 'de'}
>
  <Navbar />

  <Section id="course-content" padding="standard">
    <Container size="reading" padding="none">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs 
      items={[
        { label: "Home", href: "/" },
        { label: "Courses", href: "/courses/" },
        { label: course.data.title }
      ]}
      domain="courses"
    />

    <!-- Title Header -->
    <header class="mb-12 relative">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
        {course.data.title}
      </h1>
      {course.data.description && (
        <p class="text-gray-300 text-base max-w-3xl leading-relaxed font-normal">
          {course.data.description}
        </p>
      )}
      {course.data.tags && course.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {course.data.tags.map((tag) => (
            <TagChip tag={tag} />
          ))}
        </div>
      )}

      <div class="flex flex-wrap items-center gap-3 mt-6">
        {course.data.inLanguage && (
          <span class="px-4 py-2.5 rounded-xl text-xs font-bold bg-element-bg border border-element-border text-gray-200 flex items-center space-x-2">
            <span>🌐</span>
            <span>{course.data.inLanguage === 'de' ? 'German' : 'English'}</span>
          </span>
        )}

        {repoUrl && (
          <a 
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-xl text-xs font-bold bg-element-bg border border-element-border hover:border-element-border-medium text-gray-200 transition-all duration-300 hover:scale-105 flex items-center space-x-2 cursor-pointer"
          >
            <svg class="w-4 h-4 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <span>GitHub Repository</span>
          </a>
        )}

        {repoUrl && (
          <a 
            href="https://github.com/sponsors/ghackenberg"
            target="_blank"
            rel="noopener noreferrer"
            data-track-event="High Intent: Sponsor Click"
            data-track-location="course-header"
            class="px-4 py-2.5 rounded-xl text-xs font-bold bg-element-bg border border-element-border hover:border-domain-courses/40 text-gray-200 hover:text-domain-courses transition-all duration-300 hover:scale-105 flex items-center space-x-2 cursor-pointer"
            title="Sponsor open educational courseware on GitHub Sponsors"
          >
            <svg class="w-4 h-4 text-domain-courses fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
            </svg>
            <span>Sponsor Courseware</span>
          </a>
        )}
      </div>
    </header>

    <div class="glass-card p-8 md:p-10 rounded-3xl border border-element-border relative overflow-hidden prose-custom">
      <p class="text-base text-gray-300 leading-relaxed font-normal mb-8">{course.data.overview || course.data.description}</p>

      {course.data.targetAudience && (
        <div class="mb-8">
          <h2 id="target-audience" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Target Audience
          </h2>
          <p class="text-gray-300 leading-relaxed font-normal">
            {course.data.targetAudience}
          </p>
        </div>
      )}

      {course.data.prerequisites && course.data.prerequisites.length > 0 && (
        <div class="mb-8">
          <h2 id="course-prerequisites" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Course Prerequisites
          </h2>
          <ul class="space-y-2">
            {course.data.prerequisites.map(prereq => (
              <li>
                <span>{prereq}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mb-8">
        <h2 id="learning-goals" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
          Learning Goals
        </h2>
        {course.data.competencies && course.data.competencies.length > 0 ? (
          <ul class="space-y-2">
            {course.data.competencies.map(comp => (
              <li>
                <strong class="text-gray-100 font-semibold">{comp.title}:</strong> {comp.description}
              </li>
            ))}
          </ul>
        ) : course.data.learningGoals && course.data.learningGoals.length > 0 && (
          <ul class="space-y-2">
            {course.data.learningGoals.map(goal => (
              <li>
                <span>{goal}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="syllabus-summary">
        <h2 id="course-syllabus" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
          Course Syllabus
        </h2>
        {courseModules.length > 0 ? (
          <ol class="space-y-3 text-gray-300 font-normal leading-relaxed list-decimal pl-5">
            {courseModules.map((mod) => (
              <li>
                <strong class="text-gray-100 font-semibold">{mod.data.title}</strong>: {mod.data.description}
              </li>
            ))}
          </ol>
        ) : course.data.syllabus && course.data.syllabus.length > 0 ? (
          <ol class="space-y-3 text-gray-300 font-normal leading-relaxed list-decimal pl-5">
            {course.data.syllabus.map((mod) => (
              <li>
                <strong class="text-gray-100 font-semibold">{mod.title}</strong>: {mod.description}
              </li>
            ))}
          </ol>
        ) : (
          <Content />
        )}
      </div>
    </div>
    </Container>
  </Section>

  <!-- Section 2: Course Modules -->
  {courseModules.length > 0 && (
    <Section id="course-modules" border="top" padding="standard">
      <Container size="wide" padding="none">
        <div class="mb-8 md:mb-12">
          <h2 id="course-modules-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-4">
            Course <span class="text-domain-courses">Modules</span>
          </h2>
          <p class="text-gray-400 text-sm md:text-base max-w-2xl leading-relaxed font-normal">
            Structured learning units covering theoretical foundations, practical implementations, and industry tooling.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {courseModules.map((module) => (
            <CourseModuleCard courseId={course.id} module={module} />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="courses" 
    currentId={course.id} 
    tags={course.data.tags} 
  />
</Layout>

<style>
  /* Syllabus rich markdown formatting inside CSS styles */
  .syllabus-content :global(h2),
  .syllabus-summary :global(h2) {
    font-weight: 850;
    color: var(--color-text-heading);
    margin-top: 2.25rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.025em;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 0.5rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .syllabus-content :global(h2:first-child),
  .syllabus-summary :global(h2:first-child) {
    margin-top: 0;
  }
  .syllabus-content :global(h3),
  .syllabus-summary :global(h3) {
    font-weight: 750;
    color: var(--color-text-heading);
    margin-top: 1.75rem;
    margin-bottom: 0.85rem;
    transition: color 0.5s ease;
  }
  .syllabus-content :global(h4),
  .syllabus-summary :global(h4) {
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 1.35rem;
    margin-bottom: 0.6rem;
    line-height: 1.45;
    transition: color 0.5s ease;
  }
  .syllabus-content :global(p),
  .syllabus-summary :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 1.5rem;
    transition: color 0.5s ease;
  }
  .syllabus-content :global(table),
  .syllabus-summary :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }
  .syllabus-content :global(th),
  .syllabus-summary :global(th) {
    text-align: left;
    padding: 0.75rem 1rem;
    background: var(--color-element-bg);
    border-bottom: 2px solid var(--color-border-subtle);
    font-weight: 700;
    color: var(--color-text-heading);
  }
  .syllabus-content :global(td),
  .syllabus-summary :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-main);
  }
  .syllabus-content :global(tr:hover td),
  .syllabus-summary :global(tr:hover td) {
    background: rgba(255, 255, 255, 0.02);
  }
</style>
