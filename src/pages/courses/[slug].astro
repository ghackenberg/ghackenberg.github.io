---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);

// Dynamically fetch the referenced repository entry
const repos = await getCollection("github-repos");
const repoEntry = repos.find(r => r.id.toLowerCase() === course.data.repoName.toLowerCase());
const repo = repoEntry?.data;
const starCount = (repo as { stargazers_count?: number } | undefined)?.stargazers_count || repo?.stars || 0;

const courseUrl = `https://hackenberg.tech/courses/${course.id}/`;

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "@id": `${courseUrl}#course`,
  "name": course.data.title,
  "description": course.data.description || `${course.data.title} taught by Dr. Georg Hackenberg.`,
  "image": course.data.screenshot ? new URL(course.data.screenshot.src.src, Astro.site).href : undefined,
  "url": courseUrl,
  "provider": {
    "@type": "EducationalOrganization",
    "name": "UAP - University of Applied Sciences Upper Austria",
    "sameAs": "https://www.wikidata.org/wiki/Q1390494"
  },
  "instructor": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech",
    "sameAs": "https://www.wikidata.org/wiki/Q141537961"
  },
  "inLanguage": course.data.language,
  "educationalCredentialAwarded": "Academic Course Credit",
  "teaches": course.data.learningGoals ? course.data.learningGoals.join(", ") : undefined
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Courses",
      "item": "https://hackenberg.tech/courses/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": course.data.title,
      "item": courseUrl
    }
  ]
};

const courseJsonLd = [courseSchema, breadcrumbSchema];
---

<Layout 
  title={`${course.data.title} | Dr. Georg Hackenberg`} 
  description={course.data.description}
  image={course.data.screenshot}
  tags={course.data.tags}
  jsonLd={courseJsonLd}
  lang={course.data.language || 'de'}
>
  <Navbar />

  <Section id="course-content" padding="standard">
    <Container size="reading" padding="none">
    <!-- Back Button -->
    <a 
      href="/courses/" 
      class="inline-flex items-center space-x-2 text-xs font-semibold px-4 py-2 rounded-xl bg-brand-yellow/10 border border-brand-yellow/20 hover:border-brand-yellow/30 text-brand-yellow transition-all mb-8 cursor-pointer"
    >
      <span>&larr;</span>
      <span>Back to Courses</span>
    </a>

    <!-- Title Header -->
    <header class="mb-12 relative">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
        {course.data.title}
      </h1>
      {course.data.description && (
        <p class="text-gray-300 text-base max-w-3xl leading-relaxed font-normal">
          {course.data.description}
        </p>
      )}
      {course.data.tags && course.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {course.data.tags.map((tag) => (
            <a
              href={`/tags/${tag}/`}
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border transition-all duration-200 hover:scale-105 bg-brand-yellow/10 border-brand-yellow/20 text-brand-yellow hover:bg-brand-yellow/20 hover:border-brand-yellow/30"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      <div class="flex flex-wrap items-center gap-3 mt-6">
        {course.data.language && (
          <span class="px-4 py-2.5 rounded-xl text-xs font-bold bg-element-bg border border-element-border text-gray-200 flex items-center space-x-2">
            <span>🌐</span>
            <span>{course.data.language === 'de' ? 'German' : 'English'}</span>
          </span>
        )}

        {repo && (
          <a 
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-xl text-xs font-bold bg-element-bg border border-element-border hover:border-element-border-medium text-gray-200 transition-all duration-300 hover:scale-105 flex items-center space-x-2 cursor-pointer"
          >
            <svg class="w-4 h-4 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <span>GitHub Repository</span>
            {starCount > 0 && <span class="text-gray-400 font-normal">⭐ {starCount}</span>}
          </a>
        )}
      </div>
    </header>

    <div class="glass-card p-8 md:p-10 rounded-3xl border border-white/5 relative overflow-hidden prose-custom">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-yellow"></div>

      <p class="text-base text-gray-300 leading-relaxed font-normal mb-8">{course.data.overview || course.data.description}</p>

      {course.data.targetAudience && (
        <div class="mb-8">
          <h2 id="target-audience" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-white/5 pb-2 mb-4">
            Target Audience
          </h2>
          <p class="text-gray-300 leading-relaxed font-normal">
            {course.data.targetAudience}
          </p>
        </div>
      )}

      {course.data.prerequisites && course.data.prerequisites.length > 0 && (
        <div class="mb-8">
          <h2 id="course-prerequisites" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-white/5 pb-2 mb-4">
            Course Prerequisites
          </h2>
          <ul class="space-y-2">
            {course.data.prerequisites.map(prereq => (
              <li>
                <span>{prereq}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mb-8">
        <h2 id="learning-goals" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-white/5 pb-2 mb-4">
          Learning Goals
        </h2>
        {course.data.competencies && course.data.competencies.length > 0 ? (
          <ul class="space-y-2">
            {course.data.competencies.map(comp => (
              <li>
                <strong class="text-gray-100 font-semibold">{comp.title}:</strong> {comp.description}
              </li>
            ))}
          </ul>
        ) : course.data.learningGoals && course.data.learningGoals.length > 0 && (
          <ul class="space-y-2">
            {course.data.learningGoals.map(goal => (
              <li>
                <span>{goal}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="syllabus-content">
        <h2 id="course-syllabus" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-white/5 pb-2 mb-4">
          Course Syllabus
        </h2>
        {course.data.syllabus && course.data.syllabus.length > 0 ? (
          <div class="space-y-6">
            {course.data.syllabus.map(mod => (
              <div class="space-y-2">
                <h3 id={`module-${mod.moduleNumber}`} class="text-lg font-bold text-gray-100 tracking-tight">
                  Module {mod.moduleNumber}: {mod.title}
                </h3>
                <p class="text-gray-300 leading-relaxed font-normal text-base">
                  {mod.description}
                </p>
                {mod.topics && mod.topics.length > 0 && (
                  <ul class="space-y-2">
                    {mod.topics.map(topic => (
                      <li>
                        <span>{topic}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        ) : (
          <Content />
        )}
      </div>
    </div>
    </Container>
  </Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="courses" 
    currentId={course.id} 
    tags={course.data.tags} 
  />
</Layout>

<style>
  /* Syllabus rich markdown formatting inside CSS styles */
  .syllabus-content :global(h2) {
    font-weight: 850;
    color: var(--color-text-heading);
    margin-top: 2.25rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.025em;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 0.5rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .syllabus-content :global(h2:first-child) {
    margin-top: 0;
  }
  .syllabus-content :global(h3) {
    font-weight: 750;
    color: var(--color-text-heading);
    margin-top: 1.75rem;
    margin-bottom: 0.85rem;
    transition: color 0.5s ease;
  }
  .syllabus-content :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 1.5rem;
    transition: color 0.5s ease;
  }
  .syllabus-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }
  .syllabus-content :global(th) {
    text-align: left;
    padding: 0.75rem 1rem;
    background: var(--color-element-bg);
    border-bottom: 2px solid var(--color-border-subtle);
    font-weight: 700;
    color: var(--color-text-heading);
  }
  .syllabus-content :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-main);
  }
  .syllabus-content :global(tr:hover td) {
    background: rgba(255, 255, 255, 0.02);
  }
</style>
