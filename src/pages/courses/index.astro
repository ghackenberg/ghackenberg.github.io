---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import CourseCard from "../../components/CourseCard.astro";

const courses = await getCollection("courses");

// Extract unique tags from all courses
const tagsSet = new Set<string>();
for (const course of courses) {
  if (course.data.tags) {
    course.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();

// Find the first course's screenshot to preload for LCP
const firstCourse = courses[0];
const firstCourseScreenshot = firstCourse?.data.screenshot;
const optimizedFirstScreenshot = firstCourseScreenshot ? await getImage({
  src: firstCourseScreenshot,
  format: 'webp',
  width: 480,
  quality: 80
}) : null;
---

<Layout 
  title="University Lectures | Dr. Georg Hackenberg, Professor for Industrial Informatics @ UAP Campus Wels" 
  description="Explore syllabus materials, repositories, and teaching resources for Computer Science & Industrial Informatics courses taught by Dr. Georg Hackenberg."
  image={firstCourseScreenshot}
  preloadImage={optimizedFirstScreenshot?.src}
>
  <Navbar />

  <main class="flex-grow max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-20 w-full relative z-10">
    <!-- Header -->
    <div class="mb-12">

      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
        University <span class="heading-gradient-yellow">Lectures</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Explore materials, code repositories, and syllabus details for the courses I teach at the University of Applied Sciences Upper Austria (Fakultät für Technik und angewandte Naturwissenschaften, Wels).
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Filters Sidebar (Column 1) -->
      <div class="lg:col-span-3 order-1 lg:order-2 lg:sticky lg:top-24">
        <div class="glass-card p-6 rounded-2xl border border-element-border flex flex-col lg:max-h-[calc(100vh-8rem)]">
          <div class="mb-4 shrink-0">
            <h2 class="text-lg font-bold flex items-center space-x-2">
              <span>⚙️</span>
              <span>Filter Catalog</span>
            </h2>
          </div>

          <!-- Text Search -->
          <div class="mb-4 shrink-0">
            <label for="course-search" class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block mb-2">Search</label>
            <div class="relative">
              <input 
                type="text" 
                id="course-search" 
                placeholder="Search lectures..." 
                class="w-full bg-element-bg border border-element-border-medium rounded-lg px-3 py-2 pl-8 text-xs placeholder-gray-500 focus:outline-none focus:border-brand-yellow/50 focus:ring-1 focus:ring-brand-yellow/50 transition-all duration-200"
              />
              <span class="absolute left-2.5 top-2.5 text-xs text-gray-500">🔍</span>
            </div>
          </div>

          <!-- Instruction Language -->
          <div class="mb-4 shrink-0">
            <span class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block mb-2">Instruction Language</span>
            <div class="flex flex-wrap gap-2">
              <button 
                id="lang-btn-de" 
                class="lang-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold border cursor-pointer transition-all duration-200"
                data-lang="de"
              >
                Deutsch (DE)
              </button>
              <button 
                id="lang-btn-en" 
                class="lang-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold border cursor-pointer transition-all duration-200"
                data-lang="en"
              >
                English (EN)
              </button>
            </div>
          </div>

          <!-- Technologies / Tags list -->
          <div class="flex-1 min-h-0 flex flex-col">
            <div class="flex items-center justify-between mb-2 shrink-0">
              <span class="text-[10px] font-extrabold text-gray-500 uppercase tracking-widest block">Filter by Tag</span>
              <span class="text-[10px] text-gray-500 font-medium">{allTags.length} topics</span>
            </div>
            <div class="flex flex-wrap gap-1.5 max-h-[240px] lg:max-h-none flex-1 min-h-0 overflow-y-auto pr-1 custom-scrollbar-thin content-start" id="tag-filter-buttons">
              {allTags.map(tag => (
                <button 
                  type="button" 
                  class="tag-filter-btn px-2.5 py-1 rounded-lg text-xs font-semibold border cursor-pointer transition-all duration-200"
                  data-tag={tag}
                >
                  #{tag}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Courses Grid (Column 2) -->
      <div class="lg:col-span-9 order-2 lg:order-1">
        {courses.length === 0 ? (
          <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No courses defined.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 scroll-mt-28" id="courses-grid">
            {courses.map(course => {
              const goalsJoined = (course.data.learningGoals || []).join(" ").toLowerCase();

              return (
                <div 
                  class="course-card h-full"
                  data-title={course.data.title.toLowerCase()}
                  data-desc={(course.data.description || "").toLowerCase()}
                  data-goals={goalsJoined}
                  data-tags={(course.data.tags || []).join(" ").toLowerCase()}
                  data-lang={course.data.language}
                >
                  <CourseCard
                    title={course.data.title}
                    description={course.data.description}
                    href={`/courses/${course.id}/`}
                    language={course.data.language}
                    screenshot={course.data.screenshot}
                    tags={course.data.tags}
                  />
                </div>
              );
            })}
          </div>
        )}
        <p id="no-courses-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
          No courses match your selected filter criteria.
        </p>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Custom filter active states matching design guidelines */
  .lang-filter-btn {
    position: relative;
    background: rgba(31, 41, 55, 0.4);
    border-color: rgba(255, 255, 255, 0.05);
    color: #9ca3af; /* text-gray-400 */
  }

  .lang-filter-btn.active {
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.3);
    color: #f59e0b; /* brand-yellow */
    box-shadow: 0 0 15px -3px rgba(245, 158, 11, 0.25);
  }

  .lang-filter-btn:hover:not(.active) {
    border-color: rgba(245, 158, 11, 0.2);
    color: #fbbf24;
  }

  /* Light mode overrides */
  :global(.light) .lang-filter-btn {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.08);
    color: #475569; /* slate-600 */
  }

  :global(.light) .lang-filter-btn.active {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
    color: #b45309; /* amber-700 */
    box-shadow: 0 0 15px -3px rgba(245, 158, 11, 0.2);
  }

  :global(.light) .lang-filter-btn:hover:not(.active) {
    background: rgba(245, 158, 11, 0.06);
    border-color: rgba(245, 158, 11, 0.3);
    color: #d97706; /* amber-600 */
  }

  /* Tag filter buttons */
  .tag-filter-btn {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #9ca3af;
  }

  .tag-filter-btn:hover:not(.active) {
    border-color: rgba(245, 158, 11, 0.3);
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.08);
  }

  .tag-filter-btn.active {
    background: rgba(245, 158, 11, 0.2);
    border-color: rgba(245, 158, 11, 0.5);
    color: #fde047;
    box-shadow: 0 0 15px -3px rgba(245, 158, 11, 0.25);
  }

  /* Light mode overrides */
  :global(.light) .tag-filter-btn {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.08);
    color: #475569;
  }

  :global(.light) .tag-filter-btn:hover:not(.active) {
    background: rgba(245, 158, 11, 0.06);
    border-color: rgba(245, 158, 11, 0.3);
    color: #d97706;
  }

  :global(.light) .tag-filter-btn.active {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
    color: #b45309;
    box-shadow: 0 0 15px -3px rgba(245, 158, 11, 0.2);
  }
</style>

<script>
  import { ClientListFilter } from "../../scripts/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".course-card",
      searchFieldSelector: "#course-search",
      searchDataAttributes: ["data-title", "data-desc", "data-goals", "data-tags"],
      searchParamKey: "q",
      buttonFilters: [
        {
          buttonSelector: ".lang-filter-btn",
          dataAttribute: "data-lang",
          defaultValue: "all",
          activeClass: "active",
          paramKey: "lang"
        },
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag"
        }
      ],
      scrollToSelector: "#courses-grid",
      noResultsSelector: "#no-courses-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>
