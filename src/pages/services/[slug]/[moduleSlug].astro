---
import Layout from "@layouts/Layout.astro";
import { buildServiceModuleSchema } from "@commons/server/json-ld";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const modules = await getCollection("service-modules");
  const services = await getCollection("services");
  
  return modules.map((module) => {
    const [serviceSlug, moduleSlug] = module.id.split('/');
    const parentService = services.find((s) => s.id === serviceSlug);
    
    return {
      params: { slug: serviceSlug, moduleSlug: moduleSlug },
      props: { module, parentService },
    };
  });
}

interface Props {
  module: CollectionEntry<"service-modules">;
  parentService: CollectionEntry<"services">;
}

const { module, parentService } = Astro.props;
const { Content } = await render(module);


const activePreviewImage = module.data.image || parentService.data.image;

const moduleSchema = buildServiceModuleSchema({ parentService, module, siteUrl: Astro.site?.origin || "https://hackenberg.tech" });
---

<Layout 
  title={`${module.data.title} | Dr. Georg Hackenberg`} 
  description={module.data.description}
  image={activePreviewImage}
  breadcrumbParentTitle={parentService.data.title}
  jsonLd={moduleSchema}
>
  <Navbar />

  <Section id="module-content" padding="standard">
    <Container size="reading" padding="none">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs 
      items={[
        { label: "Home", href: "/" },
        { label: "Services", href: "/services/" },
        { label: parentService.data.title, href: `/services/${parentService.id}/` },
        { label: module.data.title }
      ]}
      domain="services"
    />

    <!-- Header -->
    <header class="mb-12 relative">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
        {module.data.title}
      </h1>
      <p class="text-gray-300 text-base sm:text-lg max-w-3xl leading-relaxed font-normal">
        {module.data.description}
      </p>
      
      {/* Quick Specs Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
        <div class="px-4 py-2.5 rounded-xl bg-element-bg border border-element-border flex flex-col justify-center min-h-[50px] light:bg-slate-50 light:border-slate-200">
          <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wider">Est. Duration</span>
          <span class="text-xs font-bold mt-0.5">
            {module.data.duration || 'Flexible Plan'}
          </span>
        </div>
        <div class="px-4 py-2.5 rounded-xl bg-element-bg border border-element-border flex flex-col justify-center min-h-[50px] light:bg-slate-50 light:border-slate-200">
          <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wider">Format</span>
          <span class="text-xs font-bold mt-0.5">
            {module.data.format || 'Sprint-Based'}
          </span>
        </div>
        <div class="px-4 py-2.5 rounded-xl bg-element-bg border border-element-border flex flex-col justify-center min-h-[50px] light:bg-slate-50 light:border-slate-200">
          <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wider">Delivery Mode</span>
          <span class="text-xs font-bold mt-0.5">
            {module.data.delivery || 'Collaborative'}
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="glass-card p-8 md:p-10 rounded-3xl border border-element-border service-content prose-custom">
      <!-- Module Overview Content -->
      <div id="module-overview" class="mb-10">
        <Content />
      </div>

      <!-- Module Scope -->
      {module.data.highlights && module.data.highlights.length > 0 && (
        <div id="module-scope" class="mb-10">
          <h2 id="module-scope-heading" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Module Scope
          </h2>
          <ul class="space-y-2">
            {module.data.highlights.map(item => (
              <li>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Required Inputs -->
      {module.data.inputs && module.data.inputs.length > 0 && (
        <div id="required-inputs" class="mb-10">
          <h2 id="required-inputs-heading" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Required Inputs
          </h2>
          <ul class="space-y-2">
            {module.data.inputs.map(item => (
              <li>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Technical Deliverables -->
      {module.data.outputs && module.data.outputs.length > 0 && (
        <div id="technical-deliverables" class="mb-10">
          <h2 id="technical-deliverables-heading" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Technical Deliverables
          </h2>
          <ul class="space-y-2">
            {module.data.outputs.map(item => (
              <li>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Delivery Methodology (if present) -->
      {module.data.methodologyPhases && module.data.methodologyPhases.length > 0 && (
        <div id="delivery-methodology">
          <h2 id="delivery-methodology-heading" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Delivery Methodology
          </h2>
          {module.data.methodologyDescription && (
            <p class="text-gray-300 leading-relaxed font-normal mb-4">
              {module.data.methodologyDescription}
            </p>
          )}
          <ol class="space-y-2">
            {module.data.methodologyPhases.map(phase => (
              <li>
                <strong class="text-gray-100 font-semibold">{phase.title}:</strong> {phase.description}
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>
  </Container>
</Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="services" 
    currentId={parentService.id} 
    tags={parentService.data.tags} 
  />
</Layout>

<style>
  /* Markdown content styling for service layouts */
  .service-content :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
    transition: color 0.5s ease;
  }
  .service-content :global(li strong) {
    color: var(--color-text-heading);
    transition: color 0.5s ease;
  }
  .service-content :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>
