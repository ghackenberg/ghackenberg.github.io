---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import GetInTouchCard from "@components/GetInTouchCard.astro";
import RelatedContent from "@components/RelatedContent.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const modules = await getCollection("modules");
  const services = await getCollection("services");
  
  return modules.map((module) => {
    const [serviceSlug, moduleSlug] = module.id.split('/');
    const parentService = services.find((s) => s.id === serviceSlug);
    
    return {
      params: { slug: serviceSlug, moduleSlug: moduleSlug },
      props: { module, parentService },
    };
  });
}

interface Props {
  module: CollectionEntry<"modules">;
  parentService: CollectionEntry<"services">;
}

const { module, parentService } = Astro.props;
const { Content } = await render(module);

const moduleUrl = `https://hackenberg.tech/services/${parentService.id}/${module.id.split('/').pop()}/`;

const activePreviewImage = module.data.previewImage || parentService.data.previewImage;

const moduleServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${moduleUrl}#service`,
  "name": module.data.title,
  "serviceType": module.data.title,
  "description": module.data.description,
  "image": activePreviewImage ? new URL(activePreviewImage.src.src, Astro.site).href : undefined,
  "url": moduleUrl,
  "category": parentService.data.title,
  "provider": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech"
  },
  "areaServed": "Global"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://hackenberg.tech/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": parentService.data.title,
      "item": `https://hackenberg.tech/services/${parentService.id}/`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": module.data.title,
      "item": moduleUrl
    }
  ]
};

const moduleJsonLd = [moduleServiceSchema, breadcrumbSchema];
---

<Layout 
  title={`${module.data.title} | Dr. Georg Hackenberg`} 
  description={module.data.description}
  image={activePreviewImage}
  jsonLd={moduleJsonLd}
>
  <Navbar />

  <Section id="module-content" padding="standard">
    <Container size="reading" padding="none">
    <!-- Back Button -->
    <a 
      href={`/services/${parentService.id}/`} 
      class="inline-flex items-center space-x-2 text-xs font-semibold px-4 py-2 rounded-xl bg-brand-purple/10 border border-brand-purple/20 hover:border-brand-purple/30 text-brand-purple transition-all mb-8 cursor-pointer"
    >
      <span>&larr;</span>
      <span>Back to {parentService.data.title}</span>
    </a>

    <!-- Header -->
    <header class="mb-12 relative">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
        {module.data.title}
      </h1>
      <p class="text-gray-300 text-base sm:text-lg max-w-3xl leading-relaxed font-normal">
        {module.data.description}
      </p>
      
      {/* Quick Specs Grid */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-6">
        <div class="px-4 py-2.5 rounded-xl bg-element-bg border border-element-border flex flex-col justify-center min-h-[50px] light:bg-slate-50 light:border-slate-200">
          <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wider">Est. Duration</span>
          <span class="text-xs font-bold mt-0.5">
            {module.data.duration || 'Flexible Plan'}
          </span>
        </div>
        <div class="px-4 py-2.5 rounded-xl bg-element-bg border border-element-border flex flex-col justify-center min-h-[50px] light:bg-slate-50 light:border-slate-200">
          <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wider">Format</span>
          <span class="text-xs font-bold mt-0.5">
            {module.data.format || 'Sprint-Based'}
          </span>
        </div>
        <div class="px-4 py-2.5 rounded-xl bg-element-bg border border-element-border flex flex-col justify-center min-h-[50px] light:bg-slate-50 light:border-slate-200">
          <span class="text-[9px] font-bold text-gray-500 uppercase tracking-wider">Delivery Mode</span>
          <span class="text-xs font-bold mt-0.5">
            {module.data.delivery || 'Collaborative'}
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="glass-card p-8 md:p-10 rounded-3xl border border-element-border service-content theme-purple prose-custom mb-16">
      <!-- Module Overview Content -->
      <section id="module-overview" class="mb-10">
        <Content />
      </section>

      <!-- Module Scope -->
      {module.data.highlights && module.data.highlights.length > 0 && (
        <section id="module-scope" class="mb-10">
          <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Module Scope
          </h2>
          <ul class="list-disc pl-5 space-y-2 text-gray-300 font-normal leading-relaxed">
            {module.data.highlights.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}

      <!-- Required Inputs -->
      {module.data.inputs && module.data.inputs.length > 0 && (
        <section id="required-inputs" class="mb-10">
          <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Required Inputs
          </h2>
          <ul class="list-disc pl-5 space-y-2 text-gray-300 font-normal leading-relaxed">
            {module.data.inputs.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}

      <!-- Guaranteed Deliverables -->
      {module.data.outputs && module.data.outputs.length > 0 && (
        <section id="guaranteed-deliverables" class="mb-10">
          <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Guaranteed Deliverables
          </h2>
          <ul class="list-disc pl-5 space-y-2 text-gray-300 font-normal leading-relaxed">
            {module.data.outputs.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}

      <!-- Delivery Methodology (if present) -->
      {module.data.methodologyPhases && module.data.methodologyPhases.length > 0 && (
        <section id="delivery-methodology">
          <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
            Delivery Methodology
          </h2>
          {module.data.methodologyDescription && (
            <p class="text-gray-300 leading-relaxed font-normal mb-4">
              {module.data.methodologyDescription}
            </p>
          )}
          <ol class="list-decimal pl-5 space-y-3 text-gray-300 font-normal leading-relaxed">
            {module.data.methodologyPhases.map(phase => (
              <li>
                <strong class="text-gray-100 font-semibold">{phase.title}:</strong> {phase.description}
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>

    <!-- Contact Section -->
    <GetInTouchCard
      id="contact-services"
      sectionHeading="Start a Conversation"
      sectionDescription={`Write directly to request an inquiry about the ${module.data.title} module or custom bundle options.`}
      cardHeading="Contact & Booking Inquiry"
      emailSubject={`Services Inquiry: ${parentService.data.title} - ${module.data.title}`}
      accentColor="purple"
      primaryButtonText="Open Email Client"
    />
  </Container>
</Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="services" 
    currentId={parentService.id} 
    tags={parentService.data.tags} 
  />
</Layout>

<style>
  /* Markdown content styling for service layouts */
  .service-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-heading);
    margin-top: 1.85rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 0.35rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .service-content :global(h2:first-child) {
    margin-top: 0;
  }
  .service-content :global(h3) {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    transition: color 0.5s ease;
  }
  .service-content :global(p) {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
    transition: color 0.5s ease;
  }
  .service-content :global(p:first-of-type) {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-text-heading);
    border-left: 3px solid var(--glow-text, #a855f7);
    padding-left: 1rem;
    margin-bottom: 1.5rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .service-content :global(li strong) {
    color: var(--color-text-heading);
    transition: color 0.5s ease;
  }
  .service-content :global(> *:last-child) {
    margin-bottom: 0;
  }

  .theme-purple {
    --glow-border: rgba(168, 85, 247, 0.3);
    --glow-text: #c084fc;
    --glow-shadow: rgba(168, 85, 247, 0.25);
  }

  :global(.light) .theme-purple {
    --glow-border: rgba(109, 40, 217, 0.25);
    --glow-text: #6d28d9;
    --glow-shadow: rgba(109, 40, 217, 0.15);
  }
</style>

<script>
  // Add listeners to inquiry triggers to pre-fill email client link subject
  const triggers = document.querySelectorAll('.inquiry-trigger');
  const directMailLink = document.getElementById('direct-mail-link') as HTMLAnchorElement | null;
  
  triggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      const subject = trigger.getAttribute('data-subject');
      if (directMailLink && subject) {
        directMailLink.href = `mailto:georg.hackenberg@fh-wels.at?subject=${encodeURIComponent(subject)}`;
      }
    });
  });
</script>
