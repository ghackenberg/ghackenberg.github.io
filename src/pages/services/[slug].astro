---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const allModules = await getCollection("modules");
const serviceModules = allModules
  .filter((m) => m.data.serviceId === service.id)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const colorClasses = {
  text: 'text-brand-purple light:text-purple-700',
  border: 'border-brand-purple/20 light:border-purple-200',
  bg: 'bg-brand-purple/10 light:bg-purple-50/50',
  btnBg: 'bg-brand-purple hover:bg-brand-purple/90 shadow-brand-purple/20 hover:shadow-brand-purple/30 text-slate-950 font-bold light:bg-purple-600 light:hover:bg-purple-700 light:text-white',
  cardBtnBg: 'bg-brand-purple/12 hover:bg-brand-purple/25 border border-brand-purple/20 hover:border-brand-purple/45 text-purple-300 light:text-brand-purple',
  hoverText: 'group-hover:text-brand-purple light:group-hover:text-purple-600',
  glow: 'from-brand-purple to-pink-500 light:to-pink-600',
  leftBorder: 'border-brand-purple light:border-purple-600',
  dot: 'badge-new badge-new-purple'
};

const serviceUrl = `https://hackenberg.tech/services/${service.id}/`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${serviceUrl}#service`,
  "name": service.data.title,
  "serviceType": service.data.tagline,
  "description": service.data.description,
  "image": service.data.previewImage?.src ? new URL(service.data.previewImage.src, Astro.site).href : undefined,
  "url": serviceUrl,
  "provider": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech"
  },
  "areaServed": "Global"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://hackenberg.tech/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.data.title,
      "item": serviceUrl
    }
  ]
};

const serviceJsonLd = [serviceSchema, breadcrumbSchema];
---

<Layout 
  title={`${service.data.title} | Business Services | Dr. Georg Hackenberg, Professor for Industrial Informatics @ UAP Campus Wels`} 
  description={service.data.description}
  image={service.data.previewImage}
  tags={service.data.tags}
  jsonLd={serviceJsonLd}
>
  <Navbar />

  <main class="flex-grow max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-20 w-full relative z-10">
    <!-- Top Content (Narrow: max-w-4xl) -->
    <div class="max-w-4xl mx-auto">
      <!-- Back Button -->
      <a 
        href="/services/" 
        class="inline-flex items-center space-x-2 text-xs font-semibold px-4 py-2 rounded-xl bg-brand-purple/10 border border-brand-purple/20 hover:border-brand-purple/30 text-brand-purple transition-all mb-8 cursor-pointer"
      >
        <span>&larr;</span>
        <span>Back to Services</span>
      </a>

      <!-- Header -->
      <header class="mb-12 pb-10 border-b border-element-border relative">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
          {service.data.title}
        </h1>
        <p class={`${colorClasses.text} font-bold text-xs uppercase tracking-wider mb-2`}>
          {service.data.tagline}
        </p>
        <p class="text-gray-300 text-base sm:text-lg max-w-3xl leading-relaxed font-normal">
          {service.data.description}
        </p>

        {service.data.tags && service.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4 mb-2">
            {service.data.tags.map((tag) => (
              <a
                href={`/tags/${tag}/`}
                class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border transition-all duration-200 hover:scale-105 ${colorClasses.bg} ${colorClasses.border} ${colorClasses.text}`}
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
        
        <div class="flex flex-wrap gap-4 mt-6">
          <a
            href="#contact-services"
            data-subject={`Inquiry: ${service.data.title}`}
            class={`px-6 py-3 rounded-xl text-center text-xs font-bold shadow-md transition-all duration-300 hover:scale-[1.02] flex items-center justify-center space-x-1.5 cursor-pointer inquiry-trigger min-h-[44px] ${colorClasses.btnBg}`}
          >
            <span>{service.data.ctaText}</span>
            <span>&rarr;</span>
          </a>
        </div>
      </header>

      <!-- Service Text -->
      <section class="glass-card p-8 md:p-10 rounded-3xl border border-element-border service-content theme-purple prose-custom">
        <Content />
      </section>
    </div>

    <!-- Horizontal Ruler -->
    <hr class="border-element-border my-16" />

    <!-- Service Modules Section (Wide: max-w-6xl) -->
    <section class="space-y-6">
      <h2 class="text-2xl font-extrabold tracking-tight flex items-center space-x-2">
        <span>📦</span>
        <span>Available Service Modules</span>
      </h2>
      
      <p class="text-gray-400 text-sm leading-relaxed font-normal">
        Each service module represents a concrete building block that can be booked individually or combined into a comprehensive custom package.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {serviceModules.map((module) => {
              const moduleSlug = module.id.split('/').pop();
              return (
                <a 
                  href={`/services/${service.id}/${moduleSlug}/`}
                  class="glass-card preview-card border border-element-border relative flex flex-col h-full hover:border-element-border-medium transition-all duration-300 group cursor-pointer block no-underline"
                >
                  {/* Preview Image Column (Top) */}
                  <div class="w-full aspect-video shrink-0 relative overflow-hidden bg-gray-950/40 border-b border-element-border">
                    {module.data.previewImage && (
                      <Image 
                        src={module.data.previewImage} 
                        alt={`${module.data.title} preview`}
                        width={640}
                        height={360}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-gray-950/40 via-transparent to-transparent pointer-events-none z-10"></div>

                    <!-- Unread badge -->
                    <span 
                      class={`unread-dot hidden ${colorClasses.dot} badge-corner-tr`}
                      data-item-url={`/services/${service.id}/${moduleSlug}/`}
                      title="Unread module"
                    >UNREAD</span>
                  </div>
                  
                  <!-- Info Body (Below) -->
                  <div class="preview-card-body flex flex-col flex-grow justify-between relative z-10 text-left">
                    <div class="space-y-3">
                      <div class="flex items-center gap-2">
                        <h3 class={`text-base sm:text-lg font-bold uppercase tracking-wider leading-snug mt-0 flex items-center gap-2 text-gray-100 light:text-slate-900 ${colorClasses.hoverText} transition-colors`}>
                          <span>{module.data.title}</span>
                        </h3>
                      </div>
                      <p class={`${colorClasses.text} font-bold text-[10px] uppercase tracking-wider leading-none`}>
                        {module.data.tagline}
                      </p>
                      <p class="text-gray-400 text-xs sm:text-sm leading-relaxed font-normal">
                        {module.data.description}
                      </p>

                      <div class="flex flex-wrap gap-1.5 pt-1">
                        {module.data.duration && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold tracking-wide uppercase border border-element-border-medium bg-element-bg text-gray-400">
                            ⏱️ {module.data.duration}
                          </span>
                        )}
                        {module.data.format && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold tracking-wide uppercase border border-element-border-medium bg-element-bg text-gray-400">
                            ⚡ {module.data.format}
                          </span>
                        )}
                        {module.data.delivery && (
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-bold tracking-wide uppercase border border-element-border-medium bg-element-bg text-gray-400">
                            📍 {module.data.delivery}
                          </span>
                        )}
                      </div>
                    </div>

                    <!-- Read more button — full width, pinned to bottom -->
                    <div class="mt-auto pt-6 w-full">
                      <span 
                        class={`flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg text-xs font-bold relative z-20 transition-all duration-200 ${colorClasses.cardBtnBg}`}
                      >
                        <span>Read More</span>
                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>

    <!-- Contact & Booking Section -->
    <section id="contact-services" class="py-16 mt-16 border-t border-element-border scroll-mt-24">
      <div class="max-w-3xl mx-auto text-center mb-12">

        <h2 class="text-3xl md:text-4xl font-extrabold mb-4">
          Start a Conversation
        </h2>
        <p class="text-gray-400 text-sm md:text-base leading-relaxed">
          Write directly to discuss custom setups, corporate workshops, strategic advisory, or media publishing.
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="glass-card p-8 md:p-10 rounded-3xl border border-element-border relative overflow-hidden">
          <div class={`absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r ${colorClasses.glow}`}></div>
          
          <h3 class="text-lg font-bold mb-6">Contact & Booking Inquiry</h3>
          
          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class={`${colorClasses.text} mt-1.5 shrink-0`}>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"></path>
                </svg>
              </div>
              <div class="flex-grow flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <p class="text-gray-500 text-xs font-semibold uppercase tracking-wider">Send an email request to</p>
                  <p id="services-email-text" class="font-mono font-medium mt-0.5 select-all text-sm sm:text-base">georg.hackenberg@fh-wels.at</p>
                </div>
                <button 
                  id="services-copy-email-btn"
                  class="px-4 py-2 text-xs font-semibold rounded-lg bg-element-bg hover:bg-element-bg-hover text-gray-300 hover:text-gray-100 border border-element-border-medium hover:border-element-border-hover transition-all duration-200 self-start sm:self-auto flex items-center space-x-2"
                >
                  <span id="services-copy-btn-text">Copy Email</span>
                </button>
              </div>
            </div>
            
            <div class="pt-6 border-t border-element-border flex flex-col sm:flex-row gap-4 justify-between items-center text-xs text-gray-400">
              <p>Typically responding within 2 business days.</p>
              <a 
                id="direct-mail-link"
                href={`mailto:georg.hackenberg@fh-wels.at?subject=Services%20Inquiry:%20${encodeURIComponent(service.data.title)}`}
                class={`px-5 py-2.5 rounded-xl font-bold transition-all duration-300 hover:scale-105 shadow-md ${colorClasses.btnBg}`}
              >
                Open Email Client &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Markdown content styling for service layouts */
  .service-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-heading);
    margin-top: 1.85rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 0.35rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .service-content :global(h2:first-child) {
    margin-top: 0;
  }
  .service-content :global(h3) {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    transition: color 0.5s ease;
  }
  .service-content :global(p) {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
    transition: color 0.5s ease;
  }
  .service-content :global(p:first-of-type) {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-text-heading);
    border-left: 3px solid var(--glow-text, #a855f7);
    padding-left: 1rem;
    margin-bottom: 1.5rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .service-content :global(ul),
  .service-content :global(ol) {
    list-style-type: none;
    padding-left: 0;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .service-content :global(ol) {
    counter-reset: service-counter;
  }
  .service-content :global(li) {
    margin-bottom: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: 0.85rem 1rem 0.85rem 2.25rem;
    border-radius: 12px;
    position: relative;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  :global(.light) .service-content :global(li) {
    background: rgba(15, 23, 42, 0.02);
    border-color: rgba(15, 23, 42, 0.06);
  }
  .service-content :global(li:hover) {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  :global(.light) .service-content :global(li:hover) {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.1);
  }
  .service-content :global(li::before) {
    content: "→";
    position: absolute;
    left: 1rem;
    top: 0.85rem;
    line-height: 1.6;
    color: var(--glow-text, #a855f7);
    font-weight: bold;
  }
  .service-content :global(ol > li) {
    counter-increment: service-counter;
  }
  .service-content :global(ol > li::before) {
    content: counter(service-counter) ".";
  }
  .service-content :global(li strong) {
    color: var(--color-text-heading);
    transition: color 0.5s ease;
  }
  .service-content :global(> *:last-child) {
    margin-bottom: 0;
  }

  .theme-purple { --glow-text: #c084fc; }
  :global(.light) .theme-purple { --glow-text: #7e22ce; }
</style>

<script>
  // Add listeners to inquiry triggers to pre-fill email client link subject
  const triggers = document.querySelectorAll('.inquiry-trigger');
  const directMailLink = document.getElementById('direct-mail-link') as HTMLAnchorElement | null;
  
  triggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      const subject = trigger.getAttribute('data-subject');
      if (directMailLink && subject) {
        directMailLink.href = `mailto:georg.hackenberg@fh-wels.at?subject=${encodeURIComponent(subject)}`;
      }
    });
  });

  // Copy Email Logic
  const copyBtn = document.getElementById('services-copy-email-btn');
  const emailText = document.getElementById('services-email-text');
  const copyBtnText = document.getElementById('services-copy-btn-text');

  if (copyBtn && emailText && copyBtnText) {
    copyBtn.addEventListener('click', () => {
      const email = emailText.textContent?.trim() || 'georg.hackenberg@fh-wels.at';
      
      navigator.clipboard.writeText(email).then(() => {
        copyBtnText.textContent = 'Copied!';
        copyBtn.classList.remove('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
        copyBtn.classList.add('bg-brand-green/20', 'text-brand-green', 'border-brand-green/30');
        
        setTimeout(() => {
          copyBtnText.textContent = 'Copy Email';
          copyBtn.classList.remove('bg-brand-green/20', 'text-brand-green', 'border-brand-green/30');
          copyBtn.classList.add('bg-element-bg', 'text-gray-300', 'border-element-border-medium');
        }, 2500);
      }).catch(err => {
        console.error('Failed to copy: ', err);
      });
    });
  }
</script>
