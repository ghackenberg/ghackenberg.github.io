---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import ServiceModuleCard from "@components/ServiceModuleCard.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import TagChip from "@components/TagChip.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const allModules = await getCollection("modules");
const serviceModules = allModules
  .filter((m) => m.data.serviceId === service.id)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const serviceUrl = `https://hackenberg.tech/services/${service.id}/`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${serviceUrl}#service`,
  "name": service.data.title,
  "serviceType": service.data.title,
  "description": service.data.description,
  "image": service.data.previewImage ? new URL(service.data.previewImage.src.src, Astro.site).href : undefined,
  "url": serviceUrl,
  "provider": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech"
  },
  "areaServed": "Global"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://hackenberg.tech/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.data.title,
      "item": serviceUrl
    }
  ]
};

const serviceJsonLd = [serviceSchema, breadcrumbSchema];
---

<Layout 
  title={`${service.data.title} | Dr. Georg Hackenberg`} 
  description={service.data.description}
  image={service.data.previewImage}
  tags={service.data.tags}
  jsonLd={serviceJsonLd}
>
  <Navbar />

  <!-- Section 1: Service Overview -->
  <Section id="service-overview" padding="standard">
    <Container size="reading" padding="none">
      <!-- Breadcrumbs Navigation -->
      <Breadcrumbs 
        items={[
          { label: "Home", href: "/" },
          { label: "Services", href: "/services/" },
          { label: service.data.title }
        ]}
        domain="services"
      />

      <!-- Header -->
      <header class="mb-12 relative">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
          {service.data.title}
        </h1>
        <p class="text-gray-300 text-base sm:text-lg max-w-3xl leading-relaxed font-normal">
          {service.data.description}
        </p>

        {service.data.tags && service.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4 mb-2">
            {service.data.tags.map((tag) => (
              <TagChip tag={tag} />
            ))}
          </div>
        )}
      </header>

      <div class="glass-card p-8 md:p-10 rounded-3xl border border-element-border service-content prose-custom">
        <Content />

        {service.data.guidingPrinciples && service.data.guidingPrinciples.length > 0 && (
          <div class="mt-10">
            <h2 id="guiding-principles" class="text-xl md:text-2xl font-bold tracking-tight text-gray-100 border-b border-element-border pb-2 mb-4">
              Guiding Principles
            </h2>
            <ul class="space-y-2">
              {service.data.guidingPrinciples.map(principle => (
                <li>
                  <strong class="text-gray-100 font-semibold">{principle.title}:</strong> {principle.description}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </Container>
  </Section>

  <!-- Section 2: Service Modules -->
  <Section id="service-modules" border="top" padding="standard">
    <Container size="wide" padding="none">
      <div class="mb-8 md:mb-12">
        <h2 id="service-modules-heading" class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-4">
          Service <span class="text-domain-services">Modules</span>
        </h2>
        <p class="text-gray-400 text-sm md:text-base max-w-2xl leading-relaxed font-normal">
          Each service module represents a concrete building block that can be booked individually or combined into a comprehensive custom package.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {serviceModules.map((module) => (
          <ServiceModuleCard serviceId={service.id} module={module} />
        ))}
      </div>
    </Container>
  </Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="services" 
    currentId={service.id} 
    tags={service.data.tags} 
  />
</Layout>

<style>
  /* Markdown content styling for service layouts */
  .service-content :global(p) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
    transition: color 0.5s ease;
  }
  .service-content :global(li strong) {
    color: var(--color-text-heading);
    transition: color 0.5s ease;
  }
  .service-content :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>
