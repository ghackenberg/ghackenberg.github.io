---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import ServiceModuleCard from "@components/ServiceModuleCard.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const allModules = await getCollection("modules");
const serviceModules = allModules
  .filter((m) => m.data.serviceId === service.id)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const colorClasses = {
  text: 'text-brand-purple light:text-purple-700',
  border: 'border-brand-purple/20 light:border-purple-200',
  bg: 'bg-brand-purple/10 light:bg-purple-50/50'
};

const serviceUrl = `https://hackenberg.tech/services/${service.id}/`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${serviceUrl}#service`,
  "name": service.data.title,
  "serviceType": service.data.title,
  "description": service.data.description,
  "image": service.data.previewImage ? new URL(service.data.previewImage.src.src, Astro.site).href : undefined,
  "url": serviceUrl,
  "provider": {
    "@type": "Person",
    "name": "Dr. Georg Hackenberg",
    "url": "https://hackenberg.tech"
  },
  "areaServed": "Global"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://hackenberg.tech/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.data.title,
      "item": serviceUrl
    }
  ]
};

const serviceJsonLd = [serviceSchema, breadcrumbSchema];
---

<Layout 
  title={`${service.data.title} | Dr. Georg Hackenberg`} 
  description={service.data.description}
  image={service.data.previewImage}
  tags={service.data.tags}
  jsonLd={serviceJsonLd}
>
  <Navbar />

  <!-- Section 1: Service Overview -->
  <Section id="service-overview" padding="standard">
    <Container size="wide" padding="none">
      <!-- Back Button -->
      <a 
        href="/services/" 
        class="inline-flex items-center space-x-2 text-xs font-semibold px-4 py-2 rounded-xl bg-brand-purple/10 border border-brand-purple/20 hover:border-brand-purple/30 text-brand-purple transition-all mb-8 cursor-pointer"
      >
        <span>&larr;</span>
        <span>Back to Services</span>
      </a>

      <!-- Header -->
      <header class="mb-12 relative">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
          {service.data.title}
        </h1>
        <p class="text-gray-300 text-base sm:text-lg max-w-3xl leading-relaxed font-normal">
          {service.data.description}
        </p>

        {service.data.tags && service.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4 mb-2">
            {service.data.tags.map((tag) => (
              <a
                href={`/tags/${tag}/`}
                class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border transition-all duration-200 hover:scale-105 ${colorClasses.bg} ${colorClasses.border} ${colorClasses.text}`}
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mt-8">
        <!-- Main Content (Column 1) -->
        <div class="lg:col-span-8">
          <div class="glass-card p-8 md:p-10 rounded-3xl border border-element-border service-content theme-purple prose-custom">
            <Content />
          </div>
        </div>

        <!-- Sidebar (Column 2) -->
        <aside class="lg:col-span-4 space-y-8 lg:sticky lg:top-24">
          <!-- Service Info Card -->
          <div class="glass-card p-6 rounded-2xl border border-element-border flex flex-col relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-purple"></div>
            <h3 class="text-lg font-bold mb-4 flex items-center space-x-2">
              <span>ℹ️</span>
              <span>Service Info</span>
            </h3>
            <div class="space-y-4 mb-6">
              <div>
                <p class="text-[10px] text-gray-500 light:text-slate-600 font-extrabold uppercase tracking-widest mb-1">Delivery Model</p>
                <p class="text-sm text-gray-300 font-semibold leading-tight">Advisory & Hands-on Implementation</p>
              </div>
              <div>
                <p class="text-[10px] text-gray-500 light:text-slate-600 font-extrabold uppercase tracking-widest mb-1">Available Modules</p>
                <p class="text-sm text-gray-300 font-semibold leading-tight">{serviceModules.length} Specialized Building Blocks</p>
              </div>
            </div>
            <a 
              href="#service-modules"
              class="w-full py-3 px-4 rounded-xl text-center text-xs font-semibold bg-brand-purple/10 border border-brand-purple/20 text-brand-purple hover:bg-brand-purple/20 transition-all flex items-center justify-center space-x-2 cursor-pointer"
            >
              <span>Explore Modules</span>
              <span>↓</span>
            </a>
          </div>

          <!-- Direct Inquiry Card -->
          <div class="glass-card p-6 rounded-2xl border border-element-border flex flex-col relative overflow-hidden">
            <h3 class="text-lg font-bold mb-2 flex items-center space-x-2">
              <span>💬</span>
              <span>Quick Inquiry</span>
            </h3>
            <p class="text-xs text-gray-400 leading-relaxed mb-4">
              Direct advisory, custom bundles, and corporate workshop formats tailored to your tech stack.
            </p>
            <a 
              href={`mailto:georg.hackenberg@fh-wels.at?subject=${encodeURIComponent(`Services Inquiry: ${service.data.title}`)}`}
              class="w-full py-3 px-4 rounded-xl text-center text-xs font-bold bg-brand-purple hover:bg-brand-purple/90 text-white shadow-lg shadow-brand-purple/20 transition-all flex items-center justify-center space-x-2 cursor-pointer"
            >
              <span>Send Email Inquiry</span>
              <span>↗</span>
            </a>
          </div>
        </aside>
      </div>
    </Container>
  </Section>

  <!-- Section 2: Service Modules -->
  <Section id="service-modules" border="top" padding="standard">
    <Container size="wide" padding="none">
      <div class="mb-8 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-100 mb-4">
          Service <span class="heading-gradient-purple">Modules</span>
        </h2>
        <p class="text-gray-400 text-sm md:text-base max-w-2xl leading-relaxed font-normal">
          Each service module represents a concrete building block that can be booked individually or combined into a comprehensive custom package.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {serviceModules.map((module) => (
          <ServiceModuleCard serviceId={service.id} module={module} />
        ))}
      </div>
    </Container>
  </Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="services" 
    currentId={service.id} 
    tags={service.data.tags} 
  />
</Layout>

<style>
  /* Markdown content styling for service layouts */
  .service-content :global(h2) {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-heading);
    margin-top: 1.85rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 0.35rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .service-content :global(h2:first-child) {
    margin-top: 0;
  }
  .service-content :global(h3) {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    transition: color 0.5s ease;
  }
  .service-content :global(p) {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
    transition: color 0.5s ease;
  }
  .service-content :global(p:first-of-type) {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-text-heading);
    border-left: 3px solid var(--glow-text, #a855f7);
    padding-left: 1rem;
    margin-bottom: 1.5rem;
    transition: color 0.5s ease, border-color 0.5s ease;
  }
  .service-content :global(ul),
  .service-content :global(ol) {
    list-style-type: none;
    padding-left: 0;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .service-content :global(ol) {
    counter-reset: service-counter;
  }
  .service-content :global(li) {
    margin-bottom: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: 0.85rem 1rem 0.85rem 2.25rem;
    border-radius: 12px;
    position: relative;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  :global(.light) .service-content :global(li) {
    background: rgba(15, 23, 42, 0.02);
    border-color: rgba(15, 23, 42, 0.06);
  }
  .service-content :global(li:hover) {
    border-color: rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  :global(.light) .service-content :global(li:hover) {
    background: rgba(15, 23, 42, 0.04);
    border-color: rgba(15, 23, 42, 0.1);
  }
  .service-content :global(li::before) {
    content: "→";
    position: absolute;
    left: 1rem;
    top: 0.85rem;
    line-height: 1.6;
    color: var(--glow-text, #a855f7);
    font-weight: bold;
  }
  .service-content :global(ol > li) {
    counter-increment: service-counter;
  }
  .service-content :global(ol > li::before) {
    content: counter(service-counter) ".";
  }
  .service-content :global(li strong) {
    color: var(--color-text-heading);
    transition: color 0.5s ease;
  }
  .service-content :global(> *:last-child) {
    margin-bottom: 0;
  }

  .theme-purple { --glow-text: #c084fc; }
  :global(.light) .theme-purple { --glow-text: #7e22ce; }
</style>
