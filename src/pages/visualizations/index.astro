---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection } from "astro:content";
import VisualizationCard from "../../components/VisualizationCard.astro";

const visualizations = await getCollection("visualizations");
const firstVisScreenshot = visualizations.find(v => v.data.screenshot)?.data.screenshot;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Visualizations",
      "item": "https://hackenberg.tech/visualizations/"
    }
  ]
};
---

<Layout 
  title="Content Visualizations | Dr. Georg Hackenberg" 
  description="Explore interactive real-time knowledge graphs, network diagrams, and WebGL visualizations connecting research, software projects, and topics."
  image={firstVisScreenshot}
  jsonLd={breadcrumbSchema}
>
  <Navbar />

  <main class="flex-grow max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-20 w-full relative z-10">
    <div class="mb-12">

      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 mb-6">
        Content <span class="heading-gradient-green">Visualizations</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Explore the relationships between software projects, blog posts, research publications, university courses, business services, and topic tags. These interactive graphs are rendered in real-time using different graph engines.
      </p>
    </div>

    <!-- Visualizations Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {visualizations.map(vis => (
        <VisualizationCard
          title={vis.data.title}
          description={vis.data.description}
          href={`/visualizations/${vis.id}/`}
          screenshot={vis.data.screenshot}
          tags={vis.data.tags}
        />
      ))}
    </div>
  </main>
</Layout>

