---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import { getCollection } from "astro:content";
import VisualizationCard from "@components/VisualizationCard.astro";
import FilterToolbar from "@components/FilterToolbar.astro";
import CatalogPreFilter from "@components/CatalogPreFilter.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { buildCollectionPageSchema } from "@commons/server/json-ld";

const visualizations = await getCollection("visualizations");

// Extract unique tags from all visualizations
const tagsSet = new Set<string>();
for (const vis of visualizations) {
  if (vis.data.tags) {
    vis.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();
const itemTags = visualizations.map(v => (v.data.tags || []).map(t => t.toLowerCase()));

const firstVisScreenshot = visualizations.find(v => v.data.image)?.data.image;

---

<Layout 
  title="Content Visualizations | Dr. Georg Hackenberg" 
  description="Explore interactive real-time knowledge graphs, network diagrams, and WebGL visualizations connecting research, software projects, and topics."
  image={firstVisScreenshot}
  jsonLd={buildCollectionPageSchema("visualizations", visualizations.map((v) => ({ id: v.id })))}
>
  <Navbar />

  <Container size="wide">
    <Breadcrumbs domain="visualizations" />

    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-6">
        Content <span class="text-domain-visualizations">Visualizations</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Interactive knowledge graphs exploring cross-content relationships between articles, publications, projects, and courses rendered in real time.
      </p>
    </div>

    <!-- Filter Toolbar -->
    <FilterToolbar
      searchId="visualization-search"
      searchPlaceholder="Search visualizations..."
      tags={allTags}
      domain="visualizations"
      itemTags={itemTags}
      totalCount={visualizations.length}
      pageSize={12}
    />

    <!-- Visualizations Grid (3-2-1) -->
    {visualizations.length === 0 ? (
      <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No visualizations found.</p>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="visualizations-grid">
          {visualizations.map(vis => {
            const tagsJoined = (vis.data.tags || []).join(" ").toLowerCase();
            return (
              <div 
                class="visualization-card-item h-full"
                data-title={vis.data.title.toLowerCase()}
                data-desc={(vis.data.description || "").toLowerCase()}
                data-tags={tagsJoined}
              >
                <VisualizationCard
                  title={vis.data.title}
                  description={vis.data.description}
                  href={`/visualizations/${vis.id}/`}
                  image={vis.data.image}
                  tags={vis.data.tags}
                />
              </div>
            );
          })}
        </div>

        <CatalogPreFilter
          itemSelector=".visualization-card-item"
          noResultsId="no-visualizations-message"
        />
      </>
    )}

    <p id="no-visualizations-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
      No visualizations match your selected filter criteria.
    </p>
  </Container>
</Layout>

<script>
  import { ClientListFilter } from "@commons/client/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".visualization-card-item",
      searchFieldSelector: "#visualization-search",
      searchDataAttributes: ["data-title", "data-desc", "data-tags"],
      searchParamKey: "q",
      resetButtonSelector: "#visualization-search-reset",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag",
          multiple: true
        }
      ],
      scrollToSelector: "#visualizations-grid",
      noResultsSelector: "#no-visualizations-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>
