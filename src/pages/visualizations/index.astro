---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import { getCollection } from "astro:content";
import VisualizationCard from "@components/VisualizationCard.astro";
import FilterToolbar from "@components/FilterToolbar.astro";

const visualizations = await getCollection("visualizations");

// Extract unique tags from all visualizations
const tagsSet = new Set<string>();
for (const vis of visualizations) {
  if (vis.data.tags) {
    vis.data.tags.forEach(tag => tagsSet.add(tag));
  }
}
const allTags = Array.from(tagsSet).sort();
const itemTags = visualizations.map(v => (v.data.tags || []).map(t => t.toLowerCase()));

const firstVisScreenshot = visualizations.find(v => v.data.screenshot)?.data.screenshot;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Visualizations",
      "item": "https://hackenberg.tech/visualizations/"
    }
  ]
};
---

<Layout 
  title="Content Visualizations | Dr. Georg Hackenberg" 
  description="Explore interactive real-time knowledge graphs, network diagrams, and WebGL visualizations connecting research, software projects, and topics."
  image={firstVisScreenshot}
  jsonLd={breadcrumbSchema}
>
  <Navbar />

  <Container size="wide">
    <div class="mb-12">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-100 mb-6">
        Content <span class="heading-gradient-green">Visualizations</span>
      </h1>
      <p class="text-gray-400 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
        Explore the relationships between technical blog posts, research publications, presentations, university courses, software projects, business services, and topic tags. These interactive graphs are rendered in real-time using different graph engines.
      </p>
    </div>

    <!-- Filter Toolbar -->
    <FilterToolbar
      searchId="visualization-search"
      searchPlaceholder="Search visualizations..."
      tags={allTags}
      accentColor="green"
      itemTags={itemTags}
      totalCount={visualizations.length}
      pageSize={12}
    />

    <!-- Pre-filter state gate: activate has-filter-query if URL params exist -->
    <script is:inline>
      (function() {
        var params = new URLSearchParams(window.location.search);
        var rawTags = params.getAll('tag');
        var hasTag = rawTags.some(function(t) { return t.trim().length > 0; });
        var hasQ = Boolean((params.get('q') || '').trim());
        if (hasTag || hasQ) {
          document.documentElement.classList.add('has-filter-query');
        }
      })();
    </script>

    <!-- Visualizations Grid (3-2-1) -->
    {visualizations.length === 0 ? (
      <p class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl">No visualizations found.</p>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="visualizations-grid">
          {visualizations.map(vis => {
            const tagsJoined = (vis.data.tags || []).join(" ").toLowerCase();
            return (
              <div 
                class="visualization-card-item h-full"
                data-title={vis.data.title.toLowerCase()}
                data-desc={(vis.data.description || "").toLowerCase()}
                data-tags={tagsJoined}
              >
                <VisualizationCard
                  title={vis.data.title}
                  description={vis.data.description}
                  href={`/visualizations/${vis.id}/`}
                  screenshot={vis.data.screenshot}
                  tags={vis.data.tags}
                />
              </div>
            );
          })}
        </div>

        <!-- Instant Pre-filter Script (Eliminates FOUC/Flicker before First Paint) -->
        <script is:inline>
          (function() {
            try {
              var params = new URLSearchParams(window.location.search);
              var rawTags = params.getAll('tag');
              var tags = rawTags.flatMap(function(v) { return v.split(','); }).map(function(s) { return s.trim().toLowerCase(); }).filter(Boolean);
              var q = (params.get('q') || '').trim().toLowerCase();

              var hasTag = tags.length > 0;
              var hasQ = Boolean(q);

              if (!hasTag && !hasQ) return;

              var items = document.querySelectorAll('.visualization-card-item');
              var matching = [];

              items.forEach(function(item) {
                var itemTags = (item.getAttribute('data-tags') || '').toLowerCase().split(/[\s,]+/);
                var title = item.getAttribute('data-title') || '';
                var desc = item.getAttribute('data-desc') || '';
                var tagsStr = item.getAttribute('data-tags') || '';

                var matchesTag = !hasTag || tags.every(function(t) { return itemTags.indexOf(t) !== -1; });
                var matchesQ = !hasQ || (title.indexOf(q) !== -1 || desc.indexOf(q) !== -1 || tagsStr.indexOf(q) !== -1);

                if (matchesTag && matchesQ) {
                  matching.push(item);
                  item.classList.add('is-matched');
                  item.classList.remove('hidden');
                  item.style.display = '';
                } else {
                  item.classList.remove('is-matched');
                  item.classList.add('hidden');
                  item.style.display = 'none';
                }
              });

              var noResults = document.getElementById('no-visualizations-message');
              if (noResults) {
                if (matching.length === 0) {
                  noResults.classList.remove('hidden');
                  noResults.style.display = '';
                } else {
                  noResults.classList.add('hidden');
                  noResults.style.display = 'none';
                }
              }

              var countEl = document.querySelector('[data-tag-total], [data-tag-count]');
              if (countEl && (hasTag || hasQ)) {
                var availTags = new Set();
                matching.forEach(function(item) {
                  var itags = (item.getAttribute('data-tags') || '').toLowerCase().split(/[\s,]+/);
                  itags.forEach(function(t) { if (t) availTags.add(t); });
                });
                countEl.textContent = String(matching.length > 0 ? availTags.size : 0);
                countEl.classList.add('is-synced');
              }
            } catch(e) {}
          })();
        </script>
      </>
    )}

    <p id="no-visualizations-message" class="text-gray-500 font-medium py-12 text-center glass-card rounded-2xl hidden">
      No visualizations match your selected filter criteria.
    </p>
  </Container>
</Layout>

<script>
  import { ClientListFilter } from "@commons/client/filter";

  function initFilter() {
    new ClientListFilter({
      itemSelector: ".visualization-card-item",
      searchFieldSelector: "#visualization-search",
      searchDataAttributes: ["data-title", "data-desc", "data-tags"],
      searchParamKey: "q",
      resetButtonSelector: "#visualization-search-reset",
      buttonFilters: [
        {
          buttonSelector: ".tag-filter-btn",
          dataAttribute: "data-tags",
          defaultValue: "all",
          activeClass: "active",
          matchType: "includes",
          paramKey: "tag",
          multiple: true
        }
      ],
      scrollToSelector: "#visualizations-grid",
      noResultsSelector: "#no-visualizations-message"
    });
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>
