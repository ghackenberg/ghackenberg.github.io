---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import GetInTouchCard from "@components/GetInTouchCard.astro";
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";

export async function getStaticPaths() {
  const visualizations = await getCollection("visualizations");
  return visualizations.map(vis => ({
    params: { slug: vis.id },
    props: { vis }
  }));
}

const { vis } = Astro.props;
const type = vis.id;
const title = vis.data.title;
const description = vis.data.description;
const screenshot = vis.data.screenshot;

const { Content } = await render(vis);

const screenshotImg = screenshot ? (typeof screenshot === 'object' && 'src' in screenshot ? screenshot.src : screenshot) : null;
const optimizedScreenshot = screenshotImg ? await getImage({
  src: screenshotImg,
  format: 'webp',
  width: 1200,
  quality: 85
}) : null;

import { buildGraphPayload } from "@commons/shared/graph-payload.js";

const posts = await getCollection("posts");
const publications = await getCollection("publications");
const presentations = await getCollection("presentations");
const projects = await getCollection("projects");
const courses = await getCollection("courses");
const services = await getCollection("services");
const tags = await getCollection("tags");

const payload = await buildGraphPayload({
  posts,
  publications,
  presentations,
  projects,
  courses,
  services,
  tags,
  getImage
});

const engineFactsMap: Record<string, { renderer: string; dimensions: string; layouts: string }> = {
  '3d-force': {
    renderer: 'WebGL 2.0 & Three.js',
    dimensions: '3D Volumetric Coordinate Space',
    layouts: 'Force-Directed, Concentric, Columns'
  },
  cytoscape: {
    renderer: 'HTML5 Canvas (2D)',
    dimensions: '2D Planar Graph Space',
    layouts: 'Organic Force, Concentric Rings, Columns'
  },
  d3: {
    renderer: 'Scalable Vector Graphics (SVG)',
    dimensions: '2D Vector Coordinate System',
    layouts: 'Velocity Verlet Physics, Radial, Columns'
  },
  sigma: {
    renderer: 'WebGL (Hardware-Accelerated 2D)',
    dimensions: '2D Planar Graph Space',
    layouts: 'Worker-Offloaded Force, Radial, Columns'
  },
  'vis-network': {
    renderer: 'HTML5 Canvas (2D)',
    dimensions: '2D Planar Coordinate System',
    layouts: 'Barnes-Hut Simulation, Hierarchical, Repulsion'
  }
};

const facts = engineFactsMap[vis.id] || {
  renderer: 'HTML5 Canvas & JavaScript',
  dimensions: 'Interactive Coordinate System',
  layouts: 'Dynamic Layout Presets'
};

const nodeCount = payload.d3?.nodes?.length || (posts.length + publications.length + presentations.length + projects.length + courses.length + services.length + tags.length);
const edgeCount = payload.d3?.connections?.length || payload['vis-network']?.connections?.length || 0;

const visUrl = `https://hackenberg.tech/visualizations/${vis.id}/`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hackenberg.tech"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Visualizations",
      "item": "https://hackenberg.tech/visualizations/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": visUrl
    }
  ]
};
---

<Layout 
  title={`${title} | Dr. Georg Hackenberg`} 
  description={description || `An interactive network diagram mapping the connections between posts, publications, presentations, courses, projects, services, and topic tags on Dr. Georg Hackenberg's website using ${title}.`}
  image={screenshot || optimizedScreenshot?.src}
  jsonLd={breadcrumbSchema}
>
  <Navbar />

  <Section id="visualization-content" padding="standard">
    <Container size="wide" padding="none">
      <!-- Back Button -->
    <a 
      href="/visualizations/" 
      class="inline-flex items-center space-x-2 text-xs font-semibold px-4 py-2 rounded-xl bg-brand-green/10 border border-brand-green/20 hover:border-brand-green/30 text-brand-green transition-all mb-8 cursor-pointer self-start"
    >
      <span>&larr;</span>
      <span>Back to Visualizations</span>
    </a>

    <!-- Title Header -->
    <header class="mb-12 relative">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
        {title}
      </h1>
      {description && (
        <p class="text-gray-300 text-base sm:text-lg max-w-3xl leading-relaxed font-normal">
          {description}
        </p>
      )}
      {vis.data.tags && vis.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-6">
          {vis.data.tags.map((tag: string) => (
            <a
              href={`/tags/${tag}/`}
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border transition-all duration-200 hover:scale-105 bg-brand-green/10 border-brand-green/20 text-brand-green hover:bg-brand-green/20 hover:border-brand-green/30"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="flex-grow w-full relative min-h-[500px] h-[70vh] md:h-[calc(100vh-320px)] rounded-3xl border border-element-border glass-card hover:transform-none overflow-hidden shadow-2xl mb-12">
      <!-- Floating Glassmorphic Legend (Positioned top-left, responsive on mobile & desktop) -->
      <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-20 max-w-[calc(100%-1.5rem)] flex flex-wrap items-center gap-3 sm:gap-5 px-3.5 py-2 rounded-2xl bg-gray-950/60 light:bg-white/80 backdrop-blur-md border border-white/10 light:border-slate-200/80 shadow-md text-xs pointer-events-none select-none">
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-sky-400 border border-white/20 shadow-sm shadow-sky-400/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Tags</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-blue border border-white/20 shadow-sm shadow-brand-blue/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Posts</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 border border-white/20 shadow-sm shadow-indigo-500/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Publications</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-500 border border-white/20 shadow-sm shadow-cyan-500/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Presentations</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-yellow border border-white/20 shadow-sm shadow-brand-yellow/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Courses</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-green border border-white/20 shadow-sm shadow-brand-green/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Projects</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-purple border border-white/20 shadow-sm shadow-brand-purple/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Services</span>
        </div>
      </div>

      <!-- Floating Controls: Layout Dropdown Selector -->
      <div 
        id="layout-control-container"
        class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 z-20 flex items-center space-x-2 px-3 py-1.5 rounded-xl bg-gray-950/70 light:bg-white/90 backdrop-blur-md border border-white/10 light:border-slate-200 shadow-md text-xs"
      >
        <label for="layout-selector" class="flex items-center space-x-1.5 text-gray-400 light:text-slate-500 font-medium select-none">
          <svg class="w-3.5 h-3.5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <span>Layout:</span>
        </label>
        <div class="relative flex items-center">
          <select 
            id="layout-selector"
            aria-label="Select layout"
            class="bg-transparent text-gray-200 light:text-slate-800 font-semibold text-[11px] sm:text-xs cursor-pointer focus:outline-none appearance-none pr-5 py-0.5"
          >
            <!-- Options will be populated dynamically by the engine -->
          </select>
          <div class="absolute right-0 flex items-center pointer-events-none text-gray-400 light:text-slate-500">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Render Loading Placeholder -->
      <div id="canvas-loading" class="absolute inset-0 flex items-center justify-center bg-gray-950/80 z-30 transition-opacity duration-300">
        <div class="flex flex-col items-center space-y-4">
          <div class="w-8 h-8 rounded-full border-2 border-brand-green/20 border-t-brand-green animate-spin"></div>
          <span class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Loading Network Graph...</span>
        </div>
      </div>

      <!-- Graph Rendering Canvas -->
      <div id="canvas" class="w-full h-full relative"></div>
    </div>
  </Container>

  <Container size="wide" padding="none" class="mt-12 md:mt-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
      <!-- Main Content (Column 1 - Article / Documentation) -->
      <div class="lg:col-span-8">
        <article class="glass-card p-8 md:p-10 rounded-3xl border border-element-border visualization-details prose-custom">
          <Content />
        </article>
      </div>

      <!-- Aside Metadata / Key Facts (Column 2) -->
      <aside class="lg:col-span-4 space-y-8 lg:sticky lg:top-24">
        <!-- Engine Specs Card -->
        <div class="glass-card p-6 rounded-2xl border border-element-border flex flex-col relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-brand-green to-emerald-400"></div>

          <h3 class="text-lg font-bold mb-4 flex items-center space-x-2">
            <span>📊</span>
            <span>Engine Specs</span>
          </h3>

          <div class="space-y-4 mb-6">
            <div>
              <p class="text-[10px] text-gray-500 light:text-slate-600 font-extrabold uppercase tracking-widest mb-1">Renderer & Stack</p>
              <p class="text-sm text-gray-300 font-semibold leading-tight">{facts.renderer}</p>
            </div>
            <div>
              <p class="text-[10px] text-gray-500 light:text-slate-600 font-extrabold uppercase tracking-widest mb-1">Space Topology</p>
              <p class="text-sm text-gray-300 font-semibold leading-tight">{facts.dimensions}</p>
            </div>
            <div>
              <p class="text-[10px] text-gray-500 light:text-slate-600 font-extrabold uppercase tracking-widest mb-1">Graph Dimensions</p>
              <p class="text-sm text-gray-300 font-semibold leading-tight">{nodeCount} Entities · {edgeCount} Connections</p>
            </div>
            <div>
              <p class="text-[10px] text-gray-500 light:text-slate-600 font-extrabold uppercase tracking-widest mb-1">Layout Presets</p>
              <p class="text-sm text-gray-300 font-semibold leading-tight">{facts.layouts}</p>
            </div>
          </div>

          <a 
            href="/posts/2026_05_27_interactive_graph_visualizations_update/"
            class="w-full py-3 px-4 rounded-xl text-center text-xs font-semibold bg-brand-green/10 border border-brand-green/20 text-brand-green hover:bg-brand-green/20 transition-all flex items-center justify-center space-x-2 cursor-pointer"
          >
            <span>Read Architecture Benchmark</span>
            <span>↗</span>
          </a>
        </div>

        <!-- Topics & Technologies Card -->
        {vis.data.tags && vis.data.tags.length > 0 && (
          <div class="glass-card p-6 rounded-2xl border border-element-border">
            <h3 class="text-lg font-bold mb-4 flex items-center space-x-2">
              <span>🏷️</span>
              <span>Technologies</span>
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {vis.data.tags.map((tag: string) => (
                <a
                  href={`/tags/${tag}/`}
                  class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border transition-all duration-200 hover:scale-105 bg-brand-green/10 border-brand-green/20 text-brand-green hover:bg-brand-green/20"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <!-- Contact Section -->
    <GetInTouchCard
      sectionHeading="Start a Conversation"
      sectionDescription="Want to explore custom graph algorithms, WebGL performance, or interactive data visualizers for your organization? Feel free to reach out directly via email."
      cardHeading="Visualization & Data Model Inquiry"
      emailSubject={`Visualization Inquiry: ${vis.data.title}`}
      accentColor="green"
      primaryButtonText="Open Email Client"
    />
  </Container>
  </Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="visualizations" 
    currentId={vis.id} 
    tags={vis.data.tags || []} 
  />

  <!-- Expose Astro variables to global scope for client script -->
  <script is:inline define:vars={{ type, payload }}>
    window.GRAPH_TYPE = type;
    window.GRAPH_PAYLOAD = payload;
  </script>

  <!-- Inject Graph Boot Scripts -->
  <script>
    interface VisNetworkNode {
      id: string;
      name: string;
      size: number;
      group: number;
      typeLabel?: string;
      description?: string;
      date?: string;
      image?: string;
      tags?: string[];
    }

    interface GraphPayload {
      cytoscape?: { elements: { data: Record<string, string | number | undefined> }[] };
      d3?: { nodes: { id: string; name: string; size: number; group: number }[]; connections: { sourceId: string; targetId: string }[] };
      sigma?: { nodes: { id: string; label: string; x: number; y: number; size: number; group: number; color: string }[]; edges: { id: string; source: string; target: string; color?: string }[] };
      '3d-force'?: { nodes: { id: string; name: string; size: number; group: number }[]; connections: { sourceId: string; targetId: string }[] };
      'vis-network'?: { nodes: VisNetworkNode[]; connections: { sourceId: string; targetId: string }[] };
    }

    interface GraphInstance {
      destroy(): void;
      updateLayout(layout: string, isLight: boolean): void;
      layouts: { id: string; label: string }[];
    }

    interface GraphEngine {
      layouts: { id: string; label: string }[];
      init(container: HTMLElement, payload: GraphPayload, layout: string, isLight: boolean, extraOptions?: Record<string, string>): Promise<GraphInstance>;
    }

    declare global {
      interface Window {
        GRAPH_TYPE: string;
        GRAPH_PAYLOAD: GraphPayload;
        activeInstance: GraphInstance | null;
      }
    }

    const type = window.GRAPH_TYPE;
    const payload = window.GRAPH_PAYLOAD;

    function onReady(fn: () => void) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fn);
      } else {
        fn();
      }
    }

    onReady(() => {
      const container = document.getElementById('canvas');
      const loading = document.getElementById('canvas-loading');
      const selector = document.getElementById('layout-selector') as HTMLSelectElement | null;
      if (!container) return;

      let activeInstance: GraphInstance | null = null;

      async function runInit() {
        if (!container) return;
        if (activeInstance) {
          if (typeof activeInstance.destroy === 'function') {
            activeInstance.destroy();
          }
          activeInstance = null;
        }
        if (container) {
          container.innerHTML = '';
        }

        try {
          let engineModule;
          switch (type) {
            case 'cytoscape':
              engineModule = await import('../../content/visualizations/cytoscape/engine.ts');
              break;
            case 'd3':
              engineModule = await import('../../content/visualizations/d3/engine.ts');
              break;
            case 'sigma':
              engineModule = await import('../../content/visualizations/sigma/engine.ts');
              break;
            case '3d-force':
              engineModule = await import('../../content/visualizations/3d-force/engine.ts');
              break;
            case 'vis-network':
              engineModule = await import('../../content/visualizations/vis-network/engine.ts');
              break;
            default:
              throw new Error(`Unknown visualization type: ${type}`);
          }

          const engine = engineModule.default as GraphEngine;
          
          // Determine layout from query parameters
          const params = new URLSearchParams(window.location.search);
          let currentLayout = params.get('layout');
          
          // Verify layout is supported by the engine, else fallback to default
          const supportsLayout = engine.layouts.some((l: { id: string }) => l.id === currentLayout);
          if (!currentLayout || !supportsLayout) {
            currentLayout = engine.layouts[0].id;
          }

          // Populate the layout dropdown
          if (selector) {
            const isLightMode = document.documentElement.classList.contains('light');
            selector.innerHTML = '';
            engine.layouts.forEach((l: { id: string; label: string }) => {
              const option = document.createElement('option');
              option.value = l.id;
              option.textContent = l.label;
              option.style.backgroundColor = isLightMode ? '#ffffff' : '#030712';
              option.style.color = isLightMode ? '#0f172a' : '#ffffff';
              selector.appendChild(option);
            });
            selector.value = currentLayout;
          }

          // Initialize engine with UTM tracking
          const isLight = document.documentElement.classList.contains('light');
          activeInstance = await engine.init(container, payload, currentLayout, isLight, {
            utmSource: 'visualizations_demo',
            utmMedium: type,
            utmCampaign: 'interactive_visualization'
          });
          window.activeInstance = activeInstance;

        } catch (e) {
          console.error("Failed to load visualization: ", e);
        }
      }

      // Initialize on load
      setTimeout(async () => {
        await runInit();
        if (loading) {
          loading.style.opacity = '0';
          setTimeout(() => loading.remove(), 300);
        }
      }, 100);

      // Handle layout change
      if (selector) {
        selector.addEventListener('change', (e) => {
          const newLayout = (e.target as HTMLSelectElement).value;
          if (activeInstance) {
            const url = new URL(window.location.href);
            url.searchParams.set('layout', newLayout);
            window.history.pushState({}, '', url.toString());
            
            const isLight = document.documentElement.classList.contains('light');
            activeInstance.updateLayout(newLayout, isLight);
          }
        });
      }

      // Handle theme change dynamically without reloading canvas
      window.addEventListener('theme-changed', () => {
        const isLight = document.documentElement.classList.contains('light');
        if (selector) {
          Array.from(selector.options).forEach((option) => {
            option.style.backgroundColor = isLight ? '#ffffff' : '#030712';
            option.style.color = isLight ? '#0f172a' : '#ffffff';
          });
        }
        if (activeInstance) {
          const params = new URLSearchParams(window.location.search);
          const currentLayout = params.get('layout') || activeInstance.layouts[0].id;
          activeInstance.updateLayout(currentLayout, isLight);
        }
      });
    });
  </script>
</Layout>

<style>
  /* Ensure canvas takes all available dimensions */
  #canvas {
    outline: none;
  }

  /* Style layout selector options */
  #layout-selector option {
    background: #030712;
    color: #f3f4f6;
  }
  :global(.light) #layout-selector option {
    background: #ffffff;
    color: #0f172a;
  }

  /* Typography for semantic visualization details */
  .visualization-details :global(h2) {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-heading);
    margin-top: 1rem;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
  }
  .visualization-details :global(h2:first-child) {
    margin-top: 0;
  }
  .visualization-details :global(h3) {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-heading);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .visualization-details :global(p) {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }
  .visualization-details :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-main);
  }
  .visualization-details :global(li) {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .visualization-details :global(a) {
    color: #3b82f6;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .visualization-details :global(a:hover) {
    color: #60a5fa;
  }
  .visualization-details :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.875rem;
  }
  .visualization-details :global(th) {
    text-align: left;
    padding: 0.75rem 1rem;
    background: var(--color-element-bg);
    border-bottom: 2px solid var(--color-border-subtle);
    font-weight: 700;
    color: var(--color-text-heading);
  }
  .visualization-details :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-main);
  }
  .visualization-details :global(tr:hover td) {
    background: rgba(255, 255, 255, 0.02);
  }
</style>
