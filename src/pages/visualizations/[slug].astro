---
import Layout from "@layouts/Layout.astro";
import { buildVisualizationSchema } from "@commons/server/json-ld";
import Navbar from "@components/Navbar.astro";
import Container from "@components/Container.astro";
import Section from "@components/Section.astro";
import RelatedContent from "@components/RelatedContent.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import TagChip from "@components/TagChip.astro";
import ConversionCallout from "@components/ConversionCallout.astro";
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";

export async function getStaticPaths() {
  const visualizations = await getCollection("visualizations");
  return visualizations.map(vis => ({
    params: { slug: vis.id },
    props: { vis }
  }));
}

const { vis } = Astro.props;
const type = vis.id;
const title = vis.data.title;
const description = vis.data.description;
const screenshot = vis.data.image;

const { Content } = await render(vis);

const screenshotImg = screenshot ? (typeof screenshot === 'object' && 'src' in screenshot ? screenshot.src : screenshot) : null;
const optimizedScreenshot = screenshotImg ? await getImage({
  src: screenshotImg,
  format: 'webp',
  width: 1200,
  quality: 85
}) : null;

import { getCanonicalGraphPayloadArtifact, getGraphPayloadEndpointUrl } from "@commons/server/graph-payload-endpoint";
import { getGraphLayoutEndpointUrl } from "@commons/server/graph-layout-endpoint";

const payloadArtifact = await getCanonicalGraphPayloadArtifact();
const payloadUrl = await getGraphPayloadEndpointUrl();
const layoutUrl = await getGraphLayoutEndpointUrl(type);


const engineSwitcherItems = [
  { id: "cytoscape", label: "Cytoscape.js", badge: "2D Canvas" },
  { id: "sigma", label: "Sigma.js", badge: "WebGL 2.0" },
  { id: "d3", label: "D3.js", badge: "SVG DOM" },
  { id: "vis-network", label: "Vis-Network", badge: "Spring 2D" },
  { id: "3d-force-graph", label: "3D Force", badge: "Three.js" },
];

const defaultLayouts = [
  { id: "force", label: "Force Directed (Organic)" },
  { id: "radial", label: "Concentric Rings (Tags → Items)" },
  { id: "columns", label: "Structured Columns (Category)" },
];

const vizSchema = buildVisualizationSchema({ visualization: vis, siteUrl: Astro.site?.origin || "https://hackenberg.tech" });
---

<Layout 
  title={`${title} | Dr. Georg Hackenberg`}
  description={description || `An interactive network diagram mapping the connections between posts, publications, presentations, courses, projects, services, and topic tags on Dr. Georg Hackenberg's website using ${title}.`}
  image={screenshot || optimizedScreenshot?.src}
  jsonLd={vizSchema}
>
  <Navbar />

  <Section id="visualization-content" padding="standard">
    <!-- Header in Reading Width -->
    <Container size="reading" padding="none">
      <!-- Breadcrumbs Navigation -->
      <Breadcrumbs 
        items={[
          { label: "Home", href: "/" },
          { label: "Visualizations", href: "/visualizations/" },
          { label: title }
        ]}
        domain="visualizations"
      />

      <header class="mb-12 relative">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight">
          {title}
        </h1>
        {description && (
          <p class="text-gray-300 text-base sm:text-lg max-w-3xl leading-relaxed font-normal">
            {description}
          </p>
        )}
        {vis.data.tags && vis.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {vis.data.tags.map((tag: string) => (
              <TagChip tag={tag} />
            ))}
          </div>
        )}
      </header>
    </Container>

    <!-- Canvas Viewport in Wide Width -->
    <Container size="wide" padding="none">
      <div
        class="visualization-viewport artifact-card flex-grow w-full min-w-0 relative min-h-[500px] rounded-3xl border border-element-border glass-card hover:transform-none overflow-hidden shadow-2xl flex flex-col"
        data-visualization-title={title}
      >
        <!-- Top Band: Engine Switcher + Layout Selector + Fullscreen Toggle -->
        <div class="artifact-card-header w-full flex items-center justify-between gap-2 sm:gap-3 px-3 sm:px-4 py-2">
          <!-- Desktop Engine Pill Switcher (lg+) -->
          <div class="hidden lg:flex items-center gap-2 min-w-0">
            <span class="artifact-card-badge mr-1 shrink-0">Engine</span>
            <nav aria-label="Compare graph engines" class="flex items-center gap-1.5 flex-wrap">
              {engineSwitcherItems.map((item) => {
                const isActive = item.id === type;
                return (
                  <a
                    href={`/visualizations/${item.id}/`}
                    aria-current={isActive ? "page" : undefined}
                    data-track-event="Visualization Engine Switched"
                    data-track-from={type}
                    data-track-to={item.id}
                    class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold border transition-colors ${
                      isActive
                        ? "bg-domain-visualizations/15 text-domain-visualizations border-domain-visualizations/40 shadow-sm"
                        : "bg-element-bg text-gray-300 light:text-slate-700 border-element-border hover:border-domain-visualizations/30 hover:text-domain-visualizations"
                    }`}
                  >
                    <span>{item.label}</span>
                    <span class="text-[10px] font-medium opacity-75 hidden xl:inline">({item.badge})</span>
                  </a>
                );
              })}
            </nav>
          </div>

          <!-- Responsive Controls Row: Engine Dropdown (< lg) + Layout Dropdown + Fullscreen Button -->
          <div class="artifact-card-controls w-full lg:w-auto flex items-center justify-between lg:justify-end gap-2 min-w-0">
            <!-- Smartphone Portrait & Tablet Engine Dropdown (< lg) -->
            <div
              id="engine-control-container"
              class="flex lg:hidden items-center gap-1.5 px-2.5 py-1 rounded-lg bg-element-bg border border-element-border text-xs flex-1 min-w-0 sm:flex-initial"
            >
              <label for="engine-selector" class="flex items-center gap-1 text-gray-400 light:text-slate-500 font-semibold select-none shrink-0">
                <svg class="w-3.5 h-3.5 text-domain-visualizations shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span class="hidden sm:inline">Engine:</span>
              </label>
              <div class="relative flex items-center flex-1 min-w-0">
                <select
                  id="engine-selector"
                  aria-label="Select graph engine"
                  class="w-full bg-transparent text-gray-200 light:text-slate-800 font-semibold text-[11px] sm:text-xs cursor-pointer focus:outline-none appearance-none pr-4 py-0.5 truncate"
                >
                  {engineSwitcherItems.map((item) => (
                    <option value={item.id} selected={item.id === type}>
                      {item.label} ({item.badge})
                    </option>
                  ))}
                </select>
                <div class="absolute right-0 flex items-center pointer-events-none text-gray-400 light:text-slate-500">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Layout Dropdown Selector -->
            <div
              id="layout-control-container"
              class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-element-bg border border-element-border text-xs flex-1 min-w-0 sm:flex-initial"
            >
              <label for="layout-selector" class="flex items-center gap-1 text-gray-400 light:text-slate-500 font-semibold select-none shrink-0">
                <svg class="w-3.5 h-3.5 text-domain-visualizations shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
                </svg>
                <span class="hidden sm:inline">Layout:</span>
              </label>
              <div class="relative flex items-center flex-1 min-w-0">
                <select
                  id="layout-selector"
                  aria-label="Select layout"
                  class="w-full bg-transparent text-gray-200 light:text-slate-800 font-semibold text-[11px] sm:text-xs cursor-pointer focus:outline-none appearance-none pr-4 py-0.5 truncate"
                >
                  {defaultLayouts.map((layoutItem, idx) => (
                    <option value={layoutItem.id} selected={idx === 0}>
                      {layoutItem.label}
                    </option>
                  ))}
                </select>
                <div class="absolute right-0 flex items-center pointer-events-none text-gray-400 light:text-slate-500">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Fullscreen Toggle Button -->
            <button
              type="button"
              class="table-deck-btn shrink-0"
              data-media-fullscreen="true"
              aria-label={`Open fullscreen visualization: ${title}`}
              title="Fullscreen"
            >
              <svg class="artifact-fullscreen-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </button>
          </div>
        </div>

        <!-- Middle Band: Unobstructed Graph Rendering Canvas Stage -->
        <div
          class="visualization-stage artifact-card-body relative flex-1 w-full min-w-0 min-h-0 overflow-hidden"
          data-payload-url={payloadUrl}
          data-layout-url={layoutUrl}
        >
          <!-- Render Loading Placeholder -->
          <div id="canvas-loading" class="absolute inset-0 flex items-center justify-center bg-gray-950/80 z-30 transition-opacity duration-300">
            <div class="flex flex-col items-center space-y-4">
              <div class="w-8 h-8 rounded-full border-2 border-domain-visualizations/20 border-t-domain-visualizations animate-spin"></div>
              <span class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Loading Network Graph...</span>
            </div>
          </div>

          <!-- Read-only FPS Telemetry Sparkline -->
          <div
            id="fps-badge"
            class="pointer-events-none select-none absolute top-3 right-3.5 z-20 flex flex-col items-end gap-1"
            aria-label="Frames per second"
          >
            <div class="flex items-baseline gap-1 leading-none">
              <span id="fps-value" class="text-xs font-mono font-bold tabular-nums text-gray-200 light:text-slate-800">--</span>
              <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-gray-400 light:text-slate-500">FPS</span>
            </div>
            <svg width="88" height="22" viewBox="0 0 88 22" class="overflow-visible block" aria-hidden="true">
              <line x1="0" y1="2" x2="88" y2="2" stroke="var(--color-border-subtle)" stroke-width="1" stroke-dasharray="2 2" />
              <line x1="0" y1="21" x2="88" y2="21" stroke="var(--color-border-subtle)" stroke-width="1" />
              <polygon id="fps-chart-area" points="0,21 88,21" fill="var(--color-domain-visualizations)" fill-opacity="0.15" />
              <polyline id="fps-chart-line" points="0,21 88,21" fill="none" stroke="var(--color-domain-visualizations)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <!-- Graph Rendering Canvas -->
          <div
            id="canvas"
            class="absolute inset-0 w-full h-full overflow-hidden"
            data-graph-type={type}
            data-payload-url={payloadUrl}
            data-layout-url={layoutUrl}
            data-graph-payload-url={payloadArtifact.url}
            data-graph-payload-hash={payloadArtifact.hash}
          ></div>
        </div>

        <!-- Floating Glassmorphic Legend -->
        <div class="artifact-card-footer px-3.5 py-2.5 text-xs select-none">
          <div class="grid grid-cols-3 md:flex md:flex-wrap md:items-center md:justify-center gap-x-3 gap-y-1.5 md:gap-x-5 w-full">
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-domain-posts border border-white/20 shadow-sm shadow-domain-posts/30"></span>
              <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs truncate">Posts</span>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-domain-publications border border-white/20 shadow-sm shadow-domain-publications/30"></span>
              <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs truncate">Publications</span>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-domain-presentations border border-white/20 shadow-sm shadow-domain-presentations/30"></span>
              <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs truncate">Presentations</span>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-domain-courses border border-white/20 shadow-sm shadow-domain-courses/30"></span>
              <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs truncate">Courses</span>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-domain-projects border border-white/20 shadow-sm shadow-domain-projects/30"></span>
              <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs truncate">Projects</span>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-domain-services border border-white/20 shadow-sm shadow-domain-services/30"></span>
              <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs truncate">Services</span>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-domain-newsletters border border-white/20 shadow-sm shadow-domain-newsletters/30"></span>
              <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs truncate">Newsletters</span>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-domain-visualizations border border-white/20 shadow-sm shadow-domain-visualizations/30"></span>
              <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs truncate">Visualizations</span>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-domain-tags border border-white/20 shadow-sm shadow-domain-tags/30"></span>
              <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs truncate">Tags</span>
            </div>
          </div>
        </div>
      </div>
    </Container>

    <!-- Documentation & Contact in Reading Width -->
    <Container size="reading" padding="none" class="mt-12">
      <article id="visualization-docs" class="glass-card p-8 md:p-10 rounded-3xl border border-element-border visualization-details prose-custom">
        <Content />
      </article>

      <ConversionCallout domain="visualizations" />
    </Container>
  </Section>

  <!-- Standardized Related Content (Edge-to-Edge) -->
  <RelatedContent 
    currentCollection="visualizations" 
    currentId={vis.id} 
    tags={vis.data.tags || []} 
  />

  <!-- Inject Graph Boot Scripts -->
  <script>
    import { getThemeTokens } from '@commons/shared/domain-themes';
    import {
      hydrateEnginePayloads,
      type CanonicalGraphPayload,
      type EnginePayloads,
      type GraphLayoutPayload,
    } from '@commons/shared/graph-payload';

    interface GraphInstance {
      destroy(): void;
      updateLayout(layout: string, isLight: boolean): void;
      layouts: { id: string; label: string }[];
    }

    interface GraphEngine {
      layouts: { id: string; label: string }[];
      init(container: HTMLElement, payload: EnginePayloads, layout: string, isLight: boolean, extraOptions?: Record<string, string>): Promise<GraphInstance>;
    }

    declare global {
      interface Window {
        GRAPH_TYPE: string;
        GRAPH_PAYLOAD: EnginePayloads;
        activeInstance: GraphInstance | null;
      }
    }

    const inMemoryUrlCache = new Map<string, string>();

    async function fetchWithMemoryCache<T>(url: string): Promise<T> {
      const memRaw = inMemoryUrlCache.get(url);
      if (memRaw) {
        return JSON.parse(memRaw) as T;
      }

      const response = await fetch(url);
      if (!response.ok) {
        throw new Error(`Failed to fetch ${url} (${response.status})`);
      }
      const rawJson = await response.text();
      const parsed = JSON.parse(rawJson) as T;
      inMemoryUrlCache.set(url, rawJson);
      return parsed;
    }

    async function loadHydratedGraphPayload(
      _type: string,
      payloadUrl: string,
      layoutUrl: string
    ): Promise<EnginePayloads> {
      const [canonicalPayload, layoutData] = await Promise.all([
        fetchWithMemoryCache<CanonicalGraphPayload>(payloadUrl),
        layoutUrl
          ? fetchWithMemoryCache<GraphLayoutPayload>(layoutUrl).catch(() => null)
          : Promise.resolve(null),
      ]);
      return hydrateEnginePayloads(canonicalPayload, layoutData?.positions);
    }

    function onReady(fn: () => void) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fn);
      } else {
        fn();
      }
    }

    onReady(() => {
      const container = document.getElementById('canvas');
      const loading = document.getElementById('canvas-loading');
      const selector = document.getElementById('layout-selector') as HTMLSelectElement | null;
      const engineSelector = document.getElementById('engine-selector') as HTMLSelectElement | null;
      const fpsValueEl = document.getElementById('fps-value');
      const fpsChartLine = document.getElementById('fps-chart-line');
      const fpsChartArea = document.getElementById('fps-chart-area');
      if (!container) return;

      if (fpsValueEl) {
        let frames = 0;
        let lastFpsSample = performance.now();
        const maxSamples = 30;
        const chartW = 88;
        const topY = 2;
        const bottomY = 21;
        const fpsHistory: number[] = [];

        const updateFps = (now: number) => {
          if (!document.hidden) {
            frames++;
            const elapsed = now - lastFpsSample;
            if (elapsed >= 200) {
              const fps = Math.min(120, Math.max(1, Math.round((frames * 1000) / elapsed)));
              fpsValueEl.textContent = String(fps);
              fpsHistory.push(fps);
              if (fpsHistory.length > maxSamples) {
                fpsHistory.shift();
              }

              if (fpsChartLine && fpsChartArea && fpsHistory.length > 0) {
                const maxScale = Math.max(60, ...fpsHistory);
                const stepX = chartW / (maxSamples - 1);
                const startIdx = maxSamples - fpsHistory.length;
                const coords = fpsHistory.map((val, i) => {
                  const x = ((startIdx + i) * stepX).toFixed(1);
                  const ratio = Math.max(0, Math.min(1, val / maxScale));
                  const y = (bottomY - ratio * (bottomY - topY)).toFixed(1);
                  return `${x},${y}`;
                });
                const firstX = (startIdx * stepX).toFixed(1);
                const linePts = coords.length === 1 ? `0,${coords[0].split(',')[1]} ${chartW},${coords[0].split(',')[1]}` : coords.join(' ');
                const areaPts =
                  coords.length === 1
                    ? `0,${bottomY} 0,${coords[0].split(',')[1]} ${chartW},${coords[0].split(',')[1]} ${chartW},${bottomY}`
                    : `${firstX},${bottomY} ${coords.join(' ')} ${chartW},${bottomY}`;
                fpsChartLine.setAttribute('points', linePts);
                fpsChartArea.setAttribute('points', areaPts);
              }

              frames = 0;
              lastFpsSample = now;
            }
          } else {
            frames = 0;
            lastFpsSample = now;
          }
          requestAnimationFrame(updateFps);
        };
        requestAnimationFrame(updateFps);
      }

      const stageEl = container.closest('.visualization-stage') as HTMLElement | null;
      const type = container.dataset.graphType || '';
      const payloadUrl =
        stageEl?.dataset.payloadUrl ||
        container.dataset.payloadUrl ||
        container.dataset.graphPayloadUrl ||
        '';
      const layoutUrl = stageEl?.dataset.layoutUrl || container.dataset.layoutUrl || '';
      window.GRAPH_TYPE = type;

      const isInitialLightMode = document.documentElement.classList.contains('light');
      const initialTokens = getThemeTokens(isInitialLightMode);

      if (engineSelector) {
        Array.from(engineSelector.options).forEach((option) => {
          option.style.backgroundColor = initialTokens.background;
          option.style.color = initialTokens.textHeading;
        });

        engineSelector.addEventListener('change', (e) => {
          const newEngine = (e.target as HTMLSelectElement).value;
          if (newEngine && newEngine !== type) {
            const params = new URLSearchParams(window.location.search);
            const layoutParam = params.get('layout');
            const targetUrl = layoutParam
              ? `/visualizations/${newEngine}/?layout=${encodeURIComponent(layoutParam)}`
              : `/visualizations/${newEngine}/`;
            window.location.href = targetUrl;
          }
        });
      }

      if (selector) {
        Array.from(selector.options).forEach((option) => {
          option.style.backgroundColor = initialTokens.background;
          option.style.color = initialTokens.textHeading;
        });
        const initialLayoutParam = new URLSearchParams(window.location.search).get('layout');
        if (
          initialLayoutParam &&
          Array.from(selector.options).some((opt) => opt.value === initialLayoutParam)
        ) {
          selector.value = initialLayoutParam;
        }
      }

      let activeInstance: GraphInstance | null = null;

      async function runInit() {
        if (!container) return;
        if (activeInstance) {
          if (typeof activeInstance.destroy === 'function') {
            activeInstance.destroy();
          }
          activeInstance = null;
        }
        if (container) {
          container.replaceChildren();
        }

        try {
          const payloadPromise = loadHydratedGraphPayload(type, payloadUrl, layoutUrl);
          let engineModule;
          switch (type) {
            case 'cytoscape':
              engineModule = await import('@content/visualizations/cytoscape/engine.ts');
              break;
            case 'd3':
              engineModule = await import('@content/visualizations/d3/engine.ts');
              break;
            case 'sigma':
              engineModule = await import('@content/visualizations/sigma/engine.ts');
              break;
            case '3d-force-graph':
            case '3d-force':
              engineModule = await import('@content/visualizations/3d-force-graph/engine.ts');
              // canonical 3d-force-graph engine
              break;
            case 'vis-network':
              engineModule = await import('@content/visualizations/vis-network/engine.ts');
              break;
            default:
              throw new Error(`Unknown visualization type: ${type}`);
          }

          const payload = await payloadPromise;
          window.GRAPH_PAYLOAD = payload;

          const engine = engineModule.default as GraphEngine;
          
          // Determine layout from query parameters
          const params = new URLSearchParams(window.location.search);
          let currentLayout = params.get('layout');
          
          // Verify layout is supported by the engine, else fallback to default
          const supportsLayout = engine.layouts.some((l: { id: string }) => l.id === currentLayout);
          if (!currentLayout || !supportsLayout) {
            currentLayout = engine.layouts[0].id;
          }

          // Sync the layout dropdown without triggering unnecessary DOM replacement
          if (selector) {
            const isLightMode = document.documentElement.classList.contains('light');
            const tokens = getThemeTokens(isLightMode);
            const existingIds = Array.from(selector.options)
              .map((o) => o.value)
              .join(',');
            const engineIds = engine.layouts.map((l: { id: string }) => l.id).join(',');
            if (existingIds !== engineIds) {
              selector.replaceChildren();
              engine.layouts.forEach((l: { id: string; label: string }) => {
                const option = document.createElement('option');
                option.value = l.id;
                option.textContent = l.label;
                option.style.backgroundColor = tokens.background;
                option.style.color = tokens.textHeading;
                selector.appendChild(option);
              });
            } else {
              Array.from(selector.options).forEach((option) => {
                option.style.backgroundColor = tokens.background;
                option.style.color = tokens.textHeading;
              });
            }
            selector.value = currentLayout;
          }

          // Initialize engine with UTM tracking
          const isLight = document.documentElement.classList.contains('light');
          activeInstance = await engine.init(container, payload, currentLayout, isLight, {
            utmSource: 'visualizations_demo',
            utmMedium: type,
            utmCampaign: 'interactive_visualization'
          });
          window.activeInstance = activeInstance;

        } catch (e) {
          console.error("Failed to load visualization: ", e);
        }
      }

      // Initialize on load
      setTimeout(async () => {
        await runInit();
        if (loading) {
          loading.style.opacity = '0';
          setTimeout(() => loading.remove(), 300);
        }
      }, 100);

      // Handle layout change
      if (selector) {
        selector.addEventListener('change', (e) => {
          const newLayout = (e.target as HTMLSelectElement).value;
          if (activeInstance) {
            const url = new URL(window.location.href);
            url.searchParams.set('layout', newLayout);
            window.history.pushState({}, '', url.toString());
            
            const isLight = document.documentElement.classList.contains('light');
            activeInstance.updateLayout(newLayout, isLight);
          }
        });
      }

      // Handle theme change dynamically without reloading canvas
      window.addEventListener('theme-changed', () => {
        const isLight = document.documentElement.classList.contains('light');
        const tokens = getThemeTokens(isLight);
        if (selector) {
          Array.from(selector.options).forEach((option) => {
            option.style.backgroundColor = tokens.background;
            option.style.color = tokens.textHeading;
          });
        }
        if (engineSelector) {
          Array.from(engineSelector.options).forEach((option) => {
            option.style.backgroundColor = tokens.background;
            option.style.color = tokens.textHeading;
          });
        }
        if (activeInstance) {
          const params = new URLSearchParams(window.location.search);
          const currentLayout = params.get('layout') || activeInstance.layouts[0].id;
          activeInstance.updateLayout(currentLayout, isLight);
        }
      });
    });
  </script>
</Layout>

