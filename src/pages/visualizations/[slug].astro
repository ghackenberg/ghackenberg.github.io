---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";

export async function getStaticPaths() {
  const visualizations = await getCollection("visualizations");
  return visualizations.map(vis => ({
    params: { slug: vis.id },
    props: { type: vis.id, title: vis.data.title, screenshot: vis.data.screenshot }
  }));
}

const { type, title, screenshot } = Astro.props;

const optimizedScreenshot = screenshot ? await getImage({
  src: screenshot,
  format: 'webp',
  width: 1200,
  quality: 85
}) : null;

import { buildGraphPayload } from "../../scripts/graph-payload";

const posts = await getCollection("posts");
const publications = await getCollection("publications");
const projects = await getCollection("projects");
const courses = await getCollection("courses");
const services = await getCollection("services");
const tags = await getCollection("tags");

const payload = await buildGraphPayload({
  posts,
  publications,
  projects,
  courses,
  services,
  tags,
  getImage
});

---

<Layout 
  title={`${title} | Content Visualizations | Dr. Georg Hackenberg, Professor for Industrial Informatics @ UAP Campus Wels`} 
  description={`An interactive network diagram mapping the connections between projects, blog posts, publications, courses, services, and topic tags on Dr. Georg Hackenberg's website using ${title}.`}
  image={screenshot || optimizedScreenshot?.src}
>
  <Navbar />

  <main class="flex-grow max-w-6xl mx-auto px-4 md:px-8 pt-12 pb-20 md:pt-16 md:pb-24 w-full relative z-10 flex flex-col min-h-[calc(100vh-80px)]">
    <!-- Back Button -->
    <a 
      href="/visualizations/" 
      class="inline-flex items-center space-x-2 text-xs font-semibold px-4 py-2 rounded-xl bg-brand-green/10 border border-brand-green/20 hover:border-brand-green/30 text-brand-green transition-all mb-8 cursor-pointer self-start"
    >
      <span>&larr;</span>
      <span>Back to Visualizations</span>
    </a>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 shrink-0">
      <div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-gray-100 tracking-tight">
          {title}
        </h1>
      </div>

      <!-- Engine Selector Tabs -->
      <div class="flex flex-wrap gap-1 bg-element-bg border border-element-border p-1 rounded-xl self-start sm:self-auto">
        <a 
          href="/visualizations/cytoscape/" 
          class={`px-4 py-2 rounded-lg text-xs font-bold transition-all ${type === 'cytoscape' ? 'bg-brand-green text-slate-950 shadow-md' : 'text-gray-400 hover:text-gray-100'}`}
        >
          Cytoscape
        </a>
        <a 
          href="/visualizations/d3/" 
          class={`px-4 py-2 rounded-lg text-xs font-bold transition-all ${type === 'd3' ? 'bg-brand-green text-slate-950 shadow-md' : 'text-gray-400 hover:text-gray-100'}`}
        >
          D3
        </a>
        <a 
          href="/visualizations/sigma/" 
          class={`px-4 py-2 rounded-lg text-xs font-bold transition-all ${type === 'sigma' ? 'bg-brand-green text-slate-950 shadow-md' : 'text-gray-400 hover:text-gray-100'}`}
        >
          Sigma
        </a>
        <a 
          href="/visualizations/3d-force/" 
          class={`px-4 py-2 rounded-lg text-xs font-bold transition-all ${type === '3d-force' ? 'bg-brand-green text-slate-950 shadow-md' : 'text-gray-400 hover:text-gray-100'}`}
        >
          3D Force
        </a>
        <a 
          href="/visualizations/vis-network/" 
          class={`px-4 py-2 rounded-lg text-xs font-bold transition-all ${type === 'vis-network' ? 'bg-brand-green text-slate-950 shadow-md' : 'text-gray-400 hover:text-gray-100'}`}
        >
          Vis.js
        </a>
      </div>
    </div>

    <div class="flex-grow w-full relative min-h-[500px] h-[70vh] md:h-[calc(100vh-320px)] rounded-3xl border border-element-border light:border-slate-200 bg-gray-950/60 light:bg-slate-100/60 backdrop-blur-md overflow-hidden shadow-2xl">
      <!-- Floating Glassmorphic Legend (Positioned top-left, responsive on mobile & desktop) -->
      <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-20 max-w-[calc(100%-1.5rem)] flex flex-wrap items-center gap-3 sm:gap-5 px-3.5 py-2 rounded-2xl bg-gray-950/60 light:bg-white/80 backdrop-blur-md border border-white/10 light:border-slate-200/80 shadow-md text-xs pointer-events-none select-none">
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-sky-400 border border-white/20 shadow-sm shadow-sky-400/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Tags</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-blue border border-white/20 shadow-sm shadow-brand-blue/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Posts</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-green border border-white/20 shadow-sm shadow-brand-green/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Projects</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500 border border-white/20 shadow-sm shadow-indigo-500/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Publications</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-yellow border border-white/20 shadow-sm shadow-brand-yellow/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Courses</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-purple border border-white/20 shadow-sm shadow-brand-purple/30"></span>
          <span class="text-gray-200 light:text-slate-700 font-semibold text-[11px] sm:text-xs">Services</span>
        </div>
      </div>

      <!-- Floating Glassmorphic Layout Mode Selector (Positioned bottom-right) -->
      <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 z-20 pointer-events-auto flex items-center space-x-2.5 px-3.5 py-2 rounded-2xl bg-gray-950/60 light:bg-white/80 backdrop-blur-md border border-white/10 light:border-slate-200/80 shadow-md text-xs">
        <label for="layout-selector" class="text-gray-400 light:text-slate-500 font-semibold text-[11px] sm:text-xs whitespace-nowrap flex items-center space-x-1.5 cursor-pointer">
          <svg class="w-3.5 h-3.5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          <span>Layout:</span>
        </label>
        <div class="relative flex items-center">
          <select 
            id="layout-selector"
            aria-label="Select layout"
            class="bg-transparent text-gray-200 light:text-slate-800 font-semibold text-[11px] sm:text-xs cursor-pointer focus:outline-none appearance-none pr-5 py-0.5"
          >
            <!-- Options will be populated dynamically by the engine -->
          </select>
          <div class="absolute right-0 flex items-center pointer-events-none text-gray-400 light:text-slate-500">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Render Loading Placeholder -->
      <div id="canvas-loading" class="absolute inset-0 flex items-center justify-center bg-gray-950/80 z-30 transition-opacity duration-300">
        <div class="flex flex-col items-center space-y-4">
          <div class="w-8 h-8 rounded-full border-2 border-brand-green/20 border-t-brand-green animate-spin"></div>
          <span class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Loading Network Graph...</span>
        </div>
      </div>

      <!-- Graph Rendering Canvas -->
      <div id="canvas" class="w-full h-full relative z-10"></div>
    </div>
  </main>

  <!-- Expose Astro variables to global scope for client script -->
  <script is:inline define:vars={{ type, payload }}>
    window.GRAPH_TYPE = type;
    window.GRAPH_PAYLOAD = payload;
  </script>

  <!-- Inject Graph Boot Scripts -->
  <script>
    interface VisNetworkNode {
      id: string;
      name: string;
      size: number;
      group: number;
      typeLabel?: string;
      description?: string;
      date?: string;
      image?: string;
      tags?: string[];
    }

    interface GraphPayload {
      cytoscape?: { elements: { data: Record<string, string | number | undefined> }[] };
      d3?: { nodes: { id: string; name: string; size: number; group: number }[]; connections: { sourceId: string; targetId: string }[] };
      sigma?: { nodes: { id: string; label: string; x: number; y: number; size: number; group: number; color: string }[]; edges: { id: string; source: string; target: string; color?: string }[] };
      '3d-force'?: { nodes: { id: string; name: string; size: number; group: number }[]; connections: { sourceId: string; targetId: string }[] };
      'vis-network'?: { nodes: VisNetworkNode[]; connections: { sourceId: string; targetId: string }[] };
    }

    interface GraphInstance {
      destroy(): void;
      updateLayout(layout: string, isLight: boolean): void;
      layouts: { id: string; label: string }[];
    }

    interface GraphEngine {
      layouts: { id: string; label: string }[];
      init(container: HTMLElement, payload: GraphPayload, layout: string, isLight: boolean, extraOptions?: Record<string, string>): Promise<GraphInstance>;
    }

    declare global {
      interface Window {
        GRAPH_TYPE: string;
        GRAPH_PAYLOAD: GraphPayload;
        activeInstance: GraphInstance | null;
      }
    }

    const type = window.GRAPH_TYPE;
    const payload = window.GRAPH_PAYLOAD;

    window.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('canvas');
      const loading = document.getElementById('canvas-loading');
      const selector = document.getElementById('layout-selector') as HTMLSelectElement | null;
      if (!container) return;

      let activeInstance: GraphInstance | null = null;

      async function runInit() {
        if (!container) return;
        if (activeInstance) {
          if (typeof activeInstance.destroy === 'function') {
            activeInstance.destroy();
          }
          activeInstance = null;
        }
        if (container) {
          container.innerHTML = '';
        }

        try {
          let engineModule;
          switch (type) {
            case 'cytoscape':
              engineModule = await import('../../content/visualizations/cytoscape/engine.js');
              break;
            case 'd3':
              engineModule = await import('../../content/visualizations/d3/engine.js');
              break;
            case 'sigma':
              engineModule = await import('../../content/visualizations/sigma/engine.js');
              break;
            case '3d-force':
              engineModule = await import('../../content/visualizations/3d-force/engine.js');
              break;
            case 'vis-network':
              engineModule = await import('../../content/visualizations/vis-network/engine.js');
              break;
            default:
              throw new Error(`Unknown visualization type: ${type}`);
          }

          const engine = engineModule.default as GraphEngine;
          
          // Determine layout from query parameters
          const params = new URLSearchParams(window.location.search);
          let currentLayout = params.get('layout');
          
          // Verify layout is supported by the engine, else fallback to default
          const supportsLayout = engine.layouts.some((l: { id: string }) => l.id === currentLayout);
          if (!currentLayout || !supportsLayout) {
            currentLayout = engine.layouts[0].id;
          }

          // Populate the layout dropdown
          if (selector) {
            const isLightMode = document.documentElement.classList.contains('light');
            selector.innerHTML = '';
            engine.layouts.forEach((l: { id: string; label: string }) => {
              const option = document.createElement('option');
              option.value = l.id;
              option.textContent = l.label;
              option.style.backgroundColor = isLightMode ? '#ffffff' : '#030712';
              option.style.color = isLightMode ? '#0f172a' : '#ffffff';
              selector.appendChild(option);
            });
            selector.value = currentLayout;
          }

          // Initialize engine with UTM tracking
          const isLight = document.documentElement.classList.contains('light');
          activeInstance = await engine.init(container, payload, currentLayout, isLight, {
            utmSource: 'visualizations_demo',
            utmMedium: type,
            utmCampaign: 'interactive_visualization'
          });
          window.activeInstance = activeInstance;

        } catch (e) {
          console.error("Failed to load visualization: ", e);
        }
      }

      // Initialize on load
      setTimeout(async () => {
        await runInit();
        if (loading) {
          loading.style.opacity = '0';
          setTimeout(() => loading.remove(), 300);
        }
      }, 100);

      // Handle layout change
      if (selector) {
        selector.addEventListener('change', (e) => {
          const newLayout = (e.target as HTMLSelectElement).value;
          if (activeInstance) {
            const url = new URL(window.location.href);
            url.searchParams.set('layout', newLayout);
            window.history.pushState({}, '', url.toString());
            
            const isLight = document.documentElement.classList.contains('light');
            activeInstance.updateLayout(newLayout, isLight);
          }
        });
      }

      // Handle theme change dynamically without reloading canvas
      window.addEventListener('theme-changed', () => {
        const isLight = document.documentElement.classList.contains('light');
        if (selector) {
          Array.from(selector.options).forEach((option) => {
            option.style.backgroundColor = isLight ? '#ffffff' : '#030712';
            option.style.color = isLight ? '#0f172a' : '#ffffff';
          });
        }
        if (activeInstance) {
          const params = new URLSearchParams(window.location.search);
          const currentLayout = params.get('layout') || activeInstance.layouts[0].id;
          activeInstance.updateLayout(currentLayout, isLight);
        }
      });
    });
  </script>
</Layout>

<style>
  /* Ensure canvas takes all available dimensions */
  #canvas {
    outline: none;
  }

  /* Style layout selector options */
  #layout-selector option {
    background: #030712;
    color: #f3f4f6;
  }
  :global(.light) #layout-selector option {
    background: #ffffff;
    color: #0f172a;
  }
</style>
