---
// Dev-only Analytics Overlay Component
// Zero footprint in production builds
interface Props {
  isInsideFrame?: boolean;
}

const { isInsideFrame = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

{!isInsideFrame && (
<div id="dev-analytics-container" class="dev-analytics-root select-none font-sans text-xs">
  <!-- Strict Single-Row HUD Bar (Full Window Width, 50% Medium Gray) -->
  <aside
    id="dev-analytics-hud"
    class="fixed top-0 left-0 right-0 z-[9999] h-11 bg-zinc-500 text-white border-b border-zinc-400 px-4 shadow-md backdrop-blur-md transition-none"
    aria-label="Dev Analytics HUD"
  >
    <div class="h-full w-full flex items-center justify-between gap-4 flex-nowrap overflow-hidden">
      <!-- Left: Identity & Timeframe Selector -->
      <div class="flex items-center gap-2 shrink-0">
        <div class="h-7 flex items-center justify-center font-semibold text-white font-mono text-xs gap-1.5 px-1">
          <span>📊</span>
          <div class="w-4 h-4 flex items-center justify-center shrink-0" title="Analytics Sync Status">
            <!-- Animated Loading Spinner -->
            <svg id="dev-hud-spinner" class="w-3.5 h-3.5 animate-spin text-emerald-300 hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            <!-- Check Symbol (visible when loaded) -->
            <svg id="dev-hud-check" class="w-3.5 h-3.5 text-emerald-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
            </svg>
          </div>
        </div>

        <!-- Timeframe Selector -->
        <div class="h-7 flex items-center rounded-lg bg-zinc-600/90 border border-zinc-400/80 p-0.5" role="group" aria-label="Timeframe">
          <button type="button" data-period="7d" class="dev-period-btn h-full px-2 flex items-center justify-center rounded-md text-[11px] font-mono leading-none transition-colors text-zinc-200 hover:text-white">7d</button>
          <button type="button" data-period="28d" class="dev-period-btn active-period h-full px-2 flex items-center justify-center rounded-md text-[11px] font-mono leading-none transition-colors bg-zinc-200 text-zinc-900 font-bold shadow-xs border border-zinc-300">28d</button>
          <button type="button" data-period="90d" class="dev-period-btn h-full px-2 flex items-center justify-center rounded-md text-[11px] font-mono leading-none transition-colors text-zinc-200 hover:text-white">90d</button>
        </div>
      </div>

      <!-- Center: Key Performance Metrics with Smooth Right Fade-out Mask -->
      <div
        class="h-7 flex-1 min-w-0 overflow-hidden flex items-center gap-2 text-xs font-mono transition-opacity duration-200"
        id="dev-analytics-metrics"
        style="-webkit-mask-image: linear-gradient(to right, black calc(100% - 36px), transparent 100%); mask-image: linear-gradient(to right, black calc(100% - 36px), transparent 100%);"
      >
        <!-- Core Essential Plausible (Always visible) -->
        <div class="h-7 flex items-center gap-2 px-2.5 rounded-lg bg-zinc-600/90 border border-zinc-400/80 shrink-0 leading-none">
          <span title="Unique Page Visitors" class="flex items-center gap-1">
            <span class="text-zinc-200">Visitors:</span>
            <strong id="hud-visitors" class="text-white font-bold">--</strong>
          </span>
          <span class="hidden md:inline text-zinc-400">|</span>
          <span title="Direct Entry Visitors (Landing Page Sessions)" class="hidden md:flex items-center gap-1">
            <span class="text-zinc-200">Entries:</span>
            <strong id="hud-entries" class="text-white font-bold">--</strong>
          </span>
          <span class="hidden md:inline text-zinc-400">|</span>
          <span title="Total Pageviews" class="hidden md:flex items-center gap-1">
            <span class="text-zinc-200">Views:</span>
            <strong id="hud-pageviews" class="text-white font-bold">--</strong>
          </span>
          <span class="hidden md:inline text-zinc-400">|</span>
          <span title="Bounce Rate" class="hidden md:flex items-center gap-1">
            <span class="text-zinc-200">Bounce:</span>
            <strong id="hud-bounce" class="text-amber-200 font-bold">--</strong>
          </span>
          <span class="hidden lg:inline text-zinc-400">|</span>
          <span title="Average Visit Duration" class="hidden lg:flex items-center gap-1">
            <span class="text-zinc-200">Dur:</span>
            <strong id="hud-duration" class="text-white font-bold">--</strong>
          </span>
        </div>

        <!-- Scroll Retention Pill (Informational only, not clickable) -->
        <div
          class="h-7 hidden lg:flex items-center gap-1.5 px-2.5 rounded-lg bg-zinc-600/90 border border-zinc-400/80 shrink-0 leading-none"
        >
          <span class="text-white font-semibold">Scroll:</span>
          <span title="Median Reader Scroll Depth" class="flex items-center gap-1">
            <span class="text-zinc-200">Med:</span>
            <strong id="hud-scroll-median" class="text-white font-bold">--</strong>
          </span>
          <span class="text-zinc-400">|</span>
          <span title="Read-Through Rate (100% Depth)" class="flex items-center gap-1">
            <span class="text-zinc-200">Read:</span>
            <strong id="hud-scroll-readthrough" class="text-emerald-300 font-bold">--</strong>
          </span>
        </div>

        <!-- Core Google Stats -->
        <div class="h-7 flex items-center gap-2 px-2.5 rounded-lg bg-zinc-600/90 border border-zinc-400/80 shrink-0 leading-none">
          <span class="text-white font-semibold">Google:</span>
          <span title="Google Search Clicks" class="flex items-center gap-1">
            <span class="text-zinc-200">Clicks:</span>
            <strong id="hud-gsc-clicks" class="text-emerald-300 font-bold">--</strong>
          </span>
          <span class="hidden md:inline text-zinc-400">|</span>
          <span title="Search Impressions" class="hidden md:flex items-center gap-1">
            <span class="text-zinc-200">Impr:</span>
            <strong id="hud-gsc-impr" class="text-zinc-100 font-bold">--</strong>
          </span>
          <span class="hidden lg:inline text-zinc-400">|</span>
          <span title="Search Click-Through Rate" class="hidden lg:flex items-center gap-1">
            <span class="text-zinc-200">CTR:</span>
            <strong id="hud-gsc-ctr" class="text-sky-200 font-bold">--</strong>
          </span>
          <span class="hidden xl:inline text-zinc-400">|</span>
          <span title="Average Search Ranking Position" class="hidden xl:flex items-center gap-1">
            <span class="text-zinc-200">Rank:</span>
            <strong id="hud-gsc-rank" class="text-amber-200 font-bold">--</strong>
          </span>
        </div>
      </div>

      <!-- Right: Action Controls, Toggles & Expand Button -->
      <div class="flex items-center gap-1.5 shrink-0">

        <!-- External Dashboard Quick Link (lg+) -->
        <a
          id="dev-plausible-link"
          href="https://plausible.io/hackenberg.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="h-7 w-7 hidden lg:flex items-center justify-center rounded-lg bg-zinc-600 hover:bg-zinc-700 text-zinc-100 hover:text-white border border-zinc-400/80 shadow-xs transition-colors"
          title="Open in Plausible Dashboard"
          aria-label="Open in Plausible"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>

        <!-- Refresh Button -->
        <button
          id="dev-analytics-refresh"
          type="button"
          class="h-7 w-7 flex items-center justify-center rounded-lg bg-zinc-600 hover:bg-zinc-700 text-zinc-100 hover:text-white border border-zinc-400/80 shadow-xs transition-colors cursor-pointer"
          title="Force refresh live data (clears cache)"
          aria-label="Refresh Data"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </button>

        <!-- Expand to Full-Window Cockpit Button -->
        <button
          id="dev-expand-btn"
          type="button"
          class="h-7 w-7 flex items-center justify-center rounded-lg bg-zinc-600 hover:bg-zinc-700 text-zinc-100 hover:text-white border border-zinc-400/80 font-mono text-xs transition-colors cursor-pointer shadow-xs leading-none font-bold"
          title="Expand to Full-Window Analytics Cockpit"
          aria-label="Expand Cockpit"
        >
          <span>⛶</span>
        </button>
      </div>
    </div>
  </aside>


  <!-- Integrated Fullscreen Visitor Flow Cockpit Overlay -->
  <div
    id="dev-analytics-fullview"
    role="dialog"
    class="fixed inset-0 z-[10001] bg-zinc-950 text-white hidden flex flex-col overflow-hidden font-sans select-none"
    aria-label="Dev Analytics Cockpit"
  >
    <!-- Fullview Header Bar -->
    <header class="min-h-12 shrink-0 border-b border-zinc-800 bg-zinc-900 px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 font-mono text-xs z-30">
      <!-- Left: Title, Status, Truncated Path Pill, Timeframe -->
      <div class="flex items-center gap-2 min-w-0">
        <div class="flex items-center gap-1.5 font-bold text-white shrink-0">
          <span>📊</span>
          <span class="hidden md:inline">Flow Cockpit</span>
          <div class="w-4 h-4 flex items-center justify-center shrink-0">
            <svg id="dev-fullview-spinner" class="w-3.5 h-3.5 animate-spin text-emerald-300 hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            <svg id="dev-fullview-check" class="w-3.5 h-3.5 text-emerald-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
            </svg>
          </div>
          <span id="dev-fullview-cache-badge" class="px-2 py-0.5 rounded text-[11px] bg-zinc-800 text-zinc-200 border border-zinc-700">LIVE</span>
        </div>

        <!-- Path pill -->
        <div class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-zinc-800 border border-zinc-700 text-zinc-100 truncate max-w-[160px] sm:max-w-[240px] lg:max-w-[320px]">
          <span class="text-zinc-400">📍</span>
          <span id="dev-fullview-path" class="font-semibold truncate">{currentPath}</span>
        </div>

        <!-- Timeframe selector -->
        <div class="inline-flex items-center rounded-lg bg-zinc-800 border border-zinc-700 p-0.5 shrink-0" role="group" aria-label="Timeframe">
          <button type="button" data-period="7d" class="dev-full-period-btn px-2 py-0.5 rounded transition-colors text-zinc-200 hover:text-white cursor-pointer">7d</button>
          <button type="button" data-period="28d" class="dev-full-period-btn active-period px-2 py-0.5 rounded transition-colors bg-zinc-200 text-zinc-900 font-bold shadow-xs border border-zinc-300 cursor-pointer">28d</button>
          <button type="button" data-period="90d" class="dev-full-period-btn px-2 py-0.5 rounded transition-colors text-zinc-200 hover:text-white cursor-pointer">90d</button>
        </div>
      </div>

      <!-- Right: Compact Steppers + Density Switcher + Actions -->
      <div class="flex flex-wrap items-center gap-1.5">
        <!-- Compact Inflow Stepper -->
        <div class="inline-flex items-center gap-1 bg-zinc-800 border border-zinc-700 rounded-lg p-0.5" title="Upstream Inflow Levels (1–5)">
          <span class="text-zinc-300 font-bold pl-1.5 pr-0.5">⬅️<span class="hidden sm:inline ml-1">Inflow</span></span>
          <button type="button" data-sankey-level-side="left" data-sankey-level-step="-1" class="w-6 h-6 rounded bg-zinc-900 hover:bg-zinc-700 text-zinc-200 font-bold flex items-center justify-center cursor-pointer" title="Decrease inflow levels">−</button>
          <span data-sankey-left-badge="true" class="min-w-[28px] text-center font-bold text-emerald-300">2L</span>
          <button type="button" data-sankey-level-side="left" data-sankey-level-step="1" class="w-6 h-6 rounded bg-zinc-900 hover:bg-zinc-700 text-zinc-200 font-bold flex items-center justify-center cursor-pointer" title="Increase inflow levels">+</button>
        </div>

        <!-- 2-Stage Density Switcher (Compact vs. Detailed) -->
        <div class="inline-flex items-center gap-0.5 bg-zinc-800 border border-zinc-700 rounded-lg p-0.5">
          <button
            type="button"
            data-sankey-density="compact"
            class="px-2 py-1 rounded font-bold text-zinc-400 hover:text-white transition-colors cursor-pointer"
            title="Compact: 1-line cards (Title + Visitors)"
          >
            Compact
          </button>
          <button
            type="button"
            data-sankey-density="detailed"
            class="px-2 py-1 rounded font-bold bg-emerald-500/30 border border-emerald-400 text-emerald-200 transition-colors cursor-pointer"
            title="Detailed: Title & Path above divider, Local 100% Flow & Action Bars below divider"
          >
            Detailed
          </button>
        </div>

        <!-- Compact Outflow Stepper -->
        <div class="inline-flex items-center gap-1 bg-zinc-800 border border-zinc-700 rounded-lg p-0.5" title="Downstream Outflow Levels (1–5)">
          <span class="text-zinc-300 font-bold pl-1.5 pr-0.5">➡️<span class="hidden sm:inline ml-1">Outflow</span></span>
          <button type="button" data-sankey-level-side="right" data-sankey-level-step="-1" class="w-6 h-6 rounded bg-zinc-900 hover:bg-zinc-700 text-zinc-200 font-bold flex items-center justify-center cursor-pointer" title="Decrease outflow levels">−</button>
          <span data-sankey-right-badge="true" class="min-w-[28px] text-center font-bold text-emerald-300">2R</span>
          <button type="button" data-sankey-level-side="right" data-sankey-level-step="1" class="w-6 h-6 rounded bg-zinc-900 hover:bg-zinc-700 text-zinc-200 font-bold flex items-center justify-center cursor-pointer" title="Increase outflow levels">+</button>
        </div>

        <button
          type="button"
          data-sankey-copy-png="true"
          class="px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-100 font-bold cursor-pointer flex items-center gap-1 transition-colors"
          title="Copy high-resolution PNG (2x) to clipboard"
        >
          <span>📋</span><span class="hidden sm:inline">Copy PNG</span>
        </button>

        <button
          id="dev-fullview-refresh"
          type="button"
          class="p-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white border border-zinc-700 transition-colors cursor-pointer"
          title="Force refresh live data"
          aria-label="Refresh"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </button>

        <a
          id="dev-fullview-plausible"
          href="https://plausible.io/hackenberg.tech"
          target="_blank"
          rel="noopener noreferrer"
          class="px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-100 hover:text-white border border-zinc-700 font-bold transition-colors"
          title="Open in Plausible Dashboard"
        >
          Plausible ↗
        </a>

        <!-- Collapse back into Top Bar Button -->
        <button
          id="dev-collapse-btn"
          type="button"
          class="flex items-center gap-1 px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-100 hover:text-white border border-zinc-700 font-bold transition-colors cursor-pointer"
          title="Collapse back to top analytics bar (Esc)"
          aria-label="Collapse to bar"
        >
          <span>✕</span>
          <kbd class="hidden sm:inline px-1 rounded bg-zinc-900 text-[10px] text-zinc-300 border border-zinc-700">Esc</kbd>
        </button>
      </div>
    </header>

    <!-- Fullscreen Visitor Flow Stage -->
    <main class="flex-1 min-h-0 relative overflow-hidden">
      <div id="full-visitor-flow-sankey" class="w-full h-full">
        <div class="w-full h-full flex items-center justify-center text-zinc-400 italic text-xs font-mono">
          Loading visitor flow stage...
        </div>
      </div>
    </main>
  </div>
</div>
)}

<script>
  import { renderVisitorFlowSankey, type DevSankeyData } from '@commons/client/dev-sankey';

  interface SearchQuery {
    query: string;
    clicks: number;
    impressions: number;
    ctr: number;
    position: number;
  }

  interface ScrollMilestone {
    depth: number;
    visitors: number;
    percentageOfVisitors: number;
    dropOffRateFromPrevious?: number;
  }

  interface ScrollRetentionData {
    milestones: ScrollMilestone[];
    readThroughRate: number | null;
    medianScrollDepth: number | null;
  }

  interface TechItem {
    name: string;
    visitors: number;
    percentage: number;
  }

  interface CountryItem {
    country: string;
    visitors: number;
    percentage: number;
  }

  interface DevOverlayData {
    path: string;
    period: string;
    plausible: {
      visitors: number;
      entries?: number;
      pageviews: number;
      bounceRate: number | null;
      visitDuration: number | null;
      scrollFunnel?: ScrollRetentionData;
      visitorFlow?: DevSankeyData;
      timeseries?: Array<{ date: string; visitors: number; pageviews: number }>;
      tech?: {
        devices?: TechItem[];
        operatingSystems?: TechItem[];
        browsers?: TechItem[];
      };
      countries?: CountryItem[];
    };
    gsc: {
      clicks: number;
      impressions: number;
      ctr: number;
      position: number;
      queries: SearchQuery[];
    };
    sections: Record<string, { id: string; visitors: number; events?: number }>;
    cards: Record<string, { id: string; views: number; clicks: number; ctr: number }>;
    pages?: Record<string, { visitors: number; pageviews: number; bounceRate?: number | null; visitDuration?: number | null }>;
  }

  const PERIOD_KEY = 'gh_dev_analytics_period';

  class DevAnalyticsManager {
    private currentPeriod: string = '28d';
    private currentLoadedPath: string = '';
    private currentData: DevOverlayData | null = null;
    private createdBadges: HTMLElement[] = [];
    private isFullViewOpen: boolean = false;

    constructor() {
      this.currentPeriod = localStorage.getItem(PERIOD_KEY) || '28d';
    }

    public init(): void {
      if (typeof window !== 'undefined' && window.self !== window.top) {
        window.parent.postMessage({
          type: 'dev-studio-nav',
          pathname: window.location.pathname,
        }, '*');
      }
      this.setupGlobalListeners();
      this.setupDomListeners();
      this.setupIframeSync();
      this.updatePeriodButtonsUI();
      this.restoreCachedSessionMetrics();
      this.fetchData();
    }

    public onPageLoad(): void {
      if (typeof window !== 'undefined' && window.self !== window.top) {
        window.parent.postMessage({
          type: 'dev-studio-nav',
          pathname: window.location.pathname,
        }, '*');
      }
      this.removeBadges();
      this.setupDomListeners();
      this.setupIframeSync();
      this.updatePeriodButtonsUI();
      this.restoreCachedSessionMetrics();
      this.fetchData(false);
    }

    private setupIframeSync(): void {
      if (typeof window === 'undefined' || window.self === window.top) return;

      // 1. Report scroll position to parent Studio Shell
      let scrollTicking = false;
      const reportScroll = () => {
        if (!scrollTicking) {
          requestAnimationFrame(() => {
            const scrollTop = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
            const scrollHeight = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight, 1000);
            const clientHeight = window.innerHeight || document.documentElement.clientHeight || 800;

            window.parent.postMessage({
              type: 'dev-studio-scroll',
              scrollTop,
              scrollHeight,
              clientHeight,
            }, '*');
            scrollTicking = false;
          });
          scrollTicking = true;
        }
      };

      window.addEventListener('scroll', reportScroll, { passive: true });
      document.addEventListener('scroll', reportScroll, { passive: true });
      window.addEventListener('resize', reportScroll, { passive: true });
      setTimeout(reportScroll, 100);
      setTimeout(reportScroll, 300);
      setTimeout(reportScroll, 800);

      // 2. Listen for scroll commands and period/data sync from parent Studio Shell
      window.addEventListener('message', (e) => {
        if (!e.data || typeof e.data !== 'object') return;

        if (e.data.type === 'dev-studio-scroll-to') {
          const top = typeof e.data.top === 'number' ? e.data.top : 0;
          window.scrollTo({
            top,
            behavior: e.data.smooth ? 'smooth' : 'instant',
          });
        } else if (e.data.type === 'dev-studio-set-period') {
          const period = e.data.period;
          if (period && period !== this.currentPeriod) {
            this.setPeriod(period);
          }
        } else if (e.data.type === 'dev-studio-sync-data') {
          if (e.data.period && e.data.period !== this.currentPeriod) {
            this.currentPeriod = e.data.period;
            localStorage.setItem(PERIOD_KEY, e.data.period);
            this.updatePeriodButtonsUI();
          }
          if (e.data.data) {
            this.currentData = e.data.data;
            try {
              sessionStorage.setItem(`gh_dev_last_${window.location.pathname}_${this.currentPeriod}`, JSON.stringify(e.data.data));
            } catch {}
            this.renderBadges(e.data.data);
            this.renderHud(e.data.data);
            this.renderFullView(e.data.data);
          }
        }
      });

      // 3. Storage event listener for period changes across windows/tabs
      window.addEventListener('storage', (e) => {
        if (e.key === PERIOD_KEY && e.newValue && e.newValue !== this.currentPeriod) {
          this.setPeriod(e.newValue);
        }
      });

      // 3. Inform parent Studio Shell on internal link navigation
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement)?.closest('a');
        if (!a || !a.href) return;
        if (a.target === '_blank' || a.href.startsWith('mailto:') || a.href.startsWith('tel:') || a.href.startsWith('#')) return;

        try {
          const url = new URL(a.href);
          if (url.origin === window.location.origin) {
            window.parent.postMessage({
              type: 'dev-studio-nav',
              pathname: url.pathname,
            }, '*');
          }
        } catch {}
      });
    }

    private setupGlobalListeners(): void {
      // Escape key closes fullview
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (this.isFullViewOpen) {
            this.closeFullView();
          }
        }
        if (e.altKey && (e.key === 'e' || e.key === 'E')) {
          e.preventDefault();
          this.toggleFullView();
        }
      });

      window.addEventListener('popstate', () => this.checkPathChange());
      this.interceptHistory();
    }

    private interceptHistory(): void {
      if (typeof window !== 'undefined' && window.self !== window.top) {
        return;
      }
      const origPush = history.pushState;
      const origReplace = history.replaceState;

      history.pushState = (...args: Parameters<typeof origPush>) => {
        origPush.apply(history, args);
        this.checkPathChange();
      };

      history.replaceState = (...args: Parameters<typeof origReplace>) => {
        origReplace.apply(history, args);
        this.checkPathChange();
      };
    }

    private checkPathChange(): void {
      if (window.location.pathname !== this.currentLoadedPath) {
        this.restoreCachedSessionMetrics();
        this.fetchData();
      }
    }

    private setupDomListeners(): void {
      // Refresh buttons
      const refreshBtn = document.getElementById('dev-analytics-refresh');
      if (refreshBtn && !refreshBtn.hasAttribute('data-bound')) {
        refreshBtn.setAttribute('data-bound', 'true');
        refreshBtn.addEventListener('click', () => {
          this.fetchData(true);
        });
      }

      const fullRefreshBtn = document.getElementById('dev-fullview-refresh');
      if (fullRefreshBtn && !fullRefreshBtn.hasAttribute('data-bound')) {
        fullRefreshBtn.setAttribute('data-bound', 'true');
        fullRefreshBtn.addEventListener('click', () => {
          this.fetchData(true);
        });
      }

      // Expand / Collapse buttons
      const expandBtn = document.getElementById('dev-expand-btn');
      if (expandBtn && !expandBtn.hasAttribute('data-bound')) {
        expandBtn.setAttribute('data-bound', 'true');
        expandBtn.addEventListener('click', () => {
          this.openFullView();
        });
      }

      const collapseBtn = document.getElementById('dev-collapse-btn');
      if (collapseBtn && !collapseBtn.hasAttribute('data-bound')) {
        collapseBtn.setAttribute('data-bound', 'true');
        collapseBtn.addEventListener('click', () => {
          this.closeFullView();
        });
      }

      // Timeframe buttons (HUD)
      const periodButtons = document.querySelectorAll<HTMLButtonElement>('.dev-period-btn');
      periodButtons.forEach((btn) => {
        if (!btn.hasAttribute('data-bound')) {
          btn.setAttribute('data-bound', 'true');
          btn.addEventListener('click', () => {
            const period = btn.getAttribute('data-period');
            if (period && period !== this.currentPeriod) {
              this.setPeriod(period);
            }
          });
        }
      });

      // Timeframe buttons (Full View)
      const fullPeriodButtons = document.querySelectorAll<HTMLButtonElement>('.dev-full-period-btn');
      fullPeriodButtons.forEach((btn) => {
        if (!btn.hasAttribute('data-bound')) {
          btn.setAttribute('data-bound', 'true');
          btn.addEventListener('click', () => {
            const period = btn.getAttribute('data-period');
            if (period && period !== this.currentPeriod) {
              this.setPeriod(period);
            }
          });
        }
      });
    }

    private setPeriod(period: string): void {
      this.currentPeriod = period;
      localStorage.setItem(PERIOD_KEY, period);
      this.updatePeriodButtonsUI();
      this.restoreCachedSessionMetrics();
      this.fetchData(true);
    }

    public openFullView(focusSectionId?: string): void {
      this.isFullViewOpen = true;
      const fullview = document.getElementById('dev-analytics-fullview');
      fullview?.classList.remove('hidden');

      if (this.currentData) {
        this.renderFullView(this.currentData);
      }

      if (focusSectionId) {
        requestAnimationFrame(() => {
          const el = document.getElementById(focusSectionId);
          el?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    }

    public closeFullView(): void {
      this.isFullViewOpen = false;
      const fullview = document.getElementById('dev-analytics-fullview');
      fullview?.classList.add('hidden');
    }

    public toggleFullView(): void {
      if (this.isFullViewOpen) {
        this.closeFullView();
      } else {
        this.openFullView();
      }
    }

    private updatePeriodButtonsUI(): void {
      const allPeriodButtons = document.querySelectorAll<HTMLButtonElement>('.dev-period-btn, .dev-full-period-btn');
      allPeriodButtons.forEach((btn) => {
        const period = btn.getAttribute('data-period');
        if (period === this.currentPeriod) {
          btn.classList.add('bg-zinc-200', 'text-zinc-900', 'font-bold', 'shadow-xs', 'border', 'border-zinc-300');
          btn.classList.remove('text-zinc-200');
        } else {
          btn.classList.remove('bg-zinc-200', 'text-zinc-900', 'font-bold', 'shadow-xs', 'border', 'border-zinc-300');
          btn.classList.add('text-zinc-200');
        }
      });
    }


    private restoreCachedSessionMetrics(): void {
      const currentPath = window.location.pathname;
      const cached = sessionStorage.getItem(`gh_dev_last_${currentPath}_${this.currentPeriod}`);
      if (cached) {
        try {
          const data: DevOverlayData = JSON.parse(cached);
          this.currentData = data;
          this.renderHud(data);
          this.renderFullView(data);
          this.renderBadges(data);
        } catch {
          // ignore
        }
      }
    }

    private setLoadingState(isLoading: boolean, isCached: boolean = false): void {
      const hudSpinner = document.getElementById('dev-hud-spinner');
      const hudCheck = document.getElementById('dev-hud-check');
      const fullSpinner = document.getElementById('dev-fullview-spinner');
      const fullCheck = document.getElementById('dev-fullview-check');
      const cacheBadge = document.getElementById('dev-analytics-cache-badge');
      const fullBadge = document.getElementById('dev-fullview-cache-badge');
      const metricsContainer = document.getElementById('dev-analytics-metrics');

      if (isLoading) {
        hudSpinner?.classList.remove('hidden');
        hudCheck?.classList.add('hidden');
        fullSpinner?.classList.remove('hidden');
        fullCheck?.classList.add('hidden');
        metricsContainer?.classList.add('opacity-60');

        if (cacheBadge) {
          cacheBadge.textContent = 'FETCHING...';
          cacheBadge.className = 'px-1.5 py-0.2 rounded text-[10px] bg-amber-50 text-amber-700 border border-amber-200';
        }
        if (fullBadge) {
          fullBadge.textContent = 'FETCHING...';
          fullBadge.className = 'px-2 py-0.5 rounded text-[11px] bg-amber-50 text-amber-700 border border-amber-200';
        }
      } else {
        hudSpinner?.classList.add('hidden');
        hudCheck?.classList.remove('hidden');
        fullSpinner?.classList.add('hidden');
        fullCheck?.classList.remove('hidden');
        metricsContainer?.classList.remove('opacity-60');

        const badgeText = isCached ? 'CACHED' : 'LIVE';
        const badgeClass = isCached
          ? 'px-1.5 py-0.2 rounded text-[10px] bg-zinc-700 text-zinc-200 border border-zinc-500'
          : 'px-1.5 py-0.2 rounded text-[10px] bg-zinc-700 text-emerald-300 border border-emerald-500/60 font-semibold';
        const fullBadgeClass = isCached
          ? 'px-2 py-0.5 rounded text-[11px] bg-zinc-700 text-zinc-200 border border-zinc-500'
          : 'px-2 py-0.5 rounded text-[11px] bg-zinc-700 text-emerald-300 border border-emerald-500/60 font-semibold';

        if (cacheBadge) {
          cacheBadge.textContent = badgeText;
          cacheBadge.className = badgeClass;
        }
        if (fullBadge) {
          fullBadge.textContent = badgeText;
          fullBadge.className = fullBadgeClass;
        }
      }
    }

    private async fetchData(forceRefresh: boolean = false): Promise<void> {
      const currentPath = window.location.pathname;
      this.currentLoadedPath = currentPath;

      // Update current path indicators
      const pathEl = document.getElementById('dev-analytics-current-path');
      if (pathEl) pathEl.textContent = currentPath;
      const fullPathEl = document.getElementById('dev-fullview-path');
      if (fullPathEl) fullPathEl.textContent = currentPath;

      // Update Plausible direct links
      const plausibleLink = document.getElementById('dev-plausible-link') as HTMLAnchorElement | null;
      if (plausibleLink) {
        plausibleLink.href = `https://plausible.io/hackenberg.tech?page=${encodeURIComponent(currentPath)}`;
      }
      const fullPlausibleLink = document.getElementById('dev-fullview-plausible') as HTMLAnchorElement | null;
      if (fullPlausibleLink) {
        fullPlausibleLink.href = `https://plausible.io/hackenberg.tech?page=${encodeURIComponent(currentPath)}`;
      }

      this.setLoadingState(true);

      try {
        let url = `/api/dev-analytics.json?path=${encodeURIComponent(currentPath)}&period=${this.currentPeriod}`;
        if (forceRefresh) {
          url += `&_t=${Date.now()}`;
        }

        const headers: Record<string, string> = {
          'x-analytics-path': currentPath,
          'x-analytics-period': this.currentPeriod,
        };

        const res = await fetch(url, { cache: 'no-store', headers });
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }

        const isCacheHit = res.headers.get('X-Analytics-Cache') === 'HIT';
        const data: DevOverlayData = await res.json();
        this.currentData = data;

        // Cache in sessionStorage to eliminate navigation flicker
        try {
          sessionStorage.setItem(`gh_dev_last_${currentPath}_${this.currentPeriod}`, JSON.stringify(data));
        } catch {
          // ignore storage quota
        }

        this.setLoadingState(false, isCacheHit);
        this.renderHud(data);
        this.renderFullView(data);
        this.renderBadges(data);
      } catch (err) {
        console.error('[dev-analytics] Failed to load metrics:', err);
        this.setLoadingState(false);
        const cacheBadge = document.getElementById('dev-analytics-cache-badge');
        if (cacheBadge) {
          cacheBadge.textContent = 'ERROR';
          cacheBadge.className = 'px-1.5 py-0.2 rounded text-[10px] bg-rose-50 text-rose-700 border border-rose-200';
        }
      }
    }

    private formatDuration(seconds: number | null): string {
      if (seconds === null || seconds === undefined) return '--';
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}m ${secs}s`;
    }

    private renderHud(data: DevOverlayData): void {
      const { plausible, gsc } = data;

      // Update HUD elements
      const visitorsEl = document.getElementById('hud-visitors');
      const entriesEl = document.getElementById('hud-entries');
      const viewsEl = document.getElementById('hud-pageviews');
      const bounceEl = document.getElementById('hud-bounce');
      const durationEl = document.getElementById('hud-duration');

      if (visitorsEl) visitorsEl.textContent = String(plausible.visitors ?? 0);
      if (entriesEl) entriesEl.textContent = String(plausible.entries ?? 0);
      if (viewsEl) viewsEl.textContent = String(plausible.pageviews ?? 0);
      if (bounceEl) bounceEl.textContent = plausible.bounceRate !== null ? `${plausible.bounceRate}%` : '--';
      if (durationEl) durationEl.textContent = this.formatDuration(plausible.visitDuration);

      // Scroll retention stats in HUD
      const medianEl = document.getElementById('hud-scroll-median');
      const readthroughEl = document.getElementById('hud-scroll-readthrough');
      if (medianEl) {
        medianEl.textContent = plausible.scrollFunnel?.medianScrollDepth != null ? `${plausible.scrollFunnel.medianScrollDepth}%` : '--';
      }
      if (readthroughEl) {
        readthroughEl.textContent = plausible.scrollFunnel?.readThroughRate != null ? `${plausible.scrollFunnel.readThroughRate}%` : '--';
      }

      const gscClicksEl = document.getElementById('hud-gsc-clicks');
      const gscImprEl = document.getElementById('hud-gsc-impr');
      const gscCtrEl = document.getElementById('hud-gsc-ctr');
      const gscRankEl = document.getElementById('hud-gsc-rank');

      if (gscClicksEl) gscClicksEl.textContent = String(gsc.clicks ?? 0);
      if (gscImprEl) gscImprEl.textContent = String(gsc.impressions ?? 0);
      if (gscCtrEl) gscCtrEl.textContent = `${((gsc.ctr ?? 0) * 100).toFixed(1)}%`;
      if (gscRankEl) gscRankEl.textContent = gsc.position ? `#${gsc.position.toFixed(1)}` : '--';

      // Update Queries button count
      const queriesCountEl = document.getElementById('dev-queries-count');
      const queries = gsc.queries || [];
      if (queriesCountEl) {
        queriesCountEl.textContent = `Queries (${queries.length}) ↗`;
      }
    }

    private renderFullView(data: DevOverlayData): void {
      const { plausible, gsc } = data;

      const sankeyContainerEl = document.getElementById('full-visitor-flow-sankey');
      if (sankeyContainerEl) {
        renderVisitorFlowSankey(
          sankeyContainerEl,
          data.path || window.location.pathname,
          plausible.visitorFlow,
          (targetPath) => {
            document.getElementById('dev-analytics-fullview')?.classList.add('hidden');
            window.location.href = targetPath;
          },
          this.currentPeriod,
          {
            visitors: plausible.visitors,
            pageviews: plausible.pageviews,
            visitDuration: plausible.visitDuration,
            bounceRate: plausible.bounceRate,
            gscQueries: gsc.queries,
            scrollFunnel: plausible.scrollFunnel,
            timeseries: plausible.timeseries,
          }
        );
      }
    }

    private removeBadges(): void {
      this.createdBadges.forEach((b) => b.remove());
      this.createdBadges = [];
    }

    private renderBadges(data: DevOverlayData): void {
      this.removeBadges();

      const totalPageVisitors = data.plausible.visitors || 0;
      const sectionData = data.sections || {};
      const cardData = data.cards || {};

      // 1. Process Headings (h2, h3, h4 with id)
      const headingElements = Array.from(
        document.querySelectorAll<HTMLElement>(':is(h2, h3, h4)[id]')
      ).filter((el) => {
        return (
          !el.closest('.preview-card') &&
          !el.closest('#presentation-player') &&
          !el.closest('#dev-analytics-container') &&
          !el.closest('dialog') &&
          !el.closest('[role="dialog"]') &&
          !el.closest('.modal') &&
          !el.closest('#whats-new-modal-container') &&
          !el.closest('#privacy-policy-modal-container')
        );
      });

      let previousSectionVisitors: number | null = null;

      headingElements.forEach((el, index) => {
        const id = el.id;
        if (!id) return;

        const dwell = sectionData[id];
        const visitors = dwell?.visitors ?? 0;
        const events = dwell?.events ?? visitors;
        const retentionRate = totalPageVisitors > 0 ? Number(((visitors / totalPageVisitors) * 100).toFixed(1)) : 0;

        let dropOffFromPrevious: number | null = null;
        if (index > 0 && previousSectionVisitors !== null && previousSectionVisitors > 0) {
          dropOffFromPrevious = Number(
            (((previousSectionVisitors - visitors) / previousSectionVisitors) * 100).toFixed(1)
          );
        }
        previousSectionVisitors = visitors;

        let indicatorColor = 'text-zinc-300';
        if (visitors > 0) {
          if (retentionRate >= 60) indicatorColor = 'text-emerald-300 font-bold';
          else if (retentionRate >= 30) indicatorColor = 'text-sky-200 font-bold';
          else indicatorColor = 'text-amber-200 font-bold';
        }

        const dropOffText =
          index > 0 && dropOffFromPrevious !== null
            ? ` <span class="text-zinc-400">|</span> <span class="${dropOffFromPrevious > 30 ? 'text-rose-300 font-bold' : 'text-zinc-300'}">${dropOffFromPrevious > 0 ? '🔻-' : '🔼+'}${Math.abs(dropOffFromPrevious)}%</span>`
            : '';

        const nextSibling = el.nextElementSibling as HTMLElement | null;
        const hasInlineCta = nextSibling && nextSibling.tagName === 'A';

        const badge = document.createElement('span');
        const spacingClass = hasInlineCta ? 'shrink-0' : 'ml-2.5';
        badge.className = `dev-analytics-badge dev-heading-badge inline-flex items-center gap-1.5 ${spacingClass} px-2.5 py-1 rounded-lg text-[11px] font-mono tracking-tight cursor-default select-none border border-zinc-400/90 bg-zinc-500 text-white shadow-lg shadow-black/25 backdrop-blur-sm align-middle my-auto leading-none ring-1 ring-black/20`;
        badge.title = `Heading #${id} retention: ${retentionRate}% (${visitors}/${totalPageVisitors} dwellers, ${events} dwell events)`;

        const labelText = dwell && visitors > 0
          ? `👁️ <span class="${indicatorColor}">${visitors}</span><span class="text-zinc-300">/${totalPageVisitors}</span> <span class="text-zinc-200">(${retentionRate}%)</span>${dropOffText}`
          : `👁️ <span class="text-zinc-300">0/${totalPageVisitors}</span> <span class="text-zinc-300">(0%)</span>`;
        badge.innerHTML = labelText;

        if (hasInlineCta && nextSibling) {
          nextSibling.insertAdjacentElement('afterend', badge);
        } else {
          el.appendChild(badge);
        }
        this.createdBadges.push(badge);
      });

      // 2. Process Sections (macro sections via [data-page-section][id])
      const sectionElements = Array.from(
        document.querySelectorAll<HTMLElement>('[data-page-section][id]')
      ).filter((el) => {
        return (
          !el.closest('.preview-card') &&
          !el.closest('#presentation-player') &&
          !el.closest('#dev-analytics-container') &&
          !el.closest('dialog') &&
          !el.closest('[role="dialog"]') &&
          !el.closest('.modal')
        );
      });

      sectionElements.forEach((secEl) => {
        const id = secEl.id;
        if (!id) return;

        const dwell = sectionData[id];
        const visitors = dwell?.visitors ?? 0;
        const events = dwell?.events ?? visitors;
        const retentionRate = totalPageVisitors > 0 ? Number(((visitors / totalPageVisitors) * 100).toFixed(1)) : 0;

        let indicatorColor = 'text-zinc-300';
        if (visitors > 0) {
          if (retentionRate >= 60) indicatorColor = 'text-emerald-300 font-bold';
          else if (retentionRate >= 30) indicatorColor = 'text-sky-200 font-bold';
          else indicatorColor = 'text-amber-200 font-bold';
        }

        const badge = document.createElement('div');
        badge.className = `dev-analytics-badge dev-section-badge absolute top-3 right-3 sm:right-4 z-20 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-mono tracking-tight cursor-default select-none border border-zinc-400/90 bg-zinc-500 text-white shadow-lg shadow-black/25 backdrop-blur-sm leading-none ring-1 ring-black/20`;
        badge.title = `Section #${id} retention: ${visitors}/${totalPageVisitors} dwellers (${retentionRate}%), ${events} dwell events`;

        const labelText = dwell && visitors > 0
          ? `📍 <span class="text-white font-bold">#${id}</span> <span class="text-zinc-400">|</span> 👁️ <span class="${indicatorColor}">${visitors}</span><span class="text-zinc-300">/${totalPageVisitors}</span> <span class="text-zinc-200">(${retentionRate}%)</span>`
          : `📍 <span class="text-white font-bold">#${id}</span> <span class="text-zinc-400">|</span> 👁️ <span class="text-zinc-300">0/${totalPageVisitors}</span> <span class="text-zinc-300">(0%)</span>`;
        badge.innerHTML = labelText;

        // Directly attach the badge to the section element itself for 100% predictable, uniform positioning across all pages.
        secEl.classList.add('relative');
        secEl.appendChild(badge);
        this.createdBadges.push(badge);
      });

      // 3. Process Preview Cards
      const cardElements = document.querySelectorAll<HTMLElement>('.preview-card[data-card-id]');
      const allPages = data.pages || {};

      cardElements.forEach((cardEl) => {
        const cardId = cardEl.getAttribute('data-card-id');
        const collection = cardEl.getAttribute('data-collection') || 'content';
        if (!cardId) return;

        const metrics = cardData[cardId] || { id: cardId, views: 0, clicks: 0, ctr: 0 };

        // Resolve target content path and look up metrics
        const targetPath = this.resolveCardTargetPath(cardEl, cardId, collection);
        let targetPage: { visitors: number; pageviews: number } | null = null;
        if (targetPath) {
          const norm = targetPath.toLowerCase();
          const clean = norm.replace(/\/$/, '');
          const withSlash = clean + '/';
          targetPage =
            allPages[withSlash] ||
            allPages[clean] ||
            allPages[withSlash.replace(/_/g, '-')] ||
            allPages[clean.replace(/_/g, '-')] ||
            allPages[withSlash.replace(/-/g, '_')] ||
            allPages[clean.replace(/-/g, '_')] ||
            null;
        }

        const targetVisitors = targetPage?.visitors ?? 0;
        const targetViews = targetPage?.pageviews ?? 0;

        let ctrColor = 'text-zinc-300';
        if (metrics.views > 0) {
          if (metrics.ctr >= 5) ctrColor = 'text-emerald-300 font-bold';
          else if (metrics.ctr >= 2) ctrColor = 'text-sky-200 font-bold';
          else ctrColor = 'text-amber-200 font-bold';
        }

        const badge = document.createElement('div');
        badge.className = `dev-analytics-badge dev-card-badge absolute top-3 right-3 z-30 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-mono tracking-tight border border-zinc-400/90 bg-zinc-500 text-white shadow-lg shadow-black/25 backdrop-blur-sm pointer-events-auto cursor-default select-none leading-none ring-1 ring-black/20`;
        badge.title = `Card CTR: ${metrics.ctr}% (${metrics.clicks} clicks / ${metrics.views} impressions) | Target: ${targetVisitors} visitors (${targetViews} views)`;

        const labelText = `🎯 <span class="${ctrColor}">${metrics.ctr}%</span> <span class="text-zinc-200">(${metrics.clicks}c/${metrics.views}i)</span> <span class="text-zinc-400">|</span> <span class="text-sky-200 font-bold">👥 ${targetVisitors}</span> <span class="text-zinc-200">(${targetViews}v)</span>`;
        badge.innerHTML = labelText;

        const style = window.getComputedStyle(cardEl);
        if (style.position === 'static') {
          cardEl.classList.add('relative');
        }

        cardEl.appendChild(badge);
        this.createdBadges.push(badge);
      });
    }

    private resolveCardTargetPath(cardEl: HTMLElement, cardId: string, collection: string): string | null {
      // 1. Search for internal anchor link inside card (or card element itself)
      const anchors = Array.from(cardEl.querySelectorAll<HTMLAnchorElement>('a[href]'));
      if (cardEl instanceof HTMLAnchorElement && cardEl.hasAttribute('href')) {
        anchors.unshift(cardEl);
      }
      for (const a of anchors) {
        if (a.closest('.tag-chip') || a.hasAttribute('data-tag')) continue;
        const href = a.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || href.includes('/tags/')) continue;
        try {
          if (href.startsWith('http://') || href.startsWith('https://')) {
            const parsed = new URL(href);
            if (parsed.hostname === window.location.hostname || parsed.hostname.endsWith('hackenberg.tech')) {
              const cleanPath = parsed.pathname.toLowerCase();
              return cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;
            }
            continue;
          }
          const cleanPath = href.split('?')[0].split('#')[0].toLowerCase();
          return cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;
        } catch {
          // ignore malformed URLs
        }
      }

      // 2. Candidate fallbacks based on collection and cardId
      if (collection && cardId) {
        return `/${collection.toLowerCase()}/${cardId.toLowerCase()}/`;
      }

      return null;
    }
  }

  // Initialize singleton on client only inside iframe
  if (typeof window !== 'undefined') {
    if (window.self === window.top) {
      document.getElementById('dev-analytics-container')?.remove();
    } else {
      // Inside iframe: clean up duplicate HUD and fullview modals (handled by outer DevStudioShell)
      document.getElementById('dev-analytics-hud')?.remove();
      document.getElementById('dev-analytics-fullview')?.remove();

      const manager = new DevAnalyticsManager();
      manager.init();
      document.addEventListener('astro:page-load', () => {
        manager.onPageLoad();
      });
    }
  }
</script>
