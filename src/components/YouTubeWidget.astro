---
// YouTubeWidget.astro
// Build-time server-side YouTube Widget using Astro Collections.
// Pre-renders content to static HTML.

import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import { formatCount } from "../scripts/format";
import type { ImageMetadata } from "astro";

interface YouTubeVideo {
  title: string;
  id?: string | null;
  pubDate: Date;
  image: ImageMetadata | null | undefined;
  description: string;
  views: number;
  likes: number;
}

interface YouTubeStats {
  subscribers: string;
}

let videos: YouTubeVideo[] = [];
let stats: YouTubeStats | null = null;
let buildError: string | null = null;
let syncRequired = false;

try {
  const profileEntry = await getEntry("youtube-profile", "profile");
  if (profileEntry) {
    stats = profileEntry.data;
  }

  const videosCollection = await getCollection("youtube-videos");
  if (videosCollection && videosCollection.length > 0) {
    const publishedVideos = videosCollection.filter(entry => entry.id);
    const rawVideos = publishedVideos.map(entry => {
      return {
        title: entry.data.title,
        id: entry.id,
        pubDate: entry.data.pubDate ?? new Date(),
        image: entry.data.image,
        description: entry.data.description || "",
        views: entry.data.views,
        likes: entry.data.likes
      };
    });
    videos = rawVideos.sort((a, b) => (b.views ?? 0) - (a.views ?? 0));
  }

  if (!stats || videos.length === 0) {
    syncRequired = true;
  }
} catch (error) {
  const err = error instanceof Error ? error : new Error(String(error));
  console.warn(`[YouTubeWidget Build Warning] Failed to load data from collection: ${err.message}`);
  buildError = err.message;
}
---

{buildError ? (
  /* YouTube Error Card */
  <div class="glass-card p-4 sm:p-6 rounded-3xl border border-red-500/20 h-full flex flex-col justify-between relative overflow-hidden group">
    <!-- Accent line for error state -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-red-500/80"></div>
    
    <div>
      <!-- Widget Header -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center space-x-3">
          <div class="p-2 rounded-xl bg-red-500/10 border border-red-500/20">
            <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.507 9.388.507 9.388.507s7.518 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </div>
          <h3 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100">YouTube</h3>
        </div>
        <span class="text-xs text-red-500 bg-red-500/10 px-2.5 py-0.5 rounded-full border border-red-500/20 font-bold uppercase tracking-wider">
          Failed
        </span>
      </div>

      <div class="flex flex-col items-center justify-center text-center py-10">
        <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 text-lg mb-4">
          ⚠️
        </div>
        <h4 class="text-base font-bold text-gray-100 mb-2">Build-Time Error</h4>
        <p class="text-sm text-gray-400 leading-relaxed max-w-[220px]">
          Could not load local collection. {buildError}
        </p>
      </div>
    </div>

    <!-- Fallback CTA Button (Direct Channel Link) -->
    <div class="mt-6 pt-4 border-t border-element-border">
      <a 
        href="https://youtube.com/@georghackenberg" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center space-x-2 py-2.5 text-xs sm:text-sm font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 border border-element-border-medium hover:border-element-border-hover transition-all duration-300"
      >
        <span>Open YouTube Channel</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>
  </div>
) : syncRequired ? (
  /* YouTube Sync Required Card */
  <div class="glass-card p-4 sm:p-6 rounded-3xl border border-yellow-500/20 h-full flex flex-col justify-between relative overflow-hidden group">
    <!-- Accent line for sync required state -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-yellow-500/80"></div>
    
    <div>
      <!-- Widget Header -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center space-x-3">
          <div class="p-2 rounded-xl bg-yellow-500/10 border border-yellow-500/20">
            <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.507 9.388.507 9.388.507s7.518 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </div>
          <h3 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100">YouTube</h3>
        </div>
        <span class="text-xs text-yellow-500 bg-yellow-500/10 px-2.5 py-0.5 rounded-full border border-yellow-500/20 font-bold uppercase tracking-wider">
          Sync Required
        </span>
      </div>

      <div class="flex flex-col items-center justify-center text-center py-10">
        <div class="w-12 h-12 rounded-full bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center text-yellow-500 text-lg mb-4">
          ⚙️
        </div>
        <h4 class="text-base font-bold text-gray-100 mb-2">No Local Data Found</h4>
        <p class="text-sm text-gray-400 leading-relaxed max-w-[220px]">
          Please run <code class="bg-element-bg-hover px-1.5 py-0.5 rounded text-yellow-400 font-mono text-xs">npm run sync</code> locally to populate the YouTube feed.
        </p>
      </div>
    </div>

    <!-- Fallback CTA Button (Direct Channel Link) -->
    <div class="mt-6 pt-4 border-t border-element-border">
      <a 
        href="https://youtube.com/@georghackenberg" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center space-x-2 py-2.5 text-xs sm:text-sm font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 border border-element-border-medium hover:border-element-border-hover transition-all duration-300"
      >
        <span>Open YouTube Channel</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>
  </div>
) : stats && videos.length > 0 && (
  /* YouTube Active Content Card */
  <div class="glass-card p-5 sm:p-6 md:p-8 rounded-3xl border border-element-border h-full relative overflow-hidden group">
    <!-- Brand accent header color block -->
    <div class="absolute top-0 left-0 right-0 h-1.5 bg-brand-green opacity-50 group-hover:opacity-100 transition-opacity"></div>

    <!-- Widget Card Header with Integrated Stats -->
    <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-element-border/60">
      <div class="flex items-center space-x-3">
        <div class="p-2.5 rounded-xl bg-brand-green/10 border border-brand-green/20">
          <svg class="w-6 h-6 text-brand-green shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.507 9.388.507 9.388.507s7.518 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <h3 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100">YouTube</h3>
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-element-bg border border-element-border text-gray-300 font-mono">
            {videos.length} Videos &bull; {stats.subscribers} Subscribers
          </span>
        </div>
      </div>
    </div>
    
    <!-- Main Card Body: Recent Videos Feed -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {videos.slice(0, 3).map((video, index) => (
        <div class={index === 2 ? 'h-full hidden sm:hidden lg:flex flex-col' : 'h-full flex flex-col'}>
          <a 
            href={`https://youtube.com/watch?v=${video.id}`}
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full flex flex-col items-stretch rounded-2xl bg-element-bg hover:bg-element-bg-hover border border-element-border hover:border-brand-green/30 transition-all duration-300 group/item cursor-pointer overflow-hidden p-0 flex-grow"
          >
            <div class="relative w-full aspect-video shrink-0 bg-gray-900 light:bg-slate-100 border-b border-element-border group-hover/item:border-brand-green/30 flex items-center justify-center overflow-hidden rounded-t-2xl">
            {video.image ? (
              <>
                <Image 
                  src={video.image} 
                  alt=""
                  width={480}
                  height={360}
                  class="absolute inset-0 w-full h-full object-cover group-hover/item:scale-105 transition-transform duration-300 z-0 will-change-transform pointer-events-none" 
                />
                <div class="absolute inset-0 bg-gradient-to-br from-[#111827] to-[#051e14]/40 light:from-[#111827]/60 light:to-[#051e14]/20 z-10 pointer-events-none"></div>
                <div class="absolute inset-0 flex items-center justify-center z-20 opacity-80 group-hover/item:opacity-100 transition-opacity pointer-events-none">
                  <svg class="w-8 h-8 md:w-10 md:h-10 text-brand-green group-hover/item:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </>
            ) : (
              <>
                <div class="absolute inset-0 bg-gradient-to-br from-green-900/60 to-emerald-950/80 light:from-green-100/60 light:to-emerald-50/80 z-10"></div>
                <svg class="w-9 h-9 text-brand-green/50 group-hover/item:text-brand-green/80 transition-colors z-20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.507a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.507 9.388.507 9.388.507s7.518 0 9.388-.507a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </>
            )}
            </div>
            <div class="flex-grow min-w-0 p-4 sm:p-5 md:p-6 flex flex-col justify-center select-none">
            <p class="text-base sm:text-lg md:text-xl font-semibold text-gray-100 group-hover/item:text-brand-green transition-colors line-clamp-1 font-sans leading-snug">
              {video.title}
            </p>
            <p class="text-sm sm:text-base text-gray-300 light:text-slate-600 line-clamp-2 mt-1.5 sm:mt-2 leading-relaxed font-sans font-normal">
              {video.description}
            </p>
            <div class="flex items-center space-x-3 text-xs sm:text-sm text-gray-400 mt-3 font-medium select-none">
              <span>👁️ {formatCount(video.views)}</span>
              <span>&bull;</span>
              <span>👍 {formatCount(video.likes)}</span>
              <span>&bull;</span>
              <span>{new Date(video.pubDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
            </div>
          </div>
          </a>
        </div>
      ))}
    </div>

    <!-- Card Footer: CTA Action Button -->
    <div class="mt-5 pt-4 border-t border-element-border/60">
      <a 
        href="https://youtube.com/@georghackenberg" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center space-x-2 py-3 px-4 text-xs sm:text-sm font-semibold rounded-xl bg-brand-green/15 hover:bg-brand-green/30 text-brand-green border border-brand-green/30 hover:border-brand-green/50 transition-all duration-300"
      >
        <span>Subscribe on YouTube</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
)}
