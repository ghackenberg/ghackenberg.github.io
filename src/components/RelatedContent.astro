---
import { getRelatedContent, type ContentCollectionName } from "@commons/server/related-content";
import Section from "@components/Section.astro";
import Container from "@components/Container.astro";
import CompactRelatedCard from "@components/CompactRelatedCard.astro";

interface Props {
  currentCollection: ContentCollectionName;
  currentId: string;
  tags?: string[];
  class?: string;
}

const {
  currentCollection,
  currentId,
  tags = [],
  class: className = "",
} = Astro.props;

const related = await getRelatedContent({
  currentCollection,
  currentId,
  tags,
});

const rankedItems = related.ranked;
---

{rankedItems.length > 0 && (
  <Section id="related-content" as="aside" border="top" padding="standard" class={`relative z-10 ${className}`} aria-label="Related Content">
    <Container size="wide" padding="none" class="space-y-6 sm:space-y-8">
      <div class="max-w-2xl">
        <h2 id="related-content-heading" class="text-2xl md:text-3xl font-extrabold tracking-tight text-gray-100 light:text-slate-900 mb-2.5 flex items-center gap-3">
          <span>Related <span class="heading-gradient-brand">Content</span></span>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-element-bg border border-element-border-medium text-gray-400 light:text-slate-500">
            {rankedItems.length}
          </span>
        </h2>
        <p class="text-gray-400 light:text-slate-600 text-sm md:text-base font-normal leading-relaxed">
          Discovered and ranked automatically based on shared topic tags. Matching tags are highlighted to reveal direct connections across articles, courses, projects, publications, and visualizations.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-3.5 sm:gap-4 auto-rows-fr">
        {rankedItems.map((entry) => {
          switch (entry.collection) {
            case "interests": {
              const item = entry.item;
              return (
                <CompactRelatedCard
                  id={item.id}
                  href={`/interests/${item.id}/`}
                  title={item.data.title}
                  description={item.data.description}
                  date={item.data.pubDate}
                  collection="interests"
                  color="rose"
                  image={item.data.heroImage}
                  fallbackIcon={item.data.icon || "🎯"}
                  tags={item.data.tags}
                  activeTag={tags}
                />
              );
            }
            case "posts": {
              const item = entry.item;
              return (
                <CompactRelatedCard
                  id={item.id}
                  href={`/posts/${item.id}/`}
                  title={item.data.title}
                  description={item.data.description}
                  date={item.data.pubDate}
                  collection="posts"
                  color="blue"
                  image={item.data.icon}
                  fallbackIcon="✍️"
                  tags={item.data.tags}
                  activeTag={tags}
                />
              );
            }
            case "publications": {
              const item = entry.item;
              return (
                <CompactRelatedCard
                  id={item.id}
                  href={`/publications/${item.id}/`}
                  title={item.data.title}
                  description={item.data.abstract || item.data.book || `Publication by ${item.data.author}`}
                  date={item.data.pubDate}
                  collection="publications"
                  color="indigo"
                  image={item.data.icon}
                  fallbackIcon="📚"
                  tags={item.data.tags}
                  activeTag={tags}
                />
              );
            }
            case "presentations": {
              const item = entry.item;
              return (
                <CompactRelatedCard
                  id={item.id}
                  href={`/presentations/${item.id}/`}
                  title={item.data.title}
                  description={item.data.description || item.data.subtitle}
                  date={item.data.pubDate}
                  collection="presentations"
                  color="cyan"
                  image={item.data.previewImage}
                  fallbackIcon="🖥️"
                  tags={item.data.tags}
                  activeTag={tags}
                />
              );
            }
            case "courses": {
              const item = entry.item;
              return (
                <CompactRelatedCard
                  id={item.id}
                  href={`/courses/${item.id}/`}
                  title={item.data.title}
                  description={item.data.description}
                  date={item.data.pubDate || item.data.terms?.[0]}
                  collection="courses"
                  color="yellow"
                  image={item.data.screenshot}
                  fallbackIcon="🎓"
                  tags={item.data.tags}
                  activeTag={tags}
                />
              );
            }
            case "projects": {
              const item = entry.item;
              return (
                <CompactRelatedCard
                  id={item.id}
                  href={`/projects/${item.id}/`}
                  title={item.data.title}
                  description={item.data.description}
                  date={item.data.pubDate}
                  collection="projects"
                  color="emerald"
                  image={item.data.screenshot}
                  fallbackIcon="🚀"
                  tags={item.data.tags}
                  activeTag={tags}
                />
              );
            }
            case "services": {
              const item = entry.item;
              return (
                <CompactRelatedCard
                  id={item.id}
                  href={`/services/${item.id}/`}
                  title={item.data.title}
                  description={item.data.description}
                  date={item.data.pubDate}
                  collection="services"
                  color="purple"
                  image={item.data.previewImage}
                  fallbackIcon="💼"
                  tags={item.data.tags}
                  activeTag={tags}
                />
              );
            }
            case "visualizations": {
              const item = entry.item;
              return (
                <CompactRelatedCard
                  id={item.id}
                  href={`/visualizations/${item.id}/`}
                  title={item.data.title}
                  description={item.data.description}
                  date={item.data.pubDate}
                  collection="visualizations"
                  color="teal"
                  image={item.data.screenshot}
                  fallbackIcon="🌐"
                  tags={item.data.tags}
                  activeTag={tags}
                />
              );
            }
          }
        })}
      </div>
    </Container>
  </Section>
)}
