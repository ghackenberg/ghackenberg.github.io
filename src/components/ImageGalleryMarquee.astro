---
export interface GalleryItem {
  id: string;
  title: string;
  image: string;
  href: string;
  tagline?: string;
  pubDate: number;
  imageTitle: string;
  imageDescription: string;
}

interface Props {
  catalog: GalleryItem[];
}

const { catalog } = Astro.props;

// Select distinct initial items for the 3 rows: 12 for row 1, 15 for row 2, 18 for row 3 (45 distinct items total)
const initialRow1 = catalog.slice(0, 12);
const initialRow2 = catalog.slice(12, 27);
const initialRow3 = catalog.slice(27, 45);

function getBadgeColor(href: string): string {
  if (href.startsWith('/courses/')) return 'badge-new-yellow';
  if (href.startsWith('/services/')) return 'badge-new-purple';
  if (href.startsWith('/visualizations/')) return 'badge-new-green';
  return 'badge-new-blue';
}
---

<section id="gallery" class="w-full pb-12 md:pb-16 scroll-mt-20 overflow-hidden relative">
  <!-- Section Header (Aligned to standard grid max-w-6xl) -->
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <div class="border-t border-white/5 pt-12 md:pt-16 mb-8">
      <div>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-gray-100 mb-4">
          Content <span class="heading-gradient-brand">Gallery</span>
        </h2>
        <p class="text-gray-400 text-sm md:text-base max-w-2xl font-normal leading-relaxed">
          A multi-tier perspective preview across articles, interactive platforms, academic courses, business services, and scientific models.
        </p>
      </div>
    </div>
  </div>

  <!-- Multi-Tier Parallax Viewport (Edge-to-Edge) -->
  <div id="gallery-marquee-viewport" class="gallery-viewport w-full overflow-hidden py-2 select-none relative space-y-4 sm:space-y-5">
    
    <!-- Row 1: Foreground (Largest Cards, Speed ~65px/s) -->
    <div id="gallery-marquee-track-1" class="gallery-track gallery-track-1 flex gap-6 w-max" data-speed="65" data-gap="24">
      {initialRow1.map(item => (
        <a
          href={item.href}
          data-id={item.id}
          class="gallery-card group relative w-64 sm:w-72 md:w-80 aspect-video shrink-0 rounded-2xl overflow-hidden glass-card border border-white/10 light:border-slate-200/80 hover:border-white/35 light:hover:border-brand-blue/60 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
        >
          <img
            src={item.image}
            alt={item.imageDescription}
            title={item.imageTitle}
            width="640"
            height="360"
            class="gallery-card-img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/50 to-transparent opacity-95 pointer-events-none" />
          <span
            class={`gallery-badge unread-dot hidden badge-new ${getBadgeColor(item.href)}`}
            data-item-url={item.href}
            title="Unread"
          >UNREAD</span>
          <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5 flex items-end justify-between pointer-events-none z-10">
            <div class="pr-3 min-w-0 flex-1">
              <h3 class="gallery-card-title text-sm sm:text-base font-bold text-white group-hover:text-blue-200 transition-colors truncate drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]" title={item.title}>
                {item.title}
              </h3>
              <p class="gallery-card-tagline text-xs text-slate-200 line-clamp-1 font-normal mt-1 drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]" style={item.tagline ? "" : "display: none;"}>
                {item.tagline || ""}
              </p>
            </div>
            <div class="w-7 h-7 shrink-0 rounded-lg glass-card border border-white/20 bg-white/10 flex items-center justify-center text-white/80 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-300">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Row 2: Midground (Medium Cards, Speed ~42px/s) -->
    <div id="gallery-marquee-track-2" class="gallery-track gallery-track-2 flex gap-5 w-max" data-speed="42" data-gap="20">
      {initialRow2.map(item => (
        <a
          href={item.href}
          data-id={item.id}
          class="gallery-card group relative w-52 sm:w-60 md:w-64 aspect-video shrink-0 rounded-xl overflow-hidden glass-card border border-white/10 light:border-slate-200/80 hover:border-white/35 light:hover:border-brand-blue/60 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1.5 block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
        >
          <img
            src={item.image}
            alt={item.imageDescription}
            title={item.imageTitle}
            width="640"
            height="360"
            class="gallery-card-img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/50 to-transparent opacity-95 pointer-events-none" />
          <span
            class={`gallery-badge unread-dot hidden badge-new ${getBadgeColor(item.href)}`}
            data-item-url={item.href}
            title="Unread"
          >UNREAD</span>
          <div class="absolute inset-x-0 bottom-0 p-3.5 sm:p-4 flex items-end justify-between pointer-events-none z-10">
            <div class="pr-2 min-w-0 flex-1">
              <h3 class="gallery-card-title text-xs sm:text-sm font-bold text-white group-hover:text-blue-200 transition-colors truncate drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]" title={item.title}>
                {item.title}
              </h3>
              <p class="gallery-card-tagline text-[11px] text-slate-200 line-clamp-1 font-normal mt-0.5 drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]" style={item.tagline ? "" : "display: none;"}>
                {item.tagline || ""}
              </p>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Row 3: Background (Smallest Cards, Speed ~26px/s) -->
    <div id="gallery-marquee-track-3" class="gallery-track gallery-track-3 flex gap-4 w-max" data-speed="26" data-gap="16">
      {initialRow3.map(item => (
        <a
          href={item.href}
          data-id={item.id}
          class="gallery-card group relative w-40 sm:w-48 md:w-52 aspect-video shrink-0 rounded-lg overflow-hidden glass-card border border-white/10 light:border-slate-200/80 hover:border-white/35 light:hover:border-brand-blue/60 shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
        >
          <img
            src={item.image}
            alt={item.imageDescription}
            title={item.imageTitle}
            width="640"
            height="360"
            class="gallery-card-img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/50 to-transparent opacity-95 pointer-events-none" />
          <span
            class={`gallery-badge unread-dot hidden badge-new ${getBadgeColor(item.href)}`}
            data-item-url={item.href}
            title="Unread"
          >UNREAD</span>
          <div class="absolute inset-x-0 bottom-0 p-2.5 sm:p-3 flex items-end justify-between pointer-events-none z-10">
            <h3 class="gallery-card-title text-[11px] sm:text-xs font-semibold text-white group-hover:text-blue-200 transition-colors truncate drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)]" title={item.title}>
              {item.title}
            </h3>
          </div>
        </a>
      ))}
    </div>

  </div>

  <!-- Full catalog embedded for client-side continuous recycling -->
  <script is:inline type="application/json" id="gallery-catalog-data" set:html={JSON.stringify(catalog)} />
</section>

<style>
  /* Edge fade overlays: GPU-friendly linear gradient overlays instead of heavy off-screen alpha mask */
  .gallery-viewport {
    position: relative;
    touch-action: pan-y;
    cursor: grab;
  }

  .gallery-viewport.is-dragging,
  .gallery-viewport.is-dragging * {
    cursor: grabbing !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  .gallery-card {
    cursor: pointer;
  }

  .gallery-card-img {
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .gallery-viewport::before,
  .gallery-viewport::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(24px, 6vw, 80px);
    z-index: 20;
    pointer-events: none;
  }

  .gallery-viewport::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg-main) 0%, transparent 100%);
  }

  .gallery-viewport::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg-main) 0%, transparent 100%);
  }

  .gallery-track {
    will-change: transform;
  }

  /* Marquee cards are 100% covered by opaque image + dark gradient overlay; disable expensive backdrop-filter */
  .gallery-card,
  .gallery-card .glass-card {
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
  }

  /* Accessibility: Prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .gallery-viewport::before,
    .gallery-viewport::after {
      display: none;
    }

    .gallery-track {
      transform: none !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      width: 100%;
      padding-inline: 1rem;
      scrollbar-width: thin;
    }

    .gallery-card {
      scroll-snap-align: start;
    }
  }
</style>

<script>
  import type { GalleryItem } from './ImageGalleryMarquee.astro';

  interface TrackState {
    el: HTMLElement;
    speed: number;
    gap: number;
    x: number;
    cardWidthWithGap: number;
  }

  let activeAnimationId: number | null = null;
  let galleryObserver: IntersectionObserver | null = null;
  let saveLedgerTimer: number | null = null;
  let inMemorySeenLedger: Record<string, number> = {};
  let abortController: AbortController | null = null;

  function loadSeenLedger(): Record<string, number> {
    try {
      const raw = localStorage.getItem('gh_gallery_impressions');
      if (raw) {
        return JSON.parse(raw);
      }
    } catch {
      // Ignore localStorage access failures in restricted environments
    }
    return {};
  }

  function scheduleSaveLedger() {
    if (saveLedgerTimer !== null) return;
    saveLedgerTimer = window.setTimeout(() => {
      saveLedgerTimer = null;
      try {
        localStorage.setItem('gh_gallery_impressions', JSON.stringify(inMemorySeenLedger));
      } catch {
        // Quota exceeded or private browsing
      }
    }, 1000);
  }

  function recordSeen(id: string) {
    inMemorySeenLedger[id] = Date.now();
    scheduleSaveLedger();
  }

  function pickNextItem(
    catalog: GalleryItem[],
    inUseIds: Set<string>,
    seenLedger: Record<string, number>
  ): GalleryItem {
    let candidates = catalog.filter(item => !inUseIds.has(item.id));
    if (candidates.length === 0) {
      candidates = catalog;
    }

    const now = Date.now();
    const weights: number[] = [];
    let totalWeight = 0;

    for (const item of candidates) {
      // 1. Content publication recency factor
      const ageYears = Math.max(0, (now - item.pubDate) / (1000 * 60 * 60 * 24 * 365.25));
      const contentFactor = 1 / (1 + 0.25 * ageYears);

      // 2. Display recency factor (LRU tracking)
      const lastSeen = seenLedger[item.id];
      let displayFactor = 1.0;
      if (!lastSeen) {
        // High boost to display unseen items
        displayFactor = 12.0;
      } else {
        const minutesSinceSeen = (now - lastSeen) / 60000;
        if (minutesSinceSeen < 12) {
          // Strict cooldown for recently viewed items
          displayFactor = 0.05;
        } else {
          // Smooth restoration over the subsequent 48 minutes
          displayFactor = Math.min(1.0, 0.05 + 0.95 * ((minutesSinceSeen - 12) / 48));
        }
      }

      const weight = contentFactor * displayFactor;
      weights.push(weight);
      totalWeight += weight;
    }

    let random = Math.random() * totalWeight;
    for (let i = 0; i < candidates.length; i++) {
      random -= weights[i];
      if (random <= 0 || i === candidates.length - 1) {
        return candidates[i];
      }
    }

    return candidates[0];
  }

  function getBadgeColor(href: string): string {
    if (href.startsWith('/courses/')) return 'badge-new-yellow';
    if (href.startsWith('/services/')) return 'badge-new-purple';
    if (href.startsWith('/visualizations/')) return 'badge-new-green';
    return 'badge-new-blue';
  }

  function getVisitedItems(): Record<string, number> {
    try {
      const raw = localStorage.getItem('gh_site_notifications_v1');
      if (raw) {
        const parsed = JSON.parse(raw);
        return parsed.visitedItems || {};
      }
    } catch {
      // Storage access failure
    }
    return {};
  }

  function isPathVisited(path: string, visitedMap: Record<string, number>): boolean {
    let normalized = path.replace(/\/$/, '');
    if (!normalized.startsWith('/')) {
      normalized = '/' + normalized;
    }
    return !!visitedMap[normalized];
  }

  let visitedItemsCache: Record<string, number> = {};

  function refreshVisitedItemsCache() {
    visitedItemsCache = getVisitedItems();
  }

  function hydrateCard(card: HTMLElement, item: GalleryItem) {
    card.dataset.id = item.id;
    card.setAttribute('href', item.href);

    const img = card.querySelector<HTMLImageElement>('.gallery-card-img');
    if (img) {
      img.src = item.image;
      img.alt = item.imageDescription;
      img.title = item.imageTitle;
    }

    const title = card.querySelector<HTMLElement>('.gallery-card-title');
    if (title) {
      title.textContent = item.title;
      title.setAttribute('title', item.title);
    }

    const tagline = card.querySelector<HTMLElement>('.gallery-card-tagline');
    if (tagline) {
      if (item.tagline) {
        tagline.textContent = item.tagline;
        tagline.style.display = '';
      } else {
        tagline.textContent = '';
        tagline.style.display = 'none';
      }
    }

    const badge = card.querySelector<HTMLElement>('.gallery-badge');
    if (badge) {
      badge.setAttribute('data-item-url', item.href);
      badge.classList.remove('badge-new-blue', 'badge-new-yellow', 'badge-new-purple', 'badge-new-green');
      badge.classList.add(getBadgeColor(item.href));

      const isVisited = isPathVisited(item.href, visitedItemsCache);
      if (!isVisited) {
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }
  }

  function setupGalleryEngine() {
    if (activeAnimationId !== null) {
      cancelAnimationFrame(activeAnimationId);
      activeAnimationId = null;
    }
    if (galleryObserver !== null) {
      galleryObserver.disconnect();
      galleryObserver = null;
    }
    if (abortController !== null) {
      abortController.abort();
      abortController = null;
    }

    const viewport = document.getElementById('gallery-marquee-viewport');
    const catalogDataEl = document.getElementById('gallery-catalog-data');

    if (!viewport || !catalogDataEl) return;

    let catalog: GalleryItem[] = [];
    try {
      catalog = JSON.parse(catalogDataEl.textContent || '[]');
    } catch {
      return;
    }

    if (!catalog.length) return;

    abortController = new AbortController();
    const { signal } = abortController;

    inMemorySeenLedger = loadSeenLedger();
    refreshVisitedItemsCache();

    // 1. Full Client-Side Rehydration:
    const inUseIds = new Set<string>();
    const initialCards = viewport.querySelectorAll<HTMLElement>('.gallery-card');

    initialCards.forEach(card => {
      const nextItem = pickNextItem(catalog, inUseIds, inMemorySeenLedger);
      inUseIds.add(nextItem.id);
      hydrateCard(card, nextItem);
      recordSeen(nextItem.id);
    });

    const trackElements = viewport.querySelectorAll<HTMLElement>('.gallery-track');
    const tracks: TrackState[] = [];

    trackElements.forEach(el => {
      const speed = parseFloat(el.dataset.speed || '40');
      const gap = parseFloat(el.dataset.gap || '20');

      // Measure initial card width once during setup to avoid synchronous layout reads during animation
      const firstCard = el.firstElementChild as HTMLElement | null;
      const initialCardWidth = firstCard ? firstCard.getBoundingClientRect().width : 280;

      tracks.push({
        el,
        speed,
        gap,
        x: 0,
        cardWidthWithGap: initialCardWidth + gap,
      });

      // Ensure track buffer covers ultra-wide displays
      while (el.children.length > 0 && el.scrollWidth < window.innerWidth + 1200) {
        const nextItem = pickNextItem(catalog, inUseIds, inMemorySeenLedger);
        inUseIds.add(nextItem.id);
        const template = el.firstElementChild as HTMLElement;
        if (!template) break;

        const clone = template.cloneNode(true) as HTMLElement;
        hydrateCard(clone, nextItem);
        recordSeen(nextItem.id);
        el.appendChild(clone);
      }
    });

    // Update cached card widths on resize without polling
    const onResize = () => {
      tracks.forEach(track => {
        const firstCard = track.el.firstElementChild as HTMLElement | null;
        if (firstCard) {
          track.cardWidthWithGap = firstCard.getBoundingClientRect().width + track.gap;
        }
      });
    };
    window.addEventListener('resize', onResize, { signal, passive: true });

    const TOTAL_IDLE_BEFORE_RESUME = 3000; // 3 seconds of inactivity before auto-resume

    // Direction of automatic motion: -1 (leftward/forward), 1 (rightward/backward)
    let autoDirection = -1;
    let isInteracting = false;
    let interactionEndTimer: number | null = null;
    let interactionEndTime = -TOTAL_IDLE_BEFORE_RESUME;

    function startInteraction() {
      isInteracting = true;
      interactionEndTime = 0;
      if (interactionEndTimer !== null) {
        window.clearTimeout(interactionEndTimer);
      }
      interactionEndTimer = window.setTimeout(() => {
        isInteracting = false;
        interactionEndTime = performance.now();
      }, 250);
    }

    // Bidirectional continuous card recycling
    function applyTrackOffset(track: TrackState, deltaX: number) {
      track.x += deltaX;

      // Moving leftwards: recycle from head to tail
      while (track.x <= -track.cardWidthWithGap) {
        track.x += track.cardWidthWithGap;
        const cardToRecycle = track.el.firstElementChild as HTMLElement | null;
        if (cardToRecycle) {
          const oldId = cardToRecycle.dataset.id;
          if (oldId) inUseIds.delete(oldId);

          const nextItem = pickNextItem(catalog, inUseIds, inMemorySeenLedger);
          inUseIds.add(nextItem.id);
          hydrateCard(cardToRecycle, nextItem);
          recordSeen(nextItem.id);

          track.el.appendChild(cardToRecycle);
        }
      }

      // Moving rightwards: recycle from tail to head
      while (track.x > 0) {
        track.x -= track.cardWidthWithGap;
        const cardToRecycle = track.el.lastElementChild as HTMLElement | null;
        if (cardToRecycle) {
          const oldId = cardToRecycle.dataset.id;
          if (oldId) inUseIds.delete(oldId);

          const nextItem = pickNextItem(catalog, inUseIds, inMemorySeenLedger);
          inUseIds.add(nextItem.id);
          hydrateCard(cardToRecycle, nextItem);
          recordSeen(nextItem.id);

          track.el.prepend(cardToRecycle);
        }
      }

      track.el.style.transform = `translate3d(${track.x}px, 0, 0)`;
    }

    // Parallax depth distribution across all 3 tiers + direction tracking
    function applyScrollParallax(deltaX: number, targetTrack: TrackState | null) {
      if (Math.abs(deltaX) > 0.5) {
        autoDirection = deltaX < 0 ? -1 : 1;
      }
      const baseTrack = targetTrack || tracks[0];
      const baseSpeed = baseTrack ? baseTrack.speed : 65;

      for (const track of tracks) {
        const ratio = baseSpeed > 0 ? track.speed / baseSpeed : 1.0;
        const trackDelta = deltaX * ratio;
        applyTrackOffset(track, trackDelta);
      }
    }

    function getTargetTrack(e: Event): TrackState {
      const target = e.target as HTMLElement | null;
      const trackEl = target?.closest('.gallery-track') as HTMLElement | null;
      if (trackEl) {
        const found = tracks.find(t => t.el === trackEl);
        if (found) return found;
      }

      const clientY = 'clientY' in e ? (e as MouseEvent).clientY : 0;
      if (clientY && tracks.length > 0) {
        let closestTrack = tracks[0];
        let minDistance = Infinity;
        for (const track of tracks) {
          const rect = track.el.getBoundingClientRect();
          const midY = (rect.top + rect.bottom) / 2;
          const dist = Math.abs(clientY - midY);
          if (dist < minDistance) {
            minDistance = dist;
            closestTrack = track;
          }
        }
        return closestTrack;
      }
      return tracks[0];
    }

    let isDocumentHidden = false;
    let isInView = false;
    let reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let isMouseOver = false;
    let lastPointerType = 'mouse';

    // Viewport hover, movement & focus events
    let lastMouseMoveX = 0;
    let lastMouseMoveY = 0;

    viewport.addEventListener('mouseenter', (e: MouseEvent) => {
      isMouseOver = true;
      lastMouseMoveX = e.clientX;
      lastMouseMoveY = e.clientY;
      startInteraction();
    }, { signal });

    viewport.addEventListener('mousemove', (e: MouseEvent) => {
      isMouseOver = true;
      if (Math.abs(e.clientX - lastMouseMoveX) > 3 || Math.abs(e.clientY - lastMouseMoveY) > 3) {
        lastMouseMoveX = e.clientX;
        lastMouseMoveY = e.clientY;
        startInteraction();
      }
    }, { signal, passive: true });

    viewport.addEventListener('mouseleave', () => {
      isMouseOver = false;
      if (!isPointerDown) {
        if (interactionEndTimer !== null) {
          window.clearTimeout(interactionEndTimer);
          interactionEndTimer = null;
        }
        isInteracting = false;
        interactionEndTime = -TOTAL_IDLE_BEFORE_RESUME;
      }
    }, { signal });

    viewport.addEventListener('focusin', () => {
      startInteraction();
    }, { signal });

    viewport.addEventListener('focusout', () => {
      if (!isPointerDown) {
        if (interactionEndTimer !== null) {
          window.clearTimeout(interactionEndTimer);
          interactionEndTimer = null;
        }
        isInteracting = false;
        interactionEndTime = -TOTAL_IDLE_BEFORE_RESUME;
      }
    }, { signal });

    // Media query listener
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const handleMotionChange = (e: MediaQueryListEvent) => {
      reducedMotion = e.matches;
    };
    motionQuery.addEventListener('change', handleMotionChange, { signal });

    // Tab visibility handler & storage sync
    const handleVisibilityChange = () => {
      isDocumentHidden = document.hidden;
      if (!isDocumentHidden) {
        refreshVisitedItemsCache();
        lastTime = null;
        if (isInView && activeAnimationId === null) {
          activeAnimationId = requestAnimationFrame(tick);
        }
      }
    };
    document.addEventListener('visibilitychange', handleVisibilityChange, { signal });
    window.addEventListener('storage', refreshVisitedItemsCache, { signal, passive: true });

    // 2. Horizontal Scrolling: Apple Touchpad & Classic Mouse Wheel (with Shift or tilt)
    viewport.addEventListener(
      'wheel',
      (e: WheelEvent) => {
        if (reducedMotion) return;

        // Check for horizontal gesture or Shift + scroll wheel
        const isShiftWheel = e.shiftKey && (e.deltaY !== 0 || e.deltaX !== 0);
        const isHorizontalScroll = Math.abs(e.deltaX) > Math.abs(e.deltaY);

        if (isShiftWheel || isHorizontalScroll) {
          let delta = e.deltaX !== 0 ? e.deltaX : (e.shiftKey ? e.deltaY : 0);

          if (e.deltaMode === 1) {
            delta *= 24; // Lines to pixels
          } else if (e.deltaMode === 2) {
            delta *= 200; // Pages to pixels
          }

          if (delta !== 0) {
            // Prevent browser back/forward swipe history navigation on macOS/Safari
            e.preventDefault();

            startInteraction();
            const targetTrack = getTargetTrack(e);
            applyScrollParallax(-delta, targetTrack);
          }
        }
      },
      { signal, passive: false }
    );

    // 3. Pointer & Touch Dragging with Momentum Glide
    let isPointerDown = false;
    let startX = 0;
    let startY = 0;
    let lastPointerX = 0;
    let lastPointerTime = 0;
    let pointerVelocity = 0;
    let momentumVelocity = 0;
    let activeDragTrack: TrackState | null = null;
    let dragPointerId: number | null = null;
    let hasDragged = false;

    viewport.addEventListener(
      'pointerdown',
      (e: PointerEvent) => {
        if (e.button !== 0 || reducedMotion) return;
        lastPointerType = e.pointerType;
        if (e.pointerType === 'mouse') {
          isMouseOver = true;
        }
        isPointerDown = true;
        hasDragged = false;
        startX = e.clientX;
        startY = e.clientY;
        lastPointerX = e.clientX;
        lastPointerTime = performance.now();
        pointerVelocity = 0;
        momentumVelocity = 0;
        activeDragTrack = getTargetTrack(e);
        dragPointerId = e.pointerId;
        startInteraction();
      },
      { signal }
    );

    window.addEventListener(
      'pointermove',
      (e: PointerEvent) => {
        if (!isPointerDown || e.pointerId !== dragPointerId || !activeDragTrack) return;

        const totalDx = Math.abs(e.clientX - startX);
        const totalDy = Math.abs(e.clientY - startY);

        if (!hasDragged) {
          if (totalDx > 6 && totalDx > totalDy) {
            hasDragged = true;
            viewport.classList.add('is-dragging');
          } else if (totalDy > 10) {
            // Allow natural vertical page scroll
            isPointerDown = false;
            dragPointerId = null;
            activeDragTrack = null;
            return;
          }
        }

        if (hasDragged) {
          const dx = e.clientX - lastPointerX;
          const now = performance.now();
          const dt = Math.max((now - lastPointerTime) / 1000, 0.001);
          pointerVelocity = dx / dt;
          lastPointerX = e.clientX;
          lastPointerTime = now;

          startInteraction();
          applyScrollParallax(dx, activeDragTrack);
        }
      },
      { signal, passive: true }
    );

    const onPointerEnd = (e: PointerEvent) => {
      if (e.pointerId !== dragPointerId) return;
      isPointerDown = false;
      dragPointerId = null;
      viewport.classList.remove('is-dragging');

      if (hasDragged) {
        if (Math.abs(pointerVelocity) > 60) {
          momentumVelocity = Math.max(-2000, Math.min(2000, pointerVelocity));
        }
        hasDragged = false;

        // Suppress unintentional click after drag
        const captureClick = (clickEvent: MouseEvent) => {
          clickEvent.preventDefault();
          clickEvent.stopPropagation();
          window.removeEventListener('click', captureClick, true);
        };
        window.addEventListener('click', captureClick, true);
        window.setTimeout(() => {
          window.removeEventListener('click', captureClick, true);
        }, 100);
      }

      if (e.pointerType === 'mouse' && !isMouseOver && Math.abs(momentumVelocity) <= 5) {
        if (interactionEndTimer !== null) {
          window.clearTimeout(interactionEndTimer);
          interactionEndTimer = null;
        }
        isInteracting = false;
        interactionEndTime = -TOTAL_IDLE_BEFORE_RESUME;
      } else {
        startInteraction();
      }
    };

    window.addEventListener('pointerup', onPointerEnd, { signal });
    window.addEventListener('pointercancel', onPointerEnd, { signal });
    viewport.addEventListener('dragstart', (e) => e.preventDefault(), { signal });

    // 4. Keyboard Arrow Key Navigation
    viewport.addEventListener(
      'keydown',
      (e: KeyboardEvent) => {
        if (reducedMotion) return;
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          startInteraction();
          applyScrollParallax(140, getTargetTrack(e));
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          startInteraction();
          applyScrollParallax(-140, getTargetTrack(e));
        }
      },
      { signal }
    );

    let lastTime: number | null = null;

    function tick(timestamp: number) {
      // 1. Off-screen check: If the viewport is not visible, stop scheduling frames completely!
      if (!isInView) {
        activeAnimationId = null;
        return;
      }

      if (lastTime === null) {
        lastTime = timestamp;
      }
      const dt = Math.min((timestamp - lastTime) / 1000, 0.1);
      lastTime = timestamp;

      // Apply drag momentum glide if present
      if (Math.abs(momentumVelocity) > 5) {
        const step = momentumVelocity * dt;
        applyScrollParallax(step, activeDragTrack || tracks[0]);
        momentumVelocity *= Math.pow(0.88, dt * 60);
        interactionEndTime = 0;
      } else {
        if (momentumVelocity !== 0) {
          momentumVelocity = 0;
          if (!isPointerDown && !isInteracting) {
            if (lastPointerType === 'mouse' && !isMouseOver) {
              interactionEndTime = -TOTAL_IDLE_BEFORE_RESUME;
            } else {
              interactionEndTime = timestamp;
            }
          }
        }
      }

      const isMotionActive = !isDocumentHidden && !reducedMotion;

      if (isMotionActive) {
        if (isPointerDown || isInteracting || Math.abs(momentumVelocity) > 5) {
          interactionEndTime = timestamp;
        } else {
          const elapsed = timestamp - interactionEndTime;
          if (elapsed >= TOTAL_IDLE_BEFORE_RESUME) {
            // Smooth continuous animation in the last scrolled direction
            for (const track of tracks) {
              applyTrackOffset(track, autoDirection * track.speed * dt);
            }
          }
        }
      }

      activeAnimationId = requestAnimationFrame(tick);
    }

    // IntersectionObserver: Pause completely when scrolled out of view to save 100% CPU/battery
    galleryObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const wasInView = isInView;
        isInView = entry.isIntersecting;
        if (isInView && !wasInView) {
          lastTime = null;
          if (activeAnimationId === null) {
            activeAnimationId = requestAnimationFrame(tick);
          }
        }
      });
    }, { rootMargin: '150px 0px' });

    galleryObserver.observe(viewport);
  }

  // Support Astro View Transitions and initial load
  setupGalleryEngine();
  document.addEventListener('astro:page-load', setupGalleryEngine);
  document.addEventListener('astro:before-swap', () => {
    if (activeAnimationId !== null) {
      cancelAnimationFrame(activeAnimationId);
      activeAnimationId = null;
    }
    if (galleryObserver !== null) {
      galleryObserver.disconnect();
      galleryObserver = null;
    }
    if (abortController !== null) {
      abortController.abort();
      abortController = null;
    }
  });
</script>
