---
// Background.astro
// Clear vector-style night sky background with responsive day/night color schemes,
// crescent moon, detailed sparkling starfield, shooting stars,
// and smooth scroll/mouse parallax effects on celestial elements.
---
<div class="background-container fixed inset-0 overflow-hidden pointer-events-none z-0 select-none">
  <!-- Twinkling Stars -->
  <svg id="bg-layer-stars" class="stars-svg absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
    <g id="sparkling-stars" class="transition-opacity duration-700"></g>
  </svg>

  <!-- Shooting Stars -->
  <div id="bg-layer-shooting-stars" class="shooting-stars-container absolute inset-0">
    <div class="shooting-star shooting-star-1"></div>
    <div class="shooting-star shooting-star-2"></div>
    <div class="shooting-star shooting-star-3"></div>
  </div>
</div>

<style>
  :root {
    --star-color: #fef9c3;
  }

  :global(.light) {
    --star-color: #64748b;
  }

  /* Base Container */
  .background-container {
    width: 100%;
    height: 100vh;
  }

  /* Twinkling Stars */
  .stars-svg {
    pointer-events: none;
    will-change: transform;
    transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.75;
  }
  :global(.light) .stars-svg {
    opacity: 0.55;
  }
  
  /* Twinkling CSS animation */
  :global(@keyframes twinkle) {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50% { opacity: 0.85; transform: scale(1.15); }
  }

  :global(@keyframes twinkle-hero) {
    0%, 100% { opacity: 0.3; transform: scale(0.7) rotate(0deg); }
    50% { opacity: 0.9; transform: scale(1.25) rotate(45deg); }
  }

  /* Shooting Stars */
  .shooting-stars-container {
    pointer-events: none;
    transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.65;
    will-change: transform;
  }
  :global(.light) .shooting-stars-container {
    opacity: 0.55;
  }
  .shooting-star {
    position: absolute;
    width: 90px;
    height: 1.5px;
    background: linear-gradient(to left, rgba(254, 249, 195, 0) 0%, rgba(254, 249, 195, 0.75) 100%);
    opacity: 0;
    pointer-events: none;
  }
  :global(.light) .shooting-star {
    background: linear-gradient(to left, rgba(100, 116, 139, 0) 0%, rgba(100, 116, 139, 0.65) 100%);
  }
  .shooting-star-1 {
    top: 8%;
    left: 70%;
    animation: shoot-1 16s infinite ease-in-out;
  }
  .shooting-star-2 {
    top: 22%;
    left: 55%;
    animation: shoot-2 20s infinite ease-in-out;
    animation-delay: 5s;
  }
  .shooting-star-3 {
    top: 4%;
    left: 85%;
    animation: shoot-3 24s infinite ease-in-out;
    animation-delay: 11s;
  }
  @keyframes shoot-1 {
    0% { transform: rotate(-35deg) translateX(0) scaleX(0); opacity: 0; }
    1% { opacity: 0.7; transform: rotate(-35deg) translateX(0) scaleX(1); }
    3% { transform: rotate(-35deg) translateX(-350px) scaleX(1); opacity: 0; }
    100% { transform: rotate(-35deg) translateX(-350px) scaleX(0); opacity: 0; }
  }
  @keyframes shoot-2 {
    0% { transform: rotate(-38deg) translateX(0) scaleX(0); opacity: 0; }
    1% { opacity: 0.65; transform: rotate(-38deg) translateX(0) scaleX(1); }
    3% { transform: rotate(-38deg) translateX(-280px) scaleX(1); opacity: 0; }
    100% { transform: rotate(-38deg) translateX(-280px) scaleX(0); opacity: 0; }
  }
  @keyframes shoot-3 {
    0% { transform: rotate(-32deg) translateX(0) scaleX(0); opacity: 0; }
    1% { opacity: 0.75; transform: rotate(-32deg) translateX(0) scaleX(1); }
    3.5% { transform: rotate(-32deg) translateX(-420px) scaleX(1); opacity: 0; }
    100% { transform: rotate(-32deg) translateX(-420px) scaleX(0); opacity: 0; }
  }
</style>

<script>
  function initBackground() {
    const starsLayer = document.getElementById('bg-layer-stars');
    const shootingStarsLayer = document.getElementById('bg-layer-shooting-stars');

    if (!starsLayer && !shootingStarsLayer) {
      return;
    }

    let targetScrollY = window.scrollY;
    let currentScrollY = window.scrollY;
    
    let targetMouseX = 0.5; // normalized 0 to 1
    let targetMouseY = 0.5;
    let currentMouseX = 0.5;
    let currentMouseY = 0.5;

    let ticking = false;

    // Scroll listener
    const onScroll = () => {
      targetScrollY = window.scrollY || document.documentElement.scrollTop;
      requestTick();
    };

    // Mouse movement listener
    const onMouseMove = (e: MouseEvent) => {
      targetMouseX = e.clientX / window.innerWidth;
      targetMouseY = e.clientY / window.innerHeight;
      requestTick();
    };

    // Touch listener for mobile
    const onTouchMove = (e: TouchEvent) => {
      if (e.touches && e.touches[0]) {
        targetMouseX = e.touches[0].clientX / window.innerWidth;
        targetMouseY = e.touches[0].clientY / window.innerHeight;
        requestTick();
      }
    };

    const requestTick = () => {
      if (!ticking) {
        requestAnimationFrame(updateFrame);
        ticking = true;
      }
    };

    const updateFrame = () => {
      const scrollLerp = 0.08;
      const mouseLerp = 0.08;

      currentScrollY += (targetScrollY - currentScrollY) * scrollLerp;
      currentMouseX += (targetMouseX - currentMouseX) * mouseLerp;
      currentMouseY += (targetMouseY - currentMouseY) * mouseLerp;

      // Normalized offset from center (-0.5 to 0.5)
      const normMouseX = currentMouseX - 0.5;
      const normMouseY = currentMouseY - 0.5;

      // 1. Celestial & Sky Parallax
      if (starsLayer) {
        starsLayer.style.transform = `translate3d(${normMouseX * 10}px, ${-currentScrollY * 0.035 + normMouseY * 10}px, 0)`;
      }
      if (shootingStarsLayer) {
        shootingStarsLayer.style.transform = `translate3d(0, ${-currentScrollY * 0.03}px, 0)`;
      }

      const scrollDiff = Math.abs(targetScrollY - currentScrollY);
      const mouseDiffX = Math.abs(targetMouseX - currentMouseX);
      const mouseDiffY = Math.abs(targetMouseY - currentMouseY);

      if (scrollDiff > 0.05 || mouseDiffX > 0.001 || mouseDiffY > 0.001) {
        requestAnimationFrame(updateFrame);
      } else {
        ticking = false;
      }
    };

    // Attach listeners
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('touchmove', onTouchMove, { passive: true });

    // Initial frame run
    requestTick();

    // High Density Night Sky Starfield Generator
    const starsGroup = document.getElementById('sparkling-stars');
    if (starsGroup) {
      starsGroup.innerHTML = '';
      const numStars = 140;
      const starColor = 'var(--star-color)';

      for (let i = 0; i < numStars; i++) {
        const cx = Math.random() * 100; // percent
        const cy = Math.random() * 75;  // upper 75% of sky
        const color = starColor;
        const delay = Math.random() * 6; // staggered delay
        const duration = Math.random() * 3.5 + 2.5; // star twinkle speed
        
        const isHeroStar = i % 18 === 0;

        if (isHeroStar) {
          // 4-point sparkle star SVG path
          const heroStar = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          const size = Math.random() * 5 + 4;
          heroStar.setAttribute('transform', `translate(${(cx / 100) * window.innerWidth}, ${(cy / 100) * window.innerHeight})`);
          
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('d', `M 0 -${size} Q 0 0 ${size} 0 Q 0 0 0 ${size} Q 0 0 -${size} 0 Q 0 0 0 -${size} Z`);
          path.setAttribute('fill', color);
          path.setAttribute('opacity', (Math.random() * 0.3 + 0.5).toString());
          
          path.style.transformOrigin = 'center';
          path.style.transformBox = 'fill-box';
          path.style.animation = `twinkle-hero ${duration * 1.2}s infinite ease-in-out ${delay}s`;
          
          heroStar.appendChild(path);
          starsGroup.appendChild(heroStar);
        } else {
          // Standard circular star
          const r = Math.random() * 0.8 + 0.4; // 0.4px to 1.2px
          const star = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          star.setAttribute('cx', `${cx}%`);
          star.setAttribute('cy', `${cy}%`);
          star.setAttribute('r', r.toString());
          star.setAttribute('fill', color);
          star.setAttribute('opacity', (Math.random() * 0.35 + 0.4).toString());
          
          star.style.transformOrigin = `${cx}% ${cy}%`;
          star.style.transformBox = 'fill-box';
          star.style.animation = `twinkle ${duration}s infinite ease-in-out ${delay}s`;
          
          starsGroup.appendChild(star);
        }
      }
    }
  }

  // Initialize immediately
  initBackground();
  
  // Re-run setup on View Transition navigation
  document.addEventListener('astro:page-load', initBackground);
</script>

