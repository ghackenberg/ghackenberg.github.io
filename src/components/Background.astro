---
// Background.astro
// Clear vector-style night sky background with responsive day/night color schemes,
// detailed sparkling starfield with intelligent responsive density control, shooting stars,
// and smooth scroll/mouse parallax effects on celestial elements.

interface Star {
  id: number;
  cx: number;
  cy: number;
  r: number;
  opacity: number;
  duration: number;
  delay: number;
  isHero: boolean;
  heroSize: number;
  tier: 'base' | 'md' | 'lg';
}

// PRNG for deterministic, reproducible SSR builds (Seed: 42)
function mulberry32(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (s + 0x6d2b79f5) >>> 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = mulberry32(42);

// Intelligent density tier configuration:
// - Base tier: 60 stars (always rendered across mobile, tablet, desktop)
// - Md tier: 45 stars (additional stars activated on tablets >= 768px)
// - Lg tier: 45 stars (additional stars activated on desktops >= 1280px)
// Total on mobile: 60 stars
// Total on tablet: 105 stars
// Total on desktop & ultrawide: 150 stars
const TIERS: Array<{ name: 'base' | 'md' | 'lg'; count: number; heroModulo: number }> = [
  { name: 'base', count: 60, heroModulo: 20 },
  { name: 'md', count: 45, heroModulo: 15 },
  { name: 'lg', count: 45, heroModulo: 15 }
];

const stars: Star[] = [];
let starId = 0;

for (const tierConfig of TIERS) {
  for (let i = 0; i < tierConfig.count; i++) {
    const cx = Number((random() * 100).toFixed(2));
    const cy = Number((random() * 75).toFixed(2)); // upper 75% of sky
    const delay = Number((random() * 6).toFixed(2));
    const duration = Number((random() * 3.5 + 2.5).toFixed(2));
    const isHero = i % tierConfig.heroModulo === 0;

    if (isHero) {
      const heroSize = Number((random() * 5 + 4).toFixed(2));
      const opacity = Number((random() * 0.3 + 0.5).toFixed(2));
      stars.push({
        id: starId++,
        cx,
        cy,
        r: 0,
        opacity,
        duration: Number((duration * 1.2).toFixed(2)),
        delay,
        isHero: true,
        heroSize,
        tier: tierConfig.name
      });
    } else {
      const r = Number((random() * 0.8 + 0.4).toFixed(2));
      const opacity = Number((random() * 0.35 + 0.4).toFixed(2));
      stars.push({
        id: starId++,
        cx,
        cy,
        r,
        opacity,
        duration,
        delay,
        isHero: false,
        heroSize: 0,
        tier: tierConfig.name
      });
    }
  }
}
---
<div class="background-container fixed inset-0 overflow-hidden pointer-events-none z-0 select-none">
  <!-- Twinkling Stars (SSR-rendered with intelligent responsive density) -->
  <svg id="bg-layer-stars" class="stars-svg absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
    <g id="sparkling-stars">
      {stars.map((star) => {
        const tierClass = star.tier === 'md' ? 'star-density-md' : star.tier === 'lg' ? 'star-density-lg' : '';

        if (star.isHero) {
          return (
            <svg
              x={`${star.cx}%`}
              y={`${star.cy}%`}
              class={`overflow-visible ${tierClass}`}
            >
              <path
                d={`M 0 -${star.heroSize} Q 0 0 ${star.heroSize} 0 Q 0 0 0 ${star.heroSize} Q 0 0 -${star.heroSize} 0 Q 0 0 0 -${star.heroSize} Z`}
                fill="var(--star-color)"
                opacity={star.opacity}
                style={`transform-origin: center; transform-box: fill-box; animation: twinkle-hero ${star.duration}s infinite ease-in-out ${star.delay}s;`}
              />
            </svg>
          );
        }

        return (
          <circle
            cx={`${star.cx}%`}
            cy={`${star.cy}%`}
            r={star.r}
            fill="var(--star-color)"
            opacity={star.opacity}
            class={tierClass}
            style={`transform-origin: center; transform-box: fill-box; animation: twinkle ${star.duration}s infinite ease-in-out ${star.delay}s;`}
          />
        );
      })}
    </g>
  </svg>

  <!-- Shooting Stars -->
  <div id="bg-layer-shooting-stars" class="shooting-stars-container absolute inset-0">
    <div class="shooting-star shooting-star-1"></div>
    <div class="shooting-star shooting-star-2"></div>
    <div class="shooting-star shooting-star-3"></div>
  </div>
</div>

<style>
  :root {
    --star-color: var(--color-text-heading);
  }

  :global(.light) {
    --star-color: var(--color-text-subtle);
  }

  /* Base Container */
  .background-container {
    width: 100%;
    height: 100vh;
  }

  /* Twinkling Stars */
  .stars-svg {
    pointer-events: none;
    will-change: transform;
    transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.75;
  }
  :global(.light) .stars-svg {
    opacity: 0.55;
  }

  /* Intelligent Responsive Density Tiers */
  .star-density-md {
    display: none;
  }
  .star-density-lg {
    display: none;
  }

  @media (min-width: 768px) {
    .star-density-md {
      display: inline;
    }
  }

  @media (min-width: 1280px) {
    .star-density-lg {
      display: inline;
    }
  }
</style>

<style is:global>
  /* Twinkling CSS animation */
  @keyframes twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50% { opacity: 0.85; transform: scale(1.15); }
  }

  @keyframes twinkle-hero {
    0%, 100% { opacity: 0.3; transform: scale(0.7) rotate(0deg); }
    50% { opacity: 0.9; transform: scale(1.25) rotate(45deg); }
  }
</style>

<style>
  /* Shooting Stars */
  .shooting-stars-container {
    pointer-events: none;
    transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.65;
    will-change: transform;
  }
  :global(.light) .shooting-stars-container {
    opacity: 0.55;
  }
  .shooting-star {
    position: absolute;
    width: 90px;
    height: 1.5px;
    background: linear-gradient(to left, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.85) 100%);
    opacity: 0;
    pointer-events: none;
  }
  :global(.light) .shooting-star {
    background: linear-gradient(to left, rgba(100, 116, 139, 0) 0%, rgba(100, 116, 139, 0.65) 100%);
  }
  .shooting-star-1 {
    top: 8%;
    left: 70%;
    animation: shoot-1 16s infinite ease-in-out;
  }
  .shooting-star-2 {
    top: 22%;
    left: 55%;
    animation: shoot-2 20s infinite ease-in-out;
    animation-delay: 5s;
  }
  .shooting-star-3 {
    top: 4%;
    left: 85%;
    animation: shoot-3 24s infinite ease-in-out;
    animation-delay: 11s;
  }
  @keyframes shoot-1 {
    0% { transform: rotate(-35deg) translateX(0) scaleX(0); opacity: 0; }
    1% { opacity: 0.7; transform: rotate(-35deg) translateX(0) scaleX(1); }
    3% { transform: rotate(-35deg) translateX(-350px) scaleX(1); opacity: 0; }
    100% { transform: rotate(-35deg) translateX(-350px) scaleX(0); opacity: 0; }
  }
  @keyframes shoot-2 {
    0% { transform: rotate(-38deg) translateX(0) scaleX(0); opacity: 0; }
    1% { opacity: 0.65; transform: rotate(-38deg) translateX(0) scaleX(1); }
    3% { transform: rotate(-38deg) translateX(-280px) scaleX(1); opacity: 0; }
    100% { transform: rotate(-38deg) translateX(-280px) scaleX(0); opacity: 0; }
  }
  @keyframes shoot-3 {
    0% { transform: rotate(-32deg) translateX(0) scaleX(0); opacity: 0; }
    1% { opacity: 0.75; transform: rotate(-32deg) translateX(0) scaleX(1); }
    3.5% { transform: rotate(-32deg) translateX(-420px) scaleX(1); opacity: 0; }
    100% { transform: rotate(-32deg) translateX(-420px) scaleX(0); opacity: 0; }
  }
</style>

<script>
  let isInitialized = false;

  function initBackground() {
    const starsLayer = document.getElementById('bg-layer-stars');
    const shootingStarsLayer = document.getElementById('bg-layer-shooting-stars');

    if (!starsLayer && !shootingStarsLayer) {
      return;
    }

    if (isInitialized) {
      return;
    }

    // Only enable parallax on desktop devices with fine pointer (mouse).
    // On mobile touch devices, JS-based parallax on fixed full-screen SVG layers fights with
    // native asynchronous compositor scrolling and creates noticeable jitter/stutter.
    const isTouchDevice = window.matchMedia('(pointer: coarse)').matches || ('ontouchstart' in window);

    if (isTouchDevice) {
      return;
    }

    isInitialized = true;

    let targetScrollY = window.scrollY;
    let currentScrollY = window.scrollY;
    
    let targetMouseX = 0.5; // normalized 0 to 1
    let targetMouseY = 0.5;
    let currentMouseX = 0.5;
    let currentMouseY = 0.5;

    let ticking = false;

    // Scroll listener
    const onScroll = () => {
      targetScrollY = window.scrollY || document.documentElement.scrollTop;
      requestTick();
    };

    // Mouse movement listener
    const onMouseMove = (e: MouseEvent) => {
      targetMouseX = e.clientX / window.innerWidth;
      targetMouseY = e.clientY / window.innerHeight;
      requestTick();
    };

    const requestTick = () => {
      if (!ticking) {
        requestAnimationFrame(updateFrame);
        ticking = true;
      }
    };

    const updateFrame = () => {
      const scrollLerp = 0.08;
      const mouseLerp = 0.08;

      currentScrollY += (targetScrollY - currentScrollY) * scrollLerp;
      currentMouseX += (targetMouseX - currentMouseX) * mouseLerp;
      currentMouseY += (targetMouseY - currentMouseY) * mouseLerp;

      // Normalized offset from center (-0.5 to 0.5)
      const normMouseX = currentMouseX - 0.5;
      const normMouseY = currentMouseY - 0.5;

      // Celestial & Sky Parallax
      if (starsLayer) {
        starsLayer.style.transform = `translate3d(${normMouseX * 10}px, ${-currentScrollY * 0.035 + normMouseY * 10}px, 0)`;
      }
      if (shootingStarsLayer) {
        shootingStarsLayer.style.transform = `translate3d(0, ${-currentScrollY * 0.03}px, 0)`;
      }

      const scrollDiff = Math.abs(targetScrollY - currentScrollY);
      const mouseDiffX = Math.abs(targetMouseX - currentMouseX);
      const mouseDiffY = Math.abs(targetMouseY - currentMouseY);

      if (scrollDiff > 0.05 || mouseDiffX > 0.001 || mouseDiffY > 0.001) {
        requestAnimationFrame(updateFrame);
      } else {
        ticking = false;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('mousemove', onMouseMove, { passive: true });

    // Initial frame run
    requestTick();
  }

  // Initialize immediately
  initBackground();
  
  // Re-run setup on View Transition navigation
  document.addEventListener('astro:page-load', initBackground);
</script>
