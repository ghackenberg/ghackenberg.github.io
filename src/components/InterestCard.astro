---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  color?: 'blue' | 'yellow' | 'purple' | 'green' | string;
  icon?: string;
  heroImage?: ImageMetadata | { src: ImageMetadata; title: string; description: string };
  tags?: string[];
  activeTag?: string | string[];
  showTags?: boolean;
}

const {
  id,
  title,
  description,
  heroImage,
  tags = [],
  activeTag,
  showTags,
} = Astro.props;

const isTagActive = (t: string) => (!activeTag ? false : Array.isArray(activeTag) ? activeTag.includes(t) : activeTag === t);
const shouldShowTags = showTags ?? Boolean(activeTag);

const isHeroObj = Boolean(heroImage && typeof heroImage === 'object' && 'src' in heroImage && heroImage.src);
const heroImg = isHeroObj ? (heroImage as { src: ImageMetadata }).src : (heroImage as ImageMetadata | undefined);
const heroTitle = isHeroObj ? (heroImage as { title: string }).title : title;
const heroDesc = isHeroObj ? (heroImage as { description: string }).description : (description ? `${title} – ${description}` : `Focus area for ${title}`);

const optimizedImage = heroImg ? await getImage({
  src: heroImg,
  format: 'webp',
  width: 800,
  quality: 85
}) : null;
---

<article 
  class="glass-card preview-card relative rounded-2xl border border-domain-interests/20 hover:border-domain-interests/50 group flex flex-col h-full overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl cursor-pointer"
  data-card-id={id}
  data-collection="interests"
>
  <!-- Absolute overlay link for card clickability -->
  <a href={`/interests/${id}/`} class="absolute inset-0 z-10 cursor-pointer" aria-label={`Explore ${title}`}></a>

  <!-- Artwork Header -->
  {optimizedImage && (
    <div class="relative w-full aspect-video shrink-0 grow-0 overflow-hidden bg-slate-950">
      <img 
        src={optimizedImage.src} 
        alt={heroDesc}
        title={heroTitle}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent opacity-90"></div>
      <span 
        class="unread-dot hidden badge-new badge-new-interests badge-corner-tr" 
        data-item-url={`/interests/${id}/`}
        title="Unread interest"
      >UNREAD</span>
    </div>
  )}

  <!-- Content Body -->
  <div class="preview-card-body flex flex-col flex-grow">
    <h3 class="text-base sm:text-lg font-bold text-gray-100 mb-2 group-hover:text-domain-interests transition-colors leading-snug line-clamp-1 min-h-[1lh]" title={title}>
      {title}
    </h3>

    {description && (
      <p class="text-gray-400 light:text-slate-600 text-sm mb-3 leading-relaxed font-normal line-clamp-3 min-h-[3lh]">
        {description}
      </p>
    )}

    {shouldShowTags && tags && tags.length > 0 ? (
      <div class="flex-grow flex flex-col mt-3">
        <div class="flex flex-wrap gap-1.5 self-start relative z-20">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag}/`}
              data-tag={tag}
              class={`tag-chip tag-chip-rose inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border relative z-20 hover:scale-105 ${
                isTagActive(tag) ? 'active-tag-match' : ''
              }`}
            >
              #{tag}
            </a>
          ))}
        </div>

        <!-- Footer: Read More Button -->
        <div class="mt-auto pt-5 w-full">
          <a
            href={`/interests/${id}/`}
            aria-label={`Read More: ${title}`}
            class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-domain-interests/12 hover:bg-domain-interests/25 border border-domain-interests/20 hover:border-domain-interests/45 text-domain-interests text-xs font-bold relative z-20 transition-all duration-200"
          >
            <span>Read More</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <div class="mt-auto pt-4 w-full">
        <a
          href={`/interests/${id}/`}
          aria-label={`Read More: ${title}`}
          class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-domain-interests/12 hover:bg-domain-interests/25 border border-domain-interests/20 hover:border-domain-interests/45 text-domain-interests text-xs font-bold relative z-20 transition-all duration-200"
        >
          <span>Read More</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</article>
