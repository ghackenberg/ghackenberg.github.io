---
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"section"> {
  as?: "section" | "div" | "aside" | "header" | "footer";
  id: string;
  padding?: "standard" | "compact" | "large" | "none";
  border?: "top" | "bottom" | "both" | "none";
  class?: string;
  /** Marks the section as collapsible (header must contain a SectionToggle) */
  collapsible?: boolean;
}

const {
  as: Tag = "section",
  id,
  padding = "standard",
  border = "none",
  class: className = "",
  collapsible = false,
  ...restProps
} = Astro.props;

const PADDING_MAP: Record<"standard" | "compact" | "large" | "none", string> = {
  standard: "section-fluid-padding",
  compact: "section-fluid-padding-compact",
  large: "section-fluid-padding-large",
  none: ""
};

const combinedClasses = [
  "w-full relative",
  PADDING_MAP[padding],
  className
].filter(Boolean).join(" ");
---

<Tag id={id} data-page-section="true" data-collapsible={collapsible ? "true" : undefined} class={combinedClasses} {...restProps}>
  {(border === "top" || border === "both") && (
    <div class="absolute top-0 left-0 right-0 flex justify-center pointer-events-none select-none">
      <div class="w-full max-w-6xl container-fluid-gutter">
        <div class="w-full border-t border-element-border light:border-slate-900/10"></div>
      </div>
    </div>
  )}
  <slot />
  {(border === "bottom" || border === "both") && (
    <div class="absolute bottom-0 left-0 right-0 flex justify-center pointer-events-none select-none">
      <div class="w-full max-w-6xl container-fluid-gutter">
        <div class="w-full border-b border-element-border light:border-slate-900/10"></div>
      </div>
    </div>
  )}
</Tag>
