    <!-- Synchronous inline script for Zero-Flicker on first paint -->
    <script is:inline>
      (function() {
        try {
          var header = document.getElementById('site-header');
          var container = document.getElementById('nav-container');
          var brand = document.getElementById('nav-brand');
          var actions = document.getElementById('desktop-actions');
          var mobileActions = document.getElementById('mobile-actions');
          if (!header || !container) return;

          var cs = window.getComputedStyle(container);
          var padX = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0);
          var innerWidth = (container.clientWidth || window.innerWidth) - padX;

          // Measure intrinsic brand lockup widths while data-brand-mode="full" is active
          var titleEl = brand ? brand.querySelector('.nav-logo-title') : null;
          var subtitleEl = brand ? brand.querySelector('.nav-logo-subtitle') : null;
          var monoWidth = 40;
          var brandGap = 12;
          var titleW = Math.max(titleEl ? Math.ceil(titleEl.getBoundingClientRect().width || titleEl.offsetWidth) : 0, 150);
          var subtitleW = Math.max(subtitleEl ? Math.ceil(subtitleEl.getBoundingClientRect().width || subtitleEl.offsetWidth) : 0, 205);
          header.setAttribute('data-title-w', String(titleW));
          header.setAttribute('data-subtitle-w', String(subtitleW));

          var brandTitleWidth = monoWidth + brandGap + titleW;
          var brandFullWidth = monoWidth + brandGap + Math.max(titleW, subtitleW);
          var actionsWidth = (actions && actions.offsetWidth) ? actions.offsetWidth : 156;
          var minLogoGap = 40; // 2.5rem minimum gap between logo and navigation
          var navActionsGap = 20;

          var availableWidth = innerWidth - brandFullWidth - actionsWidth - minLogoGap - navActionsGap;

          // Calibrated baseline item widths (About, Posts, Publications, Presentations, Courses, Projects, Services, Visualizations, Newsletters, Tags)
          var itemWidths = [68, 46, 92, 102, 62, 62, 62, 102, 90, 44];
          var gap = 16;
          var moreWidth = 60;

          // Needed width for count = 10 (all 10 items shown, More ▾ is hidden)
          var sum10 = 0;
          for (var i = 0; i < 10; i++) sum10 += itemWidths[i];
          var needed10 = sum10 + 9 * gap;

          // Needed width for count = k (1..9, items 1..k + More ▾ trigger)
          var needed = { 10: needed10 };
          var runningSum = 0;
          for (var k = 1; k <= 9; k++) {
            runningSum += itemWidths[k - 1];
            needed[k] = runningSum + k * gap + moreWidth;
          }

          if (availableWidth < needed[1]) {
            header.setAttribute('data-nav-mode', 'burger');
            var mobileActionsWidth = (mobileActions && mobileActions.offsetWidth) ? mobileActions.offsetWidth : 84;
            var minBurgerGap = 10;
            var availableBrandWidth = innerWidth - mobileActionsWidth - minBurgerGap;
            if (availableBrandWidth >= brandFullWidth) {
              header.setAttribute('data-brand-mode', 'full');
            } else if (availableBrandWidth >= brandTitleWidth) {
              header.setAttribute('data-brand-mode', 'title');
            } else {
              header.setAttribute('data-brand-mode', 'compact');
            }
          } else {
            header.setAttribute('data-nav-mode', 'desktop');
            header.setAttribute('data-brand-mode', 'full');
            var chosen = 1;
            if (availableWidth >= needed[10]) {
              chosen = 10;
            } else {
              for (var c = 9; c >= 1; c--) {
                if (availableWidth >= needed[c]) {
                  chosen = c;
                  break;
                }
              }
            }
            header.setAttribute('data-nav-count', String(chosen));

            var activePriority = parseInt(header.getAttribute('data-active-priority') || '0', 10);
            var moreTrigger = document.getElementById('more-dropdown-trigger');
            if (moreTrigger) {
              var isMoreActive = (activePriority > 0 && activePriority > chosen);
              moreTrigger.setAttribute('data-more-active', isMoreActive ? 'true' : 'false');
            }

            var menu = document.getElementById('more-dropdown-menu');
            if (menu && moreTrigger && container) {
              var mWidth = (chosen >= 7 && chosen <= 9) ? 320 : 560;
              var tRect = moreTrigger.getBoundingClientRect();
              var cRect = container.getBoundingClientRect();
              var dLeft = tRect.right - mWidth;
              var minL = Math.max(cRect.left + 8, 16);
              if (dLeft < minL) {
                menu.style.right = '-' + Math.round(minL - dLeft) + 'px';
              } else {
                menu.style.right = '0px';
              }
            }
          }
        } catch (e) {}
      })();
    </script>
