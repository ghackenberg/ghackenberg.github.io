---
import Container from "@components/Container.astro";
import { CONTENT_DOMAINS, DOMAIN_METADATA } from "@commons/shared/domain-themes";

const { pathname } = Astro.url;
const normalizedPathname = pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
  const normHref = href.replace(/\/$/, "") || "/";
  if (normHref === "/") {
    return normalizedPathname === "/";
  }
  return normalizedPathname.startsWith(normHref);
};

const isAboutActive = isActive("/about/");
const isContactActive = isActive("/contact/");
const isSupportActive = isActive("/support/");

// Desktop navigation items (Canonical sequence derived from CONTENT_DOMAINS)
const directNavItems = [
  { label: "About", href: "/about/", id: "about", priority: 1, active: isAboutActive },
  ...CONTENT_DOMAINS.map((domain, idx) => ({
    label: DOMAIN_METADATA[domain].label,
    href: DOMAIN_METADATA[domain].href,
    id: domain,
    priority: idx + 2,
    active: isActive(DOMAIN_METADATA[domain].href),
  }))
];

// All site pages for mobile menu
const mobileNavItems = [
  { label: "About", href: "/about/", id: "about", active: isAboutActive },
  ...CONTENT_DOMAINS.map((domain) => ({
    label: DOMAIN_METADATA[domain].label,
    href: DOMAIN_METADATA[domain].href,
    id: domain,
    active: isActive(DOMAIN_METADATA[domain].href),
  }))
];

let activePriority = 0;
const matchedActiveItem = directNavItems.find((item) => item.active);
if (matchedActiveItem) {
  activePriority = matchedActiveItem.priority;
}

const moreItems = CONTENT_DOMAINS.map((domain, idx) => ({
  label: DOMAIN_METADATA[domain].label,
  href: DOMAIN_METADATA[domain].href,
  description: DOMAIN_METADATA[domain].navDescription,
  domain,
  priority: idx + 2,
}));

const NAV_DOMAIN_STYLES: Record<string, {
  cssVar: string;
  desktopActiveText: string;
  desktopActiveBar: string;
  mobileActive: string;
  megaCardActive: string;
  megaCardHover: string;
  megaIconActive: string;
  megaIconHover: string;
  megaTitleHover: string;
}> = {
  about: {
    cssVar: 'var(--color-brand-primary)',
    desktopActiveText: 'text-brand-primary font-semibold',
    desktopActiveBar: 'bg-brand-primary',
    mobileActive: 'text-brand-primary font-semibold border-l-2 border-brand-primary pl-3 -ml-3',
    megaCardActive: 'bg-brand-primary/15 text-brand-primary font-semibold border border-brand-primary/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-brand-primary/30',
    megaIconActive: 'bg-brand-primary/20 text-brand-primary',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-brand-primary group-hover/item:bg-brand-primary/15',
    megaTitleHover: 'group-hover/item:text-brand-primary transition-colors duration-200',
  },
  posts: {
    cssVar: 'var(--color-domain-posts)',
    desktopActiveText: 'text-domain-posts font-semibold',
    desktopActiveBar: 'bg-domain-posts',
    mobileActive: 'text-domain-posts font-semibold border-l-2 border-domain-posts pl-3 -ml-3',
    megaCardActive: 'bg-domain-posts/15 text-domain-posts font-semibold border border-domain-posts/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-domain-posts/30',
    megaIconActive: 'bg-domain-posts/20 text-domain-posts',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-domain-posts group-hover/item:bg-domain-posts/15',
    megaTitleHover: 'group-hover/item:text-domain-posts transition-colors duration-200',
  },
  publications: {
    cssVar: 'var(--color-domain-publications)',
    desktopActiveText: 'text-domain-publications font-semibold',
    desktopActiveBar: 'bg-domain-publications',
    mobileActive: 'text-domain-publications font-semibold border-l-2 border-domain-publications pl-3 -ml-3',
    megaCardActive: 'bg-domain-publications/15 text-domain-publications font-semibold border border-domain-publications/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-domain-publications/30',
    megaIconActive: 'bg-domain-publications/20 text-domain-publications',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-domain-publications group-hover/item:bg-domain-publications/15',
    megaTitleHover: 'group-hover/item:text-domain-publications transition-colors duration-200',
  },
  presentations: {
    cssVar: 'var(--color-domain-presentations)',
    desktopActiveText: 'text-domain-presentations font-semibold',
    desktopActiveBar: 'bg-domain-presentations',
    mobileActive: 'text-domain-presentations font-semibold border-l-2 border-domain-presentations pl-3 -ml-3',
    megaCardActive: 'bg-domain-presentations/15 text-domain-presentations font-semibold border border-domain-presentations/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-domain-presentations/30',
    megaIconActive: 'bg-domain-presentations/20 text-domain-presentations',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-domain-presentations group-hover/item:bg-domain-presentations/15',
    megaTitleHover: 'group-hover/item:text-domain-presentations transition-colors duration-200',
  },
  courses: {
    cssVar: 'var(--color-domain-courses)',
    desktopActiveText: 'text-domain-courses font-semibold',
    desktopActiveBar: 'bg-domain-courses',
    mobileActive: 'text-domain-courses font-semibold border-l-2 border-domain-courses pl-3 -ml-3',
    megaCardActive: 'bg-domain-courses/15 text-domain-courses font-semibold border border-domain-courses/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-domain-courses/30',
    megaIconActive: 'bg-domain-courses/20 text-domain-courses',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-domain-courses group-hover/item:bg-domain-courses/15',
    megaTitleHover: 'group-hover/item:text-domain-courses transition-colors duration-200',
  },
  projects: {
    cssVar: 'var(--color-domain-projects)',
    desktopActiveText: 'text-domain-projects font-semibold',
    desktopActiveBar: 'bg-domain-projects',
    mobileActive: 'text-domain-projects font-semibold border-l-2 border-domain-projects pl-3 -ml-3',
    megaCardActive: 'bg-domain-projects/15 text-domain-projects font-semibold border border-domain-projects/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-domain-projects/30',
    megaIconActive: 'bg-domain-projects/20 text-domain-projects',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-domain-projects group-hover/item:bg-domain-projects/15',
    megaTitleHover: 'group-hover/item:text-domain-projects transition-colors duration-200',
  },
  services: {
    cssVar: 'var(--color-domain-services)',
    desktopActiveText: 'text-domain-services font-semibold',
    desktopActiveBar: 'bg-domain-services',
    mobileActive: 'text-domain-services font-semibold border-l-2 border-domain-services pl-3 -ml-3',
    megaCardActive: 'bg-domain-services/15 text-domain-services font-semibold border border-domain-services/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-domain-services/30',
    megaIconActive: 'bg-domain-services/20 text-domain-services',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-domain-services group-hover/item:bg-domain-services/15',
    megaTitleHover: 'group-hover/item:text-domain-services transition-colors duration-200',
  },
  newsletters: {
    cssVar: 'var(--color-domain-newsletters)',
    desktopActiveText: 'text-domain-newsletters font-semibold',
    desktopActiveBar: 'bg-domain-newsletters',
    mobileActive: 'text-domain-newsletters font-semibold border-l-2 border-domain-newsletters pl-3 -ml-3',
    megaCardActive: 'bg-domain-newsletters/15 text-domain-newsletters font-semibold border border-domain-newsletters/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-domain-newsletters/30',
    megaIconActive: 'bg-domain-newsletters/20 text-domain-newsletters',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-domain-newsletters group-hover/item:bg-domain-newsletters/15',
    megaTitleHover: 'group-hover/item:text-domain-newsletters transition-colors duration-200',
  },
  visualizations: {
    cssVar: 'var(--color-domain-visualizations)',
    desktopActiveText: 'text-domain-visualizations font-semibold',
    desktopActiveBar: 'bg-domain-visualizations',
    mobileActive: 'text-domain-visualizations font-semibold border-l-2 border-domain-visualizations pl-3 -ml-3',
    megaCardActive: 'bg-domain-visualizations/15 text-domain-visualizations font-semibold border border-domain-visualizations/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-domain-visualizations/30',
    megaIconActive: 'bg-domain-visualizations/20 text-domain-visualizations',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-domain-visualizations group-hover/item:bg-domain-visualizations/15',
    megaTitleHover: 'group-hover/item:text-domain-visualizations transition-colors duration-200',
  },
  tags: {
    cssVar: 'var(--color-domain-tags)',
    desktopActiveText: 'text-domain-tags font-semibold',
    desktopActiveBar: 'bg-domain-tags',
    mobileActive: 'text-domain-tags font-semibold border-l-2 border-domain-tags pl-3 -ml-3',
    megaCardActive: 'bg-domain-tags/15 text-domain-tags font-semibold border border-domain-tags/30',
    megaCardHover: 'hover:bg-element-bg/60 text-gray-300 hover:text-gray-100 border border-transparent hover:border-domain-tags/30',
    megaIconActive: 'bg-domain-tags/20 text-domain-tags',
    megaIconHover: 'bg-element-bg text-gray-400 group-hover/item:text-domain-tags group-hover/item:bg-domain-tags/15',
    megaTitleHover: 'group-hover/item:text-domain-tags transition-colors duration-200',
  },
};

const activeNavItem = directNavItems.find(item => item.active);
const activeNavCssVar = activeNavItem ? (NAV_DOMAIN_STYLES[activeNavItem.id]?.cssVar || 'var(--color-brand-primary)') : 'var(--color-brand-primary)';
---

<div class="sticky top-0 left-0 right-0 z-50 w-full" id="navbar-root">
  <header
    id="site-header"
    class="transition-all duration-300 w-full py-4 relative"
    data-nav-mode="desktop"
    data-brand-mode="full"
    data-nav-count="10"
    data-active-priority={activePriority}
    style={`--active-nav-color: ${activeNavCssVar};`}
  >
    <!-- Background frosted glass layer (separated from header to avoid backdrop-root clipping on dropdown menus) -->
    <div class="header-bg absolute inset-0 glass-panel border-b border-element-border backdrop-blur-md -z-10 pointer-events-none" id="site-header-bg"></div>

    <Container as="div" size="wide" padding="none" class="relative flex items-center justify-between" id="nav-container">
      
      <!-- Logo / Brand on the left (shrink-0 with script-driven visibility) -->
      <a href="/" class="flex items-center gap-3 group shrink-0 min-w-max" id="nav-brand">
        <span class="w-10 h-10 flex items-center justify-center transition-transform duration-200 group-hover:scale-105 shrink-0">
          <svg class="w-10 h-10 block" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="0" y="0" width="100" height="100" rx="22" style="fill: var(--active-nav-color); transition: fill 0.25s ease;" />
            <polygon points="18,78 30,22 44,22 32,78" fill="white" />
            <polygon points="56,78 68,22 82,22 70,78" fill="white" />
            <polygon points="36,58 40,42 64,42 60,58" style="fill: color-mix(in srgb, var(--active-nav-color) 28%, white); transition: fill 0.25s ease;" />
          </svg>
        </span>
        <div class="flex flex-col items-start nav-logo-name leading-tight shrink-0">
          <span class="nav-logo-title font-semibold text-sm text-gray-300 tracking-wide group-hover:text-gray-100 transition-colors whitespace-nowrap">
            Dr. Georg Hackenberg
          </span>
          <span class="nav-logo-subtitle text-[11px] text-gray-400 font-normal tracking-normal group-hover:text-gray-300 transition-colors whitespace-nowrap">
            Professor for Industrial Informatics @ UAP
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Right-aligned, Priority+ Dynamic Container) -->
      <nav id="desktop-nav" class="ml-auto flex items-center justify-end gap-4 transition-opacity duration-200">
        <!-- 9 Direct Canonical Items -->
        {directNavItems.map(item => {
          const styles = NAV_DOMAIN_STYLES[item.id] || NAV_DOMAIN_STYLES.about;
          return (
            <a 
              href={item.href} 
              data-nav-item={item.id}
              data-nav-priority={item.priority > 1 ? String(item.priority) : undefined}
              class={`nav-item-desktop relative py-1 text-sm font-medium transition-colors duration-200 flex items-center whitespace-nowrap ${
                item.active 
                  ? styles.desktopActiveText 
                  : "text-gray-400 hover:text-gray-100"
              }`}
            >
              {item.id === 'about' && (
                <svg class="w-4 h-4 mr-1.5 shrink-0 opacity-80 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
              )}
              <span>{item.label}</span>
              {item.active && (
                <span 
                  class={`absolute bottom-0 left-0 right-0 h-[2px] ${styles.desktopActiveBar} rounded-full`}
                  style={`box-shadow: 0 0 8px color-mix(in srgb, ${styles.cssVar} 80%, transparent);`}
                ></span>
              )}
            </a>
          );
        })}

        <!-- 10. More ▾ Mega-Menu Dropdown Trigger -->
        <div class="relative group shrink-0" id="more-dropdown-container">
          <button
            id="more-dropdown-trigger"
            aria-label="Toggle More navigation menu"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            data-more-active="false"
            class="relative py-1 text-sm font-medium transition-colors duration-200 flex items-center gap-1 cursor-pointer whitespace-nowrap text-gray-400 hover:text-gray-100"
          >
            <span>More ▾</span>
            <span class="more-active-indicator hidden absolute bottom-0 left-0 right-0 h-[2px] bg-brand-primary rounded-full shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
          </button>

          <!-- Dropdown Panel with Hover Bridge -->
          <div
            id="more-dropdown-menu"
            role="menu"
            aria-label="More Navigation"
            class="invisible opacity-0 group-hover:visible group-hover:opacity-100 focus-within:visible focus-within:opacity-100 transition-all duration-200 transform translate-y-2 group-hover:translate-y-0 absolute right-0 top-full pt-3 z-50 w-[560px] max-w-[calc(100vw-2rem)] pointer-events-none group-hover:pointer-events-auto focus-within:pointer-events-auto"
          >
            <!-- Invisible bridge padding to prevent mouse drop -->
            <div class="absolute -top-3 left-0 right-0 h-4 bg-transparent pointer-events-auto"></div>

            <div class="glass-panel rounded-2xl border border-element-border-medium shadow-2xl p-4 backdrop-blur-md">
              <div id="more-items-container" class="grid grid-cols-2 gap-2">
                {moreItems.map(item => {
                  const active = isActive(item.href);
                  const styles = NAV_DOMAIN_STYLES[item.domain] || NAV_DOMAIN_STYLES.about;
                  return (
                    <a
                      href={item.href}
                      role="menuitem"
                      data-more-priority={item.priority}
                      class={`p-2.5 rounded-xl transition-all duration-200 flex items-start gap-3 group/item ${
                        active
                          ? styles.megaCardActive
                          : styles.megaCardHover
                      }`}
                    >
                      <div class={`mt-0.5 w-8 h-8 rounded-lg flex items-center justify-center shrink-0 transition-colors duration-200 ${
                        active
                          ? styles.megaIconActive
                          : styles.megaIconHover
                      }`}>
                        {item.domain === "posts" && (
                          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                          </svg>
                        )}
                        {item.domain === "publications" && (
                          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                          </svg>
                        )}
                        {item.domain === "presentations" && (
                          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
                          </svg>
                        )}
                        {item.domain === "courses" && (
                          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-5.25 6.557c0 1.5 2.35 2.7 5.25 2.7s5.25-1.2 5.25-2.7" />
                          </svg>
                        )}
                        {item.domain === "projects" && (
                          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                          </svg>
                        )}
                        {item.domain === "services" && (
                          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />
                          </svg>
                        )}
                        {item.domain === "newsletters" && (
                          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                          </svg>
                        )}
                        {item.domain === "visualizations" && (
                          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                          </svg>
                        )}
                        {item.domain === "tags" && (
                          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
                          </svg>
                        )}
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class={`text-sm font-semibold leading-snug ${active ? "" : styles.megaTitleHover}`}>{item.label}</span>
                        <span class="text-xs text-gray-400 line-clamp-1 leading-normal">{item.description}</span>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      </nav>

      <!-- Desktop Actions Group at far right -->
      <div id="desktop-actions" class="flex items-center space-x-1.5 shrink-0 ml-5">
        <!-- Theme Cycle Button Desktop -->
        <button 
