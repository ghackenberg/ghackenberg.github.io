---
const { pathname } = Astro.url;
const normalizedPathname = pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
  const normHref = href.replace(/\/$/, "") || "/";
  if (normHref === "/") {
    return normalizedPathname === "/";
  }
  return normalizedPathname.startsWith(normHref);
};

const navItems = [
  { label: "Home", href: "/" },
  { label: "Posts", href: "/posts/" },
  { label: "Publications", href: "/publications/" },
  { label: "Presentations", href: "/presentations/" },
  { label: "Courses", href: "/courses/" },
  { label: "Projects", href: "/projects/" },
  { label: "Services", href: "/services/" },
  { label: "Visualizations", href: "/visualizations/" }
];
---

<div class="sticky top-0 left-0 right-0 z-50 w-full">
  <header class="transition-all duration-300 w-full glass-panel border-b border-white/5 py-4 backdrop-blur-md relative">
  <div class="max-w-6xl mx-auto px-4 md:px-8 relative flex items-center justify-between">
    
    <!-- Logo / Brand -->
    <a href="/" class="flex items-center space-x-3 group shrink-0">
      <span class="w-10 h-10 rounded-lg border border-element-border-medium bg-element-bg/50 group-hover:border-brand-blue/40 group-hover:bg-element-bg flex items-center justify-center transition-all duration-200 shadow-sm shrink-0">
        <span class="text-base font-extrabold tracking-tight heading-gradient-brand group-hover:opacity-80 transition-opacity">
          GH
        </span>
      </span>
      <div class="flex flex-col nav-logo-name leading-tight shrink-0">
        <span class="nav-logo-title font-semibold text-sm text-gray-300 tracking-wide group-hover:text-gray-100 transition-colors whitespace-nowrap">
          Dr. Georg Hackenberg
        </span>
        <span class="nav-logo-subtitle text-[11px] text-gray-400 font-normal tracking-normal group-hover:text-gray-300 transition-colors whitespace-nowrap">
          Professor for Industrial Informatics @ UAP
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden nav:flex items-center space-x-3.5 lg:space-x-4 xl:space-x-5">
      {navItems.map(item => {
        const active = isActive(item.href);
        return (
          <a 
            href={item.href} 
            class={`relative py-1 text-xs nav:text-sm font-medium transition-colors duration-200 flex items-center ${
              active 
                ? "text-brand-blue font-semibold" 
                : "text-gray-400 hover:text-gray-100"
            }`}
          >
            <span>{item.label}</span>
            {active && (
              <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-brand-blue rounded-full shadow-[0_0_8px_rgba(59,130,246,0.8)]" />
            )}
          </a>
        );
      })}

      <!-- Desktop Actions Group -->
      <div class="flex items-center space-x-1 ml-2">
        <!-- Theme Cycle Button Desktop -->
        <button 
          id="theme-cycle-btn-desktop"
          class="w-9 h-9 rounded-full border border-element-border-medium bg-element-bg/50 hover:bg-element-bg text-gray-400 hover:text-gray-100 flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-90"
          aria-label="Toggle theme"
          title="Toggle theme (System / Light / Dark)"
        >
          <svg class="w-5 h-5 theme-icon-system" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <svg class="w-5 h-5 theme-icon-light" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M14 12a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <svg class="w-5 h-5 theme-icon-dark" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- What's New Sparkle Trigger Desktop -->
        <button 
          id="whats-new-btn-desktop"
          type="button"
          data-open-whats-new-modal
          class="relative w-9 h-9 rounded-full border border-element-border-medium bg-element-bg/50 hover:bg-element-bg text-gray-400 hover:text-gray-100 flex items-center justify-center transition-all duration-300 cursor-pointer active:scale-90"
          aria-label="Content Updates"
          title="Content Updates"
        >
          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
          </svg>
        </button>

        <!-- Privacy Settings Button Desktop -->
        <button 
          type="button"
          data-open-privacy-modal
          class="w-9 h-9 rounded-full border border-element-border-medium bg-element-bg/50 hover:bg-element-bg text-gray-400 hover:text-gray-100 flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-90"
          aria-label="Privacy Settings"
          title="Privacy Settings"
        >
          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Theme, What's New & Privacy Toggle Mobile -->
    <div class="flex items-center nav:hidden">
      <!-- Action buttons -->
      <div class="flex items-center space-x-1 mr-2">
        <!-- Theme Cycle Button Mobile -->
        <button 
          id="theme-cycle-btn-mobile"
          class="w-11 h-11 rounded-full border border-element-border-medium bg-element-bg/50 hover:bg-element-bg text-gray-400 hover:text-gray-100 flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-90"
          aria-label="Toggle theme"
          title="Toggle theme (System / Light / Dark)"
        >
          <svg class="w-5 h-5 theme-icon-system" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <svg class="w-5 h-5 theme-icon-light" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M14 12a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <svg class="w-5 h-5 theme-icon-dark" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- What's New Sparkle Trigger Mobile -->
        <button 
          id="whats-new-btn-mobile"
          type="button"
          data-open-whats-new-modal
          class="relative w-11 h-11 rounded-full border border-element-border-medium bg-element-bg/50 hover:bg-element-bg text-gray-400 hover:text-gray-100 flex items-center justify-center transition-all duration-300 cursor-pointer active:scale-90"
          aria-label="Content Updates"
          title="Content Updates"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
          </svg>
        </button>

        <!-- Privacy Settings Button Mobile -->
        <button 
          type="button"
          data-open-privacy-modal
          class="w-11 h-11 rounded-full border border-element-border-medium bg-element-bg/50 hover:bg-element-bg text-gray-400 hover:text-gray-100 flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-90"
          aria-label="Privacy Settings"
          title="Privacy Settings"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button 
        id="mobile-menu-btn" 
        class="text-gray-400 hover:text-gray-100 focus:outline-none p-2.5 rounded-lg hover:bg-element-bg"
        aria-label="Toggle Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  </header>

  <!-- Mobile Dropdown Menu -->
  <div 
    id="mobile-menu" 
    class="hidden nav:hidden glass-panel border-b border-element-border absolute top-full left-0 right-0 py-6 px-6 flex flex-col space-y-4 shadow-xl shadow-black/30"
  >
    {navItems.map(item => {
      const active = isActive(item.href);
      return (
        <a 
          href={item.href} 
          class={`text-base font-medium transition-colors py-1 flex items-center ${
            active 
              ? "text-brand-blue font-semibold border-l-2 border-brand-blue pl-3 -ml-3" 
              : "text-gray-300 hover:text-gray-100"
          }`}
        >
          <span>{item.label}</span>
        </a>
      );
    })}
  </div>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  
  if (btn && menu && hamburger && closeIcon) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close menu when a link is clicked
    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }

  // Header scroll dynamic visual styling
  window.addEventListener('scroll', () => {
    const header = document.querySelector('header');
    if (header) {
      if (window.scrollY > 50) {
        header.classList.remove('py-4');
        header.classList.add('py-3', 'navbar-scrolled', 'shadow-lg');
      } else {
        header.classList.remove('py-3', 'navbar-scrolled', 'shadow-lg');
        header.classList.add('py-4');
      }
    }
  }, { passive: true });

  // Theme Toggle Client Logic
  const initThemeToggle = () => {
    const setTheme = (setting: string) => {
      document.documentElement.setAttribute('data-theme-setting', setting);
      localStorage.setItem('theme', setting);

      let activeTheme = setting;
      if (setting === 'system') {
        const systemIsLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
        activeTheme = systemIsLight ? 'light' : 'dark';
      }

      if (activeTheme === 'light') {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }

      // Update English tooltip & aria-label
      const tooltipMap: Record<string, string> = {
        system: 'Theme: System (Click to switch to Light)',
        light: 'Theme: Light (Click to switch to Dark)',
        dark: 'Theme: Dark (Click to switch to System)'
      };
      const tooltip = tooltipMap[setting] || 'Toggle theme';
      const dBtn = document.getElementById('theme-cycle-btn-desktop');
      const mBtn = document.getElementById('theme-cycle-btn-mobile');
      if (dBtn) {
        dBtn.setAttribute('title', tooltip);
        dBtn.setAttribute('aria-label', tooltip);
      }
      if (mBtn) {
        mBtn.setAttribute('title', tooltip);
        mBtn.setAttribute('aria-label', tooltip);
      }

      // Dispatch custom event for Plausible / timelines / graphs
      window.dispatchEvent(new CustomEvent('theme-changed', { 
        detail: { 
          themeSetting: setting,
          resolvedTheme: activeTheme,
          trigger: 'manual'
        } 
      }));
    };

    const cycleTheme = () => {
      const currentSetting = document.documentElement.getAttribute('data-theme-setting') || 'system';
      let nextSetting = 'system';
      if (currentSetting === 'system') {
        nextSetting = 'light';
      } else if (currentSetting === 'light') {
        nextSetting = 'dark';
      } else if (currentSetting === 'dark') {
        nextSetting = 'system';
      }
      setTheme(nextSetting);
    };

    // Clean listeners by replacing elements with clones to avoid memory leaks/double-listeners
    const desktopBtn = document.getElementById('theme-cycle-btn-desktop');
    const mobileBtn = document.getElementById('theme-cycle-btn-mobile');
    
    if (desktopBtn) {
      const clone = desktopBtn.cloneNode(true);
      desktopBtn.replaceWith(clone);
    }
    if (mobileBtn) {
      const clone = mobileBtn.cloneNode(true);
      mobileBtn.replaceWith(clone);
    }

    // Bind click handlers to newly cloned elements
    const newDesktopBtn = document.getElementById('theme-cycle-btn-desktop');
    const newMobileBtn = document.getElementById('theme-cycle-btn-mobile');

    if (newDesktopBtn) {
      newDesktopBtn.addEventListener('click', cycleTheme);
    }
    if (newMobileBtn) {
      newMobileBtn.addEventListener('click', cycleTheme);
    }

    // Apply initial tooltips based on current theme setting
    const currentTheme = document.documentElement.getAttribute('data-theme-setting') || localStorage.getItem('theme') || 'system';
    const initialTooltipMap: Record<string, string> = {
      system: 'Theme: System (Click to switch to Light)',
      light: 'Theme: Light (Click to switch to Dark)',
      dark: 'Theme: Dark (Click to switch to System)'
    };
    const initialTip = initialTooltipMap[currentTheme] || 'Toggle theme';
    if (newDesktopBtn) {
      newDesktopBtn.setAttribute('title', initialTip);
      newDesktopBtn.setAttribute('aria-label', initialTip);
    }
    if (newMobileBtn) {
      newMobileBtn.setAttribute('title', initialTip);
      newMobileBtn.setAttribute('aria-label', initialTip);
    }
  };

  // Initialize immediately
  initThemeToggle();

  // Re-run if Astro uses page load events
  document.addEventListener('astro:page-load', () => {
    initThemeToggle();
  });
</script>

<style is:global>
  /* Theme Cycle Button Icons Visibility */
  .theme-icon-system,
  .theme-icon-light,
  .theme-icon-dark {
    display: none !important;
  }

  html[data-theme-setting="system"] .theme-icon-system {
    display: block !important;
  }
  html[data-theme-setting="light"] .theme-icon-light {
    display: block !important;
  }
  html[data-theme-setting="dark"] .theme-icon-dark {
    display: block !important;
  }
</style>
