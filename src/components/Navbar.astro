          isSupportActive
            ? "bg-brand-primary hover:bg-brand-primary/90 text-white shadow-brand-primary/30 shadow-md ring-2 ring-brand-primary/50"
            : "bg-element-bg hover:bg-element-bg-hover text-gray-200 hover:text-brand-primary border border-element-border-medium hover:border-brand-primary/40"
        }`}
      >
