<script>
  // Mobile drawer interactive toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  
  if (btn && menu && hamburger && closeIcon) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close menu when a link is clicked
    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }

  // Desktop More ▾ Mega-Menu Interactive Support
  const moreBtn = document.getElementById('more-dropdown-trigger');
  const moreMenu = document.getElementById('more-dropdown-menu');
  const moreContainer = document.getElementById('more-dropdown-container');

  if (moreBtn && moreMenu && moreContainer) {
    moreBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = moreBtn.getAttribute('aria-expanded') === 'true';
      moreBtn.setAttribute('aria-expanded', String(!isExpanded));
      if (!isExpanded) {
        moreMenu.classList.remove('invisible', 'opacity-0', 'pointer-events-none');
        moreMenu.classList.add('visible', 'opacity-100', 'pointer-events-auto');
      } else {
        moreMenu.classList.add('invisible', 'opacity-0', 'pointer-events-none');
        moreMenu.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!moreContainer.contains(e.target as Node)) {
        moreBtn.setAttribute('aria-expanded', 'false');
        moreMenu.classList.add('invisible', 'opacity-0', 'pointer-events-none');
        moreMenu.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        moreBtn.setAttribute('aria-expanded', 'false');
        moreMenu.classList.add('invisible', 'opacity-0', 'pointer-events-none');
        moreMenu.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
        moreBtn.focus();
      }
    });
  }

  // Dynamic Greedy / Priority+ Navigation Engine
  function initPriorityNav() {
    const header = document.getElementById('site-header');
    const container = document.getElementById('nav-container');
    const brand = document.getElementById('nav-brand');
    const desktopNav = document.getElementById('desktop-nav');
    const desktopActions = document.getElementById('desktop-actions');
    const mobileActions = document.getElementById('mobile-actions');
    const moreTrigger = document.getElementById('more-dropdown-trigger');
    const menuEl = document.getElementById('mobile-menu');
    const hamburgerEl = document.getElementById('hamburger-icon');
    const closeIconEl = document.getElementById('close-icon');

    if (!header || !container || !brand || !desktopNav || !desktopActions) return;

    const activePriority = parseInt(header.getAttribute('data-active-priority') || '0', 10);
    const titleEl = brand.querySelector<HTMLElement>('.nav-logo-title');
    const subtitleEl = brand.querySelector<HTMLElement>('.nav-logo-subtitle');

    let cachedTitleW = Math.max(parseInt(header.getAttribute('data-title-w') || '150', 10), 150);
    let cachedSubtitleW = Math.max(parseInt(header.getAttribute('data-subtitle-w') || '205', 10), 205);

    // Query all 10 direct items in canonical sequence
    const itemIds = [
      'about', 'posts', 'publications', 'presentations',
      'courses', 'projects', 'services', 'visualizations', 'newsletters', 'tags'
    ];
    const fallbackWidths = [68, 46, 92, 102, 62, 62, 62, 102, 90, 44];
    const minLogoGap = 40; // 2.5rem minimum gap between logo and navigation
    const navActionsGap = 20;
    const minBurgerGap = 10;
    const monoWidth = 40;
    const brandGap = 12;
    const gap = 16;

    const moreContainerEl = document.getElementById('more-dropdown-container');

    const repositionMoreDropdown = () => {
      const moreMenu = document.getElementById('more-dropdown-menu');
      if (!moreMenu || !moreTrigger || !container) return;

      const currentCount = parseInt(header.getAttribute('data-nav-count') || '10', 10);
      const menuWidth = (currentCount >= 7 && currentCount <= 9) ? 320 : 560;

      const triggerRect = moreTrigger.getBoundingClientRect();
      const containerRect = container.getBoundingClientRect();

      const desiredLeft = triggerRect.right - menuWidth;
      const minLeft = Math.max(containerRect.left + 8, 16);

      if (desiredLeft < minLeft) {
        const offset = Math.round(minLeft - desiredLeft);
        moreMenu.style.right = `-${offset}px`;
      } else {
        moreMenu.style.right = '0px';
      }
    };

    let rafId: number | null = null;

    const updateNavPriority = () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        const cs = window.getComputedStyle(container);
        const padX = (parseFloat(cs.paddingLeft) || 0) + (parseFloat(cs.paddingRight) || 0);
        const innerWidth = container.clientWidth - padX;

        const liveTitleW = titleEl ? Math.ceil(titleEl.getBoundingClientRect().width || titleEl.offsetWidth) : 0;
        const liveSubtitleW = subtitleEl ? Math.ceil(subtitleEl.getBoundingClientRect().width || subtitleEl.offsetWidth) : 0;
        if (liveTitleW > 0) cachedTitleW = liveTitleW;
        if (liveSubtitleW > 0) cachedSubtitleW = liveSubtitleW;

        const brandTitleWidth = monoWidth + brandGap + cachedTitleW;
        const brandFullWidth = monoWidth + brandGap + Math.max(cachedTitleW, cachedSubtitleW);
        const actionsWidth = desktopActions.offsetWidth || 156;

        const availableWidth = innerWidth - brandFullWidth - actionsWidth - minLogoGap - navActionsGap;

        // Measure live widths of items or use calibrated fallbacks
        const measuredWidths = itemIds.map((id, index) => {
          const el = desktopNav.querySelector<HTMLElement>(`[data-nav-item="${id}"]`);
          return Math.max(el?.getBoundingClientRect().width || el?.offsetWidth || 0, fallbackWidths[index]);
        });

        const measuredMoreWidth = Math.max(
          moreContainerEl?.getBoundingClientRect().width || moreContainerEl?.offsetWidth || 0,
          60
        );

        // Compute needed widths:
        // Count 10: all 10 items shown, More ▾ trigger is hidden
        const sum10 = measuredWidths.reduce((a, b) => a + b, 0);
        const needed10 = sum10 + 9 * gap;

        // Count 1..9: items 1..k + More ▾ trigger
        const needed: Record<number, number> = { 10: needed10 };
        let runningSum = 0;
        for (let k = 1; k <= 9; k++) {
          runningSum += measuredWidths[k - 1];
          needed[k] = runningSum + k * gap + measuredMoreWidth;
        }

        let nextMode: 'burger' | 'desktop';
        let nextBrandMode: 'full' | 'title' | 'compact' = 'full';
        let nextCount = 1;

        if (availableWidth < needed[1]) {
          nextMode = 'burger';
          const mobileActionsWidth = (mobileActions && mobileActions.offsetWidth) ? mobileActions.offsetWidth : 84;
          const availableBrandWidth = innerWidth - mobileActionsWidth - minBurgerGap;
          if (availableBrandWidth >= brandFullWidth) {
            nextBrandMode = 'full';
          } else if (availableBrandWidth >= brandTitleWidth) {
            nextBrandMode = 'title';
          } else {
            nextBrandMode = 'compact';
          }
        } else {
          nextMode = 'desktop';
          nextBrandMode = 'full';
          if (availableWidth >= needed[10]) {
            nextCount = 10;
          } else {
            for (let c = 9; c >= 1; c--) {
              if (availableWidth >= needed[c]) {
                nextCount = c;
                break;
              }
            }
          }
        }

        if (header.getAttribute('data-nav-mode') !== nextMode) {
          header.setAttribute('data-nav-mode', nextMode);
        }
        if (header.getAttribute('data-brand-mode') !== nextBrandMode) {
          header.setAttribute('data-brand-mode', nextBrandMode);
        }

        if (nextMode === 'desktop') {
          if (header.getAttribute('data-nav-count') !== String(nextCount)) {
            header.setAttribute('data-nav-count', String(nextCount));
          }

          repositionMoreDropdown();

          if (moreTrigger) {
            const isMoreActive = (activePriority > 0 && activePriority > nextCount);
            const activeAttr = isMoreActive ? 'true' : 'false';
            if (moreTrigger.getAttribute('data-more-active') !== activeAttr) {
              moreTrigger.setAttribute('data-more-active', activeAttr);
            }
          }

          // Close mobile menu if switching to desktop
          if (menuEl && !menuEl.classList.contains('hidden')) {
            menuEl.classList.add('hidden');
            hamburgerEl?.classList.remove('hidden');
            closeIconEl?.classList.add('hidden');
          }
        }
      });
    };

    updateNavPriority();

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        updateNavPriority();
      });
    }

    window.addEventListener('resize', updateNavPriority, { passive: true });

    if (window.ResizeObserver) {
      const ro = new ResizeObserver(() => {
        updateNavPriority();
      });
      ro.observe(container);
    }
  }

  initPriorityNav();
  document.addEventListener('astro:page-load', initPriorityNav);

  // Header scroll dynamic visual styling
  window.addEventListener('scroll', () => {
    const header = document.querySelector('header');
    const headerBg = document.getElementById('site-header-bg');
    if (header) {
      if (window.scrollY > 50) {
        header.classList.remove('py-4');
        header.classList.add('py-3');
        headerBg?.classList.add('navbar-scrolled', 'shadow-lg');
      } else {
        header.classList.remove('py-3');
        header.classList.add('py-4');
        headerBg?.classList.remove('navbar-scrolled', 'shadow-lg');
      }
    }
  }, { passive: true });

  // Theme Toggle Client Logic
  const initThemeToggle = () => {
    const setTheme = (setting: string) => {
      document.documentElement.setAttribute('data-theme-setting', setting);
      localStorage.setItem('theme', setting);

      let activeTheme = setting;
      if (setting === 'system') {
        const systemIsLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
        activeTheme = systemIsLight ? 'light' : 'dark';
      }

      if (activeTheme === 'light') {
        document.documentElement.classList.add('light');
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
      }

      // Update English tooltip & aria-label
      const tooltipMap: Record<string, string> = {
        system: 'Theme: System (Click to switch to Light)',
        light: 'Theme: Light (Click to switch to Dark)',
        dark: 'Theme: Dark (Click to switch to System)'
      };
      const tooltip = tooltipMap[setting] || 'Toggle theme';
      const dBtn = document.getElementById('theme-cycle-btn-desktop');
      const mBtn = document.getElementById('theme-cycle-btn-mobile');
      if (dBtn) {
        dBtn.setAttribute('title', tooltip);
        dBtn.setAttribute('aria-label', tooltip);
      }
      if (mBtn) {
        mBtn.setAttribute('title', tooltip);
        mBtn.setAttribute('aria-label', tooltip);
      }

      // Dispatch custom event for Plausible / timelines / graphs
      window.dispatchEvent(new CustomEvent('theme-changed', { 
        detail: { 
          themeSetting: setting,
          resolvedTheme: activeTheme,
          trigger: 'manual'
        } 
      }));
    };

    const cycleTheme = () => {
      const currentSetting = document.documentElement.getAttribute('data-theme-setting') || 'system';
      let nextSetting = 'system';
      if (currentSetting === 'system') {
        nextSetting = 'light';
      } else if (currentSetting === 'light') {
        nextSetting = 'dark';
      } else if (currentSetting === 'dark') {
        nextSetting = 'system';
      }
      setTheme(nextSetting);
    };

    // Clean listeners by replacing elements with clones to avoid memory leaks/double-listeners
    const desktopBtn = document.getElementById('theme-cycle-btn-desktop');
    const mobileBtn = document.getElementById('theme-cycle-btn-mobile');
    
    if (desktopBtn) {
      const clone = desktopBtn.cloneNode(true);
      desktopBtn.replaceWith(clone);
    }
    if (mobileBtn) {
      const clone = mobileBtn.cloneNode(true);
      mobileBtn.replaceWith(clone);
    }

    // Bind click handlers to newly cloned elements
    const newDesktopBtn = document.getElementById('theme-cycle-btn-desktop');
    const newMobileBtn = document.getElementById('theme-cycle-btn-mobile');

    if (newDesktopBtn) {
      newDesktopBtn.addEventListener('click', cycleTheme);
    }
    if (newMobileBtn) {
      newMobileBtn.addEventListener('click', cycleTheme);
    }

    // Apply initial tooltips based on current theme setting
    const currentTheme = document.documentElement.getAttribute('data-theme-setting') || localStorage.getItem('theme') || 'system';
    const initialTooltipMap: Record<string, string> = {
      system: 'Theme: System (Click to switch to Light)',
      light: 'Theme: Light (Click to switch to Dark)',
      dark: 'Theme: Dark (Click to switch to System)'
    };
    const initialTip = initialTooltipMap[currentTheme] || 'Toggle theme';
    if (newDesktopBtn) {
      newDesktopBtn.setAttribute('title', initialTip);
      newDesktopBtn.setAttribute('aria-label', initialTip);
    }
    if (newMobileBtn) {
      newMobileBtn.setAttribute('title', initialTip);
      newMobileBtn.setAttribute('aria-label', initialTip);
    }
  };

  initThemeToggle();

  document.addEventListener('astro:page-load', () => {
    initThemeToggle();
  });
</script>

