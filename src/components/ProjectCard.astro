---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  tagline: string;
  description: string;
  href: string;
  tags: string[];
  accentColor?: 'blue' | 'yellow' | 'purple' | 'green';
  screenshot?: ImageMetadata;
  screenshotLight?: ImageMetadata;
}

const { 
  title, 
  tagline, 
  description, 
  href, 
  tags, 
  accentColor = 'blue',
  screenshot,
  screenshotLight
} = Astro.props;

const optimizedScreenshot = screenshot ? await getImage({
  src: screenshot,
  format: 'webp',
  width: 640,
  quality: 80
}) : null;

const optimizedScreenshotLight = screenshotLight ? await getImage({
  src: screenshotLight,
  format: 'webp',
  width: 640,
  quality: 80
}) : null;

// Dynamically assign classes based on color-coding preferences
const colorClasses = {
  blue: {
    border: 'hover:border-brand-blue/40 border-element-border',
    glow: 'group-hover:bg-brand-blue/10',
    tagBg: 'bg-white/5 border-white/10 text-gray-400 hover:bg-brand-blue/15 hover:border-brand-blue/30 hover:text-sky-300 light:bg-white light:border-slate-200 light:text-slate-500 light:hover:bg-blue-50 light:hover:border-brand-blue/30 light:hover:text-brand-blue',
    btnBg: 'bg-brand-blue/12 hover:bg-brand-blue/25 border border-brand-blue/20 hover:border-brand-blue/45 text-sky-300 light:text-brand-blue',
    iconColor: 'text-brand-blue'
  },
  yellow: {
    border: 'hover:border-brand-yellow/40 border-element-border',
    glow: 'group-hover:bg-brand-yellow/10',
    tagBg: 'bg-white/5 border-white/10 text-gray-400 hover:bg-brand-yellow/15 hover:border-brand-yellow/30 hover:text-amber-300 light:bg-white light:border-slate-200 light:text-slate-500 light:hover:bg-amber-50 light:hover:border-brand-yellow/30 light:hover:text-amber-600',
    btnBg: 'bg-brand-yellow/12 hover:bg-brand-yellow/25 border border-brand-yellow/20 hover:border-brand-yellow/45 text-amber-300 light:text-amber-600',
    iconColor: 'text-brand-yellow'
  },
  purple: {
    border: 'hover:border-brand-purple/40 border-element-border',
    glow: 'group-hover:bg-brand-purple/10',
    tagBg: 'bg-white/5 border-white/10 text-gray-400 hover:bg-brand-purple/15 hover:border-brand-purple/30 hover:text-purple-300 light:bg-white light:border-slate-200 light:text-slate-500 light:hover:bg-purple-50 light:hover:border-brand-purple/30 light:hover:text-brand-purple',
    btnBg: 'bg-brand-purple/12 hover:bg-brand-purple/25 border border-brand-purple/20 hover:border-brand-purple/45 text-purple-300 light:text-brand-purple',
    iconColor: 'text-brand-purple'
  },
  green: {
    border: 'hover:border-brand-green/40 border-element-border',
    glow: 'group-hover:bg-brand-green/10',
    tagBg: 'bg-white/5 border-white/10 text-gray-400 hover:bg-brand-green/15 hover:border-brand-green/30 hover:text-emerald-300 light:bg-white light:border-slate-200 light:text-slate-500 light:hover:bg-emerald-50 light:hover:border-brand-green/30 light:hover:text-brand-green',
    btnBg: 'bg-brand-green/12 hover:bg-brand-green/25 border border-brand-green/20 hover:border-brand-green/45 text-emerald-300 light:text-brand-green',
    iconColor: 'text-brand-green'
  }
}[accentColor];

const badgeColorClass = {
  blue: 'badge-new-blue',
  yellow: 'badge-new-yellow',
  purple: 'badge-new-purple',
  green: 'badge-new-green'
}[accentColor];
---

<a 
  href={href} 
  class={`glass-card h-full rounded-2xl border flex flex-col group overflow-hidden relative cursor-pointer ${colorClasses.border}`}
>
  <!-- Interactive Glow Element -->
  <div class={`absolute top-0 right-0 w-32 h-32 rounded-full filter blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none ${colorClasses.glow}`}></div>
  
  <!-- Card Header Banner (Preview or Placeholder) -->
  <div class="aspect-video w-full overflow-hidden bg-gray-950 flex items-center justify-center relative" style="transform: translate3d(0, 0, 0); backface-visibility: hidden; -webkit-backface-visibility: hidden;">
    {screenshot ? (
      <svg 
        class="absolute inset-0 w-full h-full group-hover:scale-105 transition-transform duration-500 z-0 will-change-transform pointer-events-none" 
        viewBox="0 0 160 90" 
        preserveAspectRatio="none"
        role="img"
        aria-label={`Project preview: ${title}`}
      >
        <defs>
          <linearGradient id={`grad-project-dark-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#000000" stop-opacity="0" />
            <stop offset="60%" stop-color="#000000" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0.85" />
          </linearGradient>
          <linearGradient id={`grad-project-light-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#000000" stop-opacity="0" />
            <stop offset="60%" stop-color="#000000" stop-opacity="0.15" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0.45" />
          </linearGradient>
        </defs>
        <image 
          href={optimizedScreenshot ? optimizedScreenshot.src : ''} 
          x="0" 
          y="0" 
          width="160" 
          height="90" 
          preserveAspectRatio="xMidYMid slice" 
          class={optimizedScreenshotLight ? "block light:hidden" : "block"}
        />
        {optimizedScreenshotLight && (
          <image 
            href={optimizedScreenshotLight.src} 
            x="0" 
            y="0" 
            width="160" 
            height="90" 
            preserveAspectRatio="xMidYMid slice" 
            class="hidden light:block"
          />
        )}
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="block light:hidden"
          fill={`url(#grad-project-dark-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="hidden light:block"
          fill={`url(#grad-project-light-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
      </svg>
    ) : (
      <>
        <!-- Premium gradient placeholder for missing preview -->
        <div class={`absolute inset-0 bg-gradient-to-br from-brand-${accentColor}/20 via-brand-purple/5 to-blue-950/40 light:to-slate-100/40 group-hover:scale-105 transition-transform duration-500 z-0`}></div>
        <div class="text-4xl select-none relative z-10 filter opacity-60 group-hover:scale-110 transition-transform duration-500">
          🚀
        </div>
      </>
    )}
  </div>

  <!-- Content Padding Wrapper -->
  <div class="p-6 md:p-8 flex flex-col flex-grow border-t border-element-border">
    <div>
      <!-- Header -->
      <div class="flex items-start justify-between mb-4 w-full">
        <div class="w-full">
          <h3 class={`text-xl md:text-2xl font-bold text-gray-100 tracking-tight group-hover:text-brand-${accentColor} transition-all duration-300`}>
            {title}
            <span 
              class={`unread-dot hidden badge-new ${badgeColorClass} ml-2 align-middle`} 
              data-item-url={href}
              title="Unread project"
            >UNREAD</span>
          </h3>
          <p class={`text-sm font-semibold tracking-wide mt-1 uppercase ${colorClasses.iconColor}`}>
            {tagline}
          </p>
        </div>
      </div>
      
      <!-- Description -->
      <p class="text-gray-400 text-sm md:text-base leading-relaxed mb-4 font-normal">
        {description}
      </p>
    </div>

    <!-- Tech tags & actions footer -->
    <div class="flex-grow flex flex-col justify-between mt-2">
      <div class="flex flex-wrap gap-1.5 mb-3">
        {tags.map(tag => (
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border transition-colors ${colorClasses.tagBg}`}>
            #{tag}
          </span>
        ))}
      </div>
      
      <div class="flex justify-center mt-3">
        <span 
          class={`inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-xs font-bold relative z-20 transition-all hover:scale-105 ${colorClasses.btnBg}`}
        >
          <span>Read More</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
          </svg>
        </span>
      </div>
    </div>
  </div>
</a>
