---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description?: string;
  href: string;
  language: 'de' | 'en';
  screenshot?: ImageMetadata;
  screenshotLight?: ImageMetadata;
  tags?: string[];
  activeTag?: string;
}

const { 
  title, 
  description, 
  href, 
  language, 
  screenshot, 
  screenshotLight, 
  tags = [],
  activeTag
} = Astro.props;

const optimizedScreenshot = screenshot ? await getImage({
  src: screenshot,
  format: 'webp',
  width: 480,
  quality: 80
}) : null;

const optimizedScreenshotLight = screenshotLight ? await getImage({
  src: screenshotLight,
  format: 'webp',
  width: 480,
  quality: 80
}) : null;
---

<div class="glass-card h-full rounded-2xl border border-element-border flex flex-col group overflow-hidden relative cursor-pointer hover:border-brand-yellow/30">
  <!-- Absolute overlay link for card clickability -->
  <a href={href} class="absolute inset-0 z-10" aria-label={title}></a>

  <!-- Card Header Banner (Preview or Placeholder) -->
  <div class="aspect-video w-full overflow-hidden bg-gray-950 flex items-center justify-center relative" style="transform: translate3d(0, 0, 0); backface-visibility: hidden; -webkit-backface-visibility: hidden;">
    {screenshot ? (
      <svg 
        class="absolute inset-0 w-full h-full group-hover:scale-105 transition-transform duration-500 z-0 pointer-events-none" 
        viewBox="0 0 160 90" 
        preserveAspectRatio="none"
        role="img"
        aria-label={`Course preview: ${title}`}
      >
        <defs>
          <linearGradient id={`grad-course-dark-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#000000" stop-opacity="0" />
            <stop offset="60%" stop-color="#000000" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0.85" />
          </linearGradient>
          <linearGradient id={`grad-course-light-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#000000" stop-opacity="0" />
            <stop offset="60%" stop-color="#000000" stop-opacity="0.15" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0.45" />
          </linearGradient>
        </defs>
        <image 
          href={optimizedScreenshot ? optimizedScreenshot.src : (screenshot ? screenshot.src : '')} 
          x="0" 
          y="0" 
          width="160" 
          height="90" 
          preserveAspectRatio="xMidYMid slice" 
          class={optimizedScreenshotLight ? "block light:hidden" : "block"}
        />
        {optimizedScreenshotLight && (
          <image 
            href={optimizedScreenshotLight.src} 
            x="0" 
            y="0" 
            width="160" 
            height="90" 
            preserveAspectRatio="xMidYMid slice" 
            class="hidden light:block"
          />
        )}
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="block light:hidden"
          fill={`url(#grad-course-dark-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="hidden light:block"
          fill={`url(#grad-course-light-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
      </svg>
    ) : (
      <>
        <!-- Premium gradient placeholder for missing preview -->
        <div class="absolute inset-0 bg-gradient-to-br from-brand-yellow/20 via-brand-purple/5 to-blue-950/40 light:to-slate-100/40 group-hover:scale-105 transition-transform duration-500 z-0"></div>
        <div class="text-4xl select-none relative z-10 filter opacity-60 group-hover:scale-110 transition-transform duration-500">
          🎓
        </div>
      </>
    )}

    <!-- Instruction language badge -->
    <span class="absolute top-4 right-4 z-20 inline-flex items-center text-[10px] font-bold px-2 py-0.5 rounded bg-slate-950/80 text-white border border-white/15 uppercase select-none">
      {language}
    </span>
  </div>

  <!-- Details -->
  <div class="p-5 md:p-6 flex flex-col flex-grow border-t border-element-border">
    <div>
      <h2 class="text-lg font-bold text-gray-100 mb-2 group-hover:text-brand-yellow transition-colors leading-tight">
        {title}
        <span 
          class="unread-dot hidden badge-new badge-new-yellow ml-2 align-middle" 
          data-item-url={href}
          title="Unread course"
        >UNREAD</span>
      </h2>

      {description && (
        <p class="text-gray-400 text-sm leading-relaxed mb-3 font-normal">
          {description}
        </p>
      )}
    </div>

    <!-- Tags & Action Button Area -->
    <div class="flex-grow flex flex-col mt-3">
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 relative z-20 self-start">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag}/`}
              data-tag={tag}
              class={`tag-chip tag-chip-yellow inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border relative z-20 hover:scale-105 ${
                activeTag === tag ? 'active-tag-match' : ''
              }`}
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      <!-- Read more button — full width, pinned to bottom -->
      <div class="mt-auto pt-6 w-full">
        <a 
          href={href} 
          class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-brand-yellow/12 hover:bg-brand-yellow/25 border border-brand-yellow/20 hover:border-brand-yellow/45 text-amber-300 light:text-amber-700 text-xs font-bold relative z-20 transition-all duration-200"
        >
          <span>Read More</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
