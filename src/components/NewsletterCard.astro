---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDate } from "@commons/shared/format";

interface Props {
  id: string;
  issueNumber: number;
  title: string;
  description: string;
  pubDate: Date;
  icon?: ImageMetadata | { src: ImageMetadata; title: string; description: string };
  image?: ImageMetadata | { src: ImageMetadata; title: string; description: string };
  tags?: (string | { id: string })[];
  activeTag?: string | string[];
  showTags?: boolean;
}

const {
  id,
  issueNumber,
  title,
  description,
  pubDate,
  icon,
  image,
tags: rawTags = [],
  activeTag,
  showTags,
} = Astro.props;

const tags: string[] = (rawTags || []).map((t) => (typeof t === 'string' ? t : t.id));
const isTagActive = (t: string) => (!activeTag ? false : Array.isArray(activeTag) ? activeTag.includes(t) : activeTag === t);
const shouldShowTags = Boolean(showTags || (activeTag && (Array.isArray(activeTag) ? activeTag.length > 0 : activeTag.trim().length > 0)));

const effImg = image || icon;
const isCoverObj = Boolean(effImg && typeof effImg === 'object' && 'src' in effImg && effImg.src);
const iconImg = isCoverObj ? (effImg as { src: ImageMetadata }).src : (effImg as ImageMetadata | undefined);
const iconTitle = isCoverObj ? (effImg as { title: string }).title : title;
const iconDesc = isCoverObj ? (effImg as { description: string }).description : (description || `Preview for ${title}`);

const isSvg = iconImg && typeof iconImg === 'object' && 'format' in iconImg && iconImg.format === 'svg';

const optimizedIcon = iconImg && !isSvg ? await getImage({
  src: iconImg,
  format: 'webp',
  width: 800,
  quality: 80,
}) : null;

const articleClass =
  "glass-card preview-card border border-element-border flex flex-col items-stretch group relative cursor-pointer hover:border-domain-newsletters/40 transition-all duration-300 h-full w-full";
const imageContainerClass =
  "w-full aspect-video shrink-0 overflow-hidden border-b border-element-border-medium bg-gray-900 flex items-center justify-center relative z-10";
---

<article class={articleClass} data-card-id={id} data-collection="newsletters" data-tags={tags.join(',')}>
  <!-- Visual header panel -->
  <div class={imageContainerClass}>
    <a href={`/newsletters/${id}/`} class="absolute inset-0 z-20" aria-hidden="true" tabindex="-1"></a>
    {icon ? (
      <div class="relative w-full h-full min-h-[160px] overflow-hidden flex items-center justify-center">
        <img
          src={optimizedIcon ? optimizedIcon.src : (typeof iconImg === 'string' ? iconImg : (iconImg?.src || ''))}
          alt={iconDesc}
          title={iconTitle}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent block light:hidden pointer-events-none z-10"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/25 via-transparent to-transparent hidden light:block pointer-events-none z-10"></div>
      </div>
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-domain-newsletters/20 via-element-bg to-bg-main flex flex-col items-center justify-center gap-2">
        <svg class="w-12 h-12 text-domain-newsletters/35 light:text-domain-newsletters/55" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex-grow flex flex-col relative z-10 preview-card-body">
    <!-- Meta row -->
    <div class="flex flex-wrap items-center gap-2 mb-1.5">
      <time class="text-xs font-semibold text-domain-newsletters">
        {formatDate(pubDate, 'short')}
      </time>
      <span class="text-gray-500 text-xs">•</span>
      <span class="text-xs font-medium text-gray-400 light:text-slate-500">
        Issue #{issueNumber}
      </span>
    </div>

    <!-- Title -->
    <h2 class="text-base sm:text-lg font-bold text-gray-100 mb-2 group-hover:text-domain-newsletters light:group-hover:text-domain-newsletters transition-colors leading-snug line-clamp-2 min-h-[2lh]" title={title}>
      <a href={`/newsletters/${id}/`} class="after:absolute after:inset-0 after:z-10">
        {title}
      </a>
    </h2>

    <!-- Description -->
    <p class="text-gray-400 light:text-slate-600 text-sm mb-3 leading-relaxed font-normal line-clamp-3 min-h-[3lh]">
      {description}
    </p>

    <!-- Tags & Action Button Area -->
    {shouldShowTags && tags && tags.length > 0 ? (
      <div class="flex-grow flex flex-col mt-3">
        <div class="flex flex-wrap gap-2 self-start">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag}/`}
              data-tag={tag}
              class={`tag-chip tag-chip-newsletters inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border relative z-20 hover:scale-105 ${
                isTagActive(tag) ? 'active-tag-match' : ''
              }`}
            >
              #{tag}
            </a>
          ))}
        </div>

        <!-- Read more button — full width, pinned to bottom -->
        <div class="mt-auto pt-5 w-full">
          <a
            href={`/newsletters/${id}/`}
            aria-label={`Read More: ${title}`}
            class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-domain-newsletters/12 hover:bg-domain-newsletters/25 border border-domain-newsletters/20 hover:border-domain-newsletters/45 text-domain-newsletters text-xs font-bold relative z-20 transition-all duration-200"
          >
            <span>Read More</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <div class="mt-auto pt-4 w-full">
        <a
          href={`/newsletters/${id}/`}
          aria-label={`Read More: ${title}`}
          class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-domain-newsletters/12 hover:bg-domain-newsletters/25 border border-domain-newsletters/20 hover:border-domain-newsletters/45 text-domain-newsletters text-xs font-bold relative z-20 transition-all duration-200"
        >
          <span>Read More</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</article>
