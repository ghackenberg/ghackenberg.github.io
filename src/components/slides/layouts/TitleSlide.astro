---
import SlideBase from '../primitives/SlideBase.astro';

interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  class?: string;
}

const {
  title,
  subtitle,
  badge = "KEYNOTE",
  slideNumber = 1,
  totalSlides = 30,
  class: className = ""
} = Astro.props;
---

<SlideBase
  badge={badge}
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  class={className}
>
  <div class="grid grid-cols-12 gap-10 h-full w-full items-stretch">
    <!-- Left: Hero Titles & Topic Presentation -->
    <div class="col-span-7 h-full flex flex-col justify-between py-4 min-h-0">
      <div class="flex flex-col gap-6">
        <div class="inline-flex items-center gap-3">
          <span class="px-5 py-2 rounded-full text-sm font-mono font-bold tracking-widest uppercase bg-blue-500/20 text-blue-400 light:bg-blue-100 light:text-blue-700 border border-blue-500/40 light:border-blue-300">
            {badge}
          </span>
        </div>

        <h1 class="text-5xl lg:text-6xl xl:text-7xl font-black text-slate-100 light:text-slate-900 tracking-tight leading-[1.12] text-balance">
          {title}
        </h1>

        {subtitle && (
          <p class="text-2xl lg:text-3xl text-slate-300 light:text-slate-600 leading-relaxed font-normal text-pretty">
            {subtitle}
          </p>
        )}
      </div>

      <div class="pt-6 flex items-center gap-6 text-base font-mono text-slate-400 light:text-slate-500 border-t border-slate-800/80 light:border-slate-200">
        <span class="flex items-center gap-2 font-bold text-slate-300 light:text-slate-700">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
          Oktober 2026
        </span>
        <span>•</span>
        <span>Industrie & B2B Traunviertel</span>
      </div>
    </div>

    <!-- Right: Speaker Card or Custom Visual Slot -->
    <div class="col-span-5 h-full flex flex-col justify-stretch items-stretch min-h-0">
      <slot />
    </div>
  </div>
</SlideBase>
