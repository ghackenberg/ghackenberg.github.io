---
import SlideBase from '../primitives/SlideBase.astro';
import { resolveAccentName, getCycleAccent, type SlideAccent } from '@commons/shared/accent-system';

interface Props {
  title?: string;
  subtitle?: string;
  subtitleCue?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  accent?: SlideAccent;
  startAccent?: SlideAccent;
  class?: string;
}

const {
  title,
  subtitle,
  subtitleCue,
  slideNumber,
  totalSlides,
  accent,
  startAccent,
  class: className = ""
} = Astro.props;

const activeAccentName = resolveAccentName(startAccent || accent || 'blue');
const bottomAccent = getCycleAccent(activeAccentName, 3);
---

<SlideBase
  title={title}
  subtitle={subtitle}
  subtitleCue={subtitleCue}
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  accent={accent}
  startAccent={startAccent}
  class={className}
>
  <div class="h-full w-full flex flex-col justify-between gap-8 min-h-0">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch flex-1 min-h-0">
      <slot name="metrics" />
    </div>
    {Astro.slots.has('default') && (
      <div class="shrink-0" style={`--card-accent: var(--color-slide-accent-${bottomAccent.name});`}>
        <slot />
      </div>
    )}
  </div>
</SlideBase>
