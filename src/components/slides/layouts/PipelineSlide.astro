---
import SlideBase from '../primitives/SlideBase.astro';

interface Props {
  title?: string;
  subtitle?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  direction?: 'horizontal' | 'vertical';
  class?: string;
}

const {
  title,
  subtitle,
  slideNumber,
  totalSlides,
  direction = 'horizontal',
  class: className = ""
} = Astro.props;
---

<SlideBase
  title={title}
  subtitle={subtitle}
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  class={className}
>
  <div data-direction={direction} class={`h-full w-full min-h-0 min-w-0 flex flex-col items-stretch ${className}`}>
    <slot />
  </div>
</SlideBase>
