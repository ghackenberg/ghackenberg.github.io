---
import SlideBase from '../primitives/SlideBase.astro';

interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  direction?: 'horizontal' | 'vertical';
  class?: string;
}

const {
  title,
  subtitle,
  badge,
  slideNumber,
  totalSlides,
  direction = 'horizontal',
  class: className = ""
} = Astro.props;
---

<SlideBase
  title={title}
  subtitle={subtitle}
  badge={badge}
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  class={className}
>
  <div class={`h-full w-full flex ${direction === 'horizontal' ? 'flex-row items-stretch gap-6' : 'flex-col justify-between gap-4'}`}>
    <slot />
  </div>
</SlideBase>
