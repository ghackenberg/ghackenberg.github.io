---
import SlideBase from '../primitives/SlideBase.astro';
import { renderSlideCues } from '../../../utils/slide-cues';

interface Props {
  chapter: string;
  icon?: 'network' | 'pillars' | 'terminal' | 'orbit' | 'compass';
  title: string;
  subtitle?: string;
  subtitleCue?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  showFooter?: boolean;
  presentationTitle?: string;
  class?: string;
}

const {
  chapter,
  icon = 'network',
  title,
  subtitle,
  subtitleCue = "sub",
  slideNumber,
  totalSlides = 56,
  showFooter = true,
  presentationTitle,
  class: className = ""
} = Astro.props;
---

<SlideBase
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  showFooter={showFooter}
  presentationTitle={presentationTitle}
  class={className}
>
  <div class="relative h-full w-full flex flex-col justify-between items-center text-center px-8 py-3 select-none">
    <!-- Atmospheric Center Halo & SVG Artwork Watermark (Z-0) -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none overflow-hidden select-none z-0" aria-hidden="true">
      <!-- Ambient Center Radial Glow -->
      <div class="w-[850px] h-[850px] rounded-full bg-gradient-to-tr from-blue-600/15 via-indigo-500/10 to-cyan-400/15 blur-[120px] light:from-blue-400/15 light:via-indigo-300/10 light:to-cyan-300/15"></div>

      <!-- Large Geometric SVG Watermark (560x560, 13% dark / 8% light) -->
      <div class="absolute w-[560px] h-[560px] flex items-center justify-center opacity-[0.13] light:opacity-[0.08] text-cyan-400 light:text-blue-700 transition-opacity duration-700">
        {icon === 'network' && (
          <svg class="w-full h-full" viewBox="0 0 500 500" fill="none" stroke="currentColor">
            <!-- Outer Constellation Orbit -->
            <circle cx="250" cy="250" r="210" stroke-width="1.5" stroke-dasharray="6 6" />
            <circle cx="250" cy="250" r="150" stroke-width="1.5" opacity="0.6" />
            
            <!-- Graph Nodes -->
            <circle cx="250" cy="250" r="32" fill="currentColor" fill-opacity="0.15" stroke-width="3" />
            <circle cx="250" cy="90" r="16" fill="currentColor" fill-opacity="0.2" stroke-width="2" />
            <circle cx="390" cy="180" r="18" fill="currentColor" fill-opacity="0.2" stroke-width="2" />
            <circle cx="370" cy="340" r="14" fill="currentColor" fill-opacity="0.2" stroke-width="2" />
            <circle cx="130" cy="340" r="18" fill="currentColor" fill-opacity="0.2" stroke-width="2" />
            <circle cx="110" cy="180" r="15" fill="currentColor" fill-opacity="0.2" stroke-width="2" />
            <circle cx="250" cy="410" r="16" fill="currentColor" fill-opacity="0.2" stroke-width="2" />
            
            <!-- Inner Connection Edges -->
            <line x1="250" y1="218" x2="250" y2="106" stroke-width="2" />
            <line x1="275" y1="230" x2="375" y2="190" stroke-width="2" />
            <line x1="272" y1="268" x2="358" y2="330" stroke-width="2" />
            <line x1="250" y1="282" x2="250" y2="394" stroke-width="2" />
            <line x1="228" y1="268" x2="142" y2="330" stroke-width="2" />
            <line x1="225" y1="230" x2="125" y2="190" stroke-width="2" />
            
            <!-- Cross-Mesh Relations -->
            <line x1="250" y1="90" x2="390" y2="180" stroke-width="1.5" stroke-dasharray="4 4" />
            <line x1="390" y1="180" x2="370" y2="340" stroke-width="1.5" stroke-dasharray="4 4" />
            <line x1="370" y1="340" x2="250" y2="410" stroke-width="1.5" stroke-dasharray="4 4" />
            <line x1="250" y1="410" x2="130" y2="340" stroke-width="1.5" stroke-dasharray="4 4" />
            <line x1="130" y1="340" x2="110" y2="180" stroke-width="1.5" stroke-dasharray="4 4" />
            <line x1="110" y1="180" x2="250" y2="90" stroke-width="1.5" stroke-dasharray="4 4" />
          </svg>
        )}

        {icon === 'pillars' && (
          <svg class="w-full h-full" viewBox="0 0 500 500" fill="none" stroke="currentColor">
            <!-- Architectural Pediment / Synthesis Cap -->
            <polygon points="250,70 90,140 410,140" stroke-width="2" fill="currentColor" fill-opacity="0.1" />
            <line x1="70" y1="150" x2="430" y2="150" stroke-width="3" />

            <!-- Pillar 1: Strukturierte Daten -->
            <rect x="110" y="165" width="60" height="200" rx="6" stroke-width="2.5" fill="currentColor" fill-opacity="0.08" />
            <line x1="125" y1="185" x2="125" y2="345" stroke-width="1.5" stroke-dasharray="4 4" />
            <line x1="155" y1="185" x2="155" y2="345" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- Pillar 2: E-E-A-T Autorität (Higher central pillar) -->
            <rect x="220" y="155" width="60" height="210" rx="6" stroke-width="3" fill="currentColor" fill-opacity="0.15" />
            <line x1="235" y1="175" x2="235" y2="345" stroke-width="2" />
            <line x1="265" y1="175" x2="265" y2="345" stroke-width="2" />

            <!-- Pillar 3: Information Gain -->
            <rect x="330" y="165" width="60" height="200" rx="6" stroke-width="2.5" fill="currentColor" fill-opacity="0.08" />
            <line x1="345" y1="185" x2="345" y2="345" stroke-width="1.5" stroke-dasharray="4 4" />
            <line x1="375" y1="185" x2="375" y2="345" stroke-width="1.5" stroke-dasharray="4 4" />

            <!-- Stepped Foundation Plinth -->
            <rect x="80" y="375" width="340" height="25" rx="4" stroke-width="2.5" fill="currentColor" fill-opacity="0.1" />
            <rect x="60" y="405" width="380" height="25" rx="4" stroke-width="3" fill="currentColor" fill-opacity="0.15" />
          </svg>
        )}

        {icon === 'terminal' && (
          <svg class="w-full h-full" viewBox="0 0 500 500" fill="none" stroke="currentColor">
            <!-- IDE / Terminal Window Frame -->
            <rect x="70" y="90" width="360" height="300" rx="16" stroke-width="2.5" fill="currentColor" fill-opacity="0.08" />
            <line x1="70" y1="140" x2="430" y2="140" stroke-width="2" />
            
            <!-- Window Buttons -->
            <circle cx="105" cy="115" r="7" fill="currentColor" fill-opacity="0.4" />
            <circle cx="130" cy="115" r="7" fill="currentColor" fill-opacity="0.4" />
            <circle cx="155" cy="115" r="7" fill="currentColor" fill-opacity="0.4" />

            <!-- Agentic Loop Glyphs -->
            <path d="M 120 210 L 160 245 L 120 280" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="180" y1="280" x2="230" y2="280" stroke-width="3" stroke-linecap="round" />

            <!-- MCP Socket Hub (Center Right) -->
            <circle cx="320" cy="245" r="45" stroke-width="2.5" stroke-dasharray="6 4" />
            <circle cx="320" cy="245" r="22" stroke-width="2" fill="currentColor" fill-opacity="0.2" />
            <circle cx="320" cy="165" r="10" fill="currentColor" fill-opacity="0.3" stroke-width="1.5" />
            <circle cx="385" cy="285" r="10" fill="currentColor" fill-opacity="0.3" stroke-width="1.5" />
            <circle cx="255" cy="285" r="10" fill="currentColor" fill-opacity="0.3" stroke-width="1.5" />
            <line x1="320" y1="200" x2="320" y2="223" stroke-width="2" />
            <line x1="340" y1="260" x2="375" y2="280" stroke-width="2" />
            <line x1="300" y1="260" x2="265" y2="280" stroke-width="2" />

            <!-- CI/CD Orbit -->
            <ellipse cx="250" cy="420" rx="140" ry="24" stroke-width="1.5" stroke-dasharray="5 5" />
          </svg>
        )}

        {icon === 'orbit' && (
          <svg class="w-full h-full" viewBox="0 0 500 500" fill="none" stroke="currentColor">
            <!-- Orbital Rings -->
            <circle cx="250" cy="250" r="190" stroke-width="1.5" stroke-dasharray="6 6" />
            <ellipse cx="250" cy="250" rx="210" ry="110" stroke-width="2" transform="rotate(-25 250 250)" />
            <ellipse cx="250" cy="250" rx="210" ry="110" stroke-width="1.5" stroke-dasharray="4 4" transform="rotate(35 250 250)" />

            <!-- Central Author Hub (Entity Node) -->
            <circle cx="250" cy="250" r="44" stroke-width="3" fill="currentColor" fill-opacity="0.2" />
            <circle cx="250" cy="235" r="15" stroke-width="2" fill="currentColor" fill-opacity="0.4" />
            <path d="M 230 268 C 230 254 270 254 270 268" stroke-width="2" fill="none" />

            <!-- Satellite Identity Nodes (sameAs) -->
            <circle cx="100" cy="180" r="22" stroke-width="2" fill="currentColor" fill-opacity="0.15" />
            <circle cx="400" cy="160" r="22" stroke-width="2" fill="currentColor" fill-opacity="0.15" />
            <circle cx="360" cy="370" r="18" stroke-width="2" fill="currentColor" fill-opacity="0.15" />
            <circle cx="140" cy="350" r="20" stroke-width="2" fill="currentColor" fill-opacity="0.15" />

            <!-- Ray Connections -->
            <line x1="210" y1="230" x2="120" y2="190" stroke-width="2" />
            <line x1="290" y1="230" x2="380" y2="170" stroke-width="2" />
            <line x1="280" y1="280" x2="345" y2="355" stroke-width="2" />
            <line x1="220" y1="280" x2="155" y2="335" stroke-width="2" />
          </svg>
        )}

        {icon === 'compass' && (
          <svg class="w-full h-full" viewBox="0 0 500 500" fill="none" stroke="currentColor">
            <!-- Strategic Dial & Milestone Arcs -->
            <circle cx="250" cy="250" r="200" stroke-width="2" />
            <circle cx="250" cy="250" r="160" stroke-width="1.5" stroke-dasharray="5 5" />
            <circle cx="250" cy="250" r="18" fill="currentColor" fill-opacity="0.3" stroke-width="2" />

            <!-- Compass Ticks -->
            <line x1="250" y1="50" x2="250" y2="70" stroke-width="3" />
            <line x1="250" y1="430" x2="250" y2="450" stroke-width="3" />
            <line x1="50" y1="250" x2="70" y2="250" stroke-width="3" />
            <line x1="430" y1="250" x2="450" y2="250" stroke-width="3" />

            <!-- 90-Day Trajectory Growth Vector Arrow -->
            <path d="M 120 360 Q 220 310 270 210 T 380 110" stroke-width="3.5" stroke-linecap="round" fill="none" />
            <polygon points="380,110 350,115 375,140" fill="currentColor" />

            <!-- Milestone Waypoint Nodes (30d, 60d, 90d) -->
            <circle cx="160" cy="335" r="10" fill="currentColor" fill-opacity="0.3" stroke-width="2" />
            <circle cx="250" cy="250" r="12" fill="currentColor" fill-opacity="0.4" stroke-width="2" />
            <circle cx="320" cy="165" r="12" fill="currentColor" fill-opacity="0.4" stroke-width="2" />
          </svg>
        )}
      </div>
    </div>

    <!-- Foreground Top Row: Floating Chapter Tracker & Slide Number (Z-10) -->
    <div class="relative z-10 w-full flex items-center justify-between shrink-0">
      <div class="inline-flex items-center gap-3.5 px-6 py-2.5 rounded-full bg-slate-900/80 light:bg-slate-100/90 border border-slate-700/80 light:border-slate-300 shadow-xl backdrop-blur-md">
        <span class="w-3 h-3 rounded-full bg-cyan-400 light:bg-blue-600 shadow-[0_0_12px_rgba(34,211,238,0.85)] animate-pulse"></span>
        <span class="text-xl font-mono font-bold tracking-widest uppercase text-blue-300 light:text-blue-700">
          {chapter}
        </span>
      </div>

      {slideNumber && (
        <div class="slide-number-badge">
          <span class="text-xl font-mono text-slate-400 light:text-slate-500 font-bold">
            {String(slideNumber).padStart(2, '0')} / {totalSlides}
          </span>
        </div>
      )}
    </div>

    <!-- Center Stage: Pure Typographic Grandeur (Z-10) -->
    <div class="relative z-10 flex-1 flex flex-col justify-center items-center max-w-5xl mx-auto w-full py-2">
      <!-- Monumental Chapter Title -->
      <h1 class="text-7xl lg:text-8xl xl:text-[84px] font-black tracking-tight text-white light:text-slate-950 leading-[1.05] text-balance mb-4">
        {title}
      </h1>

      <!-- Subtitle with CUE highlight -->
      {subtitle && (
        <p
          data-cue={subtitleCue}
          data-dim="false"
          class="text-2xl lg:text-3xl text-slate-400 light:text-slate-600 font-medium tracking-wide max-w-4xl leading-relaxed mb-8"
          set:html={renderSlideCues(subtitle)}
        />
      )}

      <!-- Subtle Glowing Gradient Line -->
      <div class="w-36 h-1 bg-gradient-to-r from-transparent via-cyan-400 light:via-blue-500 to-transparent mb-8 opacity-75"></div>

      <!-- The Provocative Leitfrage (Slot 1) -->
      <div class="w-full max-w-4xl">
        <slot name="question" />
      </div>

      <!-- The Strategic Bridge (Slot 2) -->
      <div class="w-full max-w-3xl mt-6">
        <slot name="bridge" />
      </div>
    </div>

    <!-- Bottom Spacing -->
    <div class="h-2 shrink-0"></div>
  </div>
</SlideBase>
