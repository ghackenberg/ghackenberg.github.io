---
import SlideBase from '../primitives/SlideBase.astro';
import { renderSlideCues } from '@commons/shared/slide-cues';
import type { SlideAccent } from '@commons/shared/accent-system';

interface Props {
  chapter: string;
  title: string;
  subtitle?: string;
  subtitleCue?: string;
  dividerCue?: string;
  questionCue?: string;
  bridgeCue?: string;
  question?: string;
  bridge?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  showFooter?: boolean;
  presentationTitle?: string;
  accent?: SlideAccent;
  startAccent?: SlideAccent;
  class?: string;
}

const {
  chapter,
  title,
  subtitle,
  subtitleCue = "sub",
  dividerCue = `card-divider-${String(Astro.props.slideNumber || '01').padStart(2, '0')}`,
  questionCue = `card-leitfrage-${String(Astro.props.slideNumber || '01').padStart(2, '0')}`,
  bridgeCue = `card-bridge-${String(Astro.props.slideNumber || '01').padStart(2, '0')}`,
  question,
  bridge,
  slideNumber,
  totalSlides = 56,
  showFooter = true,
  presentationTitle,
  accent,
  startAccent,
  class: className = ""
} = Astro.props;
---

<SlideBase
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  showFooter={showFooter}
  presentationTitle={presentationTitle}
  isSection={true}
  accent={accent}
  startAccent={startAccent}
  class={className}
>
  <div class="relative h-full w-full flex flex-col justify-between items-center text-center px-8 py-3 select-none">
    <!-- Top Row: Slide Number Badge (Top Right) -->
    <div class="relative z-10 w-full flex items-center justify-end shrink-0">
      {slideNumber && (
        <div class="slide-number-badge">
          <span class="text-xl font-mono text-slate-400 light:text-slate-500 font-bold">
            {String(slideNumber).padStart(2, '0')} / {totalSlides}
          </span>
        </div>
      )}
    </div>

    <!-- Center Stage: Dynamic Progressive Unfolding Container -->
    <div class="relative z-10 flex-1 flex flex-col justify-center items-center max-w-5xl mx-auto w-full my-auto transition-all duration-700">
      <!-- 1. Anchor: Chapter Badge & Monumental Title (Always Visible & Initial Center) -->
      <div class="section-hero-header flex flex-col items-center justify-center text-center w-full">
        <!-- Chapter Badge -->
        <div class="section-title-reveal inline-flex items-center px-6 py-2.5 rounded-full bg-slate-900/80 light:bg-slate-100/90 border border-slate-700/80 light:border-slate-300 shadow-xl backdrop-blur-md mb-6">
          <span class="text-lg lg:text-xl font-mono font-bold tracking-widest uppercase text-[var(--slide-accent)]">
            {chapter}
          </span>
        </div>

        <!-- Monumental Chapter Title -->
        <h1 class="section-title-reveal text-6xl lg:text-7xl xl:text-[84px] font-black tracking-tight text-white light:text-slate-950 leading-[1.06] text-balance">
          {title}
        </h1>
      </div>

      <!-- 2. Subtitle: Collapsible Reveal Item (Revealed on {cue:sub}) -->
      {subtitle && (
        <div
          data-cue={subtitleCue}
          data-dim="false"
          class="title-reveal-item grid transition-all duration-700 ease-out w-full"
        >
          <div class="overflow-hidden py-1">
            <p
              class="slide-subtitle text-2xl lg:text-3xl xl:text-4xl text-slate-300 light:text-slate-600 font-medium tracking-wide max-w-4xl mx-auto leading-relaxed text-center mt-6"
              set:html={renderSlideCues(subtitle)}
            />
          </div>
        </div>
      )}

      <!-- 3. Divider: Collapsible Reveal Item (Revealed on {cue:card-divider-XX}) -->
      <div
        data-cue={dividerCue}
        data-dim="false"
        class="title-reveal-item grid transition-all duration-700 ease-out w-full"
      >
        <div class="overflow-hidden flex justify-center py-6">
          <div class="w-36 h-1.5 bg-gradient-to-r from-transparent via-[var(--slide-accent)] to-transparent rounded-full opacity-80"></div>
        </div>
      </div>

      <!-- 4. Leitfrage (Question): Collapsible Reveal Item (Revealed on {cue:card-leitfrage-XX}) -->
      <div
        data-cue={questionCue}
        data-dim="false"
        class="title-reveal-item grid transition-all duration-700 ease-out w-full max-w-4xl mx-auto"
      >
        <div class="overflow-hidden py-2">
          <div class="section-question-container text-3xl lg:text-4xl xl:text-[42px] font-black text-[var(--slide-accent)] leading-snug tracking-tight text-center">
            {question ? <span set:html={renderSlideCues(question)} /> : <slot name="question" />}
          </div>
        </div>
      </div>

      <!-- 5. Bridge (Brücke): Collapsible Reveal Item (Revealed on {cue:card-bridge-XX}) -->
      <div
        data-cue={bridgeCue}
        data-dim="false"
        class="title-reveal-item grid transition-all duration-700 ease-out w-full max-w-3xl mx-auto"
      >
        <div class="overflow-hidden py-2 mt-4">
          <div class="section-bridge-container text-xl lg:text-2xl text-slate-300 light:text-slate-700 font-normal leading-relaxed text-center">
            {bridge ? <span set:html={renderSlideCues(bridge)} /> : <slot name="bridge" />}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Spacing -->
    <div class="h-2 shrink-0"></div>
  </div>
</SlideBase>

<style>
  .section-question-container,
  .section-question-container :global(p) {
    font-size: var(--slide-font-card-title, 2.35rem) !important;
    line-height: 1.35 !important;
  }
  .section-bridge-container,
  .section-bridge-container :global(p) {
    font-size: var(--slide-font-body, 1.75rem) !important;
    line-height: 1.5 !important;
  }

  .section-title-reveal {
    animation: section-title-fade-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes section-title-fade-in {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-title-reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  :global(.print-pdf) .section-title-reveal,
  :global(.print-slide-page) .section-title-reveal,
  :global(.reveal-viewport.export-mode) .section-title-reveal {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
