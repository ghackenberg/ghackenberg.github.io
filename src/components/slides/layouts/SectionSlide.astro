---
import SlideBase from '../primitives/SlideBase.astro';
import { renderSlideCues } from '../../../utils/slide-cues';

interface Props {
  chapter: string;
  title: string;
  subtitle?: string;
  subtitleCue?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  showFooter?: boolean;
  presentationTitle?: string;
  class?: string;
}

const {
  chapter,
  title,
  subtitle,
  subtitleCue = "sub",
  slideNumber,
  totalSlides = 56,
  showFooter = true,
  presentationTitle,
  class: className = ""
} = Astro.props;
---

<SlideBase
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  showFooter={showFooter}
  presentationTitle={presentationTitle}
  isSection={true}
  class={className}
>
  <div class="relative h-full w-full flex flex-col justify-between items-center text-center px-8 py-3 select-none">
    <!-- Top Row: Slide Number Badge (Top Right) -->
    <div class="relative z-10 w-full flex items-center justify-end shrink-0">
      {slideNumber && (
        <div class="slide-number-badge">
          <span class="text-xl font-mono text-slate-400 light:text-slate-500 font-bold">
            {String(slideNumber).padStart(2, '0')} / {totalSlides}
          </span>
        </div>
      )}
    </div>

    <!-- Center Stage: Pure Typographic Grandeur & Focused Sequential Reveal -->
    <div class="relative z-10 flex-1 flex flex-col justify-center items-center max-w-5xl mx-auto w-full py-2 my-auto">
      <!-- Chapter Badge (Automatic Entrance) -->
      <div class="section-title-reveal inline-flex items-center gap-3.5 px-6 py-2.5 rounded-full bg-slate-900/80 light:bg-slate-100/90 border border-slate-700/80 light:border-slate-300 shadow-xl backdrop-blur-md mb-6">
        <span class="w-3 h-3 rounded-full bg-cyan-400 light:bg-blue-600 shadow-[0_0_12px_rgba(34,211,238,0.85)] animate-pulse"></span>
        <span class="text-lg lg:text-xl font-mono font-bold tracking-widest uppercase text-cyan-300 light:text-blue-700">
          {chapter}
        </span>
      </div>

      <!-- Monumental Chapter Title (Automatic Entrance) -->
      <h1 class="section-title-reveal text-6xl lg:text-7xl xl:text-[84px] font-black tracking-tight text-white light:text-slate-950 leading-[1.06] text-balance mb-6">
        {title}
      </h1>

      <!-- Subtitle with CUE highlight (Sequential Entrance on {cue:sub}) -->
      {subtitle && (
        <p
          data-cue={subtitleCue}
          data-dim="false"
          class="slide-subtitle text-2xl lg:text-3xl xl:text-4xl text-slate-300 light:text-slate-600 font-medium tracking-wide max-w-4xl leading-relaxed text-center mb-8"
          set:html={renderSlideCues(subtitle)}
        />
      )}

      <!-- Subtle Glowing Gradient Line -->
      <div class="w-36 h-1 bg-gradient-to-r from-transparent via-cyan-400 light:via-blue-600 to-transparent mb-8 opacity-75 rounded-full"></div>

      <!-- The Provocative Leitfrage (Slot 1, Sequential Entrance on Leitfrage Cue) -->
      <div class="w-full max-w-4xl mx-auto mb-6">
        <slot name="question" />
      </div>

      <!-- The Strategic Bridge (Slot 2, Sequential Entrance on Bridge Cue) -->
      <div class="w-full max-w-3xl mx-auto">
        <slot name="bridge" />
      </div>
    </div>

    <!-- Bottom Spacing -->
    <div class="h-2 shrink-0"></div>
  </div>
</SlideBase>

<style>
  .section-title-reveal {
    animation: section-title-fade-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes section-title-fade-in {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-title-reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }

  :global(.print-pdf) .section-title-reveal,
  :global(.print-slide-page) .section-title-reveal,
  :global(.reveal-viewport.export-mode) .section-title-reveal {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
</style>
