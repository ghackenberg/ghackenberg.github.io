---
import SlideBase from '../primitives/SlideBase.astro';
import { renderSlideCues } from '../../../utils/slide-cues';

interface Props {
  chapter: string;
  icon?: 'network' | 'pillars' | 'terminal' | 'orbit' | 'compass';
  title: string;
  subtitle?: string;
  subtitleCue?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  showFooter?: boolean;
  presentationTitle?: string;
  class?: string;
}

const {
  chapter,
  icon = 'network',
  title,
  subtitle,
  subtitleCue = "sub",
  slideNumber,
  totalSlides = 56,
  showFooter = true,
  presentationTitle,
  class: className = ""
} = Astro.props;
---

<SlideBase
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  showFooter={showFooter}
  presentationTitle={presentationTitle}
  class={className}
>
  <div class="relative h-full w-full flex flex-col justify-between px-8 py-4 select-none">
    <!-- Top Row: Floating Chapter Tracker & Slide Number -->
    <div class="relative z-10 w-full flex items-center justify-between shrink-0">
      <div class="inline-flex items-center gap-3.5 px-6 py-2.5 rounded-full bg-slate-900/80 light:bg-slate-100/90 border border-slate-700/80 light:border-slate-300 shadow-xl backdrop-blur-md">
        <span class="w-3 h-3 rounded-full bg-cyan-400 light:bg-blue-600 shadow-[0_0_12px_rgba(34,211,238,0.85)] animate-pulse"></span>
        <span class="text-xl font-mono font-bold tracking-widest uppercase text-blue-300 light:text-blue-700">
          {chapter}
        </span>
      </div>

      {slideNumber && (
        <div class="slide-number-badge">
          <span class="text-xl font-mono text-slate-400 light:text-slate-500 font-bold">
            {String(slideNumber).padStart(2, '0')} / {totalSlides}
          </span>
        </div>
      )}
    </div>

    <!-- Main Content Area: 58/42 Left/Right Asymmetric Split Stage -->
    <div class="relative z-10 grid grid-cols-12 gap-8 lg:gap-12 items-center flex-1 my-auto w-full max-w-7xl mx-auto py-2">
      <!-- Left Column (~58% / col-span-7): Editorial Typographic Power -->
      <div class="col-span-7 flex flex-col justify-center text-left">
        <!-- Monumental Chapter Title -->
        <h1 class="text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight text-white light:text-slate-950 leading-[1.08] text-balance mb-4">
          {title}
        </h1>

        <!-- Subtitle with CUE highlight -->
        {subtitle && (
          <p
            data-cue={subtitleCue}
            data-dim="false"
            class="text-xl lg:text-2xl text-slate-300 light:text-slate-600 font-medium tracking-wide leading-relaxed mb-6"
            set:html={renderSlideCues(subtitle)}
          />
        )}

        <!-- Subtle Glowing Accent Bar -->
        <div class="w-28 h-1 bg-gradient-to-r from-cyan-400 via-blue-500 to-transparent light:from-blue-600 light:via-indigo-500 rounded-full mb-8 opacity-90"></div>

        <!-- The Provocative Leitfrage (Slot 1) -->
        <div class="w-full">
          <slot name="question" />
        </div>

        <!-- The Strategic Bridge (Slot 2) -->
        <div class="w-full mt-6">
          <slot name="bridge" />
        </div>
      </div>

      <!-- Right Column (~42% / col-span-5): Luminous Technical SVG Artpiece -->
      <div class="col-span-5 flex items-center justify-center relative">
        <!-- Radiant Ambient Glow Backdrop -->
        <div class="absolute w-[400px] h-[400px] rounded-full bg-gradient-to-tr from-cyan-500/25 via-blue-600/20 to-indigo-500/25 blur-[90px] light:from-blue-400/30 light:via-indigo-300/25 light:to-cyan-300/30 pointer-events-none"></div>

        <!-- Technical SVG Artwork Canvas (440x440) -->
        <div class="relative w-[440px] h-[440px] flex items-center justify-center drop-shadow-[0_0_35px_rgba(56,189,248,0.3)]">
          {icon === 'network' && (
            <svg class="w-full h-full" viewBox="0 0 500 500" fill="none">
              <defs>
                <linearGradient id="netGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#22d3ee" />
                  <stop offset="100%" stop-color="#3b82f6" />
                </linearGradient>
                <linearGradient id="netGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#818cf8" />
                  <stop offset="100%" stop-color="#c084fc" />
                </linearGradient>
                <radialGradient id="coreGlow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.4" />
                  <stop offset="100%" stop-color="#1e293b" stop-opacity="0" />
                </radialGradient>
              </defs>

              <!-- Outer Coordinate Rings -->
              <circle cx="250" cy="250" r="215" stroke="#334155" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.6" />
              <circle cx="250" cy="250" r="170" stroke="#38bdf8" stroke-width="1.5" opacity="0.35" />
              <circle cx="250" cy="250" r="110" stroke="#818cf8" stroke-width="1.5" stroke-dasharray="8 6" opacity="0.5" />

              <!-- Core Radial Glow -->
              <circle cx="250" cy="250" r="80" fill="url(#coreGlow)" />

              <!-- Cross-Mesh Connecting Vectors -->
              <line x1="250" y1="80" x2="395" y2="175" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />
              <line x1="395" y1="175" x2="380" y2="340" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />
              <line x1="380" y1="340" x2="250" y2="420" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />
              <line x1="250" y1="420" x2="120" y2="340" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />
              <line x1="120" y1="340" x2="105" y2="175" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />
              <line x1="105" y1="175" x2="250" y2="80" stroke="#64748b" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6" />

              <!-- Primary Directed Vector Beams -->
              <line x1="250" y1="210" x2="250" y2="105" stroke="url(#netGrad1)" stroke-width="3" />
              <line x1="278" y1="225" x2="375" y2="185" stroke="url(#netGrad1)" stroke-width="3" />
              <line x1="275" y1="268" x2="362" y2="330" stroke="url(#netGrad1)" stroke-width="2.5" />
              <line x1="250" y1="290" x2="250" y2="395" stroke="url(#netGrad2)" stroke-width="2.5" />
              <line x1="225" y1="268" x2="138" y2="330" stroke="url(#netGrad2)" stroke-width="2.5" />
              <line x1="222" y1="225" x2="125" y2="185" stroke="url(#netGrad1)" stroke-width="3" />

              <!-- Peripheral Knowledge Nodes -->
              <!-- Top: Dense Vector Index -->
              <circle cx="250" cy="80" r="22" fill="#0f172a" stroke="#22d3ee" stroke-width="3" />
              <circle cx="250" cy="80" r="10" fill="#22d3ee" />

              <!-- Top Right: Lexical BM25 -->
              <circle cx="395" cy="175" r="20" fill="#0f172a" stroke="#38bdf8" stroke-width="2.5" />
              <circle cx="395" cy="175" r="8" fill="#38bdf8" />

              <!-- Bottom Right: Knowledge Graph Node -->
              <circle cx="380" cy="340" r="24" fill="#0f172a" stroke="#818cf8" stroke-width="3" />
              <circle cx="380" cy="340" r="11" fill="#818cf8" />

              <!-- Bottom: Entity Anchor -->
              <circle cx="250" cy="420" r="22" fill="#0f172a" stroke="#c084fc" stroke-width="3" />
              <circle cx="250" cy="420" r="10" fill="#c084fc" />

              <!-- Bottom Left: Web Context Chunk -->
              <circle cx="120" cy="340" r="20" fill="#0f172a" stroke="#818cf8" stroke-width="2.5" />
              <circle cx="120" cy="340" r="8" fill="#818cf8" />

              <!-- Top Left: Semantic Embeddings -->
              <circle cx="105" cy="175" r="24" fill="#0f172a" stroke="#22d3ee" stroke-width="3" />
              <circle cx="105" cy="175" r="11" fill="#22d3ee" />

              <!-- Central Neurosymbolic Nexus (Vector Core) -->
              <polygon points="250,205 289,228 289,272 250,295 211,272 211,228" fill="#0f172a" stroke="#38bdf8" stroke-width="3.5" />
              <circle cx="250" cy="250" r="24" fill="url(#netGrad1)" />
              <circle cx="250" cy="250" r="12" fill="#ffffff" />
            </svg>
          )}

          {icon === 'pillars' && (
            <svg class="w-full h-full" viewBox="0 0 500 500" fill="none">
              <defs>
                <linearGradient id="pilGrad1" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#38bdf8" />
                  <stop offset="100%" stop-color="#0284c7" />
                </linearGradient>
                <linearGradient id="pilGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#818cf8" />
                  <stop offset="100%" stop-color="#4f46e5" />
                </linearGradient>
                <linearGradient id="pilGrad3" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#34d399" />
                  <stop offset="100%" stop-color="#059669" />
                </linearGradient>
                <linearGradient id="pedGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#0284c7" />
                  <stop offset="50%" stop-color="#4f46e5" />
                  <stop offset="100%" stop-color="#059669" />
                </linearGradient>
              </defs>

              <!-- Classical Synthesis Pediment (Top Cap) -->
              <polygon points="250,60 70,135 430,135" stroke="url(#pedGrad)" stroke-width="3.5" fill="#0f172a" />
              <circle cx="250" cy="105" r="14" fill="#38bdf8" />
              <line x1="55" y1="145" x2="445" y2="145" stroke="#94a3b8" stroke-width="3.5" stroke-linecap="round" />

              <!-- Pillar 1 (Left): Strukturierte Daten / Schema.org -->
              <rect x="95" y="160" width="70" height="210" rx="8" stroke="url(#pilGrad1)" stroke-width="3" fill="#0f172a" />
              <!-- Fluting / Code brackets icon -->
              <line x1="115" y1="185" x2="115" y2="345" stroke="#38bdf8" stroke-width="2" stroke-dasharray="6 4" opacity="0.7" />
              <line x1="145" y1="185" x2="145" y2="345" stroke="#38bdf8" stroke-width="2" stroke-dasharray="6 4" opacity="0.7" />
              <circle cx="130" cy="265" r="16" fill="#0284c7" fill-opacity="0.3" stroke="#38bdf8" stroke-width="2" />
              <text x="130" y="271" text-anchor="middle" font-family="monospace" font-size="16" font-weight="bold" fill="#38bdf8">&lt;/&gt;</text>

              <!-- Pillar 2 (Center): E-E-A-T Autorität (Taller, dominant monolith) -->
              <rect x="215" y="150" width="70" height="220" rx="8" stroke="url(#pilGrad2)" stroke-width="3.5" fill="#0f172a" />
              <line x1="235" y1="175" x2="235" y2="345" stroke="#818cf8" stroke-width="2.5" opacity="0.8" />
              <line x1="265" y1="175" x2="265" y2="345" stroke="#818cf8" stroke-width="2.5" opacity="0.8" />
              <!-- Authority Shield/Star Icon -->
              <circle cx="250" cy="260" r="18" fill="#4f46e5" fill-opacity="0.4" stroke="#818cf8" stroke-width="2" />
              <polygon points="250,248 254,257 263,258 257,265 259,274 250,269 241,274 243,265 237,258 246,257" fill="#818cf8" />

              <!-- Pillar 3 (Right): Information Gain (Empirische Tiefe) -->
              <rect x="335" y="160" width="70" height="210" rx="8" stroke="url(#pilGrad3)" stroke-width="3" fill="#0f172a" />
              <line x1="355" y1="185" x2="355" y2="345" stroke="#34d399" stroke-width="2" stroke-dasharray="6 4" opacity="0.7" />
              <line x1="385" y1="185" x2="385" y2="345" stroke="#34d399" stroke-width="2" stroke-dasharray="6 4" opacity="0.7" />
              <!-- Delta / Gain Icon -->
              <circle cx="370" cy="265" r="16" fill="#059669" fill-opacity="0.3" stroke="#34d399" stroke-width="2" />
              <text x="370" y="271" text-anchor="middle" font-family="sans-serif" font-size="18" font-weight="bold" fill="#34d399">Δ</text>

              <!-- Stepped Plinth / Enterprise Foundation -->
              <rect x="75" y="380" width="350" height="24" rx="5" stroke="#64748b" stroke-width="2.5" fill="#1e293b" />
              <rect x="50" y="410" width="400" height="28" rx="6" stroke="url(#pedGrad)" stroke-width="3" fill="#0f172a" />
              <line x1="60" y1="424" x2="440" y2="424" stroke="#475569" stroke-width="1.5" stroke-dasharray="6 6" />
            </svg>
          )}

          {icon === 'terminal' && (
            <svg class="w-full h-full" viewBox="0 0 500 500" fill="none">
              <defs>
                <linearGradient id="termGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#22d3ee" />
                  <stop offset="100%" stop-color="#818cf8" />
                </linearGradient>
                <linearGradient id="mcpGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#34d399" />
                  <stop offset="100%" stop-color="#06b6d4" />
                </linearGradient>
              </defs>

              <!-- Terminal Window Frame -->
              <rect x="55" y="80" width="390" height="320" rx="18" stroke="url(#termGrad)" stroke-width="3" fill="#090d16" />
              
              <!-- Window Top Bar -->
              <path d="M 55 98 C 55 88 63 80 73 80 L 427 80 C 437 80 445 88 445 98 L 445 130 L 55 130 Z" fill="#131c2e" />
              <line x1="55" y1="130" x2="445" y2="130" stroke="#334155" stroke-width="2" />
              
              <!-- Window Controls (Red, Yellow, Green) -->
              <circle cx="85" cy="105" r="7" fill="#ef4444" />
              <circle cx="110" cy="105" r="7" fill="#f59e0b" />
              <circle cx="135" cy="105" r="7" fill="#10b981" />
              <text x="250" y="110" text-anchor="middle" font-family="monospace" font-size="13" font-weight="bold" fill="#64748b">agy-labor · mcp-agent</text>

              <!-- Prompt Command Line -->
              <text x="85" y="175" font-family="monospace" font-size="20" font-weight="bold" fill="#38bdf8">&gt; agy verify:quality</text>
              <rect x="330" y="158" width="10" height="20" fill="#38bdf8" opacity="0.8" />

              <!-- Left Side: Agentic Execution Loop -->
              <path d="M 95 230 L 135 260 L 95 290" stroke="#22d3ee" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
              <line x1="150" y1="290" x2="195" y2="290" stroke="#22d3ee" stroke-width="3.5" stroke-linecap="round" />
              <text x="95" y="340" font-family="monospace" font-size="15" fill="#34d399">✓ 0 diffs · 100% test pass</text>
              <text x="95" y="365" font-family="monospace" font-size="14" fill="#94a3b8">CI/CD Gate: APPROVED</text>

              <!-- Right Side: MCP Hub & Satellite Tool Sockets -->
              <circle cx="340" cy="265" r="48" stroke="url(#mcpGrad)" stroke-width="3" stroke-dasharray="6 4" fill="#0f172a" />
              <circle cx="340" cy="265" r="26" fill="url(#mcpGrad)" />
              <text x="340" y="271" text-anchor="middle" font-family="monospace" font-size="14" font-weight="black" fill="#0f172a">MCP</text>

              <!-- Satellites connected to MCP Hub -->
              <circle cx="340" cy="180" r="14" fill="#0f172a" stroke="#38bdf8" stroke-width="2" />
              <line x1="340" y1="217" x2="340" y2="239" stroke="#38bdf8" stroke-width="2.5" />

              <circle cx="415" cy="295" r="14" fill="#0f172a" stroke="#818cf8" stroke-width="2" />
              <line x1="365" y1="280" x2="401" y2="290" stroke="#818cf8" stroke-width="2.5" />

              <circle cx="270" cy="295" r="14" fill="#0f172a" stroke="#34d399" stroke-width="2" />
              <line x1="315" y1="280" x2="284" y2="290" stroke="#34d399" stroke-width="2.5" />

              <!-- Lower CI/CD Orbit -->
              <ellipse cx="250" cy="430" rx="160" ry="24" stroke="#475569" stroke-width="2" stroke-dasharray="6 6" />
              <circle cx="380" cy="425" r="6" fill="#22d3ee" />
              <circle cx="120" cy="425" r="6" fill="#818cf8" />
            </svg>
          )}

          {icon === 'orbit' && (
            <svg class="w-full h-full" viewBox="0 0 500 500" fill="none">
              <defs>
                <linearGradient id="orbGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#38bdf8" />
                  <stop offset="100%" stop-color="#a855f7" />
                </linearGradient>
                <radialGradient id="authorGlow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.4" />
                  <stop offset="100%" stop-color="#0f172a" stop-opacity="0" />
                </radialGradient>
              </defs>

              <!-- Orbital Ellipses (3D Celestial Network) -->
              <ellipse cx="250" cy="250" rx="215" ry="110" stroke="#475569" stroke-width="2" stroke-dasharray="6 6" transform="rotate(-30 250 250)" />
              <ellipse cx="250" cy="250" rx="215" ry="110" stroke="#38bdf8" stroke-width="2" stroke-dasharray="8 4" opacity="0.75" transform="rotate(35 250 250)" />
              <circle cx="250" cy="250" r="190" stroke="#a855f7" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.5" />

              <!-- Author Core Glow -->
              <circle cx="250" cy="250" r="85" fill="url(#authorGlow)" />

              <!-- Radiating Connection Beams -->
              <line x1="210" y1="220" x2="95" y2="155" stroke="url(#orbGrad)" stroke-width="3" />
              <line x1="290" y1="220" x2="405" y2="155" stroke="url(#orbGrad)" stroke-width="3" />
              <line x1="285" y1="285" x2="390" y2="365" stroke="url(#orbGrad)" stroke-width="3" />
              <line x1="215" y1="285" x2="110" y2="365" stroke="url(#orbGrad)" stroke-width="3" />

              <!-- Satellite 1 (Top Left): LinkedIn / Professional Network -->
              <circle cx="95" cy="155" r="28" fill="#0f172a" stroke="#38bdf8" stroke-width="3" />
              <text x="95" y="161" text-anchor="middle" font-family="sans-serif" font-size="16" font-weight="bold" fill="#38bdf8">in</text>

              <!-- Satellite 2 (Top Right): sameAs / Wikidata Authority -->
              <circle cx="405" cy="155" r="28" fill="#0f172a" stroke="#a855f7" stroke-width="3" />
              <text x="405" y="161" text-anchor="middle" font-family="monospace" font-size="14" font-weight="bold" fill="#a855f7">sameAs</text>

              <!-- Satellite 3 (Bottom Right): Corporate Brand Hub -->
              <circle cx="390" cy="365" r="28" fill="#0f172a" stroke="#34d399" stroke-width="3" />
              <text x="390" y="371" text-anchor="middle" font-family="sans-serif" font-size="15" font-weight="bold" fill="#34d399">Corp</text>

              <!-- Satellite 4 (Bottom Left): Scholar / Academic Citations -->
              <circle cx="110" cy="365" r="28" fill="#0f172a" stroke="#fbbf24" stroke-width="3" />
              <text x="110" y="371" text-anchor="middle" font-family="sans-serif" font-size="15" font-weight="bold" fill="#fbbf24">E-E-A-T</text>

              <!-- Central Author Authority Hub (Executive Entity) -->
              <circle cx="250" cy="250" r="54" fill="#0f172a" stroke="url(#orbGrad)" stroke-width="4" />
              <circle cx="250" cy="232" r="18" fill="#38bdf8" />
              <path d="M 226 272 C 226 254 274 254 274 272 Z" fill="#38bdf8" />
              <!-- Verification Checkmark Badge -->
              <circle cx="282" cy="222" r="10" fill="#34d399" />
              <polyline points="278,222 281,225 287,219" stroke="#ffffff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}

          {icon === 'compass' && (
            <svg class="w-full h-full" viewBox="0 0 500 500" fill="none">
              <defs>
                <linearGradient id="compGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#38bdf8" />
                  <stop offset="100%" stop-color="#34d399" />
                </linearGradient>
                <linearGradient id="arrowGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#3b82f6" />
                  <stop offset="50%" stop-color="#06b6d4" />
                  <stop offset="100%" stop-color="#10b981" />
                </linearGradient>
              </defs>

              <!-- Outer Strategic Compass Dial -->
              <circle cx="250" cy="250" r="215" stroke="#334155" stroke-width="2.5" />
              <circle cx="250" cy="250" r="180" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.6" />
              <circle cx="250" cy="250" r="140" stroke="#475569" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.4" />

              <!-- Dial Cardinal Ticks -->
              <line x1="250" y1="35" x2="250" y2="60" stroke="#38bdf8" stroke-width="4" stroke-linecap="round" />
              <line x1="250" y1="440" x2="250" y2="465" stroke="#64748b" stroke-width="3" stroke-linecap="round" />
              <line x1="35" y1="250" x2="60" y2="250" stroke="#64748b" stroke-width="3" stroke-linecap="round" />
              <line x1="440" y1="250" x2="465" y2="250" stroke="#34d399" stroke-width="4" stroke-linecap="round" />

              <text x="250" y="28" text-anchor="middle" font-family="monospace" font-size="16" font-weight="black" fill="#38bdf8">N · ZIEL</text>
              <text x="475" y="255" text-anchor="start" font-family="monospace" font-size="14" font-weight="bold" fill="#34d399">ROI</text>

              <!-- Central Pivot -->
              <circle cx="250" cy="250" r="24" fill="#0f172a" stroke="url(#compGrad)" stroke-width="3" />
              <circle cx="250" cy="250" r="10" fill="#38bdf8" />

              <!-- Dynamic 90-Day Trajectory Arrow (Exponential Curve) -->
              <path d="M 100 390 Q 210 350 270 240 T 400 95" stroke="url(#arrowGrad)" stroke-width="5" stroke-linecap="round" fill="none" />
              <!-- Arrowhead -->
              <polygon points="400,95 365,105 390,130" fill="#10b981" />

              <!-- Milestone Waypoints along Curve -->
              <!-- Day 30 -->
              <circle cx="170" cy="355" r="18" fill="#0f172a" stroke="#38bdf8" stroke-width="3" />
              <circle cx="170" cy="355" r="7" fill="#38bdf8" />
              <text x="170" y="395" text-anchor="middle" font-family="monospace" font-size="13" font-weight="bold" fill="#94a3b8">30 Tage</text>

              <!-- Day 60 -->
              <circle cx="265" cy="250" r="18" fill="#0f172a" stroke="#06b6d4" stroke-width="3" />
              <circle cx="265" cy="250" r="7" fill="#06b6d4" />
              <text x="310" y="275" text-anchor="start" font-family="monospace" font-size="13" font-weight="bold" fill="#94a3b8">60 Tage</text>

              <!-- Day 90 (Goal) -->
              <circle cx="360" cy="140" r="20" fill="#0f172a" stroke="#10b981" stroke-width="3.5" />
              <circle cx="360" cy="140" r="8" fill="#10b981" />
