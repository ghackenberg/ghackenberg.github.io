---
import SlideBase from '../primitives/SlideBase.astro';
import { resolveAccentName, getCycleAccent, type SlideAccent } from '@commons/shared/accent-system';

interface Props {
  title?: string;
  subtitle?: string;
  subtitleCue?: string;
  cue?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  cols?: 2 | 3 | 4;
  accent?: SlideAccent;
  startAccent?: SlideAccent;
  class?: string;
}

const {
  title,
  subtitle,
  subtitleCue,
  cue,
  slideNumber,
  totalSlides,
  cols = 2,
  accent,
  startAccent,
  class: className = ""
} = Astro.props;

const gridCols = {
  2: 'grid-cols-2',
  3: 'grid-cols-3',
  4: 'grid-cols-4'
}[cols];

const activeAccentName = resolveAccentName(startAccent || accent || 'blue');
const insightsAccent = getCycleAccent(activeAccentName, cols);
---

<SlideBase
  title={title}
  subtitle={subtitle}
  subtitleCue={subtitleCue}
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  accent={accent}
  startAccent={startAccent}
  class={className}
>
  {Astro.slots.has('insights') ? (
    <div class="h-full w-full flex flex-col justify-between gap-6 min-h-0">
      <div data-cue={cue} class={`grid ${gridCols} gap-6 items-stretch flex-1 min-h-0`}>
        <slot />
      </div>
      <div
        class="shrink-0 w-full"
        data-accent={insightsAccent.name}
        style={`--card-accent: var(--color-slide-accent-${insightsAccent.name}); --hl-color: var(--color-slide-accent-${insightsAccent.name});`}
      >
        <slot name="insights" />
      </div>
    </div>
  ) : (
    <div data-cue={cue} class={`grid ${gridCols} ${cols === 2 ? 'grid-rows-2' : ''} gap-6 h-full w-full items-stretch min-h-0`}>
      <slot />
    </div>
  )}
</SlideBase>

<style>
  .grid :global(.bento-card-root) {
    padding: 1.5rem !important;
  }
  .grid :global(.bento-card-root h3) {
    font-size: calc(1.85rem * var(--content-scale, 1)) !important;
    margin-top: 0.35rem !important;
  }
  .grid :global(.bento-card-root p) {
    font-size: calc(1.4rem * var(--content-scale, 1)) !important;
    line-height: 1.45 !important;
  }
</style>
