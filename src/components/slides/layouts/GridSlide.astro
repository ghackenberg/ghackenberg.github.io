---
import SlideBase from '../primitives/SlideBase.astro';

interface Props {
  title?: string;
  subtitle?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  cols?: 2 | 3 | 4;
  class?: string;
}

const {
  title,
  subtitle,
  slideNumber,
  totalSlides,
  cols = 2,
  class: className = ""
} = Astro.props;

const gridCols = {
  2: 'grid-cols-2',
  3: 'grid-cols-3',
  4: 'grid-cols-4'
}[cols];
---

<SlideBase
  title={title}
  subtitle={subtitle}
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  class={className}
>
  <div class={`grid ${gridCols} ${cols === 2 ? 'grid-rows-2' : ''} gap-6 h-full w-full items-stretch min-h-0`}>
    <slot />
  </div>
</SlideBase>

<style>
  .grid :global(.bento-card-root) {
    padding: 1.5rem !important;
  }
  .grid :global(.bento-card-root h3) {
    font-size: calc(1.85rem * var(--content-scale, 1)) !important;
    margin-top: 0.35rem !important;
  }
  .grid :global(.bento-card-root p) {
    font-size: calc(1.4rem * var(--content-scale, 1)) !important;
    line-height: 1.45 !important;
  }
</style>
