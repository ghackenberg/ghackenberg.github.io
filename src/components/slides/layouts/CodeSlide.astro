---
import SlideBase from '../primitives/SlideBase.astro';

interface Props {
  title?: string;
  subtitle?: string;
  subtitleCue?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  class?: string;
}

const {
  title,
  subtitle,
  subtitleCue,
  slideNumber,
  totalSlides,
  class: className = ""
} = Astro.props;
---

<SlideBase
  title={title}
  subtitle={subtitle}
  subtitleCue={subtitleCue}
  slideNumber={slideNumber}
  totalSlides={totalSlides}
  class={className}
>
  <div class="grid grid-cols-12 gap-8 h-full w-full items-stretch min-h-0">
    <!-- Code Editor / Snippet Slot -->
    <div class="col-span-7 h-full flex flex-col justify-stretch items-stretch min-h-0">
      <slot name="code" />
    </div>

    <!-- Explanation / Key Highlights Slot -->
    <div class="col-span-5 h-full flex flex-col justify-stretch items-stretch min-h-0">
      <slot name="explanation" />
    </div>
  </div>
</SlideBase>
