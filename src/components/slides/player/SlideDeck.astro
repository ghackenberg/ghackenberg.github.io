  /* ==========================================================================
     Presentation Animation Architecture (Pure CSS Synchronized to Speech Cues)
     ========================================================================== */

  /* 1. Containers, Cards, and Graphical Nodes (Boxes) */
  .reveal .slides [data-cue]:not(mark):not(.highlight-marker):not(.slide-subtitle),
  .reveal .slides .cue-target:not(mark):not(.highlight-marker):not(.slide-subtitle) {
    transition: opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.4s ease;
    will-change: opacity, transform;
  }

  /* Pre-cue pending state: hidden until spoken (Fade-In Pre-state) */
  .reveal .slides [data-cue]:not(mark):not(.highlight-marker):not(.slide-subtitle):not(.is-active),
  .reveal .slides .cue-target:not(mark):not(.highlight-marker):not(.slide-subtitle):not(.is-active) {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
    pointer-events: none;
  }

  /* Active cue state: fully visible & in position (Fade-In Result) */
  .reveal .slides [data-cue]:not(mark):not(.highlight-marker):not(.slide-subtitle).is-active,
  .reveal .slides .cue-target:not(mark):not(.highlight-marker):not(.slide-subtitle).is-active {
    opacity: 1 !important;
    transform: translateY(0) scale(1) !important;
    pointer-events: auto !important;
  }

  /* Dimmed cue state: earlier points step down for spotlight focus */
  .reveal .slides [data-cue]:not(mark):not(.highlight-marker):not(.slide-subtitle).is-dimmed,
  .reveal .slides .cue-target:not(mark):not(.highlight-marker):not(.slide-subtitle).is-dimmed {
    opacity: 0.32 !important;
    transform: scale(0.985) !important;
    filter: saturate(0.85);
  }

  /* Exited cue state: explicit fade-out only if element explicitly specifies data-exit="hide" */
  .reveal .slides [data-cue][data-exit="hide"]:not(.slide-subtitle).is-exited,
  .reveal .slides .cue-target[data-exit="hide"]:not(.slide-subtitle).is-exited {
    opacity: 0 !important;
    transform: translateY(-16px) scale(0.97) !important;
    pointer-events: none !important;
  }

  /* 1b. Title Slide Sequential Reveal Items (Collapsible Grid) */
  .reveal .slides .title-reveal-item {
    transition: grid-template-rows 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.65s cubic-bezier(0.16, 1, 0.3, 1) !important;
    will-change: grid-template-rows, opacity, transform;
