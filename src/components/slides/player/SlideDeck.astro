  }

  /* Pre-cue pending state: hidden until spoken (Fade-In Pre-state) */
  .reveal .slides [data-cue]:not(mark):not(.highlight-marker):not(.is-active),
  .reveal .slides .cue-target:not(mark):not(.highlight-marker):not(.is-active) {
