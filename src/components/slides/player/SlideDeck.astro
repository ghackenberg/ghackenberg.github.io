---
import 'reveal.js/reveal.css';
import type { SlideCueMap } from './AudioSyncController';

interface SlideMeta {
  id: string;
  title: string;
  audioUrl?: string;
  cues?: SlideCueMap;
  notes?: string;
}

interface Props {
  presentationId?: string;
  talkId?: string;
  slides: SlideMeta[];
  class?: string;
  pdfUrl?: string;
  pdfDarkUrl?: string;
  pdfLightUrl?: string;
}

const { presentationId, talkId, slides, class: className = "", pdfUrl, pdfDarkUrl, pdfLightUrl } = Astro.props;
const currentDeckId = presentationId || talkId || "presentation";
---

<div class={`slide-deck-wrapper relative w-full lg:aspect-[16/9.6] lg:max-h-[88vh] bg-slate-950 light:bg-slate-100 border border-slate-800 light:border-slate-300 rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl flex flex-col ${className}`}>
  <!-- Slide Stage Viewport with Drawer / Sidebar Layer -->
  <div class="relative flex-1 w-full min-h-0 flex overflow-hidden">
    <!-- Slide List Backdrop (Mobile only: dims & blurs slide stage) -->
    <div
      id="slide-list-backdrop"
      class="lg:hidden absolute inset-0 bg-slate-950/60 light:bg-slate-900/30 backdrop-blur-xs z-30 opacity-0 pointer-events-none transition-opacity duration-300 cursor-pointer"
      title="Close"
    ></div>

    <!-- Slide List Sidebar (Side-by-side on desktop lg+, overlay drawer on mobile <lg) -->
    <aside
      id="slide-list-drawer"
      class="drawer-closed bg-slate-900/95 light:bg-white/95 lg:bg-slate-900 lg:light:bg-slate-50 border-r border-slate-800 light:border-slate-200 z-40 flex flex-col shadow-2xl lg:shadow-none select-none shrink-0"
      aria-label="Slide overview"
      aria-hidden="true"
    >
      <div class="w-72 sm:w-80 max-w-[85vw] h-full flex flex-col">
        <!-- Drawer Header -->
        <div class="p-4 border-b border-slate-800 light:border-slate-200 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <h2 class="font-bold text-xs uppercase tracking-wider text-slate-200 light:text-slate-800">Slide Overview</h2>
            <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-slate-800 light:bg-slate-100 text-slate-400 light:text-slate-500 font-bold ml-1">
              {slides.length}
            </span>
          </div>
          <button
            id="btn-close-drawer"
            class="w-8 h-8 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-400 hover:text-slate-200 light:text-slate-500 light:hover:text-slate-800 flex items-center justify-center transition-colors cursor-pointer"
            title="Close (ESC)"
            aria-label="Close slide overview"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Slide Items List (Scrollable) -->
        <div class="flex-1 overflow-y-auto p-3 space-y-1.5 custom-scrollbar min-h-0" id="slide-list-items">
          {slides.map((slide, idx) => (
            <button
              type="button"
              data-slide-index={idx}
              data-active={idx === 0 ? "true" : undefined}
              title={slide.title || `Slide ${idx + 1}`}
              class={`slide-list-item w-full text-left p-3 rounded-xl flex items-center gap-3 transition-all duration-200 cursor-pointer border min-w-0 ${
                idx === 0
                  ? 'bg-blue-600/15 border-blue-500/40 text-blue-400 light:bg-blue-50 light:border-blue-300 light:text-blue-700 font-semibold'
                  : 'bg-transparent border-transparent hover:bg-slate-800/60 light:hover:bg-slate-100 text-slate-300 light:text-slate-700'
              }`}
            >
              <span class={`font-mono text-xs px-2 py-0.5 rounded-md font-bold shrink-0 ${
                idx === 0
                  ? 'bg-blue-500/20 text-blue-300 light:bg-blue-200 light:text-blue-800'
                  : 'bg-slate-800 light:bg-slate-200/80 text-slate-400 light:text-slate-600'
              }`}>
                {String(idx + 1).padStart(2, '0')}
              </span>
              <span class="text-xs sm:text-sm truncate min-w-0 flex-1 leading-snug" title={slide.title || `Slide ${idx + 1}`}>
                {slide.title || `Slide ${idx + 1}`}
              </span>
            </button>
          ))}
        </div>
      </div>
    </aside>

    <!-- Slide Canvas Viewport (Crisp, unblurred, auto-scaling) -->
    <div class="relative flex-1 w-full min-w-0 overflow-hidden bg-slate-950 light:bg-slate-100 flex items-center justify-center aspect-video lg:aspect-auto">
      <!-- Loading Indicator / Shield (Active until Reveal & AutoFit finish) -->
      <div 
        id="deck-loader" 
        class="absolute inset-0 z-30 flex flex-col items-center justify-center bg-slate-950 light:bg-slate-50 transition-opacity duration-300 pointer-events-none select-none"
      >
        <div class="flex flex-col items-center gap-4">
          <div class="relative flex items-center justify-center">
            <div class="w-12 h-12 rounded-2xl border border-blue-500/30 bg-blue-500/10 flex items-center justify-center shadow-lg shadow-blue-500/20">
              <span class="text-base font-black tracking-tight text-blue-400 font-sans">GH</span>
            </div>
            <!-- Concentric circular orbit spinner (symmetrical, non-wobbling) -->
            <div class="absolute -inset-2 rounded-full border-2 border-blue-500/20 border-t-blue-500 animate-spin"></div>
          </div>
          <span class="text-xs font-mono font-medium text-slate-400 light:text-slate-500 tracking-wider uppercase">Loading presentation...</span>
        </div>
      </div>

      <!-- Reveal.js Container -->
      <div class="reveal w-full h-full relative opacity-0 transition-opacity duration-300" id="reveal-root">
        <div class="slides w-full h-full">
          <slot />
        </div>
      </div>
    </div>
  </div>

  <!-- Audio & Slide Navigation Control Bar -->
  <div class="slide-controls-bar z-20 bg-slate-900/95 light:bg-white/95 backdrop-blur-md border-t border-slate-800 light:border-slate-200 px-3 sm:px-4 md:px-6 py-2.5 sm:py-3 md:py-3.5 flex flex-wrap lg:flex-nowrap items-center justify-between gap-y-2.5 gap-x-2 sm:gap-x-3 lg:gap-6 text-slate-300 light:text-slate-700 select-none">

    <!-- Timeline & Progress Scrubbing: Full-width on mobile & tablet (order-1), centered flex-1 on desktop (lg:order-2) -->
    <div class="w-full order-1 lg:order-2 lg:flex-1 lg:max-w-xl flex items-center gap-2 sm:gap-3">
      <span id="time-current" class="text-xs font-mono text-slate-400 light:text-slate-500 w-9 sm:w-10 text-right shrink-0 select-none">0:00</span>
      <div class="flex-1 relative py-2.5 cursor-pointer group" id="progress-container">
        <!-- Background Track -->
        <div class="h-1.5 sm:h-2 bg-slate-800 light:bg-slate-200 rounded-full overflow-hidden relative">
          <div id="progress-bar" class="h-full bg-blue-500 rounded-full w-0 transition-all duration-100"></div>
        </div>
        <!-- Cue Markers Container -->
        <div id="cue-markers-container" class="absolute inset-x-0 top-0 bottom-0 pointer-events-none flex items-center"></div>
      </div>
      <span id="time-total" class="text-xs font-mono text-slate-400 light:text-slate-500 w-9 sm:w-10 shrink-0 select-none">0:00</span>
    </div>

    <!-- Left: Play/Pause & Slide/Cue Navigation (order-2 on mobile/tablet, lg:order-1 on desktop) -->
    <div class="order-2 lg:order-1 flex items-center gap-1 sm:gap-1.5 md:gap-2 shrink-0">
      <!-- Vorherige Folie -->
      <button
        id="btn-prev"
        class="w-8 h-8 sm:w-9 sm:h-9 md:w-10 md:h-10 rounded-xl bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-200 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Previous slide (←)"
        aria-label="Previous slide"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-4.5 md:h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M18 19L11 12l7-7M6 5v14" />
        </svg>
      </button>

      <!-- Vorherige Sprungmarke / Cue (Intra-Slide) -->
      <button
        id="btn-prev-cue"
        class="w-8 h-8 sm:w-9 sm:h-9 md:w-10 md:h-10 rounded-xl bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-200 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Previous cue (↑ / Shift+←)"
        aria-label="Previous cue"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-4.5 md:h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Play / Pause -->
      <button
        id="btn-play-pause"
        class="h-8 sm:h-9 md:h-10 px-3 sm:px-4 md:px-5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold flex items-center gap-1.5 sm:gap-2 transition-all shadow-md cursor-pointer text-xs sm:text-sm"
        title="Play audio presentation (Space)"
        aria-label="Play or pause audio presentation"
      >
        <svg id="icon-play" class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-4.5 md:h-4.5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <svg id="icon-pause" class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-4.5 md:h-4.5 hidden shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
        </svg>
        <span id="label-play-pause" class="hidden sm:inline">Listen to presentation</span>
      </button>

      <!-- Nächste Sprungmarke / Cue (Intra-Slide) -->
      <button
        id="btn-next-cue"
        class="w-8 h-8 sm:w-9 sm:h-9 md:w-10 md:h-10 rounded-xl bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-200 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Next cue (↓ / Shift+→)"
        aria-label="Next cue"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-4.5 md:h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Nächste Folie -->
      <button
        id="btn-next"
        class="w-8 h-8 sm:w-9 sm:h-9 md:w-10 md:h-10 rounded-xl bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-200 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Next slide (→)"
        aria-label="Next slide"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-4.5 md:h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 5l7 7-7 7M18 5v14" />
        </svg>
      </button>
    </div>

    <!-- Right: Tools, Speed, Overview, Fullscreen, Counter (order-3 on both) -->
    <div class="order-3 flex items-center gap-1.5 sm:gap-2 md:gap-3 shrink-0">
      <!-- Speed Toggle -->
      <button
        id="btn-speed"
        class="px-2 sm:px-2.5 md:px-3 h-8 sm:h-9 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-300 light:text-slate-700 border border-transparent light:border-slate-300 text-[11px] sm:text-xs font-mono font-bold transition-colors cursor-pointer"
        title="Playback speed"
        aria-label="Change playback speed"
      >
        1.0x
      </button>

      <!-- Slide List Drawer Toggle (ESC) -->
      <button
        id="btn-overview"
        class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-300 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Slide overview (ESC)"
        aria-label="Toggle slide overview"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Fullscreen (F) -->
      <button
        id="btn-fullscreen"
        class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-300 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Fullscreen (F)"
        aria-label="Toggle fullscreen"
      >
        <svg id="icon-fullscreen-enter" class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5h-4m4 0v-4m0 4l-5-5" />
        </svg>
        <svg id="icon-fullscreen-exit" class="w-3.5 h-3.5 sm:w-4 sm:h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v6H3m0 0l5-5M15 3v6h6m0 0l-5-5M9 21v-6H3m0 0l5 5M15 21v-6h6m0 0l-5 5" />
        </svg>
      </button>

      <!-- Download PDF Handout with Theme Matching & Selector -->
      {(pdfDarkUrl || pdfLightUrl || pdfUrl) && (
        <div class="relative flex items-center" id="pdf-download-container">
          <a
            id="btn-download-pdf"
            href={pdfDarkUrl || pdfUrl}
            data-pdf-dark={pdfDarkUrl || pdfUrl}
            data-pdf-light={pdfLightUrl}
            data-deck-id={currentDeckId}
            download={`Presentation_${currentDeckId}.pdf`}
            class={`h-8 sm:h-9 bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-300 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer ${
              pdfLightUrl && (pdfDarkUrl || pdfUrl) ? 'w-7 sm:w-8 rounded-l-lg' : 'w-8 h-8 sm:w-9 sm:h-9 rounded-lg'
            }`}
            title="Download PDF handout"
            aria-label="Download PDF handout"
          >
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </a>

          {pdfLightUrl && (pdfDarkUrl || pdfUrl) && (
            <>
              <button
                id="btn-toggle-pdf-menu"
                type="button"
                class="w-4 h-8 sm:h-9 rounded-r-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-400 light:text-slate-500 border-l border-slate-700/60 light:border-slate-200 flex items-center justify-center transition-colors cursor-pointer"
                title="Select PDF format (Light / Dark)"
                aria-label="Select PDF format"
              >
                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <div 
                id="pdf-download-menu" 
                class="hidden absolute bottom-full mb-2 right-0 w-60 p-2 bg-slate-900/95 light:bg-white/95 backdrop-blur-md border border-slate-700 light:border-slate-200 rounded-xl shadow-2xl z-50 flex flex-col gap-1 text-xs"
              >
                <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 light:text-slate-500 border-b border-slate-800 light:border-slate-100 mb-1">
                  PDF Handout Format
                </div>
                <a
                  id="menu-item-pdf-dark"
                  href={pdfDarkUrl || pdfUrl}
                  download={`Presentation_${currentDeckId}_Dark.pdf`}
                  class="flex items-center justify-between px-2.5 py-2 rounded-lg hover:bg-slate-800 light:hover:bg-slate-100 text-slate-200 light:text-slate-800 transition-colors cursor-pointer"
                >
                  <div class="flex items-center gap-2">
                    <span>🌙</span>
                    <span class="font-medium">Dark Mode</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400">Original</span>
                </a>
                <a
                  id="menu-item-pdf-light"
                  href={pdfLightUrl}
                  download={`Presentation_${currentDeckId}_Light.pdf`}
                  class="flex items-center justify-between px-2.5 py-2 rounded-lg hover:bg-slate-800 light:hover:bg-slate-100 text-slate-200 light:text-slate-800 transition-colors cursor-pointer"
                >
                  <div class="flex items-center gap-2">
                    <span>☀️</span>
                    <span class="font-medium">Light Mode</span>
                  </div>
                  <span class="text-[10px] font-mono text-slate-400">Print</span>
                </a>
              </div>
            </>
          )}
        </div>
      )}

      <!-- Slide Counter -->
      <div class="px-2 sm:px-2.5 md:px-3 h-8 sm:h-9 rounded-lg bg-slate-800/60 light:bg-slate-100 border border-slate-700/50 light:border-slate-300 flex items-center text-[11px] sm:text-xs font-mono text-slate-400 light:text-slate-600 font-bold shrink-0 select-none">
        <span id="slide-index-label">1</span>
        <span class="mx-0.5 sm:mx-1">/</span>
        <span>{slides.length}</span>
      </div>
    </div>
  </div>
</div>

<!-- Slides Metadata Carrier -->
<script id="slides-meta" is:inline type="application/json" set:html={JSON.stringify(slides)}></script>

<script>
  import Reveal, { type RevealApi } from 'reveal.js';
  import { AudioSyncController, type SlideData, type CueItem } from './AudioSyncController';
  import { AutoFitController } from './AutoFitController';

  declare global {
    interface Window {
      __revealDeck?: RevealApi;
    }
  }

  // Read metadata
  const metaEl = document.getElementById('slides-meta');
  const slidesData: SlideData[] = metaEl ? JSON.parse(metaEl.textContent || '[]') : [];

  // Initialize Reveal.js
  const deck = new Reveal(document.getElementById('reveal-root') as HTMLElement, {
    width: 1920,
    height: 1080,
    margin: 0.02,
    minScale: 0.2,
    maxScale: 2.0,
    controls: false,
    progress: false,
    hash: false,
    history: false,
    keyboard: true,
    overview: false,
    center: true,
    transition: 'fade',
    transitionSpeed: 'fast',
    embedded: true,
    mouseWheel: false,
    touch: true
  });


  deck.initialize().then(() => {
    const revealRoot = document.getElementById('reveal-root');
    const deckLoader = document.getElementById('deck-loader');

    // AutoFit Controller
    const autoFit = new AutoFitController();
    autoFit.fitAll(revealRoot);

    // UI Elements
    const btnPlayPause = document.getElementById('btn-play-pause');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');
    const labelPlayPause = document.getElementById('label-play-pause');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const btnPrevCue = document.getElementById('btn-prev-cue');
    const btnNextCue = document.getElementById('btn-next-cue');
    const btnSpeed = document.getElementById('btn-speed');
    const btnOverview = document.getElementById('btn-overview');
    const btnFullscreen = document.getElementById('btn-fullscreen');
    const progressBar = document.getElementById('progress-bar');
    const progressContainer = document.getElementById('progress-container');
    const cueMarkersContainer = document.getElementById('cue-markers-container');
    const timeCurrent = document.getElementById('time-current');
    const timeTotal = document.getElementById('time-total');
    const slideIndexLabel = document.getElementById('slide-index-label');

    // Drawer Elements
    const slideListDrawer = document.getElementById('slide-list-drawer');
    const slideListBackdrop = document.getElementById('slide-list-backdrop');
    const slideListContainer = document.getElementById('slide-list-items');
    const btnCloseDrawer = document.getElementById('btn-close-drawer');
    const slideListItems = document.querySelectorAll<HTMLButtonElement>('.slide-list-item');

    let isDrawerOpen = false;

    const scrollActiveSlideIntoView = (activeItem: HTMLElement | null, smooth = true) => {
      const listEl = slideListContainer || document.getElementById('slide-list-items');
      if (!listEl || !activeItem) return;
      const listRect = listEl.getBoundingClientRect();
      const itemRect = activeItem.getBoundingClientRect();

      if (listRect.height === 0 || itemRect.height === 0) return;

      const isAbove = itemRect.top < listRect.top + 8;
      const isBelow = itemRect.bottom > listRect.bottom - 8;

      if (isAbove) {
        const delta = itemRect.top - (listRect.top + 8);
        listEl.scrollTo({
          top: Math.max(0, listEl.scrollTop + delta),
          behavior: smooth ? 'smooth' : 'auto',
        });
      } else if (isBelow) {
        const delta = itemRect.bottom - (listRect.bottom - 8);
        listEl.scrollTo({
          top: listEl.scrollTop + delta,
          behavior: smooth ? 'smooth' : 'auto',
        });
      }
    };

    const openDrawer = (shouldScroll = true) => {
      if (!slideListDrawer) return;
      isDrawerOpen = true;
      slideListDrawer.classList.remove('drawer-closed');
      slideListDrawer.classList.add('drawer-open');
      slideListDrawer.setAttribute('aria-hidden', 'false');

      if (slideListBackdrop && window.innerWidth < 1024) {
        slideListBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        slideListBackdrop.classList.add('opacity-100', 'pointer-events-auto');
      }

      btnOverview?.classList.add('bg-blue-600', 'text-white');
      btnOverview?.classList.remove('bg-slate-800', 'light:bg-slate-100', 'text-slate-300', 'light:text-slate-700');

      if (shouldScroll) {
        const activeItem = document.querySelector<HTMLElement>('.slide-list-item[data-active="true"]');
        if (activeItem) {
          scrollActiveSlideIntoView(activeItem, false);
          // Wait for drawer width/transform transition (300ms) to ensure exact positioning
          setTimeout(() => {
            if (isDrawerOpen) {
              scrollActiveSlideIntoView(activeItem, true);
            }
          }, 320);
        }
      }
    };

    const closeDrawer = () => {
      if (!slideListDrawer) return;
      isDrawerOpen = false;
      slideListDrawer.classList.remove('drawer-open');
      slideListDrawer.classList.add('drawer-closed');
      slideListDrawer.setAttribute('aria-hidden', 'true');

      if (slideListBackdrop) {
        slideListBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
        slideListBackdrop.classList.add('opacity-0', 'pointer-events-none');
      }

      btnOverview?.classList.remove('bg-blue-600', 'text-white');
      btnOverview?.classList.add('bg-slate-800', 'light:bg-slate-100', 'text-slate-300', 'light:text-slate-700');
    };

    const toggleDrawer = () => {
      if (isDrawerOpen) {
        closeDrawer();
      } else {
        openDrawer(true);
      }
    };

    const updateActiveSlideInList = (currentIndex: number) => {
      let activeItemEl: HTMLElement | null = null;
      slideListItems.forEach((item, idx) => {
        const numBadge = item.querySelector('span:first-child');
        if (idx === currentIndex) {
          item.setAttribute('data-active', 'true');
          item.className = 'slide-list-item w-full text-left p-3 rounded-xl flex items-center gap-3 transition-all duration-200 cursor-pointer border min-w-0 bg-blue-600/15 border-blue-500/40 text-blue-400 light:bg-blue-50 light:border-blue-300 light:text-blue-700 font-semibold';
          if (numBadge) {
            numBadge.className = 'font-mono text-xs px-2 py-0.5 rounded-md bg-blue-500/20 text-blue-300 light:bg-blue-200 light:text-blue-800 font-bold shrink-0';
          }
          activeItemEl = item;
        } else {
          item.removeAttribute('data-active');
          item.className = 'slide-list-item w-full text-left p-3 rounded-xl flex items-center gap-3 transition-all duration-200 cursor-pointer border min-w-0 bg-transparent border-transparent hover:bg-slate-800/60 light:hover:bg-slate-100 text-slate-300 light:text-slate-700';
          if (numBadge) {
            numBadge.className = 'font-mono text-xs px-2 py-0.5 rounded-md bg-slate-800 light:bg-slate-200/80 text-slate-400 light:text-slate-600 font-bold shrink-0';
          }
        }
      });

      if (isDrawerOpen && activeItemEl) {
        scrollActiveSlideIntoView(activeItemEl, true);
      }
    };

    // Format MM:SS with strict finite validation
    const formatTime = (seconds: number) => {
      if (typeof seconds !== 'number' || !Number.isFinite(seconds) || isNaN(seconds) || seconds < 0) {
        return '0:00';
      }
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    };

    const renderCueMarkers = (cues: CueItem[], totalSec: number) => {
      if (!cueMarkersContainer) return;
      cueMarkersContainer.innerHTML = '';

      if (!cues || cues.length === 0 || !totalSec || totalSec <= 0) return;

      cues.forEach((cue) => {
        const pct = Math.max(0, Math.min(100, (cue.start / totalSec) * 100));
        const marker = document.createElement('button');
        marker.type = 'button';
        marker.className = 'cue-timeline-marker absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-2 h-3.5 sm:w-2.5 sm:h-4 rounded-full bg-slate-400 light:bg-slate-500 border border-slate-900 light:border-white transition-all duration-150 pointer-events-auto hover:scale-135 hover:bg-cyan-400 light:hover:bg-cyan-500 cursor-pointer z-10 shadow-sm';
        marker.style.left = `${pct}%`;
        marker.setAttribute('data-cue-id', cue.cueId);
        marker.setAttribute('data-cue-start', String(cue.start));
        marker.title = `${formatTime(cue.start)} · ${cue.cueId}`;
        marker.setAttribute('aria-label', `Springe zu ${cue.cueId} (${formatTime(cue.start)})`);

        marker.addEventListener('click', (e) => {
          e.stopPropagation();
          audioSync.seek(cue.start);
        });

        cueMarkersContainer.appendChild(marker);
      });
    };

    const updateCueMarkersState = (currentSec: number) => {
      if (!cueMarkersContainer) return;
      const markers = cueMarkersContainer.querySelectorAll<HTMLButtonElement>('.cue-timeline-marker');
      markers.forEach((m) => {
        const start = parseFloat(m.getAttribute('data-cue-start') || '0');
        if (currentSec >= start) {
          m.classList.add('bg-blue-400', 'light:bg-blue-600', 'ring-2', 'ring-blue-400/50');
          m.classList.remove('bg-slate-400', 'light:bg-slate-500');
        } else {
          m.classList.remove('bg-blue-400', 'light:bg-blue-600', 'ring-2', 'ring-blue-400/50');
          m.classList.add('bg-slate-400', 'light:bg-slate-500');
        }
      });
    };

    // Instantiate Audio Controller
    const audioSync = new AudioSyncController(slidesData, {
      onSlideChange: (index) => {
        if (deck.getIndices().h !== index) {
          deck.slide(index);
        }
        if (slideIndexLabel) slideIndexLabel.textContent = String(index + 1);
        updateActiveSlideInList(index);
        if (progressBar) progressBar.style.width = '0%';
        if (timeCurrent) timeCurrent.textContent = '0:00';
        if (timeTotal) timeTotal.textContent = '0:00';
        renderCueMarkers([], 0);
      },
      onProgress: (current, total) => {
        if (timeCurrent) timeCurrent.textContent = formatTime(current);
        if (timeTotal && Number.isFinite(total) && total > 0) {
          timeTotal.textContent = formatTime(total);
        }
        if (progressBar && Number.isFinite(total) && total > 0) {
          const pct = Math.min(100, Math.max(0, (current / total) * 100));
          progressBar.style.width = `${pct}%`;
        }
        updateCueMarkersState(current);
      },
      onCuesLoaded: (cues, totalSec) => {
        renderCueMarkers(cues, totalSec);
      },
      onPlayStateChange: (isPlaying) => {
        if (iconPlay && iconPause) {
          if (isPlaying) {
            iconPlay.classList.add('hidden');
            iconPause.classList.remove('hidden');
            if (labelPlayPause) labelPlayPause.textContent = 'Pause';
            btnPlayPause?.setAttribute('title', 'Pause audio (Space)');
            btnPlayPause?.setAttribute('aria-label', 'Pause audio presentation');
          } else {
            iconPlay.classList.remove('hidden');
            iconPause.classList.add('hidden');
            if (labelPlayPause) labelPlayPause.textContent = 'Listen to presentation';
            btnPlayPause?.setAttribute('title', 'Play audio presentation (Space)');
            btnPlayPause?.setAttribute('aria-label', 'Play audio presentation');
          }
        }
      }
    });

    // Reveal Slide Changed Event
    deck.on('slidechanged', () => {
      const idx = deck.getIndices().h;
      if (slideIndexLabel) slideIndexLabel.textContent = String(idx + 1);
      updateActiveSlideInList(idx);
      if (audioSync.getCurrentSlideIndex() !== idx) {
        const isPlaying = audioSync.getIsPlaying();
        audioSync.setSlideIndex(idx, {
          shouldPlay: isPlaying,
          entryMode: isPlaying ? 'start' : 'full'
        });
      } else {
        audioSync.updateSlideIntroState();
      }
      const currentSlide = document.querySelectorAll<HTMLElement>('.reveal .slides > section')[idx];
      autoFit.fitSlide(currentSlide);
    });

    // Button Listeners
    btnPlayPause?.addEventListener('click', () => audioSync.togglePlay());
    btnPrev?.addEventListener('click', () => deck.prev());
    btnNext?.addEventListener('click', () => deck.next());
    btnPrevCue?.addEventListener('click', () => audioSync.prevCue());
    btnNextCue?.addEventListener('click', () => audioSync.nextCue());

    // Slide List Item Navigation Click Listeners
    slideListItems.forEach((item) => {
      item.addEventListener('click', () => {
        const slideIdxStr = item.getAttribute('data-slide-index');
        if (slideIdxStr !== null) {
          const targetIdx = parseInt(slideIdxStr, 10);
          deck.slide(targetIdx);
          // Only auto-close on mobile (< 1024px) where drawer overlays the slide
          if (window.innerWidth < 1024) {
            closeDrawer();
          }
        }
      });
    });

    btnOverview?.addEventListener('click', () => toggleDrawer());
    btnCloseDrawer?.addEventListener('click', () => closeDrawer());
    slideListBackdrop?.addEventListener('click', () => closeDrawer());

    // Listen for external jump-to-slide events (e.g. from the Transcript Timeline Feed)
    window.addEventListener('deck:jump-to-slide', ((e: CustomEvent<{ index: number; autoPlay?: boolean }>) => {
      const targetIdx = e.detail?.index;
      if (typeof targetIdx === 'number' && targetIdx >= 0) {
        deck.slide(targetIdx);
        if (e.detail?.autoPlay && !audioSync.getIsPlaying()) {
          audioSync.play();
        }
      }
    }) as EventListener);
    window.__revealDeck = deck;

    // Initial drawer state: open on desktop (side-by-side), closed on mobile
    if (window.innerWidth >= 1024) {
      openDrawer(false);
    } else {
      closeDrawer();
    }

    // Auto-adapt Reveal scale whenever slide canvas viewport resizes
    if (revealRoot && typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(() => {
        deck.layout();
        const idx = deck.getIndices().h;
        const currentSlide = document.querySelectorAll<HTMLElement>('.reveal .slides > section')[idx];
        autoFit.fitSlide(currentSlide);
      });
      ro.observe(revealRoot);
    }

    // Responsive breakpoint listener for mobile <-> desktop transitions
    let prevIsDesktop = window.innerWidth >= 1024;
    window.addEventListener('resize', () => {
      const isDesktop = window.innerWidth >= 1024;
      if (isDesktop !== prevIsDesktop) {
        prevIsDesktop = isDesktop;
        if (isDesktop && !isDrawerOpen) {
          openDrawer(false);
        } else if (!isDesktop && isDrawerOpen) {
          closeDrawer();
        }
      }
    });

    // Speed Cycle: 1.0x -> 1.25x -> 1.5x -> 1.0x
    const rates = [1.0, 1.25, 1.5];
    let rateIdx = 0;
    btnSpeed?.addEventListener('click', () => {
      rateIdx = (rateIdx + 1) % rates.length;
      const r = rates[rateIdx];
      audioSync.setRate(r);
      if (btnSpeed) btnSpeed.textContent = `${r.toFixed(2)}x`;
    });

    const updateFullscreenIcons = () => {
      const isFs = Boolean(document.fullscreenElement);
      const iconEnter = document.getElementById('icon-fullscreen-enter');
      const iconExit = document.getElementById('icon-fullscreen-exit');
      if (iconEnter && iconExit) {
        if (isFs) {
          iconEnter.classList.add('hidden');
          iconExit.classList.remove('hidden');
        } else {
          iconEnter.classList.remove('hidden');
          iconExit.classList.add('hidden');
        }
      }
      setTimeout(() => deck.layout(), 60);
    };

    btnFullscreen?.addEventListener('click', () => {
      const wrapper = document.querySelector('.slide-deck-wrapper');
      if (!document.fullscreenElement && wrapper) {
        wrapper.requestFullscreen().catch(() => {});
      } else if (document.exitFullscreen) {
        document.exitFullscreen();
      }
    });

    document.addEventListener('fullscreenchange', updateFullscreenIcons);
    document.addEventListener('webkitfullscreenchange', updateFullscreenIcons);

    // Progress Bar Scrubbing (Click + Touch)
    const handleScrub = (clientX: number) => {
      if (!progressContainer) return;
      const rect = progressContainer.getBoundingClientRect();
      const clickX = clientX - rect.left;
      const pct = Math.max(0, Math.min(1, clickX / rect.width));
      const parts = (timeTotal?.textContent || '0:00').split(':');
      const min = parseFloat(parts[0]) || 0;
      const sec = parseFloat(parts[1]) || 0;
      const totalSec = min * 60 + sec;
      if (Number.isFinite(totalSec) && totalSec > 0) {
        audioSync.seek(pct * totalSec);
      }
    };

    progressContainer?.addEventListener('click', (e) => {
      handleScrub(e.clientX);
    });

    let isScrubbing = false;
    progressContainer?.addEventListener('touchstart', (e) => {
      isScrubbing = true;
      if (e.touches[0]) handleScrub(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (!isScrubbing) return;
      if (e.touches[0]) handleScrub(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('touchend', () => {
      isScrubbing = false;
    });

    // Global Key Listener for Space -> Toggle Audio, Escape -> Toggle Drawer, Up/Down -> Cue Navigation
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Escape') {
        e.preventDefault();
        toggleDrawer();
      } else if (e.code === 'Space' && (e.target === document.body || (e.target as HTMLElement)?.classList.contains('reveal'))) {
        e.preventDefault();
        audioSync.togglePlay();
      } else if (e.code === 'ArrowDown' || (e.shiftKey && e.code === 'ArrowRight') || e.code === 'KeyJ') {
        e.preventDefault();
        audioSync.nextCue();
      } else if (e.code === 'ArrowUp' || (e.shiftKey && e.code === 'ArrowLeft') || e.code === 'KeyK') {
        e.preventDefault();
        audioSync.prevCue();
      }
    });

    // PDF Handout Dynamic Theme Detection & Menu Toggle
    const btnDownloadPdf = document.getElementById('btn-download-pdf') as HTMLAnchorElement | null;
    const btnTogglePdfMenu = document.getElementById('btn-toggle-pdf-menu');
    const pdfDownloadMenu = document.getElementById('pdf-download-menu');

    const updatePdfDownload = () => {
      if (!btnDownloadPdf) return;
      const pdfDark = btnDownloadPdf.getAttribute('data-pdf-dark');
      const pdfLight = btnDownloadPdf.getAttribute('data-pdf-light');
      const deckId = btnDownloadPdf.getAttribute('data-deck-id') || 'presentation';
      const isLight = document.documentElement.classList.contains('light');

      if (isLight && pdfLight) {
        btnDownloadPdf.href = pdfLight;
        btnDownloadPdf.setAttribute('download', `Presentation_${deckId}_Light.pdf`);
        btnDownloadPdf.title = 'Download PDF handout (Light mode / print-friendly)';
        btnDownloadPdf.setAttribute('aria-label', 'Download PDF handout (Light mode)');
      } else if (pdfDark) {
        btnDownloadPdf.href = pdfDark;
        btnDownloadPdf.setAttribute('download', `Presentation_${deckId}_Dark.pdf`);
        btnDownloadPdf.title = 'Download PDF handout (Dark mode)';
        btnDownloadPdf.setAttribute('aria-label', 'Download PDF handout (Dark mode)');
      }
    };

    updatePdfDownload();
    window.addEventListener('theme-changed', updatePdfDownload);

    if (btnTogglePdfMenu && pdfDownloadMenu) {
      btnTogglePdfMenu.addEventListener('click', (e) => {
        e.stopPropagation();
        pdfDownloadMenu.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!pdfDownloadMenu.contains(e.target as Node) && e.target !== btnTogglePdfMenu) {
          pdfDownloadMenu.classList.add('hidden');
        }
      });
    }

    // Initialize initial slide cues (Titelfolie in full mode)
    audioSync.setSlideIndex(0, { entryMode: 'full' });

    // Dismiss loading indicator & reveal deck smoothly
    if (revealRoot) revealRoot.classList.add('deck-ready');
    if (deckLoader) {
      deckLoader.classList.add('opacity-0');
      setTimeout(() => deckLoader.remove(), 350);
    }
  });
</script>

