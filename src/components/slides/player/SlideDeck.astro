---
import 'reveal.js/reveal.css';

interface SlideMeta {
  id: string;
  title: string;
  audioUrl?: string;
  cues?: Record<string, any>;
  notes?: string;
}

interface Props {
  talkId: string;
  slides: SlideMeta[];
  class?: string;
  pdfUrl?: string;
}

const { talkId, slides, class: className = "", pdfUrl } = Astro.props;
---

<div class={`slide-deck-wrapper relative w-full aspect-[16/9.6] max-h-[88vh] bg-slate-950 light:bg-slate-100 border border-slate-800 light:border-slate-300 rounded-3xl overflow-hidden shadow-2xl flex flex-col ${className}`}>
  <!-- Slide Stage Viewport with Drawer / Sidebar Layer -->
  <div class="relative flex-1 w-full min-h-0 flex overflow-hidden">
    <!-- Slide List Backdrop (Mobile only: dims & blurs slide stage) -->
    <div
      id="slide-list-backdrop"
      class="lg:hidden absolute inset-0 bg-slate-950/60 light:bg-slate-900/30 backdrop-blur-xs z-30 opacity-0 pointer-events-none transition-opacity duration-300 cursor-pointer"
      title="Schließen"
    ></div>

    <!-- Slide List Sidebar (Side-by-side on desktop lg+, overlay drawer on mobile <lg) -->
    <aside
      id="slide-list-drawer"
      class="drawer-closed bg-slate-900/95 light:bg-white/95 lg:bg-slate-900 lg:light:bg-slate-50 border-r border-slate-800 light:border-slate-200 z-40 flex flex-col shadow-2xl lg:shadow-none select-none shrink-0"
      aria-label="Folienübersicht"
      aria-hidden="true"
    >
      <div class="w-80 h-full flex flex-col">
        <!-- Drawer Header -->
        <div class="p-4 border-b border-slate-800 light:border-slate-200 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <h2 class="font-bold text-xs uppercase tracking-wider text-slate-200 light:text-slate-800">Folienübersicht</h2>
            <span class="text-xs font-mono px-2 py-0.5 rounded-full bg-slate-800 light:bg-slate-100 text-slate-400 light:text-slate-500 font-bold ml-1">
              {slides.length}
            </span>
          </div>
          <button
            id="btn-close-drawer"
            class="w-8 h-8 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-400 hover:text-slate-200 light:text-slate-500 light:hover:text-slate-800 flex items-center justify-center transition-colors cursor-pointer"
            title="Schließen (ESC)"
            aria-label="Folienübersicht schließen"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Slide Items List (Scrollable) -->
        <div class="flex-1 overflow-y-auto p-3 space-y-1.5 custom-scrollbar min-h-0" id="slide-list-items">
          {slides.map((slide, idx) => (
            <button
              type="button"
              data-slide-index={idx}
              data-active={idx === 0 ? "true" : undefined}
              class={`slide-list-item w-full text-left p-3 rounded-xl flex items-start gap-3 transition-all duration-200 cursor-pointer border ${
                idx === 0
                  ? 'bg-blue-600/15 border-blue-500/40 text-blue-400 light:bg-blue-50 light:border-blue-300 light:text-blue-700 font-semibold'
                  : 'bg-transparent border-transparent hover:bg-slate-800/60 light:hover:bg-slate-100 text-slate-300 light:text-slate-700'
              }`}
            >
              <span class={`font-mono text-xs px-2 py-0.5 rounded-md font-bold shrink-0 mt-0.5 ${
                idx === 0
                  ? 'bg-blue-500/20 text-blue-300 light:bg-blue-200 light:text-blue-800'
                  : 'bg-slate-800 light:bg-slate-200/80 text-slate-400 light:text-slate-600'
              }`}>
                {String(idx + 1).padStart(2, '0')}
              </span>
              <span class="text-xs sm:text-sm line-clamp-2 flex-1 leading-snug">
                {slide.title || `Folie ${idx + 1}`}
              </span>
            </button>
          ))}
        </div>
      </div>
    </aside>

    <!-- Slide Canvas Viewport (Crisp, unblurred, auto-scaling) -->
    <div class="relative flex-1 h-full min-w-0 overflow-hidden bg-slate-950 light:bg-slate-100 flex items-center justify-center">
      <!-- Reveal.js Container -->
      <div class="reveal w-full h-full relative" id="reveal-root">
        <div class="slides w-full h-full">
          <slot />
        </div>
      </div>
    </div>
  </div>

  <!-- Audio & Slide Navigation Control Bar -->
  <div class="slide-controls-bar z-50 bg-slate-900/95 light:bg-white/95 backdrop-blur-md border-t border-slate-800 light:border-slate-200 px-6 py-4 flex items-center justify-between gap-6 text-slate-300 light:text-slate-700 select-none">
    <!-- Left: Play/Pause & Slide Step -->
    <div class="flex items-center gap-3">
      <button
        id="btn-prev"
        class="w-10 h-10 rounded-xl bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-200 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Vorherige Folie (←)"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="btn-play-pause"
        class="px-5 h-10 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold flex items-center gap-2 transition-all shadow-md cursor-pointer"
        title="Audio Vortrag abspielen / pausieren (Leertaste)"
      >
        <svg id="icon-play" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <svg id="icon-pause" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
        </svg>
        <span id="label-play-pause" class="text-sm">Vortrag anhören</span>
      </button>

      <button
        id="btn-next"
        class="w-10 h-10 rounded-xl bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-200 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Nächste Folie (→)"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Center: Timeline & Progress Scrubbing -->
    <div class="flex-1 max-w-xl flex items-center gap-4">
      <span id="time-current" class="text-xs font-mono text-slate-400 light:text-slate-500 w-10 text-right">0:00</span>
      <div class="flex-1 relative h-2 bg-slate-800 light:bg-slate-200 rounded-full overflow-hidden cursor-pointer group" id="progress-container">
        <div id="progress-bar" class="h-full bg-blue-500 rounded-full w-0 transition-all duration-100"></div>
      </div>
      <span id="time-total" class="text-xs font-mono text-slate-400 light:text-slate-500 w-10">0:00</span>
    </div>

    <!-- Right: Tools, Speed, Overview, Fullscreen -->
    <div class="flex items-center gap-3">
      <!-- Speed Toggle -->
      <button
        id="btn-speed"
        class="px-3 h-9 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-300 light:text-slate-700 border border-transparent light:border-slate-300 text-xs font-mono font-bold transition-colors cursor-pointer"
        title="Wiedergabegeschwindigkeit"
      >
        1.0x
      </button>

      <!-- Slide List Drawer Toggle (ESC) -->
      <button
        id="btn-overview"
        class="w-9 h-9 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-300 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Folienübersicht (ESC)"
        aria-label="Folienübersicht öffnen oder schließen"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Fullscreen (F) -->
      <button
        id="btn-fullscreen"
        class="w-9 h-9 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-300 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
        title="Vollbild (F)"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5h-4m4 0v-4m0 4l-5-5" />
        </svg>
      </button>

      <!-- Download PDF Handout -->
      {pdfUrl && (
        <a
          id="btn-download-pdf"
          href={pdfUrl}
          download={`Vortrag_${talkId}.pdf`}
          class="w-9 h-9 rounded-lg bg-slate-800 light:bg-slate-100 hover:bg-slate-700 light:hover:bg-slate-200 text-slate-300 light:text-slate-700 border border-transparent light:border-slate-300 flex items-center justify-center transition-colors cursor-pointer"
          title="PDF Handout herunterladen"
          aria-label="PDF Handout herunterladen"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </a>
      )}

      <!-- Slide Counter -->
      <div class="px-3 h-9 rounded-lg bg-slate-800/60 light:bg-slate-100 border border-slate-700/50 light:border-slate-300 flex items-center text-xs font-mono text-slate-400 light:text-slate-600 font-bold">
        <span id="slide-index-label">1</span>
        <span class="mx-1">/</span>
        <span>{slides.length}</span>
      </div>
    </div>
  </div>
</div>

<!-- Slides Metadata Carrier -->
<script id="slides-meta" is:inline type="application/json" set:html={JSON.stringify(slides)}></script>

<script>
  import Reveal from 'reveal.js';
  import { AudioSyncController, type SlideData } from './AudioSyncController';

  // Read metadata
  const metaEl = document.getElementById('slides-meta');
  const slidesData: SlideData[] = metaEl ? JSON.parse(metaEl.textContent || '[]') : [];

  // Initialize Reveal.js
  const deck = new Reveal(document.getElementById('reveal-root') as HTMLElement, {
    width: 1920,
    height: 1080,
    margin: 0.02,
    minScale: 0.2,
    maxScale: 2.0,
    controls: false,
    progress: false,
    hash: false,
    history: false,
    keyboard: true,
    overview: false,
    center: true,
    transition: 'fade',
    transitionSpeed: 'fast',
    embedded: true,
    mouseWheel: false
  });


  deck.initialize().then(() => {
    // UI Elements
    const btnPlayPause = document.getElementById('btn-play-pause');
    const iconPlay = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');
    const labelPlayPause = document.getElementById('label-play-pause');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const btnSpeed = document.getElementById('btn-speed');
    const btnOverview = document.getElementById('btn-overview');
    const btnFullscreen = document.getElementById('btn-fullscreen');
    const progressBar = document.getElementById('progress-bar');
    const progressContainer = document.getElementById('progress-container');
    const timeCurrent = document.getElementById('time-current');
    const timeTotal = document.getElementById('time-total');
    const slideIndexLabel = document.getElementById('slide-index-label');

    // Drawer Elements
    const slideListDrawer = document.getElementById('slide-list-drawer');
    const slideListBackdrop = document.getElementById('slide-list-backdrop');
    const btnCloseDrawer = document.getElementById('btn-close-drawer');
    const slideListItems = document.querySelectorAll<HTMLButtonElement>('.slide-list-item');

    let isDrawerOpen = false;

    const openDrawer = (shouldScroll = true) => {
      if (!slideListDrawer) return;
      isDrawerOpen = true;
      slideListDrawer.classList.remove('drawer-closed');
      slideListDrawer.classList.add('drawer-open');
      slideListDrawer.setAttribute('aria-hidden', 'false');

      if (slideListBackdrop && window.innerWidth < 1024) {
        slideListBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        slideListBackdrop.classList.add('opacity-100', 'pointer-events-auto');
      }

      btnOverview?.classList.add('bg-blue-600', 'text-white');
      btnOverview?.classList.remove('bg-slate-800', 'light:bg-slate-100', 'text-slate-300', 'light:text-slate-700');

      if (shouldScroll) {
        const activeItem = document.querySelector<HTMLElement>('.slide-list-item[data-active="true"]');
        if (activeItem) {
          activeItem.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      }
    };

    const closeDrawer = () => {
      if (!slideListDrawer) return;
      isDrawerOpen = false;
      slideListDrawer.classList.remove('drawer-open');
      slideListDrawer.classList.add('drawer-closed');
      slideListDrawer.setAttribute('aria-hidden', 'true');

      if (slideListBackdrop) {
        slideListBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
        slideListBackdrop.classList.add('opacity-0', 'pointer-events-none');
      }

      btnOverview?.classList.remove('bg-blue-600', 'text-white');
      btnOverview?.classList.add('bg-slate-800', 'light:bg-slate-100', 'text-slate-300', 'light:text-slate-700');
    };

    const toggleDrawer = () => {
      if (isDrawerOpen) {
        closeDrawer();
      } else {
        openDrawer(true);
      }
    };

    const updateActiveSlideInList = (currentIndex: number) => {
      slideListItems.forEach((item, idx) => {
        const numBadge = item.querySelector('span:first-child');
        if (idx === currentIndex) {
          item.setAttribute('data-active', 'true');
          item.className = 'slide-list-item w-full text-left p-3 rounded-xl flex items-start gap-3 transition-all duration-200 cursor-pointer border bg-blue-600/15 border-blue-500/40 text-blue-400 light:bg-blue-50 light:border-blue-300 light:text-blue-700 font-semibold';
          if (numBadge) {
            numBadge.className = 'font-mono text-xs px-2 py-0.5 rounded-md bg-blue-500/20 text-blue-300 light:bg-blue-200 light:text-blue-800 font-bold shrink-0 mt-0.5';
          }
        } else {
          item.removeAttribute('data-active');
          item.className = 'slide-list-item w-full text-left p-3 rounded-xl flex items-start gap-3 transition-all duration-200 cursor-pointer border bg-transparent border-transparent hover:bg-slate-800/60 light:hover:bg-slate-100 text-slate-300 light:text-slate-700';
          if (numBadge) {
            numBadge.className = 'font-mono text-xs px-2 py-0.5 rounded-md bg-slate-800 light:bg-slate-200/80 text-slate-400 light:text-slate-600 font-bold shrink-0 mt-0.5';
          }
        }
      });
    };

    // Format MM:SS with strict finite validation
    const formatTime = (seconds: number) => {
      if (typeof seconds !== 'number' || !Number.isFinite(seconds) || isNaN(seconds) || seconds < 0) {
        return '0:00';
      }
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    };

    // Instantiate Audio Controller
    const audioSync = new AudioSyncController(slidesData, {
      onSlideChange: (index) => {
        if (deck.getIndices().h !== index) {
          deck.slide(index);
        }
        if (slideIndexLabel) slideIndexLabel.textContent = String(index + 1);
        updateActiveSlideInList(index);
        if (progressBar) progressBar.style.width = '0%';
        if (timeCurrent) timeCurrent.textContent = '0:00';
        if (timeTotal) timeTotal.textContent = '0:00';
      },
      onProgress: (current, total) => {
        if (timeCurrent) timeCurrent.textContent = formatTime(current);
        if (timeTotal && Number.isFinite(total) && total > 0) {
          timeTotal.textContent = formatTime(total);
        }
        if (progressBar && Number.isFinite(total) && total > 0) {
          const pct = Math.min(100, Math.max(0, (current / total) * 100));
          progressBar.style.width = `${pct}%`;
        }
      },
      onPlayStateChange: (isPlaying) => {
        if (iconPlay && iconPause && labelPlayPause) {
          if (isPlaying) {
            iconPlay.classList.add('hidden');
            iconPause.classList.remove('hidden');
            labelPlayPause.textContent = 'Pausieren';
          } else {
            iconPlay.classList.remove('hidden');
            iconPause.classList.add('hidden');
            labelPlayPause.textContent = 'Vortrag anhören';
          }
        }
      }
    });

    // Reveal Slide Changed Event
    deck.on('slidechanged', (event: any) => {
      const idx = event.indexh;
      if (slideIndexLabel) slideIndexLabel.textContent = String(idx + 1);
      updateActiveSlideInList(idx);
      audioSync.setSlideIndex(idx, false);
    });

    // Button Listeners
    btnPlayPause?.addEventListener('click', () => audioSync.togglePlay());
    btnPrev?.addEventListener('click', () => deck.prev());
    btnNext?.addEventListener('click', () => deck.next());

    // Slide List Item Navigation Click Listeners
    slideListItems.forEach((item) => {
      item.addEventListener('click', () => {
        const slideIdxStr = item.getAttribute('data-slide-index');
        if (slideIdxStr !== null) {
          const targetIdx = parseInt(slideIdxStr, 10);
          deck.slide(targetIdx);
          // Only auto-close on mobile (< 1024px) where drawer overlays the slide
          if (window.innerWidth < 1024) {
            closeDrawer();
          }
        }
      });
    });

    btnOverview?.addEventListener('click', () => toggleDrawer());
    btnCloseDrawer?.addEventListener('click', () => closeDrawer());
    slideListBackdrop?.addEventListener('click', () => closeDrawer());

    // Initial drawer state: open on desktop (side-by-side), closed on mobile
    if (window.innerWidth >= 1024) {
      openDrawer(false);
    } else {
      closeDrawer();
    }

    // Auto-adapt Reveal scale whenever slide canvas viewport resizes
    const revealRoot = document.getElementById('reveal-root');
    if (revealRoot && typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(() => {
        deck.layout();
      });
      ro.observe(revealRoot);
    }

    // Responsive breakpoint listener for mobile <-> desktop transitions
    let prevIsDesktop = window.innerWidth >= 1024;
    window.addEventListener('resize', () => {
      const isDesktop = window.innerWidth >= 1024;
      if (isDesktop !== prevIsDesktop) {
        prevIsDesktop = isDesktop;
        if (isDesktop && !isDrawerOpen) {
          openDrawer(false);
        } else if (!isDesktop && isDrawerOpen) {
          closeDrawer();
        }
      }
    });

    // Speed Cycle: 1.0x -> 1.25x -> 1.5x -> 1.0x
    const rates = [1.0, 1.25, 1.5];
    let rateIdx = 0;
    btnSpeed?.addEventListener('click', () => {
      rateIdx = (rateIdx + 1) % rates.length;
      const r = rates[rateIdx];
      audioSync.setRate(r);
      if (btnSpeed) btnSpeed.textContent = `${r.toFixed(2)}x`;
    });

    btnFullscreen?.addEventListener('click', () => {
      const wrapper = document.querySelector('.slide-deck-wrapper');
      if (!document.fullscreenElement && wrapper) {
        wrapper.requestFullscreen().catch(() => {});
      } else if (document.exitFullscreen) {
        document.exitFullscreen();
      }
    });

    // Progress Bar Scrubbing
    progressContainer?.addEventListener('click', (e) => {
      const rect = progressContainer.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const pct = Math.max(0, Math.min(1, clickX / rect.width));
      const parts = (timeTotal?.textContent || '0:00').split(':');
      const min = parseFloat(parts[0]) || 0;
      const sec = parseFloat(parts[1]) || 0;
      const totalSec = min * 60 + sec;
      if (Number.isFinite(totalSec) && totalSec > 0) {
        audioSync.seek(pct * totalSec);
      }
    });

    // Global Key Listener for Space -> Toggle Audio & Escape -> Toggle Drawer
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Escape') {
        e.preventDefault();
        toggleDrawer();
      } else if (e.code === 'Space' && e.target === document.body) {
        e.preventDefault();
        audioSync.togglePlay();
      }
    });
  });
</script>

<style is:global>
  /* Reveal custom styling inside Astro component */
  .reveal {
    font-family: inherit;
    background: transparent !important;
  }
  .reveal .slides {
    text-align: left;
  }
  .reveal .slides section {
    padding: 0 !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  /* Slide Canvas Theme Overrides for Dark Mode */
  :root:not(.light) .bento-card-object .bg-blue-50,
  :root:not(.light) .bento-card-object .bg-blue-50\/70,
  :root:not(.light) .bento-card-object .bg-blue-50\/60,
  :root:not(.light) .bento-card-object .bg-blue-50\/80 {
    background-color: rgba(30, 58, 138, 0.25) !important;
    border-color: rgba(59, 130, 246, 0.35) !important;
    color: #f1f5f9 !important;
  }

  :root:not(.light) .bento-card-object .bg-cyan-50,
  :root:not(.light) .bento-card-object .bg-cyan-50\/70 {
    background-color: rgba(22, 78, 99, 0.25) !important;
    border-color: rgba(6, 182, 212, 0.35) !important;
    color: #f1f5f9 !important;
  }

  :root:not(.light) .bento-card-object .bg-indigo-50,
  :root:not(.light) .bento-card-object .bg-indigo-50\/70 {
    background-color: rgba(49, 46, 129, 0.25) !important;
    border-color: rgba(99, 102, 241, 0.35) !important;
    color: #f1f5f9 !important;
  }

  :root:not(.light) .bento-card-object .bg-emerald-50,
  :root:not(.light) .bento-card-object .bg-emerald-50\/70 {
    background-color: rgba(6, 78, 59, 0.25) !important;
    border-color: rgba(16, 185, 129, 0.35) !important;
    color: #f1f5f9 !important;
  }

  :root:not(.light) .bento-card-object .bg-slate-50,
  :root:not(.light) .bento-card-object .bg-slate-100 {
    background-color: rgba(30, 41, 59, 0.55) !important;
    border-color: rgba(71, 85, 105, 0.45) !important;
    color: #f1f5f9 !important;
  }

  :root:not(.light) .bento-card-object .bg-white {
    background-color: rgba(15, 23, 42, 0.85) !important;
    border-color: rgba(71, 85, 105, 0.5) !important;
