---
interface Props {
  id?: string;
  cue?: string;
  class?: string;
}

const {
  id: explicitId,
  cue,
  class: className = ""
} = Astro.props;

const elementId = explicitId || cue;
---

<mark
  id={elementId}
  data-cue={cue}
  class={`highlight-marker inline-block font-semibold rounded-[0.38em] ${className}`}
>
  <slot />
</mark>

