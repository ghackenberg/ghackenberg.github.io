---
interface Props {
  id?: string;
  cue?: string;
  class?: string;
}

const { id, cue = "graph-area", class: className = "" } = Astro.props;
const elementId = id || cue;
---

<div id={elementId} data-cue={cue} class={`entity-graph-visual w-full h-full flex items-center justify-center p-1 min-h-0 ${className}`}>
  <svg viewBox="0 0 800 490" class="w-full h-full max-h-full" preserveAspectRatio="xMidYMid meet">
    <defs>
      <!-- Drop Shadows -->
      <filter id="card-shadow" x="-10%" y="-10%" width="130%" height="130%">
        <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000000" flood-opacity="0.25" />
      </filter>
      
      <filter id="glow-blue" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>

      <!-- Arrow Markers -->
      <marker id="arrow-blue" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="#3b82f6" />
      </marker>
      <marker id="arrow-cyan" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="#06b6d4" />
      </marker>
      <marker id="arrow-amber" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="#f59e0b" />
      </marker>
      <marker id="arrow-emerald" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="#10b981" />
      </marker>

      <!-- Gradients -->
      <linearGradient id="edge-blue-cyan" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#3b82f6" />
        <stop offset="100%" stop-color="#06b6d4" />
      </linearGradient>

      <linearGradient id="edge-amber-emerald" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#f59e0b" />
        <stop offset="100%" stop-color="#10b981" />
      </linearGradient>
    </defs>

    <!-- RELATION CONNECTORS (BEHIND CARDS) -->
    
    <!-- 1. Top Edge: Fronius -> Symo GEN24 (entwickelt) -->
    <g id="edge-01" data-cue="edge-01" class="transition-all duration-500">
      <path
        d="M 325 92 L 465 92"
        fill="none"
        stroke="url(#edge-blue-cyan)"
        stroke-width="3"
        stroke-dasharray="6 4"
        marker-end="url(#arrow-cyan)"
        filter="url(#glow-blue)"
      />
      <!-- Relation Pill -->
      <g transform="translate(400, 92)">
        <rect x="-56" y="-15" width="112" height="30" rx="15" class="rel-pill-bg" stroke="#3b82f6" stroke-width="2" />
        <text y="5" text-anchor="middle" class="rel-text-blue" font-size="13" font-weight="800" font-family="'Inter', sans-serif">
          entwickelt →
        </text>
      </g>
    </g>

    <!-- 2. Left Edge: Fronius -> Pettenbach (Standort in) -->
    <g id="edge-03" data-cue="edge-03" class="transition-all duration-500">
      <path
        d="M 180 150 L 180 335"
        fill="none"
        stroke="#3b82f6"
        stroke-width="3"
        stroke-dasharray="6 4"
        marker-end="url(#arrow-blue)"
      />
      <!-- Relation Pill -->
      <g transform="translate(180, 247)">
        <rect x="-60" y="-15" width="120" height="30" rx="15" class="rel-pill-bg" stroke="#3b82f6" stroke-width="2" />
        <text y="5" text-anchor="middle" class="rel-text-blue" font-size="13" font-weight="800" font-family="'Inter', sans-serif">
          Standort in ↓
        </text>
      </g>
    </g>

    <!-- 3. Right Edge: Symo GEN24 -> VDE Norm (zertifiziert nach) -->
    <g id="edge-02" data-cue="edge-02" class="transition-all duration-500">
      <path
        d="M 620 150 L 620 335"
        fill="none"
        stroke="#06b6d4"
        stroke-width="3"
        stroke-dasharray="6 4"
        marker-end="url(#arrow-cyan)"
      />
      <!-- Relation Pill -->
      <g transform="translate(620, 247)">
        <rect x="-74" y="-15" width="148" height="30" rx="15" class="rel-pill-bg" stroke="#06b6d4" stroke-width="2" />
        <text y="5" text-anchor="middle" class="rel-text-cyan" font-size="13" font-weight="800" font-family="'Inter', sans-serif">
          zertifiziert nach ↓
        </text>
      </g>
    </g>

    <!-- 4. Bottom Edge: Pettenbach -> VDE Norm (reguliert durch) -->
    <g id="edge-04" data-cue="edge-04" class="transition-all duration-500">
      <path
        d="M 325 402 L 465 402"
        fill="none"
        stroke="url(#edge-amber-emerald)"
        stroke-width="3"
        stroke-dasharray="6 4"
        marker-end="url(#arrow-emerald)"
      />
      <!-- Relation Pill -->
      <g transform="translate(400, 402)">
        <rect x="-68" y="-15" width="136" height="30" rx="15" class="rel-pill-bg" stroke="#10b981" stroke-width="2" />
        <text y="5" text-anchor="middle" class="rel-text-emerald" font-size="13" font-weight="800" font-family="'Inter', sans-serif">
          reguliert durch →
        </text>
      </g>
    </g>

    <!-- CENTER MULTI-HOP BADGE -->
    <g transform="translate(400, 247)" class="transition-all duration-500">
      <rect x="-105" y="-20" width="210" height="40" rx="20" class="center-pill-bg" stroke="#6366f1" stroke-width="2" filter="url(#card-shadow)" />
      <text y="6" text-anchor="middle" class="center-pill-text" font-size="13" font-weight="900" font-family="'Inter', sans-serif" letter-spacing="0.5">
        ⚡ MULTI-HOP REASONING
      </text>
    </g>


    <!-- ENTITY CARDS (FOREGROUND) -->

    <!-- ENTITY 1: ORGANIZATION (Top-Left) -->
    <g id="node-org" transform="translate(35, 35)" class="transition-transform duration-300">
      <!-- Card Container -->
      <rect
        width="290"
        height="115"
        rx="18"
        class="card-bg"
        stroke="#3b82f6"
        stroke-width="2"
        filter="url(#card-shadow)"
      />
      <!-- Type Badge Pill -->
      <g transform="translate(18, 18)">
        <rect width="130" height="22" rx="11" class="badge-blue-bg" stroke="#3b82f6" stroke-width="1.2" />
        <text x="65" y="15" text-anchor="middle" class="badge-blue-text" font-size="10.5" font-weight="800" font-family="'Inter', sans-serif" letter-spacing="0.8">
          🏢 ORGANIZATION
        </text>
      </g>
      <!-- Entity Title -->
      <text x="18" y="72" class="card-title" font-size="19" font-weight="900" font-family="'Inter', sans-serif">
        Fronius International
      </text>
      <!-- Schema URI / ID -->
      <text x="18" y="96" class="card-sub" font-size="12" font-weight="600" font-family="'JetBrains Mono', monospace">
        schema:Organization • @id:#fronius
      </text>
    </g>

    <!-- ENTITY 2: PRODUCT (Top-Right) -->
    <g id="node-prod" transform="translate(475, 35)" class="transition-transform duration-300">
      <!-- Card Container -->
      <rect
        width="290"
        height="115"
        rx="18"
        class="card-bg"
        stroke="#06b6d4"
        stroke-width="2"
        filter="url(#card-shadow)"
      />
      <!-- Type Badge Pill -->
      <g transform="translate(18, 18)">
        <rect width="105" height="22" rx="11" class="badge-cyan-bg" stroke="#06b6d4" stroke-width="1.2" />
        <text x="52.5" y="15" text-anchor="middle" class="badge-cyan-text" font-size="10.5" font-weight="800" font-family="'Inter', sans-serif" letter-spacing="0.8">
          ⚡ PRODUCT
        </text>
      </g>
      <!-- Entity Title -->
      <text x="18" y="72" class="card-title" font-size="19" font-weight="900" font-family="'Inter', sans-serif">
        Symo GEN24 Plus
      </text>
      <!-- Schema URI / ID -->
      <text x="18" y="96" class="card-sub" font-size="12" font-weight="600" font-family="'JetBrains Mono', monospace">
        schema:Product • @id:#symo-gen24
      </text>
    </g>

    <!-- ENTITY 3: LOCATION (Bottom-Left) -->
    <g id="node-loc" transform="translate(35, 345)" class="transition-transform duration-300">
      <!-- Card Container -->
      <rect
        width="290"
        height="115"
        rx="18"
        class="card-bg"
        stroke="#f59e0b"
        stroke-width="2"
        filter="url(#card-shadow)"
      />
      <!-- Type Badge Pill -->
      <g transform="translate(18, 18)">
        <rect width="110" height="22" rx="11" class="badge-amber-bg" stroke="#f59e0b" stroke-width="1.2" />
        <text x="55" y="15" text-anchor="middle" class="badge-amber-text" font-size="10.5" font-weight="800" font-family="'Inter', sans-serif" letter-spacing="0.8">
          📍 LOCATION
        </text>
      </g>
      <!-- Entity Title -->
      <text x="18" y="72" class="card-title" font-size="19" font-weight="900" font-family="'Inter', sans-serif">
        Pettenbach (OÖ)
      </text>
      <!-- Schema URI / ID -->
      <text x="18" y="96" class="card-sub" font-size="12" font-weight="600" font-family="'JetBrains Mono', monospace">
        schema:Place • AT-4643
      </text>
    </g>

    <!-- ENTITY 4: STANDARD (Bottom-Right) -->
    <g id="node-std" transform="translate(475, 345)" class="transition-transform duration-300">
      <!-- Card Container -->
      <rect
        width="290"
        height="115"
        rx="18"
        class="card-bg"
        stroke="#10b981"
        stroke-width="2"
        filter="url(#card-shadow)"
      />
      <!-- Type Badge Pill -->
      <g transform="translate(18, 18)">
        <rect width="112" height="22" rx="11" class="badge-emerald-bg" stroke="#10b981" stroke-width="1.2" />
        <text x="56" y="15" text-anchor="middle" class="badge-emerald-text" font-size="10.5" font-weight="800" font-family="'Inter', sans-serif" letter-spacing="0.8">
          📜 STANDARD
        </text>
      </g>
      <!-- Entity Title -->
      <text x="18" y="72" class="card-title" font-size="19" font-weight="900" font-family="'Inter', sans-serif">
        VDE-AR-N 4105
      </text>
      <!-- Schema URI / ID -->
      <text x="18" y="96" class="card-sub" font-size="12" font-weight="600" font-family="'JetBrains Mono', monospace">
        schema:DefinedTerm • Netznorm
      </text>
    </g>
  </svg>
</div>

<style>
  /* Dual-Theme Styles */
  .card-bg {
    fill: #090d16;
  }
  :global(.light) .card-bg {
    fill: #ffffff;
  }

  .card-title {
    fill: #f8fafc;
  }
  :global(.light) .card-title {
    fill: #0f172a;
  }

  .card-sub {
    fill: #94a3b8;
  }
  :global(.light) .card-sub {
    fill: #64748b;
  }

  .rel-pill-bg {
    fill: #090d16;
  }
  :global(.light) .rel-pill-bg {
    fill: #ffffff;
  }

  .rel-text-blue {
    fill: #93c5fd;
  }
  :global(.light) .rel-text-blue {
    fill: #1d4ed8;
  }

  .rel-text-cyan {
    fill: #a5f3fc;
  }
  :global(.light) .rel-text-cyan {
    fill: #0e7490;
  }

  .rel-text-emerald {
    fill: #6ee7b7;
  }
  :global(.light) .rel-text-emerald {
    fill: #047857;
  }

  .center-pill-bg {
    fill: #1e1b4b;
  }
  :global(.light) .center-pill-bg {
    fill: #e0e7ff;
  }

  .center-pill-text {
    fill: #c7d2fe;
  }
  :global(.light) .center-pill-text {
    fill: #3730a3;
  }

  /* Badge styling */
  .badge-blue-bg { fill: #172554; }
  :global(.light) .badge-blue-bg { fill: #dbeafe; }
  .badge-blue-text { fill: #93c5fd; }
  :global(.light) .badge-blue-text { fill: #1d4ed8; }

  .badge-cyan-bg { fill: #083344; }
  :global(.light) .badge-cyan-bg { fill: #cffafe; }
  .badge-cyan-text { fill: #a5f3fc; }
  :global(.light) .badge-cyan-text { fill: #0e7490; }

  .badge-amber-bg { fill: #451a03; }
  :global(.light) .badge-amber-bg { fill: #fef3c7; }
  .badge-amber-text { fill: #fde68a; }
  :global(.light) .badge-amber-text { fill: #b45309; }

  .badge-emerald-bg { fill: #022c22; }
  :global(.light) .badge-emerald-bg { fill: #d1fae5; }
  .badge-emerald-text { fill: #6ee7b7; }
  :global(.light) .badge-emerald-text { fill: #047857; }
</style>
