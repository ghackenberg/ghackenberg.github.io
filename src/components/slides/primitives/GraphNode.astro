---
interface Props {
  x: number;
  y: number;
  label: string;
  type?: string;
  color?: 'blue' | 'teal' | 'indigo' | 'green' | 'amber';
  id?: string;
  radius?: number;
  class?: string;
}

const {
  x,
  y,
  label,
  type,
  color = 'blue',
  id,
  radius = 65,
  class: className = ""
} = Astro.props;

const colorSchemes: Record<string, { fill: string; stroke: string; text: string; pill: string }> = {
  blue: {
    fill: 'color-mix(in srgb, var(--color-slide-accent-blue) 12%, var(--color-slide-card-bg))',
    stroke: 'var(--color-slide-accent-blue)',
    text: 'var(--color-slide-text)',
    pill: 'var(--color-slide-accent-blue)'
  },
  teal: {
    fill: 'color-mix(in srgb, var(--color-slide-accent-teal) 12%, var(--color-slide-card-bg))',
    stroke: 'var(--color-slide-accent-teal)',
    text: 'var(--color-slide-text)',
    pill: 'var(--color-slide-accent-teal)'
  },
  indigo: {
    fill: 'color-mix(in srgb, var(--color-slide-accent-indigo) 12%, var(--color-slide-card-bg))',
    stroke: 'var(--color-slide-accent-indigo)',
    text: 'var(--color-slide-text)',
    pill: 'var(--color-slide-accent-indigo)'
  },
  green: {
    fill: 'color-mix(in srgb, var(--color-slide-accent-emerald) 12%, var(--color-slide-card-bg))',
    stroke: 'var(--color-slide-accent-emerald)',
    text: 'var(--color-slide-text)',
    pill: 'var(--color-slide-accent-emerald)'
  },
  amber: {
    fill: 'color-mix(in srgb, var(--color-slide-accent-amber) 12%, var(--color-slide-card-bg))',
    stroke: 'var(--color-slide-accent-amber)',
    text: 'var(--color-slide-text)',
    pill: 'var(--color-slide-accent-amber)'
  }
};

const scheme = colorSchemes[color] || colorSchemes.blue;
---

<g id={id} class={`graph-node transition-transform duration-300 ${className}`} transform={`translate(${x}, ${y})`}>
  <!-- Outer glowing border -->
  <circle
    r={radius}
    fill={scheme.fill}
    stroke={scheme.stroke}
    stroke-width="3"
    filter="drop-shadow(0 4px 6px rgba(0,0,0,0.05))"
  />

  <!-- Type Badge (optional top pill) -->
  {type && (
    <g transform={`translate(0, -${radius - 12})`}>
      <rect
        x={-(type.length * 4.5 + 10)}
        y="-10"
        width={type.length * 9 + 20}
        height="20"
        rx="10"
        fill={scheme.stroke}
      />
      <text
        y="4"
        text-anchor="middle"
        fill="white"
        font-size="11"
        font-weight="700"
        letter-spacing="0.5"
        font-family="'Outfit', sans-serif"
      >
        {type.toUpperCase()}
      </text>
    </g>
  )}

  <!-- Node Label -->
  <text
    y={type ? "8" : "6"}
    text-anchor="middle"
    fill={scheme.text}
    font-size="16"
    font-weight="700"
    font-family="'Outfit', sans-serif"
  >
    {label}
  </text>
</g>
