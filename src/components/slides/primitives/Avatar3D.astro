---
import profileImage from "../../../assets/images/comic-profile-head.png";
import profileDepthImage from "../../../assets/images/comic-profile-head-depth.png";
import profileWinkImage from "../../../assets/images/comic-profile-head-wink.png";
import profileWinkDepthImage from "../../../assets/images/comic-profile-head-wink-depth.png";
import profileBlinkImage from "../../../assets/images/comic-profile-head-blink.png";
import profileBlinkDepthImage from "../../../assets/images/comic-profile-head-blink-depth.png";
import profileClosedMouthImage from "../../../assets/images/comic-profile-head-closed-mouth.png";
import profileClosedMouthDepthImage from "../../../assets/images/comic-profile-head-closed-mouth-depth.png";
import profileClosedMouthBlinkImage from "../../../assets/images/comic-profile-head-closed-mouth-blink.png";
import profileClosedMouthBlinkDepthImage from "../../../assets/images/comic-profile-head-closed-mouth-blink-depth.png";
import { getImage } from "astro:assets";
import DepthPortrait, { type FacialExpression } from "../../DepthPortrait.astro";

interface Props {
  class?: string;
  intensity?: number;
  maxTilt?: number;
  trackMouse?: boolean;
  vignette?: boolean;
  idleAnimation?: boolean;
  alt?: string;
  title?: string;
}

const {
  class: className = "",
  intensity = 0.08,
  maxTilt = 5,
  trackMouse = false,
  vignette = false,
  idleAnimation = true,
  alt = "Dr. Georg Hackenberg - Interaktives 3D Porträt",
  title = "Dr. Georg Hackenberg"
} = Astro.props;

const optimizedProfile = await getImage({ src: profileImage, format: "webp", width: 800, quality: 95 });
const optimizedDepth = await getImage({ src: profileDepthImage, format: "png", width: 800 });
const optimizedWink = await getImage({ src: profileWinkImage, format: "webp", width: 800, quality: 95 });
const optimizedWinkDepth = await getImage({ src: profileWinkDepthImage, format: "png", width: 800 });
const optimizedBlink = await getImage({ src: profileBlinkImage, format: "webp", width: 800, quality: 95 });
const optimizedBlinkDepth = await getImage({ src: profileBlinkDepthImage, format: "png", width: 800 });
const optimizedClosedMouth = await getImage({ src: profileClosedMouthImage, format: "webp", width: 800, quality: 95 });
const optimizedClosedMouthDepth = await getImage({ src: profileClosedMouthDepthImage, format: "png", width: 800 });
const optimizedClosedMouthBlink = await getImage({ src: profileClosedMouthBlinkImage, format: "webp", width: 800, quality: 95 });
const optimizedClosedMouthBlinkDepth = await getImage({ src: profileClosedMouthBlinkDepthImage, format: "png", width: 800 });

const faceExpressions: FacialExpression[] = [
  {
    id: "default",
    imageSrc: optimizedProfile.src,
    depthSrc: optimizedDepth.src,
    durationRange: [3000, 6000],
    transitionDuration: 180,
    transitions: [
      { targetId: "wink", weight: 25 },
      { targetId: "blink", weight: 35 },
      { targetId: "closed_mouth", weight: 40 }
    ]
  },
  {
    id: "wink",
    imageSrc: optimizedWink.src,
    depthSrc: optimizedWinkDepth.src,
    durationRange: [250, 380],
    transitionDuration: 120,
    transitions: [
      { targetId: "default", weight: 65 },
      { targetId: "closed_mouth", weight: 35 }
    ]
  },
  {
    id: "blink",
    imageSrc: optimizedBlink.src,
    depthSrc: optimizedBlinkDepth.src,
    durationRange: [180, 280],
    transitionDuration: 100,
    transitions: [
      { targetId: "default", weight: 70 },
      { targetId: "closed_mouth", weight: 30 }
    ]
  },
  {
    id: "closed_mouth",
    imageSrc: optimizedClosedMouth.src,
    depthSrc: optimizedClosedMouthDepth.src,
    durationRange: [2500, 5000],
    transitionDuration: 200,
    transitions: [
      { targetId: "closed_mouth_blink", weight: 40 },
      { targetId: "default", weight: 35 },
      { targetId: "blink", weight: 15 },
      { targetId: "wink", weight: 10 }
    ]
  },
  {
    id: "closed_mouth_blink",
    imageSrc: optimizedClosedMouthBlink.src,
    depthSrc: optimizedClosedMouthBlinkDepth.src,
    durationRange: [180, 280],
    transitionDuration: 100,
    transitions: [
      { targetId: "closed_mouth", weight: 75 },
      { targetId: "default", weight: 25 }
    ]
  }
];
---

<DepthPortrait
  expressions={faceExpressions}
  imageSrc={optimizedProfile.src}
  depthSrc={optimizedDepth.src}
  alt={alt}
  title={title}
  class={className}
  intensity={intensity}
  maxTilt={maxTilt}
  trackMouse={trackMouse}
  vignette={vignette}
  idleAnimation={idleAnimation}
/>
