---
interface Props {
  cols?: 2 | 3 | 4;
  id?: string;
  cue?: string;
  class?: string;
}

const {
  cols = 2,
  id,
  cue,
  class: className = ""
} = Astro.props;

const colClasses: Record<2 | 3 | 4, string> = {
  2: 'grid-cols-2',
  3: 'grid-cols-3',
  4: 'grid-cols-4'
};

const colClass = colClasses[cols] || 'grid-cols-2';
---

<div
  id={id}
  data-cue={cue}
  class={`card-grid grid ${colClass} ${className}`}
>
  <slot />
</div>

<style>
  .card-grid {
    width: 100%;
    /* Aligned with BulletList spacing between bullet points (independent of --content-scale) */
    gap: var(--slide-space-element, 1rem) !important;
  }
</style>
