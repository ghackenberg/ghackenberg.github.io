---
import { renderSlideCues } from '../../../utils/slide-cues';

export interface BulletItem {
  num?: string | number;
  icon?: string; // 'check' | 'arrow' | 'cross' | emoji
  title?: string;
  desc?: string;
}

interface Props {
  items?: BulletItem[];
  class?: string;
}

const { items = [], class: className = "" } = Astro.props;
---

<ul class={`bullet-list flex flex-col justify-around gap-6 flex-1 my-auto pb-1 ${className}`}>
  {items.map((item, idx) => {
    const isCheck = item.icon === 'check' || item.icon === '✓';
    const isCross = item.icon === 'cross' || item.icon === '✗';
    const hasBadge = item.num !== undefined || item.icon;

    return (
      <li class="flex items-start gap-5">
        {hasBadge && (
          <span
            class={`bullet-badge w-14 h-14 rounded-2xl flex items-center justify-center font-black text-2xl shrink-0 shadow-md ${
              isCheck
                ? 'bullet-badge-check bg-emerald-600 text-white'
                : isCross
                  ? 'bullet-badge-cross bg-rose-600 text-white'
                  : ''
            }`}
          >
            {isCheck ? '✓' : isCross ? '✗' : item.icon === 'arrow' ? '→' : (item.num ?? item.icon)}
          </span>
        )}
        <div class="flex-1 flex flex-col justify-center">
          {item.title && (
            <div class="flex items-center gap-3">
              <strong class="font-extrabold text-slate-100 light:text-slate-900 text-2xl lg:text-3xl leading-snug" set:html={renderSlideCues(item.title)} />
            </div>
          )}
          {item.desc && (
            <p class="text-slate-300 light:text-slate-600 text-xl lg:text-2xl leading-relaxed mt-1 font-normal" set:html={renderSlideCues(item.desc)} />
          )}
          <slot name={`item-${idx}`} />
        </div>
      </li>
    );
  })}
  <slot />
</ul>
