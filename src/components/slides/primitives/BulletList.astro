---
import { renderSlideCues } from '../../../utils/slide-cues';
import SlideIcon, { type SlideIconName } from './SlideIcon.astro';

export interface BulletItem {
  icon: SlideIconName;
  title?: string;
  desc?: string;
}

interface Props {
  items?: BulletItem[];
  class?: string;
}

const { items = [], class: className = "" } = Astro.props;
---

<ul class={`bullet-list flex flex-col justify-around gap-6 flex-1 my-auto pb-1 ${className}`}>
  {items.map((item, idx) => {
    return (
      <li class="flex items-start gap-5">
        <span class="bullet-badge w-14 h-14 rounded-2xl flex items-center justify-center font-black text-2xl shrink-0 shadow-md">
          <SlideIcon name={item.icon} class="w-7 h-7" />
        </span>
        <div class="flex-1 flex flex-col justify-center">
          {item.title && (
            <div class="flex items-center gap-3">
              <strong class="font-extrabold text-slate-100 light:text-slate-900 text-2xl lg:text-3xl leading-snug" set:html={renderSlideCues(item.title)} />
            </div>
          )}
          {item.desc && (
            <p class="text-slate-300 light:text-slate-600 text-xl lg:text-2xl leading-relaxed mt-1 font-normal" set:html={renderSlideCues(item.desc)} />
          )}
          <slot name={`item-${idx}`} />
        </div>
      </li>
    );
  })}
  <slot />
</ul>
