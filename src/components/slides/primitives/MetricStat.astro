---
interface Props {
  value: string | number;
  unit?: string;
  label: string;
  sublabel?: string;
  badge?: string;
  color?: 'blue' | 'teal' | 'green' | 'red' | 'amber';
  cue?: string;
  id?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
  class?: string;
}

const {
  value,
  unit,
  label,
  sublabel,
  badge,
  color = 'blue',
  cue,
  id: explicitId,
  class: className = ""
} = Astro.props;

const elementId = explicitId || cue;

const colorClasses = {
  blue: 'text-blue-500 light:text-blue-600',
  teal: 'text-cyan-400 light:text-cyan-600',
  green: 'text-emerald-400 light:text-emerald-600',
  red: 'text-rose-500 light:text-rose-600',
  amber: 'text-amber-400 light:text-amber-600'
};
---

<div
  id={elementId}
  data-cue={cue}
  class={`metric-stat-card p-8 lg:p-10 rounded-3xl border border-slate-700/80 bg-slate-900/95 light:border-slate-300 light:bg-white shadow-2xl flex flex-col justify-between h-full flex-1 transition-all duration-300 min-h-0 ${className}`}
>
  <div class="flex items-center justify-between mb-4 shrink-0">
    <span class="text-sm uppercase font-mono font-bold tracking-wider text-slate-400 light:text-slate-500">
      Key Metric
    </span>
    {badge && (
      <span class="text-sm uppercase font-mono font-bold tracking-wider px-3.5 py-1 rounded-full bg-blue-500/15 text-blue-400 border border-blue-500/30 light:bg-blue-100 light:text-blue-700 light:border-blue-200">
        {badge}
      </span>
    )}
  </div>

  <!-- Big Number Display -->
  <div class="my-auto py-4 flex-1 flex flex-col justify-center">
    <div class="flex items-baseline gap-2">
      <span class={`text-7xl lg:text-8xl xl:text-9xl font-black tracking-tight ${colorClasses[color]}`}>
        {value}
      </span>
      {unit && (
        <span class="text-4xl lg:text-5xl font-bold text-slate-400 light:text-slate-500">
          {unit}
        </span>
      )}
    </div>

    <h4 class="text-2xl lg:text-3xl font-extrabold text-slate-100 light:text-slate-900 mt-4 tracking-tight leading-snug">
      {label}
    </h4>
  </div>

  {sublabel && (
    <p class="text-slate-300 light:text-slate-600 text-base lg:text-lg border-t border-slate-800/80 light:border-slate-200 pt-4 mt-4 leading-relaxed shrink-0">
      {sublabel}
    </p>
  )}
</div>
