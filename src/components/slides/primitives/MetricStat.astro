---
interface Props {
  value: string | number;
  unit?: string;
  label: string;
  sublabel?: string;
  badge?: string;
  color?: 'blue' | 'teal' | 'green' | 'red' | 'amber';
  size?: 'hero' | 'compact';
  cue?: string;
  id?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
  class?: string;
}

const {
  value,
  unit,
  label,
  sublabel,
  badge,
  color = 'blue',
  size = 'hero',
  cue,
  id: explicitId,
  class: className = ""
} = Astro.props;

const elementId = explicitId || cue;

const colorClasses = {
  blue: 'text-blue-500 light:text-blue-600',
  teal: 'text-cyan-400 light:text-cyan-600',
  green: 'text-emerald-400 light:text-emerald-600',
  red: 'text-rose-500 light:text-rose-600',
  amber: 'text-amber-400 light:text-amber-600'
};
---

<div
  id={elementId}
  data-cue={cue}
  class={`metric-stat-card ${size === 'compact' ? 'p-6 lg:p-7' : 'p-8 lg:p-10'} rounded-3xl border border-slate-700/80 bg-slate-900/95 light:border-slate-300 light:bg-white shadow-2xl flex flex-col justify-between h-full flex-1 transition-all duration-300 min-h-0 ${className}`}
>
  <div class="flex items-center justify-between mb-2 shrink-0">
    <span class="text-sm lg:text-base uppercase font-mono font-bold tracking-wider text-slate-400 light:text-slate-500">
      Key Metric
    </span>
    {badge && (
      <span class="text-xs lg:text-sm uppercase font-mono font-bold tracking-wider px-3 py-1 rounded-full bg-blue-500/15 text-blue-400 border border-blue-500/30 light:bg-blue-100 light:text-blue-700 light:border-blue-200">
        {badge}
      </span>
    )}
  </div>

  <!-- Big Number Display -->
  <div class="my-auto py-2 flex-1 flex flex-col justify-center">
    <div class="flex items-baseline gap-2">
      <span class={`${size === 'compact' ? 'text-6xl lg:text-7xl xl:text-8xl' : 'text-8xl lg:text-9xl xl:text-[140px]'} font-black tracking-tight ${colorClasses[color]}`}>
        {value}
      </span>
      {unit && (
        <span class={`${size === 'compact' ? 'text-4xl lg:text-5xl' : 'text-5xl lg:text-6xl'} font-bold text-slate-400 light:text-slate-500`}>
          {unit}
        </span>
      )}
    </div>

    <h4 class={`${size === 'compact' ? 'text-2xl lg:text-3xl mt-2' : 'text-3xl lg:text-4xl mt-4'} font-extrabold text-slate-100 light:text-slate-900 tracking-tight leading-snug`}>
      {label}
    </h4>
  </div>

  {sublabel && (
    <p class={`text-slate-300 light:text-slate-600 ${size === 'compact' ? 'text-base lg:text-lg pt-3 mt-2' : 'text-xl lg:text-2xl pt-5 mt-4'} border-t border-slate-800/80 light:border-slate-200 leading-relaxed shrink-0`}>
      {sublabel}
    </p>
  )}
</div>
