---
import { renderSlideCues } from '@commons/shared/slide-cues';

interface Props {
  value: string | number;
  unit?: string;
  label: string;
  sublabel?: string;
  cue?: string;
  id?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
  class?: string;
}

const {
  value,
  unit,
  label,
  sublabel,
  cue,
  id: explicitId,
  class: className = ""
} = Astro.props;

const elementId = explicitId;
---

<div
  id={elementId}
  data-cue={cue}
  class={`metric-stat-card rounded-3xl border bg-[var(--color-slide-card-bg)] shadow-2xl flex flex-col justify-between h-full flex-1 transition-all duration-300 min-h-0 ${className}`}
>
  <div class="flex items-center justify-between mb-2 shrink-0">
    <span class="text-sm lg:text-base uppercase font-mono font-bold tracking-wider text-[var(--color-slide-text-subtle)]">
      Key Metric
    </span>
  </div>

  <!-- Big Number Display -->
  <div class="my-auto py-2 flex-1 flex flex-col justify-center">
    <div class="flex items-baseline gap-2">
      <span class="metric-stat-value font-black tracking-tight">
        {value}
      </span>
      {unit && (
        <span class="metric-stat-unit font-bold text-[var(--color-slide-text-subtle)]">
          {unit}
        </span>
      )}
    </div>

    <h4 class="metric-stat-label font-extrabold text-[var(--color-slide-text)] tracking-tight leading-snug">
      {label}
    </h4>
  </div>

  {sublabel && (
    <p class="metric-stat-sublabel text-[var(--color-slide-text-subtle)] pt-4 mt-4 border-t border-[var(--color-slide-card-border)] leading-relaxed shrink-0" set:html={renderSlideCues(sublabel)} />
  )}
</div>

<style>
  .metric-stat-card {
    --effective-accent: var(--card-accent, var(--slide-accent, var(--color-slide-accent-blue)));
    --hl-color: var(--effective-accent);
    --hl-text-dark: color-mix(in srgb, var(--hl-color) 35%, white);
    --hl-text-light: var(--hl-color);
    border-color: color-mix(in srgb, var(--effective-accent) 30%, var(--color-slide-card-border));
    padding: var(--slide-space-card, 2rem) !important;
  }
  .metric-stat-card .metric-stat-value {
    color: var(--effective-accent);
    font-size: calc(7rem * var(--content-scale, 1)) !important;
    line-height: 1 !important;
  }
  .metric-stat-card .metric-stat-unit {
    font-size: calc(3.5rem * var(--content-scale, 1)) !important;
  }
  .metric-stat-card .metric-stat-label {
    font-size: calc(2.25rem * var(--content-scale, 1)) !important;
    line-height: 1.25 !important;
    margin-top: var(--slide-space-element, 1rem);
  }
  .metric-stat-card .metric-stat-sublabel {
    font-size: calc(1.35rem * var(--content-scale, 1)) !important;
    line-height: 1.5 !important;
  }
  .metric-stat-card :global(mark),
  .metric-stat-card :global(.highlight-marker) {
    --hl-color: var(--effective-accent) !important;
    --hl-text-dark: color-mix(in srgb, var(--effective-accent) 35%, white) !important;
    --hl-text-light: var(--effective-accent) !important;
  }
</style>
