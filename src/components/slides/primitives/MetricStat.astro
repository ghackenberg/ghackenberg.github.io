---
interface Props {
  x: number;
  y: number;
  width: number;
  height: number;
  value: string | number;
  unit?: string;
  label: string;
  sublabel?: string;
  badge?: string;
  color?: 'blue' | 'teal' | 'green' | 'red';
  id?: string;
  class?: string;
}

const {
  x,
  y,
  width,
  height,
  value,
  unit,
  label,
  sublabel,
  badge,
  color = 'blue',
  id,
  class: className = ""
} = Astro.props;

const colorClasses = {
  blue: 'text-blue-600',
  teal: 'text-cyan-600',
  green: 'text-emerald-600',
  red: 'text-rose-600'
};
---

<foreignObject
  id={id}
  x={x}
  y={y}
  width={width}
  height={height}
  class={`metric-stat-container overflow-visible ${className}`}
>
  <div class="w-full h-full p-10 rounded-2xl border border-slate-800/90 bg-slate-900/90 light:border-slate-200/80 light:bg-white/95 shadow-sm flex flex-col justify-between">
    <div class="flex items-center justify-between">
      <span class="text-sm uppercase font-bold tracking-wider text-slate-400 light:text-slate-500">
        Key Metric
      </span>
      {badge && (
        <span class="text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full bg-blue-950 text-blue-300 border border-blue-800/60 light:bg-blue-50 light:text-blue-700 light:border-blue-200">
          {badge}
        </span>
      )}
    </div>

    <!-- Big Number Display -->
    <div class="my-auto">
      <div class="flex items-baseline gap-1">
        <span class={`text-8xl font-black tracking-tighter ${colorClasses[color]}`}>
          {value}
        </span>
        {unit && (
          <span class="text-5xl font-bold text-slate-400 light:text-slate-500">
            {unit}
          </span>
        )}
      </div>

      <h4 class="text-2xl font-bold text-slate-100 light:text-slate-900 mt-2 tracking-tight">
        {label}
      </h4>
    </div>

    {sublabel && (
      <p class="text-slate-400 light:text-slate-500 text-sm border-t border-slate-800/80 light:border-slate-100 pt-3">
        {sublabel}
      </p>
    )}
  </div>
</foreignObject>
