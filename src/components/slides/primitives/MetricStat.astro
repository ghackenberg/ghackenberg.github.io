---
import { renderSlideCues } from '@commons/shared/slide-cues';

interface Props {
  value: string | number;
  unit?: string;
  label: string;
  sublabel?: string;
  size?: 'hero' | 'compact';
  cue?: string;
  id?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
  class?: string;
}

const {
  value,
  unit,
  label,
  sublabel,
  size = 'hero',
  cue,
  id: explicitId,
  class: className = ""
} = Astro.props;

const elementId = explicitId;
---

<div
  id={elementId}
  data-cue={cue}
  class={`metric-stat-card ${size === 'compact' ? 'p-6 lg:p-7' : 'p-8 lg:p-10'} rounded-3xl border bg-[var(--color-slide-card-bg)] shadow-2xl flex flex-col justify-between h-full flex-1 transition-all duration-300 min-h-0 ${className}`}
>
  <div class="flex items-center justify-between mb-2 shrink-0">
    <span class="text-sm lg:text-base uppercase font-mono font-bold tracking-wider text-[var(--color-slide-text-subtle)]">
      Key Metric
    </span>
  </div>

  <!-- Big Number Display -->
  <div class="my-auto py-2 flex-1 flex flex-col justify-center">
    <div class="flex items-baseline gap-2">
      <span class={`metric-stat-value ${size === 'compact' ? 'text-6xl lg:text-7xl xl:text-8xl' : 'text-8xl lg:text-9xl xl:text-[140px]'} font-black tracking-tight`}>
        {value}
      </span>
      {unit && (
        <span class={`${size === 'compact' ? 'text-4xl lg:text-5xl' : 'text-5xl lg:text-6xl'} font-bold text-[var(--color-slide-text-subtle)]`}>
          {unit}
        </span>
      )}
    </div>

    <h4 class={`${size === 'compact' ? 'text-2xl lg:text-3xl mt-2' : 'text-3xl lg:text-4xl mt-4'} font-extrabold text-[var(--color-slide-text)] tracking-tight leading-snug`}>
      {label}
    </h4>
  </div>

  {sublabel && (
    <p class={`text-[var(--color-slide-text-subtle)] ${size === 'compact' ? 'text-base lg:text-lg pt-3 mt-2' : 'text-xl lg:text-2xl pt-5 mt-4'} border-t border-[var(--color-slide-card-border)] leading-relaxed shrink-0`} set:html={renderSlideCues(sublabel)} />
  )}
</div>

<style>
  .metric-stat-card {
    --effective-accent: var(--card-accent, var(--slide-accent, var(--color-slide-accent-blue)));
    --hl-color: var(--effective-accent);
    --hl-text-dark: color-mix(in srgb, var(--hl-color) 35%, white);
    --hl-text-light: var(--hl-color);
    border-color: color-mix(in srgb, var(--effective-accent) 30%, var(--color-slide-card-border));
  }
  .metric-stat-card .metric-stat-value {
    color: var(--effective-accent);
  }
  .metric-stat-card :global(mark),
  .metric-stat-card :global(.highlight-marker) {
    --hl-color: var(--effective-accent) !important;
    --hl-text-dark: color-mix(in srgb, var(--effective-accent) 35%, white) !important;
    --hl-text-light: var(--effective-accent) !important;
  }
</style>
