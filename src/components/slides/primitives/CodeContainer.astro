---
interface Props {
  x: number;
  y: number;
  width: number;
  height: number;
  filename?: string;
  badge?: string;
  id?: string;
  class?: string;
}

const {
  x,
  y,
  width,
  height,
  filename = "schema.jsonld",
  badge = "JSON-LD 1.1",
  id,
  class: className = ""
} = Astro.props;
---

<foreignObject
  id={id}
  x={x}
  y={y}
  width={width}
  height={height}
  class={`code-container-object overflow-visible ${className}`}
>
  <div class="w-full h-full rounded-2xl border border-slate-200/90 bg-slate-900 text-slate-100 shadow-xl overflow-hidden flex flex-col font-mono">
    <!-- Editor Top Bar -->
    <div class="px-6 py-4 bg-slate-950 border-b border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
        <span class="text-xs text-slate-400 ml-4 font-sans font-semibold tracking-wide">
          {filename}
        </span>
      </div>
      <span class="text-xs px-2.5 py-0.5 rounded bg-blue-900/60 text-blue-300 border border-blue-700/50 font-sans font-bold">
        {badge}
      </span>
    </div>

    <!-- Code Content Area -->
    <div class="p-8 flex-1 overflow-auto text-base leading-relaxed font-mono">
      <slot />
    </div>
  </div>
</foreignObject>
