---
interface Props {
  filename?: string;
  badge?: string;
  cue?: string;
  id?: string;
  class?: string;
}

const {
  filename = "schema.jsonld",
  badge = "JSON-LD 1.1",
  cue,
  id: explicitId,
  class: className = ""
} = Astro.props;

const elementId = explicitId || cue;
---

<div
  id={elementId}
  data-cue={cue}
  class={`code-container-root code-container-card w-full h-full rounded-3xl border border-slate-700/80 bg-slate-900 text-slate-100 shadow-2xl overflow-hidden flex flex-col font-mono min-h-0 ${className}`}
>
  <!-- Editor Top Bar -->
  <div class="px-8 py-4 bg-slate-950/90 border-b border-slate-800 flex items-center justify-between shrink-0">
    <div class="flex items-center gap-2.5">
      <span class="w-3.5 h-3.5 rounded-full bg-rose-500 inline-block"></span>
      <span class="w-3.5 h-3.5 rounded-full bg-amber-500 inline-block"></span>
      <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 inline-block"></span>
      <span class="text-sm text-slate-400 ml-4 font-sans font-semibold tracking-wide">
        {filename}
      </span>
    </div>
    <span class="text-sm px-3 py-1 rounded-full bg-blue-900/60 text-blue-300 border border-blue-700/50 font-sans font-bold">
      {badge}
    </span>
  </div>

  <!-- Code Content Area -->
  <div class="code-scroll-area p-6 lg:p-7 flex-1 overflow-hidden font-mono min-h-0 flex flex-col justify-center">
    <slot />
  </div>
</div>

<style>
  .code-container-root {
    --scale: var(--content-scale, 1);
  }
  .code-container-root :global(pre) {
    font-size: calc(19px * var(--content-scale, 1)) !important;
    line-height: 1.38 !important;
    margin: auto 0 !important;
  }
  .code-container-root :global(code) {
    font-size: inherit !important;
    line-height: inherit !important;
  }
</style>
