---
interface Props {
  x: number;
  y: number;
  width: number;
  height: number;
  id?: string;
  title?: string;
  class?: string;
}

const {
  x,
  y,
  width,
  height,
  id,
  title,
  class: className = ""
} = Astro.props;
---

<foreignObject
  id={id}
  x={x}
  y={y}
  width={width}
  height={height}
  class={`bento-card-object overflow-visible ${className}`}
>
  <div
    class="bento-box-inner w-full h-full p-8 rounded-2xl border shadow-sm flex flex-col justify-between backdrop-blur-xs transition-all duration-300"
  >
    {title && (
      <div class="flex items-center justify-between gap-4 mb-4 border-b border-slate-800/70 light:border-slate-100 pb-3">
        <h3 class="text-2xl font-bold text-slate-100 light:text-slate-900 tracking-tight font-sans">
          {title}
        </h3>
      </div>
    )}

    <div class="flex-1 flex flex-col justify-center text-slate-300 light:text-slate-600 text-lg leading-relaxed">
      <slot />
    </div>
  </div>
</foreignObject>

<style>
  .bento-box-inner {
    --resolved-box-accent: var(--card-accent, var(--slide-accent, var(--color-slide-accent-blue)));
    --card-accent: var(--resolved-box-accent);
    --hl-color: var(--resolved-box-accent);
    --hl-text-dark: color-mix(in srgb, var(--hl-color) 35%, white);
    --hl-text-light: var(--hl-color);
    border-color: color-mix(in srgb, var(--resolved-box-accent) 35%, var(--color-slide-card-border));
    background-color: color-mix(in srgb, var(--resolved-box-accent) 8%, var(--color-slide-card-bg));
    color: var(--color-slide-text);
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.08);
  }
</style>
