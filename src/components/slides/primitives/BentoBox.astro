---
interface Props {
  x: number;
  y: number;
  width: number;
  height: number;
  id?: string;
  title?: string;
  accent?: 'blue' | 'teal' | 'indigo' | 'green' | 'amber' | 'neutral';
  class?: string;
}

const {
  x,
  y,
  width,
  height,
  id,
  title,
  accent = 'neutral',
  class: className = ""
} = Astro.props;

const borderStyles = {
  blue: 'border-blue-900/60 bg-blue-950/40 text-blue-100 light:border-blue-200 light:bg-blue-50/70 light:text-blue-950',
  teal: 'border-cyan-900/60 bg-cyan-950/40 text-cyan-100 light:border-cyan-200 light:bg-cyan-50/70 light:text-cyan-950',
  indigo: 'border-indigo-900/60 bg-indigo-950/40 text-indigo-100 light:border-indigo-200 light:bg-indigo-50/70 light:text-indigo-950',
  green: 'border-emerald-900/60 bg-emerald-950/40 text-emerald-100 light:border-emerald-200 light:bg-emerald-50/70 light:text-emerald-950',
  amber: 'border-amber-900/60 bg-amber-950/40 text-amber-100 light:border-amber-200 light:bg-amber-50/70 light:text-amber-950',
  neutral: 'border-slate-800/90 bg-slate-900/90 text-slate-100 light:border-slate-200/90 light:bg-white/95 light:text-slate-900'
};
---

<foreignObject
  id={id}
  x={x}
  y={y}
  width={width}
  height={height}
  class={`bento-card-object overflow-visible ${className}`}
>
  <div
    class={`w-full h-full p-8 rounded-2xl border shadow-sm flex flex-col justify-between backdrop-blur-xs transition-all duration-300 ${borderStyles[accent]}`}
    style="box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.08);"
  >
    {title && (
      <div class="flex items-center justify-between gap-4 mb-4 border-b border-slate-800/70 light:border-slate-100 pb-3">
        <h3 class="text-2xl font-bold text-slate-100 light:text-slate-900 tracking-tight font-sans">
          {title}
        </h3>
      </div>
    )}

    <div class="flex-1 flex flex-col justify-center text-slate-300 light:text-slate-600 text-lg leading-relaxed">
      <slot />
    </div>
  </div>
</foreignObject>
