---
import { renderSlideCues } from '@commons/shared/slide-cues';
import { resolveAccentName, getCycleAccent, type SlideAccent } from '@commons/shared/accent-system';

export interface TableRow {
  cue?: string;
  id?: string;
  title: string;
  subtitle?: string;
  targetSystem?: string;
  mechanism?: string;
  goal?: string;
}

interface Props {
  id?: string;
  cue?: string;
  columns?: string[];
  rows: TableRow[];
  class?: string;
  accent?: SlideAccent;
}

const {
  id: explicitId,
  cue,
  columns = ["Disziplin", "Zielsystem", "Kernmechanismus", "Nutzerziel & Erfolgsmetrik"],
  rows,
  class: className = "",
  accent: tableAccent
} = Astro.props;

const elementId = explicitId;
const resolvedTableAccent = tableAccent ? resolveAccentName(tableAccent) : undefined;

const accentBars: Record<string, string> = {
  blue: 'bg-[var(--color-slide-accent-blue)]',
  cyan: 'bg-[var(--color-slide-accent-cyan)]',
  indigo: 'bg-[var(--color-slide-accent-indigo)]',
  emerald: 'bg-[var(--color-slide-accent-emerald)]',
  amber: 'bg-[var(--color-slide-accent-amber)]',
  purple: 'bg-[var(--color-slide-accent-purple)]',
  rose: 'bg-[var(--color-slide-accent-rose)]',
  teal: 'bg-[var(--color-slide-accent-teal)]',
  orange: 'bg-[var(--color-slide-accent-orange)]'
};

const accentTitles: Record<string, string> = {
  blue: 'text-[var(--color-slide-accent-blue)]',
  cyan: 'text-[var(--color-slide-accent-cyan)]',
  indigo: 'text-[var(--color-slide-accent-indigo)]',
  emerald: 'text-[var(--color-slide-accent-emerald)]',
  amber: 'text-[var(--color-slide-accent-amber)]',
  purple: 'text-[var(--color-slide-accent-purple)]',
  rose: 'text-[var(--color-slide-accent-rose)]',
  teal: 'text-[var(--color-slide-accent-teal)]',
  orange: 'text-[var(--color-slide-accent-orange)]'
};

function resolveRowAccent(idx: number): string {
  if (resolvedTableAccent) {
    return resolvedTableAccent;
  }
  return getCycleAccent(undefined, idx).name;
}
---

<div
  id={elementId}
  data-cue={cue}
  data-accent={resolvedTableAccent}
  data-autofit
  class={`comparison-table-container w-full h-full flex flex-col justify-between rounded-3xl border border-slate-700/80 bg-slate-900/95 light:border-slate-300 light:bg-white shadow-2xl p-6 lg:p-8 min-h-0 overflow-hidden ${className}`}
>
  <!-- Table Header -->
  <div class="table-header-grid grid grid-cols-12 gap-6 pb-4 border-b-2 border-slate-800 light:border-slate-200 font-mono uppercase text-base lg:text-lg font-bold tracking-wider text-slate-400 light:text-slate-500 shrink-0">
    <div class="col-span-3">{columns[0]}</div>
    <div class="col-span-3">{columns[1]}</div>
    <div class="col-span-3">{columns[2]}</div>
    <div class="col-span-3">{columns[3]}</div>
  </div>

  <!-- Table Rows -->
  <div class="table-rows-container flex-1 flex flex-col justify-between divide-y divide-slate-800/80 light:divide-slate-200 min-h-0">
    {rows.map((row, idx) => {
      const accent = resolveRowAccent(idx);
      const rowId = row.id;
      return (
        <div
          id={rowId}
          data-cue={row.cue}
          data-accent={accent}
          class="table-row-item grid grid-cols-12 gap-6 py-4 items-center flex-1 transition-all duration-300 relative min-h-0"
        >
          <!-- Col 1: Disziplin -->
          <div class="comp-table-cell table-col-discipline col-span-3 flex items-center gap-4 min-w-0" data-cell>
            <div class={`w-2.5 rounded-full shrink-0 table-accent-bar ${accentBars[accent] || accentBars.blue}`}></div>
            <div class="flex flex-col min-w-0">
              <h3 class={`table-row-title text-3xl lg:text-4xl font-black tracking-tight leading-none ${accentTitles[accent] || accentTitles.blue}`} set:html={renderSlideCues(row.title)} />
              {row.subtitle && (
                <span class="table-row-subtitle text-sm lg:text-base text-slate-400 light:text-slate-500 font-medium leading-tight mt-1 truncate" set:html={renderSlideCues(row.subtitle)} />
              )}
            </div>
          </div>

          <!-- Col 2: Zielsystem -->
          <div class="comp-table-cell table-col-target col-span-3 font-semibold text-xl lg:text-2xl text-slate-100 light:text-slate-900 leading-snug" data-cell>
            <slot name={`target-${idx}`}>
              <span set:html={renderSlideCues(row.targetSystem)} />
            </slot>
          </div>

          <!-- Col 3: Kernmechanismus -->
          <div class="comp-table-cell table-col-mechanism col-span-3 text-lg lg:text-xl text-slate-300 light:text-slate-600 leading-relaxed font-normal" data-cell>
            <slot name={`mechanism-${idx}`}>
              <span set:html={renderSlideCues(row.mechanism)} />
            </slot>
          </div>

          <!-- Col 4: Nutzerziel & Erfolgsmetrik -->
          <div class="comp-table-cell table-col-goal col-span-3 text-lg lg:text-xl text-slate-200 light:text-slate-800 leading-relaxed font-normal" data-cell>
            <slot name={`goal-${idx}`}>
              <span set:html={renderSlideCues(row.goal)} />
            </slot>
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  /* Cell-level dynamic auto-fit typography */
  .comp-table-cell {
    --scale: var(--content-scale, 1);
  }
  .comparison-table-container .table-col-discipline {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 1rem !important;
  }
  .comparison-table-container .table-accent-bar {
    flex-shrink: 0 !important;
    height: calc(3.5rem * var(--content-scale, 1));
  }
  .comp-table-cell.table-col-discipline .table-row-title {
    font-size: calc(34px * var(--content-scale, 1)) !important;
    line-height: 1.15 !important;
  }
  .comp-table-cell.table-col-discipline .table-row-subtitle {
    font-size: calc(16px * var(--content-scale, 1)) !important;
  }
  .comp-table-cell.table-col-target {
    font-size: calc(24px * var(--content-scale, 1)) !important;
    line-height: 1.3 !important;
  }
  .comp-table-cell.table-col-mechanism {
    font-size: calc(20px * var(--content-scale, 1)) !important;
    line-height: 1.4 !important;
  }
  .comp-table-cell.table-col-goal {
    font-size: calc(20px * var(--content-scale, 1)) !important;
    line-height: 1.4 !important;
  }

  .comparison-table-container .table-header-grid {
    font-size: calc(1rem * var(--content-scale, 1));
  }
  .comparison-table-container .table-row-item {
    padding-top: calc(1rem * var(--content-scale, 1));
    padding-bottom: calc(1rem * var(--content-scale, 1));
    gap: calc(1.5rem * var(--content-scale, 1));
  }

  /* Ton-in-ton container cascade for comparison table inside [data-accent] cards */
  :global([data-accent="rose"]) .table-row-item .table-accent-bar { background-color: var(--color-slide-accent-rose); }
  :global([data-accent="rose"]) .table-row-item .table-row-title { color: var(--color-slide-accent-rose); }

  :global([data-accent="purple"]) .table-row-item .table-accent-bar { background-color: var(--color-slide-accent-purple); }
  :global([data-accent="purple"]) .table-row-item .table-row-title { color: var(--color-slide-accent-purple); }

  :global([data-accent="indigo"]) .table-row-item .table-accent-bar { background-color: var(--color-slide-accent-indigo); }
  :global([data-accent="indigo"]) .table-row-item .table-row-title { color: var(--color-slide-accent-indigo); }

  :global([data-accent="blue"]) .table-row-item .table-accent-bar { background-color: var(--color-slide-accent-blue); }
  :global([data-accent="blue"]) .table-row-item .table-row-title { color: var(--color-slide-accent-blue); }

  :global([data-accent="cyan"]) .table-row-item .table-accent-bar { background-color: var(--color-slide-accent-cyan); }
  :global([data-accent="cyan"]) .table-row-item .table-row-title { color: var(--color-slide-accent-cyan); }

  :global([data-accent="teal"]) .table-row-item .table-accent-bar { background-color: var(--color-slide-accent-teal); }
  :global([data-accent="teal"]) .table-row-item .table-row-title { color: var(--color-slide-accent-teal); }

  :global([data-accent="emerald"]) .table-row-item .table-accent-bar { background-color: var(--color-slide-accent-emerald); }
  :global([data-accent="emerald"]) .table-row-item .table-row-title { color: var(--color-slide-accent-emerald); }

  :global([data-accent="amber"]) .table-row-item .table-accent-bar { background-color: var(--color-slide-accent-amber); }
  :global([data-accent="amber"]) .table-row-item .table-row-title { color: var(--color-slide-accent-amber); }

  :global([data-accent="orange"]) .table-row-item .table-accent-bar { background-color: var(--color-slide-accent-orange); }
  :global([data-accent="orange"]) .table-row-item .table-row-title { color: var(--color-slide-accent-orange); }
</style>
