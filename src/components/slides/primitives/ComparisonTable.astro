---
export interface TableRow {
  cue?: string;
  id?: string;
  accent?: 'neutral' | 'blue' | 'cyan' | 'indigo' | 'emerald' | 'amber' | 'purple';
  title: string;
  subtitle?: string;
  targetSystem?: string;
  mechanism?: string;
  goal?: string;
}

interface Props {
  columns?: string[];
  rows: TableRow[];
  class?: string;
}

const {
  columns = ["Disziplin", "Zielsystem", "Kernmechanismus", "Nutzerziel & Erfolgsmetrik"],
  rows,
  class: className = ""
} = Astro.props;

const accentBars = {
  neutral: 'bg-slate-500',
  blue: 'bg-blue-500',
  cyan: 'bg-cyan-400',
  indigo: 'bg-indigo-500',
  emerald: 'bg-emerald-500',
  amber: 'bg-amber-500',
  purple: 'bg-purple-500'
};

const accentTitles = {
  neutral: 'text-slate-100 light:text-slate-900',
  blue: 'text-blue-400 light:text-blue-600',
  cyan: 'text-cyan-400 light:text-cyan-600',
  indigo: 'text-indigo-400 light:text-indigo-600',
  emerald: 'text-emerald-400 light:text-emerald-600',
  amber: 'text-amber-400 light:text-amber-600',
  purple: 'text-purple-400 light:text-purple-600'
};
---

<div class={`comparison-table-container w-full h-full flex flex-col justify-between rounded-3xl border border-slate-700/80 bg-slate-900/95 light:border-slate-300 light:bg-white shadow-2xl p-6 lg:p-8 min-h-0 overflow-hidden ${className}`}>
  <!-- Table Header -->
  <div class="grid grid-cols-12 gap-6 pb-4 border-b-2 border-slate-800 light:border-slate-200 font-mono uppercase text-base lg:text-lg font-bold tracking-wider text-slate-400 light:text-slate-500 shrink-0">
    <div class="col-span-3">{columns[0]}</div>
    <div class="col-span-3">{columns[1]}</div>
    <div class="col-span-3">{columns[2]}</div>
    <div class="col-span-3">{columns[3]}</div>
  </div>

  <!-- Table Rows -->
  <div class="flex-1 flex flex-col justify-between divide-y divide-slate-800/80 light:divide-slate-200 min-h-0">
    {rows.map((row, idx) => {
      const accent = row.accent || 'neutral';
      const rowId = row.id || row.cue;
      return (
        <div
          id={rowId}
          data-cue={row.cue}
          class="grid grid-cols-12 gap-6 py-4 items-center flex-1 transition-all duration-300 relative min-h-0"
        >
          <!-- Col 1: Disziplin -->
          <div class="col-span-3 flex items-center gap-4 min-w-0">
            <div class={`w-2.5 h-16 rounded-full shrink-0 ${accentBars[accent]}`}></div>
            <div class="flex flex-col min-w-0">
              <h3 class={`text-3xl lg:text-4xl font-black tracking-tight leading-none ${accentTitles[accent]}`}>
                {row.title}
              </h3>
              {row.subtitle && (
                <span class="text-sm lg:text-base text-slate-400 light:text-slate-500 font-medium leading-tight mt-1 truncate">
                  {row.subtitle}
                </span>
              )}
            </div>
          </div>

          <!-- Col 2: Zielsystem -->
          <div class="col-span-3 font-semibold text-xl lg:text-2xl text-slate-100 light:text-slate-900 leading-snug">
            <slot name={`target-${idx}`}>
              {row.targetSystem}
            </slot>
          </div>

          <!-- Col 3: Kernmechanismus -->
          <div class="col-span-3 text-lg lg:text-xl text-slate-300 light:text-slate-600 leading-relaxed font-normal">
            <slot name={`mechanism-${idx}`}>
              {row.mechanism}
            </slot>
          </div>

          <!-- Col 4: Nutzerziel & Erfolgsmetrik -->
          <div class="col-span-3 text-lg lg:text-xl text-slate-200 light:text-slate-800 leading-relaxed font-normal">
            <slot name={`goal-${idx}`}>
              {row.goal}
            </slot>
          </div>
        </div>
      );
    })}
  </div>
</div>
