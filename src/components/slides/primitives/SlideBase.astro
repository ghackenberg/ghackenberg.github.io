---
import { renderSlideCues } from '@commons/shared/slide-cues';
import { resolveAccentName, getCycleAccent, type SlideAccent } from '@commons/shared/accent-system';

interface Props {
  title?: string;
  subtitle?: string;
  subtitleCue?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  showFooter?: boolean;
  presentationTitle?: string;
  accent?: SlideAccent;
  startAccent?: SlideAccent;
  class?: string;
  isSection?: boolean;
}

const {
  title,
  subtitle,
  subtitleCue = "sub",
  slideNumber,
  totalSlides = 30,
  showFooter = true,
  presentationTitle = "hackenberg.tech",
  accent,
  startAccent,
  class: className = "",
  isSection = false
} = Astro.props;

const activeAccentName = resolveAccentName(startAccent || accent || 'blue');
const nextAccentName = getCycleAccent(activeAccentName, 1).name;

const num = typeof slideNumber === 'string' ? parseInt(slideNumber, 10) : (slideNumber || 1);
const isNotFirstSlide = num > 1 && !isSection;
---

<div
  lang="de"
  data-slide-accent={activeAccentName}
  style={`--slide-accent: var(--color-slide-accent-${activeAccentName});`}
  class={`slide-base-frame relative w-[1920px] h-[1080px] max-w-full max-h-full bg-slate-950 light:bg-slate-50 text-slate-100 light:text-slate-900 flex flex-col justify-between pt-9 px-12 pb-7 select-none font-sans overflow-hidden box-border ${isNotFirstSlide ? 'is-intro-state' : ''} ${className}`}
>
  <!-- Ambient Gradient Glow (Large radius, seamless color blending) -->
  <div class="slide-ambient-glow absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <!-- Top Accent Bar (Harmonic Progression from active accent to next chromatic step) -->
  <div class={`absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[var(--color-slide-accent-${activeAccentName})] to-[var(--color-slide-accent-${nextAccentName})]`}></div>

  <!-- Slide Header -->
  {title && (
    <header class="slide-header relative z-20 mb-5 shrink-0">
      {slideNumber && (
        <div class="slide-number-badge absolute top-1.5 right-0 transition-opacity duration-500">
          <span class="text-xl font-mono text-slate-400 light:text-slate-500 font-bold">
            {String(slideNumber).padStart(2, '0')} / {totalSlides}
          </span>
        </div>
      )}

      <div class="slide-header-content w-fit max-w-[1600px]">
        <h1 class="slide-title text-5xl lg:text-6xl xl:text-[62px] font-black tracking-tight text-slate-100 light:text-slate-900 leading-[1.12]">
          {title}
        </h1>

        {subtitle && (
          <p
            data-cue={subtitleCue}
            data-dim="false"
            class="slide-subtitle text-2xl lg:text-3xl text-slate-300 light:text-slate-600 mt-2 font-normal leading-relaxed"
            set:html={renderSlideCues(subtitle)}
          />
        )}
      </div>
    </header>
  )}

  <!-- Slide Main Stage (Full Vertical Stretch) -->
  <main class="slide-main-stage relative z-10 flex-1 min-h-0 w-full flex flex-col justify-stretch items-stretch transition-all duration-600 ease-[cubic-bezier(0.16,1,0.3,1)]">
    <slot />
  </main>

  <!-- Slide Standardized Footer -->
  {showFooter && (
    <footer class="slide-footer relative z-10 pt-2 mt-2 flex items-center justify-between text-base font-mono text-slate-400 light:text-slate-600 shrink-0 transition-opacity duration-500">
      <div class="flex items-center gap-4">
        <span class="font-bold text-slate-300 light:text-slate-800">Dr. Georg Hackenberg</span>
        <span>•</span>
        <span>FH OÖ Campus Wels</span>
        {presentationTitle && presentationTitle !== "hackenberg.tech" && (
          <>
            <span>•</span>
            <span>{presentationTitle}</span>
          </>
        )}
      </div>
      <div class="flex items-center gap-3">
        <span>https://hackenberg.tech</span>
      </div>
    </footer>
  )}
</div>

<style>
  /* Presentation Slide Typography System (1920x1080 canvas) */
  .slide-base-frame {
    font-size: calc(var(--slide-font-body, 1.75rem) * var(--content-scale, 1));
    line-height: 1.55;
    hyphens: auto;
    -webkit-hyphens: auto;
    hyphenate-limit-chars: 6 3 3;
    -webkit-hyphenate-limit-chars: 6 3 3;
  }

  .slide-base-frame :global(p) {
    font-size: calc(var(--slide-font-body, 1.75rem) * var(--content-scale, 1));
    line-height: 1.55;
    text-wrap: pretty;
  }

  .slide-base-frame :global(.slide-title) {
    font-size: var(--slide-font-title, 3.875rem) !important;
    line-height: 1.12 !important;
  }
  .slide-base-frame :global(.slide-subtitle) {
    font-size: var(--slide-font-card-title, 2.35rem) !important;
    line-height: 1.35 !important;
  }
  .slide-base-frame :global(.slide-number-badge),
  .slide-base-frame :global(.slide-number-badge span) {
    font-size: var(--slide-font-card-title, 2.35rem) !important;
    line-height: 1.2 !important;
  }
  .slide-base-frame :global(.slide-footer),
  .slide-base-frame :global(.slide-footer span) {
    font-size: var(--slide-font-body, 1.75rem) !important;
    line-height: 1.35 !important;
  }

  .slide-base-frame :global(h1),
  .slide-base-frame :global(h2),
  .slide-base-frame :global(h3),
  .slide-base-frame :global(h4),
  .slide-base-frame :global(h5),
  .slide-base-frame :global(h6) {
    text-wrap: balance;
  }

  /* Exclude code, monospace, badges and footers from hyphenation */
  .slide-base-frame :global(pre),
  .slide-base-frame :global(code),
  .slide-base-frame :global(kbd),
  .slide-base-frame :global(samp),
  .slide-base-frame :global([class*="font-mono"]),
  .slide-base-frame :global(.no-hyphens),
  .slide-base-frame :global(footer) {
    hyphens: none;
    -webkit-hyphens: none;
  }

  /* Bullet list presentation defaults */
  .slide-base-frame :global(ul:not([class*="space-y-"])) {
    display: flex;
    flex-direction: column;
    gap: var(--slide-space-block, 2rem);
  }

  .slide-base-frame :global(li) {
    font-size: calc(var(--slide-font-body, 1.75rem) * var(--content-scale, 1));
    line-height: 1.55;
  }

  /* Ambient Background Gradients (Extended radius for seamless, circle-free blending) */
  .slide-ambient-glow {
    background-image: 
      radial-gradient(1500px 1000px at 0% 0%, rgba(37, 99, 235, 0.18) 0%, rgba(37, 99, 235, 0.08) 35%, rgba(37, 99, 235, 0.02) 65%, transparent 85%),
      radial-gradient(1500px 1000px at 100% 100%, rgba(6, 182, 212, 0.16) 0%, rgba(6, 182, 212, 0.07) 35%, rgba(6, 182, 212, 0.02) 65%, transparent 85%);
  }

  :global(.light) .slide-ambient-glow,
  :global(.light:root) .slide-ambient-glow {
    background-image: 
      radial-gradient(1500px 1000px at 0% 0%, rgba(59, 130, 246, 0.12) 0%, rgba(59, 130, 246, 0.05) 35%, rgba(59, 130, 246, 0.015) 65%, transparent 85%),
      radial-gradient(1500px 1000px at 100% 100%, rgba(6, 182, 212, 0.10) 0%, rgba(6, 182, 212, 0.04) 35%, rgba(6, 182, 212, 0.015) 65%, transparent 85%);
  }

  /* German Typography & Hyphenation */
  .slide-hyphens {
    hyphens: auto;
    -webkit-hyphens: auto;
    text-wrap: balance;
  }

  @property --hl-alpha-1 {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 38%;
  }
  @property --hl-alpha-2 {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 48%;
  }

  /* ==========================================================================
     Bullet Badge System (Ton-in-Ton Container-Driven Palette)
     ========================================================================== */

  :global(.bullet-badge) {
    background-color: var(--card-accent, var(--color-gray-800));
    color: var(--color-slide-text);
  }
  :global(.light .bullet-badge) {
    background-color: var(--card-accent, var(--color-gray-200));
    color: var(--color-slide-text);
  }
  :global(.bento-card-root .bullet-badge) {
    background-color: var(--card-accent, var(--color-gray-800));
    color: white;
  }

  /* Ton-in-Ton Bullet Badges per Container Accent (Canonical 9 Accents + Aliases + Numbers) */
  :global([data-accent="rose"] .bullet-badge),
  :global([data-accent="red"] .bullet-badge),
  :global([data-accent="1"] .bullet-badge) {
    background-color: var(--color-slide-accent-rose);
    color: white;
  }
  :global([data-accent="purple"] .bullet-badge),
  :global([data-accent="violet"] .bullet-badge),
  :global([data-accent="2"] .bullet-badge) {
    background-color: var(--color-slide-accent-purple);
    color: white;
  }
  :global([data-accent="indigo"] .bullet-badge),
  :global([data-accent="3"] .bullet-badge) {
    background-color: var(--color-slide-accent-indigo);
    color: white;
  }
  :global([data-accent="blue"] .bullet-badge),
  :global([data-accent="4"] .bullet-badge) {
    background-color: var(--color-slide-accent-blue);
    color: white;
  }
  :global([data-accent="cyan"] .bullet-badge),
  :global([data-accent="5"] .bullet-badge) {
    background-color: var(--color-slide-accent-cyan);
    color: white;
  }
  :global([data-accent="teal"] .bullet-badge),
  :global([data-accent="6"] .bullet-badge) {
    background-color: var(--color-slide-accent-teal);
    color: white;
  }
  :global([data-accent="emerald"] .bullet-badge),
  :global([data-accent="green"] .bullet-badge),
  :global([data-accent="7"] .bullet-badge) {
    background-color: var(--color-slide-accent-emerald);
    color: white;
  }
  :global([data-accent="amber"] .bullet-badge),
  :global([data-accent="yellow"] .bullet-badge),
  :global([data-accent="8"] .bullet-badge) {
    background-color: var(--color-slide-accent-amber);
    color: white;
  }
  :global([data-accent="orange"] .bullet-badge),
  :global([data-accent="9"] .bullet-badge) {
    background-color: var(--color-slide-accent-orange);
    color: white;
  }
  :global([data-accent="neutral"] .bullet-badge) {
    background-color: var(--color-gray-800);
    color: var(--color-slide-text);
  }
  :global(.light [data-accent="neutral"] .bullet-badge) {
    background-color: var(--color-gray-200);
    color: var(--color-slide-text);
  }

  /* ==========================================================================
     Callout Box System (Container-Driven Palette)
     ========================================================================== */

  :global(.callout-box) {
    background-color: var(--color-slide-card-bg);
    border-color: var(--color-slide-card-border);
    color: var(--color-slide-text);
  }
  :global(.light .callout-box) {
    background-color: var(--color-slide-card-bg);
    border-color: var(--color-slide-card-border);
    color: var(--color-slide-text);
  }

  :global([data-accent="rose"] .callout-box),
  :global([data-accent="red"] .callout-box),
  :global([data-accent="1"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-rose) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-slide-accent-rose) 35%, transparent);
    color: color-mix(in srgb, var(--color-slide-accent-rose) 35%, white);
  }
  :global(.light [data-accent="rose"] .callout-box),
  :global(.light [data-accent="red"] .callout-box),
  :global(.light [data-accent="1"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-rose) 6%, white);
    border-color: color-mix(in srgb, var(--color-slide-accent-rose) 25%, transparent);
    color: var(--color-slide-accent-rose);
  }

  :global([data-accent="purple"] .callout-box),
  :global([data-accent="violet"] .callout-box),
  :global([data-accent="2"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-purple) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-slide-accent-purple) 35%, transparent);
    color: color-mix(in srgb, var(--color-slide-accent-purple) 35%, white);
  }
  :global(.light [data-accent="purple"] .callout-box),
  :global(.light [data-accent="violet"] .callout-box),
  :global(.light [data-accent="2"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-purple) 6%, white);
    border-color: color-mix(in srgb, var(--color-slide-accent-purple) 25%, transparent);
    color: var(--color-slide-accent-purple);
  }

  :global([data-accent="indigo"] .callout-box),
  :global([data-accent="3"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-indigo) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-slide-accent-indigo) 35%, transparent);
    color: color-mix(in srgb, var(--color-slide-accent-indigo) 35%, white);
  }
  :global(.light [data-accent="indigo"] .callout-box),
  :global(.light [data-accent="3"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-indigo) 6%, white);
    border-color: color-mix(in srgb, var(--color-slide-accent-indigo) 25%, transparent);
    color: var(--color-slide-accent-indigo);
  }

  :global([data-accent="blue"] .callout-box),
  :global([data-accent="4"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-blue) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-slide-accent-blue) 35%, transparent);
    color: color-mix(in srgb, var(--color-slide-accent-blue) 35%, white);
  }
  :global(.light [data-accent="blue"] .callout-box),
  :global(.light [data-accent="4"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-blue) 6%, white);
    border-color: color-mix(in srgb, var(--color-slide-accent-blue) 25%, transparent);
    color: var(--color-slide-accent-blue);
  }

  :global([data-accent="cyan"] .callout-box),
  :global([data-accent="5"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-cyan) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-slide-accent-cyan) 35%, transparent);
    color: color-mix(in srgb, var(--color-slide-accent-cyan) 35%, white);
  }
  :global(.light [data-accent="cyan"] .callout-box),
  :global(.light [data-accent="5"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-cyan) 6%, white);
    border-color: color-mix(in srgb, var(--color-slide-accent-cyan) 25%, transparent);
    color: var(--color-slide-accent-cyan);
  }

  :global([data-accent="teal"] .callout-box),
  :global([data-accent="6"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-teal) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-slide-accent-teal) 35%, transparent);
    color: color-mix(in srgb, var(--color-slide-accent-teal) 35%, white);
  }
  :global(.light [data-accent="teal"] .callout-box),
  :global(.light [data-accent="6"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-teal) 6%, white);
    border-color: color-mix(in srgb, var(--color-slide-accent-teal) 25%, transparent);
    color: var(--color-slide-accent-teal);
  }

  :global([data-accent="emerald"] .callout-box),
  :global([data-accent="green"] .callout-box),
  :global([data-accent="7"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-emerald) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-slide-accent-emerald) 35%, transparent);
    color: color-mix(in srgb, var(--color-slide-accent-emerald) 35%, white);
  }
  :global(.light [data-accent="emerald"] .callout-box),
  :global(.light [data-accent="green"] .callout-box),
  :global(.light [data-accent="7"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-emerald) 6%, white);
    border-color: color-mix(in srgb, var(--color-slide-accent-emerald) 25%, transparent);
    color: var(--color-slide-accent-emerald);
  }

  :global([data-accent="amber"] .callout-box),
  :global([data-accent="yellow"] .callout-box),
  :global([data-accent="8"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-amber) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-slide-accent-amber) 35%, transparent);
    color: color-mix(in srgb, var(--color-slide-accent-amber) 35%, white);
  }
  :global(.light [data-accent="amber"] .callout-box),
  :global(.light [data-accent="yellow"] .callout-box),
  :global(.light [data-accent="8"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-amber) 6%, white);
    border-color: color-mix(in srgb, var(--color-slide-accent-amber) 25%, transparent);
    color: var(--color-slide-accent-amber);
  }

  :global([data-accent="orange"] .callout-box),
  :global([data-accent="9"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-orange) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-slide-accent-orange) 35%, transparent);
    color: color-mix(in srgb, var(--color-slide-accent-orange) 35%, white);
  }
  :global(.light [data-accent="orange"] .callout-box),
  :global(.light [data-accent="9"] .callout-box) {
    background-color: color-mix(in srgb, var(--color-slide-accent-orange) 6%, white);
    border-color: color-mix(in srgb, var(--color-slide-accent-orange) 25%, transparent);
    color: var(--color-slide-accent-orange);
  }

  :global([data-accent="neutral"] .callout-box) {
    background-color: var(--color-slide-card-bg);
    border-color: var(--color-slide-card-border);
    color: var(--color-slide-text);
  }
  :global(.light [data-accent="neutral"] .callout-box) {
    background-color: var(--color-slide-card-bg);
    border-color: var(--color-slide-card-border);
    color: var(--color-slide-text);
  }

  /* ==========================================================================
     Highlight Marker System (Container-Driven Palette)
     ========================================================================== */

  :global(mark),
  :global(.highlight-marker) {
    --hl-alpha-1: 38%;
    --hl-alpha-2: 48%;
    --hl-color: var(--color-slide-accent-cyan);
    --hl-text-dark: color-mix(in srgb, var(--hl-color) 35%, white);
    --hl-text-light: var(--hl-color);
    background-color: transparent !important;
    color: inherit;
    padding: 0.14em 0.45em;
    margin: 0 -0.05em;
    border-radius: 0.38em !important;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    background-repeat: no-repeat;
    background-image: linear-gradient(120deg, color-mix(in srgb, var(--hl-color) var(--hl-alpha-1), transparent) 0%, color-mix(in srgb, var(--hl-color) var(--hl-alpha-2), transparent) 100%);
    background-size: 100% 100%;
    transition: background-size var(--cue-duration, 0.45s) cubic-bezier(0.16, 1, 0.3, 1),
                --hl-alpha-1 0.45s ease,
                --hl-alpha-2 0.45s ease,
                color 0.45s ease,
                filter 0.45s ease;
    will-change: background-size, color, filter;
  }

  :global(.light mark),
  :global(.light .highlight-marker) {
    --hl-alpha-1: 42%;
    --hl-alpha-2: 48%;
    background-image: linear-gradient(120deg, color-mix(in srgb, var(--hl-color) var(--hl-alpha-1), transparent) 0%, color-mix(in srgb, var(--hl-color) var(--hl-alpha-2), transparent) 100%);
  }

  :global(.slide-subtitle mark),
  :global(.slide-subtitle .highlight-marker) {
    border-radius: 0.4em !important;
    padding: 0.14em 0.5em !important;
    margin: 0 0.05em !important;
    --hl-color: var(--slide-accent, var(--color-slide-accent-cyan));
    --hl-text-dark: color-mix(in srgb, var(--hl-color) 35%, white);
    --hl-text-light: var(--hl-color);
  }

  /* Default Marker Colors */
  :global(mark),
  :global(.highlight-marker) {
    --hl-color: var(--slide-accent, var(--color-slide-accent-cyan));
    --hl-text-dark: color-mix(in srgb, var(--hl-color) 35%, white);
    --hl-text-light: var(--hl-color);
  }

  /* Container-driven Highlight: 1 (Rose / Red) */
  :global([data-accent="rose"] mark),
  :global([data-accent="rose"] .highlight-marker),
  :global([data-accent="red"] mark),
  :global([data-accent="red"] .highlight-marker),
  :global([data-accent="1"] mark),
  :global([data-accent="1"] .highlight-marker) {
    --hl-color: var(--color-slide-accent-rose);
    --hl-text-dark: color-mix(in srgb, var(--color-slide-accent-rose) 35%, white);
    --hl-text-light: var(--color-slide-accent-rose);
  }

  /* Container-driven Highlight: 2 (Purple / Violet) */
  :global([data-accent="purple"] mark),
  :global([data-accent="purple"] .highlight-marker),
  :global([data-accent="violet"] mark),
  :global([data-accent="violet"] .highlight-marker),
  :global([data-accent="2"] mark),
  :global([data-accent="2"] .highlight-marker) {
    --hl-color: var(--color-slide-accent-purple);
    --hl-text-dark: color-mix(in srgb, var(--color-slide-accent-purple) 35%, white);
    --hl-text-light: var(--color-slide-accent-purple);
  }

  /* Container-driven Highlight: 3 (Indigo) */
  :global([data-accent="indigo"] mark),
  :global([data-accent="indigo"] .highlight-marker),
  :global([data-accent="3"] mark),
  :global([data-accent="3"] .highlight-marker) {
    --hl-color: var(--color-slide-accent-indigo);
    --hl-text-dark: color-mix(in srgb, var(--color-slide-accent-indigo) 35%, white);
    --hl-text-light: var(--color-slide-accent-indigo);
  }

  /* Container-driven Highlight: 4 (Blue) */
  :global([data-accent="blue"] mark),
  :global([data-accent="blue"] .highlight-marker),
  :global([data-accent="4"] mark),
  :global([data-accent="4"] .highlight-marker) {
    --hl-color: var(--color-slide-accent-blue);
    --hl-text-dark: color-mix(in srgb, var(--color-slide-accent-blue) 35%, white);
    --hl-text-light: var(--color-slide-accent-blue);
  }

