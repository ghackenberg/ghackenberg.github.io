---
import { renderSlideCues } from '../../../utils/slide-cues';

interface Props {
  title?: string;
  subtitle?: string;
  subtitleCue?: string;
  slideNumber?: string | number;
  totalSlides?: string | number;
  showFooter?: boolean;
  presentationTitle?: string;
  class?: string;
}

const {
  title,
  subtitle,
  subtitleCue = "sub",
  slideNumber,
  totalSlides = 30,
  showFooter = true,
  presentationTitle = "hackenberg.tech",
  class: className = ""
} = Astro.props;

const num = typeof slideNumber === 'string' ? parseInt(slideNumber, 10) : (slideNumber || 1);
const isNotFirstSlide = num > 1;
---

<div
  lang="de"
  class={`slide-base-frame relative w-[1920px] h-[1080px] max-w-full max-h-full bg-slate-950 light:bg-slate-50 text-slate-100 light:text-slate-900 flex flex-col justify-between pt-9 px-12 pb-7 select-none font-sans overflow-hidden box-border ${isNotFirstSlide ? 'is-intro-state' : ''} ${className}`}
>
  <!-- Ambient Gradient Glow (Large radius, seamless color blending) -->
  <div class="slide-ambient-glow absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <!-- Top Accent Bar -->
  <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400"></div>

  <!-- Slide Header -->
  {title && (
    <header class="slide-header relative z-20 mb-5 shrink-0">
      {slideNumber && (
        <div class="slide-number-badge absolute top-1.5 right-0 transition-opacity duration-500">
          <span class="text-xl font-mono text-slate-400 light:text-slate-500 font-bold">
            {String(slideNumber).padStart(2, '0')} / {totalSlides}
          </span>
        </div>
      )}

      <div class="slide-header-content w-fit max-w-[1600px]">
        <h1 class="slide-title text-5xl lg:text-6xl xl:text-[62px] font-black tracking-tight text-slate-100 light:text-slate-900 leading-[1.12]">
          {title}
        </h1>

        {subtitle && (
          <p
            id={subtitleCue}
            data-cue={subtitleCue}
            data-dim="false"
            class="slide-subtitle text-2xl lg:text-3xl text-slate-300 light:text-slate-600 mt-2 font-normal leading-relaxed"
            set:html={renderSlideCues(subtitle)}
          />
        )}
      </div>
    </header>
  )}

  <!-- Slide Main Stage (Full Vertical Stretch) -->
  <main class="slide-main-stage relative z-10 flex-1 min-h-0 w-full flex flex-col justify-stretch items-stretch transition-all duration-600 ease-[cubic-bezier(0.16,1,0.3,1)]">
    <slot />
  </main>

  <!-- Slide Standardized Footer -->
  {showFooter && (
    <footer class="slide-footer relative z-10 pt-2 mt-2 flex items-center justify-between text-base font-mono text-slate-400 light:text-slate-600 shrink-0 transition-opacity duration-500">
      <div class="flex items-center gap-4">
        <span class="font-bold text-slate-300 light:text-slate-800">Dr. Georg Hackenberg</span>
        <span>•</span>
        <span>FH OÖ Campus Wels</span>
        {presentationTitle && presentationTitle !== "hackenberg.tech" && (
          <>
            <span>•</span>
            <span>{presentationTitle}</span>
          </>
        )}
      </div>
      <div class="flex items-center gap-3">
        <span>https://hackenberg.tech</span>
      </div>
    </footer>
  )}
</div>

<style>
  /* Presentation Slide Typography System (1920x1080 canvas) */
  .slide-base-frame {
    font-size: calc(28px * var(--content-scale, 1));
    line-height: 1.55;
    hyphens: auto;
    -webkit-hyphens: auto;
    hyphenate-limit-chars: 6 3 3;
    -webkit-hyphenate-limit-chars: 6 3 3;
  }

  .slide-base-frame :global(p) {
    font-size: calc(28px * var(--content-scale, 1));
    line-height: 1.55;
    text-wrap: pretty;
  }

  .slide-base-frame :global(h1),
  .slide-base-frame :global(h2),
  .slide-base-frame :global(h3),
  .slide-base-frame :global(h4),
  .slide-base-frame :global(h5),
  .slide-base-frame :global(h6) {
    text-wrap: balance;
  }

  /* Exclude code, monospace, badges and footers from hyphenation */
  .slide-base-frame :global(pre),
  .slide-base-frame :global(code),
  .slide-base-frame :global(kbd),
  .slide-base-frame :global(samp),
  .slide-base-frame :global([class*="font-mono"]),
  .slide-base-frame :global(.no-hyphens),
  .slide-base-frame :global(footer) {
    hyphens: none;
    -webkit-hyphens: none;
  }

  /* Enforced minimum floor with adaptive content-scale scaling */
  .slide-base-frame :global(.text-xs),
  .slide-base-frame :global(.text-\[11px\]),
  .slide-base-frame :global(.text-\[10px\]) {
    font-size: calc(21px * var(--content-scale, 1)) !important;
    line-height: 1.4 !important;
  }

  .slide-base-frame :global(.text-sm) {
    font-size: calc(23px * var(--content-scale, 1)) !important;
    line-height: 1.4 !important;
  }

  .slide-base-frame :global(.text-base) {
    font-size: calc(26px * var(--content-scale, 1)) !important;
    line-height: 1.45 !important;
  }

  .slide-base-frame :global(.text-lg) {
    font-size: calc(30px * var(--content-scale, 1)) !important;
    line-height: 1.45 !important;
  }

  .slide-base-frame :global(.text-xl) {
    font-size: calc(34px * var(--content-scale, 1)) !important;
    line-height: 1.4 !important;
  }

  .slide-base-frame :global(.text-2xl) {
    font-size: calc(38px * var(--content-scale, 1)) !important;
    line-height: 1.35 !important;
  }

  .slide-base-frame :global(.text-3xl) {
    font-size: calc(44px * var(--content-scale, 1)) !important;
    line-height: 1.3 !important;
  }

  .slide-base-frame :global(.text-4xl) {
    font-size: calc(52px * var(--content-scale, 1)) !important;
    line-height: 1.25 !important;
  }

  /* Bullet list presentation defaults */
  .slide-base-frame :global(ul:not([class*="space-y-"])) {
    display: flex;
    flex-direction: column;
    gap: calc(1.5rem * var(--content-scale, 1));
  }

  .slide-base-frame :global(li) {
    font-size: calc(28px * var(--content-scale, 1));
    line-height: 1.55;
  }

  /* Ambient Background Gradients (Extended radius for seamless, circle-free blending) */
  .slide-ambient-glow {
    background-image: 
      radial-gradient(1500px 1000px at 0% 0%, rgba(37, 99, 235, 0.18) 0%, rgba(37, 99, 235, 0.08) 35%, rgba(37, 99, 235, 0.02) 65%, transparent 85%),
      radial-gradient(1500px 1000px at 100% 100%, rgba(6, 182, 212, 0.16) 0%, rgba(6, 182, 212, 0.07) 35%, rgba(6, 182, 212, 0.02) 65%, transparent 85%);
  }

  :global(.light) .slide-ambient-glow,
  :global(.light:root) .slide-ambient-glow {
    background-image: 
      radial-gradient(1500px 1000px at 0% 0%, rgba(59, 130, 246, 0.12) 0%, rgba(59, 130, 246, 0.05) 35%, rgba(59, 130, 246, 0.015) 65%, transparent 85%),
      radial-gradient(1500px 1000px at 100% 100%, rgba(6, 182, 212, 0.10) 0%, rgba(6, 182, 212, 0.04) 35%, rgba(6, 182, 212, 0.015) 65%, transparent 85%);
  }

  /* German Typography & Hyphenation */
  .slide-hyphens {
    hyphens: auto;
    -webkit-hyphens: auto;
    text-wrap: balance;
  }

  @property --hl-alpha-1 {
    syntax: '<number>';
    inherits: true;
    initial-value: 0.38;
  }
  @property --hl-alpha-2 {
    syntax: '<number>';
    inherits: true;
    initial-value: 0.48;
  }

  /* ==========================================================================
     Bullet Badge System (Ton-in-Ton Container-Driven Palette)
     ========================================================================== */

  :global(.bullet-badge) {
    background-color: #334155; /* slate-700 */
    color: #f8fafc;
  }
  :global(.light .bullet-badge) {
    background-color: #e2e8f0; /* slate-200 */
    color: #0f172a;
  }

  /* Ton-in-Ton Bullet Badges per Container Accent */
  :global([data-accent="blue"] .bullet-badge) {
    background-color: #2563eb; /* blue-600 */
    color: #ffffff;
  }
  :global(.light [data-accent="blue"] .bullet-badge) {
    background-color: #3b82f6; /* blue-500 */
    color: #ffffff;
  }
  :global([data-accent="cyan"] .bullet-badge),
  :global([data-accent="teal"] .bullet-badge) {
    background-color: #0891b2; /* cyan-600 */
    color: #ffffff;
  }
  :global(.light [data-accent="cyan"] .bullet-badge),
  :global(.light [data-accent="teal"] .bullet-badge) {
    background-color: #06b6d4; /* cyan-500 */
    color: #ffffff;
  }
  :global([data-accent="emerald"] .bullet-badge),
  :global([data-accent="green"] .bullet-badge) {
    background-color: #059669; /* emerald-600 */
    color: #ffffff;
  }
  :global(.light [data-accent="emerald"] .bullet-badge),
  :global(.light [data-accent="green"] .bullet-badge) {
    background-color: #10b981; /* emerald-500 */
    color: #ffffff;
  }
  :global([data-accent="purple"] .bullet-badge) {
    background-color: #9333ea; /* purple-600 */
    color: #ffffff;
  }
  :global(.light [data-accent="purple"] .bullet-badge) {
    background-color: #a855f7; /* purple-500 */
    color: #ffffff;
  }
  :global([data-accent="indigo"] .bullet-badge) {
    background-color: #4f46e5; /* indigo-600 */
    color: #ffffff;
  }
  :global(.light [data-accent="indigo"] .bullet-badge) {
    background-color: #6366f1; /* indigo-500 */
    color: #ffffff;
  }
  :global([data-accent="amber"] .bullet-badge) {
    background-color: #d97706; /* amber-600 */
    color: #ffffff;
  }
  :global(.light [data-accent="amber"] .bullet-badge) {
    background-color: #f59e0b; /* amber-500 */
    color: #ffffff;
  }
  :global([data-accent="neutral"] .bullet-badge) {
    background-color: #334155; /* slate-700 */
    color: #f8fafc;
  }
  :global(.light [data-accent="neutral"] .bullet-badge) {
    background-color: #e2e8f0; /* slate-200 */
    color: #0f172a;
  }

  /* ==========================================================================
     Callout Box System (Container-Driven Palette)
     ========================================================================== */

  :global(.callout-box) {
    background-color: rgba(30, 41, 59, 0.55);
    border-color: rgba(71, 85, 105, 0.45);
    color: #f1f5f9;
  }
  :global(.light .callout-box) {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
    color: #1e293b;
  }

  :global([data-accent="blue"] .callout-box) {
    background-color: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.35);
    color: #bfdbfe;
  }
  :global(.light [data-accent="blue"] .callout-box) {
    background-color: #eff6ff;
    border-color: #bfdbfe;
    color: #1e3a8a;
  }

  :global([data-accent="cyan"] .callout-box),
  :global([data-accent="teal"] .callout-box) {
    background-color: rgba(6, 182, 212, 0.12);
    border-color: rgba(6, 182, 212, 0.35);
    color: #a5f3fc;
  }
  :global(.light [data-accent="cyan"] .callout-box),
  :global(.light [data-accent="teal"] .callout-box) {
    background-color: #ecfeff;
    border-color: #a5f3fc;
    color: #155e75;
  }

  :global([data-accent="emerald"] .callout-box),
  :global([data-accent="green"] .callout-box) {
    background-color: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.35);
    color: #a7f3d0;
  }
  :global(.light [data-accent="emerald"] .callout-box),
  :global(.light [data-accent="green"] .callout-box) {
    background-color: #ecfdf5;
    border-color: #a7f3d0;
    color: #065f46;
  }

  :global([data-accent="purple"] .callout-box) {
    background-color: rgba(168, 85, 247, 0.12);
    border-color: rgba(168, 85, 247, 0.35);
    color: #e9d5ff;
  }
  :global(.light [data-accent="purple"] .callout-box) {
    background-color: #faf5ff;
    border-color: #e9d5ff;
    color: #581c87;
  }

  :global([data-accent="indigo"] .callout-box) {
    background-color: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.35);
    color: #c7d2fe;
  }
  :global(.light [data-accent="indigo"] .callout-box) {
    background-color: #eef2ff;
    border-color: #c7d2fe;
    color: #3730a3;
  }

  :global([data-accent="amber"] .callout-box) {
    background-color: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.35);
    color: #fef08a;
  }
  :global(.light [data-accent="amber"] .callout-box) {
    background-color: #fffbeb;
    border-color: #fde68a;
    color: #78350f;
  }

  :global([data-accent="neutral"] .callout-box) {
    background-color: rgba(30, 41, 59, 0.55);
    border-color: rgba(71, 85, 105, 0.45);
    color: #f1f5f9;
  }
  :global(.light [data-accent="neutral"] .callout-box) {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
    color: #1e293b;
  }

  /* ==========================================================================
     Highlight Marker System (Container-Driven Palette)
     ========================================================================== */

  :global(mark),
  :global(.highlight-marker) {
    --hl-alpha-1: 0.38;
    --hl-alpha-2: 0.48;
    background-color: transparent !important;
    color: inherit;
    padding: 0.14em 0.45em;
    margin: 0 -0.05em;
    border-radius: 0.38em !important;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    background-repeat: no-repeat;
    background-image: linear-gradient(120deg, rgba(var(--hl-glow-rgb, 245, 158, 11), var(--hl-alpha-1)) 0%, rgba(var(--hl-glow-rgb-2, var(--hl-glow-rgb, 251, 191, 36)), var(--hl-alpha-2)) 100%);
    background-size: 100% 100%;
    transition: background-size var(--cue-duration, 0.45s) cubic-bezier(0.16, 1, 0.3, 1),
                --hl-alpha-1 0.45s ease,
                --hl-alpha-2 0.45s ease,
                color 0.45s ease,
                filter 0.45s ease;
    will-change: background-size, color, filter;
  }

  :global(.light mark),
  :global(.light .highlight-marker) {
    --hl-alpha-1: 0.42;
    --hl-alpha-2: 0.48;
    background-image: linear-gradient(120deg, rgba(var(--hl-glow-rgb-2, var(--hl-glow-rgb, 251, 191, 36)), var(--hl-alpha-1)) 0%, rgba(var(--hl-glow-rgb, 245, 158, 11), var(--hl-alpha-2)) 100%);
  }

  :global(.slide-subtitle mark),
  :global(.slide-subtitle .highlight-marker) {
    border-radius: 0.4em !important;
    padding: 0.14em 0.5em !important;
    margin: 0 0.05em !important;
    --hl-glow-rgb: 6, 182, 212;
    --hl-glow-rgb-2: 34, 211, 238;
    --hl-text-dark: #a5f3fc;
    --hl-text-light: #0e7490;
  }

  /* Default Marker Colors (Cyan) */
  :global(mark),
  :global(.highlight-marker) {
    --hl-glow-rgb: 6, 182, 212;
    --hl-glow-rgb-2: 34, 211, 238;
    --hl-text-dark: #a5f3fc;
    --hl-text-light: #0e7490;
  }

  /* Container-driven Highlight: Blue */
  :global([data-accent="blue"] mark),
  :global([data-accent="blue"] .highlight-marker) {
    --hl-glow-rgb: 59, 130, 246;
    --hl-glow-rgb-2: 96, 165, 250;
    --hl-text-dark: #bfdbfe;
    --hl-text-light: #1e40af;
  }

  /* Container-driven Highlight: Cyan / Teal */
  :global([data-accent="cyan"] mark),
  :global([data-accent="cyan"] .highlight-marker),
  :global([data-accent="teal"] mark),
  :global([data-accent="teal"] .highlight-marker) {
    --hl-glow-rgb: 6, 182, 212;
    --hl-glow-rgb-2: 34, 211, 238;
    --hl-text-dark: #a5f3fc;
    --hl-text-light: #0e7490;
  }

  /* Container-driven Highlight: Emerald / Green */
  :global([data-accent="emerald"] mark),
  :global([data-accent="emerald"] .highlight-marker),
  :global([data-accent="green"] mark),
  :global([data-accent="green"] .highlight-marker) {
    --hl-glow-rgb: 16, 185, 129;
    --hl-glow-rgb-2: 52, 211, 153;
    --hl-text-dark: #a7f3d0;
    --hl-text-light: #065f46;
  }

  /* Container-driven Highlight: Purple */
  :global([data-accent="purple"] mark),
  :global([data-accent="purple"] .highlight-marker) {
    --hl-glow-rgb: 168, 85, 247;
    --hl-glow-rgb-2: 192, 132, 252;
    --hl-text-dark: #e9d5ff;
    --hl-text-light: #581c87;
  }

  /* Container-driven Highlight: Indigo */
  :global([data-accent="indigo"] mark),
  :global([data-accent="indigo"] .highlight-marker) {
    --hl-glow-rgb: 99, 102, 241;
    --hl-glow-rgb-2: 129, 140, 248;
    --hl-text-dark: #c7d2fe;
    --hl-text-light: #3730a3;
  }

  /* Container-driven Highlight: Amber */
  :global([data-accent="amber"] mark),
  :global([data-accent="amber"] .highlight-marker) {
    --hl-glow-rgb: 245, 158, 11;
    --hl-glow-rgb-2: 251, 191, 36;
    --hl-text-dark: #fef08a;
    --hl-text-light: #78350f;
  }

  /* Container-driven Highlight: Neutral (warm classic amber contrast on slate) */
  :global([data-accent="neutral"] mark),
  :global([data-accent="neutral"] .highlight-marker) {
    --hl-glow-rgb: 245, 158, 11;
    --hl-glow-rgb-2: 251, 191, 36;
    --hl-text-dark: #fef08a;
    --hl-text-light: #78350f;
  }

  /* Pre-cue pending state for marker: 0% width (unmarked) */
  :global(mark[data-cue]:not(.is-active)),
  :global(.highlight-marker[data-cue]:not(.is-active)) {
    background-size: 0% 100%;
    filter: drop-shadow(0 0 0px rgba(var(--hl-glow-rgb, 6, 182, 212), 0));
  }

  /* Active Spotlight: Currently spoken highlight (vibrant gradient, glowing text, full brightness) */
  :global(mark.is-active:not(.is-dimmed)),
  :global(.highlight-marker.is-active:not(.is-dimmed)) {
    --hl-alpha-1: 0.38;
    --hl-alpha-2: 0.48;
    background-size: 100% 100% !important;
    color: var(--hl-text-dark) !important;
    filter: drop-shadow(0 0 10px rgba(var(--hl-glow-rgb, 6, 182, 212), 0.45));
    transition: background-size var(--cue-duration, 0.45s) cubic-bezier(0.16, 1, 0.3, 1),
                --hl-alpha-1 0.4s ease,
                --hl-alpha-2 0.4s ease,
                color 0.4s ease,
                filter 0.4s ease;
    will-change: background-size, color, filter;
  }
  :global(.light mark.is-active:not(.is-dimmed)),
  :global(.light .highlight-marker.is-active:not(.is-dimmed)) {
    --hl-alpha-1: 0.42;
    --hl-alpha-2: 0.48;
    color: var(--hl-text-light) !important;
    filter: drop-shadow(0 0 8px rgba(var(--hl-glow-rgb, 6, 182, 212), 0.25));
  }

  /* Settled Spotlight: Inactive/dimmed highlight markers transition smoothly into background */
  :global(.highlight-marker.is-active.is-dimmed),
  :global(mark.is-active.is-dimmed) {
    --hl-alpha-1: 0.13;
    --hl-alpha-2: 0.17;
    background-size: 100% 100% !important;
    color: inherit !important;
    filter: drop-shadow(0 0 0px rgba(var(--hl-glow-rgb, 59, 130, 246), 0)) !important;
    opacity: 1 !important;
    transition: --hl-alpha-1 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                --hl-alpha-2 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.light .highlight-marker.is-active.is-dimmed),
  :global(.light mark.is-active.is-dimmed) {
    --hl-alpha-1: 0.16;
    --hl-alpha-2: 0.20;
    color: inherit !important;
    filter: drop-shadow(0 0 0px rgba(var(--hl-glow-rgb, 59, 130, 246), 0)) !important;
    opacity: 1 !important;
  }

  /* Audio-Sync Dimming of inactive neighbors */
  :global(.is-dimmed:not(mark):not(.highlight-marker)) {
    opacity: 0.35 !important;
    transition: opacity 0.5s ease-out;
  }

  :global(.highlight-marker.is-dimmed),
  :global(mark.is-dimmed) {
    opacity: 1 !important;
  }

  :global(.is-active) {
    opacity: 1 !important;
    transition: opacity 0.4s ease-in, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Slide Title & Subtitle Truncation & Independent Alignment Transitions */
  .slide-title,
  .slide-subtitle {
    width: fit-content;
    max-width: 1600px;
    white-space: nowrap !important;
    text-wrap: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    transform-origin: top left;
    transform: translateX(0);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Stage Intro State (Exact Center Hero Stage before 1st Cue) */
  .slide-header-content {
    transform-origin: top left;
    transform: translateY(0);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.slide-base-frame.is-intro-state) .slide-header-content {
    /* Exact vertical centering: 540px is vertical center; 36px top padding subtracted */
    transform: translateY(calc(540px - 50% - 36px));
  }

  :global(.slide-base-frame.is-intro-state) .slide-title,
  :global(.slide-base-frame.is-intro-state) .slide-subtitle {
    /* Independent horizontal centering: 960px is horizontal center; 48px left padding subtracted */
    transform: translateX(calc(960px - 50% - 48px));
  }

  /* Transition suppression for instantaneous slide-change repositioning */
  :global(.slide-base-frame.no-intro-transition) .slide-header-content,
  :global(.slide-base-frame.no-intro-transition) .slide-title,
  :global(.slide-base-frame.no-intro-transition) .slide-subtitle {
    transition: none !important;
  }

  /* Default in intro state: opacity 1 for title; subtitle opacity managed by cue if cue-driven */
