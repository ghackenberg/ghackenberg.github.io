---
import { renderSlideCues } from '@commons/shared/slide-cues';

interface Props {
  title?: string;
  type?: 'quote' | 'takeaway' | 'statement' | 'warning' | 'info';
  class?: string;
}

const {
  title,
  type = 'takeaway',
  class: className = ""
} = Astro.props;
---

<div
  data-type={type}
  class={`callout-box p-6 lg:p-7 rounded-2xl border shadow-lg flex flex-col gap-2.5 shrink-0 transition-colors duration-300 ${className}`}
>
  {title && (
    <div class="flex items-center gap-3 mb-1">
      <h4 class="font-black text-2xl lg:text-3xl tracking-tight leading-snug" set:html={renderSlideCues(title)} />
    </div>
  )}
  <div class="text-2xl lg:text-[28px] leading-relaxed font-medium">
    <slot />
  </div>
</div>

<style>
  .callout-box {
    --effective-callout-accent: var(--card-accent, var(--slide-accent, var(--color-slide-accent-blue)));
    background-color: color-mix(in srgb, var(--effective-callout-accent) 12%, transparent) !important;
    border-color: color-mix(in srgb, var(--effective-callout-accent) 35%, transparent) !important;
    color: color-mix(in srgb, var(--effective-callout-accent) 35%, white) !important;
    padding: 1.5rem 1.75rem !important;
    gap: 0.65rem !important;
  }
  .callout-box h4 {
    color: var(--effective-callout-accent) !important;
    font-size: calc(1.9rem * var(--content-scale, 1)) !important;
    line-height: 1.3 !important;
  }
  :global(.light) .callout-box {
    background-color: color-mix(in srgb, var(--effective-callout-accent) 6%, white) !important;
    border-color: color-mix(in srgb, var(--effective-callout-accent) 25%, transparent) !important;
    color: var(--effective-callout-accent) !important;
  }
  .callout-box > div:not(.flex) {
    font-size: calc(1.75rem * var(--content-scale, 1)) !important;
    line-height: 1.45 !important;
  }
</style>

