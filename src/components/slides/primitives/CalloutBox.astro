---
interface Props {
  title?: string;
  type?: 'quote' | 'takeaway' | 'statement' | 'warning' | 'info';
  color?: 'blue' | 'cyan' | 'indigo' | 'amber' | 'emerald' | 'purple' | 'neutral';
  cue?: string;
  class?: string;
}

const {
  title,
  type = 'takeaway',
  color = 'blue',
  cue,
  class: className = ""
} = Astro.props;

const colorStyles = {
  blue: 'bg-blue-500/15 light:bg-blue-50 border-blue-500/40 light:border-blue-200 text-blue-300 light:text-blue-900',
  cyan: 'bg-cyan-500/15 light:bg-cyan-50 border-cyan-500/40 light:border-cyan-200 text-cyan-300 light:text-cyan-900',
  indigo: 'bg-indigo-500/15 light:bg-indigo-50 border-indigo-500/40 light:border-indigo-200 text-indigo-300 light:text-indigo-900',
  amber: 'bg-amber-500/15 light:bg-amber-50 border-amber-500/40 light:border-amber-200 text-amber-300 light:text-amber-900',
  emerald: 'bg-emerald-500/15 light:bg-emerald-50 border-emerald-500/40 light:border-emerald-200 text-emerald-300 light:text-emerald-900',
  purple: 'bg-purple-500/15 light:bg-purple-50 border-purple-500/40 light:border-purple-200 text-purple-300 light:text-purple-900',
  neutral: 'bg-slate-900/80 light:bg-slate-100 border-slate-700 light:border-slate-300 text-slate-200 light:text-slate-800'
}[color];
---

<div
  data-cue={cue}
  data-type={type}
  class={`callout-box p-6 lg:p-7 rounded-2xl border shadow-lg flex flex-col gap-2.5 shrink-0 ${colorStyles} ${className}`}
>
  {title && (
    <div class="flex items-center gap-3 mb-1">
      <h4 class="font-black text-2xl lg:text-3xl tracking-tight leading-snug">
        {title}
      </h4>
    </div>
  )}
  <div class="text-2xl lg:text-[28px] leading-relaxed font-medium">
    <slot />
  </div>
</div>
