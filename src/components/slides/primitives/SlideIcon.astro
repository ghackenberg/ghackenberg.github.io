---
export type SlideIconName =
  | 'check'
  | '✓'
  | 'cross'
  | '✗'
  | 'arrow'
  | '→'
  | 'alert'
  | 'warning'
  | 'target'
  | 'trending-down'
  | 'trending-up'
  | 'keyboard'
  | 'document'
  | 'file'
  | 'shield'
  | 'zap'
  | 'cpu'
  | 'database'
  | 'search'
  | 'network'
  | 'code'
  | 'sparkles'
  | 'globe'
  | 'linkedin'
  | 'github';

interface Props {
  name: SlideIconName;
  class?: string;
  size?: number | string;
}

const { name, class: className = "w-7 h-7", size = 24 } = Astro.props;

// Canonical mapping
const normalized = name === '✓' ? 'check' : name === '✗' ? 'cross' : name === '→' ? 'arrow' : name === 'file' ? 'document' : name === 'warning' ? 'alert' : name;
---

{normalized === 'check' && (
  <svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="20 6 9 17 4 12" />
  </svg>
)}

{normalized === 'cross' && (
  <svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="18" y1="6" x2="6" y2="18" />
    <line x1="6" y1="6" x2="18" y2="18" />
  </svg>
)}

{normalized === 'arrow' && (
  <svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="5" y1="12" x2="19" y2="12" />
    <polyline points="12 5 19 12 12 19" />
  </svg>
)}

{normalized === 'alert' && (
  <svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
    <line x1="12" y1="9" x2="12" y2="13" />
    <line x1="12" y1="17" x2="12.01" y2="17" />
  </svg>
)}

{normalized === 'target' && (
  <svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10" />
    <circle cx="12" cy="12" r="6" />
    <circle cx="12" cy="12" r="2" />
  </svg>
)}

{normalized === 'trending-down' && (
  <svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="23 18 13.5 8.5 8.5 13.5 1 6" />
    <polyline points="17 18 23 18 23 12" />
  </svg>
)}

{normalized === 'trending-up' && (
  <svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
    <polyline points="17 6 23 6 23 12" />
  </svg>
)}

{normalized === 'keyboard' && (
  <svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
