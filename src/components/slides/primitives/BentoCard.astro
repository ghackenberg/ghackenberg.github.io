---
interface Props {
  id?: string;
  cue?: string;
  title?: string;
  subtitle?: string;
  accent?: 'blue' | 'emerald' | 'amber' | 'purple' | 'cyan' | 'indigo' | 'neutral';
  density?: 'default' | 'compact';
  animate?: string;
  class?: string;
}

const {
  id: explicitId,
  cue,
  title,
  subtitle,
  accent = 'blue',
  density = 'default',
  animate = 'fade-up',
  class: className = ""
} = Astro.props;

const elementId = explicitId || cue;

// Accent border and glow mappings
const accentStyles = {
  blue: {
    border: 'border-blue-500/30 light:border-blue-300',
    bar: 'bg-blue-500',
    title: 'text-blue-300 light:text-blue-900'
  },
  emerald: {
    border: 'border-emerald-500/30 light:border-emerald-300',
    bar: 'bg-emerald-500',
    title: 'text-emerald-300 light:text-emerald-900'
  },
  amber: {
    border: 'border-amber-500/30 light:border-amber-300',
    bar: 'bg-amber-500',
    title: 'text-amber-300 light:text-amber-900'
  },
  purple: {
    border: 'border-purple-500/30 light:border-purple-300',
    bar: 'bg-purple-500',
    title: 'text-purple-300 light:text-purple-900'
  },
  cyan: {
    border: 'border-cyan-500/30 light:border-cyan-300',
    bar: 'bg-cyan-500',
    title: 'text-cyan-300 light:text-cyan-900'
  },
  indigo: {
    border: 'border-indigo-500/30 light:border-indigo-300',
    bar: 'bg-indigo-500',
    title: 'text-indigo-300 light:text-indigo-900'
  },
  neutral: {
    border: 'border-slate-800 light:border-slate-200',
    bar: 'bg-slate-500',
    title: 'text-slate-200 light:text-slate-800'
  }
}[accent];
---

<div
  id={elementId}
  data-cue={cue}
  data-animate={animate}
  class={`bento-card-root relative ${density === 'compact' ? 'p-6' : 'p-8'} rounded-3xl bg-slate-900/95 light:bg-white/95 backdrop-blur-md border shadow-2xl flex flex-col justify-start overflow-hidden transition-all duration-300 w-full h-full flex-1 ${accentStyles.border} ${className}`}
>
  <!-- Accent Top Glow Line -->
  <div class={`absolute top-0 left-0 right-0 h-2 ${accentStyles.bar}`}></div>

  <!-- Header -->
  {(title || subtitle) && (
    <div class={`${density === 'compact' ? 'mb-3' : 'mb-6'} shrink-0`}>
      {title && (
        <h3 class={`${density === 'compact' ? 'text-2xl lg:text-3xl' : 'text-3xl lg:text-4xl xl:text-[40px]'} font-black tracking-tight leading-tight ${accentStyles.title}`}>
          {title}
        </h3>
      )}

      {subtitle && (
        <p class={`${density === 'compact' ? 'text-lg lg:text-xl' : 'text-xl lg:text-2xl'} text-slate-300 light:text-slate-600 mt-1 font-normal`}>
          {subtitle}
        </p>
      )}
    </div>
  )}

  <!-- Body Content -->
  <div class={`flex-1 min-h-0 text-slate-200 light:text-slate-800 ${density === 'compact' ? 'text-lg lg:text-xl gap-4 pb-1' : 'text-xl lg:text-2xl gap-6 pb-2'} leading-relaxed flex flex-col justify-between bento-hyphens`}>
    <slot />
  </div>
</div>

<style>
  .bento-card-root {
    --scale: var(--content-scale, 1);
  }
  .bento-hyphens {
    hyphens: auto;
    -webkit-hyphens: auto;
    text-wrap: pretty;
  }
  .bento-hyphens :global(ul) {
    display: flex;
    flex-direction: column;
    gap: calc(1.5rem * var(--content-scale, 1));
    justify-content: space-around;
  }
  .bento-hyphens :global(li) {
    font-size: calc(1.75rem * var(--content-scale, 1));
    line-height: 1.55;
  }
  .bento-hyphens :global(p) {
    font-size: calc(1.75rem * var(--content-scale, 1));
    line-height: 1.55;
  }
</style>
