---
import { renderSlideCues } from '@commons/shared/slide-cues';

interface Props {
  id?: string;
  cue?: string;
  title?: string;
  subtitle?: string;
  animate?: string;
  class?: string;
}

const {
  id: explicitId,
  cue,
  title,
  subtitle,
  animate = 'fade-up',
  class: className = ""
} = Astro.props;

const elementId = explicitId;
---

<div
  id={elementId}
  data-cue={cue}
  data-animate={animate}
  class={`bento-card-root relative p-8 rounded-3xl bg-[var(--color-slide-card-bg)] backdrop-blur-md border shadow-2xl flex flex-col justify-start overflow-hidden transition-all duration-300 w-full h-full flex-1 ${className}`}
>
  <!-- Accent Top Glow Line -->
  <div class="bento-top-bar absolute top-0 left-0 right-0 h-2"></div>

  <!-- Header -->
  {(title || subtitle) && (
    <div class="bento-card-header shrink-0">
      {title && (
        <h3 class="text-3xl lg:text-4xl xl:text-[40px] font-black tracking-tight leading-tight" set:html={renderSlideCues(title)} />
      )}

      {subtitle && (
        <p class="bento-card-subtitle text-xl lg:text-2xl text-[var(--color-slide-text-subtle)] font-normal" set:html={renderSlideCues(subtitle)} />
      )}
    </div>
  )}

  <!-- Body Content -->
  <div class="bento-card-body flex-1 min-h-0 text-[var(--color-slide-text)] text-xl lg:text-2xl leading-relaxed flex flex-col justify-start bento-hyphens">
    <slot />
  </div>
</div>

<style>
  .bento-card-root {
    --scale: var(--content-scale, 1);
    --resolved-card-accent: var(--card-accent, var(--slide-accent, var(--color-slide-accent-blue)));
    --hl-color: var(--resolved-card-accent);
    --hl-text-dark: color-mix(in srgb, var(--hl-color) 35%, white);
    --hl-text-light: var(--hl-color);
    border-color: color-mix(in srgb, var(--resolved-card-accent) 30%, transparent);
    padding: var(--slide-space-card, 2rem) !important;
  }
  .bento-card-root .bento-top-bar {
    background-color: var(--resolved-card-accent);
  }
  .bento-card-root .bento-card-header {
    margin-bottom: calc(var(--slide-space-block, 2rem) * var(--content-scale, 1));
  }
  .bento-card-root h3 {
    color: var(--resolved-card-accent);
    font-size: calc(var(--slide-font-card-title, 2.35rem) * var(--content-scale, 1)) !important;
    line-height: 1.25 !important;
  }
  .bento-card-root .bento-card-subtitle {
    font-size: calc(var(--slide-font-meta, 1.35rem) * var(--content-scale, 1)) !important;
    line-height: 1.35 !important;
    margin-top: calc(var(--slide-space-tight, 0.5rem) * var(--content-scale, 1));
  }
  .bento-card-root .bento-card-body {
    gap: calc(var(--slide-space-block, 2rem) * var(--content-scale, 1));
  }
  .bento-card-root :global(mark),
  .bento-card-root :global(.highlight-marker) {
    --hl-color: var(--resolved-card-accent) !important;
    --hl-text-dark: color-mix(in srgb, var(--resolved-card-accent) 35%, white) !important;
    --hl-text-light: var(--resolved-card-accent) !important;
  }
  .bento-card-root :global(.bullet-badge) {
    background-color: var(--resolved-card-accent) !important;
    color: white !important;
  }
  .bento-card-root :global(.callout-box) {
    background-color: color-mix(in srgb, var(--resolved-card-accent) 12%, transparent) !important;
    border-color: color-mix(in srgb, var(--resolved-card-accent) 35%, transparent) !important;
    color: color-mix(in srgb, var(--resolved-card-accent) 35%, white) !important;
  }
  .bento-card-root :global(.callout-box h4) {
    color: var(--resolved-card-accent) !important;
  }
  :global(.light) .bento-card-root :global(.callout-box) {
    background-color: color-mix(in srgb, var(--resolved-card-accent) 6%, white) !important;
    border-color: color-mix(in srgb, var(--resolved-card-accent) 25%, transparent) !important;
    color: var(--resolved-card-accent) !important;
  }
  .bento-hyphens {
    hyphens: auto;
    -webkit-hyphens: auto;
    text-wrap: pretty;
  }
  .bento-hyphens :global(ul) {
    display: flex;
    flex-direction: column;
    gap: calc(var(--slide-space-element, 1rem) * var(--content-scale, 1));
    justify-content: space-around;
  }
  .bento-hyphens :global(li) {
    font-size: calc(var(--slide-font-body, 1.75rem) * var(--content-scale, 1));
    line-height: 1.55;
  }
  .bento-hyphens :global(p) {
    font-size: calc(var(--slide-font-body, 1.75rem) * var(--content-scale, 1));
    line-height: 1.55;
    margin: 0;
  }
  .bento-card-root :global(p:last-child),
  .bento-card-root :global(ul:last-child) {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }
</style>
