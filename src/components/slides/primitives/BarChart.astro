---
import { getCycleAccent, type SlideAccent } from '@commons/shared/accent-system';

export interface BarChartItem {
  label: string;
  value: number;
  formattedValue?: string;
  unit?: string;
  sublabel?: string;
  cue?: string;
  highlightCue?: string;
  highlightColor?: 'amber' | 'cyan' | 'emerald' | 'purple' | 'blue';
  highlightTarget?: 'label' | 'value';
}

interface Props {
  items: BarChartItem[];
  min?: number;
  max?: number;
  unit?: string;
  cue?: string;
  id?: string;
  class?: string;
  startAccent?: SlideAccent;
}

const {
  items = [],
  min: explicitMin,
  max: explicitMax,
  unit = "",
  cue,
  id: explicitId,
  class: className = "",
  startAccent
} = Astro.props;

const elementId = explicitId;

const accentColors: Record<string, { bar: string; text: string }> = {
  blue: { bar: 'bg-[var(--color-slide-accent-blue)]', text: 'text-[var(--color-slide-accent-blue)]' },
  indigo: { bar: 'bg-[var(--color-slide-accent-indigo)]', text: 'text-[var(--color-slide-accent-indigo)]' },
  violet: { bar: 'bg-[var(--color-slide-accent-violet)]', text: 'text-[var(--color-slide-accent-violet)]' },
  purple: { bar: 'bg-[var(--color-slide-accent-purple)]', text: 'text-[var(--color-slide-accent-purple)]' },
  fuchsia: { bar: 'bg-[var(--color-slide-accent-fuchsia)]', text: 'text-[var(--color-slide-accent-fuchsia)]' },
  pink: { bar: 'bg-[var(--color-slide-accent-pink)]', text: 'text-[var(--color-slide-accent-pink)]' },
  rose: { bar: 'bg-[var(--color-slide-accent-rose)]', text: 'text-[var(--color-slide-accent-rose)]' },
  orange: { bar: 'bg-[var(--color-slide-accent-orange)]', text: 'text-[var(--color-slide-accent-orange)]' },
  amber: { bar: 'bg-[var(--color-slide-accent-amber)]', text: 'text-[var(--color-slide-accent-amber)]' },
  // Legacy aliases
  cyan: { bar: 'bg-[var(--color-slide-accent-cyan)]', text: 'text-[var(--color-slide-accent-cyan)]' },
  teal: { bar: 'bg-[var(--color-slide-accent-teal)]', text: 'text-[var(--color-slide-accent-teal)]' },
  emerald: { bar: 'bg-[var(--color-slide-accent-emerald)]', text: 'text-[var(--color-slide-accent-emerald)]' }
};

// Initial SSR Calculation for zero-flash layout
const values = items.map(i => i.value);
const hasNegativeValues = values.some(v => v < 0);

let initialMin = explicitMin !== undefined ? explicitMin : Math.min(0, ...values);
let initialMax = explicitMax !== undefined ? explicitMax : Math.max(0, ...values);

if (hasNegativeValues) {
  initialMin = explicitMin !== undefined ? explicitMin : Math.floor(initialMin * 1.15);
  initialMax = explicitMax !== undefined ? explicitMax : Math.ceil(initialMax * 1.1);
} else {
  initialMin = 0;
  if (explicitMax !== undefined) {
    initialMax = explicitMax;
  } else if (Math.max(...values) > 30 && Math.max(...values) <= 100) {
    initialMax = 100;
  } else {
    initialMax = Math.ceil(initialMax * 1.05);
  }
}

const initialRange = initialMax - initialMin || 1;
const initialZeroPercent = ((0 - initialMin) / initialRange) * 100;
const hasInternalZeroLine = initialZeroPercent > 0.5 && initialZeroPercent < 99.5;

function resolveBarAccent(item: BarChartItem, idx: number): string {
  if (item.value < 0) return 'rose';
  return getCycleAccent(startAccent as SlideAccent, idx).name;
}

function computeSsrBarStyle(value: number) {
  if (value >= 0) {
    const left = initialZeroPercent;
    const width = (value / initialRange) * 100;
    return `left: ${left.toFixed(2)}%; width: ${width.toFixed(2)}%;`;
  } else {
    const width = (Math.abs(value) / initialRange) * 100;
    const left = initialZeroPercent - width;
    return `left: ${left.toFixed(2)}%; width: ${width.toFixed(2)}%;`;
  }
}

function computeSsrBarRounding(value: number) {
  if (!hasInternalZeroLine) {
    return 'rounded-full';
  }
  if (value >= 0) {
    return 'rounded-r-full rounded-l-none';
  } else {
    return 'rounded-l-full rounded-r-none';
  }
}
---

<div
  id={elementId}
  data-cue={cue}
  data-start-accent={startAccent ? String(startAccent) : undefined}
  data-min={explicitMin !== undefined ? explicitMin : ''}
  data-max={explicitMax !== undefined ? explicitMax : ''}
  class={`bar-chart-container flex flex-col justify-start gap-[var(--slide-space-element,1rem)] text-slate-200 light:text-slate-800 w-full select-none ${className}`}
>
  {items.map((item, idx) => {
    const hasCustomAccent = Boolean(item.value < 0);
    const accent = resolveBarAccent(item, idx);
    const colorStyle = accentColors[accent] || accentColors.blue;
    const itemUnit = item.unit || unit;
    const formattedVal = item.formattedValue || (item.value > 0 ? `+${item.value} ${itemUnit}` : `${item.value} ${itemUnit}`).trim();
    const cueId = item.highlightCue || item.cue;
    const isLabelHighlight = cueId && (item.highlightTarget === 'label' || !item.highlightTarget);
    const isValueHighlight = cueId && item.highlightTarget === 'value';

    return (
      <div
        data-value={item.value}
        data-accent={accent}
        data-custom-accent={hasCustomAccent ? "true" : undefined}
        style={`--row-bar-accent: var(--color-slide-accent-${accent});`}
        class="bar-chart-row flex flex-col gap-2 w-full transition-opacity duration-300"
      >
        <!-- Row Header: Label & Formatted Value -->
        <div class="bar-chart-header flex justify-between items-baseline gap-3 text-lg lg:text-xl font-bold w-full">
          <div class="chart-label-text flex items-baseline gap-2 min-w-0 pr-2 whitespace-nowrap">
            {isLabelHighlight ? (
              <mark data-cue={cueId} class="highlight-marker inline-block font-semibold rounded-[0.38em] shrink-0">
                {item.label}
              </mark>
            ) : (
              <span class="chart-main-label shrink-0">{item.label}</span>
            )}
            {item.sublabel && (
              <span class="chart-sublabel-text text-sm text-slate-400 font-normal shrink-0">({item.sublabel})</span>
            )}
          </div>

          <div class={`chart-value-text font-mono text-xl lg:text-2xl font-black shrink-0 whitespace-nowrap ${colorStyle.text}`}>
            {isValueHighlight ? (
              <mark data-cue={cueId} class="highlight-marker inline-block font-semibold rounded-[0.38em]">
                {formattedVal}
              </mark>
            ) : (
              <span>{formattedVal}</span>
            )}
          </div>
        </div>

        <!-- Track & Bar Container -->
        <div class="chart-track-container w-full h-5 bg-slate-800 light:bg-slate-200 rounded-full overflow-hidden p-0.5 relative">
          <!-- Zero Line Marker -->
          <div
            class="chart-zero-line absolute top-0 bottom-0 w-0.5 -translate-x-1/2 bg-slate-400/80 light:bg-slate-500 z-10 pointer-events-none"
            style={`left: ${initialZeroPercent.toFixed(2)}%; display: ${hasInternalZeroLine ? 'block' : 'none'};`}
          ></div>

          <!-- Dynamic Animated Fill Bar -->
          <div
            class={`chart-bar-fill absolute top-0.5 bottom-0.5 transition-all duration-700 ease-out ${computeSsrBarRounding(item.value)} ${colorStyle.bar}`}
            style={computeSsrBarStyle(item.value)}
          ></div>
        </div>
      </div>
    );
  })}
</div>

<script>
  import { getCycleAccent } from '@commons/shared/accent-system';

  function initBarCharts() {
    document.querySelectorAll<HTMLElement>('.bar-chart-container').forEach(container => {
      const minAttr = container.dataset.min;
      const maxAttr = container.dataset.max;
      const rows = Array.from(container.querySelectorAll<HTMLElement>('.bar-chart-row'));
      if (rows.length === 0) return;

      const parentCard = container.closest<HTMLElement>('.bento-card-root');
      const parentAccentEl = container.closest<HTMLElement>('[data-accent]');
      let effectiveStart = container.dataset.startAccent || parentAccentEl?.dataset.accent;
      if (!effectiveStart && parentCard) {
        const style = window.getComputedStyle(parentCard);
        const resolved = style.getPropertyValue('--resolved-card-accent') || style.getPropertyValue('--card-accent');
        const match = resolved.match(/--color-slide-accent-([a-z]+)/);
        if (match) {
          effectiveStart = match[1];
        }
      }

      if (effectiveStart && rows.length > 1) {
        let unaccentedIdx = 0;
        rows.forEach(row => {
          if (row.dataset.customAccent) return;
          const cycle = getCycleAccent(effectiveStart, unaccentedIdx);
          unaccentedIdx++;
          row.style.setProperty('--row-bar-accent', `var(--color-slide-accent-${cycle.name})`);
          const bar = row.querySelector<HTMLElement>('.chart-bar-fill');
          const valueText = row.querySelector<HTMLElement>('.chart-value-text');
          if (bar) {
            bar.style.backgroundColor = `var(--color-slide-accent-${cycle.name})`;
          }
          if (valueText) {
            valueText.style.color = `var(--color-slide-accent-${cycle.name})`;
          }
        });
      }

      const values = rows.map(r => parseFloat(r.dataset.value || '0'));
      const hasNegative = values.some(v => v < 0);

      let min = minAttr !== undefined && minAttr !== '' ? parseFloat(minAttr) : Math.min(0, ...values);
      let max = maxAttr !== undefined && maxAttr !== '' ? parseFloat(maxAttr) : Math.max(0, ...values);

      if (hasNegative) {
        min = minAttr ? parseFloat(minAttr) : Math.floor(min * 1.15);
        max = maxAttr ? parseFloat(maxAttr) : Math.ceil(max * 1.1);
      } else {
        min = 0;
        if (maxAttr) {
          max = parseFloat(maxAttr);
        } else if (Math.max(...values) > 30 && Math.max(...values) <= 100) {
          max = 100;
        } else {
          max = Math.ceil(max * 1.05);
        }
      }

      const range = max - min || 1;
      const zeroPercent = ((0 - min) / range) * 100;
      const hasInternalZero = zeroPercent > 0.5 && zeroPercent < 99.5;

      // Position Zero Line
      const zeroLines = container.querySelectorAll<HTMLElement>('.chart-zero-line');
      zeroLines.forEach(zl => {
        if (hasInternalZero) {
          zl.style.display = 'block';
          zl.style.left = `${zeroPercent}%`;
        } else {
          zl.style.display = 'none';
        }
      });

      // Compute and apply precise bar positions & roundings
      rows.forEach(row => {
        const val = parseFloat(row.dataset.value || '0');
        const bar = row.querySelector<HTMLElement>('.chart-bar-fill');
        if (!bar) return;

        if (hasInternalZero) {
          if (val >= 0) {
            bar.classList.remove('rounded-full', 'rounded-l-full');
            bar.classList.add('rounded-r-full', 'rounded-l-none');
          } else {
            bar.classList.remove('rounded-full', 'rounded-r-full');
            bar.classList.add('rounded-l-full', 'rounded-r-none');
          }
        } else {
          bar.classList.remove('rounded-l-none', 'rounded-r-none', 'rounded-l-full', 'rounded-r-full');
          bar.classList.add('rounded-full');
        }

        if (val >= 0) {
          const left = zeroPercent;
          const width = (val / range) * 100;
          bar.style.left = `${left}%`;
          bar.style.width = `${width}%`;
        } else {
          const width = (Math.abs(val) / range) * 100;
          const left = zeroPercent - width;
          bar.style.left = `${left}%`;
          bar.style.width = `${width}%`;
        }
      });
    });
  }

  // Initialize immediately on DOM load
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initBarCharts();
  } else {
    document.addEventListener('DOMContentLoaded', initBarCharts);
  }

  // Re-run whenever slide changes or viewport resizes
  window.addEventListener('slide:changed', initBarCharts);
  window.addEventListener('resize', initBarCharts);
</script>

<style>
  .bar-chart-container {
    gap: calc(var(--slide-space-element, 1rem) * var(--content-scale, 1)) !important;
  }
  .bar-chart-row {
    gap: calc(var(--slide-space-tight, 0.5rem) * var(--content-scale, 1)) !important;
  }
  .bar-chart-container .chart-label-text {
    font-size: calc(var(--slide-font-body, 1.75rem) * var(--content-scale, 1)) !important;
    line-height: 1.35 !important;
  }
  .bar-chart-container .chart-sublabel-text {
    font-size: calc(var(--slide-font-meta, 1.35rem) * var(--content-scale, 1)) !important;
  }
  .bar-chart-container .chart-value-text {
    font-size: calc(var(--slide-font-heading, 1.90rem) * var(--content-scale, 1)) !important;
    line-height: 1.25 !important;
  }
  .bar-chart-container .chart-track-container {
    height: calc(1.25rem * var(--content-scale, 1)) !important;
  }

  :global(.bento-card-root) .bar-chart-row :global(mark),
  :global(.bento-card-root) .bar-chart-row :global(.highlight-marker),
  .bar-chart-row :global(mark),
  .bar-chart-row :global(.highlight-marker) {
    --hl-color: var(--row-bar-accent) !important;
    --hl-text-dark: color-mix(in srgb, var(--row-bar-accent) 35%, white) !important;
    --hl-text-light: var(--row-bar-accent) !important;
  }

  /* Ton-in-ton container cascade for single-item bar charts or default unaccented items inside [data-accent] cards */
  :global([data-accent="rose"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-rose); }
  :global([data-accent="rose"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-rose); }

  :global([data-accent="purple"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-purple); }
  :global([data-accent="purple"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-purple); }

  :global([data-accent="indigo"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-indigo); }
  :global([data-accent="indigo"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-indigo); }

  :global([data-accent="blue"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-blue); }
  :global([data-accent="blue"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-blue); }

  :global([data-accent="cyan"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-cyan); }
  :global([data-accent="cyan"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-cyan); }

  :global([data-accent="teal"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-teal); }
  :global([data-accent="teal"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-teal); }

  :global([data-accent="emerald"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-emerald); }
  :global([data-accent="emerald"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-emerald); }

  :global([data-accent="amber"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-amber); }
  :global([data-accent="amber"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-amber); }

  :global([data-accent="orange"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-orange); }
  :global([data-accent="orange"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-orange); }
  :global([data-accent="violet"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-violet); }
  :global([data-accent="violet"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-violet); }

  :global([data-accent="fuchsia"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-fuchsia); }
  :global([data-accent="fuchsia"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-fuchsia); }

  :global([data-accent="pink"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-bar-fill { background-color: var(--color-slide-accent-pink); }
  :global([data-accent="pink"]) .bar-chart-container:not([data-start-accent]) .bar-chart-row:not([data-custom-accent]) .chart-value-text { color: var(--color-slide-accent-pink); }
</style>
