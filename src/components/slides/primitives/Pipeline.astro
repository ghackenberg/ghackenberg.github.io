---
interface Step {
  id?: string;
  cue?: string;
  num: string;
  title: string;
  desc?: string;
  badge?: string;
  accent?: 'blue' | 'teal' | 'indigo' | 'green' | 'amber';
}

interface Props {
  steps: Step[];
  id?: string;
  cue?: string;
  direction?: 'horizontal' | 'vertical';
  class?: string;
}

const {
  steps,
  id: explicitId,
  cue,
  direction = steps.length >= 5 ? 'vertical' : 'horizontal',
  class: className = ""
} = Astro.props;

const elementId = explicitId || cue;

const accentPills = {
  blue: 'bg-blue-600 text-white',
  teal: 'bg-cyan-600 text-white',
  indigo: 'bg-indigo-600 text-white',
  green: 'bg-emerald-600 text-white',
  amber: 'bg-amber-600 text-white'
};

const accentBars = {
  blue: 'bg-blue-500',
  teal: 'bg-cyan-400',
  indigo: 'bg-indigo-500',
  green: 'bg-emerald-500',
  amber: 'bg-amber-500'
};
---

{direction === 'vertical' ? (
  <div
    id={elementId}
    data-cue={cue}
    class={`pipeline-container-vertical w-full h-full flex flex-col justify-between gap-4 min-h-0 ${className}`}
  >
    {steps.map((step, idx) => {
      const accent = step.accent || (idx % 2 === 0 ? 'blue' : 'teal');
      const stepId = step.id || step.cue;
      return (
        <div
          id={stepId}
          data-cue={step.cue}
          class="step-row flex-1 p-5 lg:p-6 px-8 rounded-2xl border border-slate-700/80 bg-slate-900/95 light:border-slate-300 light:bg-white shadow-lg flex items-center justify-between gap-8 transition-all duration-300 relative overflow-hidden min-h-0"
        >
          <!-- Left accent line -->
          <div class={`absolute left-0 top-0 bottom-0 w-2.5 ${accentBars[accent]}`}></div>

          <!-- Number badge -->
          <span class={`w-14 h-14 rounded-2xl flex items-center justify-center font-black text-2xl shrink-0 shadow-md ${accentPills[accent]}`}>
            {step.num}
          </span>

          <!-- Center: Title & description -->
          <div class="flex-1 flex flex-col justify-center min-w-0 gap-1">
            <h4 class="text-2xl lg:text-[28px] font-black text-slate-100 light:text-slate-900 tracking-tight leading-snug">
              {step.title}
            </h4>
            {step.desc && (
              <p class="text-slate-300 light:text-slate-600 text-xl lg:text-2xl leading-relaxed font-normal">
                {step.desc}
              </p>
            )}
          </div>

          <!-- Right: Badge -->
          {step.badge && (
            <span class="text-base uppercase font-mono font-bold tracking-wider px-4 py-1.5 rounded-full bg-slate-800 light:bg-slate-100 text-slate-300 light:text-slate-600 border border-slate-700 light:border-slate-200 shrink-0">
              {step.badge}
            </span>
          )}
        </div>
      );
    })}
  </div>
) : (
  <div
    id={elementId}
    data-cue={cue}
    class={`pipeline-container w-full h-full flex items-stretch justify-between gap-5 min-h-0 ${className}`}
  >
    {steps.map((step, idx) => {
      const accent = step.accent || (idx % 2 === 0 ? 'blue' : 'teal');
      const stepId = step.id || step.cue;
      return (
        <div class="flex-1 flex items-stretch h-full min-h-0 min-w-0">
          <!-- Step Card -->
          <div
            id={stepId}
            data-cue={step.cue}
            class="step-card flex-1 h-full p-6 lg:p-8 rounded-3xl border border-slate-700/80 bg-slate-900/95 light:border-slate-300 light:bg-white shadow-2xl flex flex-col justify-between relative transition-all duration-300 min-h-0 min-w-0 overflow-hidden"
          >
            <!-- Top badge row -->
            <div class="flex items-center justify-between gap-3 mb-4 shrink-0">
              <span class={`w-14 h-14 rounded-2xl flex items-center justify-center font-black text-xl shadow-md ${accentPills[accent]}`}>
                {step.num}
              </span>
              {step.badge && (
                <span class="text-base uppercase font-mono font-bold tracking-wider px-4 py-1.5 rounded-full bg-slate-800 light:bg-slate-100 text-slate-300 light:text-slate-600 border border-slate-700 light:border-slate-200">
                  {step.badge}
                </span>
              )}
            </div>

            <!-- Title & description -->
            <div class="flex-1 flex flex-col justify-center my-4 gap-4 min-w-0">
              <h4 class="text-2xl lg:text-3xl font-black text-slate-100 light:text-slate-900 tracking-tight leading-snug">
                {step.title}
              </h4>
              {step.desc && (
                <p class="text-slate-300 light:text-slate-600 text-xl lg:text-2xl leading-relaxed text-pretty font-normal">
                  {step.desc}
                </p>
              )}
            </div>

            <!-- Bottom decorative progress bar -->
            <div class="w-full h-2 rounded-full bg-slate-800 light:bg-slate-100 overflow-hidden mt-4 shrink-0">
              <div class={`h-full rounded-full ${accentBars[accent]}`} style="width: 100%;"></div>
            </div>
          </div>

          <!-- Connector arrow to next step -->
          {idx < steps.length - 1 && (
            <div class="flex items-center justify-center px-2 text-slate-500 light:text-slate-400 font-bold text-2xl select-none shrink-0">
              →
            </div>
          )}
        </div>
      );
    })}
  </div>
)}
