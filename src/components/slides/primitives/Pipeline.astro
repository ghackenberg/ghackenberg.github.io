---
import { renderSlideCues } from '@commons/shared/slide-cues';
import { Image } from 'astro:assets';
import { getCycleAccent, type SlideAccent } from '@commons/shared/accent-system';

interface Step {
  id?: string;
  cue?: string;
  num: string;
  title: string;
  desc?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageTitle?: string;
  graphic?: string;
  placeholderLabel?: string;
}

interface Props {
  steps: Step[];
  id?: string;
  cue?: string;
  direction?: 'horizontal' | 'vertical';
  startAccent?: SlideAccent;
  accent?: SlideAccent;
  class?: string;
}

const {
  steps,
  id: explicitId,
  cue,
  direction = steps.length >= 4 ? 'vertical' : 'horizontal',
  startAccent,
  accent: baseAccent,
  class: className = ""
} = Astro.props;

const elementId = explicitId;

const accentPills: Record<string, string> = {
  rose: 'bg-[var(--color-slide-accent-rose)] text-white',
  red: 'bg-[var(--color-slide-accent-rose)] text-white',
  purple: 'bg-[var(--color-slide-accent-purple)] text-white',
  violet: 'bg-[var(--color-slide-accent-purple)] text-white',
  indigo: 'bg-[var(--color-slide-accent-indigo)] text-white',
  blue: 'bg-[var(--color-slide-accent-blue)] text-white',
  cyan: 'bg-[var(--color-slide-accent-cyan)] text-white',
  teal: 'bg-[var(--color-slide-accent-teal)] text-white',
  emerald: 'bg-[var(--color-slide-accent-emerald)] text-white',
  green: 'bg-[var(--color-slide-accent-emerald)] text-white',
  amber: 'bg-[var(--color-slide-accent-amber)] text-white',
  yellow: 'bg-[var(--color-slide-accent-amber)] text-white',
  orange: 'bg-[var(--color-slide-accent-orange)] text-white'
};

const accentBars: Record<string, string> = {
  rose: 'bg-[var(--color-slide-accent-rose)]',
  red: 'bg-[var(--color-slide-accent-rose)]',
  purple: 'bg-[var(--color-slide-accent-purple)]',
  violet: 'bg-[var(--color-slide-accent-purple)]',
  indigo: 'bg-[var(--color-slide-accent-indigo)]',
  blue: 'bg-[var(--color-slide-accent-blue)]',
  cyan: 'bg-[var(--color-slide-accent-cyan)]',
  teal: 'bg-[var(--color-slide-accent-teal)]',
  emerald: 'bg-[var(--color-slide-accent-emerald)]',
  green: 'bg-[var(--color-slide-accent-emerald)]',
  amber: 'bg-[var(--color-slide-accent-amber)]',
  yellow: 'bg-[var(--color-slide-accent-amber)]',
  orange: 'bg-[var(--color-slide-accent-orange)]'
};

const accentGlass: Record<string, string> = {
  rose: 'bg-[var(--color-slide-accent-rose)]/15 border-[var(--color-slide-accent-rose)]/35 text-[var(--color-slide-accent-rose)]',
  red: 'bg-[var(--color-slide-accent-rose)]/15 border-[var(--color-slide-accent-rose)]/35 text-[var(--color-slide-accent-rose)]',
  purple: 'bg-[var(--color-slide-accent-purple)]/15 border-[var(--color-slide-accent-purple)]/35 text-[var(--color-slide-accent-purple)]',
  violet: 'bg-[var(--color-slide-accent-purple)]/15 border-[var(--color-slide-accent-purple)]/35 text-[var(--color-slide-accent-purple)]',
  indigo: 'bg-[var(--color-slide-accent-indigo)]/15 border-[var(--color-slide-accent-indigo)]/35 text-[var(--color-slide-accent-indigo)]',
  blue: 'bg-[var(--color-slide-accent-blue)]/15 border-[var(--color-slide-accent-blue)]/35 text-[var(--color-slide-accent-blue)]',
  cyan: 'bg-[var(--color-slide-accent-cyan)]/15 border-[var(--color-slide-accent-cyan)]/35 text-[var(--color-slide-accent-cyan)]',
  teal: 'bg-[var(--color-slide-accent-teal)]/15 border-[var(--color-slide-accent-teal)]/35 text-[var(--color-slide-accent-teal)]',
  emerald: 'bg-[var(--color-slide-accent-emerald)]/15 border-[var(--color-slide-accent-emerald)]/35 text-[var(--color-slide-accent-emerald)]',
  green: 'bg-[var(--color-slide-accent-emerald)]/15 border-[var(--color-slide-accent-emerald)]/35 text-[var(--color-slide-accent-emerald)]',
  amber: 'bg-[var(--color-slide-accent-amber)]/15 border-[var(--color-slide-accent-amber)]/35 text-[var(--color-slide-accent-amber)]',
  yellow: 'bg-[var(--color-slide-accent-amber)]/15 border-[var(--color-slide-accent-amber)]/35 text-[var(--color-slide-accent-amber)]',
  orange: 'bg-[var(--color-slide-accent-orange)]/15 border-[var(--color-slide-accent-orange)]/35 text-[var(--color-slide-accent-orange)]'
};

const effectiveStartAccent = startAccent || baseAccent;

function getStepAccent(idx: number): string {
  return getCycleAccent(effectiveStartAccent, idx).name;
}

const hasAnyGraphic = steps.some(s => !!(s.image || s.graphic));

const formatStepNum = (num: string | number) => String(num).replace(/^0+([1-9])/, '$1');
---

{direction === 'vertical' ? (
  <div
    id={elementId}
    data-cue={cue}
    class={`pipeline-container-vertical w-full h-full flex flex-col justify-between gap-3.5 lg:gap-4 min-h-0 ${className}`}
  >
    {steps.map((step, idx) => {
      const accent = getStepAccent(idx);
      const stepId = step.id;
      return (
        <div
          id={stepId}
          data-cue={step.cue}
          data-accent={accent}
          data-autofit
          style={`--step-accent: var(--color-slide-accent-${accent}); --hl-color: var(--color-slide-accent-${accent}); --hl-text-dark: color-mix(in srgb, var(--color-slide-accent-${accent}) 35%, white); --hl-text-light: var(--color-slide-accent-${accent});`}
          class="step-row flex-1 rounded-2xl border border-[var(--color-slide-card-border)] bg-[var(--color-slide-card-bg)] shadow-lg flex items-stretch transition-all duration-300 relative overflow-hidden min-h-0"
        >
          <!-- Integrated Left Glass Block -->
          <div class={`step-num-badge w-20 lg:w-24 shrink-0 flex items-center justify-center font-black text-2xl lg:text-[26px] font-sans border-r ${accentGlass[accent]}`}>
            {formatStepNum(step.num)}
          </div>

          <!-- Center: Title & description -->
          <div class="step-text-container flex-1 flex flex-col justify-center min-w-0 py-3 px-6 lg:px-8 gap-1.5">
            <h4 class="text-2xl lg:text-[28px] font-black text-[var(--color-slide-text)] tracking-tight leading-snug" set:html={renderSlideCues(step.title)} />
            {step.desc && (
              <p class="text-[var(--color-slide-text-subtle)] text-xl lg:text-2xl leading-relaxed font-normal" set:html={renderSlideCues(step.desc)} />
            )}
          </div>

          <!-- Right: Image / Graphic Thumbnail (if provided) -->
          {step.graphic ? (
            <div class="step-image-container shrink-0 h-full aspect-video border-l border-slate-700/80 light:border-slate-200/80 bg-slate-800/40 light:bg-slate-100/70 relative overflow-hidden flex items-center justify-center" set:html={step.graphic} />
          ) : step.image ? (
            <div class="step-image-container shrink-0 h-full aspect-video border-l border-slate-700/80 light:border-slate-200/80 bg-slate-800/40 light:bg-slate-100/70 relative overflow-hidden flex items-center justify-center">
              <!-- Skeleton Shimmer Placeholder -->
              <div
                class="step-image-skeleton absolute inset-0 flex flex-col items-center justify-center gap-2 text-slate-400 light:text-slate-500 bg-slate-800/60 light:bg-slate-200/60 animate-pulse pointer-events-none z-0"
                aria-hidden="true"
              >
                <svg class="w-6 h-6 stroke-current opacity-40 animate-spin" viewBox="0 0 24 24" fill="none">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                </svg>
                <span class="text-[10px] uppercase font-bold tracking-wider opacity-60">Loading illustration...</span>
              </div>

              <Image
                src={step.image}
                alt={step.imageAlt || step.desc || `Illustration für Schritt ${step.num}: ${step.title}`}
                title={step.imageTitle || step.title}
                width={480}
                height={270}
                format="webp"
                class="w-full h-full object-cover select-none transition-opacity duration-300 opacity-0 relative z-10"
                loading="lazy"
                decoding="async"
                onload="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
                onerror="if (this.previousElementSibling) { this.previousElementSibling.textContent = 'Illustration unavailable'; }"
              />
            </div>
          ) : null}
        </div>
      );
    })}
  </div>
) : (
  <div
    id={elementId}
    data-cue={cue}
    class={`pipeline-container w-full h-full flex items-stretch justify-between gap-4 min-h-0 ${className}`}
  >
    {steps.map((step, idx) => {
      const accent = getStepAccent(idx);
      const stepId = step.id;
      return (
        <>
          <!-- Step Card -->
          {!hasAnyGraphic ? (
            <div
              id={stepId}
              data-cue={step.cue}
              data-accent={accent}
              data-autofit
              style={`--content-scale: 1; --step-accent: var(--color-slide-accent-${accent}); --hl-color: var(--color-slide-accent-${accent}); --hl-text-dark: color-mix(in srgb, var(--color-slide-accent-${accent}) 35%, white); --hl-text-light: var(--color-slide-accent-${accent});`}
              class="step-card no-graphic flex-1 h-full rounded-3xl border border-[var(--color-slide-card-border)] bg-[var(--color-slide-card-bg)] shadow-2xl flex flex-col justify-between p-6 lg:p-8 relative transition-all duration-300 min-h-0 min-w-0 overflow-hidden"
            >
              <div class="step-text-container flex-1 flex flex-col justify-start min-w-0">
                <div class="flex items-center gap-3 mb-4">
                  <span class={`step-num-badge w-10 h-10 lg:w-12 lg:h-12 rounded-xl flex items-center justify-center font-black text-lg shadow-md ${accentPills[accent]}`}>
                    {formatStepNum(step.num)}
                  </span>
                  <h4 class="text-xl lg:text-2xl font-bold tracking-tight text-[var(--color-slide-text)]">
                    {step.title}
                  </h4>
                </div>
                {step.desc && (
                  <p class="text-[var(--color-slide-text-subtle)] text-xl lg:text-2xl leading-relaxed text-pretty font-normal" set:html={renderSlideCues(step.desc)} />
                )}
              </div>

              <!-- Bottom decorative progress bar -->
              <div class="step-bar-container w-full h-2 rounded-full bg-[var(--color-slide-card-border)] overflow-hidden shrink-0 mt-4">
                <div class={`step-progress-bar h-full rounded-full ${accentBars[accent]}`} style="width: 100%;"></div>
              </div>
            </div>
          ) : (
            <div
              id={stepId}
              data-cue={step.cue}
              data-accent={accent}
              data-autofit
              style={`--content-scale: 1; --step-accent: var(--color-slide-accent-${accent}); --hl-color: var(--color-slide-accent-${accent}); --hl-text-dark: color-mix(in srgb, var(--color-slide-accent-${accent}) 35%, white); --hl-text-light: var(--color-slide-accent-${accent});`}
              class="step-card flex-1 h-full rounded-3xl border border-[var(--color-slide-card-border)] bg-[var(--color-slide-card-bg)] shadow-2xl flex flex-col justify-between relative transition-all duration-300 min-h-0 min-w-0 overflow-hidden"
            >
              <!-- Edge-to-Edge Graphic Area at the Top -->
              <div
                class="step-graphic-area w-full relative shrink-0 overflow-hidden border-b border-[var(--color-slide-card-border)] bg-slate-800/40 light:bg-slate-100/70 flex items-center justify-center select-none transition-all duration-300"
                style="height: 280px; min-height: 80px;"
              >
                <!-- Step Number Badge Overlaid on Top-Left -->
                <div class="step-num-container absolute top-4 left-4 z-10">
                  <span class={`step-num-badge w-12 h-12 lg:w-14 lg:h-14 rounded-2xl flex items-center justify-center font-black text-xl shadow-lg ring-2 ring-slate-900/40 light:ring-white/80 ${accentPills[accent]}`}>
                    {formatStepNum(step.num)}
                  </span>
                </div>

                <!-- Graphic / Image / Placeholder -->
                {step.graphic ? (
                  <div class="w-full h-full flex items-center justify-center" set:html={step.graphic} />
                ) : step.image ? (
                  <div class="relative w-full h-full flex items-center justify-center bg-slate-900/60 light:bg-slate-200/60 overflow-hidden">
                    <!-- Skeleton Shimmer Placeholder -->
                    <div
                      class="step-image-skeleton absolute inset-0 flex flex-col items-center justify-center gap-2 text-slate-400 light:text-slate-500 bg-slate-800/60 light:bg-slate-200/60 animate-pulse pointer-events-none z-0"
                      aria-hidden="true"
                    >
                      <svg class="w-6 h-6 stroke-current opacity-40 animate-spin" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                      </svg>
                      <span class="text-[10px] uppercase font-bold tracking-wider opacity-60">Loading illustration...</span>
                    </div>

                    <Image
                      src={step.image}
                      alt={step.imageAlt || step.desc || `Detailed illustration for step ${step.num}: ${step.title}`}
                      title={step.imageTitle || step.title}
                      width={640}
                      height={360}
                      format="webp"
                      class="w-full h-full object-cover transition-opacity duration-300 opacity-0 relative z-10"
                      loading="lazy"
                      decoding="async"
                      onload="this.classList.remove('opacity-0'); this.previousElementSibling?.remove();"
                      onerror="if (this.previousElementSibling) { this.previousElementSibling.textContent = 'Image unavailable'; }"
                    />
                  </div>
                ) : (
                  <div class="w-full h-full flex items-center justify-center relative p-4">
                    <!-- Subtle inner dashed border for placeholder aesthetic -->
                    <div class="absolute inset-3.5 rounded-2xl border-2 border-dashed border-[var(--color-slide-card-border)] pointer-events-none"></div>
                    <div class="flex flex-col items-center justify-center gap-2 text-center relative z-0">
                      <div class={`step-placeholder-icon w-12 h-12 rounded-xl flex items-center justify-center ${accentGlass[accent]} shadow-inner`}>
                        <svg class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                      </div>
                      <span class="text-xs font-mono uppercase tracking-widest text-[var(--color-slide-text-subtle)] font-bold">
                        {step.placeholderLabel || "Visualisierung"}
                      </span>
                    </div>
                  </div>
                )}
              </div>

              <!-- Content Area below Graphic: Title, description, and bottom bar -->
              <div class="step-content-area flex-1 flex flex-col justify-between min-h-0 min-w-0" style="padding: var(--slide-space-card, 2rem);">
                <!-- Title & description (Priority content, top-aligned) -->
                <div class="step-text-container flex-1 flex flex-col justify-start gap-3.5 lg:gap-4 min-w-0">
                  <h4 class="text-2xl lg:text-3xl font-black text-[var(--color-slide-text)] tracking-tight leading-snug" set:html={renderSlideCues(step.title)} />
                  {step.desc && (
                    <p class="text-[var(--color-slide-text-subtle)] text-xl lg:text-2xl leading-relaxed text-pretty font-normal" set:html={renderSlideCues(step.desc)} />
                  )}
                </div>

                <!-- Bottom decorative progress bar -->
                <div class="step-bar-container w-full h-2 rounded-full bg-[var(--color-slide-card-border)] overflow-hidden shrink-0">
                  <div class={`step-progress-bar h-full rounded-full ${accentBars[accent]}`} style="width: 100%;"></div>
                </div>
              </div>
            </div>
          )}

          <!-- Connector arrow to next step -->
          {idx < steps.length - 1 && (
            <span class="pipeline-arrow flex items-center justify-center px-1 text-slate-500 light:text-slate-400 font-bold text-2xl select-none shrink-0">
              →
            </span>
          )}
        </>
      );
    })}
  </div>
)}

<style>
  /* Step Row dynamic auto-fit typography */
  .step-row {
    --scale: var(--content-scale, 1);
  }
  .step-row[data-autofit] h4,
  .step-card:not(.no-graphic)[data-autofit] h4,
  .step-card.no-graphic[data-autofit] h4 {
    font-size: calc(var(--slide-font-heading, 1.90rem) * var(--content-scale, 1)) !important;
    line-height: 1.25 !important;
  }
  .step-row[data-autofit] p,
  .step-card:not(.no-graphic)[data-autofit] p,
  .step-card.no-graphic[data-autofit] p {
    font-size: calc(var(--slide-font-body, 1.75rem) * var(--content-scale, 1)) !important;
    line-height: 1.4 !important;
  }

  /* Step Card dynamic auto-fit typography */
  .step-card {
    --scale: var(--content-scale, 1);
  }

  /* Pipeline Connector Arrows Animation: coupled to following step card */
  .pipeline-arrow {
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Pre-cue pending: arrow is hidden until the following card appears */
  .pipeline-arrow:has(+ .step-card[data-cue]) {
    opacity: 0;
    transform: translateX(-14px) scale(0.8);
    pointer-events: none;
  }

  /* Active: arrow appears together with the following card */
  .pipeline-arrow:has(+ .step-card.is-active) {
    opacity: 1 !important;
    transform: translateX(0) scale(1) !important;
    pointer-events: auto !important;
  }

  /* Dimmed: arrow dims with the following card */
  .pipeline-arrow:has(+ .step-card.is-dimmed) {
    opacity: 0.35 !important;
    transform: scale(0.95) !important;
  }

  /* Exited: arrow fades out if following card exits */
  .pipeline-arrow:has(+ .step-card.is-exited) {
    opacity: 0 !important;
    transform: translateX(8px) scale(0.85) !important;
    pointer-events: none !important;
  }
</style>
