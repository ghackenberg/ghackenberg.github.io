---
interface Step {
  id?: string;
  cue?: string;
  num: string;
  title: string;
  desc?: string;
  badge?: string;
  accent?: 'blue' | 'teal' | 'indigo' | 'green' | 'amber';
}

interface Props {
  steps: Step[];
  id?: string;
  cue?: string;
  class?: string;
}

const {
  steps,
  id: explicitId,
  cue,
  class: className = ""
} = Astro.props;

const elementId = explicitId || cue;

const accentPills = {
  blue: 'bg-blue-600 text-white',
  teal: 'bg-cyan-600 text-white',
  indigo: 'bg-indigo-600 text-white',
  green: 'bg-emerald-600 text-white',
  amber: 'bg-amber-600 text-white'
};
---

<div
  id={elementId}
  data-cue={cue}
  class={`pipeline-container w-full h-full flex items-stretch justify-between gap-6 min-h-0 ${className}`}
>
  {steps.map((step, idx) => {
    const accent = step.accent || (idx % 2 === 0 ? 'blue' : 'teal');
    const stepId = step.id || step.cue;
    return (
      <div class="flex-1 flex items-stretch h-full min-h-0">
        <!-- Step Card -->
        <div
          id={stepId}
          data-cue={step.cue}
          class="step-card flex-1 h-full p-8 lg:p-10 rounded-3xl border border-slate-700/80 bg-slate-900/95 light:border-slate-300 light:bg-white shadow-2xl flex flex-col justify-between relative transition-all duration-300 min-h-0"
        >
          <!-- Top badge row -->
          <div class="flex items-center justify-between gap-3 mb-4 shrink-0">
            <span class={`w-12 h-12 rounded-2xl flex items-center justify-center font-black text-base shadow-md ${accentPills[accent]}`}>
              {step.num}
            </span>
            {step.badge && (
              <span class="text-sm uppercase font-mono font-bold tracking-wider px-3.5 py-1 rounded-full bg-slate-800 light:bg-slate-100 text-slate-300 light:text-slate-600 border border-slate-700 light:border-slate-200">
                {step.badge}
              </span>
            )}
          </div>

          <!-- Title & description -->
          <div class="flex-1 flex flex-col justify-center my-4 gap-3">
            <h4 class="text-2xl lg:text-3xl font-black text-slate-100 light:text-slate-900 tracking-tight leading-snug">
              {step.title}
            </h4>
            {step.desc && (
              <p class="text-slate-300 light:text-slate-600 text-lg lg:text-xl leading-relaxed text-pretty font-normal">
                {step.desc}
              </p>
            )}
          </div>

          <!-- Bottom decorative progress bar -->
          <div class="w-full h-2 rounded-full bg-slate-800 light:bg-slate-100 overflow-hidden mt-4 shrink-0">
            <div class={`h-full rounded-full ${accent === 'blue' ? 'bg-blue-500' : 'bg-cyan-400'}`} style="width: 100%;"></div>
          </div>
        </div>

        <!-- Connector arrow to next step -->
        {idx < steps.length - 1 && (
          <div class="flex items-center justify-center px-3 text-slate-500 light:text-slate-400 font-bold text-3xl select-none shrink-0">
            →
          </div>
        )}
      </div>
    );
  })}
</div>
