---
interface Props {
  variant?: 'footer' | 'modal' | 'card';
  class?: string;
}

const { variant = 'footer', class: className = '' } = Astro.props;
const inputId = `newsletter-email-${variant}`;
const headingId = `newsletter-heading-${variant}`;

const variantContainerClasses: Record<'footer' | 'modal' | 'card', string> = {
  footer: 'mb-10 pb-10 border-b border-element-border',
  modal: 'shrink-0 border-t border-element-border light:border-slate-200/80 bg-white/[0.02] light:bg-slate-50/90 px-4 sm:px-6 py-4',
  card: 'mt-10 p-6 sm:p-8 rounded-3xl glass-card border border-element-border relative overflow-hidden',
};

const variantCopy: Record<'footer' | 'modal' | 'card', { title: string; description: string }> = {
  footer: {
    title: 'Subscribe to the Newsletter',
    description: 'Get notified when new blog posts, presentations, courses, or publications are published.',
  },
  modal: {
    title: 'Get Updates via Email',
    description: 'Prefer email notifications? Subscribe to receive new releases directly in your inbox.',
  },
  card: {
    title: 'Enjoyed this post? Stay in the loop.',
    description: 'Subscribe to get notified when new blog posts, presentations, courses, or publications go live.',
  },
};

const copy = variantCopy[variant];
---

<aside
  aria-labelledby={headingId}
  class:list={[variantContainerClasses[variant], className]}
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-8 items-center">
    <div class="md:col-span-5 lg:col-span-6 space-y-1">
      <h3
        id={headingId}
        class="text-base sm:text-lg font-bold text-gray-100 light:text-slate-900 tracking-tight"
      >
        {copy.title}
      </h3>
      <p class="text-xs sm:text-sm text-gray-400 light:text-slate-600 leading-relaxed">
        {copy.description}
      </p>
    </div>

    <div class="md:col-span-7 lg:col-span-6">
      <form data-newsletter-form data-newsletter-variant={variant} class="space-y-2" novalidate>
        <input type="text" name="nonce" value="" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <div class="flex items-center gap-2">
          <label for={inputId} class="sr-only">Email address</label>
          <input
            id={inputId}
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="Enter your email address..."
            class="flex-1 min-w-0 h-10 px-3.5 rounded-xl bg-element-bg/70 light:bg-white border border-element-border-medium light:border-slate-300 text-xs sm:text-sm text-gray-100 light:text-slate-900 placeholder:text-gray-500 light:placeholder:text-slate-400 focus:outline-none focus:border-brand-blue focus:ring-2 focus:ring-brand-blue/25 transition-all"
          />
          <button
            type="submit"
            class="h-10 px-4 sm:px-5 rounded-xl bg-brand-blue hover:bg-brand-blue/90 text-white font-semibold text-xs sm:text-sm inline-flex items-center justify-center gap-1.5 transition-all shadow-sm shadow-brand-blue/20 cursor-pointer active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed shrink-0"
          >
            <svg data-submit-spinner class="hidden w-3.5 h-3.5 animate-spin text-white shrink-0" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
              <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v3a5 5 0 00-5 5H4z"></path>
            </svg>
            <span data-submit-label>Subscribe</span>
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 text-[11px] text-gray-500 light:text-slate-500">
          <button
            type="button"
            data-altcha-trigger
            data-state="idle"
            class="inline-flex items-center gap-1.5 text-gray-500 light:text-slate-500 hover:text-gray-300 light:hover:text-slate-800 transition-colors cursor-pointer"
            title="Click to verify anti-spam proof-of-work locally in your browser"
          >
            <svg data-altcha-icon="idle" class="w-3.5 h-3.5 text-gray-500 light:text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            <svg data-altcha-icon="verifying" class="hidden w-3.5 h-3.5 text-gray-400 light:text-slate-500 animate-spin shrink-0" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
              <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v3a5 5 0 00-5 5H4z"></path>
            </svg>
            <svg data-altcha-icon="verified" class="hidden w-3.5 h-3.5 text-brand-green shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span data-altcha-status>Protected by ALTCHA</span>
          </button>

          <span>
            Unsubscribe anytime · <a href="/datenschutz/#newsletter" class="underline hover:text-gray-300 light:hover:text-slate-800 transition-colors">Privacy Policy</a>
          </span>
        </div>

        <div
          data-newsletter-feedback
          role="status"
          aria-live="polite"
          class="hidden text-xs px-3 py-2 rounded-xl border font-medium leading-relaxed"
        ></div>
      </form>
    </div>
  </div>
</aside>

<script>
  import { initNewsletterForms } from '@commons/client/newsletter';

  initNewsletterForms();
  document.addEventListener('astro:page-load', initNewsletterForms);
</script>
