---
interface Props {
  variant?: 'footer' | 'modal' | 'card';
  class?: string;
}

const { variant = 'footer', class: className = '' } = Astro.props;
const inputId = `newsletter-email-${variant}`;
const headingId = `newsletter-heading-${variant}`;

const variantContainerClasses: Record<'footer' | 'modal' | 'card', string> = {
  footer: 'w-full mb-12 md:mb-16 rounded-3xl glass-card border border-element-border relative overflow-hidden',
  modal: 'shrink-0 border-t border-element-border light:border-slate-200/80 bg-white/[0.015] light:bg-slate-50/60 overflow-hidden',
  card: 'w-full mt-10 rounded-3xl glass-card border border-element-border relative overflow-hidden',
};

const variantTopSectionClasses: Record<'footer' | 'modal' | 'card', string> = {
  footer: 'p-6 sm:p-8 grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-8 items-center',
  modal: 'px-4 sm:px-6 py-4 grid grid-cols-1 sm:grid-cols-12 gap-3.5 sm:gap-5 items-center',
  card: 'p-6 sm:p-8 grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-8 items-center',
};

const variantBottomBarClasses: Record<'footer' | 'modal' | 'card', string> = {
  footer: 'px-6 sm:px-8 py-3 bg-white/[0.025] light:bg-slate-100/80 border-t border-element-border flex items-center justify-between gap-2 text-xs text-gray-500 light:text-slate-500 whitespace-nowrap',
  modal: 'px-4 sm:px-6 py-2.5 bg-white/[0.025] light:bg-slate-100/80 border-t border-element-border light:border-slate-200/80 flex items-center justify-between gap-2 text-xs text-gray-500 light:text-slate-500 whitespace-nowrap',
  card: 'px-6 sm:px-8 py-3 bg-white/[0.025] light:bg-slate-100/80 border-t border-element-border flex items-center justify-between gap-2 text-xs text-gray-500 light:text-slate-500 whitespace-nowrap',
};

const variantLeftColClasses: Record<'footer' | 'modal' | 'card', string> = {
  footer: 'md:col-span-5 lg:col-span-6 space-y-1.5',
  modal: 'sm:col-span-5 lg:col-span-6 space-y-1',
  card: 'md:col-span-5 lg:col-span-6 space-y-1.5',
};

const variantRightColClasses: Record<'footer' | 'modal' | 'card', string> = {
  footer: 'md:col-span-7 lg:col-span-6',
  modal: 'sm:col-span-7 lg:col-span-6',
  card: 'md:col-span-7 lg:col-span-6',
};

const variantCopy: Record<'footer' | 'modal' | 'card', { title: string; description: string }> = {
  footer: {
    title: 'Subscribe to My Newsletter',
    description: 'Get notified when new blog posts, presentations, courses, or publications are published.',
  },
  modal: {
    title: 'Get Updates via Email',
    description: 'Prefer email notifications? Subscribe to receive new releases directly in your inbox.',
  },
  card: {
    title: 'Enjoyed this post? Stay in the loop.',
    description: 'Subscribe to get notified when new blog posts, presentations, courses, or publications go live.',
  },
};

const copy = variantCopy[variant];
---

<aside
  aria-labelledby={headingId}
  class:list={[variantContainerClasses[variant], className]}
>
  <form data-newsletter-form data-newsletter-variant={variant} novalidate>
    <input type="text" name="nonce" value="" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <div class={variantTopSectionClasses[variant]}>
      <div class={variantLeftColClasses[variant]}>
        <h3
          id={headingId}
          class="text-base sm:text-lg font-bold text-gray-100 light:text-slate-900 tracking-tight"
        >
          {copy.title}
        </h3>
        <p class="text-xs sm:text-sm text-gray-400 light:text-slate-600 leading-relaxed">
          {copy.description}
        </p>
      </div>

      <div class={variantRightColClasses[variant]}>
        <div class="flex items-center gap-2">
          <label for={inputId} class="sr-only">Email address</label>
          <input
            id={inputId}
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="Enter your email address..."
            class="flex-1 min-w-0 h-10 px-3.5 rounded-xl bg-element-bg/70 light:bg-white border border-element-border-medium light:border-slate-300 text-xs sm:text-sm text-gray-100 light:text-slate-900 placeholder:text-gray-500 light:placeholder:text-slate-400 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/25 transition-all"
          />
          <button
            type="submit"
            class="h-10 px-4 sm:px-5 rounded-xl bg-brand-primary hover:bg-brand-primary/90 text-white font-semibold text-xs sm:text-sm inline-flex items-center justify-center gap-1.5 transition-all shadow-sm shadow-brand-primary/20 cursor-pointer active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed shrink-0"
          >
            <svg data-submit-spinner class="hidden w-3.5 h-3.5 animate-spin text-white shrink-0" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
              <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v3a5 5 0 00-5 5H4z"></path>
            </svg>
            <span data-submit-label>Subscribe</span>
          </button>
        </div>

        <div
          data-newsletter-feedback
          role="status"
          aria-live="polite"
          class="hidden mt-2 text-xs px-3 py-2 rounded-xl border font-medium leading-relaxed"
        ></div>
      </div>
    </div>

    <div class={variantBottomBarClasses[variant]}>
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <button
          type="button"
          data-altcha-trigger
          data-state="idle"
          class="inline-flex items-center gap-1.5 text-gray-500 light:text-slate-500 hover:text-gray-300 light:hover:text-slate-800 transition-colors cursor-pointer shrink-0"
          title="Click to verify anti-spam proof-of-work locally in your browser"
        >
          <svg data-altcha-icon="idle" class="w-3.5 h-3.5 text-gray-500 light:text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
          <svg data-altcha-icon="verifying" class="hidden w-3.5 h-3.5 text-gray-400 light:text-slate-500 animate-spin shrink-0" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v3a5 5 0 00-5 5H4z"></path>
          </svg>
          <svg data-altcha-icon="verified" class="hidden w-3.5 h-3.5 text-brand-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          <span data-altcha-status>Protected by ALTCHA</span>
        </button>
        <span class="hidden sm:inline" aria-hidden="true">·</span>
        <span class="hidden sm:inline">Unsubscribe anytime</span>
        <span aria-hidden="true">·</span>
        <a href="/datenschutz/#newsletter" class="underline hover:text-gray-300 light:hover:text-slate-800 transition-colors">Privacy<span class="hidden sm:inline"> Policy</span></a>
      </div>

      <a
        href="/newsletters/"
        class="inline-flex items-center gap-1 font-semibold text-brand-primary hover:text-brand-primary/80 hover:underline transition-colors shrink-0"
      >
        <span>{variant !== 'modal' && <span class="hidden sm:inline">Browse past issues in the </span>}Archive</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </form>
</aside>

<script>
  import { initNewsletterForms } from '@commons/client/newsletter';

  initNewsletterForms();
  document.addEventListener('astro:page-load', initNewsletterForms);
</script>
