---
type CalloutDomain = 'posts' | 'presentations' | 'publications' | 'visualizations' | 'projects' | 'courses';
type NewsletterVariant = 'footer' | 'card' | 'spotlight';

interface LatestIssue {
  id: string;
  issueNumber: number;
  title: string;
}

interface Props {
  variant?: NewsletterVariant;
  domain?: CalloutDomain;
  latestIssue?: LatestIssue;
  class?: string;
}

const { variant = 'footer', domain, latestIssue, class: className = '' } = Astro.props;
const isSpotlight = variant === 'spotlight';
const inputId = `newsletter-email-${variant}`;
const headingId = `newsletter-heading-${variant}`;

const cardTitlesByDomain: Record<CalloutDomain, string> = {
  posts: 'Enjoyed this post? Stay in the loop.',
  presentations: 'Enjoyed this presentation? Stay in the loop.',
  publications: 'Interested in this research? Stay in the loop.',
  visualizations: 'Enjoyed this visualization? Stay in the loop.',
  projects: 'Interested in this project? Stay in the loop.',
  courses: 'Interested in this course? Stay in the loop.',
};

interface AccentTokens {
  button: string;
  icon: string;
  link: string;
  inputFocus: string;
}

const accentByDomain: Record<CalloutDomain | 'newsletters' | 'brand', AccentTokens> = {
  posts: {
    button: 'bg-domain-posts hover:bg-domain-posts/90 shadow-domain-posts/20',
    icon: 'text-domain-posts',
    link: 'text-domain-posts hover:text-domain-posts/80',
    inputFocus: 'focus:border-domain-posts focus:ring-domain-posts/25',
  },
  presentations: {
    button: 'bg-domain-presentations hover:bg-domain-presentations/90 shadow-domain-presentations/20',
    icon: 'text-domain-presentations',
    link: 'text-domain-presentations hover:text-domain-presentations/80',
    inputFocus: 'focus:border-domain-presentations focus:ring-domain-presentations/25',
  },
  publications: {
    button: 'bg-domain-publications hover:bg-domain-publications/90 shadow-domain-publications/20',
    icon: 'text-domain-publications',
    link: 'text-domain-publications hover:text-domain-publications/80',
    inputFocus: 'focus:border-domain-publications focus:ring-domain-publications/25',
  },
  visualizations: {
    button: 'bg-domain-visualizations hover:bg-domain-visualizations/90 shadow-domain-visualizations/20',
    icon: 'text-domain-visualizations',
    link: 'text-domain-visualizations hover:text-domain-visualizations/80',
    inputFocus: 'focus:border-domain-visualizations focus:ring-domain-visualizations/25',
  },
  projects: {
    button: 'bg-domain-projects hover:bg-domain-projects/90 shadow-domain-projects/20',
    icon: 'text-domain-projects',
    link: 'text-domain-projects hover:text-domain-projects/80',
    inputFocus: 'focus:border-domain-projects focus:ring-domain-projects/25',
  },
  courses: {
    button: 'bg-domain-courses hover:bg-domain-courses/90 shadow-domain-courses/20',
    icon: 'text-domain-courses',
    link: 'text-domain-courses hover:text-domain-courses/80',
    inputFocus: 'focus:border-domain-courses focus:ring-domain-courses/25',
  },
  newsletters: {
    button: 'bg-domain-newsletters hover:bg-domain-newsletters/90 shadow-domain-newsletters/20',
    icon: 'text-domain-newsletters',
    link: 'text-domain-newsletters hover:text-domain-newsletters/80',
    inputFocus: 'focus:border-domain-newsletters focus:ring-domain-newsletters/25',
  },
  brand: {
    button: 'bg-brand-primary hover:bg-brand-primary/90 shadow-brand-primary/20',
    icon: 'text-brand-primary',
    link: 'text-brand-primary hover:text-brand-primary/80',
    inputFocus: 'focus:border-brand-primary focus:ring-brand-primary/25',
  },
};

const accent = accentByDomain[domain || (isSpotlight ? 'newsletters' : 'brand')];

const variantContainerClasses: Record<NewsletterVariant, string> = {
  footer: 'w-full mb-12 md:mb-16 rounded-3xl glass-card border border-element-border relative overflow-hidden',
  card: 'w-full mt-10 rounded-3xl glass-card border border-element-border relative overflow-hidden',
  spotlight:
    'w-full rounded-3xl glass-card border border-domain-newsletters/50 light:border-domain-newsletters/35 shadow-2xl shadow-domain-newsletters/15 light:shadow-domain-newsletters/10 relative overflow-hidden',
};

const variantTopSectionClasses: Record<NewsletterVariant, string> = {
  footer: 'p-6 sm:p-8 grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-8 items-center',
  card: 'p-6 sm:p-8 grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-8 items-center',
  spotlight: 'relative z-10 p-6 sm:p-8 lg:p-10 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center',
};

const variantBottomBarClasses: Record<NewsletterVariant, string> = {
  footer: 'px-6 sm:px-8 py-3 bg-white/[0.025] light:bg-slate-100/80 border-t border-element-border flex items-center justify-between gap-2 text-xs text-gray-500 light:text-slate-500 whitespace-nowrap',
  card: 'px-6 sm:px-8 py-3 bg-white/[0.025] light:bg-slate-100/80 border-t border-element-border flex items-center justify-between gap-2 text-xs text-gray-500 light:text-slate-500 whitespace-nowrap',
  spotlight:
    'relative z-10 px-6 sm:px-8 lg:px-10 py-3.5 bg-white/[0.03] light:bg-slate-100/80 border-t border-element-border flex items-center justify-between gap-2 text-xs text-gray-500 light:text-slate-500 whitespace-nowrap',
};

const variantLeftColClasses: Record<NewsletterVariant, string> = {
  footer: 'md:col-span-5 lg:col-span-6 space-y-1.5',
  card: 'md:col-span-5 lg:col-span-6 space-y-1.5',
  spotlight: 'lg:col-span-6 space-y-3',
};

const variantRightColClasses: Record<NewsletterVariant, string> = {
  footer: 'md:col-span-7 lg:col-span-6',
  card: 'md:col-span-7 lg:col-span-6',
  spotlight: 'lg:col-span-6',
};

const variantCopy: Record<NewsletterVariant, { title: string; description: string }> = {
  footer: {
    title: 'Subscribe to My Newsletter',
    description: 'Get notified when new blog posts, presentations, courses, or publications are published.',
  },
  card: {
    title: domain ? cardTitlesByDomain[domain] : 'Enjoyed this content? Stay in the loop.',
    description: 'Subscribe to get notified when new blog posts, presentations, courses, or publications go live.',
  },
  spotlight: {
    title: 'Stay Ahead on AI-Based Software Engineering',
    description:
      'Periodic English-language dispatches summarizing my latest deep dives on agentic workflows, industrial informatics, keynotes, courses, and open-source tools.',
  },
};

const copy = variantCopy[variant];
---

<aside
  aria-labelledby={headingId}
  class:list={[variantContainerClasses[variant], className]}
>
  {isSpotlight && (
    <div class="pointer-events-none select-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 bg-gradient-to-br from-domain-newsletters/20 via-domain-newsletters/[0.05] to-transparent light:from-domain-newsletters/12 light:via-domain-newsletters/[0.04] light:to-transparent"></div>
      <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-domain-newsletters/20 light:bg-domain-newsletters/12 blur-3xl"></div>
      <svg
        class="absolute -bottom-8 -right-6 sm:-bottom-10 sm:-right-4 w-56 h-56 sm:w-64 sm:h-64 text-domain-newsletters opacity-[0.07] light:opacity-[0.09] -rotate-12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
      </svg>
    </div>
  )}

  <form data-newsletter-form data-newsletter-variant={variant} novalidate>
    <input type="text" name="nonce" value="" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <div class={variantTopSectionClasses[variant]}>
      <div class={variantLeftColClasses[variant]}>
        {isSpotlight ? (
          <>
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-domain-newsletters text-white text-[11px] font-extrabold uppercase tracking-wider shadow-sm shadow-domain-newsletters/30">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse" aria-hidden="true"></span>
                <span>New on the Site</span>
              </span>
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-domain-newsletters/12 border border-domain-newsletters/25 text-domain-newsletters text-[11px] font-bold uppercase tracking-wider">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                <span>Newsletter</span>
              </div>
            </div>
            <h2
              id={headingId}
              class="text-2xl sm:text-3xl font-extrabold text-gray-100 light:text-slate-900 tracking-tight leading-tight"
            >
              Stay Ahead on <span class="text-domain-newsletters">AI-Based Software Engineering</span>
            </h2>
            <p class="text-sm sm:text-base text-gray-300 light:text-slate-600 leading-relaxed max-w-xl">
              {copy.description}
            </p>
          </>
        ) : (
          <>
            <h3
              id={headingId}
              class="text-base sm:text-lg font-bold text-gray-100 light:text-slate-900 tracking-tight"
            >
              {copy.title}
            </h3>
            <p class="text-xs sm:text-sm text-gray-400 light:text-slate-600 leading-relaxed">
              {copy.description}
            </p>
          </>
        )}
      </div>

      <div class={variantRightColClasses[variant]}>
        <div class={isSpotlight ? 'p-1.5 sm:p-2 rounded-2xl bg-slate-950/45 light:bg-white/90 border border-domain-newsletters/25 shadow-sm flex flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-2.5' : 'flex items-center gap-2'}>
          <label for={inputId} class="sr-only">Email address</label>
          <input
            id={inputId}
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="Enter your email address..."
            class:list={[
              isSpotlight
                ? 'w-full sm:w-auto sm:flex-1 min-w-0 h-12 px-4 rounded-xl bg-element-bg/80 light:bg-white border border-element-border-medium light:border-slate-300 text-sm text-gray-100 light:text-slate-900 placeholder:text-gray-500 light:placeholder:text-slate-400 focus:outline-none focus:ring-2 transition-all'
                : 'flex-1 min-w-0 h-10 px-3.5 rounded-xl bg-element-bg/70 light:bg-white border border-element-border-medium light:border-slate-300 text-xs sm:text-sm text-gray-100 light:text-slate-900 placeholder:text-gray-500 light:placeholder:text-slate-400 focus:outline-none focus:ring-2 transition-all',
              accent.inputFocus,
            ]}
          />
          <button
            type="submit"
            class:list={[
              isSpotlight
                ? 'h-12 px-6 rounded-xl text-white font-extrabold text-sm tracking-wide inline-flex items-center justify-center gap-2 transition-all duration-300 shadow-lg hover:shadow-domain-newsletters/35 hover:scale-[1.02] cursor-pointer active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed shrink-0'
                : 'h-10 px-4 sm:px-5 rounded-xl text-white font-semibold text-xs sm:text-sm inline-flex items-center justify-center gap-1.5 transition-all shadow-sm cursor-pointer active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed shrink-0',
              accent.button,
            ]}
          >
            <svg data-submit-spinner class="hidden w-3.5 h-3.5 animate-spin text-white shrink-0" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
              <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v3a5 5 0 00-5 5H4z"></path>
            </svg>
            <span data-submit-label>Subscribe</span>
          </button>
        </div>

        <div
          data-newsletter-feedback
          role="status"
          aria-live="polite"
          class="hidden mt-2.5 text-xs px-3 py-2 rounded-xl border font-medium leading-relaxed"
        ></div>
      </div>
    </div>

    <div class={variantBottomBarClasses[variant]}>
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <button
          type="button"
          data-altcha-trigger
          data-state="idle"
          class="inline-flex items-center gap-1.5 text-gray-500 light:text-slate-500 hover:text-gray-300 light:hover:text-slate-800 transition-colors cursor-pointer shrink-0"
          title="Click to verify anti-spam proof-of-work locally in your browser"
        >
          <svg data-altcha-icon="idle" class="w-3.5 h-3.5 text-gray-500 light:text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
          <svg data-altcha-icon="verifying" class="hidden w-3.5 h-3.5 text-gray-400 light:text-slate-500 animate-spin shrink-0" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
            <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v3a5 5 0 00-5 5H4z"></path>
          </svg>
          <svg data-altcha-icon="verified" class:list={['hidden w-3.5 h-3.5 shrink-0', accent.icon]} fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          <span data-altcha-status>Protected by ALTCHA</span>
        </button>
        <span class="hidden sm:inline" aria-hidden="true">·</span>
        <span class="hidden sm:inline">Unsubscribe anytime</span>
        <span aria-hidden="true">·</span>
        <a href="/datenschutz/#newsletter" class="underline hover:text-gray-300 light:hover:text-slate-800 transition-colors">Privacy<span class="hidden sm:inline"> Policy</span></a>
      </div>

      {isSpotlight && latestIssue ? (
        <a
          href={`/newsletters/${latestIssue.id}/`}
          title={latestIssue.title}
          class:list={[
            'inline-flex items-center gap-1 font-semibold hover:underline transition-colors shrink-0',
            accent.link,
          ]}
        >
          <span><span class="hidden sm:inline">Read latest issue </span>(#{latestIssue.issueNumber})</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <a
          href="/newsletters/"
          class:list={[
            'inline-flex items-center gap-1 font-semibold hover:underline transition-colors shrink-0',
            accent.link,
          ]}
        >
          <span><span class="hidden sm:inline">Browse past issues in the </span>Archive</span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </form>
</aside>

<script>
  import { initNewsletterForms } from '@commons/client/newsletter';

  initNewsletterForms();
  document.addEventListener('astro:page-load', initNewsletterForms);
</script>
