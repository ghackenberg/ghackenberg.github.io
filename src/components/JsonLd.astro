---
type JsonValue = string | number | boolean | null | undefined | { [key: string]: JsonValue } | JsonValue[];

interface Props {
  schema: Record<string, JsonValue> | Array<Record<string, JsonValue>>;
}

const { schema } = Astro.props;
const jsonLdString = JSON.stringify(schema, null, 2);
---

<script type="application/ld+json" is:inline set:html={jsonLdString} />
