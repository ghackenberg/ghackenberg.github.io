---
// GitHubWidget.astro
// Build-time server-side GitHub Widget using Astro Collections.
// Pre-renders content to static HTML at build time.

import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GitHubProfile {
  followers: number;
}

interface GitHubRepo {
  title: string;
  description: string;
  url: string;
  stars: number;
  language: string;
  image?: ImageMetadata | null | undefined;
  pubDate: Date;
  pushDate: Date;
}

let profile: GitHubProfile | null = null;
let repos: GitHubRepo[] = [];
let buildError: string | null = null;
let syncRequired = false;

try {
  const profileEntry = await getEntry("github-profile", "profile");
  if (profileEntry) {
    profile = profileEntry.data;
  }

  const reposCollection = await getCollection("github-repos");
  if (reposCollection && reposCollection.length > 0) {
    const rawRepos = reposCollection.map(entry => {
      return {
        title: entry.id,
        description: entry.data.description,
        url: entry.data.url,
        stars: entry.data.stars,
        language: entry.data.language,
        image: entry.data.image,
        pubDate: entry.data.pubDate,
        pushDate: entry.data.pushDate
      };
    });
    repos = rawRepos.sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0));
  }

  if (!profile || repos.length === 0) {
    syncRequired = true;
  }
} catch (error) {
  const err = error instanceof Error ? error : new Error(String(error));
  console.warn(`[GitHubWidget Build Warning] Failed to load data from collection: ${err.message}`);
  buildError = err.message;
}

// Language colors mapping
const languageColors: Record<string, string> = {
  TypeScript: "bg-blue-400",
  JavaScript: "bg-yellow-400",
  HTML: "bg-orange-500",
  CSS: "bg-purple-400",
  Astro: "bg-rose-500",
  Python: "bg-blue-500",
  Vue: "bg-emerald-500",
  React: "bg-sky-400",
  C: "bg-gray-400",
  "C++": "bg-pink-500",
  Java: "bg-red-400"
};
---

{buildError ? (
  /* GitHub Error Card */
  <div class="glass-card p-4 sm:p-6 rounded-3xl border border-red-500/20 h-full flex flex-col justify-between relative overflow-hidden group">
    <!-- Accent line for error state -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-red-500/80"></div>
    
    <div>
      <!-- Widget Header -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center space-x-3">
          <div class="p-2 rounded-xl bg-red-500/10 border border-red-500/20">
            <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100">GitHub</h3>
        </div>
        <span class="text-[10px] text-red-500 bg-red-500/10 px-2 py-0.5 rounded-full border border-red-500/20 font-semibold uppercase">
          Failed
        </span>
      </div>

      <div class="flex flex-col items-center justify-center text-center py-10">
        <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500 text-lg mb-4">
          ⚠️
        </div>
        <h4 class="text-sm font-bold text-gray-100 mb-2">Build-Time Error</h4>
        <p class="text-xs text-gray-400 leading-relaxed max-w-[220px]">
          Could not load local collection. {buildError}
        </p>
      </div>
    </div>

    <!-- Fallback CTA Button (Direct Profile Link) -->
    <div class="mt-6 pt-4 border-t border-element-border">
      <a 
        href="https://github.com/ghackenberg" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center space-x-2 py-2.5 text-xs font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 border border-element-border-medium hover:border-element-border-hover transition-all duration-300"
      >
        <span>Open Profile Link</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>
  </div>
) : syncRequired ? (
  /* GitHub Sync Required Card */
  <div class="glass-card p-4 sm:p-6 rounded-3xl border border-yellow-500/20 h-full flex flex-col justify-between relative overflow-hidden group">
    <!-- Accent line for sync required state -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-yellow-500/80"></div>
    
    <div>
      <!-- Widget Header -->
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center space-x-3">
          <div class="p-2 rounded-xl bg-yellow-500/10 border border-yellow-500/20">
            <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100">GitHub</h3>
        </div>
        <span class="text-[10px] text-yellow-500 bg-yellow-500/10 px-2 py-0.5 rounded-full border border-yellow-500/20 font-semibold uppercase">
          Sync Required
        </span>
      </div>

      <div class="flex flex-col items-center justify-center text-center py-10">
        <div class="w-12 h-12 rounded-full bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center text-yellow-500 text-lg mb-4">
          ⚙️
        </div>
        <h4 class="text-sm font-bold text-gray-100 mb-2">No Local Data Found</h4>
        <p class="text-xs text-gray-400 leading-relaxed max-w-[220px]">
          Please run <code class="bg-element-bg-hover px-1.5 py-0.5 rounded text-yellow-400 font-mono text-[11px]">npm run sync</code> locally to populate the GitHub feed.
        </p>
      </div>
    </div>

    <!-- Fallback CTA Button (Direct Profile Link) -->
    <div class="mt-6 pt-4 border-t border-element-border">
      <a 
        href="https://github.com/ghackenberg" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center space-x-2 py-2.5 text-xs font-semibold rounded-xl bg-element-bg hover:bg-element-bg-hover text-gray-300 border border-element-border-medium hover:border-element-border-hover transition-all duration-300"
      >
        <span>Open Profile Link</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>
  </div>
) : profile && (
  /* GitHub Active Content Card */
  <div class="glass-card p-5 sm:p-6 md:p-8 rounded-3xl border border-element-border h-full relative overflow-hidden group">
    <!-- Brand accent header color block -->
    <div class="absolute top-0 left-0 right-0 h-1.5 bg-brand-blue opacity-50 group-hover:opacity-100 transition-opacity"></div>

    <!-- Widget Card Header with Integrated Stats -->
    <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-element-border/60">
      <div class="flex items-center space-x-3">
        <div class="p-2.5 rounded-xl bg-brand-blue/10 border border-brand-blue/20">
          <svg class="w-6 h-6 text-brand-blue shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <h3 class="text-xl md:text-2xl font-bold tracking-tight text-gray-100">GitHub</h3>
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-element-bg border border-element-border text-gray-300 font-mono">
            {repos.length} Repos &bull; {profile.followers} Followers
          </span>
        </div>
      </div>
    </div>
    
    <!-- Main Card Body: Recent Repositories Feed -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {repos.slice(0, 3).map((repo, index) => (
        <div class={index === 2 ? 'h-full hidden sm:hidden lg:flex flex-col' : 'h-full flex flex-col'}>
          <a 
            href={repo.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full flex flex-col items-stretch rounded-2xl bg-element-bg hover:bg-element-bg-hover border border-element-border hover:border-brand-blue/30 transition-all duration-300 group/item cursor-pointer overflow-hidden p-0 flex-grow"
          >
            <div class="relative w-full aspect-video shrink-0 bg-gray-900 light:bg-slate-100 border-b border-element-border group-hover/item:border-brand-blue/30 flex items-center justify-center overflow-hidden rounded-t-2xl">
            {repo.image ? (
              <>
                <Image 
                  src={repo.image} 
                  alt=""
                  width={480}
                  height={270}
                  class="absolute inset-0 w-full h-full object-cover group-hover/item:scale-105 transition-transform duration-300 z-0 will-change-transform pointer-events-none" 
                />
                <div class="absolute inset-0 bg-gradient-to-br from-[#111827] to-[#0b1329]/20 light:from-[#111827]/60 light:to-[#0b1329]/10 z-10 pointer-events-none"></div>
              </>
            ) : (
              <>
                <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-blue-950/70 light:from-slate-200 light:to-slate-300/70 z-10"></div>
                <svg class="w-10 h-10 text-brand-blue/60 group-hover/item:text-brand-blue/90 group-hover/item:scale-110 transition-all duration-300 z-20" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
              </>
            )}
            </div>
            <div class="flex-grow min-w-0 p-4 sm:p-5 md:p-6 flex flex-col justify-center select-none">
            <p class="text-base sm:text-lg md:text-xl font-bold text-gray-100 group-hover/item:text-brand-blue transition-colors line-clamp-1 font-mono leading-snug">
              {repo.title}
            </p>
            <p class="text-xs sm:text-sm md:text-base text-gray-300 line-clamp-2 mt-1.5 sm:mt-2 leading-relaxed font-sans font-normal">
              {repo.description}
            </p>
            <div class="flex items-center space-x-3 text-xs sm:text-sm text-gray-400 mt-3 font-medium select-none">
              <div class="flex items-center space-x-1.5">
                <span class={`w-2.5 h-2.5 rounded-full ${languageColors[repo.language] || 'bg-gray-400'}`}></span>
                <span>{repo.language}</span>
              </div>
              <span>&bull;</span>
              <span>⭐ {repo.stars}</span>
            </div>
          </div>
          </a>
        </div>
      ))}
    </div>

    <!-- Card Footer: CTA Action Button -->
    <div class="mt-5 pt-4 border-t border-element-border/60">
      <a 
        href="https://github.com/ghackenberg" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center space-x-2 py-3 px-4 text-xs sm:text-sm font-semibold rounded-xl bg-brand-blue/15 hover:bg-brand-blue/30 text-brand-blue border border-brand-blue/30 hover:border-brand-blue/50 transition-all duration-300"
      >
        <span>Follow on GitHub</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
)}
