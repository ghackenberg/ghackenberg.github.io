---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  href: string;
  engineId?: string;
  image?: ImageMetadata | { src: ImageMetadata; title: string; description: string };
  tags?: string[];
  activeTag?: string | string[];
  showTags?: boolean;
}

const { 
  title, 
  description, 
  href, 
  image,
  tags = [],
  activeTag,
  showTags
} = Astro.props;

const isTagActive = (t: string) => (!activeTag ? false : Array.isArray(activeTag) ? activeTag.includes(t) : activeTag === t);
const shouldShowTags = showTags ?? Boolean(activeTag);

const isImageObj = Boolean(image && typeof image === 'object' && 'src' in image && image.src);
const imageImg = isImageObj ? (image as { src: ImageMetadata }).src : (image as ImageMetadata | undefined);
const imageTitle = isImageObj ? (image as { title: string }).title : title;
const imageDesc = isImageObj ? (image as { description: string }).description : (description ? `${title} – ${description}` : `Interactive network diagram preview for ${title}`);

const optimizedImage = imageImg ? await getImage({
  src: imageImg,
  format: 'webp',
  width: 640,
  quality: 80
}) : null;

const cardId = href.replace(/^\/visualizations\//, '').replace(/\/$/, '') || title;
---

<article class="glass-card preview-card h-full border border-element-border flex flex-col group relative cursor-pointer hover:border-domain-visualizations/40 transition-all duration-300" data-card-id={cardId} data-collection="visualizations">
  <!-- Absolute overlay link for card clickability -->
  <a href={href} class="absolute inset-0 z-10" aria-label={title}></a>

  <!-- Screenshot -->
  <div class="aspect-video w-full shrink-0 overflow-hidden bg-gray-900 flex items-center justify-center relative" style="transform: translate3d(0, 0, 0); backface-visibility: hidden; -webkit-backface-visibility: hidden;">
    {image && (
      <svg 
        class="absolute inset-0 w-full h-full group-hover:scale-105 transition-transform duration-500 z-0 pointer-events-none" 
        viewBox="0 0 160 90" 
        preserveAspectRatio="none" 
        role="img" 
        aria-label={imageDesc}
      >
        <defs>
          <linearGradient id={`grad-vis-dark-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="black" stop-opacity="0" />
            <stop offset="60%" stop-color="black" stop-opacity="0.25" />
            <stop offset="100%" stop-color="black" stop-opacity="0.85" />
          </linearGradient>
          <linearGradient id={`grad-vis-light-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="black" stop-opacity="0" />
            <stop offset="60%" stop-color="black" stop-opacity="0.15" />
            <stop offset="100%" stop-color="black" stop-opacity="0.45" />
          </linearGradient>
        </defs>
        <image 
          role="img"
          href={optimizedImage ? optimizedImage.src : (imageImg ? imageImg.src : '')} 
          x="0" 
          y="0" 
          width="160" 
          height="90" 
          preserveAspectRatio="xMidYMid slice" 
          {...{ title: imageTitle }}
          aria-label={imageDesc}
        />
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="block light:hidden"
          fill={`url(#grad-vis-dark-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="hidden light:block"
          fill={`url(#grad-vis-light-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
      </svg>
    )}
  </div>

  <!-- Details -->
  <div class="preview-card-body flex flex-col flex-grow border-t border-element-border">
    <div>
      <h2 class="text-base sm:text-lg font-bold text-gray-100 mb-2 group-hover:text-domain-visualizations transition-colors leading-snug line-clamp-1 min-h-[1lh]" title={title}>
        {title}
      </h2>
      
      <p class="text-gray-400 light:text-slate-600 text-sm mb-3 leading-relaxed font-normal line-clamp-3 min-h-[3lh]">
        {description}
      </p>
    </div>

    <!-- Tags & Action Footer -->
    {shouldShowTags && tags && tags.length > 0 ? (
      <div class="flex-grow flex flex-col mt-3">
        <div class="flex flex-wrap gap-2 self-start relative z-20">
          {tags.map((t) => (
            <a
              href={`/tags/${t}/`}
              data-tag={t}
              class={`tag-chip tag-chip-yellow inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border relative z-20 hover:scale-105 ${
                isTagActive(t) ? 'active-tag-match' : ''
              }`}
            >
              #{t}
            </a>
          ))}
        </div>

        <div class="mt-auto pt-5 w-full relative z-20">
          <a 
            href={`${href}?utm_source=visualizations_hub&utm_medium=vis_card&utm_campaign=visualizations`}
            aria-label={`Read More: ${title}`}
            class="flex items-center justify-center gap-2 w-full px-3.5 py-2.5 rounded-xl bg-domain-visualizations/12 hover:bg-domain-visualizations/25 border border-domain-visualizations/20 hover:border-domain-visualizations/45 text-domain-visualizations text-xs font-bold relative z-20 transition-all duration-200"
          >
            <span>Read More</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <div class="mt-auto pt-4 w-full relative z-20">
        <a 
          href={`${href}?utm_source=visualizations_hub&utm_medium=vis_card&utm_campaign=visualizations`}
          aria-label={`Read More: ${title}`}
          class="flex items-center justify-center gap-2 w-full px-3.5 py-2.5 rounded-xl bg-domain-visualizations/12 hover:bg-domain-visualizations/25 border border-domain-visualizations/20 hover:border-domain-visualizations/45 text-domain-visualizations text-xs font-bold relative z-20 transition-all duration-200"
        >
          <span>Read More</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</article>
