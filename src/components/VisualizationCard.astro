---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  href: string;
  engineId?: string;
  screenshot?: ImageMetadata | { src: ImageMetadata; title: string; description: string };
  tags?: string[];
  activeTag?: string | string[];
}

const { 
  title, 
  description, 
  href, 
  screenshot,
  tags = [],
  activeTag
} = Astro.props;

const isTagActive = (t: string) => (!activeTag ? false : Array.isArray(activeTag) ? activeTag.includes(t) : activeTag === t);

const isScreenshotObj = Boolean(screenshot && typeof screenshot === 'object' && 'src' in screenshot && screenshot.src);
const screenshotImg = isScreenshotObj ? (screenshot as { src: ImageMetadata }).src : (screenshot as ImageMetadata | undefined);
const screenshotTitle = isScreenshotObj ? (screenshot as { title: string }).title : title;
const screenshotDesc = isScreenshotObj ? (screenshot as { description: string }).description : (description ? `${title} – ${description}` : `Interactive network diagram preview for ${title}`);

const optimizedScreenshot = screenshotImg ? await getImage({
  src: screenshotImg,
  format: 'webp',
  width: 640,
  quality: 80
}) : null;
---

<div class="glass-card preview-card h-full border border-element-border flex flex-col group relative cursor-pointer hover:border-brand-green/30 transition-all duration-300">
  <!-- Absolute overlay link for card clickability -->
  <a href={href} class="absolute inset-0 z-10" aria-label={title}></a>

  <!-- Screenshot -->
  <div class="aspect-video w-full overflow-hidden bg-gray-900 flex items-center justify-center relative" style="transform: translate3d(0, 0, 0); backface-visibility: hidden; -webkit-backface-visibility: hidden;">
    {screenshot && (
      <svg 
        class="absolute inset-0 w-full h-full group-hover:scale-105 transition-transform duration-500 z-0 pointer-events-none" 
        viewBox="0 0 160 90" 
        preserveAspectRatio="none" 
        role="img" 
        aria-label={screenshotDesc}
      >
        <defs>
          <linearGradient id={`grad-vis-dark-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#000000" stop-opacity="0" />
            <stop offset="60%" stop-color="#000000" stop-opacity="0.25" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0.85" />
          </linearGradient>
          <linearGradient id={`grad-vis-light-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#000000" stop-opacity="0" />
            <stop offset="60%" stop-color="#000000" stop-opacity="0.15" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0.45" />
          </linearGradient>
        </defs>
        <image 
          href={optimizedScreenshot ? optimizedScreenshot.src : (screenshotImg ? screenshotImg.src : '')} 
          x="0" 
          y="0" 
          width="160" 
          height="90" 
          preserveAspectRatio="xMidYMid slice" 
          {...{ title: screenshotTitle }}
          aria-label={screenshotDesc}
        />
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="block light:hidden"
          fill={`url(#grad-vis-dark-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="hidden light:block"
          fill={`url(#grad-vis-light-${title.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
      </svg>
    )}

    <!-- Unread badge -->
    <span 
      class="unread-dot hidden badge-new badge-new-green badge-corner-tr" 
      data-item-url={href}
      title="Unread visualization"
    >UNREAD</span>
  </div>

  <!-- Details -->
  <div class="preview-card-body flex flex-col flex-grow border-t border-element-border">
    <div class="flex-grow flex flex-col">
      <h2 class="text-xl font-bold text-gray-100 mb-3 group-hover:text-brand-green transition-colors leading-snug">
        {title}
      </h2>
      
      <p class="text-gray-400 text-sm leading-relaxed mb-4 font-normal flex-grow">
        {description}
      </p>
    </div>

    <!-- Tags & Action Footer -->
    <div class="flex-grow flex flex-col mt-3">
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 self-start relative z-20">
          {tags.map((t) => (
            <a
              href={`/tags/${t}/`}
              data-tag={t}
              class={`tag-chip tag-chip-green inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border relative z-20 hover:scale-105 ${
                isTagActive(t) ? 'active-tag-match' : ''
              }`}
            >
              #{t}
            </a>
          ))}
        </div>
      )}

      <div class="mt-auto pt-6 w-full relative z-20">
        <a 
          href={`${href}?utm_source=visualizations_hub&utm_medium=vis_card&utm_campaign=visualizations`}
          class="flex items-center justify-center gap-2 w-full px-3.5 py-2.5 rounded-xl bg-brand-green/12 hover:bg-brand-green/25 border border-brand-green/20 hover:border-brand-green/45 text-emerald-300 light:text-brand-green text-xs font-bold relative z-20 transition-all duration-200"
        >
          <span>Launch Visualization</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
