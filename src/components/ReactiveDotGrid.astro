---
export interface Props {
  class?: string;
  spacing?: number;
  baseRadius?: number;
  activeRadius?: number;
  influenceRadius?: number;
  maxDisplacement?: number;
}

const {
  class: className = '',
  spacing = 22,
  baseRadius = 1.4,
  activeRadius = 2.8,
  influenceRadius = 115,
  maxDisplacement = 7.5
} = Astro.props;
---

<div
  class={`reactive-dot-grid relative w-full h-full overflow-visible select-none ${className}`}
  data-spacing={spacing}
  data-base-radius={baseRadius}
  data-active-radius={activeRadius}
  data-influence-radius={influenceRadius}
  data-max-displacement={maxDisplacement}
  aria-hidden="true"
>
  <canvas class="reactive-dot-canvas block w-full h-full pointer-events-none"></canvas>
</div>

<script is:inline>
  (function () {
    function initReactiveDotGrids() {
      const containers = document.querySelectorAll('.reactive-dot-grid:not([data-init="true"])');

      containers.forEach(function (container) {
        container.dataset.init = 'true';

        const canvas = container.querySelector('.reactive-dot-canvas');
        if (!canvas) return;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const spacing = parseFloat(container.dataset.spacing || '22') || 22;
        const influenceRadius = parseFloat(container.dataset.influenceRadius || '115') || 115;
        const maxDisplacement = parseFloat(container.dataset.maxDisplacement || '7.5') || 7.5;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let dots = [];
        let segments = [];
        let width = 0;
        let height = 0;
        let lastLatticeWidth = -1;
        let lastLatticeHeight = -1;
        let lastLatticeContour = null;

        let isVisible = false;
        let pointerActive = false;
        let pointerX = -9999;
        let pointerY = -9999;

        let animId = null;
        let lastTimestamp = performance.now();

        function startIntro() {
          startAnimation();
        }

        function smin(a, b, k) {
          const h = Math.max(k - Math.abs(a - b), 0) / k;
          return Math.min(a, b) - h * h * k * 0.25;
        }

        function sdRoundRect(px, py, left, top, right, bottom, r) {
          const w = right - left;
          const h = bottom - top;
          if (w <= 0 || h <= 0) return 9999;
          const effR = Math.min(r, w * 0.45, h * 0.45);
          const cx = (left + right) * 0.5;
          const cy = (top + bottom) * 0.5;
          const bx = Math.max(0, w * 0.5 - effR);
          const by = Math.max(0, h * 0.5 - effR);
          const qx = Math.abs(px - cx) - bx;
          const qy = Math.abs(py - cy) - by;
          return Math.hypot(Math.max(qx, 0), Math.max(qy, 0)) + Math.min(Math.max(qx, qy), 0) - effR;
        }

        function rebuildLattice() {
          dots = [];
          segments = [];
          if (width <= 0 || height <= 0) return;

          const contourAttr = container.dataset.contour || '';
          lastLatticeWidth = width;
          lastLatticeHeight = height;
          lastLatticeContour = contourAttr;

          const cols = Math.max(1, Math.floor((width - spacing) / spacing) + 1);
          const rows = Math.max(1, Math.floor((height - spacing) / spacing) + 1);

          const gridSpanX = (cols - 1) * spacing;
          const gridSpanY = (rows - 1) * spacing;

          const startX = Math.round((width - gridSpanX) / 2);
          const startY = Math.round((height - gridSpanY) / 2);

          const outerCornerRadius = Math.min(56, Math.floor(Math.min(width, height) * 0.28));
          const pad = spacing * 0.35;
          let contour = null;
          if (contourAttr) {
            try {
              const parsed = JSON.parse(contourAttr);
              if (Array.isArray(parsed) && parsed.length > 0) {
                contour = parsed;
              }
            } catch {
              contour = null;
            }
          }

          const grid = [];
          for (let r = 0; r < rows; r++) {
            grid.push(new Array(cols).fill(null));
          }

          if (contour) {
            const CLEARANCE_X = 32;
            const CLEARANCE_Y = 24;

            for (let r = 0; r < rows; r++) {
              const y0 = startY + r * spacing;
              for (let c = 0; c < cols; c++) {
                const x0 = startX + c * spacing;

                // 1. Outer Hero Boundary with Rounded Corners
                const dOuter = sdRoundRect(x0, y0, pad, pad, width - pad, height - pad, outerCornerRadius);
                if (dOuter >= 0) continue;

                // 2. Exact Content Contour Signed Distance (two nearest bands)
                let d1 = 9999;
                let d2 = 9999;
                for (let i = 0; i < contour.length; i++) {
                  const [bTop, bBottom, bRight] = contour[i];
                  const dBand = sdRoundRect(
                    x0,
                    y0,
                    -500,
                    bTop - CLEARANCE_Y,
                    bRight + CLEARANCE_X,
                    bBottom + CLEARANCE_Y,
                    12
                  );
                  if (dBand < d1) {
                    d2 = d1;
                    d1 = dBand;
                  } else if (dBand < d2) {
                    d2 = dBand;
                  }
                }
                const dText = smin(d1, d2, 12);

                // Strict clearance barrier: zero nodes behind text
                if (dText <= 0) continue;

                // Filleted intersection where text clearance boundary meets outer boundary
                const distInsideOpen = smin(-dOuter, dText, 22);
                if (distInsideOpen <= 0) continue;

                // Hard transition at grid edges (crisp boundary, zero opacity fade)
                const alphaFactor = 1;
                const alphaBin = 9;

                const vertex = {
                  x0,
                  y0,
                  curX: x0,
                  curY: y0,
                  dx: 0,
                  dy: 0,
                  vx: 0,
                  vy: 0,
                  energy: 0,
                  totalEnergy: 0,
                  alphaFactor,
                  alphaBin
                };
                dots.push(vertex);
                grid[r][c] = vertex;
              }
            }
          } else {
            // Standalone fallback mode (single rounded rectangle)
            for (let r = 0; r < rows; r++) {
              const y0 = startY + r * spacing;
              for (let c = 0; c < cols; c++) {
                const x0 = startX + c * spacing;
                const dOuter = sdRoundRect(x0, y0, pad, pad, width - pad, height - pad, outerCornerRadius);
                if (dOuter >= 0) continue;

                // Hard transition at grid edges (crisp boundary, zero opacity fade)
                const alphaFactor = 1;
                const alphaBin = 9;

                const vertex = {
                  x0,
                  y0,
                  curX: x0,
                  curY: y0,
                  dx: 0,
                  dy: 0,
                  vx: 0,
                  vy: 0,
                  energy: 0,
                  totalEnergy: 0,
                  alphaFactor,
                  alphaBin
                };
                dots.push(vertex);
                grid[r][c] = vertex;
              }
            }
          }

          // Build segments from adjacent connected vertices
          for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
              const v = grid[r][c];
              if (!v) continue;

              // Horizontal edge
              if (c + 1 < cols && grid[r][c + 1]) {
                const vRight = grid[r][c + 1];
                segments.push({
                  a: v,
                  b: vRight,
                  alphaFactor: 1,
                  alphaBin: 9
                });
              }

              // Vertical edge
              if (r + 1 < rows && grid[r + 1][c]) {
                const vDown = grid[r + 1][c];
                segments.push({
                  a: v,
                  b: vDown,
                  alphaFactor: 1,
                  alphaBin: 9
                });
              }
            }
          }
        }

        function draw(timestamp) {
          if (!ctx || width <= 0 || height <= 0) return;
          ctx.clearRect(0, 0, width, height);

          const isLight = document.documentElement.classList.contains('light');
          const t = prefersReducedMotion ? 0 : timestamp * 0.001;

          // 4-stop Aurora gradient stops hoisted outside per-segment loop
          const auroraStopsDark = [
            [16, 185, 129],
            [6, 182, 212],
            [59, 130, 246],
            [168, 85, 247]
          ];
          const auroraStopsLight = [
            [5, 150, 105],
            [8, 145, 178],
            [37, 99, 235],
            [147, 51, 234]
          ];
          const neutralDark = [148, 163, 184];
          const neutralLight = [71, 85, 105];
          const stops = isLight ? auroraStopsLight : auroraStopsDark;
          const neutral = isLight ? neutralLight : neutralDark;

          // 1. Update vertex coordinates and energy
          for (let i = 0; i < dots.length; i++) {
            const dot = dots[i];
            let ambientDx = 0;
            let ambientDy = 0;
            let ambientEnergy = 0;

            if (!prefersReducedMotion) {
              const wave1 = Math.sin(dot.x0 * 0.022 + dot.y0 * 0.016 - t * 1.35);
              const wave2 = Math.cos(dot.x0 * 0.015 - dot.y0 * 0.024 + t * 0.95);
              const ambientPulse = Math.max(0, (wave1 * 0.55 + wave2 * 0.45 + 1) * 0.5);
              ambientEnergy = Math.pow(ambientPulse, 2.6) * 0.42;
              ambientDx = wave1 * 1.1;
              ambientDy = wave2 * 1.1;
            }

            dot.curX = dot.x0 + ambientDx + dot.dx;
            dot.curY = dot.y0 + ambientDy + dot.dy;
            dot.totalEnergy = Math.min(1, ambientEnergy + dot.energy);
          }

          // 2. Pass 1 — Base non-energized line segments (segEnergy <= 0.02)
          // Uniform crisp base alpha across the entire grid
          ctx.lineWidth = 1;
          const effectiveAlpha = isLight ? '0.180' : '0.200';
          ctx.strokeStyle = isLight
            ? `rgba(71, 85, 105, ${effectiveAlpha})`
            : `rgba(148, 163, 184, ${effectiveAlpha})`;
          ctx.beginPath();

          for (let i = 0; i < segments.length; i++) {
            const seg = segments[i];
            const segEnergy = Math.max(seg.a.totalEnergy, seg.b.totalEnergy);
            if (segEnergy <= 0.02) {
              ctx.moveTo(seg.a.curX, seg.a.curY);
              ctx.lineTo(seg.b.curX, seg.b.curY);
            }
          }
          ctx.stroke();

          // 3. Pass 2 — Energized line segments (segEnergy > 0.02)
          for (let i = 0; i < segments.length; i++) {
            const seg = segments[i];
            const segEnergy = Math.max(seg.a.totalEnergy, seg.b.totalEnergy);
            if (segEnergy > 0.02) {
              const midX = (seg.a.curX + seg.b.curX) * 0.5;
              const auroraPos = Math.min(1, Math.max(0, (midX / Math.max(1, width)) * 0.55 + segEnergy * 0.65)) * 3;
              const idx = Math.min(2, Math.floor(auroraPos));
              const tStops = auroraPos - idx;
              const c1 = stops[idx];
              const c2 = stops[idx + 1];
              const targetR = c1[0] + (c2[0] - c1[0]) * tStops;
              const targetG = c1[1] + (c2[1] - c1[1]) * tStops;
              const targetB = c1[2] + (c2[2] - c1[2]) * tStops;

              const colorMix = Math.min(1, segEnergy * 2.2);
              const red = Math.round(neutral[0] + (targetR - neutral[0]) * colorMix);
              const green = Math.round(neutral[1] + (targetG - neutral[1]) * colorMix);
              const blue = Math.round(neutral[2] + (targetB - neutral[2]) * colorMix);

              const baseAlpha = isLight ? 0.18 : 0.20;
              const addAlpha = 0.55;
              const alpha = (baseAlpha + addAlpha * segEnergy).toFixed(3);

              ctx.beginPath();
              ctx.lineWidth = 1 + 1.15 * segEnergy;
              ctx.strokeStyle = `rgba(${red}, ${green}, ${blue}, ${alpha})`;
              ctx.moveTo(seg.a.curX, seg.a.curY);
              ctx.lineTo(seg.b.curX, seg.b.curY);
              ctx.stroke();
            }
          }
        }

        function update(timestamp) {
          if (!isVisible) {
            animId = null;
            return;
          }

          const dt = Math.min((timestamp - lastTimestamp) / 1000, 0.05);
          lastTimestamp = timestamp;

          for (let i = 0; i < dots.length; i++) {
            const dot = dots[i];
            let targetDx = 0;
            let targetDy = 0;
            let targetEnergy = 0;

            if (pointerActive) {
              const dist = Math.hypot(dot.x0 - pointerX, dot.y0 - pointerY);
              if (dist < influenceRadius) {
                const t = 1 - dist / influenceRadius;
                const weight = t * t;
                const angle = Math.atan2(dot.y0 - pointerY, dot.x0 - pointerX);
                const disp = maxDisplacement * weight * Math.sin(t * Math.PI);
                targetDx = Math.cos(angle) * disp;
                targetDy = Math.sin(angle) * disp;
                targetEnergy = weight;
              }
            }

            // Spring-damper step (k = 150, c = 18)
            const ax = -150 * (dot.dx - targetDx) - 18 * dot.vx;
            const ay = -150 * (dot.dy - targetDy) - 18 * dot.vy;

            dot.vx += ax * dt;
            dot.vy += ay * dt;
            dot.dx += dot.vx * dt;
            dot.dy += dot.vy * dt;

            dot.energy += (targetEnergy - dot.energy) * Math.min(1, dt * 14);
          }

          draw(timestamp);

          animId = requestAnimationFrame(update);
        }

        function startAnimation() {
          if (animId === null && isVisible) {
            lastTimestamp = performance.now();
            animId = requestAnimationFrame(update);
          }
        }

        function resize(force) {
          if (!canvas || !ctx) return;
          const w = container.clientWidth;
          const h = container.clientHeight;
          if (w <= 0 || h <= 0) return;

          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          const pixelW = Math.floor(w * dpr);
          const pixelH = Math.floor(h * dpr);

          const sizeChanged = canvas.width !== pixelW || canvas.height !== pixelH;
          if (sizeChanged) {
            canvas.width = pixelW;
            canvas.height = pixelH;
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.scale(dpr, dpr);
            width = w;
            height = h;
          } else if (width === 0 || height === 0) {
            width = w;
            height = h;
          }

          const currentContour = container.dataset.contour || '';
          const latticeChanged =
            width !== lastLatticeWidth ||
            height !== lastLatticeHeight ||
            currentContour !== lastLatticeContour;

          if (sizeChanged || (force && latticeChanged)) {
            rebuildLattice();
            draw(performance.now());
          }
        }

        resize();

        if ('ResizeObserver' in window) {
          const ro = new ResizeObserver(function (entries) {
            for (let i = 0; i < entries.length; i++) {
              const entry = entries[i];
              if (entry.contentRect.width > 0 && entry.contentRect.height > 0) {
                resize();
              }
            }
          });
          ro.observe(container);
        }
        window.addEventListener('resize', function () { resize(); }, { passive: true });
        container.addEventListener('dotgrid:layout', function () {
          resize(true);
        });
        container.addEventListener('dotgrid:intro', function () {
          startIntro();
        });

        // Viewport visibility tracking
        const io = new IntersectionObserver(function (entries) {
          for (let i = 0; i < entries.length; i++) {
            const entry = entries[i];
            isVisible = entry.isIntersecting;
            if (isVisible) {
              resize();
              startAnimation();
            } else if (animId !== null) {
              cancelAnimationFrame(animId);
              animId = null;
            }
          }
        }, { threshold: 0.05 });
        io.observe(container);

        function onPointerMove(clientX, clientY) {
          const rect = container.getBoundingClientRect();
          const localX = clientX - rect.left;
          const localY = clientY - rect.top;

          if (
            localX >= -influenceRadius &&
            localX <= rect.width + influenceRadius &&
            localY >= -influenceRadius &&
            localY <= rect.height + influenceRadius
          ) {
            pointerActive = true;
            pointerX = localX;
            pointerY = localY;
            startAnimation();
          } else if (pointerActive) {
            pointerActive = false;
          }
        }

        window.addEventListener('mousemove', function (e) {
          onPointerMove(e.clientX, e.clientY);
        }, { passive: true });

        window.addEventListener('touchmove', function (e) {
          if (e.touches.length > 0) {
            onPointerMove(e.touches[0].clientX, e.touches[0].clientY);
          }
        }, { passive: true });

        window.addEventListener('touchstart', function (e) {
          if (e.touches.length > 0) {
            onPointerMove(e.touches[0].clientX, e.touches[0].clientY);
          }
        }, { passive: true });

        function onPointerLeave() {
          if (pointerActive) {
            pointerActive = false;
          }
        }

        window.addEventListener('mouseleave', onPointerLeave);
        window.addEventListener('touchend', onPointerLeave);
        window.addEventListener('touchcancel', onPointerLeave);
      });
    }

    window.__initReactiveDotGrids = initReactiveDotGrids;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReactiveDotGrids);
    } else {
      initReactiveDotGrids();
    }
    document.addEventListener('astro:page-load', initReactiveDotGrids);
  })();
</script>
