---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  pubDate: Date;
  icon?: ImageMetadata;
  tags: string[];
  activeTag?: string;
  featured?: boolean;
}

const { 
  id, 
  title, 
  description, 
  pubDate, 
  icon, 
  tags, 
  activeTag,
  featured = false
} = Astro.props;

const isSvg = icon && typeof icon === 'object' && 'format' in icon && icon.format === 'svg';

const optimizedIcon = icon && !isSvg ? await getImage({
  src: icon,
  format: 'webp',
  width: 800,
  quality: 80
}) : null;


// Article wrapper classes
const articleClass = featured
  ? "glass-card rounded-2xl md:rounded-3xl border-2 border-brand-blue/50 light:border-brand-blue/40 shadow-2xl shadow-brand-blue/15 light:shadow-xl light:shadow-brand-blue/10 bg-gradient-to-br from-brand-blue/20 via-slate-900/90 to-indigo-950/80 light:from-blue-50/90 light:via-white light:to-sky-100/70 flex flex-col items-stretch group relative cursor-pointer hover:border-brand-blue/80 transition-all duration-300 h-full w-full overflow-hidden"
  : "glass-card rounded-2xl md:rounded-3xl border border-element-border flex flex-col items-stretch group relative cursor-pointer hover:border-brand-blue/40 transition-all duration-300 h-full w-full overflow-hidden";

// Image container classes
const imageContainerClass = "w-full aspect-video shrink-0 overflow-hidden border-b border-element-border-medium bg-gray-900 flex items-center justify-center relative z-10";
---


<article class={articleClass}>
  {featured && (
    <>
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-blue z-20"></div>
      <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/15 via-transparent to-brand-purple/15 light:from-brand-blue/10 light:to-sky-200/20 opacity-80 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-0"></div>
    </>
  )}

  <!-- Image panel -->
  <div class={imageContainerClass}>
    <!-- Transparent click overlay so the image panel navigates on click -->
    <a href={`/posts/${id}`} class="absolute inset-0 z-20" aria-hidden="true" tabindex="-1"></a>
    {icon ? (
      <div class="relative w-full h-full min-h-[160px] overflow-hidden flex items-center justify-center">
        <img 
          src={optimizedIcon ? optimizedIcon.src : (typeof icon === 'string' ? icon : (icon?.src || ''))}
          alt={`Preview for ${title}`}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 will-change-transform"
          loading="lazy"
          decoding="async"
        />
        <!-- Ambient overlay for depth & contrast in dark and light modes -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent block light:hidden pointer-events-none z-10"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/25 via-transparent to-transparent hidden light:block pointer-events-none z-10"></div>
      </div>
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/20 via-brand-purple/10 to-indigo-950/40 light:to-sky-100/40 flex items-center justify-center">
        <svg class="w-12 h-12 text-brand-blue/30 light:text-brand-blue/50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18c-2.305 0-4.408.867-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
    )}
  </div>
  
  <!-- Content -->
  <div class="flex-grow flex flex-col gap-3 relative z-10 p-5 md:p-6">

    <!-- Meta row: date + badge -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      {featured && (
        <span class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-brand-blue text-white shadow-md shadow-brand-blue/30">
          ★ Featured
        </span>
      )}
      <time class="text-xs font-semibold text-brand-blue/80">
        {pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric"
        })}
      </time>
      <span 
        class="unread-dot hidden badge-new badge-new-blue shrink-0" 
        data-item-url={`/posts/${id}`}
        title="Unread post"
      >UNREAD</span>
    </div>

    <!-- Title -->
    <h2 class="text-base sm:text-lg font-bold text-gray-100 light:text-slate-900 mb-2 group-hover:text-brand-blue transition-colors leading-snug">
      <a href={`/posts/${id}`} class="after:absolute after:inset-0 after:z-10">
        {title}
      </a>
    </h2>

    <!-- Description -->
    {description && (
      <p class="text-gray-400 light:text-slate-500 text-sm mb-4 leading-relaxed font-normal">
        {description}
      </p>
    )}

    <!-- Tags & Action Button Area -->
    <div class="flex-grow flex flex-col justify-between mt-2">
      <div class="flex flex-wrap gap-1.5 mb-3">
        {tags.map(tag => (
          <a 
            href={`/tags/${tag}`}
            class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border transition-colors relative z-20 ${
              tag === activeTag
                ? 'bg-brand-blue/20 border-brand-blue/50 text-sky-300 light:bg-brand-blue/15 light:border-brand-blue/40 light:text-brand-blue'
                : 'bg-white/5 border-white/10 text-gray-400 hover:bg-brand-blue/15 hover:border-brand-blue/30 hover:text-sky-300 light:bg-white light:border-slate-200 light:text-slate-500 light:hover:bg-blue-50 light:hover:border-brand-blue/30 light:hover:text-brand-blue'
            }`}
          >
            #{tag}
          </a>
        ))}
      </div>

      <!-- Read more button — centered -->
      <div class="flex justify-center mt-3">
        <a 
          href={`/posts/${id}`} 
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-brand-blue/12 hover:bg-brand-blue/25 border border-brand-blue/20 hover:border-brand-blue/45 text-sky-300 light:text-brand-blue text-xs font-bold relative z-20 transition-all hover:scale-105"
        >
          <span>Read Article</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>
