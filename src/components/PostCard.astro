---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  pubDate: Date;
  icon?: ImageMetadata;
  tags: string[];
  activeTag?: string;
  featured?: boolean;
}

const { 
  id, 
  title, 
  description, 
  pubDate, 
  icon, 
  tags, 
  activeTag,
  featured = false 
} = Astro.props;

const optimizedIcon = icon ? await getImage({
  src: icon,
  format: 'webp',
  width: 192,
  quality: 80
}) : null;
---

<article class={featured 
  ? "glass-card p-6 md:p-8 rounded-2xl md:rounded-3xl border-2 border-brand-blue/50 light:border-brand-blue/40 shadow-2xl shadow-brand-blue/15 light:shadow-xl light:shadow-brand-blue/10 bg-gradient-to-br from-brand-blue/20 via-slate-900/90 to-indigo-950/80 light:from-blue-50/90 light:via-white light:to-sky-100/70 flex flex-col md:flex-row gap-6 items-start group relative cursor-pointer hover:border-brand-blue/80 transition-all duration-300 h-full w-full overflow-hidden"
  : "glass-card p-6 rounded-2xl border border-element-border flex flex-col md:flex-row gap-6 items-start group relative cursor-pointer hover:border-brand-blue/30 h-full w-full"
}>
  {featured && (
    <>
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-brand-blue via-teal-400 to-brand-purple"></div>
      <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/15 via-transparent to-brand-purple/15 light:from-brand-blue/10 light:to-sky-200/20 opacity-80 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
    </>
  )}

  {icon && (
    <div class={featured 
      ? "w-20 h-20 md:w-28 md:h-28 rounded-2xl overflow-hidden shrink-0 border-2 border-brand-blue/40 bg-gray-990/60 flex items-center justify-center relative shadow-lg shadow-brand-blue/20" 
      : "w-16 h-16 md:w-24 md:h-24 rounded-xl overflow-hidden shrink-0 border border-element-border-medium bg-gray-990/50 flex items-center justify-center relative"
    }>
      <svg 
        class="absolute inset-0 w-full h-full group-hover:scale-105 transition-transform duration-300 z-0 will-change-transform pointer-events-none" 
        viewBox="0 0 100 100" 
        preserveAspectRatio="none"
        role="img"
        aria-label={`Post icon: ${title}`}
      >
        <defs>
          <linearGradient id={`grad-post-dark-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#111827" stop-opacity="1" />
            <stop offset="100%" stop-color="#0b1c3a" stop-opacity="0.2" />
          </linearGradient>
          <linearGradient id={`grad-post-light-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#111827" stop-opacity="0.6" />
            <stop offset="100%" stop-color="#0b1c3a" stop-opacity="0.1" />
          </linearGradient>
        </defs>
        <image 
          href={optimizedIcon ? optimizedIcon.src : (typeof icon === 'string' ? icon : (icon?.src || ''))} 
          x="0" 
          y="0" 
          width="100" 
          height="100" 
          preserveAspectRatio="xMidYMid slice" 
        />
        <rect 
          x="0" 
          y="0" 
          width="100" 
          height="100" 
          class="block light:hidden"
          fill={`url(#grad-post-dark-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
        <rect 
          x="0" 
          y="0" 
          width="100" 
          height="100" 
          class="hidden light:block"
          fill={`url(#grad-post-light-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
      </svg>
    </div>
  )}
  
  <!-- Content -->
  <div class="flex-grow flex flex-col h-full w-full relative z-10">
    <div class="flex flex-wrap items-center gap-3 mb-2.5">
      {featured && (
        <span class="inline-flex items-center gap-1.5 text-[11px] font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-brand-blue text-white shadow-md shadow-brand-blue/30 light:bg-brand-blue light:text-white">
          ★ Featured Article
        </span>
      )}
      <time class={featured ? "text-xs font-bold text-sky-400 light:text-brand-blue" : "text-xs font-semibold text-brand-blue/80"}>
        {pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric"
        })}
      </time>
      <span 
        class="unread-dot hidden w-2 h-2 rounded-full bg-brand-blue shadow-[0_0_8px_rgba(59,130,246,0.8)] shrink-0" 
        data-item-url={`/posts/${id}`}
        title="Unread post"
      ></span>
    </div>
    
    <h2 class={featured ? "text-2xl md:text-3xl lg:text-4xl font-extrabold text-gray-100 light:text-slate-900 mb-3 group-hover:text-sky-300 light:group-hover:text-brand-blue transition-colors" : "text-xl font-bold text-gray-100 mb-3 group-hover:text-brand-blue transition-colors"}>
      <a href={`/posts/${id}`} class="after:absolute after:inset-0 after:z-10">
        {title}
      </a>
    </h2>
    
    {description && (
      <p class={featured ? "text-gray-300 light:text-slate-700 text-base leading-relaxed mb-6 font-normal flex-grow" : "text-gray-400 text-sm leading-relaxed mb-4 font-normal flex-grow"}>
        {description}
      </p>
    )}

    <div class="flex flex-wrap gap-2 items-center mt-auto w-full">
      {tags.map(tag => (
        <a 
          href={`/posts/tags/${tag}`}
          class={`text-xs font-medium ${tag === activeTag ? 'text-brand-blue font-bold' : featured ? 'text-sky-300/80 light:text-slate-600 hover:text-white light:hover:text-slate-900' : 'text-gray-500 hover:text-gray-100'} transition-colors relative z-20`}
        >
          #{tag}
        </a>
      ))}
      <a 
        href={`/posts/${id}`} 
        class={featured 
          ? "px-4 py-2 rounded-xl bg-brand-blue/30 hover:bg-brand-blue/40 border border-brand-blue/50 text-white light:bg-brand-blue light:text-white light:hover:bg-brand-blue/90 text-xs font-bold ml-auto flex items-center space-x-1.5 relative z-20 shadow-sm transition-all group-hover:scale-105" 
          : "text-xs font-semibold text-brand-blue hover:text-brand-blue/85 ml-auto flex items-center space-x-1 relative z-20"
        }
      >
        <span>Read Article</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</article>
