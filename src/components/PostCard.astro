---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  pubDate: Date;
  icon?: ImageMetadata;
  tags: string[];
  activeTag?: string;
  featured?: boolean;
  /** Side-by-side image+text on desktop, stacks on mobile (used on /posts overview) */
  horizontal?: boolean;
}

const { 
  id, 
  title, 
  description, 
  pubDate, 
  icon, 
  tags, 
  activeTag,
  featured = false,
  horizontal = false
} = Astro.props;

const isSvg = icon && typeof icon === 'object' && 'format' in icon && icon.format === 'svg';

const optimizedIcon = icon && !isSvg ? await getImage({
  src: icon,
  format: 'webp',
  width: 800,
  quality: 80
}) : null;


// Article wrapper classes
const articleClass = featured
  ? "glass-card rounded-2xl md:rounded-3xl border-2 border-brand-blue/50 light:border-brand-blue/40 shadow-2xl shadow-brand-blue/15 light:shadow-xl light:shadow-brand-blue/10 bg-gradient-to-br from-brand-blue/20 via-slate-900/90 to-indigo-950/80 light:from-blue-50/90 light:via-white light:to-sky-100/70 flex flex-col md:flex-row items-stretch group relative cursor-pointer hover:border-brand-blue/80 transition-all duration-300 h-full w-full overflow-hidden"
  : horizontal
    ? "glass-card rounded-2xl md:rounded-3xl border border-element-border flex flex-col md:flex-row items-stretch group relative cursor-pointer hover:border-brand-blue/40 transition-all duration-300 h-full w-full overflow-hidden"
    : "glass-card rounded-2xl md:rounded-3xl border border-element-border flex flex-col items-stretch group relative cursor-pointer hover:border-brand-blue/40 transition-all duration-300 h-full w-full overflow-hidden";

// Image container classes
const imageContainerClass = featured
  ? "w-full md:w-[320px] lg:w-[380px] xl:w-[440px] shrink-0 aspect-video md:aspect-auto self-stretch overflow-hidden border-b-2 md:border-b-0 md:border-r-2 border-brand-blue/40 bg-gray-900 flex items-center justify-center relative shadow-lg shadow-brand-blue/20 z-10"
  : horizontal
    ? "w-full md:w-56 lg:w-64 xl:w-72 shrink-0 aspect-video md:aspect-auto self-stretch overflow-hidden border-b md:border-b-0 md:border-r border-element-border-medium bg-gray-900 flex items-center justify-center relative z-10"
    : "w-full aspect-video shrink-0 overflow-hidden border-b border-element-border-medium bg-gray-900 flex items-center justify-center relative z-10";
---


<article class={articleClass}>
  {featured && (
    <>
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-brand-blue via-teal-400 to-brand-purple z-20"></div>
      <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/15 via-transparent to-brand-purple/15 light:from-brand-blue/10 light:to-sky-200/20 opacity-80 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-0"></div>
    </>
  )}

  <!-- Image panel -->
  <div class={imageContainerClass}>
    <!-- Transparent click overlay so the image panel navigates on click -->
    <a href={`/posts/${id}`} class="absolute inset-0 z-20" aria-hidden="true" tabindex="-1"></a>
    {icon ? (
      <svg 
        class="absolute inset-0 w-full h-full pointer-events-none z-0" 
        viewBox="0 0 160 90" 
        preserveAspectRatio="none"
        role="img"
        aria-label={`Post icon: ${title}`}
      >
        <defs>
          <!-- Background gradient (letterbox fill) -->
          <linearGradient id={`grad-post-bg-dark-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#0f172a" />
            <stop offset="50%" stop-color="#0d1f3c" />
            <stop offset="100%" stop-color="#0a0f1e" />
          </linearGradient>
          <linearGradient id={`grad-post-bg-light-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#e0eaff" />
            <stop offset="50%" stop-color="#dbeafe" />
            <stop offset="100%" stop-color="#eff6ff" />
          </linearGradient>
          <!-- Bottom overlay gradient -->
          <linearGradient id={`grad-post-dark-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#000000" stop-opacity="0" />
            <stop offset="60%" stop-color="#000000" stop-opacity="0.15" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0.55" />
          </linearGradient>
          <linearGradient id={`grad-post-light-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#000000" stop-opacity="0" />
            <stop offset="60%" stop-color="#000000" stop-opacity="0.07" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0.3" />
          </linearGradient>
        </defs>
        <!-- Background fill for letterbox areas -->
        <rect x="0" y="0" width="160" height="90" class="block light:hidden" fill={`url(#grad-post-bg-dark-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} />
        <rect x="0" y="0" width="160" height="90" class="hidden light:block" fill={`url(#grad-post-bg-light-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} />
        <!-- Image fitted without cropping (meet = contain) -->
        <image 
          href={optimizedIcon ? optimizedIcon.src : (typeof icon === 'string' ? icon : (icon?.src || ''))} 
          x="0" 
          y="0" 
          width="160" 
          height="90" 
          preserveAspectRatio="xMidYMid meet" 
          class="group-hover:scale-105 transition-transform duration-500 will-change-transform"
        />
        <!-- Bottom overlay gradient -->
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="block light:hidden"
          fill={`url(#grad-post-dark-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
        <rect 
          x="0" 
          y="0" 
          width="160" 
          height="90.5" 
          class="hidden light:block"
          fill={`url(#grad-post-light-${id.replace(/[^a-zA-Z0-9]/g, '-').toLowerCase()})`} 
        />
      </svg>
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-brand-blue/20 via-brand-purple/10 to-indigo-950/40 light:to-sky-100/40 flex items-center justify-center">
        <svg class="w-12 h-12 text-brand-blue/30 light:text-brand-blue/50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18c-2.305 0-4.408.867-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
    )}
  </div>
  
  <!-- Content -->
  <div class={`flex-grow flex flex-col gap-3 relative z-10 ${featured ? 'p-6 md:p-8' : 'p-5 md:p-6'}`}>

    <!-- Meta row: date + badge -->
    <div class={`flex flex-wrap items-center gap-2 ${featured ? 'mb-4' : 'mb-3'}`}>
      {featured && (
        <span class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-brand-blue text-white shadow-md shadow-brand-blue/30">
          ★ Featured
        </span>
      )}
      <time class={featured ? "text-sm font-extrabold text-sky-400 light:text-brand-blue" : "text-xs font-semibold text-brand-blue/80"}>
        {pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric"
        })}
      </time>
      <span 
        class="unread-dot hidden badge-new badge-new-blue shrink-0" 
        data-item-url={`/posts/${id}`}
        title="Unread post"
      >UNREAD</span>
    </div>

    <!-- Title -->
    <h2 class={featured
      ? "text-xl md:text-2xl lg:text-3xl font-extrabold text-gray-100 light:text-slate-900 mb-3 group-hover:text-sky-300 light:group-hover:text-brand-blue transition-colors leading-snug"
      : "text-base font-bold text-gray-100 light:text-slate-900 mb-2 group-hover:text-brand-blue transition-colors leading-snug"
    }>
      <a href={`/posts/${id}`} class="after:absolute after:inset-0 after:z-10">
        {title}
      </a>
    </h2>

    <!-- Description -->
    {description && (
      <p class={`leading-relaxed font-normal ${featured
        ? 'text-gray-300 light:text-slate-600 text-base md:text-lg mb-5'
        : 'text-gray-400 light:text-slate-500 text-sm mb-4'
      }`}>
        {description}
      </p>
    )}

    <!-- Tags & Action Button Area -->
    <div class="flex-grow flex flex-col justify-between mt-2">
      <div class="flex flex-wrap gap-1.5 mb-3">
        {tags.map(tag => (
          <a 
            href={`/posts/tags/${tag}`}
            class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border transition-colors relative z-20 ${
              tag === activeTag
                ? 'bg-brand-blue/20 border-brand-blue/50 text-sky-300 light:bg-brand-blue/15 light:border-brand-blue/40 light:text-brand-blue'
                : 'bg-white/5 border-white/10 text-gray-400 hover:bg-brand-blue/15 hover:border-brand-blue/30 hover:text-sky-300 light:bg-white light:border-slate-200 light:text-slate-500 light:hover:bg-blue-50 light:hover:border-brand-blue/30 light:hover:text-brand-blue'
            }`}
          >
            #{tag}
          </a>
        ))}
      </div>

      <!-- Read more button — centered -->
      <div class="flex justify-center mt-3">
        <a 
          href={`/posts/${id}`} 
          class={featured 
            ? "inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-brand-blue/30 hover:bg-brand-blue/50 border border-brand-blue/50 text-white light:bg-brand-blue light:text-white light:hover:bg-brand-blue/90 text-sm font-bold relative z-20 shadow-md transition-all hover:scale-105" 
            : "inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-brand-blue/12 hover:bg-brand-blue/25 border border-brand-blue/20 hover:border-brand-blue/45 text-sky-300 light:text-brand-blue text-xs font-bold relative z-20 transition-all hover:scale-105"
          }
        >
          <span>Read Article</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>
