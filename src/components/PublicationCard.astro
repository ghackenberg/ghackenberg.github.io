---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatDate } from "@commons/shared/format";
import { formatAuthorsHtml, type AuthorEntry } from "@commons/shared/authors";

interface Props {
  id: string;
  title: string;
  authors: AuthorEntry[];
  pubDate: Date | string;
  book?: string;
  tags?: string[];
  publisherUrl?: string;
  activeTag?: string | string[];
  showTags?: boolean;
  icon?: ImageMetadata | { src: ImageMetadata; title?: string; description?: string } | string;
  image?: ImageMetadata | { src: ImageMetadata; title?: string; description?: string } | string;
}

const { 
  id, 
  title,  
  authors,
  pubDate, 
  book, 
  tags = [], 
  activeTag,
  showTags,
  icon,
  image
} = Astro.props;

const isTagActive = (t: string) => (!activeTag ? false : Array.isArray(activeTag) ? activeTag.includes(t) : activeTag === t);
const shouldShowTags = showTags ?? Boolean(activeTag);

type CoverImageObject = { src: ImageMetadata; title?: string; description?: string };

const rawImg = image || icon;
const isCoverObj = Boolean(
  rawImg &&
  typeof rawImg === 'object' &&
  'src' in rawImg &&
  typeof (rawImg as { src: ImageMetadata | string }).src === 'object'
);
const coverObj = isCoverObj ? (rawImg as CoverImageObject) : null;
const iconImg = coverObj
  ? coverObj.src
  : (rawImg as ImageMetadata | string | undefined);
const iconTitle = coverObj?.title || title;
const iconDesc = coverObj?.description || `Publication preview: ${title}`;

const isSvg = Boolean(iconImg && typeof iconImg === 'object' && 'format' in iconImg && iconImg.format === 'svg');

const optimizedIcon = iconImg && typeof iconImg === 'object' && !isSvg ? await getImage({
  src: iconImg as ImageMetadata,
  format: 'webp',
  width: 800,
  quality: 80
}) : null;
---

<article 
  class="glass-card preview-card border border-element-border flex flex-col items-stretch group relative cursor-pointer hover:border-domain-publications/40 transition-all duration-300 h-full w-full overflow-hidden" 
  data-card-id={id} 
  data-collection="publications"
>
  <!-- Image panel -->
  <div class="w-full aspect-video shrink-0 overflow-hidden border-b border-element-border-medium bg-gray-900 light:bg-slate-100 flex items-center justify-center relative z-10">
    <a href={`/publications/${id}/`} class="absolute inset-0 z-20" aria-hidden="true" tabindex="-1"></a>
    {iconImg ? (
      <div class="relative w-full h-full min-h-[160px] overflow-hidden flex items-center justify-center">
        <img
          src={optimizedIcon ? optimizedIcon.src : (typeof iconImg === 'string' ? iconImg : (iconImg?.src || ''))}
          alt={iconDesc}
          title={iconTitle}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent block light:hidden pointer-events-none z-10"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/25 via-transparent to-transparent hidden light:block pointer-events-none z-10"></div>
      </div>
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-domain-publications/20 via-element-bg to-bg-main flex items-center justify-center">
        <svg class="w-12 h-12 text-domain-publications/30 light:text-domain-publications/50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18c-2.305 0-4.408.867-6 2.292m0-14.25v14.25" />
        </svg>
      </div>
    )}
    <span class="unread-dot hidden badge-new badge-new-publications badge-corner-tr" data-item-url={`/publications/${id}/`} title="Unread publication">UNREAD</span>
  </div>

  <!-- Content / Information Body -->
  <div class="flex-grow flex flex-col relative z-10 preview-card-body">
    <!-- Date row -->
    <div class="mb-1">
      <time class="text-xs font-semibold text-domain-publications">
        {formatDate(pubDate, 'short')}
      </time>
    </div>

    <!-- Book / Venue row -->
    {book && (
      <div class="mb-2">
        <span class="text-xs font-medium text-gray-400 light:text-slate-500 italic line-clamp-1 min-h-[1lh] leading-relaxed" title={book}>
          {book}
        </span>
      </div>
    )}

    <!-- Title -->
    <h2 class="text-base sm:text-lg font-bold text-gray-100 mb-2 group-hover:text-domain-publications light:group-hover:text-domain-publications transition-colors leading-snug line-clamp-2 min-h-[2lh]" title={title}>
      <a href={`/publications/${id}/`} class="after:absolute after:inset-0 after:z-10">
        {title}
      </a>
    </h2>

    <!-- Authors -->
    <p class="text-gray-300 light:text-slate-600 text-xs sm:text-sm font-normal mb-3 leading-relaxed line-clamp-2 min-h-[2lh]">
      <span set:html={formatAuthorsHtml(authors)} />
    </p>

    <!-- Tags & Action Button Area -->
    {shouldShowTags && tags && tags.length > 0 ? (
      <div class="flex-grow flex flex-col mt-auto pt-2">
        <div class="flex flex-wrap gap-1.5 self-start">
          {tags.map(tag => (
            <a 
              href={`/tags/${tag}/`}
              data-tag={tag}
              class={`tag-chip tag-chip-indigo inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold border relative z-20 hover:scale-105 transition-all ${
                isTagActive(tag) ? 'active-tag-match' : ''
              }`}
            >
              #{tag}
            </a>
          ))}
        </div>

        <!-- Read more button — full width, pinned to bottom -->
        <div class="mt-auto pt-5 w-full">
          <a 
            href={`/publications/${id}/`} 
            aria-label={`Read More: ${title}`}
            class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-domain-publications/12 hover:bg-domain-publications/25 border border-domain-publications/20 hover:border-domain-publications/45 text-domain-publications text-xs font-bold relative z-20 transition-all duration-200"
          >
            <span>Read More</span>
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <div class="mt-auto pt-4 w-full">
        <a 
          href={`/publications/${id}/`} 
          aria-label={`Read More: ${title}`}
          class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-domain-publications/12 hover:bg-domain-publications/25 border border-domain-publications/20 hover:border-domain-publications/45 text-domain-publications text-xs font-bold relative z-20 transition-all duration-200"
        >
          <span>Read More</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</article>
