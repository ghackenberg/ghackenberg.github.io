---
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  title: string;
  author: string;
  pubDate: string;
  book?: string;
  tags?: string[];
  icon?: string | ImageMetadata;
  publisherUrl?: string;
  activeTag?: string | string[];
}

const { 
  id, 
  title, 
  author, 
  pubDate, 
  book, 
  tags = [], 
  icon, 
  activeTag
} = Astro.props;

const isTagActive = (t: string) => (!activeTag ? false : Array.isArray(activeTag) ? activeTag.includes(t) : activeTag === t);
const iconSrc = typeof icon === 'object' && icon !== null && 'src' in icon ? icon.src : icon;
---

<article 
  class="glass-card preview-card p-4 rounded-2xl border border-element-border group flex flex-col md:flex-row items-stretch gap-4 md:gap-5 relative cursor-pointer hover:border-brand-purple/30 h-auto w-full" 
  data-card-id={id} 
  data-collection="publications"
>
  <!-- Absolute overlay link for card clickability -->
  <a href={`/publications/${id}/`} class="absolute inset-0 z-10" aria-label={title}></a>

  <!-- Unread corner ribbon badge -->
  <span 
    class="unread-dot hidden badge-new badge-new-purple badge-corner-tr" 
    data-item-url={`/publications/${id}/`}
    title="Unread publication"
  >UNREAD</span>

  <!-- Preview image container (Desktop only: fixed width, variable height stretching with text) -->
  <div class="hidden md:flex shrink-0 w-44 lg:w-48 self-stretch rounded-xl overflow-hidden border border-element-border-medium bg-gray-900/50 items-center justify-center relative">
    {iconSrc ? (
      <img 
        src={iconSrc} 
        alt={`Publication preview: ${title}`} 
        title={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
        loading="lazy" 
        decoding="async" 
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-brand-purple/20 via-brand-purple/10 to-indigo-950/40 light:to-purple-100/40 flex items-center justify-center text-brand-purple/50 light:text-brand-purple/70">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
      </div>
    )}
  </div>

  <!-- Content / Information rows -->
  <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5">
    <!-- Text metadata cluster -->
    <div class="pub-card-meta flex flex-col gap-2 md:gap-2.5 min-w-0">
      <!-- Row 1: Title -->
      <div class="flex items-center min-w-0">
        <h3 class="text-base sm:text-lg font-bold text-gray-100 group-hover:text-brand-purple transition-colors whitespace-normal pr-14 leading-snug min-w-0 w-full" title={title}>
          {title}
        </h3>
      </div>

      <!-- Row 2: Authors -->
      <p class="text-gray-300 text-xs sm:text-sm font-normal whitespace-normal min-w-0 leading-normal">
        <span set:html={author} />
      </p>

      <!-- Row 3: Book/Venue + Date -->
      <p class="text-gray-400 text-xs font-normal italic whitespace-normal min-w-0 leading-normal">
        {book ? `${book}, ${pubDate}` : pubDate}
      </p>
    </div>

    <!-- Action cluster: Tags and Read More button -->
    <div class="pub-card-actions flex flex-col gap-3 md:gap-3.5 mt-auto pt-3 md:pt-3.5 w-full relative z-20">
      <!-- Row 4: Tags -->
      <div class="pub-tags-container flex flex-wrap items-center gap-1.5 min-w-0 w-full relative z-20">
        {tags && tags.map(tag => (
          <a 
            href={`/tags/${tag}/`}
            data-tag={tag}
            class={`tag-chip tag-chip-purple inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold border shrink-0 hover:scale-105 transition-all ${
              isTagActive(tag) ? 'active-tag-match' : ''
            }`}
          >
            #{tag}
          </a>
        ))}
      </div>

      <!-- Row 5: Read More Button -->
      <div class="w-full relative z-20">
        <a 
          href={`/publications/${id}/`} 
          aria-label={`Read More: ${title}`}
          class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg bg-brand-purple/12 hover:bg-brand-purple/25 border border-brand-purple/20 hover:border-brand-purple/45 text-purple-300 light:text-purple-700 text-xs font-bold relative z-20 transition-all duration-200"
        >
          <span>Read More</span>
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</article>
