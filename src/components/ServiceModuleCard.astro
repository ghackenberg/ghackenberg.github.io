---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  serviceId: string;
  module: CollectionEntry<'modules'>;
}

const { serviceId, module } = Astro.props;
const moduleSlug = module.id.split('/').pop() || module.id;
const cardId = module.id;
const href = `/services/${serviceId}/${moduleSlug}/`;

const colorClasses = {
  text: 'text-domain-services',
  hoverText: 'group-hover:text-domain-services',
  cardBtnBg: 'bg-domain-services/12 group-hover:bg-domain-services/25 border border-domain-services/20 group-hover:border-domain-services/45 text-domain-services',
  dot: 'badge-new badge-new-emerald'
};
---

<article 
  class="glass-card preview-card border border-element-border relative flex flex-col h-full hover:border-element-border-medium transition-all duration-300 group cursor-pointer"
  data-card-id={cardId}
  data-collection="service-modules"
>
  <!-- Absolute overlay link for card clickability and CTR telemetry delegation -->
  <a href={href} class="absolute inset-0 z-20" aria-label={module.data.title}></a>

  <!-- Preview Image Column (Top) -->
  <div class="w-full aspect-video shrink-0 relative overflow-hidden bg-slate-950 border-b border-element-border">
    {module.data.previewImage && (
      <Image 
        src={module.data.previewImage.src} 
        alt={module.data.previewImage.description}
        title={module.data.previewImage.title}
        width={640}
        height={360}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    )}
    <!-- Ambient overlay for depth & contrast in dark and light modes -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent block light:hidden pointer-events-none z-10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/25 via-transparent to-transparent hidden light:block pointer-events-none z-10"></div>

    <!-- Unread badge -->
    <span 
      class={`unread-dot hidden ${colorClasses.dot} badge-corner-tr`}
      data-item-url={href}
      title="Unread module"
    >UNREAD</span>
  </div>
  
  <!-- Info Body (Below) -->
  <div class="preview-card-body flex flex-col flex-grow justify-between text-left">
    <div>
      <h3 class="text-base sm:text-lg font-bold text-gray-100 mb-2 group-hover:text-domain-services light:group-hover:text-domain-services transition-colors leading-snug line-clamp-1 min-h-[1lh]" title={module.data.title}>
        <span>{module.data.title}</span>
      </h3>
      <p class="text-gray-400 light:text-slate-600 text-sm mb-3 leading-relaxed font-normal line-clamp-3 min-h-[3lh]">
        {module.data.description}
      </p>
    </div>

    <!-- Read more button — full width, pinned to bottom -->
    <div class="mt-auto pt-4 w-full">
      <span 
        class={`flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg text-xs font-bold transition-all duration-200 ${colorClasses.cardBtnBg}`}
      >
        <span>Read More</span>
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </span>
    </div>
  </div>
</article>
