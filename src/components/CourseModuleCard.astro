---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  courseId: string;
  module: CollectionEntry<'course-modules'>;
}

const { courseId, module } = Astro.props;
const moduleSlug = module.id.split('/').pop() || module.id;
const href = `/courses/${courseId}/${moduleSlug}/`;
---

<article 
  class="glass-card preview-card border border-element-border relative flex flex-col h-full hover:border-element-border-medium transition-all duration-300 group cursor-pointer" 
  data-card-id={module.id} 
  data-collection="course-modules"
>
  <!-- Absolute overlay link for card clickability and CTR telemetry delegation -->
  <a href={href} class="absolute inset-0 z-20" aria-label={module.data.title}></a>

  {module.data.previewImage ? (
    <div class="w-full aspect-video shrink-0 relative overflow-hidden bg-slate-950 border-b border-element-border">
      <Image 
        src={module.data.previewImage.src} 
        alt={module.data.previewImage.description}
        title={module.data.previewImage.title}
        width={640}
        height={360}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <!-- Ambient overlay for depth & contrast in dark and light modes -->
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent block light:hidden pointer-events-none z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/25 via-transparent to-transparent hidden light:block pointer-events-none z-10"></div>
      <span 
        class="unread-dot hidden badge-new badge-new-cyan badge-corner-tr"
        data-item-url={href}
        title="Unread module"
      >UNREAD</span>
    </div>
  ) : (
    <div>
      <div class="p-4 bg-gray-950/20 border-b border-element-border flex items-center justify-between">
        <span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-domain-courses/10 border border-domain-courses/20 text-domain-courses">
          Module {module.data.moduleNumber || module.data.order}
        </span>
        <span 
          class="unread-dot hidden badge-new badge-new-cyan"
          data-item-url={href}
          title="Unread module"
        >UNREAD</span>
      </div>
    </div>
  )}

  <!-- Info Body -->
  <div class="preview-card-body flex flex-col flex-grow justify-between text-left">
    <div>
      <h3 class="text-base sm:text-lg font-bold text-gray-100 mb-2 group-hover:text-domain-courses light:group-hover:text-domain-courses transition-colors leading-snug line-clamp-1 min-h-[1lh]" title={module.data.title}>
        {module.data.title}
      </h3>
      <p class="text-gray-400 light:text-slate-600 text-sm mb-3 leading-relaxed font-normal line-clamp-3 min-h-[3lh]">
        {module.data.description}
      </p>
    </div>

    <!-- Bottom pinned 'Read More' button -->
    <div class="mt-auto pt-4 w-full">
      <span class="flex items-center justify-center gap-2 w-full px-3.5 py-2 rounded-lg text-xs font-bold transition-all duration-200 bg-domain-courses/12 group-hover:bg-domain-courses/25 border border-domain-courses/20 group-hover:border-domain-courses/45 text-domain-courses">
        <span>Read More</span>
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </span>
    </div>
  </div>
</article>
