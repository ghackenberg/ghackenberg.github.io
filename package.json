{
  "name": "ghackenberg.github.io",
  "type": "module",
  "version": "1.0.0",
  "description": "Personal portfolio website of Dr. Georg Hackenberg",
  "author": "Georg Hackenberg <georg.hackenberg@fh-wels.at> (https://hackenberg.tech)",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghackenberg/ghackenberg.github.io.git"
  },
  "homepage": "https://hackenberg.tech",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "mcp-unified-analytics": "./src/tools/unified-analytics.ts"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run typecheck && astro build && npm run generate-assets",
    "postbuild": "npm run validate:semantic-ids && npm run validate:assets",
    "validate": "npm run lint && npm run typecheck && npm run validate:scripts && npm run validate:skills && npm run validate:slides && npm run validate:citations:syntax && npm run lint:styles && npm run lint:svgs && npm run validate:architecture",
    "verify": "npm run validate && npm run build",
    "test": "npm run verify",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity hint",
    "lint": "eslint . --max-warnings=0",
    "sync": "tsx src/scripts/sync.ts",
    "generate-assets": "tsx src/scripts/generate-assets.ts",
    "build:search": "tsx src/scripts/build-search-index.ts",
    "test:search": "tsx src/scripts/test-search.ts",
    "test:context": "tsx src/scripts/test-context.ts",
    "test:llm": "tsx src/scripts/test-llm.ts",
    "test:memory": "tsx src/scripts/test-memory.ts",
    "lighthouse": "node --experimental-strip-types src/scripts/run-lighthouse.ts",
    "mcp:analytics": "tsx src/tools/unified-analytics.ts",
    "setup:mcp": "npm link",
    "audio:presentations": "tsx src/scripts/generate-presentation-audio.ts",
    "audio:talks": "tsx src/scripts/generate-presentation-audio.ts",
    "export:slides": "tsx src/scripts/export-slides-pdf.ts",
    "export:slides-thumbs": "tsx src/scripts/generate-slide-thumbnails.ts",
    "validate:slides": "tsx src/scripts/validate-slides.ts",
    "validate:slides:syntax": "tsx src/scripts/validate-slides.ts --syntax-only",
    "validate:skills": "tsx src/scripts/validate-skills.ts",
    "validate:semantic-ids": "tsx src/scripts/validate-semantic-ids.ts",
    "validate:assets": "tsx src/scripts/validate-assets.ts",
    "validate:citations:syntax": "tsx src/scripts/lint-citations.ts --syntax-only",
    "validate:scripts": "tsx src/scripts/validate-scripts.ts",
    "validate:architecture": "tsx src/scripts/validate-architecture.ts",
    "lint:citations": "tsx src/scripts/lint-citations.ts",
    "lint:citations:ci": "tsx src/scripts/lint-citations.ts --ci",
    "lint:styles": "tsx src/scripts/lint-styles.ts",
    "lint:svgs": "tsx src/scripts/lint-svgs.ts",
    "migrate:svgs": "tsx src/scripts/migrate-adaptive-svgs.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@octokit/core": "^7.0.6",
    "@plausible-analytics/tracker": "^0.4.6",
    "@tailwindcss/vite": "^4.3.0",
    "3d-force-graph": "^1.80.1",
    "astro": "^7.3.2",
    "cytoscape": "^3.34.3",
    "d3": "^7.9.0",
    "dotenv": "^18.0.5",
    "edge-tts-universal": "^1.4.0",
    "googleapis": "^172.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "howler": "^2.2.4",
    "katex": "^0.17.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "reveal.js": "^6.0.2",
    "sigma": "^3.0.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cytoscape": "^3.21.9",
    "@types/d3": "^7.4.3",
    "@types/howler": "^2.2.13",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "lighthouse": "^13.3.0",
    "mermaid": "^12.0.0",
    "puppeteer": "^25.0.4",
    "quickjs-wasi": "^2.2.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.61.1"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
