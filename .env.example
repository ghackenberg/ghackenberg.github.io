# ==============================================================================
# Google Search Console (GSC) Credentials
# ==============================================================================
# GSC Property URL (e.g. sc-domain:hackenberg.tech or https://hackenberg.tech/)
GSC_SITE_URL="sc-domain:hackenberg.tech"

# Method 1: Path to Google Service Account JSON key file (relative to mcp-unified-analytics or absolute)
GSC_SERVICE_ACCOUNT_KEY_FILE="./service-account.json"

# Method 2: Inline Service Account JSON string (alternative to key file)
# GSC_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# ==============================================================================
# Plausible Analytics Credentials
# ==============================================================================
# Plausible API Token (Stats API Read Token)
PLAUSIBLE_API_KEY="plausible_api_token_here"

# Domain-ID in Plausible
PLAUSIBLE_SITE_ID="hackenberg.tech"

# Plausible API host (e.g. https://analytics.mentawise.com or https://plausible.io)
PLAUSIBLE_HOST="https://analytics.mentawise.com"

# ==============================================================================
# Workspace / Site Settings
# ==============================================================================
SITE_BASE_URL="https://hackenberg.tech"
