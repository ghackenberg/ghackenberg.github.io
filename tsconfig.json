{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@commons/*": ["./src/commons/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/styles/*"],
      "@content/*": ["./src/content/*"],
      "@plugins/*": ["./src/plugins/*"],
      "@tools/*": ["./src/tools/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "scratch"]
}
